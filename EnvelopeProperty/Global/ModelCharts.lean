import EnvelopeProperty.Global.Model

/-!
# Affine charts of an integral multiprojective model

Let `𝒳 = (K, S, z)` be an integral multiprojective model (`EnvelopeProperty.MultiModel`,
`def:gl-model`). This file implements the blueprint node `lem:gl-charts` of `global.tex`
(subsection `subsec:gl-model`) for the formalization of Fang–Han–Xia, *The envelope property for
unibranch projective varieties* (FHX), and the absolute value on `K` attached to a
point with generic support (`def:gl-points`).

For a chart index `j = (j_1, …, j_r)` (`MultiModel.ChartIndex`) with `f^{(c)}_{j_c} ≠ 0` for all `c`
put `z̃_j^a = ∏_c (f^{(c)}_{j_c})^{a_c}` (`MultiModel.chartDen j a`), so that
`z_j^a = z̃_j^a T^a ∈ S` (`MultiModel.chartMono j a`), and `z_j = ∏_c z^{(c)}_{j_c}`
(`MultiModel.chartElem j`).

## Part (1): the chart algebra

The chart algebra `A_j = {g / z̃_j^a : g ∈ S_a, a ∈ ℕ^r} ⊆ K` is the image of `S` under the
dehomogenization `ψ_j : K[T] → K`, `T_c ↦ 1 / f^{(c)}_{j_c}` (`MultiModel.dehom`), which sends
`g T^a` to `g / z̃_j^a`; this makes `A_j` a subalgebra by definition
(`MultiModel.chartAlg j = S.map ψ_j`) and `MultiModel.mem_chartAlg_iff` recovers the description of
the blueprint. Hence:

* `MultiModel.fg_chartAlg`, `MultiModel.chartAlg_eq_adjoin`: `A_j` is a finitely generated
  `k`-algebra, generated by the `g_ℓ / z̃_j^{d_ℓ}` for homogeneous generators `g_ℓ T^{d_ℓ}` of `S`;
* `MultiModel.coord_div_mem_chartAlg`: `f^{(c)}_i / f^{(c)}_{j_c} ∈ A_j`;
* `MultiModel.isFractionRing_chartAlg`: `K` is the fraction field of `A_j` (by (M3));
* `MultiModel.isIntegrallyClosed_chartAlg`: `A_j` is integrally closed if `𝒳` is normal. The proof
  clears denominators in an integral equation of `w ∈ K` over `A_j`: `w z̃_j^N T^N` is integral over
  `S` for `N` large, hence lies in `S` (instead of passing through `S[z_j^{-1}]`).

## Part (2): the chart homeomorphism

`U_j = {v : |z_j|_v ≠ 0}` (`MultiModel.chartDomain j`) is open, and
`MultiModel.chartHomeomorph j hj : U_j ≃ₜ (Spec A_j)^an` is given by
`|g / z̃_j^a|_{ι_j(v)} = |g T^a|_v / |z_j^a|_v` (`MultiModel.chartMap`,
`MultiModel.chartMap_val_div`), with inverse the multigraded extension (`ofMultigradedNorm`) of
`N(g T^a) = |g / z̃_j^a|_y ∏_c μ_c(y)^{-a_c}`, `μ_c(y) = max_i |f^{(c)}_i / f^{(c)}_{j_c}|_y ≥ 1`
(`MultiModel.chartInv`, `MultiModel.chartScale`, `MultiModel.one_le_chartScale`).
`MultiModel.chartMap_triv`: `ι_j(⋆) = v_triv`.

## Part (3): the cover

`MultiModel.exists_chartIndex`: for every `v ∈ 𝒳^an` there is a chart index `j` with
`|z^{(c)}_{j_c}|_v = 1` for all `c` (so `f^{(c)}_{j_c} ≠ 0` and `v ∈ U_j`);
`MultiModel.iUnion_chartUnitDomain`.

## Points with generic support

`MultiModel.fieldVal v hv`: for `v ∈ 𝒳^val` the absolute value `|f / g|_v = |f T^a|_v / |g T^a|_v`
(`f, g ∈ S_a`, `g ≠ 0`) on `K` (`MultiModel.fieldVal_div`), obtained by extending `ι_j(v)` from
`A_j` to `K = Frac A_j` for a chart containing `v`. It is well defined because every element of `K`
is a single quotient `f / g` of this form (`MultiModel.exists_eq_div`; (M3) only says that such
quotients generate `K`), and it is characterized by its values on them
(`MultiModel.eq_fieldVal`).

`MultiModel.fg_top_intermediateField`: `K / k` is a finitely generated field extension.
-/

open scoped NNReal ENNReal Topology

open Topology MvPolynomial

noncomputable section

namespace EnvelopeProperty

universe u

namespace MultiModel

variable {k : Type u} [Field k] {K : Type u} [Field K] [Algebra k K] {r : ℕ}
  (X : MultiModel k K r)

/-! ### Chart indices and the denominators `z̃_j^a` -/

/-- A chart index `j = (j_1, …, j_r)`, `0 ≤ j_c ≤ M c`. -/
abbrev ChartIndex : Type := (c : Fin r) → Fin (X.M c + 1)

variable (j : X.ChartIndex)

/-- The denominator `z̃_j^a = ∏_c (f^{(c)}_{j_c})^{a_c}` of the chart `j`. -/
def chartDen (a : Fin r →₀ ℕ) : K :=
  ∏ c, X.coord c (j c) ^ a c

@[simp]
theorem chartDen_zero : X.chartDen j 0 = 1 := by
  simp [chartDen]

theorem chartDen_add (a b : Fin r →₀ ℕ) :
    X.chartDen j (a + b) = X.chartDen j a * X.chartDen j b := by
  simp [chartDen, pow_add, Finset.prod_mul_distrib]

@[simp]
theorem chartDen_single (c : Fin r) : X.chartDen j (Finsupp.single c 1) = X.coord c (j c) := by
  rw [chartDen, Finset.prod_eq_single c (fun d _ hdc => by
    rw [Finsupp.single_eq_of_ne hdc, pow_zero]) (by simp)]
  simp

variable {X j} in
theorem chartDen_ne_zero (hj : ∀ c, X.coord c (j c) ≠ 0) (a : Fin r →₀ ℕ) :
    X.chartDen j a ≠ 0 :=
  Finset.prod_ne_zero_iff.2 fun c _ => pow_ne_zero _ (hj c)

/-- `z̃_j^a ∈ S_a`. -/
theorem chartDen_mem_piece (a : Fin r →₀ ℕ) : X.chartDen j a ∈ X.piece a := by
  have h := prod_mem_piece (X := X) (s := Finset.univ) (a := fun c => a c • Finsupp.single c 1)
    (f := fun c => X.coord c (j c) ^ a c) fun c _ => pow_mem_piece (X.coord_mem_piece c (j c)) _
  have e : ∑ c, a c • Finsupp.single c 1 = a := by
    simp only [Finsupp.smul_single, smul_eq_mul, mul_one]
    exact Finsupp.univ_sum_single a
  rwa [e] at h

/-- The monomial `z_j^a = z̃_j^a T^a = ∏_c (z^{(c)}_{j_c})^{a_c} ∈ S`. -/
def chartMono (a : Fin r →₀ ℕ) : X.S :=
  X.ofPiece (X.chartDen_mem_piece j a)

/-- The element `z_j = ∏_c z^{(c)}_{j_c} ∈ S`. -/
def chartElem : X.S :=
  ∏ c, X.coordElem ⟨c, j c⟩

theorem chartMono_add (a b : Fin r →₀ ℕ) :
    X.chartMono j (a + b) = X.chartMono j a * X.chartMono j b := by
  rw [chartMono, chartMono, chartMono, ← ofPiece_mul]
  exact X.ofPiece_congr _ _ rfl (X.chartDen_add j a b)

@[simp]
theorem chartMono_zero : X.chartMono j 0 = 1 := by
  rw [chartMono, ← X.ofPiece_one]
  exact X.ofPiece_congr _ _ rfl (X.chartDen_zero j)

theorem chartMono_single (c : Fin r) :
    X.chartMono j (Finsupp.single c 1) = X.coordElem ⟨c, j c⟩ :=
  X.ofPiece_congr _ _ rfl (X.chartDen_single j c)

theorem chartMono_nsmul (n : ℕ) (a : Fin r →₀ ℕ) :
    X.chartMono j (n • a) = X.chartMono j a ^ n := by
  induction n with
  | zero => simp
  | succ m ihm => rw [succ_nsmul, X.chartMono_add, ihm, pow_succ]

theorem val_chartMono (v : Berk k X.S) (a : Fin r →₀ ℕ) :
    v.val (X.chartMono j a) = ∏ c, v.val (X.coordElem ⟨c, j c⟩) ^ a c := by
  induction a using Finsupp.induction with
  | zero => simp
  | single_add c n a hc hn ih =>
    rw [X.chartMono_add, map_mul, ih]
    have h1 : v.val (X.chartMono j (Finsupp.single c n)) = v.val (X.coordElem ⟨c, j c⟩) ^ n := by
      have e : Finsupp.single c n = n • Finsupp.single c 1 := by
        rw [Finsupp.smul_single, smul_eq_mul, mul_one]
      rw [e, X.chartMono_nsmul, map_pow, X.chartMono_single]
    rw [h1]
    have h2 : ∏ d, v.val (X.coordElem ⟨d, j d⟩) ^ (Finsupp.single c n + a) d =
        (∏ d, v.val (X.coordElem ⟨d, j d⟩) ^ (Finsupp.single c n) d) *
          ∏ d, v.val (X.coordElem ⟨d, j d⟩) ^ a d := by
      rw [← Finset.prod_mul_distrib]
      exact Finset.prod_congr rfl fun d _ => by rw [Finsupp.add_apply, pow_add]
    have h3 : ∏ d, v.val (X.coordElem ⟨d, j d⟩) ^ (Finsupp.single c n) d =
        v.val (X.coordElem ⟨c, j c⟩) ^ n := by
      rw [Finset.prod_eq_single c (fun d _ hdc => by
        rw [Finsupp.single_eq_of_ne hdc, pow_zero]) (by simp), Finsupp.single_eq_same]
    rw [h2, h3]

theorem val_chartElem (v : Berk k X.S) :
    v.val (X.chartElem j) = ∏ c, v.val (X.coordElem ⟨c, j c⟩) := by
  rw [chartElem, map_prod]

/-! ### Part (1): the chart algebra -/

/-- The dehomogenization `ψ_j : K[T] → K`, `T_c ↦ 1 / f^{(c)}_{j_c}`; it sends `g T^a` to
`g / z̃_j^a` (`dehom_monomial`). -/
def dehom : MvPolynomial (Fin r) K →ₐ[k] K :=
  (aeval fun c => (X.coord c (j c))⁻¹).restrictScalars k

theorem dehom_monomial (a : Fin r →₀ ℕ) (f : K) :
    X.dehom j (monomial a f) = f / X.chartDen j a := by
  rw [dehom, AlgHom.restrictScalars_apply, aeval_monomial, Algebra.algebraMap_self,
    RingHom.id_apply, div_eq_mul_inv, chartDen, ← Finset.prod_inv_distrib,
    Finsupp.prod_fintype _ _ fun _ => pow_zero _]
  simp only [inv_pow]

/-- The **chart algebra** `A_j = {g / z̃_j^a : g ∈ S_a} ⊆ K` (`lem:gl-charts`(1)), the image of `S`
under the dehomogenization. -/
def chartAlg : Subalgebra k K :=
  X.S.map (X.dehom j)

variable {X j}

theorem div_chartDen_mem_chartAlg {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) :
    f / X.chartDen j a ∈ X.chartAlg j :=
  ⟨monomial a f, hf, X.dehom_monomial j a f⟩

/-- Sums of chart fractions: `f / z̃^a + g / z̃^b = (f z̃^b + g z̃^a) / z̃^{a + b}`. -/
theorem exists_div_chartDen_add (hj : ∀ c, X.coord c (j c) ≠ 0) {a b : Fin r →₀ ℕ} {f g : K}
    (hf : f ∈ X.piece a) (hg : g ∈ X.piece b) :
    ∃ h ∈ X.piece (a + b), f / X.chartDen j a + g / X.chartDen j b = h / X.chartDen j (a + b) := by
  refine ⟨f * X.chartDen j b + g * X.chartDen j a, Submodule.add_mem _
    (mul_mem_piece hf (X.chartDen_mem_piece j b)) ?_, ?_⟩
  · rw [add_comm a b]
    exact mul_mem_piece hg (X.chartDen_mem_piece j a)
  · rw [X.chartDen_add, div_add_div _ _ (chartDen_ne_zero hj a) (chartDen_ne_zero hj b)]
    ring

/-- The elements of `A_j` are the fractions `f / z̃_j^a`, `f ∈ S_a`. -/
theorem mem_chartAlg_iff (hj : ∀ c, X.coord c (j c) ≠ 0) {x : K} :
    x ∈ X.chartAlg j ↔ ∃ (a : Fin r →₀ ℕ) (f : K), f ∈ X.piece a ∧ x = f / X.chartDen j a := by
  refine ⟨?_, fun ⟨a, f, hf, hx⟩ => hx ▸ div_chartDen_mem_chartAlg hf⟩
  rintro ⟨p, hp, rfl⟩
  change X.dehom j p ∈ {x | ∃ (a : Fin r →₀ ℕ) (f : K), f ∈ X.piece a ∧ x = f / X.chartDen j a}
  rw [p.as_sum, map_sum]
  refine Finset.sum_induction _ _ (fun x y hx hy => ?_) ⟨0, 0, Submodule.zero_mem _, by simp⟩
    fun a _ => ⟨a, p.coeff a, X.coeff_mem_piece hp a, X.dehom_monomial j a _⟩
  obtain ⟨a, f, hf, rfl⟩ := hx
  obtain ⟨b, g, hg, rfl⟩ := hy
  obtain ⟨h, hh, e⟩ := exists_div_chartDen_add hj hf hg
  exact ⟨a + b, h, hh, e⟩

variable (X j)

/-- `f^{(c)}_i / f^{(c)}_{j_c} ∈ A_j`. -/
theorem coord_div_mem_chartAlg (c : Fin r) (i : Fin (X.M c + 1)) :
    X.coord c i / X.coord c (j c) ∈ X.chartAlg j := by
  have h := div_chartDen_mem_chartAlg (j := j) (X.coord_mem_piece c i)
  rwa [chartDen_single] at h

/-- `A_j` is a finitely generated `k`-algebra (`lem:gl-charts`(1)). -/
theorem fg_chartAlg : (X.chartAlg j).FG :=
  X.fg.map _

instance instFiniteTypeChartAlg : Algebra.FiniteType k (X.chartAlg j) :=
  (Subalgebra.fg_iff_finiteType _).1 (X.fg_chartAlg j)

/-- If `S` is generated by `G`, then `A_j` is generated by the `ψ_j(g)`, `g ∈ G`; for homogeneous
generators `g_ℓ T^{d_ℓ}` these are the `g_ℓ / z̃_j^{d_ℓ}`. -/
theorem chartAlg_eq_adjoin {G : Set (MvPolynomial (Fin r) K)} (hG : Algebra.adjoin k G = X.S) :
    X.chartAlg j = Algebra.adjoin k (X.dehom j '' G) := by
  rw [chartAlg, ← hG, AlgHom.map_adjoin]

variable {X j}

/-- `K` is the fraction field of `A_j` (`lem:gl-charts`(1)):
`f / g = (f / z̃_j^a) / (g / z̃_j^a)`. -/
theorem isFractionRing_chartAlg (hj : ∀ c, X.coord c (j c) ≠ 0) :
    IsFractionRing (X.chartAlg j) K := by
  refine isFractionRing_of_forall_mem_closure Subtype.val_injective fun z => ?_
  refine X.mem_of_forall_div_mem (Subfield.closure (Set.range (algebraMap (X.chartAlg j) K)))
    (fun c => Subfield.subset_closure
    ⟨algebraMap k (X.chartAlg j) c, rfl⟩) (fun a f g hf hg _ => ?_) z
  have e : f / g = (f / X.chartDen j a) / (g / X.chartDen j a) := by
    rw [div_div_div_cancel_right₀ (chartDen_ne_zero hj a)]
  rw [e]
  exact div_mem (Subfield.subset_closure ⟨⟨_, div_chartDen_mem_chartAlg hf⟩, rfl⟩)
    (Subfield.subset_closure ⟨⟨_, div_chartDen_mem_chartAlg hg⟩, rfl⟩)

/-- **`lem:gl-charts`(1), normality.** If `S` is integrally closed in `K[T]` (equivalently `𝒳` is
normal, `MultiModel.isNormal_iff`), then `A_j` is integrally closed. For `w ∈ K` integral over
`A_j`, write the coefficients of an integral equation as `f_i / z̃_j^{d_i}` and let
`N = ∑ d_i`; then `w z̃_j^N T^N` is integral over `S`, hence in `S`, so
`w = (w z̃_j^N) / z̃_j^N ∈ A_j`. -/
theorem isIntegrallyClosed_chartAlg_of_isIntegrallyClosedIn (hj : ∀ c, X.coord c (j c) ≠ 0)
    (hS : IsIntegrallyClosedIn X.S (MvPolynomial (Fin r) K)) :
    IsIntegrallyClosed (X.chartAlg j) := by
  have := isFractionRing_chartAlg hj
  rw [isIntegrallyClosed_iff K]
  intro w hw
  obtain ⟨p, hpm, hp⟩ := hw
  set n := p.natDegree with hn
  choose d f hf hdf using fun i => (mem_chartAlg_iff hj).1 (p.coeff i).2
  set N : Fin r →₀ ℕ := ∑ i ∈ Finset.range n, d i
  set D := X.chartDen j N with hD_def
  have hD : D ≠ 0 := chartDen_ne_zero hj N
  have hdN : ∀ i < n, d i ≤ N := fun i hi =>
    Finset.single_le_sum (f := d) (fun _ _ => zero_le) (Finset.mem_range.2 hi)
  -- The coefficients `c_i = (p_i z̃^{(n-i)N}) T^{(n-i)N}` lie in `S`.
  have hc : ∀ i : Fin n, (p.coeff i : K) * D ^ (n - i) ∈ X.piece ((n - i) • N) := by
    intro i
    have hi : d i ≤ N := hdN i i.2
    have h1 : f i * X.chartDen j (N - d i) ∈ X.piece N := by
      have := mul_mem_piece (hf i) (X.chartDen_mem_piece j (N - d i))
      rwa [add_tsub_cancel_of_le hi] at this
    obtain ⟨m, hm⟩ : ∃ m, n - (i : ℕ) = m + 1 := ⟨n - i - 1, by omega⟩
    have h2 := mul_mem_piece h1 (pow_mem_piece (X.chartDen_mem_piece j N) m)
    have e1 : N + m • N = (n - i) • N := by rw [hm, succ_nsmul']
    have hDd : D = X.chartDen j (N - d i) * X.chartDen j (d i) := by
      rw [hD_def, ← X.chartDen_add, tsub_add_cancel_of_le hi]
    have hdi : X.chartDen j (d i) ≠ 0 := chartDen_ne_zero hj _
    have e2 : f i * X.chartDen j (N - d i) * D ^ m = (p.coeff i : K) * D ^ (n - i) := by
      rw [hdf i, hm, pow_succ]
      calc f i * X.chartDen j (N - d i) * D ^ m
          = f i / X.chartDen j (d i) * (D ^ m * (X.chartDen j (N - d i) * X.chartDen j (d i))) := by
            field_simp
        _ = f i / X.chartDen j (d i) * (D ^ m * D) := by rw [← hDd]
    rw [e1, e2] at h2
    exact h2
  set u := monomial N (w * D) with hu_def
  set P : Polynomial X.S := Polynomial.X ^ n +
    ∑ i : Fin n, Polynomial.C (X.ofPiece (hc i)) * Polynomial.X ^ (i : ℕ)
  have hPm : P.Monic := Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt _)
  have hpw : w ^ n + ∑ i ∈ Finset.range n, (p.coeff i : K) * w ^ i = 0 := by
    rw [hpm.as_sum, Polynomial.eval₂_add, Polynomial.eval₂_X_pow,
      Polynomial.eval₂_finsetSum] at hp
    simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow] at hp
    exact hp
  have hterm : ∀ i : Fin n, algebraMap X.S (MvPolynomial (Fin r) K) (X.ofPiece (hc i)) *
      u ^ (i : ℕ) = monomial (n • N) (D ^ n * ((p.coeff i : K) * w ^ (i : ℕ))) := by
    intro i
    rw [show algebraMap X.S (MvPolynomial (Fin r) K) (X.ofPiece (hc i)) =
      monomial ((n - i) • N) ((p.coeff i : K) * D ^ (n - i)) from rfl, hu_def, monomial_pow,
      monomial_mul]
    have hni : n = (n - i) + i := by omega
    congr 1
    · rw [← add_nsmul, ← hni]
    · rw [← pow_sub_mul_pow D (show (i : ℕ) ≤ n from i.2.le)]
      ring
  have hPu : Polynomial.eval₂ (algebraMap X.S (MvPolynomial (Fin r) K)) u P = 0 := by
    simp only [P, Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum,
      Polynomial.eval₂_mul, Polynomial.eval₂_C]
    rw [Finset.sum_congr rfl fun i _ => hterm i, hu_def, monomial_pow, ← map_sum, ← map_add,
      ← Finset.sum_range (fun i => D ^ n * ((p.coeff i : K) * w ^ i)), ← Finset.mul_sum,
      mul_pow, mul_comm (w ^ n), ← mul_add, hpw, mul_zero, map_zero]
  have hu : IsIntegral X.S u := ⟨P, hPm, hPu⟩
  obtain ⟨⟨v, hvS⟩, hv⟩ := (IsIntegrallyClosedIn.isIntegral_iff (R := X.S)).1 hu
  have hmem : w * D ∈ X.piece N := by
    rw [mem_piece]
    have hv' : v = monomial N (w * D) := hv
    rw [← hv']
    exact hvS
  have e : w = (w * D) / X.chartDen j N := by rw [← hD_def, mul_div_cancel_right₀ _ hD]
  exact ⟨⟨w, e ▸ div_chartDen_mem_chartAlg hmem⟩, rfl⟩

/-- **`lem:gl-charts`(1).** The chart algebra of a normal model is integrally closed. -/
theorem isIntegrallyClosed_chartAlg (hj : ∀ c, X.coord c (j c) ≠ 0) (hX : X.IsNormal) :
    IsIntegrallyClosed (X.chartAlg j) :=
  isIntegrallyClosed_chartAlg_of_isIntegrallyClosedIn hj (X.isNormal_iff.1 hX)

/-! ### Part (2): the chart map `ι_j : U_j → (Spec A_j)^an` -/

variable (X j) in
/-- The chart domain `U_j = {v ∈ 𝒳^an : |z_j|_v ≠ 0}`. -/
def chartDomain : Set X.an :=
  {v | v.1.val (X.chartElem j) ≠ 0}

theorem mem_chartDomain_iff {v : X.an} :
    v ∈ X.chartDomain j ↔ ∀ c, v.1.val (X.coordElem ⟨c, j c⟩) ≠ 0 := by
  rw [chartDomain, Set.mem_ofPred_eq, val_chartElem, Finset.prod_ne_zero_iff]
  simp

variable (X j) in
theorem isOpen_chartDomain : IsOpen (X.chartDomain j) :=
  isOpen_ne_fun ((Berk.continuous_val_apply _).comp continuous_subtype_val) continuous_const

theorem val_chartMono_ne_zero {v : Berk k X.S} (hv : ∀ c, v.val (X.coordElem ⟨c, j c⟩) ≠ 0)
    (a : Fin r →₀ ℕ) : v.val (X.chartMono j a) ≠ 0 := by
  rw [val_chartMono]
  exact Finset.prod_ne_zero_iff.2 fun c _ => pow_ne_zero _ (hv c)

/-- Cross multiplication: if `f / z̃_j^a = g / z̃_j^b`, then `(f T^a) z_j^b = (g T^b) z_j^a` in
`S`. -/
theorem ofPiece_mul_chartMono_eq (hj : ∀ c, X.coord c (j c) ≠ 0) {a b : Fin r →₀ ℕ} {f g : K}
    (hf : f ∈ X.piece a) (hg : g ∈ X.piece b) (h : f / X.chartDen j a = g / X.chartDen j b) :
    X.ofPiece hf * X.chartMono j b = X.ofPiece hg * X.chartMono j a := by
  rw [chartMono, chartMono, ← ofPiece_mul, ← ofPiece_mul]
  refine X.ofPiece_congr _ _ (add_comm a b) ?_
  rwa [div_eq_div_iff (chartDen_ne_zero hj a) (chartDen_ne_zero hj b)] at h

variable (X j) in
/-- The value `|x|_{ι_j(v)} = |f T^a|_v / |z_j^a|_v` for a chosen representation
`x = f / z̃_j^a` of `x ∈ A_j` (independent of the choice, `chartVal_eq`). -/
def chartVal (hj : ∀ c, X.coord c (j c) ≠ 0) (v : Berk k X.S) (x : X.chartAlg j) : ℝ≥0 :=
  v.val (X.ofPiece ((mem_chartAlg_iff hj).1 x.2).choose_spec.choose_spec.1) /
    v.val (X.chartMono j ((mem_chartAlg_iff hj).1 x.2).choose)

/-- The chart value does not depend on the representation `x = f / z̃_j^a`. -/
theorem chartVal_eq (hj : ∀ c, X.coord c (j c) ≠ 0) {v : Berk k X.S}
    (hv : ∀ c, v.val (X.coordElem ⟨c, j c⟩) ≠ 0) (x : X.chartAlg j) {a : Fin r →₀ ℕ} {f : K}
    (hf : f ∈ X.piece a) (hx : (x : K) = f / X.chartDen j a) :
    X.chartVal j hj v x = v.val (X.ofPiece hf) / v.val (X.chartMono j a) := by
  have h := ((mem_chartAlg_iff hj).1 x.2).choose_spec.choose_spec
  rw [chartVal, div_eq_div_iff (val_chartMono_ne_zero hv _) (val_chartMono_ne_zero hv _),
    ← map_mul, ← map_mul, X.ofPiece_mul_chartMono_eq hj h.1 hf (h.2.symm.trans hx)]

/-- The chart map `ι_j(v)`, `|f / z̃_j^a|_{ι_j(v)} = |f T^a|_v / |z_j^a|_v`, for a seminorm `v` on
`S` with `|z^{(c)}_{j_c}|_v ≠ 0` for all `c` (`lem:gl-charts`(2)). -/
def chartMap (hj : ∀ c, X.coord c (j c) ≠ 0) (v : Berk k X.S)
    (hv : ∀ c, v.val (X.coordElem ⟨c, j c⟩) ≠ 0) : Berk k (X.chartAlg j) :=
  Berk.ofFun (X.chartVal j hj v)
    (by
      rw [X.chartVal_eq hj hv 0 (Submodule.zero_mem (X.piece 0)) (by simp), X.ofPiece_zero,
        map_zero, zero_div])
    (by
      rw [X.chartVal_eq hj hv 1 X.one_mem_piece_zero (by simp), X.ofPiece_one, chartMono_zero,
        map_one, div_one])
    (fun x y => by
      obtain ⟨a, f, hf, hx⟩ := (mem_chartAlg_iff hj).1 x.2
      obtain ⟨b, g, hg, hy⟩ := (mem_chartAlg_iff hj).1 y.2
      rw [X.chartVal_eq hj hv x hf hx, X.chartVal_eq hj hv y hg hy,
        X.chartVal_eq hj hv (x * y) (mul_mem_piece hf hg)
          (by rw [Subalgebra.coe_mul, hx, hy, X.chartDen_add, div_mul_div_comm]),
        X.ofPiece_mul, X.chartMono_add, map_mul, map_mul, div_mul_div_comm])
    (fun x y => by
      obtain ⟨a, f, hf, hx⟩ := (mem_chartAlg_iff hj).1 x.2
      obtain ⟨b, g, hg, hy⟩ := (mem_chartAlg_iff hj).1 y.2
      have h1 : f * X.chartDen j b ∈ X.piece (a + b) := mul_mem_piece hf (X.chartDen_mem_piece j b)
      have h2 : g * X.chartDen j a ∈ X.piece (a + b) := by
        rw [add_comm a b]; exact mul_mem_piece hg (X.chartDen_mem_piece j a)
      have hza := val_chartMono_ne_zero hv a
      have hzb := val_chartMono_ne_zero hv b
      rw [X.chartVal_eq hj hv x hf hx, X.chartVal_eq hj hv y hg hy,
        X.chartVal_eq hj hv (x + y) (Submodule.add_mem _ h1 h2) (by
          rw [Subalgebra.coe_add, hx, hy, X.chartDen_add,
            div_add_div _ _ (chartDen_ne_zero hj a) (chartDen_ne_zero hj b)]
          ring),
        X.ofPiece_add h1 h2, X.chartMono_add, map_mul]
      have e1 : X.ofPiece h1 = X.ofPiece hf * X.chartMono j b := X.ofPiece_mul hf _
      have e2 : X.ofPiece h2 = X.ofPiece hg * X.chartMono j a := by
        rw [chartMono, ← ofPiece_mul]; exact X.ofPiece_congr _ _ (add_comm a b) rfl
      rw [e1, e2]
      calc v.val (X.ofPiece hf * X.chartMono j b + X.ofPiece hg * X.chartMono j a) /
            (v.val (X.chartMono j a) * v.val (X.chartMono j b))
          ≤ max (v.val (X.ofPiece hf) * v.val (X.chartMono j b))
              (v.val (X.ofPiece hg) * v.val (X.chartMono j a)) /
            (v.val (X.chartMono j a) * v.val (X.chartMono j b)) := by
            gcongr
            rw [← map_mul, ← map_mul]
            exact v.val.map_add _ _
        _ = max (v.val (X.ofPiece hf) / v.val (X.chartMono j a))
              (v.val (X.ofPiece hg) / v.val (X.chartMono j b)) := by
            rw [← max_div_div_right zero_le, mul_div_mul_right _ _ hzb, mul_comm (v.val _)
              (v.val (X.chartMono j a)), mul_div_mul_left _ _ hza])
    (fun c hc => by
      rw [X.chartVal_eq hj hv _ (X.algebraMap_mem_piece_zero c) (by simp),
        X.ofPiece_algebraMap, chartMono_zero, map_one, div_one, v.val_algebraMap c hc])

theorem chartMap_val_eq (hj : ∀ c, X.coord c (j c) ≠ 0) {v : Berk k X.S}
    (hv : ∀ c, v.val (X.coordElem ⟨c, j c⟩) ≠ 0) (x : X.chartAlg j) {a : Fin r →₀ ℕ} {f : K}
    (hf : f ∈ X.piece a) (hx : (x : K) = f / X.chartDen j a) :
    (X.chartMap hj v hv).val x = v.val (X.ofPiece hf) / v.val (X.chartMono j a) :=
  X.chartVal_eq hj hv x hf hx

/-- **`lem:gl-charts`(2).** `|g / z̃_j^a|_{ι_j(v)} = |g T^a|_v / |z_j^a|_v`. -/
theorem chartMap_val_div (hj : ∀ c, X.coord c (j c) ≠ 0) {v : Berk k X.S}
    (hv : ∀ c, v.val (X.coordElem ⟨c, j c⟩) ≠ 0) {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) :
    (X.chartMap hj v hv).val ⟨f / X.chartDen j a, div_chartDen_mem_chartAlg hf⟩ =
      v.val (X.ofPiece hf) / v.val (X.chartMono j a) :=
  X.chartVal_eq hj hv _ hf rfl

/-- `|f^{(c)}_i / f^{(c)}_{j_c}|_{ι_j(v)} = |z^{(c)}_i|_v / |z^{(c)}_{j_c}|_v`. -/
theorem chartMap_val_coord_div (hj : ∀ c, X.coord c (j c) ≠ 0) {v : Berk k X.S}
    (hv : ∀ c, v.val (X.coordElem ⟨c, j c⟩) ≠ 0) (c : Fin r) (i : Fin (X.M c + 1)) :
    (X.chartMap hj v hv).val ⟨X.coord c i / X.coord c (j c), X.coord_div_mem_chartAlg j c i⟩ =
      v.val (X.coordElem ⟨c, i⟩) / v.val (X.coordElem ⟨c, j c⟩) := by
  rw [X.chartMap_val_eq hj hv _ (X.coord_mem_piece c i) (by rw [chartDen_single]),
    X.chartMono_single]
  rfl

theorem continuous_chartMap_comp (hj : ∀ c, X.coord c (j c) ≠ 0) {Y : Type*} [TopologicalSpace Y]
    {g : Y → Berk k X.S} (hg : Continuous g) (hgv : ∀ y c, (g y).val (X.coordElem ⟨c, j c⟩) ≠ 0) :
    Continuous fun y => X.chartMap hj (g y) (hgv y) := by
  refine Berk.continuous_iff.2 fun x => ?_
  change Continuous fun y => X.chartVal j hj (g y) x
  unfold chartVal
  exact Continuous.div₀ ((Berk.continuous_val_apply _).comp hg)
    ((Berk.continuous_val_apply _).comp hg) fun y => val_chartMono_ne_zero (hgv y) _

/-! ### Part (2): the inverse chart -/

variable (X j) in
/-- The scale `μ_c(y) = max_i |f^{(c)}_i / f^{(c)}_{j_c}|_y`. -/
def chartScale (y : Berk k (X.chartAlg j)) (c : Fin r) : ℝ≥0 :=
  Finset.univ.sup fun i : Fin (X.M c + 1) =>
    y.val ⟨X.coord c i / X.coord c (j c), X.coord_div_mem_chartAlg j c i⟩

/-- `μ_c(y) ≥ 1`: the term `i = j_c` is `|1|_y = 1`. -/
theorem one_le_chartScale (hj : ∀ c, X.coord c (j c) ≠ 0) (y : Berk k (X.chartAlg j))
    (c : Fin r) : 1 ≤ X.chartScale j y c := by
  have h1 : (⟨X.coord c (j c) / X.coord c (j c), X.coord_div_mem_chartAlg j c (j c)⟩ :
      X.chartAlg j) = 1 := Subtype.ext (div_self (hj c))
  refine le_trans ?_ (Finset.le_sup (f := fun i : Fin (X.M c + 1) =>
    y.val ⟨X.coord c i / X.coord c (j c), X.coord_div_mem_chartAlg j c i⟩) (Finset.mem_univ (j c)))
  rw [h1, map_one]

theorem chartScale_ne_zero (hj : ∀ c, X.coord c (j c) ≠ 0) (y : Berk k (X.chartAlg j))
    (c : Fin r) : X.chartScale j y c ≠ 0 :=
  (zero_lt_one.trans_le (one_le_chartScale hj y c)).ne'

variable (X j) in
theorem continuous_chartScale (c : Fin r) :
    Continuous fun y : Berk k (X.chartAlg j) => X.chartScale j y c :=
  Continuous.finset_sup_apply fun _ _ => Berk.continuous_val_apply _

variable (X j) in
/-- `μ(y)^a = ∏_c μ_c(y)^{a_c}`. -/
def chartScalePow (y : Berk k (X.chartAlg j)) (a : Fin r →₀ ℕ) : ℝ≥0 :=
  ∏ c, X.chartScale j y c ^ a c

theorem chartScalePow_add (y : Berk k (X.chartAlg j)) (a b : Fin r →₀ ℕ) :
    X.chartScalePow j y (a + b) = X.chartScalePow j y a * X.chartScalePow j y b := by
  simp [chartScalePow, pow_add, Finset.prod_mul_distrib]

@[simp]
theorem chartScalePow_zero (y : Berk k (X.chartAlg j)) : X.chartScalePow j y 0 = 1 := by
  simp [chartScalePow]

theorem chartScalePow_single (y : Berk k (X.chartAlg j)) (c : Fin r) :
    X.chartScalePow j y (Finsupp.single c 1) = X.chartScale j y c := by
  rw [chartScalePow, Finset.prod_eq_single c (fun d _ hdc => by
    rw [Finsupp.single_eq_of_ne hdc, pow_zero]) (by simp)]
  simp

theorem chartScalePow_ne_zero (hj : ∀ c, X.coord c (j c) ≠ 0) (y : Berk k (X.chartAlg j))
    (a : Fin r →₀ ℕ) : X.chartScalePow j y a ≠ 0 :=
  Finset.prod_ne_zero_iff.2 fun c _ => pow_ne_zero _ (chartScale_ne_zero hj y c)

variable (X j) in
theorem continuous_chartScalePow (a : Fin r →₀ ℕ) :
    Continuous fun y : Berk k (X.chartAlg j) => X.chartScalePow j y a :=
  continuous_finsetProd _ fun c _ => (X.continuous_chartScale j c).pow _

open Classical in
variable (X j) in
/-- The function `N(g T^a) = |g / z̃_j^a|_y / μ(y)^a` on homogeneous elements (set to `0` off
`S_a`), whose multigraded extension is the inverse chart. -/
def chartNorm (y : Berk k (X.chartAlg j)) (a : Fin r →₀ ℕ) (f : K) : ℝ≥0 :=
  (if h : f ∈ X.piece a then y.val ⟨f / X.chartDen j a, div_chartDen_mem_chartAlg h⟩ else 0) /
    X.chartScalePow j y a

theorem chartNorm_of_mem (y : Berk k (X.chartAlg j)) {a : Fin r →₀ ℕ} {f : K}
    (hf : f ∈ X.piece a) :
    X.chartNorm j y a f =
      y.val ⟨f / X.chartDen j a, div_chartDen_mem_chartAlg hf⟩ / X.chartScalePow j y a := by
  rw [chartNorm, dif_pos hf]

/-- The function `N` satisfies the hypotheses of the multigraded extension lemma. -/
theorem isMultigradedNorm_chartNorm (hj : ∀ c, X.coord c (j c) ≠ 0)
    (y : Berk k (X.chartAlg j)) : X.IsMultigradedNorm (X.chartNorm j y) where
  map_zero a := by
    rw [X.chartNorm_of_mem y (Submodule.zero_mem _)]
    have : (⟨0 / X.chartDen j a, div_chartDen_mem_chartAlg (Submodule.zero_mem _)⟩ :
        X.chartAlg j) = 0 := Subtype.ext (zero_div _)
    rw [this, map_zero, zero_div]
  map_algebraMap c hc := by
    rw [X.chartNorm_of_mem y (X.algebraMap_mem_piece_zero c), chartScalePow_zero, div_one]
    have : (⟨algebraMap k K c / X.chartDen j 0,
        div_chartDen_mem_chartAlg (X.algebraMap_mem_piece_zero c)⟩ : X.chartAlg j) =
        algebraMap k (X.chartAlg j) c := Subtype.ext (by simp)
    rw [this, y.val_algebraMap c hc]
  map_mul {a b f g} hf hg := by
    rw [X.chartNorm_of_mem y hf, X.chartNorm_of_mem y hg,
      X.chartNorm_of_mem y (mul_mem_piece hf hg), X.chartScalePow_add, div_mul_div_comm,
      ← map_mul]
    congr 2
    refine Subtype.ext ?_
    change f * g / X.chartDen j (a + b) = f / X.chartDen j a * (g / X.chartDen j b)
    rw [X.chartDen_add, div_mul_div_comm]
  map_add_le {a f g} hf hg := by
    rw [X.chartNorm_of_mem y hf, X.chartNorm_of_mem y hg,
      X.chartNorm_of_mem y (Submodule.add_mem _ hf hg), max_div_div_right zero_le]
    gcongr
    have : (⟨(f + g) / X.chartDen j a, div_chartDen_mem_chartAlg (Submodule.add_mem _ hf hg)⟩ :
        X.chartAlg j) = ⟨f / X.chartDen j a, div_chartDen_mem_chartAlg hf⟩ +
          ⟨g / X.chartDen j a, div_chartDen_mem_chartAlg hg⟩ := Subtype.ext (add_div _ _ _)
    rw [this]
    exact y.val.map_add _ _
  sup_coord c := by
    have h : ∀ i : Fin (X.M c + 1), X.chartNorm j y (Finsupp.single c 1) (X.coord c i) =
        y.val ⟨X.coord c i / X.coord c (j c), X.coord_div_mem_chartAlg j c i⟩ /
          X.chartScale j y c := by
      intro i
      rw [X.chartNorm_of_mem y (X.coord_mem_piece c i), chartScalePow_single]
      congr 2
      refine Subtype.ext ?_
      change X.coord c i / X.chartDen j (Finsupp.single c 1) = X.coord c i / X.coord c (j c)
      rw [chartDen_single]
    simp_rw [h]
    rw [← NNReal.finset_sup_div]
    exact div_self (chartScale_ne_zero hj y c)

variable (X j) in
/-- The **inverse chart** `(Spec A_j)^an → 𝒳^an` (`lem:gl-charts`(2)): the multigraded extension of
`N(g T^a) = |g / z̃_j^a|_y ∏_c μ_c(y)^{-a_c}`. -/
def chartInv (hj : ∀ c, X.coord c (j c) ≠ 0) (y : Berk k (X.chartAlg j)) : X.an :=
  X.ofMultigradedNorm (isMultigradedNorm_chartNorm hj y)

theorem chartInv_val_ofPiece (hj : ∀ c, X.coord c (j c) ≠ 0) (y : Berk k (X.chartAlg j))
    {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) :
    (X.chartInv j hj y).1.val (X.ofPiece hf) =
      y.val ⟨f / X.chartDen j a, div_chartDen_mem_chartAlg hf⟩ / X.chartScalePow j y a := by
  rw [chartInv, ofMultigradedNorm_val_ofPiece, chartNorm_of_mem _ hf]

theorem chartInv_val_chartMono (hj : ∀ c, X.coord c (j c) ≠ 0) (y : Berk k (X.chartAlg j))
    (a : Fin r →₀ ℕ) :
    (X.chartInv j hj y).1.val (X.chartMono j a) = (X.chartScalePow j y a)⁻¹ := by
  rw [chartMono, chartInv_val_ofPiece]
  have : (⟨X.chartDen j a / X.chartDen j a, div_chartDen_mem_chartAlg (X.chartDen_mem_piece j a)⟩ :
      X.chartAlg j) = 1 := Subtype.ext (div_self (chartDen_ne_zero hj a))
  rw [this, map_one, one_div]

theorem chartInv_val_coordElem_ne_zero (hj : ∀ c, X.coord c (j c) ≠ 0)
    (y : Berk k (X.chartAlg j)) (c : Fin r) :
    (X.chartInv j hj y).1.val (X.coordElem ⟨c, j c⟩) ≠ 0 := by
  rw [← X.chartMono_single, chartInv_val_chartMono]
  exact inv_ne_zero (chartScalePow_ne_zero hj y _)

theorem chartInv_mem_chartDomain (hj : ∀ c, X.coord c (j c) ≠ 0) (y : Berk k (X.chartAlg j)) :
    X.chartInv j hj y ∈ X.chartDomain j :=
  mem_chartDomain_iff.2 (chartInv_val_coordElem_ne_zero hj y)

/-- `ι_j ∘ ι_j⁻¹ = id`. -/
theorem chartMap_chartInv (hj : ∀ c, X.coord c (j c) ≠ 0) (y : Berk k (X.chartAlg j)) :
    X.chartMap hj (X.chartInv j hj y).1 (chartInv_val_coordElem_ne_zero hj y) = y := by
  refine Berk.ext_val fun x => ?_
  obtain ⟨a, f, hf, hx⟩ := (mem_chartAlg_iff hj).1 x.2
  rw [X.chartMap_val_eq hj _ x hf hx, chartInv_val_ofPiece, chartInv_val_chartMono,
    div_inv_eq_mul, div_mul_cancel₀ _ (chartScalePow_ne_zero hj y a)]
  exact congrArg y.val (Subtype.ext hx.symm)

/-- The scales of `ι_j(v)`: `μ_c(ι_j(v)) = |z^{(c)}_{j_c}|_v⁻¹` at a normalized point. -/
theorem chartScale_chartMap (hj : ∀ c, X.coord c (j c) ≠ 0) {v : Berk k X.S}
    (hvn : X.IsNormalized v) (hv : ∀ c, v.val (X.coordElem ⟨c, j c⟩) ≠ 0) (c : Fin r) :
    X.chartScale j (X.chartMap hj v hv) c = (v.val (X.coordElem ⟨c, j c⟩))⁻¹ := by
  rw [chartScale]
  simp_rw [X.chartMap_val_coord_div hj hv]
  rw [← NNReal.finset_sup_div, hvn c, one_div]

/-- `ι_j⁻¹ ∘ ι_j = id` on `U_j`. -/
theorem chartInv_chartMap (hj : ∀ c, X.coord c (j c) ≠ 0) (v : X.an) (hv : v ∈ X.chartDomain j) :
    X.chartInv j hj (X.chartMap hj v.1 (mem_chartDomain_iff.1 hv)) = v := by
  refine Subtype.ext (ext_of_ofPiece (X.chartInv j hj _).2.1 v.2.1 fun a f hf => ?_)
  have hv' := mem_chartDomain_iff.1 hv
  rw [chartInv_val_ofPiece, chartMap_val_div]
  have hμ : X.chartScalePow j (X.chartMap hj v.1 hv') a = (v.1.val (X.chartMono j a))⁻¹ := by
    rw [chartScalePow, val_chartMono, ← Finset.prod_inv_distrib]
    refine Finset.prod_congr rfl fun c _ => ?_
    rw [X.chartScale_chartMap hj v.2.2 hv' c, inv_pow]
  rw [hμ, div_inv_eq_mul, div_mul_cancel₀ _ (val_chartMono_ne_zero hv' a)]

theorem continuous_chartInv (hj : ∀ c, X.coord c (j c) ≠ 0) :
    Continuous (X.chartInv j hj) := by
  refine X.continuous_iff_an.2 fun p => ?_
  have e : (fun y => (X.chartInv j hj y).1.val p) = fun y =>
      p.1.support.sup fun a => y.val ⟨p.1.coeff a / X.chartDen j a,
        div_chartDen_mem_chartAlg (X.coeff_mem_piece p.2 a)⟩ / X.chartScalePow j y a := by
    funext y
    change X.multigradedFun (X.chartNorm j y) p = _
    rw [multigradedFun]
    exact Finset.sup_congr rfl fun a _ => X.chartNorm_of_mem y (X.coeff_mem_piece p.2 a)
  rw [e]
  exact Continuous.finset_sup_apply fun a _ => Continuous.div₀ (Berk.continuous_val_apply _)
    (X.continuous_chartScalePow j a) fun y => chartScalePow_ne_zero hj y a

variable (X j) in
/-- **`lem:gl-charts`(2).** The chart homeomorphism `ι_j : U_j ≃ₜ (Spec A_j)^an`,
`|g / z̃_j^a|_{ι_j(v)} = |g T^a|_v / |z_j^a|_v`, for a chart index with all `f^{(c)}_{j_c} ≠ 0`. -/
def chartHomeomorph (hj : ∀ c, X.coord c (j c) ≠ 0) : X.chartDomain j ≃ₜ Berk k (X.chartAlg j) where
  toFun v := X.chartMap hj v.1.1 (mem_chartDomain_iff.1 v.2)
  invFun y := ⟨X.chartInv j hj y, chartInv_mem_chartDomain hj y⟩
  left_inv v := Subtype.ext (chartInv_chartMap hj v.1 v.2)
  right_inv y := chartMap_chartInv hj y
  continuous_toFun := X.continuous_chartMap_comp hj
    ((continuous_subtype_val.comp continuous_subtype_val))
    fun v => mem_chartDomain_iff.1 v.2
  continuous_invFun := (continuous_chartInv hj).subtype_mk _

theorem chartHomeomorph_apply (hj : ∀ c, X.coord c (j c) ≠ 0) (v : X.chartDomain j) :
    X.chartHomeomorph j hj v = X.chartMap hj v.1.1 (mem_chartDomain_iff.1 v.2) :=
  rfl

theorem coe_chartHomeomorph_symm_apply (hj : ∀ c, X.coord c (j c) ≠ 0)
    (y : Berk k (X.chartAlg j)) :
    ((X.chartHomeomorph j hj).symm y : X.an) = X.chartInv j hj y :=
  rfl

/-- **`lem:gl-charts`(2)**, the formula for the chart homeomorphism. -/
theorem chartHomeomorph_val_div (hj : ∀ c, X.coord c (j c) ≠ 0) (v : X.chartDomain j)
    {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) :
    (X.chartHomeomorph j hj v).val ⟨f / X.chartDen j a, div_chartDen_mem_chartAlg hf⟩ =
      v.1.1.val (X.ofPiece hf) / v.1.1.val (X.chartMono j a) :=
  chartMap_val_div hj (mem_chartDomain_iff.1 v.2) hf

theorem isOpenEmbedding_chartInv (hj : ∀ c, X.coord c (j c) ≠ 0) :
    IsOpenEmbedding (X.chartInv j hj) :=
  (X.isOpen_chartDomain j).isOpenEmbedding_subtypeVal.comp
    (X.chartHomeomorph j hj).symm.isOpenEmbedding

theorem range_chartInv (hj : ∀ c, X.coord c (j c) ≠ 0) :
    Set.range (X.chartInv j hj) = X.chartDomain j := by
  ext v
  refine ⟨?_, fun hv => ⟨X.chartMap hj v.1 (mem_chartDomain_iff.1 hv), chartInv_chartMap hj v hv⟩⟩
  rintro ⟨y, rfl⟩
  exact chartInv_mem_chartDomain hj y

/-- `ι_j(⋆) = v_triv` (`lem:gl-charts`(2)). -/
theorem chartMap_triv (hj : ∀ c, X.coord c (j c) ≠ 0)
    (h : ∀ c, (X.triv : Berk k X.S).val (X.coordElem ⟨c, j c⟩) ≠ 0) :
    X.chartMap hj (X.triv : Berk k X.S) h = Berk.triv := by
  classical
  refine Berk.ext_val fun x => ?_
  obtain ⟨a, f, hf, hx⟩ := (mem_chartAlg_iff hj).1 x.2
  rw [X.chartMap_val_eq hj h x hf hx]
  have hz : X.chartMono j a ≠ 0 := by
    intro h0
    have := congrArg (fun p : X.S => (p : MvPolynomial (Fin r) K)) h0
    simp only [chartMono, coe_ofPiece, ZeroMemClass.coe_zero, monomial_eq_zero] at this
    exact chartDen_ne_zero hj a this
  rw [X.triv_val_of_ne_zero hz]
  by_cases hx0 : x = 0
  · subst hx0
    have hf0 : f = 0 := by
      have := hx.symm
      rw [ZeroMemClass.coe_zero, div_eq_zero_iff] at this
      exact this.resolve_right (chartDen_ne_zero hj a)
    subst hf0
    rw [X.ofPiece_zero, map_zero, map_zero, zero_div]
  · have hf0 : X.ofPiece hf ≠ 0 := by
      intro h0
      have := congrArg (fun p : X.S => (p : MvPolynomial (Fin r) K)) h0
      simp only [coe_ofPiece, ZeroMemClass.coe_zero, monomial_eq_zero] at this
      exact hx0 (Subtype.ext (by rw [hx, this, zero_div]; rfl))
    rw [X.triv_val_of_ne_zero hf0, Berk.triv_val_of_ne_zero hx0, div_one]

/-- `ι_j(⋆) = v_triv` for the chart homeomorphism. -/
theorem chartHomeomorph_triv (hj : ∀ c, X.coord c (j c) ≠ 0) (h : X.triv ∈ X.chartDomain j) :
    X.chartHomeomorph j hj ⟨X.triv, h⟩ = Berk.triv :=
  chartMap_triv hj (mem_chartDomain_iff.1 h)

/-! ### Part (3): the cover -/

variable (X) in
/-- **`lem:gl-charts`(3).** For every `v ∈ 𝒳^an` there is a chart index `j` with
`|z^{(c)}_{j_c}|_v = 1` for all `c`; then all `f^{(c)}_{j_c} ≠ 0` and `v ∈ U_j`. -/
theorem exists_chartIndex (v : X.an) :
    ∃ j : X.ChartIndex, (∀ c, X.coord c (j c) ≠ 0) ∧ ∀ c, v.1.val (X.coordElem ⟨c, j c⟩) = 1 := by
  choose j hj using v.2.2.exists_val_coordElem_eq_one
  refine ⟨j, fun c h0 => ?_, hj⟩
  have h : X.coordElem ⟨c, j c⟩ = 0 := Subtype.ext (by simp [h0])
  have := hj c
  rw [h, map_zero] at this
  exact zero_ne_one this

variable (X j) in
/-- The set `{v : |z^{(c)}_{j_c}|_v = 1 for all c} ⊆ U_j`. -/
def chartUnitDomain : Set X.an :=
  {v | ∀ c, v.1.val (X.coordElem ⟨c, j c⟩) = 1}

theorem chartUnitDomain_subset : X.chartUnitDomain j ⊆ X.chartDomain j := fun v hv =>
  mem_chartDomain_iff.2 fun c => by rw [hv c]; exact one_ne_zero

variable (X) in
/-- **`lem:gl-charts`(3).** The sets `{v : |z^{(c)}_{j_c}|_v = 1 ∀ c}`, over the chart indices with
all `f^{(c)}_{j_c} ≠ 0`, cover `𝒳^an`. -/
theorem iUnion_chartUnitDomain :
    (⋃ (j : X.ChartIndex) (_ : ∀ c, X.coord c (j c) ≠ 0), X.chartUnitDomain j) = Set.univ := by
  refine Set.eq_univ_of_forall fun v => ?_
  obtain ⟨j, hj, hv⟩ := X.exists_chartIndex v
  exact Set.mem_iUnion₂.2 ⟨j, hj, hv⟩

/-! ### Elements of `K` as quotients of homogeneous elements -/

variable (X) in
/-- There is a chart index with all `f^{(c)}_{j_c} ≠ 0` (by (M1)). -/
theorem exists_chartIndex_ne_zero : ∃ j : X.ChartIndex, ∀ c, X.coord c (j c) ≠ 0 := by
  choose j hj using X.exists_coord_ne_zero
  exact ⟨j, hj⟩

variable (X) in
include X in
/-- `K` is a finitely generated field extension of `k` (`def:gl-model`): it is generated by a
finite generating set of the finitely generated algebra `A_j`, whose fraction field is `K`. -/
theorem fg_top_intermediateField : (⊤ : IntermediateField k K).FG := by
  obtain ⟨j, hj⟩ := X.exists_chartIndex_ne_zero
  have := isFractionRing_chartAlg hj
  obtain ⟨t, ht⟩ := X.fg_chartAlg j
  refine ⟨t, eq_top_iff.2 fun z _ => ?_⟩
  have hle : X.chartAlg j ≤ (IntermediateField.adjoin k (t : Set K)).toSubalgebra := by
    rw [← ht]
    exact IntermediateField.algebra_adjoin_le_adjoin k _
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (X.chartAlg j) z
  exact div_mem (hle a.2) (hle b.2)

variable (X) in
/-- Every element of `K` is a quotient `f / g` of elements `f, g ∈ S_a`, `g ≠ 0`, of the same
degree. -/
theorem exists_eq_div (x : K) :
    ∃ (a : Fin r →₀ ℕ) (f g : K), f ∈ X.piece a ∧ g ∈ X.piece a ∧ g ≠ 0 ∧ x = f / g := by
  obtain ⟨j, hj⟩ := X.exists_chartIndex_ne_zero
  have := isFractionRing_chartAlg hj
  obtain ⟨α, β, hβ, rfl⟩ := IsFractionRing.div_surjective (X.chartAlg j) x
  obtain ⟨a, f, hf, hα⟩ := (mem_chartAlg_iff hj).1 α.2
  obtain ⟨b, g, hg, hβ'⟩ := (mem_chartAlg_iff hj).1 β.2
  have hβ0 : (β : K) ≠ 0 := fun h => nonZeroDivisors.ne_zero hβ (Subtype.ext h)
  have hg0 : g ≠ 0 := by
    rintro rfl
    rw [zero_div] at hβ'
    exact hβ0 hβ'
  refine ⟨a + b, f * X.chartDen j b, g * X.chartDen j a,
    mul_mem_piece hf (X.chartDen_mem_piece j b), ?_,
    mul_ne_zero hg0 (chartDen_ne_zero hj a), ?_⟩
  · rw [add_comm a b]
    exact mul_mem_piece hg (X.chartDen_mem_piece j a)
  · change (α : K) / (β : K) = _
    rw [hα, hβ']
    field_simp [chartDen_ne_zero hj a, chartDen_ne_zero hj b]

/-! ### The absolute value on `K` at a point with generic support (`def:gl-points`) -/

/-- At a point with generic support, `ι_j(v)` vanishes only at `0`. -/
theorem chartMap_val_ne_zero (hj : ∀ c, X.coord c (j c) ≠ 0) {v : Berk k X.S}
    (hv : ∀ c, v.val (X.coordElem ⟨c, j c⟩) ≠ 0) (hg : X.HasGenericSupport v)
    {x : X.chartAlg j} (hx : x ≠ 0) : (X.chartMap hj v hv).val x ≠ 0 := by
  obtain ⟨a, f, hf, hxf⟩ := (mem_chartAlg_iff hj).1 x.2
  rw [X.chartMap_val_eq hj hv x hf hxf]
  refine div_ne_zero (hg _ fun h0 => hx ?_) (val_chartMono_ne_zero hv a)
  have := congrArg (fun p : X.S => (p : MvPolynomial (Fin r) K)) h0
  simp only [coe_ofPiece, ZeroMemClass.coe_zero, monomial_eq_zero] at this
  exact Subtype.ext (by rw [hxf, this, zero_div]; rfl)

/-- The extension of `ι_j(v)` from `A_j` to its fraction field `K`, for `v` with generic
support. -/
def chartFieldVal (hj : ∀ c, X.coord c (j c) ≠ 0) (v : Berk k X.S)
    (hv : ∀ c, v.val (X.coordElem ⟨c, j c⟩) ≠ 0) (hg : X.HasGenericSupport v) :
    Valuation K ℝ≥0 :=
  haveI := isFractionRing_chartAlg hj
  (X.chartMap hj v hv).val.extendToLocalization
    (S := nonZeroDivisors (X.chartAlg j))
    (fun x hx => by
      change x ∉ (X.chartMap hj v hv).val.supp
      rw [Valuation.mem_supp_iff]
      exact chartMap_val_ne_zero hj hv hg (nonZeroDivisors.ne_zero hx)) K

/-- `|f / g| = |f T^a|_v / |g T^a|_v` for `f, g ∈ S_a` (both sides vanish if `g = 0`). -/
theorem chartFieldVal_div (hj : ∀ c, X.coord c (j c) ≠ 0) {v : Berk k X.S}
    (hv : ∀ c, v.val (X.coordElem ⟨c, j c⟩) ≠ 0) (hg : X.HasGenericSupport v)
    {a : Fin r →₀ ℕ} {f g : K} (hf : f ∈ X.piece a) (hgm : g ∈ X.piece a) :
    X.chartFieldVal hj v hv hg (f / g) = v.val (X.ofPiece hf) / v.val (X.ofPiece hgm) := by
  have := isFractionRing_chartAlg hj
  have hD := chartDen_ne_zero hj a
  have e : f / g = algebraMap (X.chartAlg j) K ⟨f / X.chartDen j a, div_chartDen_mem_chartAlg hf⟩ /
      algebraMap (X.chartAlg j) K ⟨g / X.chartDen j a, div_chartDen_mem_chartAlg hgm⟩ := by
    change f / g = (f / X.chartDen j a) / (g / X.chartDen j a)
    rw [div_div_div_cancel_right₀ hD]
  rw [e, map_div₀, chartFieldVal, Valuation.extendToLocalization_apply_map_apply,
    Valuation.extendToLocalization_apply_map_apply, chartMap_val_div, chartMap_val_div,
    div_div_div_cancel_right₀ (val_chartMono_ne_zero hv a)]

variable (X) in
/-- **The absolute value of a point with generic support** (`def:gl-points`): for `v ∈ 𝒳^an` with
generic support, the absolute value `|f / g|_v = |f T^a|_v / |g T^a|_v` on `K` (`fieldVal_div`),
constructed through a chart containing `v` (`exists_chartIndex`). -/
def fieldVal (v : X.an) (hg : X.HasGenericSupport v.1) : Valuation K ℝ≥0 :=
  X.chartFieldVal (X.exists_chartIndex v).choose_spec.1 v.1
    (fun c => by rw [(X.exists_chartIndex v).choose_spec.2 c]; exact one_ne_zero) hg

/-- `|f / g|_v = |f T^a|_v / |g T^a|_v` for `f, g ∈ S_a` (both sides vanish if `g = 0`). -/
theorem fieldVal_div (v : X.an) (hg : X.HasGenericSupport v.1) {a : Fin r →₀ ℕ} {f g : K}
    (hf : f ∈ X.piece a) (hgm : g ∈ X.piece a) :
    X.fieldVal v hg (f / g) = v.1.val (X.ofPiece hf) / v.1.val (X.ofPiece hgm) :=
  chartFieldVal_div _ _ hg hf hgm

/-- The absolute value of a point with generic support is trivial on `k`. -/
theorem fieldVal_algebraMap (v : X.an) (hg : X.HasGenericSupport v.1) {c : k} (hc : c ≠ 0) :
    X.fieldVal v hg (algebraMap k K c) = 1 := by
  have h := X.fieldVal_div v hg (X.algebraMap_mem_piece_zero c) X.one_mem_piece_zero
  rw [div_one, X.ofPiece_algebraMap, X.ofPiece_one, map_one, div_one,
    v.1.val_algebraMap c hc] at h
  exact h

/-- Two valuations on `K` satisfying the formula of `fieldVal_div` agree: the absolute value of a
point with generic support does not depend on the chart. -/
theorem eq_fieldVal (v : X.an) (hg : X.HasGenericSupport v.1) (w : Valuation K ℝ≥0)
    (hw : ∀ (a : Fin r →₀ ℕ) (f g : K) (hf : f ∈ X.piece a) (hgm : g ∈ X.piece a), g ≠ 0 →
      w (f / g) = v.1.val (X.ofPiece hf) / v.1.val (X.ofPiece hgm)) :
    w = X.fieldVal v hg := by
  ext x
  obtain ⟨a, f, g, hf, hgm, hg0, rfl⟩ := X.exists_eq_div x
  rw [hw a f g hf hgm hg0, X.fieldVal_div v hg hf hgm]

end MultiModel

end EnvelopeProperty
