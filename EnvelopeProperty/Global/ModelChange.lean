import EnvelopeProperty.Global.ModelNormalization
import EnvelopeProperty.Global.ModelQuotient
import EnvelopeProperty.Global.Sections
import EnvelopeProperty.Berkovich.Finite

/-!
# Change of model

This file implements the point-level part of the blueprint node `lem:gl-model-change` of
`global.tex` (subsection `subsec:gl-model`) for the formalization of Fang–Han–Xia, *The envelope
property for unibranch projective varieties* (FHX `prop:BJ-package`): two models
`𝒳 = (K, S, z)` and `𝒳' = (K, S', z')` with the same function field, `S ⊆ S' ⊆ S^ν`, and coordinates
mutually integral in each degree (`MultiModel.IsModelChange`) have the same points when the chart
algebras of `𝒳` are integrally closed.

## The monic root estimate in one degree

`MultiModel.val_ofPiece_le_sup_of_isIntegral`: if `g T^e` is integral over the subalgebra
generated by homogeneous elements `w_i T^e` of the same degree `e ≠ 0`, then
`|g T^e|_v ≤ max_i |w_i T^e|_v` for **every** multiplicative seminorm `v` on `S` (multigraded or
not). Proof: the coefficient of `T^{n e}` of an integral equation is a homogeneous integral equation
`G^n + ∑_{i<n} c_i G^i = 0` with `c_i` homogeneous of degree `(n - i) e` in `k[w]`, so
`|c_i|_v ≤ ρ^{n-i}` (`ρ = max_i |w_i T^e|_v`, `MultiModel.homNorm_coeff_le`); if `|G|_v > ρ` the
term `G^n` dominates. This is "the monic root estimate of `lem:gl-points-basic`(1) in both
directions" of the blueprint's proof, and gives the equivalence of the two normalization
conditions.

## The ideal argument

`MultiModel.exists_mem_piece_mul_zCoeff`: if the chart algebras `A_j` of `𝒳` are integrally closed
and `f T^a ∈ K[T]` is integral over `S`, then there is `b ∈ ℕ^r` with `f z̃^β ∈ S_{a+b}` for every
`β ∈ Mon(b)`, i.e. `S^ν_a ⊆ R_a(𝒳)` in the language of sections (`def:gl-sections`). Each
`f / z̃_j^a` is integral over `A_j`, hence lies in `A_j`, so `f z̃_j^{c_j} ∈ S_{a + c_j}`; with
`C = ∑_j c_j` and `b_c = (M_c + 1) C_c`, every `β ∈ Mon(b)` contains, in each block `c`, some
coordinate `z^{(c)}_{j_c}` with exponent `≥ C_c` (pigeonhole), so `z^β` is a multiple of `z_j^C` for
the chart `j = (j_c)` (or `z̃^β = 0`). This replaces the blueprint's radical argument ("a prime
containing all `z_j` contains a whole block of coordinates") by an explicit exponent.

## Points (`lem:gl-model-change`)

For `h : IsModelChange 𝒳 𝒳'`, restriction `v' ↦ v'|_S` (`IsModelChange.restrictAn`) maps `𝒳'^an`
to `𝒳^an`; it is continuous and surjective (`IsModelChange.restrictAn_surjective`: extend `v` to a
seminorm on `S'` by integrality, `Berk.comap_surjective_of_isIntegral`, and make it multigraded by
the multigraded extension lemma, `ofMultigradedNorm`; the normalization condition for `z'` follows
from the monic root estimate). If every element of `S'_a` is a section of `𝒳` of degree `a`
(`IsModelChange.HasSections`; e.g. by the ideal argument when the chart algebras of `𝒳` are
integrally closed, `IsModelChange.hasSections`, or trivially when `S' = S`,
`IsModelChange.hasSections_of_eq`), restriction is injective and
`|f T^a|_{v'} = max_{β ∈ Mon(b)} |f z̃^β T^{a+b}|_{v'|_S}` (`IsModelChange.val_ofPiece_eq_sup`), so
`IsModelChange.restrictHomeomorph : 𝒳'^an ≃ₜ 𝒳^an` (a continuous bijection of compact Hausdorff
spaces). It maps `⋆` to `⋆` (`IsModelChange.restrictAn_triv`).

`MultiModel.withCoords`: the same `S` with other coordinates (used for the bridge
`rmk:gl-bridges` of a model generated in degree 1 with a `ProjSubvariety`).

The comparison of sections, Fubini–Study and psh functions and cones (`R_a(𝒳) = R_a(𝒳')` with
equal values, `PSH(𝒳, θ) = PSH(𝒳', θ)`, `C(𝒳) = C(𝒳')`) is in
`EnvelopeProperty.Global.ModelChangeSections`.
-/

open scoped NNReal ENNReal Topology

open Topology MvPolynomial

noncomputable section

namespace EnvelopeProperty

universe u

namespace MultiModel

variable {k : Type u} [Field k] {K : Type u} [Field K] [Algebra k K] {r : ℕ}

/-! ### Subalgebras generated in one degree and the monic root estimate -/

section Degree

variable (X : MultiModel k K r)

/-- The subalgebra `k[z^{(c)}_0, …, z^{(c)}_{M_c}] ⊆ K[T]` generated by the coordinates of degree
`e_c`. -/
abbrev blockAlg (c : Fin r) : Subalgebra k (MvPolynomial (Fin r) K) :=
  Algebra.adjoin k (Set.range fun j : Fin (X.M c + 1) =>
    monomial (Finsupp.single c 1) (X.coord c j))

variable {X}

theorem nsmul_eq_nsmul_iff {e : Fin r →₀ ℕ} (he : e ≠ 0) {m n : ℕ} : m • e = n • e ↔ m = n := by
  refine ⟨fun h => ?_, fun h => h ▸ rfl⟩
  obtain ⟨d, hd⟩ := Finsupp.ne_iff.1 he
  have := congrArg (fun a : Fin r →₀ ℕ => a d) h
  simp only [Finsupp.smul_apply, smul_eq_mul, Finsupp.coe_zero, Pi.zero_apply] at this hd
  exact Nat.eq_of_mul_eq_mul_right (Nat.pos_of_ne_zero hd) this

theorem homNorm_smul_le (v : Berk k X.S) {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) (c : k) :
    X.homNorm v a (c • f) ≤ X.homNorm v a f := by
  rw [X.homNorm_of_mem v (Submodule.smul_mem _ c hf), X.homNorm_of_mem v hf]
  have e : X.ofPiece (Submodule.smul_mem _ c hf) = algebraMap k X.S c * X.ofPiece hf :=
    Subtype.ext (by
      rw [coe_ofPiece, Subalgebra.coe_mul, Subalgebra.coe_algebraMap, coe_ofPiece,
        ← smul_monomial, Algebra.smul_def])
  rw [e, map_mul]
  calc v.val (algebraMap k X.S c) * v.val (X.ofPiece hf) ≤ 1 * v.val (X.ofPiece hf) := by
        gcongr; exact Berk.abs_algebraMap_le_one v c
    _ = v.val (X.ofPiece hf) := one_mul _

variable {ι : Type*} {e : Fin r →₀ ℕ} {w : ι → K}

/-- The subalgebra generated by the `w_i T^e` lies in `S`. -/
theorem adjoin_monomial_le (hw : ∀ i, w i ∈ X.piece e) :
    Algebra.adjoin k (Set.range fun i => monomial e (w i)) ≤ X.S :=
  Algebra.adjoin_le (Set.range_subset_iff.2 hw)

/-- The coefficients of an element of `k[w_i T^e]` lie in the pieces of `S`. -/
theorem coeff_mem_piece_of_mem_adjoin (hw : ∀ i, w i ∈ X.piece e) {q : MvPolynomial (Fin r) K}
    (hq : q ∈ Algebra.adjoin k (Set.range fun i => monomial e (w i))) (a : Fin r →₀ ℕ) :
    q.coeff a ∈ X.piece a :=
  adjoin_monomial_le hw (monomial_coeff_mem_adjoin (s := Set.range fun i => monomial e (w i))
    (fun p hp => by obtain ⟨i, rfl⟩ := hp; exact ⟨e, w i, rfl⟩) hq a)

/-- Products of the generators `w_i T^e` are monomials `f T^{n e}` with `|f T^{n e}|_v ≤ ρ^n`,
`ρ = max_i |w_i T^e|_v`. -/
theorem exists_eq_monomial_of_mem_closure [Fintype ι] (hw : ∀ i, w i ∈ X.piece e) (v : Berk k X.S)
    {x : MvPolynomial (Fin r) K}
    (hx : x ∈ Submonoid.closure (Set.range fun i => monomial e (w i))) :
    ∃ n : ℕ, x = monomial (n • e) (x.coeff (n • e)) ∧ x.coeff (n • e) ∈ X.piece (n • e) ∧
      X.homNorm v (n • e) (x.coeff (n • e)) ≤
        (Finset.univ.sup fun i => v.val (X.ofPiece (hw i))) ^ n := by
  set ρ := Finset.univ.sup fun i => v.val (X.ofPiece (hw i))
  induction hx using Submonoid.closure_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    refine ⟨1, by rw [one_smul, coeff_monomial, if_pos rfl], ?_, ?_⟩
    · rw [one_smul, coeff_monomial, if_pos rfl]; exact hw i
    · have e1 : (monomial e (w i)).coeff (1 • e) = w i := by rw [one_smul, coeff_monomial, if_pos rfl]
      have hm : (monomial e (w i)).coeff (1 • e) ∈ X.piece (1 • e) := by rw [e1, one_smul]; exact hw i
      rw [X.homNorm_of_mem v hm, pow_one]
      refine le_trans (le_of_eq ?_) (Finset.le_sup (f := fun i => v.val (X.ofPiece (hw i)))
        (Finset.mem_univ i))
      exact congrArg v.val (X.ofPiece_congr _ _ (one_smul _ _) e1)
  | one =>
    refine ⟨0, by rw [zero_smul, coeff_one, if_pos rfl, ← C_apply, C_1], ?_, ?_⟩
    · rw [zero_smul, coeff_one, if_pos rfl]; exact X.one_mem_piece_zero
    · have e1 : (1 : MvPolynomial (Fin r) K).coeff (0 • e) = 1 := by
        rw [zero_smul, coeff_one, if_pos rfl]
      have hm : (1 : MvPolynomial (Fin r) K).coeff (0 • e) ∈ X.piece (0 • e) := by
        rw [e1, zero_smul]; exact X.one_mem_piece_zero
      rw [X.homNorm_of_mem v hm, pow_zero, show X.ofPiece hm = X.ofPiece X.one_mem_piece_zero from
        X.ofPiece_congr _ _ (zero_smul _ _) e1, X.ofPiece_one, map_one]
  | mul x y _ _ ihx ihy =>
    obtain ⟨n, hxn, hxm, hxv⟩ := ihx
    obtain ⟨n', hyn, hym, hyv⟩ := ihy
    have hc : (x * y).coeff ((n + n') • e) = x.coeff (n • e) * y.coeff (n' • e) := by
      conv_lhs => rw [hxn, hyn]
      rw [monomial_mul, ← add_nsmul, coeff_monomial, if_pos rfl]
    have hm : x.coeff (n • e) * y.coeff (n' • e) ∈ X.piece ((n + n') • e) := by
      rw [add_nsmul]; exact mul_mem_piece hxm hym
    refine ⟨n + n', ?_, hc ▸ hm, ?_⟩
    · conv_lhs => rw [hxn, hyn]
      rw [monomial_mul, ← add_nsmul, hc]
    · rw [X.homNorm_of_mem v (hc ▸ hm), pow_add]
      rw [X.homNorm_of_mem v hxm] at hxv
      rw [X.homNorm_of_mem v hym] at hyv
      have e2 : X.ofPiece (hc ▸ hm) = X.ofPiece hxm * X.ofPiece hym := by
        rw [← X.ofPiece_mul]
        exact X.ofPiece_congr _ _ (add_nsmul _ _ _) hc
      rw [e2, map_mul]
      exact mul_le_mul' hxv hyv

/-- **Homogeneous parts of `k[w_i T^e]`**: for `q ∈ k[w_i T^e]` and every `m`, the homogeneous
component `q_{m e} T^{m e}` has `|q_{m e} T^{m e}|_v ≤ ρ^m`, `ρ = max_i |w_i T^e|_v`, for every
multiplicative seminorm `v` on `S`. -/
theorem homNorm_coeff_le [Fintype ι] (he : e ≠ 0) (hw : ∀ i, w i ∈ X.piece e) (v : Berk k X.S)
    {q : MvPolynomial (Fin r) K} (hq : q ∈ Algebra.adjoin k (Set.range fun i => monomial e (w i)))
    (m : ℕ) :
    X.homNorm v (m • e) (q.coeff (m • e)) ≤
      (Finset.univ.sup fun i => v.val (X.ofPiece (hw i))) ^ m := by
  set ρ := Finset.univ.sup fun i => v.val (X.ofPiece (hw i))
  have hq' : q ∈ Submodule.span k (Submonoid.closure (Set.range fun i => monomial e (w i)) :
      Set (MvPolynomial (Fin r) K)) := by
    rw [← Algebra.adjoin_eq_span]; exact hq
  clear hq
  suffices h : q.coeff (m • e) ∈ X.piece (m • e) ∧ X.homNorm v (m • e) (q.coeff (m • e)) ≤ ρ ^ m
    from h.2
  induction hq' using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨n, hxn, hxm, hxv⟩ := exists_eq_monomial_of_mem_closure hw v hx
    by_cases hnm : n = m
    · subst hnm; exact ⟨hxm, hxv⟩
    · have h0 : x.coeff (m • e) = 0 := by
        rw [hxn, coeff_monomial, if_neg fun h => hnm ((nsmul_eq_nsmul_iff he).1 h)]
      rw [h0, homNorm_apply_zero]
      exact ⟨Submodule.zero_mem _, zero_le⟩
  | zero =>
    rw [coeff_zero, homNorm_apply_zero]
    exact ⟨Submodule.zero_mem _, zero_le⟩
  | add x y _ _ hx hy =>
    rw [coeff_add]
    exact ⟨Submodule.add_mem _ hx.1 hy.1, (homNorm_add_le_max v hx.1 hy.1).trans (max_le hx.2 hy.2)⟩
  | smul c x _ hx =>
    rw [coeff_smul]
    exact ⟨Submodule.smul_mem _ c hx.1, (homNorm_smul_le v hx.1 c).trans hx.2⟩

/-- **The monic root estimate in one degree.** If `g T^e` (`e ≠ 0`) is integral over the
subalgebra generated by homogeneous elements `w_i T^e` of the same degree, then
`|g T^e|_v ≤ max_i |w_i T^e|_v` for every multiplicative seminorm `v` on `S`. -/
theorem val_ofPiece_le_sup_of_isIntegral [Fintype ι] (he : e ≠ 0) (hw : ∀ i, w i ∈ X.piece e)
    (v : Berk k X.S) {g : K} (hg : g ∈ X.piece e)
    (hint : IsIntegral (Algebra.adjoin k (Set.range fun i => monomial e (w i))) (monomial e g)) :
    v.val (X.ofPiece hg) ≤ Finset.univ.sup fun i => v.val (X.ofPiece (hw i)) := by
  set ρ := Finset.univ.sup fun i => v.val (X.ofPiece (hw i))
  set B := Algebra.adjoin k (Set.range fun i => monomial e (w i))
  set γ := v.val (X.ofPiece hg)
  by_contra hlt
  rw [not_le] at hlt
  obtain ⟨P, hPm, hP⟩ := hint
  set n := P.natDegree
  set c : Fin n → K := fun i => (P.coeff i).1.coeff ((n - i) • e)
  have hc : ∀ i : Fin n, c i ∈ X.piece ((n - i) • e) := fun i =>
    coeff_mem_piece_of_mem_adjoin hw (P.coeff i).2 _
  -- The homogeneous integral equation `g^n + ∑ c_i g^i = 0` in `K`.
  have hterm : ∀ i : Fin n,
      ((algebraMap B (MvPolynomial (Fin r) K) (P.coeff i)) * monomial e g ^ (i : ℕ)).coeff (n • e) =
        c i * g ^ (i : ℕ) := by
    intro i
    have hle : (i : ℕ) • e ≤ n • e := nsmul_le_nsmul_left (zero_le) i.2.le
    have hsub : n • e - (i : ℕ) • e = (n - i) • e := by
      ext d
      simp [Nat.sub_mul]
    rw [monomial_pow, coeff_mul_monomial', if_pos hle, hsub]
    rfl
  have key := congrArg (fun q : MvPolynomial (Fin r) K => q.coeff (n • e)) hP
  rw [hPm.as_sum, Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum,
    coeff_add, coeff_sum, Finset.sum_range (fun i => (Polynomial.eval₂
      (algebraMap B (MvPolynomial (Fin r) K)) (monomial e g)
        (Polynomial.C (P.coeff i) * Polynomial.X ^ i)).coeff (n • e))] at key
  simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow] at key
  rw [Finset.sum_congr rfl fun i _ => hterm i, monomial_pow, coeff_monomial, if_pos rfl,
    coeff_zero] at key
  -- The same equation in `S`.
  have hdeg : ∀ i : Fin n, (n - i) • e + (i : ℕ) • e = n • e := fun i => by
    rw [← add_nsmul, Nat.sub_add_cancel i.2.le]
  have heq : X.ofPiece hg ^ n + ∑ i : Fin n, X.ofPiece (hc i) * X.ofPiece hg ^ (i : ℕ) = 0 := by
    apply Subtype.ext
    rw [Subalgebra.coe_add, Subalgebra.coe_pow, coe_ofPiece, AddSubmonoidClass.coe_finsetSum,
      ZeroMemClass.coe_zero, monomial_pow]
    simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, coe_ofPiece, monomial_pow, monomial_mul,
      hdeg]
    rw [← map_sum, ← map_add, key, map_zero]
  -- Valuations: the term `g^n` dominates.
  have hγ0 : γ ≠ 0 := (zero_le.trans_lt hlt).ne'
  have hlt' : ∀ i : Fin n, v.val (X.ofPiece (hc i) * X.ofPiece hg ^ (i : ℕ)) < γ ^ n := by
    intro i
    rw [map_mul, map_pow]
    have hci : v.val (X.ofPiece (hc i)) ≤ ρ ^ (n - i) := by
      have := homNorm_coeff_le he hw v (P.coeff i).2 (n - i)
      rwa [X.homNorm_of_mem v (hc i)] at this
    have hpos : n - (i : ℕ) ≠ 0 := Nat.sub_ne_zero_of_lt i.2
    calc v.val (X.ofPiece (hc i)) * γ ^ (i : ℕ) ≤ ρ ^ (n - i) * γ ^ (i : ℕ) := by gcongr
      _ < γ ^ (n - i) * γ ^ (i : ℕ) :=
        mul_lt_mul_of_pos_right (pow_lt_pow_left₀ hlt zero_le hpos)
          (pow_pos (pos_iff_ne_zero.2 hγ0) _)
      _ = γ ^ n := by rw [← pow_add, Nat.sub_add_cancel i.2.le]
  have hsum : v.val (∑ i : Fin n, X.ofPiece (hc i) * X.ofPiece hg ^ (i : ℕ)) < γ ^ n :=
    v.val.map_sum_lt (pow_ne_zero _ hγ0) fun i _ => hlt' i
  have h1 := v.val.map_add_eq_of_lt_left (x := X.ofPiece hg ^ n)
    (y := ∑ i : Fin n, X.ofPiece (hc i) * X.ofPiece hg ^ (i : ℕ)) (by rwa [map_pow])
  rw [heq, map_zero, map_pow] at h1
  exact pow_ne_zero _ hγ0 h1.symm

end Degree

/-! ### The ideal argument -/

section Ideal

variable (X : MultiModel k K r)

/-- `(deg β)_c = ∑_j β^{(c)}_j`. -/
theorem monDeg_apply (β : X.CoordIndex →₀ ℕ) (c : Fin r) :
    X.monDeg β c = ∑ j : Fin (X.M c + 1), β ⟨c, j⟩ := by
  classical
  rw [monDeg, Finsupp.mapDomain, Finsupp.sum_apply, Finsupp.sum]
  simp only [Finsupp.single_apply]
  rw [Finset.sum_subset (Finset.subset_univ β.support) fun i _ hi => by
    rw [Finsupp.notMem_support_iff.1 hi]; simp, Fintype.sum_sigma]
  rw [Finset.sum_eq_single c (fun d _ hdc => Finset.sum_eq_zero fun j _ => if_neg hdc)
    (by simp)]
  exact Finset.sum_congr rfl fun j _ => if_pos rfl

variable {X}

/-- For a chart index `j` (all `f^{(c)}_{j_c} ≠ 0`), if `f T^a` is integral over `S` and `A_j` is
integrally closed, then `f z̃_j^{c} ∈ S_{a + c}` for some `c`. -/
theorem exists_mul_chartDen_mem_piece {j : X.ChartIndex} (hj : ∀ c, X.coord c (j c) ≠ 0)
    (hA : IsIntegrallyClosed (X.chartAlg j)) {a : Fin r →₀ ℕ} {f : K}
    (hf : IsIntegral X.S (monomial a f)) :
    ∃ c : Fin r →₀ ℕ, f * X.chartDen j c ∈ X.piece (a + c) := by
  have := isFractionRing_chartAlg hj
  -- `f / z̃_j^a` is integral over `A_j`.
  obtain ⟨P, hPm, hP⟩ := hf
  let δ : X.S →+* X.chartAlg j :=
    ((X.dehom j).comp X.S.val).toRingHom.codRestrict _ fun p => Subalgebra.mem_map.2 ⟨p.1, p.2, rfl⟩
  have hint : IsIntegral (X.chartAlg j) (f / X.chartDen j a) := by
    refine ⟨P.map δ, hPm.map δ, ?_⟩
    rw [Polynomial.eval₂_map]
    have hcomp : (algebraMap (X.chartAlg j) K).comp δ =
        (X.dehom j : MvPolynomial (Fin r) K →+* K).comp (algebraMap X.S (MvPolynomial (Fin r) K)) :=
      RingHom.ext fun _ => rfl
    rw [hcomp, ← X.dehom_monomial j a f]
    have h2 := Polynomial.hom_eval₂ P (algebraMap X.S (MvPolynomial (Fin r) K))
      (X.dehom j : MvPolynomial (Fin r) K →+* K) (monomial a f)
    rw [hP, map_zero] at h2
    exact h2.symm
  obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.1 hint
  obtain ⟨a', g, hg, hyg⟩ := (mem_chartAlg_iff hj).1 y.2
  refine ⟨a', ?_⟩
  have e : f * X.chartDen j a' = g * X.chartDen j a := by
    have h1 : f / X.chartDen j a = g / X.chartDen j a' := hy.symm.trans hyg
    rw [div_eq_div_iff (chartDen_ne_zero hj a) (chartDen_ne_zero hj a')] at h1
    rw [h1]
  rw [e, add_comm]
  exact mul_mem_piece hg (X.chartDen_mem_piece j a)

theorem chartMultiIndex_apply (j : X.ChartIndex) (C : Fin r →₀ ℕ) (i : X.CoordIndex) :
    X.chartMultiIndex j C i = if i.2 = j i.1 then C i.1 else 0 := by
  classical
  obtain ⟨c, l⟩ := i
  rw [chartMultiIndex, Finsupp.finsetSum_apply, Finset.sum_eq_single c
    (fun d _ hdc => Finsupp.single_eq_of_ne (fun h => hdc (congrArg Sigma.fst h).symm))
    (by simp)]
  by_cases h : l = j c
  · subst h; rw [Finsupp.single_eq_same, if_pos rfl]
  · rw [Finsupp.single_eq_of_ne (fun h' => h (by
      have := (Sigma.mk.inj_iff.1 h').2
      exact eq_of_heq this)), if_neg h]

/-- **The ideal argument** (proof of `lem:gl-model-change`): if the chart algebras of `𝒳` are
integrally closed and `f T^a` is integral over `S`, there is `b ∈ ℕ^r` with `f z̃^β ∈ S_{a+b}` for
every `β ∈ Mon(b)`; i.e. `S^ν_a ⊆ R_a(𝒳)` (`def:gl-sections`). -/
theorem exists_mem_piece_mul_zCoeff
    (hX : ∀ j : X.ChartIndex, (∀ c, X.coord c (j c) ≠ 0) → IsIntegrallyClosed (X.chartAlg j))
    {a : Fin r →₀ ℕ} {f : K} (hf : IsIntegral X.S (monomial a f)) :
    ∃ b : Fin r →₀ ℕ, ∀ β ∈ X.monSet b, f * X.zCoeff β ∈ X.piece (a + b) := by
  classical
  -- For every chart index with nonzero coordinates, an exponent `c_j`.
  have hc : ∀ j : X.ChartIndex, ∃ c : Fin r →₀ ℕ, (∀ i, X.coord i (j i) ≠ 0) →
      f * X.chartDen j c ∈ X.piece (a + c) := by
    intro j
    by_cases hj : ∀ i, X.coord i (j i) ≠ 0
    · obtain ⟨c, hc⟩ := exists_mul_chartDen_mem_piece hj (hX j hj) hf
      exact ⟨c, fun _ => hc⟩
    · exact ⟨0, fun h => absurd h hj⟩
  choose c hc using hc
  set C : Fin r →₀ ℕ := ∑ j, c j
  have hC : ∀ j : X.ChartIndex, (∀ i, X.coord i (j i) ≠ 0) →
      f * X.chartDen j C ∈ X.piece (a + C) := by
    intro j hj
    have hle : c j ≤ C := Finset.single_le_sum (f := c) (fun _ _ => zero_le) (Finset.mem_univ j)
    have := mul_mem_piece (hc j hj) (X.chartDen_mem_piece j (C - c j))
    rwa [mul_assoc, ← X.chartDen_add, add_assoc, add_tsub_cancel_of_le hle] at this
  set b : Fin r →₀ ℕ := Finsupp.equivFunOnFinite.symm fun c => (X.M c + 1) * C c
  refine ⟨b, fun β hβ => ?_⟩
  have hβb : X.monDeg β = b := (X.mem_monSet).1 hβ
  -- If a coordinate occurring in `β` vanishes, `z̃^β = 0`.
  by_cases hz : ∃ i ∈ β.support, X.coord i.1 i.2 = 0
  · obtain ⟨i, hi, hi0⟩ := hz
    have h0 : X.zCoeff β = 0 := by
      rw [zCoeff, Finsupp.prod]
      exact Finset.prod_eq_zero hi (by rw [hi0, zero_pow (Finsupp.mem_support_iff.1 hi)])
    rw [h0, mul_zero]
    exact Submodule.zero_mem _
  push Not at hz
  -- Pigeonhole: in each block some exponent is `≥ C_c`.
  have hpig : ∀ c' : Fin r, ∃ j' : Fin (X.M c' + 1), X.coord c' j' ≠ 0 ∧ C c' ≤ β ⟨c', j'⟩ := by
    intro c'
    by_cases hC0 : C c' = 0
    · obtain ⟨j', hj'⟩ := X.exists_coord_ne_zero c'
      exact ⟨j', hj', by rw [hC0]; exact zero_le⟩
    · by_contra hcon
      push Not at hcon
      have hlt : ∀ j' : Fin (X.M c' + 1), β ⟨c', j'⟩ < C c' := by
        intro j'
        by_cases hj' : X.coord c' j' = 0
        · have : β ⟨c', j'⟩ = 0 := by
            by_contra hne
            exact hz _ (Finsupp.mem_support_iff.2 hne) hj'
          rw [this]; exact Nat.pos_of_ne_zero hC0
        · exact hcon j' hj'
      have hsum := Finset.sum_lt_sum_of_nonempty Finset.univ_nonempty fun j' _ => hlt j'
      rw [← monDeg_apply, hβb, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
        smul_eq_mul] at hsum
      change (X.M c' + 1) * C c' < (X.M c' + 1) * C c' at hsum
      exact lt_irrefl _ hsum
  choose j hj hjβ using hpig
  set γ := X.chartMultiIndex j C
  have hγβ : γ ≤ β := by
    rintro ⟨c', j'⟩
    rw [chartMultiIndex_apply]
    split_ifs with hi
    · simp only at hi
      subst hi
      exact hjβ c'
    · exact zero_le
  have e : β = γ + (β - γ) := (add_tsub_cancel_of_le hγβ).symm
  have hdeg : a + C + X.monDeg (β - γ) = a + b := by
    rw [add_assoc, ← X.monDeg_chartMultiIndex j C, ← monDeg_add, ← e, hβb]
  have hmem := mul_mem_piece (hC j hj) (X.zCoeff_mem_piece (β - γ))
  rw [hdeg, ← X.zCoeff_chartMultiIndex j C, mul_assoc, ← zCoeff_add, ← e] at hmem
  exact hmem

end Ideal

/-! ### Changing the coordinates -/

section WithCoords

variable (X : MultiModel k K r)

/-- The model with the same `K` and `S` and other coordinates `z'` of the same degrees, provided
`S` is integral over `k[z']` and (M1) holds for `z'`. -/
abbrev withCoords (M' : Fin r → ℕ) (coord' : (c : Fin r) → Fin (M' c + 1) → K)
    (hmem : ∀ c j, coord' c j ∈ X.piece (Finsupp.single c 1))
    (hne : ∀ c, ∃ j, coord' c j ≠ 0)
    (hint : ∀ p ∈ X.S, IsIntegral (Algebra.adjoin k (Set.range
      fun i : (Σ c, Fin (M' c + 1)) => monomial (Finsupp.single i.1 1) (coord' i.1 i.2))) p) :
    MultiModel k K r where
  S := X.S
  isGraded := X.isGraded
  fg := X.fg
  M := M'
  coord := coord'
  coord_mem := hmem
  exists_coord_ne_zero := hne
  isIntegral := hint
  generates := X.generates

end WithCoords

/-! ### Change of model -/

section ModelChange

/-- The hypotheses of **change of model** (`lem:gl-model-change`) for two models with the same
function field: `S ⊆ S' ⊆ S^ν` (`S'` integral over `S`), and every coordinate of either model is
integral over the coordinates of the other in the same degree. -/
structure IsModelChange (X X' : MultiModel k K r) : Prop where
  le : X.S ≤ X'.S
  isIntegral : ∀ p ∈ X'.S, IsIntegral X.S p
  coord_isIntegral : ∀ c j, IsIntegral (X.blockAlg c)
    (monomial (Finsupp.single c 1) (X'.coord c j))
  coord_isIntegral' : ∀ c j, IsIntegral (X'.blockAlg c)
    (monomial (Finsupp.single c 1) (X.coord c j))

namespace IsModelChange

variable {X X' : MultiModel k K r} (h : IsModelChange X X')

/-- The inclusion `S → S'`. -/
def inclHom : X.S →ₐ[k] X'.S :=
  Subalgebra.inclusion h.le

@[simp]
theorem coe_inclHom (p : X.S) : (h.inclHom p : MvPolynomial (Fin r) K) = p :=
  rfl

theorem inclHom_injective : Function.Injective h.inclHom :=
  Subalgebra.inclusion_injective h.le

include h in
theorem mem_piece {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) : f ∈ X'.piece a :=
  h.le hf

theorem inclHom_ofPiece {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) :
    h.inclHom (X.ofPiece hf) = X'.ofPiece (h.mem_piece hf) :=
  rfl

theorem inclHom_homComp (a : Fin r →₀ ℕ) (p : X.S) :
    h.inclHom (X.homComp a p) = X'.homComp a (h.inclHom p) :=
  rfl

theorem inclHom_coordElem (i : X.CoordIndex) :
    h.inclHom (X.coordElem i) = X'.ofPiece (h.mem_piece (X.coord_mem_piece i.1 i.2)) :=
  rfl

/-- `S'` is integral over `S`. -/
theorem isIntegral_inclHom : (h.inclHom : X.S →+* X'.S).IsIntegral := by
  intro q
  obtain ⟨P, hPm, hP⟩ := h.isIntegral q.1 q.2
  refine ⟨P, hPm, Subtype.val_injective ?_⟩
  change X'.S.val.toRingHom (Polynomial.eval₂ (h.inclHom : X.S →+* X'.S) q P) = 0
  rw [Polynomial.hom_eval₂]
  exact hP

/-- At a point `y` of `(Spec S')^an` whose restriction to `S` is bounded by `1`, every element of
`S'` has `|·|_y ≤ 1` (integrality). -/
theorem val_le_one_of_comap {y : Berk k X'.S} (hy : ∀ p : X.S, y.val (h.inclHom p) ≤ 1)
    (q : X'.S) : y.val q ≤ 1 := by
  obtain ⟨P, hPm, hP⟩ := h.isIntegral_inclHom q
  refine Valuation.le_one_of_monic_eval_eq_zero y.val (f := P.map (h.inclHom : X.S →+* X'.S))
    (hPm.map _) (fun i => ?_) ?_
  · rw [Polynomial.coeff_map]; exact hy _
  · rw [Polynomial.eval_map]; exact hP

/-- If `v'` on `S'` is normalized for the coordinates `z'`, its restriction is normalized for `z`:
`|z^{(c)}_j| ≤ 1` since `z ∈ S'`, and `1 = |z'^{(c)}_{j'}| ≤ max_j |z^{(c)}_j|` by the monic root
estimate. -/
theorem isNormalized_comap {y : Berk k X'.S} (hy : X'.IsNormalized y) :
    X.IsNormalized (Berk.comap h.inclHom y) := by
  intro c
  refine le_antisymm (Finset.sup_le fun j _ => ?_) ?_
  · rw [Berk.comap_val_apply]
    exact hy.val_le_one _
  · obtain ⟨j', hj'⟩ := hy.exists_val_coordElem_eq_one c
    rw [← hj']
    have hw : ∀ j : Fin (X.M c + 1), X.coord c j ∈ X'.piece (Finsupp.single c 1) := fun j =>
      h.mem_piece (X.coord_mem_piece c j)
    have := X'.val_ofPiece_le_sup_of_isIntegral (Finsupp.single_ne_zero.2 one_ne_zero) hw y
      (X'.coord_mem_piece c j') (h.coord_isIntegral c j')
    refine this.trans (le_of_eq (Finset.sup_congr rfl fun j _ => ?_))
    rfl

theorem isMultigraded_comap {y : Berk k X'.S} (hy : X'.IsMultigraded y) :
    X.IsMultigraded (Berk.comap h.inclHom y) := fun p a => hy (h.inclHom p) a

/-- **Restriction of points** `𝒳'^an → 𝒳^an`, `v' ↦ v'|_S` (`lem:gl-model-change`). -/
def restrictAn (v : X'.an) : X.an :=
  ⟨Berk.comap h.inclHom v.1, h.isMultigraded_comap v.2.1, h.isNormalized_comap v.2.2⟩

theorem restrictAn_val (v : X'.an) (p : X.S) : (h.restrictAn v).1.val p = v.1.val (h.inclHom p) :=
  rfl

theorem restrictAn_val_ofPiece (v : X'.an) {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) :
    (h.restrictAn v).1.val (X.ofPiece hf) = v.1.val (X'.ofPiece (h.mem_piece hf)) :=
  rfl

theorem continuous_restrictAn : Continuous h.restrictAn :=
  X.continuous_iff_an.2 fun p =>
    (Berk.continuous_val_apply (h.inclHom p)).comp continuous_subtype_val

theorem restrictAn_triv : h.restrictAn X'.triv = X.triv := by
  classical
  refine Subtype.ext (Berk.ext_val fun p => ?_)
  rw [restrictAn_val]
  by_cases hp : p = 0
  · rw [hp, map_zero, map_zero, map_zero]
  · rw [X.triv_val_of_ne_zero hp, X'.triv_val_of_ne_zero fun h0 =>
      hp (h.inclHom_injective (h0.trans (map_zero _).symm))]

/-- The values of a seminorm on homogeneous elements satisfy the hypotheses of the multigraded
extension lemma as soon as it is normalized. -/
theorem _root_.EnvelopeProperty.MultiModel.isMultigradedNorm_homNorm_of_isNormalized
    {Y : MultiModel k K r} {v : Berk k Y.S} (hv : Y.IsNormalized v) :
    Y.IsMultigradedNorm (Y.homNorm v) where
  map_zero a := by rw [Y.homNorm_of_mem v (Submodule.zero_mem _), Y.ofPiece_zero, map_zero]
  map_algebraMap c hc := by
    rw [Y.homNorm_of_mem v (Y.algebraMap_mem_piece_zero c), Y.ofPiece_algebraMap,
      v.val_algebraMap c hc]
  map_mul hf hg := by
    rw [Y.homNorm_of_mem v (mul_mem_piece hf hg), Y.homNorm_of_mem v hf, Y.homNorm_of_mem v hg,
      Y.ofPiece_mul, map_mul]
  map_add_le hf hg := homNorm_add_le_max v hf hg
  sup_coord c := by
    simp_rw [Y.homNorm_of_mem v (Y.coord_mem_piece c _)]
    exact hv c

/-- **Surjectivity of restriction** (`lem:gl-model-change`): a point `v ∈ 𝒳^an` extends to a
seminorm `y` on `S'` (`S'` integral over `S`); `y` is normalized for `z'` (monic root estimate),
and the multigraded extension of its values on homogeneous elements restricts to `v`. -/
theorem restrictAn_surjective : Function.Surjective h.restrictAn := by
  intro v
  obtain ⟨y, hy⟩ := Berk.comap_surjective_of_isIntegral h.inclHom h.isIntegral_inclHom
    h.inclHom_injective v.1
  have hyv : ∀ p : X.S, y.val (h.inclHom p) = v.1.val p := fun p => by
    rw [← Berk.comap_val_apply, hy]
  have hyn : X'.IsNormalized y := by
    intro c
    refine le_antisymm (Finset.sup_le fun j _ => ?_) ?_
    · exact h.val_le_one_of_comap (fun p => by rw [hyv]; exact val_le_one v.2 p) _
    · obtain ⟨j, hj⟩ := v.2.2.exists_val_coordElem_eq_one c
      have hw : ∀ j' : Fin (X'.M c + 1), X'.coord c j' ∈ X'.piece (Finsupp.single c 1) :=
        fun j' => X'.coord_mem_piece c j'
      have := X'.val_ofPiece_le_sup_of_isIntegral (Finsupp.single_ne_zero.2 one_ne_zero) hw y
        (h.mem_piece (X.coord_mem_piece c j)) (h.coord_isIntegral' c j)
      rw [← hj, ← hyv]
      exact this
  have hN := isMultigradedNorm_homNorm_of_isNormalized hyn
  refine ⟨X'.ofMultigradedNorm hN, Subtype.ext (ext_of_ofPiece (h.restrictAn _).2.1 v.2.1
    fun a f hf => ?_)⟩
  rw [restrictAn_val_ofPiece, ofMultigradedNorm_val_ofPiece, X'.homNorm_of_mem y, ← hyv]
  rfl

/-- The hypothesis that every element of `S'_a` is a section of `𝒳` of degree `a`
(`def:gl-sections`): `f z̃^β ∈ S_{a+b}` for all `β ∈ Mon(b)`, for some `b`. -/
def HasSections (X X' : MultiModel k K r) : Prop :=
  ∀ (a : Fin r →₀ ℕ) (f : K), f ∈ X'.piece a →
    ∃ b : Fin r →₀ ℕ, ∀ β ∈ X.monSet b, f * X.zCoeff β ∈ X.piece (a + b)

include h in
/-- **The ideal argument**: if the chart algebras of `𝒳` are integrally closed, the elements of
`S' ⊆ S^ν` are sections of `𝒳`. -/
theorem hasSections
    (hX : ∀ j : X.ChartIndex, (∀ c, X.coord c (j c) ≠ 0) → IsIntegrallyClosed (X.chartAlg j)) :
    HasSections X X' := fun _ _ hf =>
  exists_mem_piece_mul_zCoeff hX (h.isIntegral _ hf)

/-- If `S' = S`, every element of `S'_a` is a section of `𝒳` (take `b = 0`). -/
theorem hasSections_of_eq (hS : X'.S = X.S) : HasSections X X' := by
  intro a f hf
  refine ⟨0, fun β hβ => ?_⟩
  have hβ0 : β = 0 := by
    have := (X.mem_monSet).1 hβ
    ext i
    by_contra hne
    have h1 := congrArg (fun d : Fin r →₀ ℕ => d i.1) this
    simp only [Finsupp.coe_zero, Pi.zero_apply] at h1
    rw [monDeg_apply] at h1
    exact hne ((Finset.sum_eq_zero_iff.1 h1) i.2 (Finset.mem_univ _))
  rw [hβ0, zCoeff_zero, mul_one, add_zero]
  change monomial a f ∈ X.S
  rw [← hS]
  exact hf

/-- **The value formula** (`lem:gl-model-change`): for a section `f ∈ S'_a` with
`f z̃^β ∈ S_{a+b}` (`β ∈ Mon(b)`), `|f T^a|_{v'} = max_{β ∈ Mon(b)} |f z̃^β T^{a+b}|_{v'|_S}`. -/
theorem val_ofPiece_eq_sup (v : X'.an) {a b : Fin r →₀ ℕ} {f : K} (hf : f ∈ X'.piece a)
    (hb : ∀ β ∈ X.monSet b, f * X.zCoeff β ∈ X.piece (a + b)) :
    v.1.val (X'.ofPiece hf) =
      (X.monSet b).sup fun β => X.homNorm (h.restrictAn v).1 (a + b) (f * X.zCoeff β) := by
  have hsup := (h.restrictAn v).2.2.sup_monSet_val_zMon b
  rw [← mul_one (v.1.val (X'.ofPiece hf)), ← hsup, NNReal.mul_finset_sup]
  refine Finset.sup_congr rfl fun β hβ => ?_
  rw [X.homNorm_of_mem _ (hb β hβ), restrictAn_val, restrictAn_val, ← map_mul]
  congr 1
  apply Subtype.ext
  rw [Subalgebra.coe_mul, coe_ofPiece, coe_inclHom, coe_inclHom, zMon, coe_ofPiece,
    coe_ofPiece, monomial_mul, (X.mem_monSet).1 hβ]

/-- **Injectivity of restriction** when the elements of `S'` are sections of `𝒳`. -/
theorem restrictAn_injective (hR : HasSections X X') : Function.Injective h.restrictAn := by
  intro v₁ v₂ hv
  refine Subtype.ext (ext_of_ofPiece v₁.2.1 v₂.2.1 fun a f hf => ?_)
  obtain ⟨b, hb⟩ := hR a f hf
  rw [h.val_ofPiece_eq_sup v₁ hf hb, h.val_ofPiece_eq_sup v₂ hf hb, hv]

/-- **Change of model** (`lem:gl-model-change`, points): restriction is a homeomorphism
`𝒳'^an ≃ₜ 𝒳^an` when the elements of `S'` are sections of `𝒳` (e.g. when the chart algebras of
`𝒳` are integrally closed, `hasSections`). -/
def restrictHomeomorph (hR : HasSections X X') : X'.an ≃ₜ X.an :=
  @Continuous.homeoOfEquivCompactToT2 _ _ _ _ _ _
    (Equiv.ofBijective h.restrictAn ⟨h.restrictAn_injective hR, h.restrictAn_surjective⟩)
    h.continuous_restrictAn

@[simp]
theorem restrictHomeomorph_apply (hR : HasSections X X') (v : X'.an) :
    h.restrictHomeomorph hR v = h.restrictAn v :=
  rfl

end IsModelChange

end ModelChange

end MultiModel

end EnvelopeProperty
