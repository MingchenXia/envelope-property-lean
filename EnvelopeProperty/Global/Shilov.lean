import EnvelopeProperty.Global.DivisorialChart

/-!
# The Shilov boundary lemma on a model

Let `k` be an algebraically closed field with the trivial absolute value and
`𝒳 = (K, S, z)` an integral multiprojective model of rank `r` (`EnvelopeProperty.MultiModel`,
`def:gl-model`; possibly non-normal). This file proves the blueprint node `lem:gl-shilov` of the
global chapter `global.tex` (subsection `subsec:gl-comparison`) of the formalization of
Fang–Han–Xia, *The envelope property for unibranch projective varieties* (FHX),
i.e. Boucksom–Jonsson, *Global pluripotential theory over a trivially valued field*
(BJ22, Lemma 2.13, Lemma 4.26) on `𝒳^an`: for every `ψ ∈ 𝓗_fin(𝒳, b)` there is a finite set
`Σ ⊆ 𝒳^div` containing `⋆` such that `sup_{𝒳^an} (φ - ψ) = max_Σ (φ - ψ)` for every
Fubini–Study function `φ` of any class. It generalizes the rank-one template
`EnvelopeProperty.Projective.SubvarietyShilov` to `MultiModel`.

## The proof

After clearing denominators (`MultiModel.IsFinFS.exists_shilovSup`),
`ψ = K⁻¹ (max_i (log|s_i| - e_i) + Z)` with sections `s_i ∈ R_d` without common zero on `𝒳^an`,
`e_i ∈ ℕ`, `K ∈ ℤ_{>0}`, `Z ∈ ℤ` (`MultiModel.shilovSup`). For every chart `j` (all
`f^{(c)}_{j_c} ≠ 0`) the elements `h_i = s_i / z̃_j^d ∈ A_j` generate the unit ideal
(`MultiModel.span_sectionChart_eq_top`), so the ideal `I^{(j)} ⊆ B_j = A_j[t]` generated by
`g_i = h_i t^{e_i}` (`MultiModel.chartGen`) contains a power of `t`
(`MultiModel.exists_X_pow_mem_span_chartGen`). Its Rees valuations `V` (`Algebra/Rees.lean`,
`def:bj-rees`) are monomial in `t` with `ord_V(t) > 0` (`lem:bj-rees-invariant`), so they define
divisorial points `v_V` (`MultiModel.reesPoint`, `MultiModel.isDivisorial_reesPoint`,
`lem:gl-rees-points`). `Σ` consists of `⋆` and all `v_V`.

A single term `log|σ| + z ≤ R max_i (log|s_i| - e_i)` (`σ ∈ R_{d'}`) reads, at a point `v` with
`|z^{(c)}_{j_c}|_v = 1`, `|F|_w ≤ max_i |g_i|_w^R` for `F = (σ / z̃_j^{d'}) t^n` and the Gauss point
`w` of radius `e⁻¹` over `ι_j(v)` (`MultiModel.secAbs_eq_chartMap_of_eq_one`); `w ≤ 1` on `B_j`.
At `v = v_V` it reads `ord_V(F) ≥ R ord_V(I^{(j)})` (`MultiModel.exists_dvd_of_le_reesPoint`), and
the Rees valuations detect integral closure (`thm:bj-rees`,
`EnvelopeProperty.valuation_le_sup_pow_of_forall_dvd`). Degrees play no role: each inequality is
checked in a chart where `v` has `|z^{(c)}_{j_c}|_v = 1` (`lem:gl-charts`(3)).

## Main results

* `MultiModel.exists_finset_shilov_core` (multiplicative form) and
  `MultiModel.exists_finset_shilov_log` (logarithmic single-term form);
* **`lem:gl-shilov`**: `MultiModel.IsFinFS.exists_finset_le_of_le` (comparison form) and
  `MultiModel.IsFinFS.exists_finset_iSup_sub_eq`.

## Deviations from the blueprint

* `lem:gl-shilov` is proved for **all** `φ ∈ 𝓗(𝒳, a)`, not only those with rational weights: a term
  `m⁻¹ (log|σ| + μ)` with real `μ` is approximated from below by rational weights. Consequently the
  comparison theorem (`EnvelopeProperty.Global.Comparison`) uses the defining nets of psh functions
  directly, for every class `θ ∈ ℝ^r`.
* As in the rank-one template, the comparison form is proved first, and the normal form of `ψ`
  subtracts the largest integral weight instead of normalizing `max λ_i = 0`.
-/

open scoped NNReal ENNReal Topology Polynomial

open IsDiscreteValuationRing

noncomputable section

namespace EnvelopeProperty

universe u

namespace MultiModel

variable {k : Type u} [Field k] {K : Type u} [Field K] [Algebra k K] {r : ℕ}
  {X : MultiModel k K r}

/-! ### Sections in a chart -/

section ChartSections

variable {j : X.ChartIndex} (hj : ∀ c, X.coord c (j c) ≠ 0)

theorem val_coordElem_ne_zero_of_eq_one {v : X.an}
    (hv1 : ∀ c, v.1.val (X.coordElem ⟨c, j c⟩) = 1) (c : Fin r) :
    v.1.val (X.coordElem ⟨c, j c⟩) ≠ 0 := by
  rw [hv1 c]
  exact one_ne_zero

/-- At a point with `|z^{(c)}_{j_c}|_v = 1`, every element of `A_j` has `|·|_{ι_j(v)} ≤ 1`. -/
theorem chartMap_val_le_one_of_eq_one {v : X.an} (hv1 : ∀ c, v.1.val (X.coordElem ⟨c, j c⟩) = 1)
    (x : X.chartAlg j) :
    (X.chartMap hj v.1 (val_coordElem_ne_zero_of_eq_one hv1)).val x ≤ 1 := by
  obtain ⟨d, p, hp, hx⟩ := (mem_chartAlg_iff hj).1 x.2
  rw [X.chartMap_val_eq hj _ x hp hx, val_chartMono]
  simp only [hv1, one_pow, Finset.prod_const_one, div_one]
  exact val_le_one v.2 _

variable (X) in
/-- The element `f / z̃_j^d ∈ A_j` of a section `f ∈ R_d`. -/
def sectionChart (hj : ∀ c, X.coord c (j c) ≠ 0) {d : Fin r → ℤ} (f : X.sections d) :
    X.chartAlg j :=
  ⟨f.1 / X.chartDenZ j d, div_chartDenZ_mem_chartAlg hj f.2⟩

/-- `|f|_v = |f / z̃_j^d|_{ι_j(v)}` at a point with `|z^{(c)}_{j_c}|_v = 1`
(`lem:gl-sections`(4)). -/
theorem secAbs_eq_chartMap_of_eq_one {v : X.an} (hv1 : ∀ c, v.1.val (X.coordElem ⟨c, j c⟩) = 1)
    {d : Fin r → ℤ} (f : X.sections d) :
    X.secAbs v.1 d f =
      (X.chartMap hj v.1 (val_coordElem_ne_zero_of_eq_one hv1)).val (X.sectionChart hj f) := by
  rw [secAbs_eq_chartMap v.2.2 hj (val_coordElem_ne_zero_of_eq_one hv1) f.2]
  simp only [hv1, one_zpow, Finset.prod_const_one, mul_one]
  rfl

/-- `|f|_v = |f / z̃_j^d|_y · ∏_c μ_c(y)^{-d_c}` at `v = ι_j⁻¹(y)`. -/
theorem secAbs_chartInv (y : Berk k (X.chartAlg j)) {d : Fin r → ℤ} (f : X.sections d) :
    X.secAbs (X.chartInv j hj y).1 d f = y.val (X.sectionChart hj f) *
      ∏ c, (X.chartInv j hj y).1.val (X.coordElem ⟨c, j c⟩) ^ d c := by
  rw [secAbs_eq_chartMap (X.chartInv j hj y).2.2 hj (chartInv_val_coordElem_ne_zero hj y) f.2,
    chartMap_chartInv]
  rfl

/-- If the sections `s_i ∈ R_d` have no common zero on `𝒳^an`, then the `s_i / z̃_j^d` generate the
unit ideal of `A_j` (every point of `(Spec A_j)^an` is `ι_j(v)` for some `v ∈ U_j`). -/
theorem span_sectionChart_eq_top {ι : Type*} {d : Fin r → ℤ} (s : ι → X.sections d)
    (hz : ∀ v : X.an, ∃ i, X.secAbs v.1 d (s i) ≠ 0) :
    Ideal.span (Set.range fun i => X.sectionChart hj (s i)) = ⊤ := by
  refine Berk.span_eq_top_of_forall_exists_val_ne_zero (k := k) _ fun y => ?_
  obtain ⟨i, hi⟩ := hz (X.chartInv j hj y)
  refine ⟨_, ⟨i, rfl⟩, fun h0 => hi ?_⟩
  rw [secAbs_chartInv hj y, h0, zero_mul]

/-! ### The generators `g_i = (s_i / z̃_j^d) t^{e_i}` of `I^{(j)}` -/

variable {ι : Type*} {d : Fin r → ℤ} (s : ι → X.sections d) (e : ι → ℕ)

variable (X) in
/-- The generators `g_i = (s_i / z̃_j^d) t^{e_i} ∈ B_j = A_j[t]` of the ideal `I^{(j)}`. -/
def chartGen (hj : ∀ c, X.coord c (j c) ≠ 0) (s : ι → X.sections d) (e : ι → ℕ) (i : ι) :
    X.ChartRing j :=
  Polynomial.C (X.sectionChart hj (s i)) * Polynomial.X ^ e i

/-- `t^N ∈ I^{(j)}` for `N = max_i e_i` if the `s_i` have no common zero on `𝒳^an`. -/
theorem exists_X_pow_mem_span_chartGen [Fintype ι]
    (hz : ∀ v : X.an, ∃ i, X.secAbs v.1 d (s i) ≠ 0) :
    ∃ N : ℕ, (Polynomial.X : X.ChartRing j) ^ N ∈
      Ideal.span (Set.range (X.chartGen hj s e)) := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.1
    ((Ideal.eq_top_iff_one _).1 (span_sectionChart_eq_top hj s hz))
  set N := Finset.univ.sup e
  refine ⟨N, Ideal.mem_span_range_iff_exists_fun.2
    ⟨fun i => Polynomial.C (c i) * Polynomial.X ^ (N - e i), ?_⟩⟩
  calc ∑ i, Polynomial.C (c i) * Polynomial.X ^ (N - e i) * X.chartGen hj s e i
      = ∑ i, Polynomial.C (c i * X.sectionChart hj (s i)) * Polynomial.X ^ N := by
        refine Finset.sum_congr rfl fun i _ => ?_
        have hX : (Polynomial.X : X.ChartRing j) ^ (N - e i) * Polynomial.X ^ e i =
            Polynomial.X ^ N := by
          rw [← pow_add, Nat.sub_add_cancel (Finset.le_sup (f := e) (Finset.mem_univ i))]
        rw [chartGen, Polynomial.C_mul, ← hX]
        ring
    _ = Polynomial.X ^ N := by
        rw [← Finset.sum_mul, ← map_sum, hc, Polynomial.C_1, one_mul]

/-- The Gauss point over `y` evaluated at `(f / z̃_j^{d'}) t^n`. -/
theorem gauss_val_sectionChart (y : Berk k (X.chartAlg j)) {d' : Fin r → ℤ} (σ : X.sections d')
    (n : ℕ) :
    (Berk.gauss y ProjBerk.gaussRadius).val
        (Polynomial.C (X.sectionChart hj σ) * Polynomial.X ^ n) =
      y.val (X.sectionChart hj σ) * ProjBerk.gaussRadius ^ n :=
  Berk.gauss_val_C_mul_X_pow _ _ _ _

/-- The Gauss seminorm over `ι_j(v)` is `≤ 1` on `B_j` when `|z^{(c)}_{j_c}|_v = 1`. -/
theorem gauss_chartMap_val_le_one {v : X.an} (hv1 : ∀ c, v.1.val (X.coordElem ⟨c, j c⟩) = 1)
    (F : X.ChartRing j) :
    (Berk.gauss (X.chartMap hj v.1 (val_coordElem_ne_zero_of_eq_one hv1))
      ProjBerk.gaussRadius).val F ≤ 1 := by
  rw [Berk.gauss_val_le_iff]
  intro ℓ
  calc (X.chartMap hj v.1 (val_coordElem_ne_zero_of_eq_one hv1)).val (F.coeff ℓ) *
        ProjBerk.gaussRadius ^ ℓ ≤ 1 * 1 ^ ℓ := by
        gcongr
        · exact chartMap_val_le_one_of_eq_one hj hv1 _
        · exact ProjBerk.gaussRadius_le_one
    _ = 1 := by simp

end ChartSections

/-! ### Rees valuations of `I^{(j)}` and their divisorial points -/

section Rees

variable [IsAlgClosed k] {j : X.ChartIndex} (hj : ∀ c, X.coord c (j c) ≠ 0)
  {ι : Type*} [Fintype ι] {d : Fin r → ℤ} (s : ι → X.sections d) (e : ι → ℕ)

theorem isNoetherianRing_reesNormalChart_chartGen (ℓ : ι) :
    IsNoetherianRing (reesNormalChart (FractionRing (X.ChartRing j)) (X.chartGen hj s e) ℓ) :=
  isNoetherianRing_reesNormalChart (FractionRing (X.ChartRing j)) (X.chartGen hj s e) k ℓ

attribute [local instance] isNoetherianRing_reesNormalChart_chartGen

theorem finite_reesIndex_chartGen :
    Finite (ReesIndex (FractionRing (X.ChartRing j)) (X.chartGen hj s e)) :=
  finite_reesIndex

attribute [local instance] finite_reesIndex_chartGen

variable (X) in
/-- The Rees valuation ring `V` of `(I^{(j)}; g)` attached to `x`, as a discrete valuation ring
birational to `B_j`, essentially of finite type over `k` (`def:bj-rees`). -/
def reesDVR (hj : ∀ c, X.coord c (j c) ≠ 0) (s : ι → X.sections d) (e : ι → ℕ)
    (x : ReesIndex (FractionRing (X.ChartRing j)) (X.chartGen hj s e)) :
    BirationalDVR k (X.ChartRing j) :=
  haveI := essFiniteType_reesValuationRing k x
  BirationalDVR.ofSubalgebra (reesValuationRing _ _ x)

theorem reesDVR_ord (x : ReesIndex (FractionRing (X.ChartRing j)) (X.chartGen hj s e))
    (F : X.ChartRing j) :
    (X.reesDVR hj s e x).ord F = addVal (reesValuationRing _ _ x) (algebraMap _ _ F) :=
  rfl

variable (X) in
/-- `b = ord_V(t)` as a natural number. -/
def reesOrdX (hj : ∀ c, X.coord c (j c) ≠ 0) (s : ι → X.sections d) (e : ι → ℕ)
    (x : ReesIndex (FractionRing (X.ChartRing j)) (X.chartGen hj s e)) : ℕ :=
  ((X.reesDVR hj s e x).ord Polynomial.X).toNat

variable (X) in
/-- The divisorial point `v_V ∈ 𝒳^an` attached to a Rees valuation ring `V` of `I^{(j)}`
(`lem:gl-rees-points`). -/
def reesPoint (hj : ∀ c, X.coord c (j c) ≠ 0) (s : ι → X.sections d) (e : ι → ℕ)
    (x : ReesIndex (FractionRing (X.ChartRing j)) (X.chartGen hj s e)) : X.an :=
  X.chartDivPoint j hj (X.reesDVR hj s e x) (X.reesOrdX hj s e x)

variable (x : ReesIndex (FractionRing (X.ChartRing j)) (X.chartGen hj s e))

theorem coe_reesOrdX : ((X.reesOrdX hj s e x : ℕ) : ℕ∞) = (X.reesDVR hj s e x).ord Polynomial.X :=
  ENat.natCast_toNat ((X.reesDVR hj s e x).ord_eq_top_iff.not.2 Polynomial.X_ne_zero)

/-- `ord_V(t) > 0` (**`lem:bj-rees-invariant`**), using `t^N ∈ I^{(j)}`. -/
theorem reesOrdX_pos (hz : ∀ v : X.an, ∃ i, X.secAbs v.1 d (s i) ≠ 0) :
    0 < X.reesOrdX hj s e x := by
  have h := addVal_X_pos_reesValuationRing (exists_X_pow_mem_span_chartGen hj s e hz) x
  rw [← reesDVR_ord, ← coe_reesOrdX] at h
  exact_mod_cast h

/-- **`lem:bj-rees-invariant`** (torus invariance of the Rees valuations):
`ord_V(∑_ℓ f_ℓ t^ℓ) = min_ℓ (ord_V(f_ℓ) + ℓ ord_V(t))`. -/
theorem reesDVR_torus (F : X.ChartRing j) :
    (X.reesDVR hj s e x).ord F = F.support.inf fun ℓ =>
      (X.reesDVR hj s e x).ord (Polynomial.C (F.coeff ℓ)) +
        ((ℓ * X.reesOrdX hj s e x : ℕ) : ℕ∞) := by
  have hg : ∀ i, ∃ (a : X.chartAlg j) (m : ℕ),
      X.chartGen hj s e i = Polynomial.C a * Polynomial.X ^ m := fun i => ⟨_, _, rfl⟩
  rw [reesDVR_ord, addVal_reesValuationRing_eq_inf k hg x F]
  refine Finset.inf_congr rfl fun ℓ _ => ?_
  rw [← reesDVR_ord, ← reesDVR_ord, ← coe_reesOrdX, Nat.cast_mul, nsmul_eq_mul]

variable {s e}

/-- The points `v_V` are divisorial (`lem:gl-rees-points`). -/
theorem isDivisorial_reesPoint (hz : ∀ v : X.an, ∃ i, X.secAbs v.1 d (s i) ≠ 0) :
    X.IsDivisorial (X.reesPoint hj s e x) :=
  isDivisorial_chartDivPoint hj _ _ (reesOrdX_pos hj s e x hz) (reesDVR_torus hj s e x)

theorem reesPoint_val_coordElem (c : Fin r) :
    (X.reesPoint hj s e x).1.val (X.coordElem ⟨c, j c⟩) = 1 :=
  chartDivPoint_val_coordElem hj _ _ c

/-- The Gauss point over `ι_j(v_V)` is `F ↦ e^{-ord_V(F)/b}` on `B_j`. -/
theorem gauss_chartMap_reesPoint_val (hz : ∀ v : X.an, ∃ i, X.secAbs v.1 d (s i) ≠ 0)
    (F : X.ChartRing j) :
    (Berk.gauss (X.chartMap hj (X.reesPoint hj s e x).1
      (val_coordElem_ne_zero_of_eq_one (reesPoint_val_coordElem hj x)))
        ProjBerk.gaussRadius).val F =
      expOrd (expNeg (X.reesOrdX hj s e x : ℝ)⁻¹) ((X.reesDVR hj s e x).ord F) := by
  have hm : X.chartMap hj (X.reesPoint hj s e x).1
      (val_coordElem_ne_zero_of_eq_one (reesPoint_val_coordElem hj x)) =
        X.chartDivBerk j (X.reesDVR hj s e x) (X.reesOrdX hj s e x) :=
    chartMap_chartDivPoint hj _ _ _
  rw [hm]
  exact gauss_chartDivBerk_val _ _ (reesOrdX_pos hj s e x hz) (reesDVR_torus hj s e x) F

/-- At a point `v_V ∈ Σ`, the inequality `|F|_w ≤ max_i |g_i|_w^R` for the Gauss point `w` over
`ι_j(v_V)` says `ord_V(F) ≥ R ord_V(I^{(j)})`, i.e. `g_i^R ∣ F` in `V` for some `i`. -/
theorem exists_dvd_of_le_reesPoint [Nonempty ι]
    (hz : ∀ v : X.an, ∃ i, X.secAbs v.1 d (s i) ≠ 0) {F : X.ChartRing j} {R : ℕ}
    (h : (Berk.gauss (X.chartMap hj (X.reesPoint hj s e x).1
        (val_coordElem_ne_zero_of_eq_one (reesPoint_val_coordElem hj x)))
          ProjBerk.gaussRadius).val F ≤
      (Finset.univ.sup fun i => (Berk.gauss (X.chartMap hj (X.reesPoint hj s e x).1
        (val_coordElem_ne_zero_of_eq_one (reesPoint_val_coordElem hj x)))
          ProjBerk.gaussRadius).val (X.chartGen hj s e i)) ^ R) :
    ∃ i, algebraMap (X.ChartRing j)
        (reesValuationRing (FractionRing (X.ChartRing j)) (X.chartGen hj s e) x)
          (X.chartGen hj s e i) ^ R ∣
      algebraMap (X.ChartRing j)
        (reesValuationRing (FractionRing (X.ChartRing j)) (X.chartGen hj s e) x) F := by
  set V := X.reesDVR hj s e x
  set q := expNeg ((X.reesOrdX hj s e x : ℝ)⁻¹)
  have hb := reesOrdX_pos hj s e x hz
  have hq0 : 0 < q := zero_lt_expNeg _
  have hq1 : q < 1 := expNeg_lt_one_of_pos (inv_pos.2 (Nat.cast_pos.2 hb))
  simp only [gauss_chartMap_reesPoint_val hj x hz] at h
  obtain ⟨i₀, -, hi₀⟩ := Finset.exists_min_image Finset.univ
    (fun i => V.ord (X.chartGen hj s e i)) Finset.univ_nonempty
  have hsup : (Finset.univ.sup fun i => expOrd q (V.ord (X.chartGen hj s e i))) =
      expOrd q (V.ord (X.chartGen hj s e i₀)) :=
    le_antisymm (Finset.sup_le fun i _ => expOrd_antitone hq1.le (hi₀ i (Finset.mem_univ i)))
      (Finset.le_sup (f := fun i => expOrd q (V.ord (X.chartGen hj s e i))) (Finset.mem_univ i₀))
  rw [hsup, ← expOrd_nsmul] at h
  have hle := le_of_expOrd_le hq0 hq1 h
  refine ⟨i₀, ?_⟩
  rw [← map_pow, ← addVal_le_iff_dvd, map_pow, addVal_pow]
  exact hle

end Rees

/-! ### The Shilov boundary, multiplicative core form -/

section Core

variable [IsAlgClosed k]

attribute [local instance] isNoetherianRing_reesNormalChart_chartGen finite_reesIndex_chartGen

variable (X) in
/-- The chart indices `j` with all `f^{(c)}_{j_c} ≠ 0`. -/
abbrev GoodChart : Type := {j : X.ChartIndex // ∀ c, X.coord c (j c) ≠ 0}

/-- **The Shilov boundary on `𝒳`, core form** (`lem:gl-shilov`): for sections `s_i ∈ R_d` without
common zero on `𝒳^an` and `e_i ∈ ℕ` there is a finite set `Σ ⊆ 𝒳^div` containing `⋆` such that for
every section `σ ∈ R_{d'}` and `n, R ∈ ℕ`: if `|σ|_w e^{-n} ≤ (max_i |s_i|_w e^{-e_i})^R` for all
`w ∈ Σ`, then it holds at every `v ∈ 𝒳^an`. -/
theorem exists_finset_shilov_core {ι : Type*} [Fintype ι] {d : Fin r → ℤ}
    (s : ι → X.sections d) (e : ι → ℕ) (hz : ∀ v : X.an, ∃ i, X.secAbs v.1 d (s i) ≠ 0) :
    ∃ S : Finset X.an, X.triv ∈ S ∧ (∀ w ∈ S, X.IsDivisorial w) ∧
      ∀ (d' : Fin r → ℤ) (σ : X.sections d') (n R : ℕ),
        (∀ w ∈ S, X.secAbs w.1 d' σ * ProjBerk.gaussRadius ^ n ≤
          (Finset.univ.sup fun i => X.secAbs w.1 d (s i) * ProjBerk.gaussRadius ^ e i) ^ R) →
        ∀ v : X.an, X.secAbs v.1 d' σ * ProjBerk.gaussRadius ^ n ≤
          (Finset.univ.sup fun i => X.secAbs v.1 d (s i) * ProjBerk.gaussRadius ^ e i) ^ R := by
  have : Nonempty ι := let ⟨i, _⟩ := hz X.triv; ⟨i⟩
  have hfin : (insert X.triv (⋃ j : X.GoodChart,
      Set.range (X.reesPoint j.2 s e)) : Set X.an).Finite :=
    (Set.finite_iUnion fun j => Set.finite_range _).insert _
  have hmem : ∀ (j : X.GoodChart) x, X.reesPoint j.2 s e x ∈ hfin.toFinset := fun j x =>
    hfin.mem_toFinset.2 (Or.inr (Set.mem_iUnion.2 ⟨j, x, rfl⟩))
  refine ⟨hfin.toFinset, hfin.mem_toFinset.2 (Or.inl rfl), fun w hw => ?_,
    fun d' σ n R h v => ?_⟩
  · rcases hfin.mem_toFinset.1 hw with rfl | hw
    · exact isDivisorial_triv X
    · obtain ⟨j, x, rfl⟩ := Set.mem_iUnion.1 hw
      exact isDivisorial_reesPoint j.2 x hz
  · obtain ⟨j, hj, hv1⟩ := X.exists_chartIndex v
    have : ∀ ℓ, IsNoetherianRing (reesNormalChart (FractionRing (X.ChartRing j))
        (X.chartGen hj s e) ℓ) := fun ℓ =>
      isNoetherianRing_reesNormalChart _ (X.chartGen hj s e) k ℓ
    -- the translation of the inequality at a point with `|z^{(c)}_{j_c}| = 1` into the chart
    have htr : ∀ (w : X.an) (hw1 : ∀ c, w.1.val (X.coordElem ⟨c, j c⟩) = 1),
        (Berk.gauss (X.chartMap hj w.1 (val_coordElem_ne_zero_of_eq_one hw1))
          ProjBerk.gaussRadius).val (Polynomial.C (X.sectionChart hj σ) * Polynomial.X ^ n) =
            X.secAbs w.1 d' σ * ProjBerk.gaussRadius ^ n ∧
        ∀ i, (Berk.gauss (X.chartMap hj w.1 (val_coordElem_ne_zero_of_eq_one hw1))
          ProjBerk.gaussRadius).val (X.chartGen hj s e i) =
            X.secAbs w.1 d (s i) * ProjBerk.gaussRadius ^ e i := fun w hw1 =>
      ⟨by rw [gauss_val_sectionChart, secAbs_eq_chartMap_of_eq_one hj hw1], fun i => by
        rw [chartGen, gauss_val_sectionChart, secAbs_eq_chartMap_of_eq_one hj hw1]⟩
    have key := valuation_le_sup_pow_of_forall_dvd (K := FractionRing (X.ChartRing j))
      (g := X.chartGen hj s e)
      (Berk.gauss (X.chartMap hj v.1 (val_coordElem_ne_zero_of_eq_one hv1))
        ProjBerk.gaussRadius).val
      (gauss_chartMap_val_le_one hj hv1) (by
        obtain ⟨i, hi⟩ := hz v
        refine ⟨i, ?_⟩
        rw [(htr v hv1).2 i]
        exact mul_ne_zero hi (pow_ne_zero _ ProjBerk.gaussRadius_ne_zero))
      (F := Polynomial.C (X.sectionChart hj σ) * Polynomial.X ^ n) (r := R)
      fun x => exists_dvd_of_le_reesPoint hj x hz (by
        have h1 := h _ (hmem ⟨j, hj⟩ x)
        obtain ⟨hF, hg⟩ := htr _ (reesPoint_val_coordElem hj x)
        rw [hF]
        simp only [hg]
        exact h1)
    obtain ⟨hF, hg⟩ := htr v hv1
    rw [hF] at key
    simpa only [hg] using key

end Core

/-! ### The logarithmic form -/

section Log

variable {ι : Type*} [Fintype ι] {d : Fin r → ℤ}

variable (X) in
/-- `P(v) = max_i (log|s_i|_v - e_i)`, the normal form of a finite Fubini–Study function
(`MultiModel.IsFinFS.exists_shilovSup`). -/
def shilovSup (d : Fin r → ℤ) (s : ι → X.sections d) (e : ι → ℕ) (v : X.an) : EReal :=
  Finset.univ.sup fun i => X.logSecAbs v.1 d (s i) + ((-(e i : ℝ) : ℝ) : EReal)

theorem log_secAbs_mul_gaussRadius_pow (x : ℝ≥0) (n : ℕ) :
    ENNReal.log ((x * ProjBerk.gaussRadius ^ n : ℝ≥0) : ℝ≥0∞) =
      ENNReal.log (x : ℝ≥0∞) + ((-(n : ℝ) : ℝ) : EReal) := by
  rw [ENNReal.coe_mul, ENNReal.log_mul_add, ENNReal.coe_pow, ENNReal.log_pow,
    ProjBerk.log_gaussRadius]
  congr 1
  rw [mul_neg_one, EReal.coe_neg, EReal.coe_natCast]

theorem shilovSup_eq_log (s : ι → X.sections d) (e : ι → ℕ) (v : X.an) :
    X.shilovSup d s e v = ENNReal.log
      ((Finset.univ.sup fun i => X.secAbs v.1 d (s i) * ProjBerk.gaussRadius ^ e i : ℝ≥0) :
        ℝ≥0∞) := by
  rw [(Finset.apply_sup_eq_sup_comp_of_linearOrder (s := Finset.univ)
    (f := fun i => X.secAbs v.1 d (s i) * ProjBerk.gaussRadius ^ e i)
    (fun t : ℝ≥0 => ENNReal.log (t : ℝ≥0∞))
    (ENNReal.log_monotone.comp ENNReal.coe_mono) (by simp))]
  refine Finset.sup_congr rfl fun i _ => ?_
  rw [Function.comp_apply, log_secAbs_mul_gaussRadius_pow]
  rfl

theorem shilovSup_le_zero (s : ι → X.sections d) (e : ι → ℕ) (v : X.an) :
    X.shilovSup d s e v ≤ 0 := by
  rw [shilovSup_eq_log, ENNReal.log_le_zero_iff, ENNReal.coe_le_one_iff]
  refine Finset.sup_le fun i _ => ?_
  calc X.secAbs v.1 d (s i) * ProjBerk.gaussRadius ^ e i ≤ 1 * 1 ^ e i := by
        gcongr
        · exact secAbs_le_one v.2.2 _ _
        · exact ProjBerk.gaussRadius_le_one
    _ = 1 := by simp

theorem shilovSup_ne_bot (s : ι → X.sections d) (e : ι → ℕ)
    (hz : ∀ v : X.an, ∃ i, X.secAbs v.1 d (s i) ≠ 0) (v : X.an) :
    X.shilovSup d s e v ≠ ⊥ := by
  obtain ⟨i, hi⟩ := hz v
  refine ne_bot_of_le_ne_bot ?_ (Finset.le_sup (f := fun i =>
    X.logSecAbs v.1 d (s i) + ((-(e i : ℝ) : ℝ) : EReal)) (Finset.mem_univ i))
  rw [Ne, EReal.add_eq_bot_iff, not_or, logSecAbs_eq_bot_iff]
  exact ⟨hi, EReal.coe_ne_bot _⟩

theorem shilovSup_ne_top (s : ι → X.sections d) (e : ι → ℕ) (v : X.an) :
    X.shilovSup d s e v ≠ ⊤ :=
  ne_top_of_le_ne_top EReal.zero_ne_top (shilovSup_le_zero s e v)

theorem logSecAbs_add_le_mul_shilovSup_iff (s : ι → X.sections d) (e : ι → ℕ) (v : X.an)
    {d' : Fin r → ℤ} (σ : K) (n R : ℕ) :
    X.logSecAbs v.1 d' σ + ((-(n : ℝ) : ℝ) : EReal) ≤ ((R : ℝ) : EReal) * X.shilovSup d s e v ↔
      X.secAbs v.1 d' σ * ProjBerk.gaussRadius ^ n ≤
        (Finset.univ.sup fun i => X.secAbs v.1 d (s i) * ProjBerk.gaussRadius ^ e i) ^ R := by
  rw [shilovSup_eq_log, logSecAbs, ← log_secAbs_mul_gaussRadius_pow, EReal.coe_natCast,
    ← ENNReal.log_pow, ENNReal.log_le_log_iff, ← ENNReal.coe_pow, ENNReal.coe_le_coe]

variable [IsAlgClosed k]

/-- **The Shilov boundary on `𝒳`, single-term form**: with `Σ` as in `exists_finset_shilov_core`,
for a section `σ ∈ R_{d'}`, `z ∈ ℤ` and `R ∈ ℕ`, `log|σ| + z ≤ R P` on `Σ` implies it on `𝒳^an`. -/
theorem exists_finset_shilov_log (s : ι → X.sections d) (e : ι → ℕ)
    (hz : ∀ v : X.an, ∃ i, X.secAbs v.1 d (s i) ≠ 0) :
    ∃ S : Finset X.an, X.triv ∈ S ∧ (∀ w ∈ S, X.IsDivisorial w) ∧
      ∀ (d' : Fin r → ℤ) (σ : X.sections d') (z : ℤ) (R : ℕ),
        (∀ w ∈ S, X.logSecAbs w.1 d' σ + ((z : ℝ) : EReal) ≤
          ((R : ℝ) : EReal) * X.shilovSup d s e w) →
        ∀ v : X.an, X.logSecAbs v.1 d' σ + ((z : ℝ) : EReal) ≤
          ((R : ℝ) : EReal) * X.shilovSup d s e v := by
  obtain ⟨S, hS, hSdiv, hcore⟩ := exists_finset_shilov_core s e hz
  refine ⟨S, hS, hSdiv, fun d' σ z R h v => ?_⟩
  by_cases hσ : σ.1 = 0
  · rw [hσ, logSecAbs_zero, EReal.bot_add]
    exact bot_le
  -- evaluation at `⋆ ∈ Σ` gives `z ≤ 0`
  have hz0 : z ≤ 0 := by
    have h1 := h X.triv hS
    rw [logSecAbs_triv σ.2 hσ, zero_add] at h1
    have h2 : ((R : ℝ) : EReal) * X.shilovSup d s e X.triv ≤ 0 := by
      have := ProjBerk.ereal_coe_mul_monotone (Nat.cast_nonneg R) (shilovSup_le_zero s e X.triv)
      simpa only [mul_zero] using this
    have h3 : ((z : ℝ) : EReal) ≤ ((0 : ℝ) : EReal) := h1.trans h2
    exact_mod_cast EReal.coe_le_coe_iff.1 h3
  have hn : (((-z).toNat : ℕ) : ℤ) = -z := Int.toNat_of_nonneg (by omega)
  have hza : ((z : ℝ) : EReal) = ((-(((-z).toNat : ℕ) : ℝ) : ℝ) : EReal) := by
    congr 1
    have := congrArg (fun m : ℤ => (m : ℝ)) hn
    push_cast at this
    linarith
  rw [hza, logSecAbs_add_le_mul_shilovSup_iff]
  refine hcore d' σ _ R (fun w hw => ?_) v
  rw [← logSecAbs_add_le_mul_shilovSup_iff, ← hza]
  exact h w hw

end Log

/-! ### Normal form of finite Fubini–Study functions -/

/-- **Normal form of a finite Fubini–Study function**: after clearing the denominators of the
weights and subtracting the largest one, `ψ ∈ 𝓗_fin(𝒳, b)` is `K⁻¹ (P + Z)` with `K ∈ ℤ_{>0}`,
`Z ∈ ℤ` and `P = max_i (log|s_i| - e_i)` (`MultiModel.shilovSup`) for sections `s_i ∈ R_d` without
common zero on `𝒳^an` and `e_i ∈ ℕ`. -/
theorem IsFinFS.exists_shilovSup {b : Fin r → ℚ} {ψ : X.an → EReal} (hψ : X.IsFinFS b ψ) :
    ∃ (ι : Type u) (_ : Fintype ι) (d : Fin r → ℤ) (s : ι → X.sections d) (e : ι → ℕ)
      (L : ℕ) (Z : ℤ), 0 < L ∧ (∀ v : X.an, ∃ i, X.secAbs v.1 d (s i) ≠ 0) ∧
        ∀ v : X.an,
          ψ v = (((L : ℝ)⁻¹ : ℝ) : EReal) * (X.shilovSup d s e v + ((Z : ℝ) : EReal)) := by
  obtain ⟨D, hD, hfin, hψD⟩ := hψ
  obtain ⟨L, hL, hLz⟩ := ProjBerk.exists_pos_nat_mul_eq_int D.terms (fun t => t.2) hD
  choose z hz using hLz
  have hne : (Finset.univ : Finset D.terms).Nonempty := by
    obtain ⟨t, ht, -⟩ := hfin X.triv
    exact ⟨⟨t, ht⟩, Finset.mem_univ _⟩
  set zf : D.terms → ℤ := fun i => z i.1 i.2 with hzf
  set Z : ℤ := Finset.univ.sup' hne zf with hZdef
  have hZ : ∀ i, zf i ≤ Z := fun i => Finset.le_sup' zf (Finset.mem_univ i)
  set e : D.terms → ℕ := fun i => (Z - zf i).toNat with he_def
  set s : D.terms → X.sections (L • D.deg) := fun i =>
    ⟨i.1.1 ^ L, pow_mem_sections (D.mem_sections i.1 i.2) L⟩ with hs_def
  have he : ∀ i, ((e i : ℕ) : ℝ) = (Z : ℝ) - (zf i : ℝ) := fun i => by
    have : ((e i : ℕ) : ℤ) = Z - zf i := Int.toNat_of_nonneg (by linarith [hZ i])
    exact_mod_cast this
  -- `L (log|f_t| + λ_t) = log|f_t^L| - e_t + Z`
  have hterm : ∀ (i : D.terms) (v : X.an), ((L : ℝ) : EReal) * X.termVal D.deg i.1 v =
      (X.logSecAbs v.1 (L • D.deg) (s i).1 + ((-(e i : ℝ) : ℝ) : EReal)) +
        ((Z : ℝ) : EReal) := fun i v => by
    rw [termVal_def, ProjBerk.ereal_coe_mul_add (Nat.cast_nonneg L), ← EReal.coe_mul, hz i.1 i.2,
      EReal.coe_natCast, ← logSecAbs_pow v.2.2 (D.mem_sections i.1 i.2), add_assoc,
      ← EReal.coe_add, he]
    congr 2
    simp only [hzf]
    ring
  refine ⟨D.terms, inferInstance, L • D.deg, s, e, L * D.m, Z, Nat.mul_pos hL D.m_pos,
    fun v => ?_, fun v => ?_⟩
  · obtain ⟨t, ht, hv⟩ := hfin v
    refine ⟨⟨t, ht⟩, ?_⟩
    rw [hs_def]
    dsimp only
    rw [secAbs_pow v.2.2 (D.mem_sections t ht)]
    exact pow_ne_zero _ hv
  · have hsup : X.shilovSup (L • D.deg) s e v + ((Z : ℝ) : EReal) =
        ((L : ℝ) : EReal) * D.terms.sup fun t => X.termVal D.deg t v := by
      rw [shilovSup, Finset.apply_sup_eq_sup_comp_of_linearOrder (s := Finset.univ)
        (fun x : EReal => x + ((Z : ℝ) : EReal)) (fun _ _ h => add_le_add_left h _)
        (EReal.bot_add _), ProjBerk.ereal_coe_mul_finset_sup (by exact_mod_cast hL)]
      rw [← Finset.sup_attach D.terms, ← Finset.univ_eq_attach]
      exact Finset.sup_congr rfl fun i _ => (hterm i v).symm
    rw [hψD v, hsup, ProjBerk.ereal_coe_mul_coe_mul, FSData.eval_def]
    congr 2
    push_cast
    field_simp [D.m_ne_zero]

/-! ### The Shilov boundary lemma (`lem:gl-shilov`) -/

/-- A single term with a real weight: the rational case (through `ProjBerk.fsTerm_le_iff` and the
single-term form) and approximation of the weight from below. -/
theorem shilov_term_of_rat {x P : EReal} (hx : x ≠ ⊤) (hP : P ≠ ⊥) (hP' : P ≠ ⊤) {μ : ℝ} {m L : ℕ}
    (hm : 0 < m) (hL : 0 < L) {Z : ℤ}
    (h : ∀ q : ℚ, (q : ℝ) ≤ μ → (((m : ℝ)⁻¹ : ℝ) : EReal) * (x + ((q : ℝ) : EReal)) ≤
      (((L : ℝ)⁻¹ : ℝ) : EReal) * (P + ((Z : ℝ) : EReal))) :
    (((m : ℝ)⁻¹ : ℝ) : EReal) * (x + (μ : EReal)) ≤
      (((L : ℝ)⁻¹ : ℝ) : EReal) * (P + ((Z : ℝ) : EReal)) := by
  induction x using EReal.rec with
  | bot =>
    rw [EReal.bot_add, EReal.coe_mul_bot_of_pos (inv_pos.2 (by exact_mod_cast hm))]
    exact bot_le
  | top => exact absurd rfl hx
  | coe x =>
  induction P using EReal.rec with
  | bot => exact absurd rfl hP
  | top => exact absurd rfl hP'
  | coe p =>
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  have hL' : (0 : ℝ) < L := by exact_mod_cast hL
  simp only [← EReal.coe_add, ← EReal.coe_mul, EReal.coe_le_coe_iff] at h ⊢
  by_contra hlt
  push Not at hlt
  -- choose a rational weight `q < μ` violating the inequality
  have hlt' : (m : ℝ) * ((L : ℝ)⁻¹ * (p + Z)) - x < μ := by
    have := mul_lt_mul_of_pos_left hlt hm'
    rw [mul_inv_cancel_left₀ hm'.ne'] at this
    linarith
  obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn hlt'
  have h1 := h q hq2.le
  have h2 : (L : ℝ)⁻¹ * (p + Z) < (m : ℝ)⁻¹ * (x + q) := by
    rw [lt_inv_mul_iff₀ hm']
    linarith
  exact absurd h1 (not_le.2 h2)

variable [IsAlgClosed k]

/-- **The Shilov boundary on `𝒳`, comparison form** (`lem:gl-shilov`): for `ψ ∈ 𝓗_fin(𝒳, b)`
there is a finite set `Σ ⊆ 𝒳^div` containing `⋆` such that every Fubini–Study function `φ` of any
class `a` with `φ ≤ ψ` on `Σ` satisfies `φ ≤ ψ` on `𝒳^an`. -/
theorem IsFinFS.exists_finset_le_of_le {b : Fin r → ℚ} {ψ : X.an → EReal} (hψ : X.IsFinFS b ψ) :
    ∃ S : Finset X.an, X.triv ∈ S ∧ (∀ w ∈ S, X.IsDivisorial w) ∧
      ∀ (a : Fin r → ℚ) (φ : X.an → EReal), X.IsFS a φ → (∀ w ∈ S, φ w ≤ ψ w) →
        ∀ v : X.an, φ v ≤ ψ v := by
  obtain ⟨ι, _, d, s, e, L, Z, hL, hz, hψe⟩ := hψ.exists_shilovSup
  obtain ⟨S, hS, hSdiv, hB⟩ := exists_finset_shilov_log s e hz
  refine ⟨S, hS, hSdiv, fun a φ hφ h v => ?_⟩
  obtain ⟨D', -, hφD⟩ := hφ
  -- each term `m'⁻¹ (log|σ| + μ)` of `φ`
  have key : ∀ t ∈ D'.terms, (((D'.m : ℝ)⁻¹ : ℝ) : EReal) * X.termVal D'.deg t v ≤ ψ v := by
    intro t ht
    rw [termVal_def, hψe v]
    refine shilov_term_of_rat (logSecAbs_ne_top _ _ _) (shilovSup_ne_bot s e hz v)
      (shilovSup_ne_top s e v) D'.m_pos hL fun q hq => ?_
    -- the rational case
    have hQ := q.den_pos
    have hw : (q.den : ℝ) * (q : ℝ) = (q.num : ℝ) := by
      exact_mod_cast congrArg (fun x : ℚ => (x : ℝ)) (Rat.den_mul_eq_num q)
    have hiff : ∀ w : X.an, (((D'.m : ℝ)⁻¹ : ℝ) : EReal) *
        (X.logSecAbs w.1 D'.deg t.1 + ((q : ℝ) : EReal)) ≤
          (((L : ℝ)⁻¹ : ℝ) : EReal) * (X.shilovSup d s e w + ((Z : ℝ) : EReal)) ↔
        X.logSecAbs w.1 ((L * q.den) • D'.deg) (t.1 ^ (L * q.den)) +
            (((L * q.num - D'.m * q.den * Z : ℤ) : ℝ) : EReal) ≤
          (((D'.m * q.den : ℕ) : ℝ) : EReal) * X.shilovSup d s e w := fun w => by
      rw [logSecAbs_pow w.2.2 (D'.mem_sections t ht)]
      exact ProjBerk.fsTerm_le_iff (logSecAbs_ne_top _ _ _) (shilovSup_ne_bot s e hz w)
        (shilovSup_ne_top s e w) D'.m_pos hL hQ hw
    rw [hiff]
    refine hB _ ⟨t.1 ^ (L * q.den), pow_mem_sections (D'.mem_sections t ht) _⟩ _ _
      (fun w hw' => ?_) v
    rw [← hiff, ← hψe w]
    calc (((D'.m : ℝ)⁻¹ : ℝ) : EReal) * (X.logSecAbs w.1 D'.deg t.1 + ((q : ℝ) : EReal))
        ≤ (((D'.m : ℝ)⁻¹ : ℝ) : EReal) * X.termVal D'.deg t w := by
          refine ProjBerk.ereal_coe_mul_monotone D'.inv_m_pos.le ?_
          rw [termVal_def]
          exact add_le_add le_rfl (EReal.coe_le_coe_iff.2 hq)
      _ ≤ D'.eval w := D'.termVal_le_eval_mul w ht
      _ = φ w := (hφD w).symm
      _ ≤ ψ w := h w hw'
  rw [hφD, FSData.eval_def, ProjBerk.ereal_coe_mul_finset_sup D'.inv_m_pos, Finset.sup_le_iff]
  exact key

/-- **The Shilov boundary on `𝒳`** (**`lem:gl-shilov`**, BJ22 Lemma 2.13): for every
`ψ ∈ 𝓗_fin(𝒳, b)` there is a finite set `Σ ⊆ 𝒳^div` containing `⋆` such that
`sup_{𝒳^an} (φ - ψ) = max_Σ (φ - ψ)` for every `a ∈ ℚ^r` and every `φ ∈ 𝓗(𝒳, a)`. -/
theorem IsFinFS.exists_finset_iSup_sub_eq {b : Fin r → ℚ} {ψ : X.an → EReal}
    (hψ : X.IsFinFS b ψ) :
    ∃ S : Finset X.an, X.triv ∈ S ∧ (∀ w ∈ S, X.IsDivisorial w) ∧
      ∀ (a : Fin r → ℚ) (φ : X.an → EReal), X.IsFS a φ →
        ⨆ v, (φ v - ψ v) = S.sup fun v => φ v - ψ v := by
  obtain ⟨S, hS, hSdiv, hle⟩ := hψ.exists_finset_le_of_le
  refine ⟨S, hS, hSdiv, fun a φ hφ => le_antisymm (iSup_le fun v => ?_)
    (Finset.sup_le fun w _ => le_iSup (fun v => φ v - ψ v) w)⟩
  have hψr : ∀ v, ψ v = (((ψ v).toReal : ℝ) : EReal) := fun v =>
    (EReal.coe_toReal ((FSSystemC.IsFinFS.isFS (F := X.fsSystem) hψ).ne_top v)
      ((FSSystemC.IsFinFS.ne_bot (F := X.fsSystem) hψ) v)).symm
  refine le_of_forall_gt_imp_ge_of_dense fun c hc => ?_
  obtain ⟨q, hMq, hqc⟩ := EReal.lt_iff_exists_real_btwn.1 hc
  -- apply the comparison form to `φ - q`
  have hφq : X.IsFS a fun v => φ v + ((-q : ℝ) : EReal) :=
    FSSystemC.IsFS.add_const (F := X.fsSystem) hφ (-q)
  have h := hle a _ hφq (fun w hw => by
    have h1 : φ w - ψ w ≤ (q : EReal) := (Finset.le_sup (f := fun v => φ v - ψ v) hw).trans hMq.le
    rw [hψr w, ereal_sub_coe_le_coe_iff] at h1
    rw [hψr w]
    exact h1) v
  have h2 : φ v - ψ v ≤ (q : EReal) := by
    rw [hψr v, ereal_sub_coe_le_coe_iff]
    rw [hψr v] at h
    exact h
  exact h2.trans hqc.le

end MultiModel

end EnvelopeProperty
