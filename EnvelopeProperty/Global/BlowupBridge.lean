import EnvelopeProperty.Global.Model
import EnvelopeProperty.Projective.BlowupModel

/-!
# The rank-2 bridge: models generated by their coordinates and blowup models

This file implements the rank-2 part of the blueprint remark `rmk:gl-bridges` of `global.tex`
(subsection `subsec:gl-model`) at the level of points, for the formalization of Fang–Han–Xia,
*The envelope property for unibranch projective varieties* (FHX; the blowup model
is used in `lem:gl-stein`(3), FHX `thm:normal-ample-EP`, `cor:normal-weak-global`). The rank-1
part is in `EnvelopeProperty.Global.Bridge`.

## Monomial families

`MultiModel.aeval_monomial_family`, `MultiModel.aeval_weightedHomogeneousComponent`: for a
weight `w : σ → Γ` and an injective additive map `τ : Γ →+ ℕ^ι`, the map
`k[x_i] → K[T]`, `x_i ↦ c_i T^{τ(w_i)}`, sends `x^β` to `(∏ c_i^{β_i}) T^{τ(weight β)}` and the
weighted homogeneous component of weight `γ` of `F` to the monomial of degree `τ(γ)` of the image.

## Rank-2 models generated by their coordinates

Let `𝒳 = (K, S, z)` be a model of rank `2` with `S = k[z]` (generated by its coordinates
`z^{(0)}_j = f^{(0)}_j T_0`, `z^{(1)}_m = f^{(1)}_m T_1`). Let
`R = k[x_0, …, x_M, y_0, …, y_{M'}]` (`M = M_0`, `M' = M_1`), bigraded by `deg x_j = (1, 0)`,
`deg y_m = (0, 1)` (`EnvelopeProperty.biWeight`), as for `(ℙ^M × ℙ^{M'})^an`
(`EnvelopeProperty.BiProjBerk`).

* `MultiModel.biHom : R → K[T_0, T_1]`, `x_j ↦ z^{(0)}_j`, `y_m ↦ z^{(1)}_m`, onto `k[z] = S`
  (`MultiModel.biHomS`, surjective by assumption); it is bigraded
  (`MultiModel.biHomS_weightedHomogeneousComponent`), so its kernel `I'` (`MultiModel.biIdeal`) is
  a bihomogeneous prime ideal.
* `MultiModel.biAn = V(I')^an ⊆ (ℙ^M × ℙ^{M'})^an`, and **the bridge**
  `MultiModel.biAnHomeomorph : 𝒳^an ≃ₜ V(I')^an`, `|F|_{v'} = |F(z)|_v`
  (`MultiModel.biAnHomeomorph_val`), mapping `⋆` to the trivial valuation of `R / I'`
  (`MultiModel.biAnHomeomorph_triv_val_of_mem`, `MultiModel.biAnHomeomorph_triv_val_of_notMem`).
  As in rank `1` (`DegOnePres.projHomeomorph`): a bigraded normalized seminorm on `R` vanishing on
  `I'` is a multigraded seminorm on `S ≅ R / I'` normalized for `z`, and conversely.
* **Blowup models** (`rmk:gl-bridges` for `r = 2`): if `I'` is the ideal of the blowup of
  `V ⊆ ℙ^M` along forms `G_0, …, G_{M'}` (`ProjSubvariety.BlowupCenter.ideal`, `def:pg-blowup`),
  then `MultiModel.blowupAnHomeomorph : 𝒳^an ≃ₜ B^an` (`ProjSubvariety.BlowupCenter.an`), with
  `⋆ ↦ ⋆'` (`MultiModel.blowupAnHomeomorph_triv`) and `μ(v') = v|_{k[z^{(0)}]}`
  (`MultiModel.proj_blowupAnHomeomorph_val`). This is the form in which the bridge is used in
  `lem:gl-stein`(3) (the kernel of the bigraded ring of `B` mapping to `S_Y^ν` is `I'`).
-/

open scoped NNReal ENNReal Topology

open Topology MvPolynomial

noncomputable section

namespace EnvelopeProperty

open ProjBerk

universe u

namespace MultiModel

variable {k : Type u} [Field k] {K : Type u} [Field K] [Algebra k K]

/-! ### Monomial families -/

section MonomialFamily

variable {σ ι Γ : Type*} [AddCommMonoid Γ] (τ : Γ →+ (ι →₀ ℕ)) (w : σ → Γ) (c : σ → K)

/-- `∏_i (c_i T^{τ(w_i)})^{β_i} = (∏_i c_i^{β_i}) T^{τ(weight β)}`. -/
theorem prod_monomial_pow (β : σ →₀ ℕ) :
    (β.prod fun i n => (monomial (τ (w i)) (c i) : MvPolynomial ι K) ^ n) =
      monomial (τ (Finsupp.weight w β)) (β.prod fun i n => c i ^ n) := by
  induction β using Finsupp.induction with
  | zero => simp [← C_apply]
  | single_add i n β _ _ ih =>
    rw [Finsupp.prod_add_index' (fun _ => pow_zero _) fun _ _ _ => pow_add _ _ _, ih,
      Finsupp.prod_single_index
        (h := fun i n => (monomial (τ (w i)) (c i) : MvPolynomial ι K) ^ n) (pow_zero _),
      monomial_pow, monomial_mul, map_add, Finsupp.weight_single, map_add, map_nsmul,
      Finsupp.prod_add_index' (fun _ => pow_zero _) fun _ _ _ => pow_add _ _ _,
      Finsupp.prod_single_index (h := fun i n => c i ^ n) (pow_zero _)]

/-- `x^β ↦ (a ∏_i c_i^{β_i}) T^{τ(weight β)}` under `x_i ↦ c_i T^{τ(w_i)}`. -/
theorem aeval_monomial_family (β : σ →₀ ℕ) (a : k) :
    aeval (fun i => (monomial (τ (w i)) (c i) : MvPolynomial ι K)) (monomial β a) =
      monomial (τ (Finsupp.weight w β)) (algebraMap k K a * β.prod fun i n => c i ^ n) := by
  rw [aeval_monomial, prod_monomial_pow, MvPolynomial.algebraMap_apply, C_mul_monomial]

/-- **Weighted homogeneous components** under `x_i ↦ c_i T^{τ(w_i)}` (`τ` injective): the
component of weight `γ` maps to the monomial of degree `τ(γ)` of the image. -/
theorem aeval_weightedHomogeneousComponent (hτ : Function.Injective τ) (γ : Γ)
    (F : MvPolynomial σ k) :
    aeval (fun i => (monomial (τ (w i)) (c i) : MvPolynomial ι K))
        (weightedHomogeneousComponent w γ F) =
      monomial (τ γ) ((aeval (fun i => (monomial (τ (w i)) (c i) : MvPolynomial ι K)) F).coeff
        (τ γ)) := by
  classical
  induction F using MvPolynomial.induction_on' with
  | monomial β a =>
    rw [weightedHomogeneousComponent_of_mem (isWeightedHomogeneous_monomial w β a rfl),
      aeval_monomial_family, coeff_monomial]
    by_cases h : γ = Finsupp.weight w β
    · rw [if_pos h, if_pos (by rw [h]), aeval_monomial_family, h]
    · rw [if_neg h, if_neg fun h' => h (hτ h').symm, map_zero, map_zero]
  | add F G hF hG => rw [map_add, map_add, hF, hG, map_add, coeff_add, map_add]

end MonomialFamily

/-! ### Bidegrees -/

/-- The bidegree map `(p, q) ↦ p e_0 + q e_1`, `ℕ × ℕ →+ ℕ^2`. -/
def biDeg : ℕ × ℕ →+ (Fin 2 →₀ ℕ) :=
  (Finsupp.singleAddHom 0).comp (AddMonoidHom.fst ℕ ℕ) +
    (Finsupp.singleAddHom 1).comp (AddMonoidHom.snd ℕ ℕ)

theorem biDeg_apply (p : ℕ × ℕ) : biDeg p = Finsupp.single 0 p.1 + Finsupp.single 1 p.2 :=
  rfl

@[simp]
theorem biDeg_apply_zero (p : ℕ × ℕ) : biDeg p 0 = p.1 := by
  simp [biDeg_apply]

@[simp]
theorem biDeg_apply_one (p : ℕ × ℕ) : biDeg p 1 = p.2 := by
  simp [biDeg_apply]

theorem biDeg_injective : Function.Injective biDeg := fun p q h =>
  Prod.ext (by rw [← biDeg_apply_zero p, h, biDeg_apply_zero])
    (by rw [← biDeg_apply_one p, h, biDeg_apply_one])

theorem biDeg_eq (a : Fin 2 →₀ ℕ) : biDeg (a 0, a 1) = a := by
  ext c
  fin_cases c <;> simp

theorem biDeg_biWeight_inl (M M' : ℕ) (j : Fin (M + 1)) :
    biDeg (biWeight M M' (Sum.inl j)) = Finsupp.single 0 1 := by
  rw [biWeight_inl, biDeg_apply, Finsupp.single_zero, add_zero]

theorem biDeg_biWeight_inr (M M' : ℕ) (m : Fin (M' + 1)) :
    biDeg (biWeight M M' (Sum.inr m)) = Finsupp.single 1 1 := by
  rw [biWeight_inr, biDeg_apply, Finsupp.single_zero, zero_add]

/-! ### The presentation of a rank-2 model by its coordinates -/

section Rank2

variable (X : MultiModel k K 2)

/-- The coefficients `f^{(0)}_j` (for `x_j`) and `f^{(1)}_m` (for `y_m`) of the coordinates. -/
def biCoeff : Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1) → K :=
  Sum.elim (X.coord 0) (X.coord 1)

/-- The presentation `k[x_0, …, x_M, y_0, …, y_{M'}] → K[T_0, T_1]`, `x_j ↦ z^{(0)}_j`,
`y_m ↦ z^{(1)}_m`. -/
def biHom : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k →ₐ[k] MvPolynomial (Fin 2) K :=
  aeval fun i => monomial (biDeg (biWeight (X.M 0) (X.M 1) i)) (X.biCoeff i)

theorem biHom_X_inl (j : Fin (X.M 0 + 1)) :
    X.biHom (MvPolynomial.X (Sum.inl j)) = X.coordMono ⟨0, j⟩ := by
  rw [biHom, aeval_X, biDeg_biWeight_inl]
  rfl

theorem biHom_X_inr (m : Fin (X.M 1 + 1)) :
    X.biHom (MvPolynomial.X (Sum.inr m)) = X.coordMono ⟨1, m⟩ := by
  rw [biHom, aeval_X, biDeg_biWeight_inr]
  rfl

theorem range_biHom : X.biHom.range = X.coordAlg := by
  rw [biHom, ← Algebra.adjoin_range_eq_range_aeval, coordAlg]
  congr 1
  ext p
  constructor
  · rintro ⟨i | i, rfl⟩
    · exact ⟨⟨0, i⟩, by rw [← biHom_X_inl, biHom, aeval_X]⟩
    · exact ⟨⟨1, i⟩, by rw [← biHom_X_inr, biHom, aeval_X]⟩
  · rintro ⟨⟨c, j⟩, rfl⟩
    have hc : c = 0 ∨ c = 1 := by fin_cases c <;> simp
    rcases hc with rfl | rfl
    · exact ⟨Sum.inl j, by rw [← biHom_X_inl, biHom, aeval_X]⟩
    · exact ⟨Sum.inr j, by rw [← biHom_X_inr, biHom, aeval_X]⟩

theorem biHom_mem (F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k) : X.biHom F ∈ X.S :=
  X.coordAlg_le (by rw [← X.range_biHom]; exact ⟨F, rfl⟩)

/-- The presentation `R → S`. -/
def biHomS : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k →ₐ[k] X.S :=
  X.biHom.codRestrict X.S X.biHom_mem

@[simp]
theorem coe_biHomS (F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k) :
    (X.biHomS F : MvPolynomial (Fin 2) K) = X.biHom F :=
  rfl

theorem biHomS_X_inl (j : Fin (X.M 0 + 1)) :
    X.biHomS (MvPolynomial.X (Sum.inl j)) = X.coordElem ⟨0, j⟩ :=
  Subtype.ext (X.biHom_X_inl j)

theorem biHomS_X_inr (m : Fin (X.M 1 + 1)) :
    X.biHomS (MvPolynomial.X (Sum.inr m)) = X.coordElem ⟨1, m⟩ :=
  Subtype.ext (X.biHom_X_inr m)

variable {X} in
/-- For a model generated by its coordinates, `R → S` is surjective. -/
theorem biHomS_surjective (hX : X.S = X.coordAlg) : Function.Surjective X.biHomS := by
  rintro ⟨p, hp⟩
  rw [hX, ← X.range_biHom] at hp
  obtain ⟨F, rfl⟩ := hp
  exact ⟨F, rfl⟩

/-- **The presentation is bigraded**: the bihomogeneous component of bidegree `p` maps to the
homogeneous component of degree `p_0 e_0 + p_1 e_1`. -/
theorem biHomS_weightedHomogeneousComponent (p : ℕ × ℕ)
    (F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k) :
    X.biHomS (weightedHomogeneousComponent (biWeight (X.M 0) (X.M 1)) p F) =
      X.homComp (biDeg p) (X.biHomS F) :=
  Subtype.ext (aeval_weightedHomogeneousComponent biDeg _ _ biDeg_injective p F)

theorem homComp_biHomS (a : Fin 2 →₀ ℕ)
    (F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k) :
    X.homComp a (X.biHomS F) =
      X.biHomS (weightedHomogeneousComponent (biWeight (X.M 0) (X.M 1)) (a 0, a 1) F) := by
  rw [biHomS_weightedHomogeneousComponent, biDeg_eq]

/-- The kernel `I'` of the presentation `R → S`. -/
def biIdeal : Ideal (MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k) :=
  RingHom.ker X.biHomS

theorem mem_biIdeal_iff {F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k} :
    F ∈ X.biIdeal ↔ X.biHomS F = 0 :=
  RingHom.mem_ker

instance isPrime_biIdeal : X.biIdeal.IsPrime :=
  RingHom.ker_isPrime _

/-- `I'` is bihomogeneous. -/
theorem weightedHomogeneousComponent_mem_biIdeal
    {F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k} (hF : F ∈ X.biIdeal) (p : ℕ × ℕ) :
    weightedHomogeneousComponent (biWeight (X.M 0) (X.M 1)) p F ∈ X.biIdeal := by
  rw [mem_biIdeal_iff] at hF ⊢
  rw [biHomS_weightedHomogeneousComponent, hF]
  exact Subtype.ext (by rw [coe_homComp, ZeroMemClass.coe_zero, coeff_zero, map_zero])

/-- `V(I')^an ⊆ (ℙ^M × ℙ^{M'})^an`. -/
def biAn : Set (BiProjBerk k (X.M 0) (X.M 1)) :=
  {v | ∀ F ∈ X.biIdeal, v.1.val F = 0}

/-! #### `𝒳^an → V(I')^an` -/

/-- The point of `V(I')^an` given by a point of `𝒳^an`: `|F| = |F(z)|`. -/
def toBiProj (v : X.an) : X.biAn :=
  ⟨⟨Berk.comap X.biHomS v.1, fun F p => by
      rw [Berk.comap_val_apply, Berk.comap_val_apply, biHomS_weightedHomogeneousComponent]
      exact v.2.1 _ _, by
      simp only [Berk.comap_val_apply, biHomS_X_inl]
      exact v.2.2 0, by
      simp only [Berk.comap_val_apply, biHomS_X_inr]
      exact v.2.2 1⟩,
    fun F hF => by
      change v.1.val (X.biHomS F) = 0
      rw [(X.mem_biIdeal_iff).1 hF, map_zero]⟩

theorem toBiProj_val (v : X.an) (F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k) :
    (X.toBiProj v : BiProjBerk k (X.M 0) (X.M 1)).1.val F = v.1.val (X.biHomS F) :=
  rfl

theorem continuous_toBiProj : Continuous X.toBiProj :=
  ((((Berk.continuous_comap X.biHomS).comp continuous_subtype_val).subtype_mk _).subtype_mk _)

/-! #### `V(I')^an → 𝒳^an` -/

variable {X}

/-- The isomorphism `R / I' ≃ S`. -/
def biQuotEquiv (hX : X.S = X.coordAlg) :
    (MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k ⧸ X.biIdeal) ≃ₐ[k] X.S :=
  Ideal.quotientKerAlgEquivOfSurjective (biHomS_surjective hX)

theorem biQuotEquiv_symm_biHomS (hX : X.S = X.coordAlg)
    (F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k) :
    (biQuotEquiv hX).symm (X.biHomS F) = Ideal.Quotient.mk X.biIdeal F :=
  Ideal.quotientKerAlgEquivOfSurjective_symm_apply (biHomS_surjective hX) F

/-- The seminorm on `S ≅ R / I'` given by a point of `V(I')^an`. -/
def ofBiProjBerk (hX : X.S = X.coordAlg) (u : X.biAn) : Berk k X.S :=
  Berk.comap (biQuotEquiv hX).symm.toAlgHom (Berk.ofQuot (J := X.biIdeal) u.1.1 u.2)

theorem ofBiProjBerk_val (hX : X.S = X.coordAlg) (u : X.biAn)
    (F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k) :
    (ofBiProjBerk hX u).val (X.biHomS F) = (u : BiProjBerk k (X.M 0) (X.M 1)).1.val F := by
  rw [ofBiProjBerk, Berk.comap_val_apply]
  change (Berk.ofQuot (J := X.biIdeal) u.1.1 u.2).val ((biQuotEquiv hX).symm (X.biHomS F)) = _
  rw [biQuotEquiv_symm_biHomS]
  rfl

/-- The point of `𝒳^an` given by a point of `V(I')^an`. -/
def ofBiProj (hX : X.S = X.coordAlg) (u : X.biAn) : X.an :=
  ⟨ofBiProjBerk hX u, fun p a => by
      obtain ⟨F, rfl⟩ := biHomS_surjective hX p
      rw [homComp_biHomS, ofBiProjBerk_val, ofBiProjBerk_val]
      exact (u : BiProjBerk k (X.M 0) (X.M 1)).isBigraded F (a 0, a 1), fun c => by
      fin_cases c
      · change Finset.univ.sup (fun j : Fin (X.M 0 + 1) =>
          (ofBiProjBerk hX u).val (X.coordElem ⟨0, j⟩)) = 1
        simp_rw [← biHomS_X_inl, ofBiProjBerk_val]
        exact (u : BiProjBerk k (X.M 0) (X.M 1)).sup_val_X_inl
      · change Finset.univ.sup (fun j : Fin (X.M 1 + 1) =>
          (ofBiProjBerk hX u).val (X.coordElem ⟨1, j⟩)) = 1
        simp_rw [← biHomS_X_inr, ofBiProjBerk_val]
        exact (u : BiProjBerk k (X.M 0) (X.M 1)).sup_val_X_inr⟩

theorem ofBiProj_val (hX : X.S = X.coordAlg) (u : X.biAn)
    (F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k) :
    (ofBiProj hX u).1.val (X.biHomS F) = (u : BiProjBerk k (X.M 0) (X.M 1)).1.val F :=
  ofBiProjBerk_val hX u F

theorem toBiProj_ofBiProj (hX : X.S = X.coordAlg) (u : X.biAn) :
    X.toBiProj (ofBiProj hX u) = u :=
  Subtype.ext (Subtype.ext (Berk.ext_val fun F => by rw [toBiProj_val, ofBiProj_val]))

theorem ofBiProj_toBiProj (hX : X.S = X.coordAlg) (v : X.an) :
    ofBiProj hX (X.toBiProj v) = v := by
  refine Subtype.ext (Berk.ext_val fun p => ?_)
  obtain ⟨F, rfl⟩ := biHomS_surjective hX p
  rw [ofBiProj_val, toBiProj_val]

/-! #### The bridge -/

/-- **The rank-2 bridge** (`rmk:gl-bridges`): for a rank-2 model generated by its coordinates,
`𝒳^an ≃ₜ V(I')^an ⊆ (ℙ^M × ℙ^{M'})^an`, `I'` the kernel of `x_j ↦ z^{(0)}_j`, `y_m ↦ z^{(1)}_m`. -/
def biAnHomeomorph (hX : X.S = X.coordAlg) : X.an ≃ₜ X.biAn :=
  @Continuous.homeoOfEquivCompactToT2 _ _ _ _ _ _
    ⟨X.toBiProj, ofBiProj hX, ofBiProj_toBiProj hX, toBiProj_ofBiProj hX⟩ X.continuous_toBiProj

/-- **The value formula of the bridge**: `|F|_{v'} = |F(z)|_v` for `F ∈ R`. -/
theorem biAnHomeomorph_val (hX : X.S = X.coordAlg) (v : X.an)
    (F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k) :
    (biAnHomeomorph hX v : BiProjBerk k (X.M 0) (X.M 1)).1.val F = v.1.val (X.biHomS F) :=
  rfl

theorem biAnHomeomorph_symm_val (hX : X.S = X.coordAlg) (u : X.biAn)
    (F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k) :
    ((biAnHomeomorph hX).symm u).1.val (X.biHomS F) =
      (u : BiProjBerk k (X.M 0) (X.M 1)).1.val F := by
  rw [← biAnHomeomorph_val hX, Homeomorph.apply_symm_apply]

/-- `⋆` maps to the trivial valuation of `R / I'`: `|F| = 0` for `F ∈ I'`. -/
theorem biAnHomeomorph_triv_val_of_mem (hX : X.S = X.coordAlg)
    {F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k} (hF : F ∈ X.biIdeal) :
    (biAnHomeomorph hX X.triv : BiProjBerk k (X.M 0) (X.M 1)).1.val F = 0 :=
  (biAnHomeomorph hX X.triv).2 F hF

/-- `⋆` maps to the trivial valuation of `R / I'`: `|F| = 1` for `F ∉ I'`. -/
theorem biAnHomeomorph_triv_val_of_notMem (hX : X.S = X.coordAlg)
    {F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k} (hF : F ∉ X.biIdeal) :
    (biAnHomeomorph hX X.triv : BiProjBerk k (X.M 0) (X.M 1)).1.val F = 1 := by
  rw [biAnHomeomorph_val]
  exact X.triv_val_of_ne_zero fun h => hF ((X.mem_biIdeal_iff).2 h)

/-! #### Blowup models -/

/-- **The bridge to blowup models** (`rmk:gl-bridges`, `r = 2`): if the kernel `I'` of the
presentation of a rank-2 model generated by its coordinates is the ideal of the blowup `B` of
`V ⊆ ℙ^M` along `G_0, …, G_{M'}` (`def:pg-blowup`), then `𝒳^an ≃ₜ B^an`. -/
def blowupAnHomeomorph (hX : X.S = X.coordAlg) {V : ProjSubvariety k (X.M 0)}
    (B : V.BlowupCenter (X.M 1)) (hB : X.biIdeal = B.ideal) : X.an ≃ₜ B.an :=
  (biAnHomeomorph hX).trans (Homeomorph.setCongr (by rw [biAn, hB]; rfl))

theorem blowupAnHomeomorph_val (hX : X.S = X.coordAlg) {V : ProjSubvariety k (X.M 0)}
    (B : V.BlowupCenter (X.M 1)) (hB : X.biIdeal = B.ideal) (v : X.an)
    (F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k) :
    (blowupAnHomeomorph hX B hB v : BiProjBerk k (X.M 0) (X.M 1)).1.val F =
      v.1.val (X.biHomS F) :=
  rfl

/-- The bridge maps `⋆` to `⋆'` (`lem:pg-blowup-basic`(2)). -/
theorem blowupAnHomeomorph_triv (hX : X.S = X.coordAlg) {V : ProjSubvariety k (X.M 0)}
    (B : V.BlowupCenter (X.M 1)) (hB : X.biIdeal = B.ideal) :
    blowupAnHomeomorph hX B hB X.triv = B.triv := by
  refine Subtype.ext (Subtype.ext (Berk.ext_val fun F => ?_))
  change (blowupAnHomeomorph hX B hB X.triv : BiProjBerk k (X.M 0) (X.M 1)).1.val F =
    (B.triv : BiProjBerk k (X.M 0) (X.M 1)).1.val F
  by_cases hF : F ∈ B.ideal
  · rw [B.triv_val_of_mem hF]
    exact biAnHomeomorph_triv_val_of_mem hX (hB ▸ hF)
  · rw [B.triv_val_of_notMem hF]
    exact biAnHomeomorph_triv_val_of_notMem hX (hB ▸ hF)

/-- The blowup map under the bridge: `|f|_{μ(v')} = |f(z^{(0)})|_v` for `f ∈ k[x_0, …, x_M]`. -/
theorem proj_blowupAnHomeomorph_val (hX : X.S = X.coordAlg) {V : ProjSubvariety k (X.M 0)}
    (B : V.BlowupCenter (X.M 1)) (hB : X.biIdeal = B.ideal) (v : X.an)
    (f : MvPolynomial (Fin (X.M 0 + 1)) k) :
    (B.proj (blowupAnHomeomorph hX B hB v) : ProjBerk k (X.M 0)).1.val f =
      v.1.val (X.biHomS (rename Sum.inl f)) :=
  rfl

end Rank2

