import EnvelopeProperty.Global.ReesNormalizedNative
import EnvelopeProperty.ReesChart
import EnvelopeProperty.Berkovich.Blowup
import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Genuine finite-coordinate Rees scheme charts in arbitrary coefficient universes

The actual finite-coordinate quotient Proj is covered by its nonzero
original generators. Genuine degree-zero chart equivalences identify
these chart rings with the original fraction-adjoin paper rings, and the
entire coefficient projection triangle is retained. These are actual
scheme constructions, not supplied atlas or comparison witnesses.
-/

open scoped Classical
open CategoryTheory AlgebraicGeometry HomogeneousLocalization
noncomputable section
universe u
attribute [local instance] MvPolynomial.gradedAlgebra
namespace EnvelopeProperty.ReesPresentation
variable {A : Type u} [CommRing A] {n : ℕ} (g : Fin (n + 1) → A)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

private local instance finiteChartAlgebra (l : Fin (n + 1)) : Algebra A (ReesChart.Chart g l) :=
  ReesChart.chartAlgebra g l

/-- The actual original quotient irrelevant ideal is generated by precisely
the original quotient variables. -/
theorem fcFinite_irrelevant_eq_span_generators :
    (HomogeneousIdeal.irrelevant (ReesChart.grading g)).toIdeal =
      Ideal.span (Set.range (ReesChart.generator g)) := by
  apply le_antisymm
  · apply (HomogeneousIdeal.toIdeal_irrelevant_le _).mpr
    intro d hd q hq
    obtain ⟨F, hF, he⟩ := Submodule.mem_map.mp hq
    have hvar : F ∈ MvPolynomial.idealOfVars (Fin (n + 1)) A := by
      rw [← ProjBerk.irrelevant_eq_idealOfVars]
      exact HomogeneousIdeal.mem_irrelevant_of_mem _ hd hF
    have hm := Ideal.mem_map_of_mem (Ideal.Quotient.mk (kernel g)) hvar
    rw [MvPolynomial.idealOfVars, Ideal.map_span, ← Set.range_comp] at hm
    exact he ▸ hm
  · apply Ideal.span_le.mpr
    rintro _ ⟨l, rfl⟩
    exact HomogeneousIdeal.mem_irrelevant_of_mem _ (by decide : 0 < (1 : ℕ))
      (ReesChart.generator_mem g l)

/-- The actual original degree-zero chart immersion of the same finite
coordinate Rees quotient scheme. -/
def fcFiniteChartImmersion (l : Fin (n + 1)) :
    Spec (CommRingCat.of (ReesChart.Chart g l)) ⟶ fcFiniteScheme g :=
  Proj.awayι (ReesChart.grading g) (ReesChart.generator g l) (ReesChart.generator_mem g l) (by decide)

/-- Every original zero centre coefficient kills its actual quotient variable. -/
theorem fcFinite_generator_eq_zero_of_eq_zero {l : Fin (n + 1)} (hl : g l = 0) :
    ReesChart.generator g l = 0 := by
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  change presentation g (MvPolynomial.X l) = 0
  simp only [presentation_X, hl, Polynomial.C_0, zero_mul]

/-- Nonzero original generators give a genuine whole-scheme affine cover,
including the actual empty scheme when every original generator is zero. -/
def fcFiniteNonzeroAffineOpenCover : (fcFiniteScheme g).AffineOpenCover :=
  Proj.affineOpenCoverOfIrrelevantLESpan (ReesChart.grading g)
    (fun l : {l : Fin (n + 1) // g l ≠ 0} => ReesChart.generator g l.1)
    (fun l => ReesChart.generator_mem g l.1) (fun _ => by decide : ∀ _, 0 < (1 : ℕ)) (by
      rw [fcFinite_irrelevant_eq_span_generators]
      apply Ideal.span_le.mpr
      rintro _ ⟨l, rfl⟩
      by_cases hl : g l = 0
      · rw [fcFinite_generator_eq_zero_of_eq_zero g hl]
        exact Ideal.zero_mem _
      · exact Ideal.subset_span ⟨⟨l, hl⟩, rfl⟩)

/-- Actual degree-zero original chart maps are genuine open immersions. -/
instance fcFiniteChartImmersion_isOpenImmersion (l : Fin (n + 1)) :
    IsOpenImmersion (fcFiniteChartImmersion g l) := by
  unfold fcFiniteChartImmersion
  infer_instance

/-- The actual degree-zero original chart retains the entire original
coefficient projection as a genuine scheme-morphism equality. -/
theorem fcFiniteChartImmersion_comp_projection (l : Fin (n + 1)) :
    fcFiniteChartImmersion g l ≫ fcFiniteProjection g =
      Spec.map (CommRingCat.ofHom (ReesChart.coefficients g l)) := by
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A
  let J := homogeneousKernel g
  have hsq := (GradedQuotient.isPullback_awayMap 𝒜 J
    (show 0 < (1 : ℕ) by decide) (MvPolynomial.isHomogeneous_X A l)).w
  change (fcFiniteChartImmersion g l ≫ fcFiniteImmersion g) ≫ ProjBerk.nativeStructureMap = _
  rw [show fcFiniteChartImmersion g l ≫ fcFiniteImmersion g =
    Spec.map (CommRingCat.ofHom (Away.map (GradedQuotient.gradedMk 𝒜 J.toIdeal)
      (MvPolynomial.X l))) ≫ Proj.awayι 𝒜 (MvPolynomial.X l)
      (MvPolynomial.isHomogeneous_X A l) (by decide) from hsq.symm]
  rw [ProjBerk.nativeStructureMap, Category.assoc,
    ← Category.assoc (Proj.awayι _ _ _ _), Proj.awayι_toSpecZero,
    ← Spec.map_comp, ← Spec.map_comp]
  congr 1

section Domain
variable [IsDomain A]

/-- The actual original finite family generates exactly the literal original
fraction-adjoin ring, in the same fraction field. -/
theorem fcFinite_fractionAlgebra_eq_blowupChart (l : Fin (n + 1)) :
    ReesChart.fractionAlgebra g l = blowupChart (Finset.univ.image g) (g l) := by
  classical
  unfold ReesChart.fractionAlgebra blowupChart
  congr 1
  ext z
  constructor
  · rintro ⟨m, rfl⟩
    exact ⟨g m, Finset.mem_image.mpr ⟨m, Finset.mem_univ _, rfl⟩, rfl⟩
  · rintro ⟨a, ha, rfl⟩
    obtain ⟨m, _, rfl⟩ := Finset.mem_image.mp ha
    exact ⟨m, rfl⟩

/-- The genuine degree-zero localization is the entire original paper chart. -/
def fcFiniteChartEquiv (l : Fin (n + 1)) (hl : g l ≠ 0) :
    ReesChart.Chart g l ≃ₐ[A] blowupChart (Finset.univ.image g) (g l) :=
  (ReesChart.fractionEquiv g l hl).trans
    (Subalgebra.equivOfEq _ _ (fcFinite_fractionAlgebra_eq_blowupChart g l))

/-- The entire actual ring equivalence gives the genuine affine scheme isomorphism. -/
def fcFiniteChartSchemeIso (l : Fin (n + 1)) (hl : g l ≠ 0) :
    Spec (CommRingCat.of (blowupChart (Finset.univ.image g) (g l))) ≅
      Spec (CommRingCat.of (ReesChart.Chart g l)) :=
  Scheme.Spec.mapIso (fcFiniteChartEquiv g l hl).toRingEquiv.toCommRingCatIso.op

/-- The actual original fraction-adjoin chart maps into the same original
finite-coordinate Rees scheme via the genuine ring equivalence. -/
def fcFinitePaperChartImmersion (l : Fin (n + 1)) (hl : g l ≠ 0) :
    Spec (CommRingCat.of (blowupChart (Finset.univ.image g) (g l))) ⟶ fcFiniteScheme g :=
  (fcFiniteChartSchemeIso g l hl).hom ≫ fcFiniteChartImmersion g l

/-- The original fraction-adjoin chart morphism is a genuine open immersion. -/
instance fcFinitePaperChartImmersion_isOpenImmersion (l : Fin (n + 1)) (hl : g l ≠ 0) :
    IsOpenImmersion (fcFinitePaperChartImmersion g l hl) := by
  unfold fcFinitePaperChartImmersion
  infer_instance

/-- The entire original coefficient triangle of each genuine fraction chart
commutes in the actual Rees scheme. -/
theorem fcFinitePaperChartImmersion_comp_projection (l : Fin (n + 1)) (hl : g l ≠ 0) :
    fcFinitePaperChartImmersion g l hl ≫ fcFiniteProjection g =
      Spec.map (CommRingCat.ofHom (algebraMap A (blowupChart (Finset.univ.image g) (g l)))) := by
  rw [fcFinitePaperChartImmersion, Category.assoc, fcFiniteChartImmersion_comp_projection]
  change Spec.map (CommRingCat.ofHom (fcFiniteChartEquiv g l hl).toRingHom) ≫
    Spec.map (CommRingCat.ofHom (ReesChart.coefficients g l)) = _
  rw [← Spec.map_comp]
  congr 1
  ext a
  exact congrArg (fun b : blowupChart (Finset.univ.image g) (g l) => (b : FractionRing A))
    ((fcFiniteChartEquiv g l hl).commutes a)

/-- Every actual point of the same original finite-coordinate Rees scheme is
covered by a genuine original fraction-adjoin chart with nonzero denominator. -/
def fcFinitePaperAffineOpenCover : (fcFiniteScheme g).AffineOpenCover where
  I₀ := {l : Fin (n + 1) // g l ≠ 0}
  X l := CommRingCat.of (blowupChart (Finset.univ.image g) (g l.1))
  f l := fcFinitePaperChartImmersion g l.1 l.2
  idx x := (fcFiniteNonzeroAffineOpenCover g).idx x
  covers x := by
    let 𝒰 := fcFiniteNonzeroAffineOpenCover g
    obtain ⟨q, hq⟩ := 𝒰.covers x
    let e := fcFiniteChartSchemeIso g (𝒰.idx x).1 (𝒰.idx x).2
    obtain ⟨p, hp⟩ := e.hom.homeomorph.surjective q
    change e.hom p = q at hp
    refine ⟨p, ?_⟩
    change fcFiniteChartImmersion g (𝒰.idx x).1 (e.hom p) = x
    rw [hp]
    exact hq

end Domain
end EnvelopeProperty.ReesPresentation
