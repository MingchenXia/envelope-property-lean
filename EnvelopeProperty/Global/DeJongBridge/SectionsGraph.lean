import Mathlib.AlgebraicGeometry.Morphisms.Separated

/-!
# Sections over `W ∩ f⁻¹(U)` for a morphism to a separated scheme

Let `f : Y ⟶ X` be a morphism of schemes, where `X` is separated over an affine scheme, let
`W ⊆ Y` and `U ⊆ X` be affine opens and put `V = W ∩ f⁻¹(U)`. Then

* `V` is affine (`isAffineOpen_inf_preimage`): `W → X` is an affine morphism, since `W` is affine
  and `X` is separated over an affine base;
* if `Y` is reduced, `Γ(Y, V)` is generated as a ring by the restrictions of the sections over
  `W` and the pull-backs of the sections over `U` (`closure_range_restrict_appLE_eq_top`).

This is the classical fact that the graph `V → W × U` of `f` is a closed immersion (`X` separated),
used in step 6 of the bridge to identify the coordinate ring of a chart
`{x_{j₀} y_{j₁} ≠ 0}` of a subvariety `Y ⊆ ℙ^N × ℙ^{N'}` with the ring generated by the ratios
`x_i / x_{j₀}` and `y_m / y_{j₁}`. The proof avoids fibre products: with `C ⊆ Γ(Y, V)` the subring
generated by the two families, the maps `Spec C → W` and `Spec C → U` agree on `X` after
precomposition with the dominant `Spec Γ(Y, V) → Spec C`, hence agree (`ext_of_isDominant`,
`X` separated, `Spec C` reduced); so `Spec C → W` factors through `V`, which gives a retraction of
`Spec Γ(Y, V) → Spec C`, i.e. a section of `C ↪ Γ(Y, V)`, and `C = Γ(Y, V)`.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

namespace DeJongEPBridge

universe u

variable {X Y S : Scheme.{u}}

/-- `W ∩ f⁻¹(U)` is affine for affine opens `W ⊆ Y`, `U ⊆ X`, when `X` is separated over an
affine scheme. -/
theorem isAffineOpen_inf_preimage [IsAffine S] (p : X ⟶ S) [IsSeparated p] (f : Y ⟶ X)
    {W : Y.Opens} (hW : IsAffineOpen W) {U : X.Opens} (hU : IsAffineOpen U) :
    IsAffineOpen (W ⊓ f ⁻¹ᵁ U) := by
  have : IsAffineHom ((hW.fromSpec ≫ f) ≫ p) := inferInstance
  have : IsAffineHom (hW.fromSpec ≫ f) := IsAffineHom.of_comp _ p
  have h := (hU.preimage (hW.fromSpec ≫ f)).image_of_isOpenImmersion hW.fromSpec
  rwa [Scheme.Hom.comp_preimage, Scheme.Hom.image_preimage_eq_opensRange_inf,
    hW.opensRange_fromSpec] at h

/-- A scheme separated over an affine scheme is separated. -/
theorem isSeparated_of_isSeparated_affine [IsAffine S] (p : X ⟶ S) [IsSeparated p] :
    X.IsSeparated :=
  ⟨by rw [← terminal.comp_from p]; infer_instance⟩

/-- **Sections over `W ∩ f⁻¹(U)`.** If `Y` is reduced, `X` is separated over an affine scheme and
`W ⊆ Y`, `U ⊆ X` are affine opens, then `Γ(Y, W ∩ f⁻¹(U))` is generated as a ring by the
restrictions of the sections over `W` and the pull-backs of the sections over `U`. -/
theorem closure_range_restrict_appLE_eq_top [IsAffine S] (p : X ⟶ S) [IsSeparated p] (f : Y ⟶ X)
    [IsReduced Y] {W : Y.Opens} (hW : IsAffineOpen W) {U : X.Opens} (hU : IsAffineOpen U) :
    Subring.closure
      (Set.range (Y.presheaf.map (homOfLE (inf_le_left : W ⊓ f ⁻¹ᵁ U ≤ W)).op).hom ∪
        Set.range (f.appLE U (W ⊓ f ⁻¹ᵁ U) inf_le_right).hom) = ⊤ := by
  have hV : IsAffineOpen (W ⊓ f ⁻¹ᵁ U) := isAffineOpen_inf_preimage p f hW hU
  have : X.IsSeparated := isSeparated_of_isSeparated_affine p
  set V := W ⊓ f ⁻¹ᵁ U with hVdef
  set C : Subring Γ(Y, V) := Subring.closure
      (Set.range (Y.presheaf.map (homOfLE (inf_le_left : V ≤ W)).op).hom ∪
        Set.range (f.appLE U V inf_le_right).hom) with hC
  let ρW : Γ(Y, W) →+* C := (Y.presheaf.map (homOfLE (inf_le_left : V ≤ W)).op).hom.codRestrict C
    fun x => Subring.subset_closure (Or.inl ⟨x, rfl⟩)
  let ρU : Γ(X, U) →+* C := (f.appLE U V inf_le_right).hom.codRestrict C
    fun x => Subring.subset_closure (Or.inr ⟨x, rfl⟩)
  let ℓ : Spec Γ(Y, V) ⟶ Spec (CommRingCat.of C) := Spec.map (CommRingCat.ofHom C.subtype)
  let σ : Spec (CommRingCat.of C) ⟶ Y := Spec.map (CommRingCat.ofHom ρW) ≫ hW.fromSpec
  let τ : Spec (CommRingCat.of C) ⟶ X := Spec.map (CommRingCat.ofHom ρU) ≫ hU.fromSpec
  have hℓσ : ℓ ≫ σ = hV.fromSpec := by
    have e : CommRingCat.ofHom ρW ≫ CommRingCat.ofHom C.subtype =
        Y.presheaf.map (homOfLE (inf_le_left : V ≤ W)).op := by
      ext x
      rfl
    rw [← Category.assoc, ← Spec.map_comp, e, IsAffineOpen.map_fromSpec]
  have hℓτ : ℓ ≫ τ = hV.fromSpec ≫ f := by
    have e : CommRingCat.ofHom ρU ≫ CommRingCat.ofHom C.subtype = f.appLE U V inf_le_right := by
      ext x
      rfl
    rw [← Category.assoc, ← Spec.map_comp, e, IsAffineOpen.SpecMap_appLE_fromSpec]
  -- `ℓ` is dominant, since `C → Γ(Y, V)` is injective.
  have hℓ : IsDominant ℓ := by
    refine ⟨?_⟩
    change DenseRange (PrimeSpectrum.comap C.subtype)
    rw [PrimeSpectrum.denseRange_comap_iff_ker_le_nilRadical,
      (RingHom.injective_iff_ker_eq_bot _).1 Subtype.val_injective]
    exact bot_le
  have : _root_.IsReduced C := isReduced_of_injective C.subtype Subtype.val_injective
  have hστ : σ ≫ f = τ := ext_of_isDominant ℓ (by rw [← Category.assoc, hℓσ, hℓτ])
  -- `σ` factors through `V`.
  have hrange : Set.range σ ⊆ Set.range hV.fromSpec := by
    rintro _ ⟨t, rfl⟩
    rw [hV.range_fromSpec]
    refine ⟨?_, ?_⟩
    · change hW.fromSpec ((Spec.map (CommRingCat.ofHom ρW)) t) ∈ (W : Set Y)
      rw [← hW.range_fromSpec]
      exact ⟨_, rfl⟩
    · change f (σ t) ∈ (U : Set X)
      rw [← Scheme.Hom.comp_apply, hστ, ← hU.range_fromSpec]
      exact ⟨_, rfl⟩
  let lam := IsOpenImmersion.lift hV.fromSpec σ hrange
  have hlam : lam ≫ hV.fromSpec = σ := IsOpenImmersion.lift_fac _ _ _
  have hℓlam : ℓ ≫ lam = 𝟙 _ := by
    rw [← cancel_mono hV.fromSpec, Category.assoc, hlam, hℓσ, Category.id_comp]
  -- `lam = Spec.map μ`, and `μ` is a section of `C ↪ Γ(Y, V)`.
  have hμ : Spec.preimage lam ≫ CommRingCat.ofHom C.subtype = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, Spec.map_preimage, Spec.map_id]
    exact hℓlam
  rw [eq_top_iff]
  intro x _
  have hx := congrArg (fun φ => φ.hom x) hμ
  simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp, Function.comp_apply,
    CommRingCat.hom_id, RingHom.id_apply] at hx
  rw [← hx]
  exact ((Spec.preimage lam).hom x).2

end DeJongEPBridge
