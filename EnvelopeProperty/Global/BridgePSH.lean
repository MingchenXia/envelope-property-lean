import EnvelopeProperty.Global.Bridge
import EnvelopeProperty.Projective.SubvarietyNormal
import EnvelopeProperty.Projective.FSSystemPL

/-!
# Bridges: sections and psh functions of rank-1 models generated in degree 1

This file implements part (1) of the blueprint lemma `lem:gl-bridge-psh` (`global.tex`,
subsection `subsec:gl-model`; remark `rmk:gl-bridges`) for the formalization of Fang–Han–Xia,
*The envelope property for unibranch projective varieties* (FHX). It is the
step of `cor:sg-smooth-model` (`smooth-general.tex`) which transfers Theorem 3.1 of FHX
(`thm:smooth-EP`) from projectively normal subvarieties `V(I) ⊆ ℙ^N` to rank-1 models.

## Setting

Let `𝒳 = (K, S, z)` be a model of rank `1` (`MultiModel k K 1`) with a presentation in degree `1`,
`P : DegOnePres 𝒳 N`: elements `w_0, …, w_N ∈ S_1` with `S = k[w_0 T, …, w_N T]`, kernel `I` of
`k[x_0, …, x_N] → S` and bridge homeomorphism `τ : V(I)^an ≃ₜ 𝒳^an` (`DegOnePres.anHomeomorph`,
`lem:gl-bridge-points`(1)).

## Results

* `MultiModel.isIntegral_monomial_of_isAdmissible_of_le` (the determinant trick of the proof of
  `lem:gl-bridge-psh`): if `S = k[z]` is generated by the coordinates and `b` is admissible for
  `f` in degree `d ≥ 0`, then `f T^d` is integral over `S`; it maps the finitely generated
  faithful `S`-module spanned by the `z^β T^b`, `β ∈ Mon(b)`, into itself, because every
  homogeneous element of `S` of degree `≥ b` lies in it
  (`MultiModel.monomial_coeff_mem_span_zMon`).
* `MultiModel.sections_eq_piece_of_le_coordAlg`: hence `R_d = S_d` for `d ∈ ℕ^r` if moreover `S`
  is integrally closed.
* `DegOnePres.isProjNormal_toProjSubvariety_iff`: `V(I)` is projectively normal iff `𝒳` is
  normal.
* `DegOnePres.sections_eq_piece_of_isProjNormal`, `DegOnePres.sections_eq_piece_toNat`
  (**`lem:gl-bridge-psh`(1)**, `R_a = S_a` for `a ≥ 0`): applied to the model `(K, S, w)`
  (`DegOnePres.recoord`), whose coordinates generate `S` and whose sections are those of `𝒳`
  (`DegOnePres.sections_recoord`).
* `DegOnePres.isFS_comp_anHomeomorph_iff`: `𝓗(V(I), a) ∘ τ⁻¹ = 𝓗(𝒳, a)` for `a ≥ 0`
  (Fubini–Study data are converted by `DegOnePres.fsDataOfProj` and `DegOnePres.fsDataToProj`,
  through forms `DegOnePres.form` with prescribed images);
  `DegOnePres.isFS_comp_anHomeomorph_symm` for every class.
* `DegOnePres.isPSH_comp_anHomeomorph_iff` (**`lem:gl-bridge-psh`(1)**):
  `PSH(V(I), t) = PSH(𝒳, t) ∘ τ` for `t ≥ 0`; the approximating nets on `𝒳` may have classes
  `< 0`, which are raised to `max(a, 0)` (FS2).
* `DegOnePres.hasEnvelopeProperty_toProjSubvariety_iff` (**`lem:gl-bridge-psh`(1)**):
  `EP_{V(I)}(t) ↔ EP_𝒳(t)` for `t ≥ 0`.

## Deviations from the blueprint

* The blueprint's proof uses that "`S` is generated by the coordinates"; in the setting of
  `lem:gl-bridge-points`(1) `S` is generated by the `w_i`, which need not be the coordinates `z` of
  `𝒳`. The determinant trick is therefore applied to `(K, S, w)`, whose sections coincide with those
  of `𝒳` by change of model (`lem:gl-model-change`).
* The claim "`R_a = 0` for `a < 0`" of `lem:gl-bridge-psh`(1) is not formalized: it fails when
  `V(I)` is a point (`S = k[w_0 T]`, `R_a = k w_0^a` for all `a ∈ ℤ`), and it is not needed, since
  the comparison of psh classes and of the envelope property is only used (and stated) for
  `t ≥ 0`.
-/

open scoped NNReal ENNReal Topology

open Topology Filter MvPolynomial

noncomputable section

namespace EnvelopeProperty

universe u

namespace MultiModel

variable {k : Type u} [Field k] {K : Type u} [Field K] [Algebra k K] {r : ℕ}

/-! ### Sections of models generated by their coordinates -/

section CoordGenerated

variable {X : MultiModel k K r}

/-- For `d ∈ ℕ^r`, the degree `d + b` of `f z̃^β T^{d + b}`. -/
theorem addDeg_natCast (d b : Fin r →₀ ℕ) : addDeg (fun c => (d c : ℤ)) b = d + b := by
  ext c
  simp only [addDeg_apply, Finsupp.add_apply]
  omega

/-- If `S = k[z]`, the `S`-span of the monomials `z^β`, `β ∈ Mon(b)`, contains every homogeneous
element of `S` of degree `≥ b`. -/
theorem monomial_coeff_mem_span_zMon {P : MvPolynomial (Fin r) K} (hP : P ∈ X.coordAlg)
    {b e : Fin r →₀ ℕ} (hbe : b ≤ e) :
    monomial e (P.coeff e) ∈ Submodule.span X.S
      ((fun β => monomial b (X.zCoeff β)) '' (X.monSet b : Set (X.CoordIndex →₀ ℕ))) := by
  classical
  set N := Submodule.span X.S
    ((fun β => monomial b (X.zCoeff β)) '' (X.monSet b : Set (X.CoordIndex →₀ ℕ)))
  have hP' : P ∈ Submodule.span k (Submonoid.closure (Set.range X.coordMono) :
      Set (MvPolynomial (Fin r) K)) := by
    rw [← Algebra.adjoin_eq_span]; exact hP
  clear hP
  induction hP' using Submodule.span_induction with
  | mem x hx =>
    have hγ : ∃ γ : X.CoordIndex →₀ ℕ, x = monomial (X.monDeg γ) (X.zCoeff γ) := by
      induction hx using Submonoid.closure_induction with
      | mem x hx =>
        obtain ⟨i, rfl⟩ := hx
        exact ⟨Finsupp.single i 1, by rw [monDeg_single, zCoeff_single, pow_one]; rfl⟩
      | one => exact ⟨0, by rw [monDeg_zero, zCoeff_zero, ← C_apply, C_1]⟩
      | mul x y _ _ hx hy =>
        obtain ⟨γ, rfl⟩ := hx
        obtain ⟨γ', rfl⟩ := hy
        exact ⟨γ + γ', by rw [monomial_mul, monDeg_add, zCoeff_add]⟩
    obtain ⟨γ, rfl⟩ := hγ
    rw [coeff_monomial]
    split_ifs with h
    · obtain ⟨γ₁, γ₂, rfl, h₁, h₂⟩ :=
        exists_add_of_monDeg_eq_add (X := X) (b := b) (e := e - b)
          (by rw [h, add_tsub_cancel_of_le hbe])
      have e1 : monomial e (X.zCoeff (γ₁ + γ₂)) =
          (X.zMon γ₂ : MvPolynomial (Fin r) K) * monomial b (X.zCoeff γ₁) := by
        rw [zMon, coe_ofPiece, monomial_mul, zCoeff_add, mul_comm, h₂,
          tsub_add_cancel_of_le hbe]
      rw [e1]
      exact N.smul_mem (X.zMon γ₂) (Submodule.subset_span ⟨γ₁, (X.mem_monSet).2 h₁, rfl⟩)
    · rw [monomial_zero]; exact N.zero_mem
  | zero => rw [coeff_zero, monomial_zero]; exact N.zero_mem
  | add x y _ _ hx hy => rw [coeff_add, map_add]; exact N.add_mem hx hy
  | smul c x _ hx =>
    rw [coeff_smul, ← smul_monomial]
    exact Submodule.smul_of_tower_mem N c hx

/-- **The determinant trick** (`lem:gl-bridge-psh`, proof): if `S = k[z]` is generated by the
coordinates and `b` is admissible for `f` in degree `d ∈ ℕ^r`, then `f T^d` is integral over `S`:
it maps the finitely generated faithful `S`-module spanned by the `z^β T^b`, `β ∈ Mon(b)`, into
itself, because `S_{d + b}` lies in it. -/
theorem isIntegral_monomial_of_isAdmissible_of_le (hS : X.S ≤ X.coordAlg) {d b : Fin r →₀ ℕ}
    {f : K} (h : X.IsAdmissible (fun c => (d c : ℤ)) b f) : IsIntegral X.S (monomial d f) := by
  classical
  set G := (fun β => monomial b (X.zCoeff β)) '' (X.monSet b : Set (X.CoordIndex →₀ ℕ))
  set N : Submodule X.S (MvPolynomial (Fin r) K) := Submodule.span X.S G
  refine isIntegral_of_smul_mem_submodule N ?_ ?_ _ ?_
  · obtain ⟨j, hj⟩ := X.exists_chartIndex_ne_zero
    intro hN
    have hmem : monomial b (X.zCoeff (X.chartMultiIndex j b)) ∈ N :=
      Submodule.subset_span ⟨_, X.chartMultiIndex_mem_monSet j b, rfl⟩
    rw [hN, Submodule.mem_bot, monomial_eq_zero, zCoeff_chartMultiIndex] at hmem
    exact chartDen_ne_zero hj b hmem
  · exact Submodule.fg_span ((X.monSet b).finite_toSet.image _)
  · intro n hn
    induction hn using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨β, hβ, rfl⟩ := hx
      have hfβ := h.mul_zCoeff_mem hβ
      rw [addDeg_natCast] at hfβ
      have hkey := monomial_coeff_mem_span_zMon (X := X) (hS hfβ) (le_add_self : b ≤ d + b)
      rw [coeff_monomial, if_pos rfl] at hkey
      rw [smul_eq_mul, monomial_mul]
      exact hkey
    | zero => rw [smul_zero]; exact N.zero_mem
    | add x y _ _ hx hy => rw [smul_add]; exact N.add_mem hx hy
    | smul s x _ hx =>
      rw [smul_comm]
      exact N.smul_mem s hx

/-- **`R_d = S_d`** (`lem:gl-bridge-psh`(1)): for a normal model whose coordinate ring is generated
by the coordinates, the sections of degree `d ∈ ℕ^r` are the homogeneous elements of degree `d`. -/
theorem sections_eq_piece_of_le_coordAlg (hS : X.S ≤ X.coordAlg) (hN : X.IsNormal)
    (d : Fin r →₀ ℕ) :
    X.sections (fun c => (d c : ℤ)) = X.piece d := by
  refine le_antisymm (fun f hf => ?_) (X.piece_le_sections d)
  obtain ⟨b, hb⟩ := hf
  have := X.isNormal_iff.1 hN
  obtain ⟨y, hy⟩ := (IsIntegrallyClosedIn.isIntegral_iff (R := X.S)).1
    (isIntegral_monomial_of_isAdmissible_of_le hS hb)
  rw [mem_piece, ← hy]
  exact y.2

end CoordGenerated

/-! ### Rank-1 models generated in degree 1 -/

namespace DegOnePres

variable {X : MultiModel k K 1} {N : ℕ} (P : DegOnePres X N)

/-- The coordinate ring of `(K, S, w)` is generated by its coordinates `w_i T`. -/
theorem recoord_S_le_coordAlg : P.recoord.S ≤ P.recoord.coordAlg := by
  intro p hp
  have hp' : p ∈ Algebra.adjoin k (Set.range fun i => monomial (Finsupp.single 0 1) (P.w i)) := by
    rw [P.adjoin_eq]; exact hp
  rw [← P.range_coordMono_eq] at hp'
  exact hp'

/-- `V(I)` is projectively normal iff `S` is integrally closed, as `k[x_0, …, x_N] / I ≅ S`. -/
theorem isProjNormal_toProjSubvariety_iff : P.toProjSubvariety.IsProjNormal ↔ X.IsNormal := by
  constructor
  · intro h
    have : IsIntegrallyClosed (MvPolynomial (Fin (N + 1)) k ⧸ P.ideal) := h
    exact IsIntegrallyClosed.of_equiv P.quotEquiv.toRingEquiv
  · intro h
    have : IsIntegrallyClosed X.S := h
    exact IsIntegrallyClosed.of_equiv P.quotEquiv.symm.toRingEquiv

omit P in
/-- The degree `n ∈ ℕ^1` as an element of `ℤ^1`. -/
theorem natCast_single_eq (n : ℕ) :
    (fun c : Fin 1 => ((Finsupp.single (0 : Fin 1) n c : ℕ) : ℤ)) = fun _ => (n : ℤ) := by
  funext c
  obtain rfl := Fin.fin_one_eq_zero c
  rw [Finsupp.single_eq_same]

/-- **`R_n = S_n`** (`lem:gl-bridge-psh`(1)) for a projectively normal `V(I)`: the sections of
degree `n ≥ 0` of `𝒳` are the elements of `S_n`, i.e. the images of the forms of degree `n`. -/
theorem sections_eq_piece_of_isProjNormal (hV : P.toProjSubvariety.IsProjNormal) (n : ℕ) :
    X.sections (fun _ => (n : ℤ)) = X.piece (Finsupp.single 0 n) := by
  rw [← P.sections_recoord, ← natCast_single_eq]
  exact MultiModel.sections_eq_piece_of_le_coordAlg P.recoord_S_le_coordAlg
    (P.isProjNormal_toProjSubvariety_iff.1 hV) _

/-- **`R_a = S_a`** for `a ≥ 0` (`lem:gl-bridge-psh`(1)). -/
theorem sections_eq_piece_toNat (hV : P.toProjSubvariety.IsProjNormal) {a : Fin 1 → ℤ}
    (ha : 0 ≤ a 0) : X.sections a = X.piece (Finsupp.single 0 (a 0).toNat) := by
  have e : a = fun _ => ((a 0).toNat : ℤ) := by
    funext c
    obtain rfl := Fin.fin_one_eq_zero c
    exact (Int.toNat_of_nonneg ha).symm
  rw [e]
  exact P.sections_eq_piece_of_isProjNormal hV _

/-! #### Forms with prescribed images -/

open Classical in
/-- A form `F` of degree `n` with `F(w T) = f T^n`, for `f ∈ S_n` (`0` otherwise). -/
def form (n : ℕ) (f : K) : MvPolynomial (Fin (N + 1)) k :=
  if h : f ∈ X.piece (Finsupp.single 0 n) then
    homogeneousComponent n (P.homS_surjective (X.ofPiece h)).choose
  else 0

/-- `DegOnePres.form n f` is homogeneous of degree `n`. -/
theorem form_isHomogeneous (n : ℕ) (f : K) : (P.form n f).IsHomogeneous n := by
  unfold form
  split_ifs
  · exact homogeneousComponent_isHomogeneous _ _
  · exact isHomogeneous_zero _ _ _

/-- `F(w T) = f T^n` for `F = DegOnePres.form n f`, `f ∈ S_n`. -/
theorem hom_form {n : ℕ} {f : K} (hf : f ∈ X.piece (Finsupp.single 0 n)) :
    P.hom (P.form n f) = monomial (Finsupp.single 0 n) f := by
  rw [form, dif_pos hf, hom_homogeneousComponent]
  have h := (P.homS_surjective (X.ofPiece hf)).choose_spec
  have h' : P.hom (P.homS_surjective (X.ofPiece hf)).choose = monomial (Finsupp.single 0 n) f :=
    congrArg Subtype.val h
  rw [h', coeff_monomial, if_pos rfl]

/-- `DegOnePres.hom_form` in `S`. -/
theorem homS_form {n : ℕ} {f : K} (hf : f ∈ X.piece (Finsupp.single 0 n)) :
    P.homS (P.form n f) = X.ofPiece hf :=
  Subtype.ext (P.hom_form hf)

/-- The image of a form of degree `n` is `f T^n` with `f` its coefficient of `T^n`. -/
theorem hom_of_isHomogeneous {n : ℕ} {F : MvPolynomial (Fin (N + 1)) k} (hF : F.IsHomogeneous n) :
    P.hom F = monomial (Finsupp.single 0 n) ((P.hom F).coeff (Finsupp.single 0 n)) := by
  rw [← P.hom_homogeneousComponent, homogeneousComponent_eq_self hF]

/-- `DegOnePres.hom_of_isHomogeneous` in `S`. -/
theorem homS_of_isHomogeneous {n : ℕ} {F : MvPolynomial (Fin (N + 1)) k}
    (hF : F.IsHomogeneous n) :
    P.homS F = X.ofPiece (P.coeff_hom_mem_piece F (Finsupp.single 0 n)) :=
  Subtype.ext (P.hom_of_isHomogeneous hF)

/-- Values of sections of degree `n` at a point of `𝒳^an`: `|f|_v = |F|_{τ⁻¹ v}` for a form `F`
of degree `n` with `F(w T) = f T^n`. -/
theorem secAbs_of_isHomogeneous (v : X.an) {n : ℕ} {F : MvPolynomial (Fin (N + 1)) k}
    (hF : F.IsHomogeneous n) :
    X.secAbs v.1 (fun _ => (n : ℤ)) ((P.hom F).coeff (Finsupp.single 0 n)) =
      (P.anHomeomorph.symm v).1.1.val F := by
  rw [secAbs_of_mem_piece v.2.2 (d := Finsupp.single 0 n) (fun c => by
      obtain rfl := Fin.fin_one_eq_zero c; rw [Finsupp.single_eq_same])
      (P.coeff_hom_mem_piece F _), ← P.homS_of_isHomogeneous hF, anHomeomorph_symm_val]

/-! #### Fubini–Study data -/

open Classical in
/-- Fubini–Study data on `V(I)` as Fubini–Study data on `𝒳`: the form `s_t` of degree `m a` is
replaced by the coefficient of its image `s_t(w T) ∈ S_{m a}`. -/
def fsDataOfProj {a : Fin 1 → ℚ} (D : ProjBerk.FSData k N (a 0)) : X.FSData a where
  m := D.m
  m_pos := D.m_pos
  deg := fun _ => (D.deg : ℤ)
  deg_eq c := by
    obtain rfl := Fin.fin_one_eq_zero c
    push_cast
    exact D.deg_eq
  terms := D.terms.image fun t => ((P.hom t.1).coeff (Finsupp.single 0 D.deg), t.2)
  mem_sections t ht := by
    obtain ⟨s, -, rfl⟩ := Finset.mem_image.1 ht
    exact mem_sections_of_mem_piece (d := Finsupp.single 0 D.deg) (fun c => by
      obtain rfl := Fin.fin_one_eq_zero c; rw [Finsupp.single_eq_same])
      (P.coeff_hom_mem_piece _ _)

/-- `DegOnePres.fsDataOfProj` defines the same function: `(D on 𝒳)(v) = D(τ⁻¹ v)`. -/
theorem eval_fsDataOfProj {a : Fin 1 → ℚ} (D : ProjBerk.FSData k N (a 0)) (v : X.an) :
    (P.fsDataOfProj D).eval v = D.eval (P.anHomeomorph.symm v).1 := by
  classical
  rw [FSData.eval_def, ProjBerk.FSData.eval_def]
  congr 1
  change (D.terms.image _).sup _ = _
  rw [Finset.sup_image]
  refine Finset.sup_congr rfl fun t ht => ?_
  rw [Function.comp_apply, termVal_def, ProjBerk.termVal_def, logSecAbs]
  change ENNReal.log (X.secAbs v.1 (fun _ => (D.deg : ℤ))
    ((P.hom t.1).coeff (Finsupp.single 0 D.deg)) : ℝ≥0∞) + _ = _
  rw [P.secAbs_of_isHomogeneous v (D.isHomogeneous t ht)]
  rfl

/-- Some form of `D` not in `I` gives a nonzero section of `DegOnePres.fsDataOfProj D`. -/
theorem exists_ne_zero_fsDataOfProj {a : Fin 1 → ℚ} (D : ProjBerk.FSData k N (a 0))
    (hD : ∃ t ∈ D.terms, t.1 ∉ P.toProjSubvariety.ideal) :
    ∃ t ∈ (P.fsDataOfProj D).terms, t.1 ≠ 0 := by
  classical
  obtain ⟨t, ht, htI⟩ := hD
  refine ⟨_, Finset.mem_image_of_mem _ ht, fun h0 => htI ?_⟩
  rw [toProjSubvariety_ideal, mem_ideal_iff, P.hom_of_isHomogeneous (D.isHomogeneous t ht)]
  exact (monomial_eq_zero).2 h0

omit P in
/-- Fubini–Study data of a class `a ≥ 0` have degree `m a ≥ 0`. -/
theorem _root_.EnvelopeProperty.MultiModel.FSData.deg_zero_nonneg {a : Fin 1 → ℚ} (ha : 0 ≤ a 0)
    (D : X.FSData a) : 0 ≤ D.deg 0 := by
  have : (0 : ℚ) ≤ D.deg 0 := by
    rw [D.deg_eq 0]; exact mul_nonneg (Nat.cast_nonneg _) ha
  exact_mod_cast this

/-- The sections of Fubini–Study data of a class `a ≥ 0` lie in `S_{m a}`. -/
theorem mem_piece_of_mem_terms (hV : P.toProjSubvariety.IsProjNormal) {a : Fin 1 → ℚ}
    (ha : 0 ≤ a 0) (D : X.FSData a) {t : K × ℝ} (ht : t ∈ D.terms) :
    t.1 ∈ X.piece (Finsupp.single 0 (D.deg 0).toNat) := by
  rw [← P.sections_eq_piece_toNat hV (D.deg_zero_nonneg ha)]
  exact D.mem_sections t ht

open Classical in
/-- Fubini–Study data on `𝒳` of a class `a ≥ 0` as Fubini–Study data on `V(I)` (for `V(I)`
projectively normal): the section `f_t ∈ R_{m a} = S_{m a}` is replaced by a form of degree `m a`
with image `f_t T^{m a}`. -/
def fsDataToProj (hV : P.toProjSubvariety.IsProjNormal) {a : Fin 1 → ℚ} (ha : 0 ≤ a 0)
    (D : X.FSData a) (hD : ∃ t ∈ D.terms, t.1 ≠ 0) : ProjBerk.FSData k N (a 0) where
  m := D.m
  m_pos := D.m_pos
  deg := (D.deg 0).toNat
  deg_eq := by
    rw [← D.deg_eq 0]
    exact_mod_cast Int.toNat_of_nonneg (D.deg_zero_nonneg ha)
  terms := D.terms.image fun t => (P.form (D.deg 0).toNat t.1, t.2)
  isHomogeneous t ht := by
    obtain ⟨s, -, rfl⟩ := Finset.mem_image.1 ht
    exact P.form_isHomogeneous _ _
  exists_ne_zero := by
    obtain ⟨t, ht, ht0⟩ := hD
    refine ⟨_, Finset.mem_image_of_mem _ ht, fun h0 => ht0 ?_⟩
    have h := P.hom_form (P.mem_piece_of_mem_terms hV ha D ht)
    rw [show P.form (D.deg 0).toNat t.1 = 0 from h0, map_zero] at h
    exact (monomial_eq_zero).1 h.symm

/-- `DegOnePres.fsDataToProj` defines the same function: `(D on V(I))(u) = D(τ u)`. -/
theorem eval_fsDataToProj (hV : P.toProjSubvariety.IsProjNormal) {a : Fin 1 → ℚ}
    (ha : 0 ≤ a 0) (D : X.FSData a) (hD : ∃ t ∈ D.terms, t.1 ≠ 0)
    (u : P.toProjSubvariety.an) :
    (P.fsDataToProj hV ha D hD).eval u.1 = D.eval (P.anHomeomorph u) := by
  classical
  rw [FSData.eval_def, ProjBerk.FSData.eval_def]
  congr 1
  change (D.terms.image _).sup _ = _
  rw [Finset.sup_image]
  refine Finset.sup_congr rfl fun t ht => ?_
  rw [Function.comp_apply, termVal_def, ProjBerk.termVal_def, logSecAbs]
  have hmem := P.mem_piece_of_mem_terms hV ha D ht
  have hdeg : D.deg = fun _ => ((D.deg 0).toNat : ℤ) := by
    funext c
    obtain rfl := Fin.fin_one_eq_zero c
    exact (Int.toNat_of_nonneg (D.deg_zero_nonneg ha)).symm
  rw [hdeg, secAbs_of_mem_piece (P.anHomeomorph u).2.2 (d := Finsupp.single 0 (D.deg 0).toNat)
    (fun c => by obtain rfl := Fin.fin_one_eq_zero c; rw [Finsupp.single_eq_same]) hmem,
    ← P.homS_form hmem, anHomeomorph_val]
  rfl

/-- A nonzero section of `D` gives a form of `DegOnePres.fsDataToProj D` not in `I`. -/
theorem notMem_ideal_fsDataToProj (hV : P.toProjSubvariety.IsProjNormal) {a : Fin 1 → ℚ}
    (ha : 0 ≤ a 0) (D : X.FSData a) (hD : ∃ t ∈ D.terms, t.1 ≠ 0) :
    ∃ t ∈ (P.fsDataToProj hV ha D hD).terms, t.1 ∉ P.toProjSubvariety.ideal := by
  classical
  obtain ⟨t, ht, ht0⟩ := hD
  refine ⟨_, Finset.mem_image_of_mem _ ht, fun hI => ht0 ?_⟩
  rw [toProjSubvariety_ideal, mem_ideal_iff, P.hom_form (P.mem_piece_of_mem_terms hV ha D ht)]
    at hI
  exact (monomial_eq_zero).1 hI

/-! #### Fubini–Study functions, psh functions and the envelope property -/

/-- Fubini–Study functions on `V(I)` are Fubini–Study functions on `𝒳` (every class). -/
theorem isFS_comp_anHomeomorph_symm {a : Fin 1 → ℚ} {ψ : P.toProjSubvariety.an → EReal}
    (hψ : P.toProjSubvariety.IsFS (a 0) ψ) : X.IsFS a (ψ ∘ P.anHomeomorph.symm) := by
  obtain ⟨D, hD, hψ⟩ := hψ
  refine ⟨P.fsDataOfProj D, P.exists_ne_zero_fsDataOfProj D hD, fun v => ?_⟩
  rw [eval_fsDataOfProj, Function.comp_apply, hψ]

/-- **`𝓗(𝒳, a) = 𝓗(V(I), a) ∘ τ⁻¹`** for `a ≥ 0` and `V(I)` projectively normal
(`lem:gl-bridge-psh`(1)): the Fubini–Study families coincide since `R_{m a} = S_{m a}`. -/
theorem isFS_comp_anHomeomorph_iff (hV : P.toProjSubvariety.IsProjNormal) {a : Fin 1 → ℚ}
    (ha : 0 ≤ a 0) {φ : X.an → EReal} :
    P.toProjSubvariety.IsFS (a 0) (φ ∘ P.anHomeomorph) ↔ X.IsFS a φ := by
  refine ⟨fun h => ?_, fun h => ?_⟩
  · have := P.isFS_comp_anHomeomorph_symm h
    rwa [Function.comp_assoc, Homeomorph.self_comp_symm, Function.comp_id] at this
  · obtain ⟨D, hD, hφ⟩ := h
    exact ⟨P.fsDataToProj hV ha D hD, P.notMem_ideal_fsDataToProj hV ha D hD, fun u => by
      rw [eval_fsDataToProj, Function.comp_apply, hφ]⟩

/-- The bridge maps the trivial point `⋆` of `𝒳` to that of `V(I)`. -/
theorem anHomeomorph_symm_triv : P.anHomeomorph.symm X.triv = P.toProjSubvariety.triv := by
  rw [← P.anHomeomorph_triv, Homeomorph.symm_apply_apply]

/-- **`PSH(V(I), t) = PSH(𝒳, t) ∘ τ`** for `t ≥ 0` and `V(I)` projectively normal
(`lem:gl-bridge-psh`(1)). A Fubini–Study function of `𝒳` of a class `a` is also one of the class
`max(a, 0)` (FS2), so the approximating nets of `𝒳` may be taken with classes `≥ 0`. -/
theorem isPSH_comp_anHomeomorph_iff (hV : P.toProjSubvariety.IsProjNormal) {t : ℝ} (ht : 0 ≤ t)
    {u : X.an → EReal} :
    P.toProjSubvariety.IsPSH t (u ∘ P.anHomeomorph) ↔ X.IsPSH (fun _ => t) u := by
  constructor
  · intro h
    have h' : P.toProjSubvariety.fsSystem.toFSSystemC.IsPSH (fun _ => t) (u ∘ P.anHomeomorph) :=
      FSSystem.toFSSystemC_isPSH_iff.2 h
    have := FSSystemC.IsPSH.comp_of_isFS (F := P.toProjSubvariety.fsSystem.toFSSystemC)
      (G := X.fsSystem) P.anHomeomorph.symm.continuous P.anHomeomorph_symm_triv
      (fun a φ hφ => P.isFS_comp_anHomeomorph_symm hφ) h'
    rwa [Function.comp_assoc, Homeomorph.self_comp_symm, Function.comp_id] at this
  · rintro ⟨⟨x, hx⟩, husc, ι, hpre, hdir, hnon, a, f, hf, ha, hanti, hinf⟩
    refine ⟨⟨P.anHomeomorph.symm x, by simpa using hx⟩, husc.comp P.anHomeomorph.continuous, ι,
      hpre, hdir, hnon, fun i c => max (a i c) 0, fun i => f i ∘ P.anHomeomorph, fun i => ?_, ?_,
      fun y => hanti (P.anHomeomorph y), fun y => hinf (P.anHomeomorph y)⟩
    · change P.toProjSubvariety.IsFS (max (a i 0) 0) (f i ∘ P.anHomeomorph)
      exact (P.isFS_comp_anHomeomorph_iff hV (a := fun c => max (a i c) 0) (le_max_right _ _)).2
        ((hf i).mono_class fun c => le_max_left _ _)
    · have hcont : Continuous fun θ : Fin 1 → ℝ => fun c => max (θ c) 0 :=
        continuous_pi fun c => (continuous_apply c).max continuous_const
      have h1 := (hcont.tendsto (fun _ => t)).comp ha
      have e1 : ((fun θ : Fin 1 → ℝ => fun c => max (θ c) 0) ∘ fun i c => (a i c : ℝ)) =
          fun i c => ((max (a i c) 0 : ℚ) : ℝ) := by
        funext i c
        simp
      have e2 : (fun c : Fin 1 => max ((fun _ : Fin 1 => t) c) 0) = fun _ => t := by
        funext c
        exact max_eq_left ht
      rwa [e1, e2] at h1

/-- **`EP_{V(I)}(t) ↔ EP_𝒳(t)`** for `t ≥ 0` and `V(I)` projectively normal
(`lem:gl-bridge-psh`(1)). -/
theorem hasEnvelopeProperty_toProjSubvariety_iff (hV : P.toProjSubvariety.IsProjNormal) {t : ℝ}
    (ht : 0 ≤ t) :
    P.toProjSubvariety.HasEnvelopeProperty t ↔ X.HasEnvelopeProperty fun _ => t :=
  FSSystemC.hasEnvelopeProperty_iff_of_isPSH_comp_iff (F' := X.fsSystem)
    (G' := P.toProjSubvariety.fsSystem.toFSSystemC) P.anHomeomorph
    fun _ => P.isPSH_comp_anHomeomorph_iff hV ht

end DegOnePres

end MultiModel

