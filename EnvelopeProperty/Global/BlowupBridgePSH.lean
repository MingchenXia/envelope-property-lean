import EnvelopeProperty.Global.BlowupModelOf
import EnvelopeProperty.Global.ModelPSH
import EnvelopeProperty.Global.MorphismsPSH
import EnvelopeProperty.Projective.BlowupPSH

/-!
# Psh functions on rank-2 models generated by their coordinates and on blowups

This file implements part (2) of the blueprint lemma `lem:gl-bridge-psh` of `global.tex`
(subsection `subsec:gl-model`; the remark `rmk:gl-bridges`) for the formalization of Fang–Han–Xia,
*The envelope property for unibranch projective varieties* (FHX; the bridge is used
in `lem:gl-stein`(3) and Step 1 of FHX `thm:normal-ample-EP`): for a rank-2 model `𝒳` generated by
its coordinates whose presentation `R_{M,M'} → S` has the ideal `I'` of a blowup `B` as kernel,
the homeomorphism `ϑ : 𝒳^an ≃ₜ B^an` (`MultiModel.blowupAnHomeomorph`,
`EnvelopeProperty.Global.BlowupBridge`) identifies the psh classes:
`PSH(𝒳, θ) ∘ ϑ⁻¹ = PSH(B, θ)` for `θ ∈ ℝ²_{≥0}` (`MultiModel.isPSH_comp_blowupAnHomeomorph_iff`).

## Models generated by their coordinates (any rank)

Let `𝒳 = (K, S, z)` be a model with `S = k[z]`.

* `MultiModel.piece_le_span_zCoeff`: `S_e` is spanned over `k` by the `z̃^γ`, `γ ∈ Mon(e)`.
* `MultiModel.IsAdmissible.pow_of_eq_coordAlg`: **uniform admissible degree for powers**. If `b`
  is admissible for `f ∈ R_d`, `d ∈ ℕ^r`, then `b` is admissible for every power `f^n ∈ R_{n d}`.
  Induction on `n`: `f^n z̃^β ∈ S_{n d + b}` is a combination of monomials `z̃^γ`,
  `γ ∈ Mon(n d + b)`,
  each of which splits as `z̃^{γ'} z̃^{γ''}` with `γ'' ∈ Mon(b)`, and `f z̃^{γ''} ∈ S_{d+b}`.
* `MultiModel.isIntegral_monomial_of_isAdmissible`: `f T^d` is integral over `S` (determinant
  trick, `isIntegral_of_smul_mem_submodule`, with the `S`-module spanned by the `z^β`,
  `β ∈ Mon(b)`); this is the form in which the blueprint states the argument.
* `MultiModel.termVal_eq_sup_monSet`: `log |g| + λ = max_{β ∈ Mon(b)} (log |g z̃^β T^{d+b}| + λ)`
  for an admissible `b`; `MultiModel.FSData.powTerms` (`f_t ↦ f_t^n`, `m ↦ n m`) and
  `MultiModel.FSData.expandMon` (`f_t ↦ f_t z̃^β`, `β ∈ Mon(b)`) rewrite a Fubini–Study function
  of class `a` without changing it, the latter with class `a + b / m` and **polynomial** sections
  (elements of `S_{m a + b}`).

## The rank-2 bridge (`lem:gl-bridge-psh`(2))

Let `𝒳` have rank `2`, `hX : S = k[z]`, `B : V.BlowupCenter M'` with `hB : biIdeal = B.ideal`,
and `ϑ = blowupAnHomeomorph hX B hB`.

* `MultiModel.biLift`: a bihomogeneous preimage of bidegree `(e_0, e_1)` of `f T^e ∈ S`;
  `MultiModel.termVal_eq_biTermVal`: `log |f|_v + λ = log |F|_{ϑ v} + λ`.
* **Fubini–Study inclusions.** `MultiModel.isFS_comp_blowupAnHomeomorph`:
  `𝓗(B, a) ∘ ϑ ⊆ 𝓗(𝒳, a)` (polynomial sections are model sections). Conversely
  `MultiModel.IsFS.exists_isFS_blowup`: for `φ ∈ 𝓗(𝒳, a)`, `a ≥ 0`, there are `m > 0` and
  `b ∈ ℕ²` with `φ ∘ ϑ⁻¹ ∈ 𝓗(B, a + b / (n m))` for every `n ≥ 1` (powers `f_t^n` with the uniform
  admissible degree `b`, expanded into polynomial sections); hence
  `MultiModel.IsFS.isPSH_comp_blowupAnHomeomorph_symm`: `φ ∘ ϑ⁻¹ ∈ PSH(B, a)` by PSH2 on `B`
  (`ProjSubvariety.BlowupCenter.isPSH_of_antitone_seq`, constant sequence), and
  `MultiModel.IsFS.isPSH_comp_blowupAnHomeomorph_symm_sup`: `φ ∘ ϑ⁻¹ ∈ PSH(B, a ⊔ 0)` for every
  `a ∈ ℚ²` (a model FS function of class `a` is one of class `a ⊔ 0`).
* **Psh functions.** `MultiModel.isPSH_comp_blowupAnHomeomorph`: `PSH(B, θ) ∘ ϑ ⊆ PSH(𝒳, θ)`
  for every `θ`; `MultiModel.IsPSH.blowup_comp_symm`: `PSH(𝒳, θ) ∘ ϑ⁻¹ ⊆ PSH(B, θ ⊔ 0)` for every
  `θ ∈ ℝ²` (PSH2 on `B` for the approximating nets, with classes `a_i ⊔ 0 → θ ⊔ 0`); together
  `MultiModel.isPSH_comp_blowupAnHomeomorph_iff` and
  `MultiModel.isPSH_iff_isPSH_comp_blowupAnHomeomorph_symm` for `0 ≤ θ`, and
  `MultiModel.hasEnvelopeProperty_iff_blowup`: `EP_𝒳(θ) ↔ EP_B(θ)` for `0 ≤ θ`.
  The hypothesis `0 ≤ θ` is needed for `PSH(𝒳, θ) ∘ ϑ⁻¹ ⊆ PSH(B, θ)`: `PSH(B, θ) = ∅` unless
  `θ ≥ 0` (`prop:pg-maxprin`), while `log |f| ∈ PSH(𝒳, d)` for every nonzero model section of a
  degree `d ∈ ℤ²` (`MultiModel.isPSH_logSecAbs`); e.g. for the blowup of `ℙ²` at `[1 : 0 : 0]`
  along `(x_1, x_2)`, `x_1 / x_0 ∈ R_{(2, -1)}`.
* For the model of a blowup (`ProjSubvariety.BlowupCenter.multiModel`,
  `EnvelopeProperty.Global.BlowupModelOf`): `ProjSubvariety.BlowupCenter.isPSH_multiModel_comp_iff`
  and `ProjSubvariety.BlowupCenter.hasEnvelopeProperty_multiModel_iff`.

## Deviation from the blueprint

The blueprint proves integrality of `f T^a` over `S` by the determinant trick and then uses
finiteness of `S[f T^a]` to get the admissible degree `(N - 1) b` for all powers. The formal proof
shows directly that `b` itself is admissible for all powers (`IsAdmissible.pow_of_eq_coordAlg`),
which only uses `S_{e} = span {z̃^γ : γ ∈ Mon(e)}` for `S = k[z]`; integrality is recorded
separately. The classes `a + b/(n m)` replace `a + (N - 1) b / (m n)`.
-/

open scoped NNReal ENNReal Topology

open Topology Filter MvPolynomial

noncomputable section

namespace EnvelopeProperty

universe u

namespace MultiModel

variable {k : Type u} [Field k] {K : Type u} [Field K] [Algebra k K] {r : ℕ}

/-! ### Models generated by their coordinates -/

section Generated

variable {X : MultiModel k K r}

/-- For a model generated by its coordinates, `S_e` is spanned by the monomials `z̃^γ`,
`γ ∈ Mon(e)`. -/
theorem piece_le_span_zCoeff (hX : X.S = X.coordAlg) (e : Fin r →₀ ℕ) :
    X.piece e ≤ Submodule.span k (X.zCoeff '' (X.monSet e : Set (X.CoordIndex →₀ ℕ))) := by
  classical
  intro f hf
  have hmem : monomial e f ∈ X.coordAlg := hX ▸ mem_piece.1 hf
  rw [coordAlg, Algebra.adjoin_range_eq_range_aeval] at hmem
  obtain ⟨P, hP⟩ := hmem
  have hf' : f = (aeval X.coordMono P).coeff e := by
    rw [show (aeval X.coordMono) P = monomial e f from hP, coeff_monomial, if_pos rfl]
  rw [hf', P.as_sum, map_sum, coeff_sum]
  refine Submodule.sum_mem _ fun β _ => ?_
  rw [aeval_monomial, ← monomial_monDeg_zCoeff, MvPolynomial.algebraMap_apply, C_mul_monomial,
    coeff_monomial]
  split_ifs with h
  · rw [← Algebra.smul_def]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨β, X.mem_monSet.2 h, rfl⟩)
  · exact Submodule.zero_mem _

private theorem addDeg_zero_nsmul (d : Fin r → ℤ) (b : Fin r →₀ ℕ) : addDeg ((0 : ℕ) • d) b = b := by
  ext c
  simp [addDeg_apply]

/-- **Uniform admissible degree for powers**: for a model generated by its coordinates, an
admissible degree `b` of `f ∈ R_d`, `d ∈ ℕ^r`, is admissible for every power `f^n ∈ R_{n d}`. -/
theorem IsAdmissible.pow_of_eq_coordAlg (hX : X.S = X.coordAlg) {d : Fin r → ℤ}
    (hd : ∀ c, 0 ≤ d c) {b : Fin r →₀ ℕ} {f : K} (hf : X.IsAdmissible d b f) (n : ℕ) :
    X.IsAdmissible (n • d) b (f ^ n) := by
  have hnd : ∀ (n : ℕ) (c : Fin r), 0 ≤ (n • d) c := fun n c => by
    rw [Pi.smul_apply, nsmul_eq_mul]
    exact mul_nonneg (Nat.cast_nonneg n) (hd c)
  have hnd0 : ∀ (n : ℕ) (c : Fin r), 0 ≤ (n • d) c + ((0 : Fin r →₀ ℕ) c : ℤ) := fun n c => by
    simpa using hnd n c
  have main : ∀ n : ℕ, ∀ β ∈ X.monSet b, f ^ n * X.zCoeff β ∈ X.piece (addDeg (n • d) b) := by
    intro n
    induction n with
    | zero =>
      intro β hβ
      rw [pow_zero, one_mul, addDeg_zero_nsmul]
      exact zCoeff_mem_piece_of_mem_monSet hβ
    | succ n ih =>
      intro β hβ
      have hsplit : addDeg (n • d) b = addDeg (n • d) 0 + b := by
        rw [← addDeg_add (hnd0 n) b, zero_add]
      have hE : addDeg ((n + 1) • d) b = addDeg (n • d) 0 + addDeg d b := by
        rw [succ_nsmul, ← addDeg_add_add (hnd0 n) hf.1, zero_add]
      rw [pow_succ', mul_assoc, hE]
      have key : ∀ g ∈ Submodule.span k (X.zCoeff '' (X.monSet (addDeg (n • d) b) :
          Set (X.CoordIndex →₀ ℕ))), f * g ∈ X.piece (addDeg (n • d) 0 + addDeg d b) := by
        intro g hg
        induction hg using Submodule.span_induction with
        | mem x hx =>
          obtain ⟨γ, hγ, rfl⟩ := hx
          rw [Finset.mem_coe, mem_monSet, hsplit] at hγ
          obtain ⟨γ₁, γ₂, rfl, h₁, h₂⟩ := exists_add_of_monDeg_eq_add hγ
          rw [X.zCoeff_add, mul_left_comm, ← h₁]
          exact mul_mem_piece (X.zCoeff_mem_piece γ₁) (hf.mul_zCoeff_mem (X.mem_monSet.2 h₂))
        | zero => rw [mul_zero]; exact Submodule.zero_mem _
        | add x y _ _ hx hy => rw [mul_add]; exact Submodule.add_mem _ hx hy
        | smul c x _ hx => rw [mul_smul_comm]; exact Submodule.smul_mem _ c hx
      exact key _ (piece_le_span_zCoeff hX _ (ih β hβ))
  exact ⟨fun c => add_nonneg (hnd n c) (Nat.cast_nonneg _), main n⟩

/-- **Integrality of sections** (`lem:gl-bridge-psh`, proof): for a model generated by its
coordinates and `f ∈ R_d`, `d ∈ ℕ^r`, the element `f T^d` is integral over `S` (determinant trick
with the `S`-module spanned by the `z^β`, `β ∈ Mon(b)`, `b` admissible). -/
theorem isIntegral_monomial_of_isAdmissible (hX : X.S = X.coordAlg) {d : Fin r →₀ ℕ}
    {b : Fin r →₀ ℕ} {f : K} (hf : X.IsAdmissible (fun c => (d c : ℤ)) b f) :
    IsIntegral X.S (monomial d f) := by
  classical
  set N : Submodule X.S (MvPolynomial (Fin r) K) :=
    Submodule.span X.S ((fun β => monomial (X.monDeg β) (X.zCoeff β)) '' (X.monSet b : Set _))
  have hdb : addDeg (fun c => (d c : ℤ)) b = d + b := by
    ext c
    simp only [addDeg_apply, Finsupp.add_apply]
    omega
  refine isIntegral_of_smul_mem_submodule N ?_ (Submodule.fg_span ((X.monSet b).finite_toSet.image
    _)) _ fun n hn => ?_
  · obtain ⟨β, hβ, hz, -⟩ := exists_mem_monSet_ne_zero X.triv.2.2 b
    intro hN
    have hmem : monomial (X.monDeg β) (X.zCoeff β) ∈ N := Submodule.subset_span ⟨β, hβ, rfl⟩
    rw [hN, Submodule.mem_bot, monomial_eq_zero] at hmem
    exact hz hmem
  · induction hn using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨β, hβ, rfl⟩ := hx
      -- `f T^d z^β ∈ S_{d+b} T^{d+b} = span {z^γ : γ ∈ Mon(d + b)}`, and `z^γ ∈ S z^{γ''}`.
      have hmemS : f * X.zCoeff β ∈ X.piece (d + b) := hdb ▸ hf.mul_zCoeff_mem hβ
      have hspan := piece_le_span_zCoeff hX _ hmemS
      have hmon : (monomial d f : MvPolynomial (Fin r) K) • monomial (X.monDeg β) (X.zCoeff β) =
          monomial (d + b) (f * X.zCoeff β) := by
        rw [smul_eq_mul, monomial_mul, X.mem_monSet.1 hβ]
      rw [hmon]
      refine (show ∀ g ∈ Submodule.span k (X.zCoeff '' (X.monSet (d + b) :
          Set (X.CoordIndex →₀ ℕ))), (monomial (d + b) g : MvPolynomial (Fin r) K) ∈ N from
        fun g hg => ?_) _ hspan
      induction hg using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨γ, hγ, rfl⟩ := hy
        obtain ⟨γ₁, γ₂, rfl, h₁, h₂⟩ := exists_add_of_monDeg_eq_add (X.mem_monSet.1 hγ)
        have hz₁ : X.zCoeff γ₁ ∈ X.piece d := h₁ ▸ X.zCoeff_mem_piece γ₁
        have e : (monomial (d + b) (X.zCoeff (γ₁ + γ₂)) : MvPolynomial (Fin r) K) =
            (X.ofPiece hz₁ : X.S) • monomial (X.monDeg γ₂) (X.zCoeff γ₂) := by
          rw [Subalgebra.smul_def, coe_ofPiece, smul_eq_mul, monomial_mul, X.zCoeff_add, h₂]
        rw [e]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨γ₂, X.mem_monSet.2 h₂, rfl⟩)
      | zero => rw [map_zero]; exact Submodule.zero_mem _
      | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
      | smul c x _ hx =>
        rw [← smul_monomial, ← algebraMap_smul X.S c]
        exact Submodule.smul_mem _ _ hx
    | zero => rw [smul_zero]; exact Submodule.zero_mem _
    | add x y _ _ hx hy => rw [smul_add]; exact Submodule.add_mem _ hx hy
    | smul c x _ hx => rw [smul_comm]; exact Submodule.smul_mem _ c hx

end Generated

/-! ### Expanding sections into polynomial sections -/

section Expand

variable {X : MultiModel k K r}

/-- **Expansion of a term**: for an admissible `b`,
`log |g| + λ = max_{β ∈ Mon(b)} (log |g z̃^β T^{d+b}| + λ)`. -/
theorem termVal_eq_sup_monSet {d : Fin r → ℤ} {b : Fin r →₀ ℕ} {g : K}
    (hg : X.IsAdmissible d b g) (μ : ℝ) (v : X.an) :
    X.termVal d (g, μ) v = (X.monSet b).sup fun β =>
      X.termVal (fun c => (addDeg d b c : ℤ)) (g * X.zCoeff β, μ) v := by
  have hterm : ∀ β ∈ X.monSet b, X.termVal (fun c => (addDeg d b c : ℤ)) (g * X.zCoeff β, μ) v =
      ENNReal.log (X.homNorm v.1 (addDeg d b) (g * X.zCoeff β) : ℝ≥0∞) + (μ : EReal) := by
    intro β hβ
    rw [termVal_def, logSecAbs, secAbs_of_mem_piece v.2.2 (fun _ => rfl)
      (hg.mul_zCoeff_mem hβ), X.homNorm_of_mem v.1 (hg.mul_zCoeff_mem hβ)]
  rw [Finset.sup_congr rfl hterm, termVal_def, logSecAbs, secAbs_eq v.2.2 hg, secAbsAt,
    ENNReal.coe_finset_sup,
    Finset.apply_sup_eq_sup_comp_of_linearOrder ENNReal.log ENNReal.log_monotone
      (by rw [bot_eq_zero', ENNReal.log_zero]),
    Finset.apply_sup_eq_sup_comp_of_linearOrder (fun x : EReal => x + (μ : EReal))
      (fun _ _ h => add_le_add_left h _) (EReal.bot_add _)]
  rfl

/-- A common admissible degree for finitely many sections. -/
theorem exists_isAdmissible_of_forall_mem_sections {d : Fin r → ℤ} (s : Finset (K × ℝ))
    (hs : ∀ t ∈ s, t.1 ∈ X.sections d) : ∃ b : Fin r →₀ ℕ, ∀ t ∈ s, X.IsAdmissible d b t.1 := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨0, fun t ht => absurd ht (Finset.notMem_empty t)⟩
  | insert t s ht ih =>
    obtain ⟨b, hb⟩ := ih fun t' h' => hs t' (Finset.mem_insert_of_mem h')
    obtain ⟨b', hb'⟩ := hs t (Finset.mem_insert_self t s)
    refine ⟨b + b', fun t' h' => ?_⟩
    rcases Finset.mem_insert.1 h' with rfl | h'
    · exact hb'.mono le_add_self
    · exact (hb t' h').mono le_self_add

variable (X) in
open Classical in
/-- The expanded family `(f_t z̃^β, λ_t)`, `β ∈ Mon(b)`. -/
def expandMonTerms (T : Finset (K × ℝ)) (b : Fin r →₀ ℕ) : Finset (K × ℝ) :=
  (T ×ˢ X.monSet b).image fun p => (p.1.1 * X.zCoeff p.2, p.1.2)

theorem mem_expandMonTerms {T : Finset (K × ℝ)} {b : Fin r →₀ ℕ} {t : K × ℝ} :
    t ∈ X.expandMonTerms T b ↔ ∃ t₀ ∈ T, ∃ β ∈ X.monSet b, (t₀.1 * X.zCoeff β, t₀.2) = t := by
  classical
  rw [expandMonTerms, Finset.mem_image]
  constructor
  · rintro ⟨⟨t₀, β⟩, hp, rfl⟩
    exact ⟨t₀, (Finset.mem_product.1 hp).1, β, (Finset.mem_product.1 hp).2, rfl⟩
  · rintro ⟨t₀, h₀, β, hβ, rfl⟩
    exact ⟨(t₀, β), Finset.mem_product.2 ⟨h₀, hβ⟩, rfl⟩

theorem sup_expandMonTerms (T : Finset (K × ℝ)) (b : Fin r →₀ ℕ) (g : K × ℝ → EReal) :
    (X.expandMonTerms T b).sup g =
      T.sup fun t => (X.monSet b).sup fun β => g (t.1 * X.zCoeff β, t.2) := by
  classical
  rw [expandMonTerms, Finset.sup_image, Finset.sup_product_left]
  rfl

namespace FSData

variable {a : Fin r → ℚ}

/-- The same Fubini–Study function with `m` replaced by `n m` and `f_t` by `f_t^n`. -/
def powTerms (D : X.FSData a) (n : ℕ) (hn : 0 < n) : X.FSData a where
  m := n * D.m
  m_pos := Nat.mul_pos hn D.m_pos
  deg := n • D.deg
  deg_eq c := by
    rw [intCast_nsmul_apply, D.deg_eq, Nat.cast_mul]
    ring
  terms := scaleTerms n D.terms
  mem_sections := scaleTerms_mem_sections D.mem_sections

theorem powTerms_m (D : X.FSData a) (n : ℕ) (hn : 0 < n) : (D.powTerms n hn).m = n * D.m :=
  rfl

theorem powTerms_deg (D : X.FSData a) (n : ℕ) (hn : 0 < n) : (D.powTerms n hn).deg = n • D.deg :=
  rfl

theorem mem_powTerms_terms {D : X.FSData a} {n : ℕ} {hn : 0 < n} {t : K × ℝ}
    (ht : t ∈ (D.powTerms n hn).terms) : ∃ t₀ ∈ D.terms, t₀.1 ^ n = t.1 := by
  obtain ⟨t₀, h₀, rfl⟩ := mem_scaleTerms.1 ht
  exact ⟨t₀, h₀, rfl⟩

theorem eval_powTerms (D : X.FSData a) (n : ℕ) (hn : 0 < n) (v : X.an) :
    (D.powTerms n hn).eval v = D.eval v := by
  rw [eval_def, eval_def]
  change ((((n * D.m : ℕ) : ℝ)⁻¹ : ℝ) : EReal) *
    (scaleTerms n D.terms).sup (fun t => X.termVal (n • D.deg) t v) = _
  rw [sup_scaleTerms hn D.mem_sections v, ProjBerk.ereal_coe_mul_coe_mul]
  congr 2
  have hn' : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  push_cast
  field_simp [hn', D.m_ne_zero]

/-- **Expansion into polynomial sections**: for an admissible degree `b` of all `f_t`, the family
`(f_t z̃^β, λ_t)`, `β ∈ Mon(b)`, of elements of `S_{m a + b}` defines the same function
(`FSData.eval_expandMon`), of class `a + b / m`. -/
def expandMon (D : X.FSData a) (b : Fin r →₀ ℕ) (hb : ∀ t ∈ D.terms, X.IsAdmissible D.deg b t.1) :
    X.FSData (a + (D.m : ℚ)⁻¹ • fun c => (b c : ℚ)) where
  m := D.m
  m_pos := D.m_pos
  deg c := D.deg c + b c
  deg_eq c := by
    have : (D.m : ℚ) ≠ 0 := by exact_mod_cast D.m_pos.ne'
    rw [Int.cast_add, D.deg_eq, Pi.add_apply, Pi.smul_apply, smul_eq_mul, Int.cast_natCast]
    field_simp
  terms := X.expandMonTerms D.terms b
  mem_sections t ht := by
    obtain ⟨t₀, h₀, β, hβ, rfl⟩ := mem_expandMonTerms.1 ht
    exact mem_sections_of_mem_piece (fun c => by
      rw [addDeg_apply, Int.toNat_of_nonneg ((hb t₀ h₀).1 c)]) ((hb t₀ h₀).mul_zCoeff_mem hβ)

theorem expandMon_m (D : X.FSData a) (b : Fin r →₀ ℕ)
    (hb : ∀ t ∈ D.terms, X.IsAdmissible D.deg b t.1) : (D.expandMon b hb).m = D.m :=
  rfl

theorem expandMon_deg (D : X.FSData a) (b : Fin r →₀ ℕ)
    (hb : ∀ t ∈ D.terms, X.IsAdmissible D.deg b t.1) :
    (D.expandMon b hb).deg = fun c => D.deg c + b c :=
  rfl

/-- The sections of the expanded data are polynomial: `f_t z̃^β ∈ S_{m a + b}`. -/
theorem mem_piece_of_mem_expandMon_terms {D : X.FSData a} {b : Fin r →₀ ℕ}
    {hb : ∀ t ∈ D.terms, X.IsAdmissible D.deg b t.1} {t : K × ℝ}
    (ht : t ∈ (D.expandMon b hb).terms) : t.1 ∈ X.piece (addDeg D.deg b) := by
  obtain ⟨t₀, h₀, β, hβ, rfl⟩ := mem_expandMonTerms.1 ht
  exact (hb t₀ h₀).mul_zCoeff_mem hβ

theorem eval_expandMon (D : X.FSData a) (b : Fin r →₀ ℕ)
    (hb : ∀ t ∈ D.terms, X.IsAdmissible D.deg b t.1) (v : X.an) :
    (D.expandMon b hb).eval v = D.eval v := by
  rw [eval_def, eval_def]
  change (((D.m : ℝ)⁻¹ : ℝ) : EReal) * (X.expandMonTerms D.terms b).sup
    (fun t => X.termVal (fun c => D.deg c + b c) t v) = _
  rw [sup_expandMonTerms]
  refine congrArg (fun x => (((D.m : ℝ)⁻¹ : ℝ) : EReal) * x) ?_
  refine Finset.sup_congr rfl fun ⟨f, μ⟩ ht => ?_
  have hdeg : (fun c => D.deg c + (b c : ℤ)) = fun c => (addDeg D.deg b c : ℤ) := by
    funext c
    rw [addDeg_apply, Int.toNat_of_nonneg ((hb _ ht).1 c)]
  rw [termVal_eq_sup_monSet (hb _ ht) μ v, hdeg]

end FSData

end Expand

/-! ### The rank-2 bridge (`lem:gl-bridge-psh`(2)) -/

section Blowup

variable {X : MultiModel k K 2}

/-! #### Bihomogeneous lifts of polynomial sections -/

open Classical in
/-- A **bihomogeneous lift** of `f T^e ∈ S` for a rank-2 model generated by its coordinates: a
bihomogeneous `F ∈ R_{M,M'}` of bidegree `(e_0, e_1)` with `F(z) = f T^e`
(`MultiModel.biHomS_biLift`); `0` if `f ∉ S_e`. -/
def biLift (hX : X.S = X.coordAlg) (e : Fin 2 →₀ ℕ) (f : K) :
    MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k :=
  if h : f ∈ X.piece e then
    weightedHomogeneousComponent (biWeight (X.M 0) (X.M 1)) (e 0, e 1)
      (Function.surjInv (biHomS_surjective hX) (X.ofPiece h))
  else 0

variable (hX : X.S = X.coordAlg)

theorem isWeightedHomogeneous_biLift (e : Fin 2 →₀ ℕ) (f : K) :
    (biLift hX e f).IsWeightedHomogeneous (biWeight (X.M 0) (X.M 1)) (e 0, e 1) := by
  unfold biLift
  split_ifs
  · exact weightedHomogeneousComponent_isWeightedHomogeneous _ _
  · exact isWeightedHomogeneous_zero _ _ _

theorem biHomS_biLift {e : Fin 2 →₀ ℕ} {f : K} (hf : f ∈ X.piece e) :
    X.biHomS (biLift hX e f) = X.ofPiece hf := by
  rw [biLift, dif_pos hf, biHomS_weightedHomogeneousComponent,
    Function.surjInv_eq (biHomS_surjective hX) (X.ofPiece hf), biDeg_eq,
    homComp_ofPiece, if_pos rfl]

variable {hX} in
/-- The homogeneous component of the image of a bihomogeneous polynomial is the image. -/
theorem ofPiece_coeff_biHom {p : ℕ × ℕ} {F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k}
    (hF : F.IsWeightedHomogeneous (biWeight (X.M 0) (X.M 1)) p) :
    X.ofPiece (X.coeff_mem_piece (X.biHom_mem F) (biDeg p)) = X.biHomS F := by
  change X.homComp (biDeg p) (X.biHomS F) = _
  rw [homComp_biHomS, biDeg_apply_zero, biDeg_apply_one, Prod.mk.eta,
    weightedHomogeneousComponent_eq_self hF]

variable {V : ProjSubvariety k (X.M 0)} (B : V.BlowupCenter (X.M 1)) (hB : X.biIdeal = B.ideal)

/-- **Terms under the bridge**: for `f ∈ S_e`, `log |f|_v + λ = log |F|_{ϑ v} + λ` with `F` a
bihomogeneous lift of `f T^e`. -/
theorem termVal_eq_biTermVal (v : X.an) {e : Fin 2 →₀ ℕ} {f : K} (hf : f ∈ X.piece e) (μ : ℝ) :
    X.termVal (fun c => (e c : ℤ)) (f, μ) v =
      BiProjBerk.termVal (biLift hX e f, μ)
        (blowupAnHomeomorph hX B hB v : BiProjBerk k (X.M 0) (X.M 1)) := by
  simp only [termVal_def, BiProjBerk.termVal_def]
  rw [BiProjBerk.logAbs_def, blowupAnHomeomorph_val, biHomS_biLift hX hf, logSecAbs,
    secAbs_of_mem_piece v.2.2 (fun _ => rfl) hf]

/-- **Terms under the bridge**, converse direction: for `F` bihomogeneous of bidegree `p`,
`log |F|_{ϑ v} + λ = log |F(z)_p|_v + λ`. -/
theorem termVal_coeff_biHom (v : X.an) {p : ℕ × ℕ}
    {F : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k}
    (hF : F.IsWeightedHomogeneous (biWeight (X.M 0) (X.M 1)) p) (μ : ℝ) :
    X.termVal (fun c => (biDeg p c : ℤ)) ((X.biHom F).coeff (biDeg p), μ) v =
      BiProjBerk.termVal (F, μ) (blowupAnHomeomorph hX B hB v : BiProjBerk k (X.M 0) (X.M 1)) := by
  simp only [termVal_def, BiProjBerk.termVal_def]
  rw [BiProjBerk.logAbs_def, blowupAnHomeomorph_val, logSecAbs,
    secAbs_of_mem_piece v.2.2 (fun _ => rfl) (X.coeff_mem_piece (X.biHom_mem F) (biDeg p)),
    ofPiece_coeff_biHom hF]

/-! #### Fubini–Study data across the bridge -/

open Classical in
/-- The lifted family `(F_t, λ_t)` of a family `(f_t, λ_t)` of polynomial sections of degree
`e`. -/
def biLiftTerms (e : Fin 2 →₀ ℕ) (T : Finset (K × ℝ)) :
    Finset (MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k × ℝ) :=
  T.image fun t => (biLift hX e t.1, t.2)

theorem mem_biLiftTerms {e : Fin 2 →₀ ℕ} {T : Finset (K × ℝ)}
    {t : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k × ℝ} :
    t ∈ biLiftTerms hX e T ↔ ∃ t₀ ∈ T, (biLift hX e t₀.1, t₀.2) = t := by
  classical
  rw [biLiftTerms, Finset.mem_image]

theorem sup_biLiftTerms (e : Fin 2 →₀ ℕ) (T : Finset (K × ℝ))
    (g : MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k × ℝ → EReal) :
    (biLiftTerms hX e T).sup g = T.sup fun t => g (biLift hX e t.1, t.2) := by
  classical
  rw [biLiftTerms, Finset.sup_image]
  rfl

/-- **Polynomial Fubini–Study data on the blowup**: model data of class `a` whose sections are
polynomial of one degree `e` (`f_t ∈ S_e`, `m a = e`) give bigraded data of class `(a_0, a_1)`. -/
def biFSData {a : Fin 2 → ℚ} (D : X.FSData a) (e : Fin 2 →₀ ℕ) (hdeg : ∀ c, D.deg c = e c) :
    BiProjBerk.FSData k (X.M 0) (X.M 1) (a 0) (a 1) where
  m := D.m
  m_pos := D.m_pos
  deg := (e 0, e 1)
  deg_fst := by
    rw [← D.deg_eq 0, hdeg 0]
    simp
  deg_snd := by
    rw [← D.deg_eq 1, hdeg 1]
    simp
  terms := biLiftTerms hX e D.terms
  isWeightedHomogeneous t ht := by
    obtain ⟨t₀, -, rfl⟩ := (mem_biLiftTerms hX).1 ht
    exact isWeightedHomogeneous_biLift hX e t₀.1

theorem eval_biFSData {a : Fin 2 → ℚ} (D : X.FSData a) (e : Fin 2 →₀ ℕ)
    (hdeg : ∀ c, D.deg c = e c) (hterms : ∀ t ∈ D.terms, t.1 ∈ X.piece e) (v : X.an) :
    (biFSData hX D e hdeg).eval (blowupAnHomeomorph hX B hB v : BiProjBerk k (X.M 0) (X.M 1)) =
      D.eval v := by
  rw [BiProjBerk.FSData.eval_def, FSData.eval_def]
  change (((D.m : ℝ)⁻¹ : ℝ) : EReal) * (biLiftTerms hX e D.terms).sup
    (fun t => BiProjBerk.termVal t
      (blowupAnHomeomorph hX B hB v : BiProjBerk k (X.M 0) (X.M 1))) = _
  rw [sup_biLiftTerms]
  refine congrArg (fun x => (((D.m : ℝ)⁻¹ : ℝ) : EReal) * x) ?_
  have hD : D.deg = fun c => (e c : ℤ) := funext hdeg
  refine Finset.sup_congr rfl fun ⟨f, μ⟩ ht => ?_
  rw [hD]
  exact (termVal_eq_biTermVal hX B hB v (hterms _ ht) μ).symm

/-- **Polynomial Fubini–Study functions transport to the blowup**: if the sections of model data
of class `a` are polynomial of one degree, its function composed with `ϑ⁻¹` is a Fubini–Study
function of class `(a_0, a_1)` on `B`. -/
theorem isFS_blowup_of_forall_mem_piece {a : Fin 2 → ℚ} (D : X.FSData a) {e : Fin 2 →₀ ℕ}
    (hdeg : ∀ c, D.deg c = e c) (hterms : ∀ t ∈ D.terms, t.1 ∈ X.piece e)
    (htriv : D.eval X.triv ≠ ⊥) :
    B.IsFS (a 0) (a 1) (D.eval ∘ (blowupAnHomeomorph hX B hB).symm) := by
  refine ProjSubvariety.BlowupCenter.isFS_iff.2 ⟨biFSData hX D e hdeg, ?_, fun w => ?_⟩
  · rw [← blowupAnHomeomorph_triv hX B hB, eval_biFSData hX B hB D e hdeg hterms]
    exact htriv
  · rw [Function.comp_apply, ← eval_biFSData hX B hB D e hdeg hterms,
      Homeomorph.apply_symm_apply]

open Classical in
/-- The model family `((F_t(z))_p, λ_t)` of a bigraded family of bidegree `p`. -/
def ofBiTerms (p : ℕ × ℕ) (T : Finset (MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k × ℝ)) :
    Finset (K × ℝ) :=
  T.image fun t => ((X.biHom t.1).coeff (biDeg p), t.2)

omit hX in
theorem mem_ofBiTerms {p : ℕ × ℕ}
    {T : Finset (MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k × ℝ)} {t : K × ℝ} :
    t ∈ X.ofBiTerms p T ↔ ∃ t₀ ∈ T, ((X.biHom t₀.1).coeff (biDeg p), t₀.2) = t := by
  classical
  rw [ofBiTerms, Finset.mem_image]

omit hX in
theorem sup_ofBiTerms (p : ℕ × ℕ)
    (T : Finset (MvPolynomial (Fin (X.M 0 + 1) ⊕ Fin (X.M 1 + 1)) k × ℝ)) (g : K × ℝ → EReal) :
    (X.ofBiTerms p T).sup g = T.sup fun t => g ((X.biHom t.1).coeff (biDeg p), t.2) := by
  classical
  rw [ofBiTerms, Finset.sup_image]
  rfl

omit hX in
/-- **Bigraded Fubini–Study data as model data**: polynomial sections are model sections. -/
def ofBiFSData {a : Fin 2 → ℚ} (D : BiProjBerk.FSData k (X.M 0) (X.M 1) (a 0) (a 1)) :
    X.FSData a where
  m := D.m
  m_pos := D.m_pos
  deg c := (biDeg D.deg c : ℤ)
  deg_eq c := by
    fin_cases c
    · simp [D.deg_fst]
    · simp [D.deg_snd]
  terms := X.ofBiTerms D.deg D.terms
  mem_sections t ht := by
    obtain ⟨t₀, -, rfl⟩ := mem_ofBiTerms.1 ht
    exact mem_sections_of_mem_piece (fun _ => rfl) (X.coeff_mem_piece (X.biHom_mem t₀.1) _)

theorem eval_ofBiFSData {a : Fin 2 → ℚ} (D : BiProjBerk.FSData k (X.M 0) (X.M 1) (a 0) (a 1))
    (v : X.an) :
    (ofBiFSData D).eval v =
      D.eval (blowupAnHomeomorph hX B hB v : BiProjBerk k (X.M 0) (X.M 1)) := by
  rw [BiProjBerk.FSData.eval_def, FSData.eval_def]
  change (((D.m : ℝ)⁻¹ : ℝ) : EReal) * (X.ofBiTerms D.deg D.terms).sup
    (fun t => X.termVal (fun c => (biDeg D.deg c : ℤ)) t v) = _
  rw [sup_ofBiTerms]
  refine congrArg (fun x => (((D.m : ℝ)⁻¹ : ℝ) : EReal) * x) ?_
  refine Finset.sup_congr rfl fun ⟨F, μ⟩ ht => ?_
  exact termVal_coeff_biHom hX B hB v (D.isWeightedHomogeneous _ ht) μ

/-- **`𝓗(B, a) ∘ ϑ ⊆ 𝓗(𝒳, a)`** (`lem:gl-bridge-psh`(2), "polynomial sections are model
sections"). -/
theorem isFS_comp_blowupAnHomeomorph {a : Fin 2 → ℚ} {φ : B.an → EReal}
    (hφ : B.IsFS (a 0) (a 1) φ) : X.IsFS a (φ ∘ blowupAnHomeomorph hX B hB) := by
  obtain ⟨D, hD, hφD⟩ := ProjSubvariety.BlowupCenter.isFS_iff.1 hφ
  refine isFS_iff.2 ⟨ofBiFSData D, ?_, fun v => ?_⟩
  · rw [eval_ofBiFSData hX B hB, blowupAnHomeomorph_triv]
    exact hD
  · rw [Function.comp_apply, hφD, eval_ofBiFSData hX B hB]

/-! #### Model Fubini–Study functions on the blowup -/

/-- **Model Fubini–Study functions are polynomial Fubini–Study functions on the blowup, up to an
arbitrarily small increase of the class** (`lem:gl-bridge-psh`(2), proof): for `φ ∈ 𝓗(𝒳, a)`,
`a ≥ 0`, there are `m > 0` and `b ∈ ℕ²` with `φ ∘ ϑ⁻¹ ∈ 𝓗(B, a + b / (n m))` for every `n ≥ 1`.
Here `m` is the multiplier of a presentation `φ = m⁻¹ max_t (log |f_t| + λ_t)`, `b` a common
admissible degree of the `f_t`, admissible for all powers (`IsAdmissible.pow_of_eq_coordAlg`), and
`φ = (n m)⁻¹ max_{t, β} (log |f_t^n z̃^β T^{n m a + b}| + n λ_t)`. -/
theorem IsFS.exists_isFS_blowup {a : Fin 2 → ℚ} (ha : 0 ≤ a) {φ : X.an → EReal}
    (hφ : X.IsFS a φ) :
    ∃ m : ℕ, 0 < m ∧ ∃ b : Fin 2 →₀ ℕ, ∀ n : ℕ, 0 < n →
      B.IsFS (a 0 + b 0 / (n * m)) (a 1 + b 1 / (n * m))
        (φ ∘ (blowupAnHomeomorph hX B hB).symm) := by
  obtain ⟨D, hD0, hφD⟩ := hφ
  have hdeg0 : ∀ c, 0 ≤ D.deg c := fun c => by
    have : (0 : ℚ) ≤ D.deg c := by
      rw [D.deg_eq c]
      exact mul_nonneg (Nat.cast_nonneg _) (ha c)
    exact_mod_cast this
  obtain ⟨b, hb⟩ := exists_isAdmissible_of_forall_mem_sections D.terms D.mem_sections
  refine ⟨D.m, D.m_pos, b, fun n hn => ?_⟩
  have hbn : ∀ t ∈ (D.powTerms n hn).terms, X.IsAdmissible (D.powTerms n hn).deg b t.1 :=
    fun t ht => by
      obtain ⟨t₀, h₀, ht₀⟩ := FSData.mem_powTerms_terms ht
      rw [← ht₀]
      exact (hb t₀ h₀).pow_of_eq_coordAlg hX hdeg0 n
  have hnd : ∀ c, 0 ≤ (n • D.deg) c + (b c : ℤ) := fun c => by
    rw [Pi.smul_apply, nsmul_eq_mul]
    exact add_nonneg (mul_nonneg (Nat.cast_nonneg n) (hdeg0 c)) (Nat.cast_nonneg _)
  have hdegE : ∀ c, ((D.powTerms n hn).expandMon b hbn).deg c = addDeg (n • D.deg) b c :=
    fun c => by
      rw [FSData.expandMon_deg, FSData.powTerms_deg, addDeg_apply, Int.toNat_of_nonneg (hnd c)]
  have htermsE : ∀ t ∈ ((D.powTerms n hn).expandMon b hbn).terms,
      t.1 ∈ X.piece (addDeg (n • D.deg) b) := fun t ht => by
    have := FSData.mem_piece_of_mem_expandMon_terms ht
    rwa [FSData.powTerms_deg] at this
  have hevalE : ∀ v, ((D.powTerms n hn).expandMon b hbn).eval v = D.eval v := fun v => by
    rw [FSData.eval_expandMon, FSData.eval_powTerms]
  have htriv : ((D.powTerms n hn).expandMon b hbn).eval X.triv ≠ ⊥ := by
    rw [hevalE]
    exact (FSData.eval_triv_ne_bot_iff D).2 hD0
  have h := isFS_blowup_of_forall_mem_piece hX B hB _ hdegE htermsE htriv
  have hfun : ((D.powTerms n hn).expandMon b hbn).eval ∘ (blowupAnHomeomorph hX B hB).symm =
      φ ∘ (blowupAnHomeomorph hX B hB).symm := by
    funext w
    rw [Function.comp_apply, Function.comp_apply, hevalE, hφD]
  have hcls : ∀ c, (a + ((D.powTerms n hn).m : ℚ)⁻¹ • fun c => (b c : ℚ)) c =
      a c + b c / (n * D.m) := by
    intro c
    rw [Pi.add_apply, Pi.smul_apply, smul_eq_mul, FSData.powTerms_m, Nat.cast_mul,
      div_eq_inv_mul]
  rw [hfun, hcls, hcls] at h
  exact h

/-- `x + y / ((n + 1) m) → x`. -/
private theorem tendsto_add_div_succ_mul (x y : ℚ) {m : ℕ} (hm : 0 < m) :
    Tendsto (fun n : ℕ => ((x + y / ((n + 1 : ℕ) * m) : ℚ) : ℝ)) atTop (𝓝 (x : ℝ)) := by
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  have hden : Tendsto (fun n : ℕ => ((n : ℝ) + 1) * m) atTop atTop :=
    Tendsto.atTop_mul_const hm' (tendsto_atTop_add_const_right _ 1 tendsto_natCast_atTop_atTop)
  have h := (tendsto_const_nhds (x := (x : ℝ))).add
    ((tendsto_const_nhds (x := (y : ℝ))).div_atTop hden)
  rw [add_zero] at h
  refine h.congr fun n => ?_
  push_cast
  ring

/-- **Model Fubini–Study functions are psh on the blowup**: `φ ∘ ϑ⁻¹ ∈ PSH(B, a)` for
`φ ∈ 𝓗(𝒳, a)`, `a ∈ ℚ²_{≥0}` (`lem:gl-bridge-psh`(2), proof): the constant sequence `φ ∘ ϑ⁻¹`
lies in `PSH(B, a + b / ((n + 1) m))` (`IsFS.exists_isFS_blowup`), and PSH2 on `B`
(`thm:pg-psh2`(3), `ProjSubvariety.BlowupCenter.isPSH_of_antitone_seq`) applies. -/
theorem IsFS.isPSH_comp_blowupAnHomeomorph_symm {a : Fin 2 → ℚ} (ha : 0 ≤ a)
    {φ : X.an → EReal} (hφ : X.IsFS a φ) :
    B.IsPSH (fun c => (a c : ℝ)) (φ ∘ (blowupAnHomeomorph hX B hB).symm) := by
  obtain ⟨m, hm, b, h⟩ := hφ.exists_isFS_blowup hX B hB ha
  have hu : ∀ n : ℕ, B.IsPSH ![((a 0 + b 0 / ((n + 1 : ℕ) * m) : ℚ) : ℝ),
      ((a 1 + b 1 / ((n + 1 : ℕ) * m) : ℚ) : ℝ)] (φ ∘ (blowupAnHomeomorph hX B hB).symm) :=
    fun n => (h (n + 1) n.succ_pos).isPSH
  refine ProjSubvariety.BlowupCenter.isPSH_of_antitone_seq ?_ hu (fun _ => antitone_const)
    (fun x => iInf_const.symm) ⟨B.triv, ?_⟩
  · refine tendsto_pi_nhds.2 (Fin.forall_fin_two.2 ⟨?_, ?_⟩)
    · simpa using tendsto_add_div_succ_mul (a 0) (b 0) hm
    · simpa using tendsto_add_div_succ_mul (a 1) (b 1) hm
  · rw [Function.comp_apply, ← blowupAnHomeomorph_triv hX B hB, Homeomorph.symm_apply_apply]
    exact hφ.apply_triv_ne_bot

/-- **Model Fubini–Study functions of any class**: `φ ∘ ϑ⁻¹ ∈ PSH(B, a ⊔ 0)` for
`φ ∈ 𝓗(𝒳, a)`, `a ∈ ℚ²` (a model FS function of class `a` is one of class `a ⊔ 0`, `(FS2)`). -/
theorem IsFS.isPSH_comp_blowupAnHomeomorph_symm_sup {a : Fin 2 → ℚ} {φ : X.an → EReal}
    (hφ : X.IsFS a φ) :
    B.IsPSH (fun c => ((a ⊔ 0) c : ℝ)) (φ ∘ (blowupAnHomeomorph hX B hB).symm) :=
  (hφ.mono_class le_sup_left).isPSH_comp_blowupAnHomeomorph_symm hX B hB le_sup_right

/-! #### Psh functions across the bridge -/

/-- **`PSH(B, θ) ∘ ϑ ⊆ PSH(𝒳, θ)`** for every `θ ∈ ℝ²` (pull back the approximating nets,
`isFS_comp_blowupAnHomeomorph`). -/
theorem isPSH_comp_blowupAnHomeomorph {θ : Fin 2 → ℝ} {u : B.an → EReal} (hu : B.IsPSH θ u) :
    X.IsPSH θ (u ∘ blowupAnHomeomorph hX B hB) :=
  FSSystemC.IsPSH.comp_of_isFS (F := B.fsSystem.toFSSystemC) (G := X.fsSystem)
    (blowupAnHomeomorph hX B hB).continuous (blowupAnHomeomorph_triv hX B hB)
    (fun _ _ hφ => isFS_comp_blowupAnHomeomorph hX B hB hφ)
    (FSSystem.toFSSystemC_isPSH_iff.2 hu)

/-- **`PSH(𝒳, θ) ∘ ϑ⁻¹ ⊆ PSH(B, θ ⊔ 0)`** for every `θ ∈ ℝ²` (`lem:gl-bridge-psh`(2), proof): a
decreasing net of model FS functions `φ_i` of classes `a_i → θ` gives the decreasing net
`φ_i ∘ ϑ⁻¹ ∈ PSH(B, a_i ⊔ 0)` (`IsFS.isPSH_comp_blowupAnHomeomorph_symm_sup`) with classes
`a_i ⊔ 0 → θ ⊔ 0`, and PSH2 on `B` (`thm:pg-psh2`(3)) applies. -/
theorem IsPSH.blowup_comp_symm {θ : Fin 2 → ℝ} {u : X.an → EReal} (hu : X.IsPSH θ u) :
    B.IsPSH (θ ⊔ 0) (u ∘ (blowupAnHomeomorph hX B hB).symm) := by
  have hne := hu.apply_triv_ne_bot
  obtain ⟨-, -, ι, _, _, _, a, f, hf, ha, hanti, hinf⟩ := hu
  refine FSSystem.isPSH_of_antitone (F := B.fsSystem) (θ := fun i c => (((a i ⊔ 0) c : ℚ) : ℝ))
    ?_ (u := fun i => f i ∘ (blowupAnHomeomorph hX B hB).symm)
    (fun i => IsFS.isPSH_comp_blowupAnHomeomorph_symm_sup hX B hB (hf i))
    (fun x i j hij => hanti _ hij) (fun x => hinf _) ⟨B.triv, ?_⟩
  · have hc : Continuous fun θ : Fin 2 → ℝ => fun c => Max.max (θ c) 0 :=
      continuous_pi fun c => (continuous_apply c).max continuous_const
    refine ((hc.tendsto θ).comp ha).congr fun i => ?_
    funext c
    simp only [Function.comp_apply, Pi.sup_apply, Pi.zero_apply]
    push_cast
    rfl
  · rw [Function.comp_apply, ← blowupAnHomeomorph_triv hX B hB, Homeomorph.symm_apply_apply]
    exact hne

/-- **`lem:gl-bridge-psh`(2)**: for `θ ∈ ℝ²_{≥0}`, `u ∘ ϑ ∈ PSH(𝒳, θ)` iff `u ∈ PSH(B, θ)`,
i.e. `PSH(𝒳, θ) ∘ ϑ⁻¹ = PSH(B, θ)`. -/
theorem isPSH_comp_blowupAnHomeomorph_iff {θ : Fin 2 → ℝ} (hθ : 0 ≤ θ) {u : B.an → EReal} :
    X.IsPSH θ (u ∘ blowupAnHomeomorph hX B hB) ↔ B.IsPSH θ u := by
  refine ⟨fun h => ?_, isPSH_comp_blowupAnHomeomorph hX B hB⟩
  have h' := h.blowup_comp_symm hX B hB
  rwa [sup_eq_left.2 hθ, Function.comp_assoc, Homeomorph.self_comp_symm, Function.comp_id] at h'

/-- **`lem:gl-bridge-psh`(2)**, model-side form: for `θ ∈ ℝ²_{≥0}`, `u ∈ PSH(𝒳, θ)` iff
`u ∘ ϑ⁻¹ ∈ PSH(B, θ)`. -/
theorem isPSH_iff_isPSH_comp_blowupAnHomeomorph_symm {θ : Fin 2 → ℝ} (hθ : 0 ≤ θ)
    {u : X.an → EReal} :
    X.IsPSH θ u ↔ B.IsPSH θ (u ∘ (blowupAnHomeomorph hX B hB).symm) := by
  rw [← isPSH_comp_blowupAnHomeomorph_iff hX B hB hθ, Function.comp_assoc,
    Homeomorph.symm_comp_self, Function.comp_id]

include hX hB in
/-- **The envelope property across the bridge**: `EP_𝒳(θ) ↔ EP_B(θ)` for `θ ∈ ℝ²_{≥0}`. -/
theorem hasEnvelopeProperty_iff_blowup {θ : Fin 2 → ℝ} (hθ : 0 ≤ θ) :
    X.HasEnvelopeProperty θ ↔ B.fsSystem.HasEnvelopeProperty θ :=
  (FSSystemC.hasEnvelopeProperty_iff_of_isPSH_comp_iff (G' := X.fsSystem)
    (F' := B.fsSystem.toFSSystemC) (blowupAnHomeomorph hX B hB)
    fun _ => isPSH_comp_blowupAnHomeomorph_iff hX B hB hθ).trans
    FSSystem.toFSSystemC_hasEnvelopeProperty_iff

end Blowup

end MultiModel

/-! ### The model of a blowup -/

namespace ProjSubvariety.BlowupCenter

variable {k : Type u} [Field k] {M M' : ℕ} {V : ProjSubvariety k M} (B : V.BlowupCenter M')

/-- **`lem:gl-bridge-psh`(2) for the model of a blowup** (`BlowupCenter.multiModel`): for
`θ ∈ ℝ²_{≥0}`, `PSH(𝒳_B, θ) ∘ ϑ⁻¹ = PSH(B, θ)`. -/
theorem isPSH_multiModel_comp_iff {θ : Fin 2 → ℝ} (hθ : 0 ≤ θ) {u : B.an → EReal} :
    B.multiModel.IsPSH θ (u ∘ B.multiModelAnHomeomorph) ↔ B.IsPSH θ u :=
  MultiModel.isPSH_comp_blowupAnHomeomorph_iff B.multiModel_S B B.multiModel_biIdeal hθ

/-- The envelope property of the model of a blowup is that of the blowup, for `θ ∈ ℝ²_{≥0}`. -/
theorem hasEnvelopeProperty_multiModel_iff {θ : Fin 2 → ℝ} (hθ : 0 ≤ θ) :
    B.multiModel.HasEnvelopeProperty θ ↔ B.fsSystem.HasEnvelopeProperty θ :=
  MultiModel.hasEnvelopeProperty_iff_blowup B.multiModel_S B B.multiModel_biIdeal hθ

end ProjSubvariety.BlowupCenter

end EnvelopeProperty
