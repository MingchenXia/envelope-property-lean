import EnvelopeProperty.Global.BlowupBridge
import EnvelopeProperty.Global.ModelQuotient

/-!
# The rank-2 model of a blowup

Let `V = V(I) ⊆ ℙ^M` be a projective variety (`EnvelopeProperty.ProjSubvariety`) and
`B : V.BlowupCenter M'` the centre `G_0, …, G_{M'}` of a blowup `X' → V` (`def:pg-blowup`), with
ideal `I' = B.ideal ⊆ R_{M,M'} = k[x_0, …, x_M, y_0, …, y_{M'}]`. This file constructs the
rank-2 model of `X'` (blueprint `rmk:gl-model-examples`(1) for `r = 2` and `I = I'`, in the form
used by `lem:gl-stein`(3) and `rmk:gl-bridges`), for the formalization of Fang–Han–Xia, *The
envelope property for unibranch projective varieties* (FHX
`thm:normal-ample-EP`, Step 1).

## Construction

* `ProjSubvariety.BlowupCenter.quotVarEquiv : Fin (M + 1) ⊕ Fin (M' + 1) ≃ QuotVar ![M, M']`,
  `x_j ↦ x^{(0)}_j`, `y_m ↦ x^{(1)}_m`: the variables of `R_{M,M'}` are the variables of the
  multigraded ring of `rmk:gl-model-examples`(1) for `r = 2`, `M_0 = M`, `M_1 = M'`. Under it the
  bigrading `deg x_j = (1, 0)`, `deg y_m = (0, 1)` (`EnvelopeProperty.biWeight`) is the
  multigrading `deg x^{(c)}_j = e_c` (`MultiModel.quotWeight`)
  (`BlowupCenter.biDeg_biWeight_quotVarEquiv_symm`), so renaming commutes with taking
  homogeneous components (`BlowupCenter.rename_weightedHomogeneousComponent_quotWeight`).
* `BlowupCenter.quotIdeal = I'` transported along `quotVarEquiv`: a multihomogeneous
  (`BlowupCenter.isMultihomogeneous_quotIdeal`, from `lem:pg-blowup-basic`(1)) prime ideal,
  relevant at the indices `BlowupCenter.quotIndex` (`BlowupCenter.isRelevantAt_quotIndex`: some
  `x_j ∉ I'`, some `y_m ∉ I'`, `lem:pg-blowup-basic`(1)).
* `BlowupCenter.multiModel : MultiModel k B.ModelField 2`, the quotient model
  `MultiModel.quotModel` of `quotIdeal` (`rmk:gl-model-examples`(1)), with `M_0 = M`,
  `M_1 = M'`. It is generated by its coordinates (`BlowupCenter.multiModel_S`), and the kernel of
  its presentation `R_{M,M'} → S`, `x_j ↦ z^{(0)}_j`, `y_m ↦ z^{(1)}_m`
  (`MultiModel.biIdeal`, `EnvelopeProperty.Global.BlowupBridge`) is `I'`
  (`BlowupCenter.multiModel_biIdeal`, by `MultiModel.ker_quotMap`).
* `BlowupCenter.multiModelAnHomeomorph : 𝒳^an ≃ₜ X'^an`, the bridge
  `MultiModel.blowupAnHomeomorph` for this model, with `⋆ ↦ ⋆'` and `|F|_{v'} = |F(z)|_v`.

The psh comparison for this model is `ProjSubvariety.BlowupCenter.isPSH_multiModel_comp_iff`
in `EnvelopeProperty.Global.BlowupBridgePSH`.
-/

open scoped NNReal ENNReal Topology

open Topology MvPolynomial

noncomputable section

namespace EnvelopeProperty

universe u

namespace ProjSubvariety.BlowupCenter

variable {k : Type u} [Field k] {M M' : ℕ}

/-! ### Variables -/

variable (M M') in
/-- The variables `x_j`, `y_m` of `R_{M,M'}` as the variables `x^{(0)}_j`, `x^{(1)}_m` of the
multigraded ring `k[x^{(c)}_j]` of `rmk:gl-model-examples`(1) for `r = 2`, `M_0 = M`,
`M_1 = M'`. -/
def quotVarEquiv : Fin (M + 1) ⊕ Fin (M' + 1) ≃ MultiModel.QuotVar ![M, M'] where
  toFun := Sum.elim (fun j => ⟨0, j⟩) (fun m => ⟨1, m⟩)
  invFun i := Fin.cons (α := fun c : Fin 2 => Fin (![M, M'] c + 1) → Fin (M + 1) ⊕ Fin (M' + 1))
    Sum.inl (Fin.cons (α := fun c : Fin 1 => Fin (![M, M'] c.succ + 1) → Fin (M + 1) ⊕ Fin (M' + 1))
      Sum.inr fun i => i.elim0) i.1 i.2
  left_inv := by rintro (j | m) <;> rfl
  right_inv := by
    rintro ⟨c, j⟩
    fin_cases c <;> rfl

@[simp]
theorem quotVarEquiv_inl (j : Fin (M + 1)) :
    quotVarEquiv M M' (Sum.inl j) = (⟨0, j⟩ : MultiModel.QuotVar ![M, M']) :=
  rfl

@[simp]
theorem quotVarEquiv_inr (m : Fin (M' + 1)) :
    quotVarEquiv M M' (Sum.inr m) = (⟨1, m⟩ : MultiModel.QuotVar ![M, M']) :=
  rfl

/-- The bidegree of `x_j`, `y_m` is the multidegree of `x^{(0)}_j`, `x^{(1)}_m`. -/
theorem biDeg_biWeight_quotVarEquiv_symm (i : MultiModel.QuotVar ![M, M']) :
    MultiModel.biDeg (biWeight M M' ((quotVarEquiv M M').symm i)) =
      MultiModel.quotWeight ![M, M'] i := by
  obtain ⟨c, j⟩ := i
  fin_cases c
  · exact MultiModel.biDeg_biWeight_inl M M' j
  · exact MultiModel.biDeg_biWeight_inr M M' j

/-- The bidegree of a monomial renamed along `quotVarEquiv.symm` is its multidegree. -/
theorem biDeg_weight_mapDomain_quotVarEquiv_symm (β : MultiModel.QuotVar ![M, M'] →₀ ℕ) :
    MultiModel.biDeg
        (Finsupp.weight (biWeight M M') (Finsupp.mapDomain (quotVarEquiv M M').symm β)) =
      Finsupp.weight (MultiModel.quotWeight ![M, M']) β := by
  rw [Finsupp.weight_apply, Finsupp.sum_mapDomain_index
    (h := fun i (n : ℕ) => n • biWeight M M' i) (fun _ => zero_smul _ _)
    (fun _ _ _ => add_smul _ _ _), map_finsuppSum, Finsupp.weight_apply]
  refine Finsupp.sum_congr fun i _ => ?_
  rw [map_nsmul, biDeg_biWeight_quotVarEquiv_symm]

/-- **Renaming commutes with homogeneous components**: the multihomogeneous component of degree
`a` corresponds to the bihomogeneous component of bidegree `(a_0, a_1)`. -/
theorem rename_weightedHomogeneousComponent_quotWeight (a : Fin 2 →₀ ℕ)
    (F : MvPolynomial (MultiModel.QuotVar ![M, M']) k) :
    rename (quotVarEquiv M M').symm
        (weightedHomogeneousComponent (MultiModel.quotWeight ![M, M']) a F) =
      weightedHomogeneousComponent (biWeight M M') (a 0, a 1)
        (rename (quotVarEquiv M M').symm F) := by
  classical
  induction F using MvPolynomial.induction_on' with
  | monomial β c =>
    rw [weightedHomogeneousComponent_of_mem (isWeightedHomogeneous_monomial _ β c rfl),
      rename_monomial,
      weightedHomogeneousComponent_of_mem (isWeightedHomogeneous_monomial _ _ c rfl)]
    have h : (Finsupp.weight (biWeight M M') (Finsupp.mapDomain (quotVarEquiv M M').symm β) =
        (a 0, a 1)) ↔ Finsupp.weight (MultiModel.quotWeight ![M, M']) β = a := by
      rw [← MultiModel.biDeg_injective.eq_iff, biDeg_weight_mapDomain_quotVarEquiv_symm,
        MultiModel.biDeg_eq]
    by_cases hβ : Finsupp.weight (MultiModel.quotWeight ![M, M']) β = a
    · rw [if_pos hβ.symm, if_pos (h.2 hβ).symm, rename_monomial]
    · rw [if_neg (Ne.symm hβ), if_neg (Ne.symm (mt h.1 hβ)), map_zero]
  | add F G hF hG => rw [map_add, map_add, hF, hG, map_add, map_add]

/-! ### The ideal -/

variable {V : ProjSubvariety k M} (B : V.BlowupCenter M')

/-- The ideal `I'` of the blowup (`def:pg-blowup`) in the variables `x^{(c)}_j` of
`rmk:gl-model-examples`(1). -/
def quotIdeal : Ideal (MvPolynomial (MultiModel.QuotVar ![M, M']) k) :=
  B.ideal.comap (rename (quotVarEquiv M M').symm)

theorem mem_quotIdeal_iff {F : MvPolynomial (MultiModel.QuotVar ![M, M']) k} :
    F ∈ B.quotIdeal ↔ rename (quotVarEquiv M M').symm F ∈ B.ideal :=
  Iff.rfl

theorem rename_mem_quotIdeal_iff {F : MvPolynomial (Fin (M + 1) ⊕ Fin (M' + 1)) k} :
    rename (quotVarEquiv M M') F ∈ B.quotIdeal ↔ F ∈ B.ideal := by
  rw [mem_quotIdeal_iff, rename_rename, Equiv.symm_comp_self, rename_id_apply]

instance isPrime_quotIdeal : B.quotIdeal.IsPrime :=
  Ideal.comap_isPrime _ _

/-- `quotIdeal` is multihomogeneous, since `I'` is bihomogeneous (`lem:pg-blowup-basic`(1)). -/
theorem isMultihomogeneous_quotIdeal : MultiModel.IsMultihomogeneous B.quotIdeal := by
  intro F hF a
  rw [mem_quotIdeal_iff, rename_weightedHomogeneousComponent_quotWeight]
  exact B.weightedHomogeneousComponent_mem_ideal hF _

/-- The indices `j_0` (some `x_j ∉ I'`) and `m_0` (some `y_m ∉ I'`) at which `quotIdeal` is
relevant. -/
def quotIndex : (c : Fin 2) → Fin (![M, M'] c + 1) :=
  Fin.cons (α := fun c : Fin 2 => Fin (![M, M'] c + 1)) B.exists_X_inl_notMem_ideal.choose
    (Fin.cons (α := fun c : Fin 1 => Fin (![M, M'] c.succ + 1))
      B.exists_X_inr_notMem_ideal.choose fun i => i.elim0)

/-- `quotIdeal` is relevant: `x_{j_0} ∉ I'` and `y_{m_0} ∉ I'` (`lem:pg-blowup-basic`(1)). -/
theorem isRelevantAt_quotIndex : MultiModel.IsRelevantAt B.quotIdeal B.quotIndex := by
  refine Fin.forall_fin_two.2 ⟨?_, ?_⟩
  · change X (quotVarEquiv M M' (Sum.inl B.exists_X_inl_notMem_ideal.choose)) ∉ B.quotIdeal
    rw [← rename_X, rename_mem_quotIdeal_iff]
    exact B.exists_X_inl_notMem_ideal.choose_spec
  · change X (quotVarEquiv M M' (Sum.inr B.exists_X_inr_notMem_ideal.choose)) ∉ B.quotIdeal
    rw [← rename_X, rename_mem_quotIdeal_iff]
    exact B.exists_X_inr_notMem_ideal.choose_spec

/-! ### The model -/

/-- The function field of the blowup: the degree-zero fractions of `R_{M,M'} / I'`. -/
abbrev ModelField : Type u :=
  MultiModel.QuotFieldTy B.quotIdeal B.quotIndex

/-- **The rank-2 model of the blowup** (`rmk:gl-model-examples`(1) for `r = 2`, `I = I'`):
the quotient model of `I'`, with coordinates `z^{(0)}_j = (x̄_j / x̄_{j_0}) T_0` and
`z^{(1)}_m = (ȳ_m / ȳ_{m_0}) T_1`. -/
def multiModel : MultiModel k B.ModelField 2 :=
  MultiModel.quotModel B.quotIdeal B.quotIndex B.isRelevantAt_quotIndex

theorem multiModel_M : B.multiModel.M = ![M, M'] :=
  rfl

theorem multiModel_M_zero : B.multiModel.M 0 = M :=
  rfl

theorem multiModel_M_one : B.multiModel.M 1 = M' :=
  rfl

/-- The model of the blowup is generated by its coordinates. -/
theorem multiModel_S : B.multiModel.S = B.multiModel.coordAlg :=
  rfl

/-- The presentation of the model of the blowup is `x^{(c)}_j ↦ z^{(c)}_j` after renaming. -/
theorem multiModel_biHom :
    B.multiModel.biHom = (MultiModel.quotMap B.quotIdeal B.quotIndex).comp
      (rename (quotVarEquiv M M')) := by
  refine MvPolynomial.algHom_ext fun i => ?_
  rcases i with j | m
  · rw [MultiModel.biHom_X_inl]
    change _ = MultiModel.quotMap B.quotIdeal B.quotIndex
      (rename (quotVarEquiv M M') (X (Sum.inl j)))
    rw [rename_X, MultiModel.quotMap_X]
    rfl
  · rw [MultiModel.biHom_X_inr]
    change _ = MultiModel.quotMap B.quotIdeal B.quotIndex
      (rename (quotVarEquiv M M') (X (Sum.inr m)))
    rw [rename_X, MultiModel.quotMap_X]
    rfl

/-- **The kernel of the presentation is the ideal of the blowup**: `biIdeal = I'`. -/
theorem multiModel_biIdeal : B.multiModel.biIdeal = B.ideal := by
  ext F
  rw [MultiModel.mem_biIdeal_iff, ← Subtype.coe_inj, MultiModel.coe_biHomS,
    ZeroMemClass.coe_zero, show B.multiModel.biHom F = MultiModel.quotMap B.quotIdeal B.quotIndex
      (rename (quotVarEquiv M M') F) from DFunLike.congr_fun B.multiModel_biHom F,
    ← RingHom.mem_ker,
    MultiModel.ker_quotMap B.isRelevantAt_quotIndex B.isMultihomogeneous_quotIdeal]
  exact B.rename_mem_quotIdeal_iff

/-- **The bridge for the model of the blowup** (`lem:gl-bridge-points`(2)):
`𝒳^an ≃ₜ X'^an`, restriction along `x_j ↦ z^{(0)}_j`, `y_m ↦ z^{(1)}_m`. -/
def multiModelAnHomeomorph : B.multiModel.an ≃ₜ B.an :=
  MultiModel.blowupAnHomeomorph B.multiModel_S B B.multiModel_biIdeal

theorem multiModelAnHomeomorph_val (v : B.multiModel.an)
    (F : MvPolynomial (Fin (M + 1) ⊕ Fin (M' + 1)) k) :
    (B.multiModelAnHomeomorph v : BiProjBerk k M M').1.val F =
      v.1.val (B.multiModel.biHomS F) :=
  rfl

/-- The bridge maps `⋆` to `⋆'`. -/
theorem multiModelAnHomeomorph_triv : B.multiModelAnHomeomorph B.multiModel.triv = B.triv :=
  MultiModel.blowupAnHomeomorph_triv B.multiModel_S B B.multiModel_biIdeal

/-- The blowup map under the bridge: `|f|_{μ(v')} = |f(z^{(0)})|_v`. -/
theorem proj_multiModelAnHomeomorph_val (v : B.multiModel.an)
    (f : MvPolynomial (Fin (M + 1)) k) :
    (B.proj (B.multiModelAnHomeomorph v) : ProjBerk k M).1.val f =
      v.1.val (B.multiModel.biHomS (rename Sum.inl f)) :=
  rfl

end ProjSubvariety.BlowupCenter

end EnvelopeProperty
