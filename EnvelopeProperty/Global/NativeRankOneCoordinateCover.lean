import EnvelopeProperty.Global.NativeRankOneChartComparison
import EnvelopeProperty.Global.ModelChangeSections

/-! # The actual original coordinates cover the whole native rank-one model -/
open scoped Classical
open MvPolynomial AlgebraicGeometry CategoryTheory
noncomputable section
universe u
namespace EnvelopeProperty.MultiModel
variable {k K : Type u} [Field k] [Field K] [Algebra k K]
  (X : MultiModel k K 1)

/-- The SAME original coordinate algebra is generated by the actual single degree-one family. -/
theorem nativeRankOne_coordAlg_eq : X.coordAlg =
    Algebra.adjoin k (Set.range fun i : Fin (X.M 0 + 1) =>
      monomial (Finsupp.single (0 : Fin 1) 1) (X.coord 0 i)) := by
  have hr : Set.range X.coordMono = Set.range fun i : Fin (X.M 0 + 1) =>
      monomial (Finsupp.single (0 : Fin 1) 1) (X.coord 0 i) := by
    ext q
    constructor
    · rintro ⟨⟨c, i⟩, rfl⟩
      have hc : c = 0 := Subsingleton.elim _ _
      subst c
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨⟨0, i⟩, rfl⟩
  exact congrArg (Algebra.adjoin k) hr

/-- The actual coordinate ideal in the SAME original algebra. -/
def nativeRankOneCoordinateIdeal : Ideal X.S :=
  Ideal.span (Set.range fun i : Fin (X.M 0 + 1) => X.coordElem ⟨0, i⟩)

/-- Original M2 derives actual radical containment, without a supplied native chart cover. -/
theorem nativeRankOne_positive_mem_coordinateRadical (d : ℕ) (hd : 0 < d)
    (p : X.S) (hp : p ∈ X.nativeTotalGrading d) :
    p ∈ X.nativeRankOneCoordinateIdeal.radical := by
  let e : Fin 1 →₀ ℕ := Finsupp.single 0 d
  let e₀ : Fin 1 →₀ ℕ := Finsupp.single 0 1
  let g : K := (p : MvPolynomial (Fin 1) K).coeff e
  have hpmon : (p : MvPolynomial (Fin 1) K) = monomial e g :=
    rankOne_homogeneous_eq_monomial d _ ((X.mem_nativeTotalGrading d p).mp hp)
  have hg : g ∈ X.piece e := by
    change monomial e g ∈ X.S
    rw [← hpmon]
    exact p.property
  obtain ⟨P, hPm, hP⟩ := X.isIntegral_coordAlg hg
  let N := P.natDegree
  have hN : 0 < N := by
    refine Nat.pos_of_ne_zero fun h0 => ?_
    rw [Polynomial.eq_one_of_monic_natDegree_zero hPm h0, Polynomial.eval₂_one] at hP
    exact one_ne_zero hP
  let c : Fin N → K := fun i => (P.coeff i).1.coeff ((N - i) • e)
  have hc : ∀ i : Fin N, c i ∈ X.piece ((N - i) • e) := fun i =>
    X.coeff_mem_piece (X.coordAlg_le (P.coeff i).property) _
  have hterm : ∀ i : Fin N,
      ((algebraMap X.coordAlg (MvPolynomial (Fin 1) K) (P.coeff i)) *
        monomial e g ^ (i : ℕ)).coeff (N • e) = c i * g ^ (i : ℕ) := by
    intro i
    have hle : (i : ℕ) • e ≤ N • e := nsmul_le_nsmul_left (zero_le) i.2.le
    have hsub : N • e - (i : ℕ) • e = (N - i) • e := by
      apply Finsupp.ext
      intro a
      simp [Nat.sub_mul]
    rw [monomial_pow, coeff_mul_monomial', if_pos hle, hsub]
    rfl
  have key := congrArg (fun q : MvPolynomial (Fin 1) K => q.coeff (N • e)) hP
  rw [hPm.as_sum, Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum,
    coeff_add, coeff_sum, Finset.sum_range (fun i => (Polynomial.eval₂
      (algebraMap X.coordAlg (MvPolynomial (Fin 1) K)) (monomial e g)
        (Polynomial.C (P.coeff i) * Polynomial.X ^ i)).coeff (N • e))] at key
  simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow] at key
  rw [Finset.sum_congr rfl fun i _ => hterm i, monomial_pow, coeff_monomial,
    if_pos rfl, coeff_zero] at key
  have hcI : ∀ i : Fin N, X.ofPiece (hc i) ∈ X.nativeRankOneCoordinateIdeal := by
    intro i
    let m := (N - i) * d
    have hm : 0 < m := Nat.mul_pos (Nat.sub_pos_of_lt i.2) hd
    have hdegree : m • e₀ = (N - i) • e := by
      simp only [m, e₀, e, Finsupp.smul_single, smul_eq_mul, mul_one]
    have hq : (P.coeff i).1 ∈ Algebra.adjoin k (Set.range fun l : Fin (X.M 0 + 1) =>
        monomial e₀ (X.coord 0 l)) := by
      rw [← X.nativeRankOne_coordAlg_eq]
      exact (P.coeff i).property
    obtain ⟨t, ht, hct⟩ := exists_coeff_nsmul_eq_sum_mul (W := X)
      (e := e₀) (w := fun l : Fin (X.M 0 + 1) => X.coord 0 l)
      (by simp [e₀]) (fun l => X.coord_mem_piece 0 l) hq hm
    rw [hdegree] at hct
    have hadd : e₀ + (m - 1) • e₀ = (N - i) • e := by
      rw [← hdegree]
      have hm' : 1 + (m - 1) = m := by omega
      simpa only [add_nsmul, one_nsmul] using congrArg (fun n => n • e₀) hm'
    have hrep : X.ofPiece (hc i) = ∑ l : Fin (X.M 0 + 1),
        X.coordElem ⟨0, l⟩ * X.ofPiece (ht l) := by
      apply Subtype.ext
      change monomial ((N - i) • e) (c i) = X.S.val _
      rw [map_sum]
      simp only [map_mul, Subalgebra.val_apply, X.coe_coordElem, X.coe_ofPiece,
        monomial_mul]
      change monomial ((N - i) • e) (c i) =
        ∑ l, monomial (e₀ + (m - 1) • e₀) (X.coord 0 l * t l)
      rw [hadd, ← map_sum]
      exact congrArg (monomial ((N - i) • e)) hct
    rw [hrep]
    apply Ideal.sum_mem
    intro l _
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨l, rfl⟩)
  have hdeg : ∀ i : Fin N, (N - i) • e + (i : ℕ) • e = N • e := fun i => by
    rw [← add_nsmul, Nat.sub_add_cancel i.2.le]
  have heq : X.ofPiece hg ^ N + ∑ i : Fin N, X.ofPiece (hc i) * X.ofPiece hg ^ (i : ℕ) = 0 := by
    apply Subtype.ext
    rw [Subalgebra.coe_add, Subalgebra.coe_pow, coe_ofPiece, AddSubmonoidClass.coe_finsetSum,
      ZeroMemClass.coe_zero, monomial_pow]
    simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, coe_ofPiece, monomial_pow, monomial_mul,
      hdeg]
    rw [← map_sum, ← map_add, key, map_zero]
  have hpS : p = X.ofPiece hg := Subtype.ext hpmon
  rw [hpS]
  apply Ideal.mem_radical_iff.mpr
  refine ⟨N, ?_⟩
  rw [eq_neg_of_add_eq_zero_left heq]
  exact neg_mem (Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ (hcI i))

/-- The SAME original irrelevant ideal lies in the actual original coordinate ideal's radical. -/
theorem nativeRankOne_irrelevant_le_coordinateRadical :
    (HomogeneousIdeal.irrelevant X.nativeTotalGrading).toIdeal ≤
      X.nativeRankOneCoordinateIdeal.radical := by
  rw [HomogeneousIdeal.irrelevant_eq_span]
  apply Ideal.span_le.mpr
  intro p hp
  simp only [Set.mem_iUnion, SetLike.mem_coe] at hp
  obtain ⟨d, hd, hp⟩ := hp
  exact X.nativeRankOne_positive_mem_coordinateRadical d hd p hp

/-- The SAME original finite coordinate family covers the WHOLE actual native rank-one scheme. -/
theorem nativeRankOne_iSup_coordinateOpen :
    (⨆ i : Fin (X.M 0 + 1), X.nativeRankOneCoordinateOpen i) = ⊤ := by
  apply top_le_iff.mp
  intro x _
  apply TopologicalSpace.Opens.mem_iSup.mpr
  change ∃ i : Fin (X.M 0 + 1), X.coordElem ⟨0, i⟩ ∉ x.asHomogeneousIdeal
  by_contra! H
  have hI : X.nativeRankOneCoordinateIdeal ≤ x.asHomogeneousIdeal.toIdeal :=
    Ideal.span_le.mpr (Set.range_subset_iff.mpr H)
  have hrad : X.nativeRankOneCoordinateIdeal.radical ≤ x.asHomogeneousIdeal.toIdeal :=
    x.isPrime.radical_le_iff.mpr hI
  exact x.not_irrelevant_le (X.nativeRankOne_irrelevant_le_coordinateRadical.trans hrad)

end EnvelopeProperty.MultiModel
