import EnvelopeProperty.Berkovich.Topology

/-!
# Integral multiprojective models and their analytifications

This file starts the global chapter (`global.tex`, subsection `subsec:gl-model`) of the
formalization of Fang–Han–Xia, *The envelope property for unibranch projective varieties*
(FHX, Sections 2, 4, 6, 7, 8): a projective variety `X` with globally generated
line bundles `L_1, …, L_r` whose product map is an embedding is modelled by an
**integral multiprojective model** `𝒳 = (K, S, z)` (`def:gl-model`). We implement the blueprint nodes `conv:gl-setting`, `def:gl-model`,
`lem:gl-multigraded-extension`, `def:gl-points` and `lem:gl-points-basic`; the charts
(`lem:gl-charts`) are in `EnvelopeProperty.Global.ModelCharts`.

## The model (`def:gl-model`)

`EnvelopeProperty.MultiModel k K r` bundles

* a finitely generated subalgebra `S ⊆ K[T_1, …, T_r]` (`MvPolynomial (Fin r) K`), graded in the
  sense that it contains the homogeneous components `p_a T^a` (`monomial a (p.coeff a)`) of its
  elements (`MultiModel.isGraded`);
* coordinates `z^{(c)}_j = f^{(c)}_j T^{e_c} ∈ S` (`MultiModel.coord c j = f^{(c)}_j`,
  `0 ≤ j ≤ M c`) with
  (M1) some `f^{(c)}_j ≠ 0` for every `c` (`MultiModel.exists_coord_ne_zero`),
  (M2) `S` integral over the subalgebra `k[z]` generated by the coordinates
  (`MultiModel.isIntegral`, `MultiModel.coordAlg`),
  (M3) `K` generated as a field over `k` by the quotients `f / g` of elements `f, g ∈ S_a`
  (`MultiModel.generates`).

The degree `a` part `S_a = {f ∈ K | f T^a ∈ S}` is the `k`-submodule `MultiModel.piece a` of `K`;
`MultiModel.ofPiece` is `f T^a` as an element of `S`, and `MultiModel.homComp a p = p_a T^a`.
For `β: CoordIndex →₀ ℕ` (a multi-index `β^{(c)}_j`), `z^β = z̃^β T^{deg β}` with
`MultiModel.zCoeff β = z̃^β` and `MultiModel.monDeg β = (∑_j β^{(c)}_j)_c`; `MultiModel.monSet b` is
the finite set `Mon(b)`. `MultiModel.IsNormal` is integral closedness of `S`.

## Points (`def:gl-points`, `lem:gl-points-basic`)

`MultiModel.an X ⊆ Berk k S` is the set of multiplicative seminorms on `S`, trivial on `k`, that
are *multigraded* (`|p_a T^a|_v ≤ |p|_v`, equivalently `|p|_v = max_a |p_a T^a|_v`,
`MultiModel.IsMultigraded.val_eq_sup`) and *normalized* (`max_j |z^{(c)}_j|_v = 1` for every `c`),
with the subspace topology. It is compact, Hausdorff, and second countable for countable `k`;
every `p ∈ S` has `|p|_v ≤ 1` (`MultiModel.val_le_one`). The proof of `|p|_v ≤ 1` uses the integral
equation of `p` over `k[z]` directly (no homogeneous components are needed, a slight simplification
of the blueprint's proof). `MultiModel.triv` is the trivial point `⋆`;
`MultiModel.HasGenericSupport` and `MultiModel.valSet` describe `𝒳^val` (the absolute value on
`K` of a point with generic support, `MultiModel.fieldVal`, is in
`EnvelopeProperty.Global.ModelCharts`).
`MultiModel.isFractionRing_S`: `Frac S = K(T)`; `MultiModel.isNormal_iff`: `𝒳` is normal iff `S` is
integrally closed in `K[T]`.

## Multigraded extension (`lem:gl-multigraded-extension`)

A function `N a f` (`= N(f T^a)`) on the homogeneous elements of `S`, vanishing at `0`, equal to
`1` on `k^×`, multiplicative and ultrametric on homogeneous elements, with `max_j N(z^{(c)}_j) = 1`
(`MultiModel.IsMultigradedNorm`), extends to the point `|p| = max_a N(p_a T^a)` of `𝒳^an`
(`MultiModel.ofMultigradedNorm`). Multiplicativity is the multigraded Gauss lemma for the
lexicographic order on `ℕ^r` (`MonomialOrder.lex`), as in the blueprint: the lexicographically
largest dominant degrees `α₀, β₀` of `p, q` give the unique dominant term of `(pq)_{α₀ + β₀}`.
Every point is the extension of its own values (`MultiModel.ofMultigradedNorm_homNorm`), and points
agreeing on homogeneous elements agree (`MultiModel.ext_of_ofPiece`).

## Model conventions

* `S ⊆ K[T]` rather than a quotient `R / I`: normalizations, finite covers, Veronese re-embeddings
  and base change stay inside one ambient ring with explicit degrees. Homogeneous
  elements are monomials `f T^a`, so the sections `R_a` of `def:gl-sections` are subsets of `K`
  described through `MultiModel.piece` and `MultiModel.zCoeff`.
* Points form a `Set (Berk k S)`, like `ProjSubvariety.an`; for `r = 1` (resp. `r = 2`) this is the
  analogue of `ProjBerk` (resp. `BiProjBerk`), whose gradedness conditions are of the same shape.
* `k` is an arbitrary field here (the blueprint's `k` is algebraically closed; nothing in this file
  needs it). The finite generation of `K / k` required in `def:gl-model` is a consequence of the
  other axioms (`MultiModel.fg_top_intermediateField`, in `ModelCharts`), so it is not a field.
* Bridges (`rmk:gl-bridges`): a quotient model `MultiModel.quotModel`
  (`EnvelopeProperty.Global.ModelQuotient`) comes with the presentation
  `MultiModel.quotModelEquiv: R / I ≃ₐ[k] S`, `x̄^{(c)}_j ↦ z^{(c)}_j`, under which the grading of
  `S` by `T`-degree is the multigrading of `R / I`; for `r = 1` (`ProjSubvariety`) and `r = 2`
  (`BiProjBerk`, the blowup model) only a reindexing of the variables
  (`Σ c, Fin (M c + 1)` versus `Fin (M + 1)`, `Fin (M + 1) ⊕ Fin (M' + 1)`) is needed.
* The normalization and the normalization in a finite extension are in
  `EnvelopeProperty.Global.ModelNormalization`.
-/

open scoped NNReal ENNReal Topology

open Topology MvPolynomial

noncomputable section

namespace EnvelopeProperty

universe u

/-! ### A valuative lemma on integral equations -/

/-- If `x` is a root of a monic polynomial whose coefficients have absolute value `≤ 1`, then
`|x| ≤ 1` (the argument of `Valuation.Integers.mem_of_integral`, which needs only the bound on the
coefficients). -/
theorem Valuation.le_one_of_monic_eval_eq_zero {A : Type*} [CommRing A] (v : Valuation A ℝ≥0)
    {f : Polynomial A} (hf : f.Monic) (hc : ∀ i, v (f.coeff i) ≤ 1) {x : A}
    (hx : f.eval x = 0) : v x ≤ 1 := by
  by_contra hvx'
  have hvx : 1 < v x := not_le.1 hvx'
  rw [hf.as_sum, Polynomial.eval_add, Polynomial.eval_pow, Polynomial.eval_X,
    Polynomial.eval_finsetSum, add_eq_zero_iff_eq_neg] at hx
  have h := congrArg v hx
  refine ne_of_gt ?_ h
  rw [v.map_neg, v.map_pow]
  refine v.map_sum_lt (pow_ne_zero _ (zero_lt_one.trans hvx).ne') fun i hi => ?_
  rw [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X, v.map_mul,
    v.map_pow]
  calc v (f.coeff i) * v x ^ i ≤ 1 * v x ^ i := by gcongr; exact hc i
    _ < v x ^ f.natDegree := by
      rw [one_mul]
      exact pow_lt_pow_right₀ hvx (Finset.mem_range.1 hi)

/-! ### Fraction fields from generating sets -/

/-- If every element of the field `L` lies in the subfield generated by the image of the domain
`A`, then `L` is a fraction field of `A`: by `Subfield.mem_closure_iff`, the subfield generated by a
subring consists of the quotients of its elements. -/
theorem isFractionRing_of_forall_mem_closure {A L : Type*} [CommRing A] [Field L] [Algebra A L]
    (hinj : Function.Injective (algebraMap A L))
    (h : ∀ z : L, z ∈ Subfield.closure (Set.range (algebraMap A L))) : IsFractionRing A L := by
  have : FaithfulSMul A L := (faithfulSMul_iff_algebraMap_injective A L).2 hinj
  refine IsFractionRing.of_field A L fun z => ?_
  obtain ⟨y, hy, w, hw, rfl⟩ := Subfield.mem_closure_iff.1 (h z)
  rw [← RingHom.coe_range, Subring.closure_eq] at hy hw
  obtain ⟨a, rfl⟩ := hy
  obtain ⟨b, rfl⟩ := hw
  exact ⟨a, b, rfl⟩

/-! ### The model -/

/-- An **integral multiprojective model** of rank `r` over `k` (`def:gl-model`): a finitely
generated graded `k`-subalgebra `S ⊆ K[T_1, …, T_r]` with coordinates
`z^{(c)}_j = f^{(c)}_j T^{e_c} ∈ S` (`coord c j = f^{(c)}_j`, `0 ≤ j ≤ M c`) satisfying (M1)–(M3).
It models a projective variety `X ⊆ ℙ^{M_1} × ⋯ × ℙ^{M_r}` with function field `K` and
multihomogeneous coordinate ring `S`. -/
structure MultiModel (k : Type u) [Field k] (K : Type u) [Field K] [Algebra k K] (r : ℕ) where
  /-- The multihomogeneous coordinate ring `S ⊆ K[T_1, …, T_r]`. -/
  S : Subalgebra k (MvPolynomial (Fin r) K)
  /-- `S` is graded: it contains the homogeneous components `p_a T^a` of its elements. -/
  isGraded : ∀ p ∈ S, ∀ a, monomial a (p.coeff a) ∈ S
  /-- `S` is a finitely generated `k`-algebra. -/
  fg : S.FG
  /-- The coordinates in degree `e_c` are `z^{(c)}_0, …, z^{(c)}_{M c}`. -/
  M : Fin r → ℕ
  /-- The coefficient `f^{(c)}_j ∈ K` of the coordinate `z^{(c)}_j = f^{(c)}_j T_c`. -/
  coord : (c : Fin r) → Fin (M c + 1) → K
  /-- The coordinates lie in `S`. -/
  coord_mem : ∀ c j, monomial (Finsupp.single c 1) (coord c j) ∈ S
  /-- (M1): for every `c` some coordinate `f^{(c)}_j` is nonzero. -/
  exists_coord_ne_zero : ∀ c, ∃ j, coord c j ≠ 0
  /-- (M2): `S` is integral over the subalgebra `k[z]` generated by the coordinates. -/
  isIntegral : ∀ p ∈ S, IsIntegral (Algebra.adjoin k (Set.range
    fun i : (Σ c, Fin (M c + 1)) => monomial (Finsupp.single i.1 1) (coord i.1 i.2))) p
  /-- (M3): `K` is generated as a field by the quotients `f / g`, `f, g ∈ S_a`, `g ≠ 0`. -/
  generates : IntermediateField.adjoin k {x : K | ∃ (a : Fin r →₀ ℕ) (f g : K),
    monomial a f ∈ S ∧ monomial a g ∈ S ∧ g ≠ 0 ∧ x = f / g} = ⊤

namespace MultiModel

variable {k : Type u} [Field k] {K : Type u} [Field K] [Algebra k K] {r : ℕ}
  (X : MultiModel k K r)

/-! ### Homogeneous pieces -/

/-- The homogeneous piece `S_a = {f ∈ K | f T^a ∈ S}`, a `k`-submodule of `K`. -/
def piece (a : Fin r →₀ ℕ) : Submodule k K where
  carrier := {f | monomial a f ∈ X.S}
  add_mem' {f g} hf hg := by
    simp only [Set.mem_ofPred_eq, map_add] at hf hg ⊢
    exact X.S.add_mem hf hg
  zero_mem' := by simp
  smul_mem' c f hf := by
    simp only [Set.mem_ofPred_eq] at hf ⊢
    rw [← smul_monomial]
    exact X.S.smul_mem hf c

variable {X}

theorem mem_piece {a : Fin r →₀ ℕ} {f : K} : f ∈ X.piece a ↔ monomial a f ∈ X.S := Iff.rfl

variable (X)

theorem coeff_mem_piece {p : MvPolynomial (Fin r) K} (hp : p ∈ X.S) (a : Fin r →₀ ℕ) :
    p.coeff a ∈ X.piece a :=
  X.isGraded p hp a

variable {X}

theorem mul_mem_piece {a b : Fin r →₀ ℕ} {f g : K} (hf : f ∈ X.piece a) (hg : g ∈ X.piece b) :
    f * g ∈ X.piece (a + b) := by
  rw [mem_piece, ← monomial_mul]
  exact X.S.mul_mem hf hg

variable (X)

theorem algebraMap_mem_piece_zero (c : k) : algebraMap k K c ∈ X.piece 0 := by
  rw [mem_piece, ← C_apply, ← MvPolynomial.algebraMap_apply]
  exact X.S.algebraMap_mem c

theorem one_mem_piece_zero : (1 : K) ∈ X.piece 0 := by
  simpa using X.algebraMap_mem_piece_zero 1

variable {X}

theorem pow_mem_piece {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) (n : ℕ) :
    f ^ n ∈ X.piece (n • a) := by
  rw [mem_piece, ← monomial_pow]
  exact X.S.pow_mem hf n

theorem prod_mem_piece {ι : Type*} (s : Finset ι) {a : ι → Fin r →₀ ℕ} {f : ι → K}
    (hf : ∀ i ∈ s, f i ∈ X.piece (a i)) : ∏ i ∈ s, f i ∈ X.piece (∑ i ∈ s, a i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using X.one_mem_piece_zero
  | insert j s hj ih =>
    rw [Finset.prod_insert hj, Finset.sum_insert hj]
    exact mul_mem_piece (hf j (Finset.mem_insert_self j s))
      (ih fun i hi => hf i (Finset.mem_insert_of_mem hi))

variable (X)

/-- The coordinate `f^{(c)}_j` lies in `S_{e_c}`. -/
theorem coord_mem_piece (c : Fin r) (j : Fin (X.M c + 1)) :
    X.coord c j ∈ X.piece (Finsupp.single c 1) :=
  X.coord_mem c j

/-- The homogeneous element `f T^a ∈ S` for `f ∈ S_a`. -/
def ofPiece {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) : X.S :=
  ⟨monomial a f, hf⟩

@[simp]
theorem coe_ofPiece {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) :
    (X.ofPiece hf : MvPolynomial (Fin r) K) = monomial a f :=
  rfl

theorem ofPiece_mul {a b : Fin r →₀ ℕ} {f g : K} (hf : f ∈ X.piece a) (hg : g ∈ X.piece b) :
    X.ofPiece (mul_mem_piece hf hg) = X.ofPiece hf * X.ofPiece hg :=
  Subtype.ext (monomial_mul).symm

theorem ofPiece_add {a : Fin r →₀ ℕ} {f g : K} (hf : f ∈ X.piece a) (hg : g ∈ X.piece a) :
    X.ofPiece (Submodule.add_mem _ hf hg) = X.ofPiece hf + X.ofPiece hg :=
  Subtype.ext (map_add _ _ _)

theorem ofPiece_zero (a : Fin r →₀ ℕ) : X.ofPiece (Submodule.zero_mem (X.piece a)) = 0 :=
  Subtype.ext (by simp)

theorem ofPiece_algebraMap (c : k) :
    X.ofPiece (X.algebraMap_mem_piece_zero c) = algebraMap k X.S c :=
  Subtype.ext (by
    rw [coe_ofPiece, Subalgebra.coe_algebraMap, MvPolynomial.algebraMap_apply, C_apply])

theorem ofPiece_one : X.ofPiece X.one_mem_piece_zero = 1 :=
  Subtype.ext (by simp [← C_apply])

theorem ofPiece_pow {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) (n : ℕ) :
    X.ofPiece (pow_mem_piece hf n) = X.ofPiece hf ^ n :=
  Subtype.ext (by simp [monomial_pow])

theorem ofPiece_congr {a b : Fin r →₀ ℕ} {f g : K} (hf : f ∈ X.piece a) (hg : g ∈ X.piece b)
    (hab : a = b) (hfg : f = g) : X.ofPiece hf = X.ofPiece hg := by
  subst hab hfg; rfl

/-- The homogeneous component `p_a T^a ∈ S` of `p ∈ S`. -/
def homComp (a : Fin r →₀ ℕ) (p : X.S) : X.S :=
  X.ofPiece (X.coeff_mem_piece p.2 a)

@[simp]
theorem coe_homComp (a : Fin r →₀ ℕ) (p : X.S) :
    (X.homComp a p : MvPolynomial (Fin r) K) = monomial a (p.1.coeff a) :=
  rfl

theorem homComp_eq_zero_of_notMem {a : Fin r →₀ ℕ} {p : X.S} (ha : a ∉ p.1.support) :
    X.homComp a p = 0 :=
  Subtype.ext (by simp [notMem_support_iff.1 ha])

/-- An element of `S` is the sum of its homogeneous components. -/
theorem sum_homComp (p : X.S) : ∑ a ∈ p.1.support, X.homComp a p = p := by
  apply Subtype.ext
  push_cast
  exact p.1.as_sum.symm

theorem homComp_ofPiece {a b : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) :
    X.homComp b (X.ofPiece hf) = if a = b then X.ofPiece hf else 0 := by
  apply Subtype.ext
  split_ifs with h
  · subst h; simp
  · simp [coeff_monomial, h]

theorem support_ofPiece_subset {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) :
    (X.ofPiece hf).1.support ⊆ {a} :=
  support_monomial_subset

/-! ### Coordinates and monomials in the coordinates -/

/-- The index type `{(c, j) : 0 ≤ j ≤ M c}` of the coordinates. -/
abbrev CoordIndex : Type := Σ c : Fin r, Fin (X.M c + 1)

/-- The coordinate `z^{(c)}_j = f^{(c)}_j T_c ∈ K[T]`. -/
def coordMono (i : X.CoordIndex) : MvPolynomial (Fin r) K :=
  monomial (Finsupp.single i.1 1) (X.coord i.1 i.2)

/-- The coordinate `z^{(c)}_j` as an element of `S`. -/
def coordElem (i : X.CoordIndex) : X.S :=
  ⟨X.coordMono i, X.coord_mem i.1 i.2⟩

@[simp]
theorem coe_coordElem (i : X.CoordIndex) :
    (X.coordElem i : MvPolynomial (Fin r) K) = monomial (Finsupp.single i.1 1) (X.coord i.1 i.2) :=
  rfl

theorem coordElem_eq_ofPiece (i : X.CoordIndex) :
    X.coordElem i = X.ofPiece (X.coord_mem_piece i.1 i.2) :=
  rfl

/-- The subalgebra `k[z] ⊆ K[T]` generated by the coordinates. -/
def coordAlg : Subalgebra k (MvPolynomial (Fin r) K) :=
  Algebra.adjoin k (Set.range X.coordMono)

theorem coordAlg_le : X.coordAlg ≤ X.S :=
  Algebra.adjoin_le (Set.range_subset_iff.2 fun i => X.coord_mem i.1 i.2)

/-- (M2): every element of `S` is integral over `k[z]`. -/
theorem isIntegral_coordAlg {p : MvPolynomial (Fin r) K} (hp : p ∈ X.S) :
    IsIntegral X.coordAlg p :=
  X.isIntegral p hp

/-- The degree `(∑_j β^{(c)}_j)_c ∈ ℕ^r` of the monomial `z^β`. -/
def monDeg (β : X.CoordIndex →₀ ℕ) : Fin r →₀ ℕ :=
  Finsupp.mapDomain Sigma.fst β

/-- The coefficient `z̃^β = ∏ (f^{(c)}_j)^{β^{(c)}_j} ∈ K` of `z^β = z̃^β T^{deg β}`. -/
def zCoeff (β : X.CoordIndex →₀ ℕ) : K :=
  β.prod fun i n => X.coord i.1 i.2 ^ n

theorem monDeg_add (β γ : X.CoordIndex →₀ ℕ) : X.monDeg (β + γ) = X.monDeg β + X.monDeg γ :=
  Finsupp.mapDomain_add

theorem zCoeff_add (β γ : X.CoordIndex →₀ ℕ) : X.zCoeff (β + γ) = X.zCoeff β * X.zCoeff γ :=
  Finsupp.prod_add_index' (fun _ => pow_zero _) fun _ _ _ => pow_add _ _ _

@[simp]
theorem monDeg_single (i : X.CoordIndex) (n : ℕ) :
    X.monDeg (Finsupp.single i n) = Finsupp.single i.1 n :=
  Finsupp.mapDomain_single

@[simp]
theorem zCoeff_single (i : X.CoordIndex) (n : ℕ) :
    X.zCoeff (Finsupp.single i n) = X.coord i.1 i.2 ^ n :=
  Finsupp.prod_single_index (pow_zero _)

@[simp]
theorem monDeg_zero : X.monDeg 0 = 0 :=
  Finsupp.mapDomain_zero

@[simp]
theorem zCoeff_zero : X.zCoeff 0 = 1 :=
  Finsupp.prod_zero_index

/-- `z^β = z̃^β T^{deg β}` is the product `∏ (z^{(c)}_j)^{β^{(c)}_j}` of coordinates. -/
theorem monomial_monDeg_zCoeff (β : X.CoordIndex →₀ ℕ) :
    monomial (X.monDeg β) (X.zCoeff β) = β.prod fun i n => X.coordMono i ^ n := by
  induction β using Finsupp.induction with
  | zero => simp [← C_apply]
  | single_add i n β hi hn ih =>
    rw [X.monDeg_add, X.zCoeff_add, ← monomial_mul, ih, Finsupp.prod_add_index'
      (fun _ => pow_zero _) fun _ _ _ => pow_add _ _ _,
      Finsupp.prod_single_index (h := fun i n => X.coordMono i ^ n) (pow_zero _),
      monDeg_single, zCoeff_single, coordMono, monomial_pow, Finsupp.smul_single, smul_eq_mul,
      mul_one]

/-- `z̃^β ∈ S_{deg β}`. -/
theorem zCoeff_mem_piece (β : X.CoordIndex →₀ ℕ) : X.zCoeff β ∈ X.piece (X.monDeg β) := by
  rw [mem_piece, monomial_monDeg_zCoeff]
  exact Subalgebra.prod_mem _ fun i _ => Subalgebra.pow_mem _ (X.coord_mem i.1 i.2) _

/-- The monomial `z^β ∈ S` in the coordinates. -/
def zMon (β : X.CoordIndex →₀ ℕ) : X.S :=
  X.ofPiece (X.zCoeff_mem_piece β)

theorem zMon_eq_prod (β : X.CoordIndex →₀ ℕ) :
    X.zMon β = β.prod fun i n => X.coordElem i ^ n := by
  apply Subtype.ext
  rw [zMon, coe_ofPiece, monomial_monDeg_zCoeff, Finsupp.prod, Finsupp.prod]
  push_cast
  rfl

/-- The finite set `Mon(b)` of multi-indices `β` with `∑_j β^{(c)}_j = b_c` for all `c`. -/
def monSet (b : Fin r →₀ ℕ) : Finset (X.CoordIndex →₀ ℕ) :=
  (Finset.univ.finsuppAntidiag (b.sum fun _ n => n)).filter fun β => X.monDeg β = b

theorem mem_monSet {b : Fin r →₀ ℕ} {β : X.CoordIndex →₀ ℕ} :
    β ∈ X.monSet b ↔ X.monDeg β = b := by
  rw [monSet, Finset.mem_filter, Finset.mem_finsuppAntidiag]
  refine ⟨fun h => h.2, fun h => ⟨⟨?_, Finset.subset_univ _⟩, h⟩⟩
  rw [← h, monDeg, Finsupp.sum_mapDomain_index (fun _ => rfl) fun _ _ _ => rfl, Finsupp.sum]
  exact (Finset.sum_subset (Finset.subset_univ _) fun i _ hi =>
    Finsupp.notMem_support_iff.1 hi).symm

/-! ### Fraction fields -/

/-- A subfield of `K` containing `k` and the quotients `f / g` (`f, g ∈ S_a`, `g ≠ 0`) is all of
`K`, by (M3). -/
theorem mem_of_forall_div_mem (E : Subfield K) (hk : ∀ c : k, algebraMap k K c ∈ E)
    (h : ∀ (a : Fin r →₀ ℕ) (f g : K), f ∈ X.piece a → g ∈ X.piece a → g ≠ 0 → f / g ∈ E)
    (x : K) : x ∈ E := by
  have hle : IntermediateField.adjoin k {x : K | ∃ (a : Fin r →₀ ℕ) (f g : K),
      monomial a f ∈ X.S ∧ monomial a g ∈ X.S ∧ g ≠ 0 ∧ x = f / g} ≤ E.toIntermediateField hk := by
    rw [IntermediateField.adjoin_le_iff]
    rintro _ ⟨a, f, g, hf, hg, hg0, rfl⟩
    exact h a f g hf hg hg0
  rw [X.generates] at hle
  exact hle (IntermediateField.mem_top (x := x))

/-- The fraction field of `S` is `K(T_1, …, T_r) = Frac K[T]`: by (M3) the subfield generated by
`S` contains `K` (`f / g = (f T^a) / (g T^a)`) and the `T_c = z^{(c)}_j / f^{(c)}_j`
(`f^{(c)}_j ≠ 0` by (M1)). -/
theorem isFractionRing_S : IsFractionRing X.S (FractionRing (MvPolynomial (Fin r) K)) := by
  set L := FractionRing (MvPolynomial (Fin r) K)
  set ι : MvPolynomial (Fin r) K →+* L := algebraMap (MvPolynomial (Fin r) K) L
  have hι : Function.Injective ι := IsFractionRing.injective _ _
  set F := Subfield.closure (Set.range (algebraMap X.S L))
  have hS : ∀ p : MvPolynomial (Fin r) K, p ∈ X.S → ι p ∈ F := fun p hp =>
    Subfield.subset_closure ⟨⟨p, hp⟩, rfl⟩
  have hmon : ∀ (a : Fin r →₀ ℕ) (f : K), ι (monomial a f) = ι (C f) * ι (monomial a 1) := by
    intro a f
    rw [← map_mul, C_mul_monomial, mul_one]
  have hmon0 : ∀ a : Fin r →₀ ℕ, ι (monomial a (1 : K)) ≠ 0 := fun a =>
    (map_ne_zero_iff _ hι).2 (by simp)
  -- The constants `K` lie in `F`.
  have hK : ∀ f : K, ι (C f) ∈ F := by
    intro f
    change f ∈ F.comap (ι.comp C)
    refine X.mem_of_forall_div_mem _ (fun c => ?_) (fun a f g hf hg hg0 => ?_) f
    · change ι (C (algebraMap k K c)) ∈ F
      rw [← MvPolynomial.algebraMap_apply]
      exact hS _ (X.S.algebraMap_mem c)
    · change ι (C (f / g)) ∈ F
      have e : ι (C (f / g)) = ι (monomial a f) / ι (monomial a g) := by
        rw [hmon a f, hmon a g, mul_div_mul_right _ _ (hmon0 a)]
        exact map_div₀ (ι.comp C) f g
      rw [e]
      exact div_mem (hS _ hf) (hS _ hg)
  -- The variables `T_c` lie in `F`.
  have hT : ∀ c : Fin r, ι (MvPolynomial.X c) ∈ F := by
    intro c
    obtain ⟨j, hj⟩ := X.exists_coord_ne_zero c
    have e : ι (MvPolynomial.X c) = ι (monomial (Finsupp.single c 1) (X.coord c j)) /
        ι (C (X.coord c j)) := by
      rw [eq_div_iff ((map_ne_zero_iff _ hι).2 (C_ne_zero.2 hj)), ← map_mul, mul_comm,
        C_mul_X_eq_monomial]
    rw [e]
    exact div_mem (hS _ (X.coord_mem c j)) (hK _)
  have hP : ∀ P : MvPolynomial (Fin r) K, ι P ∈ F := by
    intro P
    induction P using MvPolynomial.induction_on with
    | C a => exact hK a
    | add p q hp hq => rw [map_add]; exact add_mem hp hq
    | mul_X p c hp => rw [map_mul]; exact mul_mem hp (hT c)
  refine isFractionRing_of_forall_mem_closure (fun x y hxy => ?_) fun z => ?_
  · exact Subtype.ext (hι hxy)
  · obtain ⟨P, Q, -, rfl⟩ := IsFractionRing.div_surjective (MvPolynomial (Fin r) K) z
    exact div_mem (hP P) (hP Q)

/-! ### Normal models -/

/-- A model is **normal** if `S` is integrally closed (`def:gl-model`). -/
def IsNormal : Prop :=
  IsIntegrallyClosed X.S

/-- A model is normal iff `S` is integrally closed in `K[T]` (since `Frac S = Frac K[T]` and `K[T]`
is integrally closed). -/
theorem isNormal_iff : X.IsNormal ↔ IsIntegrallyClosedIn X.S (MvPolynomial (Fin r) K) := by
  set L := FractionRing (MvPolynomial (Fin r) K)
  have := X.isFractionRing_S
  have hι : Function.Injective (algebraMap (MvPolynomial (Fin r) K) L) :=
    IsFractionRing.injective _ _
  let ιS : MvPolynomial (Fin r) K →ₐ[X.S] L := IsScalarTower.toAlgHom X.S _ L
  have hιS : Function.Injective ιS := hι
  rw [IsNormal, isIntegrallyClosed_iff L, isIntegrallyClosedIn_iff]
  constructor
  · intro h
    refine ⟨fun x y hxy => Subtype.ext hxy, fun {u} hu => ?_⟩
    obtain ⟨y, hy⟩ := h ((isIntegral_algHom_iff ιS hιS).2 hu)
    exact ⟨y, hι hy⟩
  · rintro ⟨-, h⟩ x hx
    obtain ⟨u, rfl⟩ := IsIntegrallyClosed.isIntegral_iff.1
      (hx.tower_top (A := MvPolynomial (Fin r) K))
    obtain ⟨y, hy⟩ := h ((isIntegral_algHom_iff ιS hιS).1 hx)
    exact ⟨y, by rw [← hy]; rfl⟩

/-! ### Points (`def:gl-points`) -/

/-- A point `v ∈ (Spec S)^an` is **multigraded** if `|p_a T^a|_v ≤ |p|_v` for all `p ∈ S` and all
degrees `a`; equivalently `|p|_v = max_a |p_a T^a|_v` (`IsMultigraded.val_eq_sup`). -/
def IsMultigraded (v : Berk k X.S) : Prop :=
  ∀ (p : X.S) (a : Fin r →₀ ℕ), v.val (X.homComp a p) ≤ v.val p

/-- A point `v` is **normalized** if `max_j |z^{(c)}_j|_v = 1` for every `c`. -/
def IsNormalized (v : Berk k X.S) : Prop :=
  ∀ c : Fin r, Finset.univ.sup (fun j : Fin (X.M c + 1) => v.val (X.coordElem ⟨c, j⟩)) = 1

/-- The analytification `𝒳^an` (`def:gl-points`): the multigraded normalized multiplicative
seminorms on `S`, trivial on `k`, with the subspace topology of `(Spec S)^an`. -/
def an : Set (Berk k X.S) :=
  {v | X.IsMultigraded v ∧ X.IsNormalized v}

variable {X}

theorem IsMultigraded.val_eq_sup {v : Berk k X.S} (hv : X.IsMultigraded v) (p : X.S) :
    v.val p = p.1.support.sup fun a => v.val (X.homComp a p) := by
  refine le_antisymm ?_ (Finset.sup_le fun a _ => hv p a)
  conv_lhs => rw [← X.sum_homComp p]
  exact v.val.map_sum_le fun a ha => Finset.le_sup (f := fun a => v.val (X.homComp a p)) ha

theorem isMultigraded_iff_val_eq_sup (v : Berk k X.S) :
    X.IsMultigraded v ↔
      ∀ p : X.S, v.val p = p.1.support.sup fun a => v.val (X.homComp a p) := by
  refine ⟨fun hv => hv.val_eq_sup, fun h p a => ?_⟩
  by_cases ha : a ∈ p.1.support
  · rw [h p]
    exact Finset.le_sup (f := fun a => v.val (X.homComp a p)) ha
  · rw [X.homComp_eq_zero_of_notMem ha, map_zero]
    exact zero_le

/-- Multigraded points agreeing on homogeneous elements are equal. -/
theorem ext_of_ofPiece {v w : Berk k X.S} (hv : X.IsMultigraded v) (hw : X.IsMultigraded w)
    (h : ∀ (a : Fin r →₀ ℕ) (f : K) (hf : f ∈ X.piece a),
      v.val (X.ofPiece hf) = w.val (X.ofPiece hf)) :
    v = w := by
  refine Berk.ext_val fun p => ?_
  rw [hv.val_eq_sup, hw.val_eq_sup]
  exact Finset.sup_congr rfl fun a _ => h a _ _

theorem mem_an {v : Berk k X.S} : v ∈ X.an ↔ X.IsMultigraded v ∧ X.IsNormalized v := Iff.rfl

theorem IsNormalized.val_coordElem_le_one {v : Berk k X.S} (hv : X.IsNormalized v)
    (i : X.CoordIndex) : v.val (X.coordElem i) ≤ 1 :=
  (Finset.le_sup (f := fun j : Fin (X.M i.1 + 1) => v.val (X.coordElem ⟨i.1, j⟩))
    (Finset.mem_univ i.2)).trans (hv i.1).le

theorem IsNormalized.exists_val_coordElem_eq_one {v : Berk k X.S} (hv : X.IsNormalized v)
    (c : Fin r) : ∃ j, v.val (X.coordElem ⟨c, j⟩) = 1 := by
  obtain ⟨j, -, hj⟩ := Finset.exists_mem_eq_sup Finset.univ Finset.univ_nonempty
    fun j : Fin (X.M c + 1) => v.val (X.coordElem ⟨c, j⟩)
  exact ⟨j, hj ▸ hv c⟩

/-- At a normalized point, every element of `k[z]` has absolute value `≤ 1`. -/
theorem IsNormalized.val_le_one_of_mem_coordAlg {v : Berk k X.S} (hv : X.IsNormalized v)
    (p : X.S) (hp : p.1 ∈ X.coordAlg) : v.val p ≤ 1 := by
  suffices h : ∀ (x : MvPolynomial (Fin r) K) (hx : x ∈ X.coordAlg),
      v.val ⟨x, X.coordAlg_le hx⟩ ≤ 1 from h p.1 hp
  intro x hx
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact hv.val_coordElem_le_one i
  | algebraMap c => exact Berk.abs_algebraMap_le_one v c
  | add x y hx hy ihx ihy =>
    have h : (⟨x + y, X.coordAlg_le (Subalgebra.add_mem _ hx hy)⟩ : X.S) =
        ⟨x, X.coordAlg_le hx⟩ + ⟨y, X.coordAlg_le hy⟩ := rfl
    rw [h]
    exact (v.val.map_add _ _).trans (max_le ihx ihy)
  | mul x y hx hy ihx ihy =>
    have h : (⟨x * y, X.coordAlg_le (Subalgebra.mul_mem _ hx hy)⟩ : X.S) =
        ⟨x, X.coordAlg_le hx⟩ * ⟨y, X.coordAlg_le hy⟩ := rfl
    rw [h, map_mul]
    exact mul_le_one' ihx ihy

/-- **`lem:gl-points-basic`(1).** At a normalized point every `p ∈ S` has `|p|_v ≤ 1`: `p` is a
root of a monic polynomial with coefficients in `k[z]` (M2), and the coefficients have absolute
value `≤ 1`. -/
theorem IsNormalized.val_le_one {v : Berk k X.S} (hv : X.IsNormalized v) (p : X.S) :
    v.val p ≤ 1 := by
  obtain ⟨f, hfm, hf⟩ := X.isIntegral_coordAlg p.2
  let g : X.coordAlg →+* X.S := (Subalgebra.inclusion X.coordAlg_le).toRingHom
  refine Valuation.le_one_of_monic_eval_eq_zero v.val (f := f.map g) (hfm.map g) (fun i => ?_) ?_
  · rw [Polynomial.coeff_map]
    exact hv.val_le_one_of_mem_coordAlg _ (f.coeff i).2
  · apply Subtype.val_injective
    rw [Polynomial.eval_map, ZeroMemClass.coe_zero]
    have hcomp : X.S.val.toRingHom.comp g = algebraMap X.coordAlg (MvPolynomial (Fin r) K) :=
      RingHom.ext fun _ => rfl
    have h := Polynomial.hom_eval₂ f g X.S.val.toRingHom p
    rw [hcomp] at h
    exact h.trans hf

theorem val_le_one {v : Berk k X.S} (hv : v ∈ X.an) (p : X.S) : v.val p ≤ 1 :=
  hv.2.val_le_one p

variable (X)

/-! ### Topology (`lem:gl-points-basic`(2)) -/

theorem isClosed_setOf_isMultigraded : IsClosed {v : Berk k X.S | X.IsMultigraded v} := by
  have e : {v : Berk k X.S | X.IsMultigraded v} =
      ⋂ p : X.S, ⋂ a : Fin r →₀ ℕ, {v | v.val (X.homComp a p) ≤ v.val p} := by
    ext v
    simp [IsMultigraded]
  rw [e]
  exact isClosed_iInter fun p => isClosed_iInter fun a =>
    isClosed_le (Berk.continuous_val_apply _) (Berk.continuous_val_apply _)

theorem isClosed_setOf_isNormalized : IsClosed {v : Berk k X.S | X.IsNormalized v} := by
  have e : {v : Berk k X.S | X.IsNormalized v} =
      ⋂ c : Fin r, {v | Finset.univ.sup (fun j : Fin (X.M c + 1) => v.val (X.coordElem ⟨c, j⟩))
        = 1} := by
    ext v
    simp [IsNormalized]
  rw [e]
  exact isClosed_iInter fun c => isClosed_eq
    (Continuous.finset_sup_apply fun _ _ => Berk.continuous_val_apply _) continuous_const

theorem isClosed_an : IsClosed X.an :=
  X.isClosed_setOf_isMultigraded.inter X.isClosed_setOf_isNormalized

/-- `𝒳^an` is compact: a closed subset of the polydisc `{|p| ≤ 1 for all p ∈ S}`. -/
theorem isCompact_an : IsCompact X.an :=
  Berk.isCompact_of_isClosed_of_forall_abs_le (S := Set.univ) (Algebra.adjoin_univ k X.S)
    X.isClosed_an 1
    fun _ hv p _ => val_le_one hv p

instance instCompactSpaceAn : CompactSpace X.an :=
  isCompact_iff_compactSpace.1 X.isCompact_an

instance instT2SpaceAn : T2Space X.an :=
  inferInstance

instance instFiniteTypeS : Algebra.FiniteType k X.S :=
  (Subalgebra.fg_iff_finiteType _).1 X.fg

/-- For countable `k`, `𝒳^an` is second countable. -/
instance instSecondCountableTopologyAn [Countable k] : SecondCountableTopology X.an :=
  inferInstance

theorem isEmbedding_coe_an : IsEmbedding ((↑) : X.an → Berk k X.S) :=
  IsEmbedding.subtypeVal

theorem isClosedEmbedding_coe_an : IsClosedEmbedding ((↑) : X.an → Berk k X.S) :=
  X.isClosed_an.isClosedEmbedding_subtypeVal

/-- A map into `𝒳^an` is continuous iff all the functions `|p|` are continuous along it. -/
theorem continuous_iff_an {Y : Type*} [TopologicalSpace Y] {g : Y → X.an} :
    Continuous g ↔ ∀ p : X.S, Continuous fun y => (g y).1.val p := by
  refine ⟨fun h p => (Berk.continuous_val_apply p).comp (continuous_subtype_val.comp h),
    fun h => ?_⟩
  exact X.isEmbedding_coe_an.continuous_iff.2 (Berk.continuous_iff.2 h)

/-! ### The trivial point -/

theorem isMultigraded_triv : X.IsMultigraded (Berk.triv : Berk k X.S) := by
  classical
  intro p a
  by_cases hp : p = 0
  · subst hp
    rw [show X.homComp a 0 = 0 from Subtype.ext (by simp)]
  · rw [Berk.triv_val_of_ne_zero hp]
    by_cases ha : X.homComp a p = 0
    · rw [ha, map_zero]
      exact zero_le
    · rw [Berk.triv_val_of_ne_zero ha]

theorem isNormalized_triv : X.IsNormalized (Berk.triv : Berk k X.S) := by
  classical
  intro c
  obtain ⟨j, hj⟩ := X.exists_coord_ne_zero c
  refine le_antisymm (Finset.sup_le fun i _ => ?_) ?_
  · by_cases hi : X.coordElem ⟨c, i⟩ = 0
    · rw [hi, map_zero]; exact zero_le
    · rw [Berk.triv_val_of_ne_zero hi]
  · have hne : X.coordElem ⟨c, j⟩ ≠ 0 := by
      intro h
      have h' := congrArg (fun p : X.S => (p : MvPolynomial (Fin r) K)) h
      simp only [coe_coordElem, ZeroMemClass.coe_zero, monomial_eq_zero] at h'
      exact hj h'
    refine le_trans ?_ (Finset.le_sup (f := fun i : Fin (X.M c + 1) =>
      (Berk.triv : Berk k X.S).val (X.coordElem ⟨c, i⟩)) (Finset.mem_univ j))
    rw [Berk.triv_val_of_ne_zero hne]

/-- The **trivial point** `⋆ ∈ 𝒳^an`: `|p|_⋆ = 1` for `p ≠ 0` (`def:gl-points`). -/
def triv : X.an :=
  ⟨Berk.triv, X.isMultigraded_triv, X.isNormalized_triv⟩

@[simp]
theorem coe_triv : (X.triv : Berk k X.S) = Berk.triv :=
  rfl

theorem triv_val_of_ne_zero {p : X.S} (hp : p ≠ 0) : (X.triv : Berk k X.S).val p = 1 :=
  Berk.triv_val_of_ne_zero hp

/-! ### Points with generic support -/

/-- A point has **generic support** if `|p|_v ≠ 0` for all `p ≠ 0` (`def:gl-points`). -/
def HasGenericSupport (v : Berk k X.S) : Prop :=
  ∀ p : X.S, p ≠ 0 → v.val p ≠ 0

/-- `𝒳^val`: the points of `𝒳^an` with generic support. -/
def valSet : Set (Berk k X.S) :=
  {v | v ∈ X.an ∧ X.HasGenericSupport v}

theorem hasGenericSupport_triv : X.HasGenericSupport (X.triv : Berk k X.S) := fun p hp => by
  rw [X.triv_val_of_ne_zero hp]
  exact one_ne_zero

theorem triv_mem_valSet : (X.triv : Berk k X.S) ∈ X.valSet :=
  ⟨X.triv.2, X.hasGenericSupport_triv⟩

/-! ### Monomials in the coordinates at points -/

variable {X}

theorem IsNormalized.val_zMon_le_one {v : Berk k X.S} (hv : X.IsNormalized v)
    (β : X.CoordIndex →₀ ℕ) : v.val (X.zMon β) ≤ 1 :=
  hv.val_le_one _

/-- At a normalized point some monomial `z^β`, `β ∈ Mon(b)`, has absolute value `1`. -/
theorem IsNormalized.exists_val_zMon_eq_one {v : Berk k X.S} (hv : X.IsNormalized v)
    (b : Fin r →₀ ℕ) : ∃ β ∈ X.monSet b, v.val (X.zMon β) = 1 := by
  choose j hj using hv.exists_val_coordElem_eq_one
  refine ⟨∑ c ∈ b.support, Finsupp.single ⟨c, j c⟩ (b c), ?_, ?_⟩
  · rw [mem_monSet, monDeg, Finsupp.mapDomain_finsetSum]
    simp only [Finsupp.mapDomain_single]
    exact Finsupp.sum_single b
  · rw [zMon_eq_prod, ← Finsupp.prod_finsetSum_index (fun _ => pow_zero _)
      fun _ _ _ => pow_add _ _ _, map_prod]
    refine Finset.prod_eq_one fun c _ => ?_
    rw [Finsupp.prod_single_index (h := fun i n => X.coordElem i ^ n) (pow_zero _), map_pow,
      hj c, one_pow]

/-- `max_{β ∈ Mon(b)} |z^β|_v = 1` at a normalized point. -/
theorem IsNormalized.sup_monSet_val_zMon {v : Berk k X.S} (hv : X.IsNormalized v)
    (b : Fin r →₀ ℕ) : (X.monSet b).sup (fun β => v.val (X.zMon β)) = 1 := by
  obtain ⟨β, hβ, h⟩ := hv.exists_val_zMon_eq_one b
  exact le_antisymm (Finset.sup_le fun γ _ => hv.val_zMon_le_one γ)
    (h ▸ Finset.le_sup (f := fun β => v.val (X.zMon β)) hβ)

/-! ### Multigraded extension (`lem:gl-multigraded-extension`) -/

variable (X) in
/-- The hypotheses of the **multigraded extension** lemma (`lem:gl-multigraded-extension`) on a
function `N a f = N(f T^a)` on the homogeneous elements `f T^a ∈ S` (only the values for
`f ∈ S_a` matter): `N` vanishes at `0`, is `1` on `k^×`, is multiplicative and ultrametric on
homogeneous elements, and `max_j N(z^{(c)}_j) = 1` for every `c`. -/
structure IsMultigradedNorm (N : (Fin r →₀ ℕ) → K → ℝ≥0) : Prop where
  map_zero : ∀ a, N a 0 = 0
  map_algebraMap : ∀ c : k, c ≠ 0 → N 0 (algebraMap k K c) = 1
  map_mul : ∀ {a b : Fin r →₀ ℕ} {f g : K}, f ∈ X.piece a → g ∈ X.piece b →
    N (a + b) (f * g) = N a f * N b g
  map_add_le : ∀ {a : Fin r →₀ ℕ} {f g : K}, f ∈ X.piece a → g ∈ X.piece a →
    N a (f + g) ≤ max (N a f) (N a g)
  sup_coord : ∀ c : Fin r,
    Finset.univ.sup (fun j : Fin (X.M c + 1) => N (Finsupp.single c 1) (X.coord c j)) = 1

variable (X) in
/-- The **multigraded extension** `|p| = max_a N(p_a T^a)` of a function on homogeneous elements. -/
def multigradedFun (N : (Fin r →₀ ℕ) → K → ℝ≥0) (p : X.S) : ℝ≥0 :=
  p.1.support.sup fun a => N a (p.1.coeff a)

namespace IsMultigradedNorm

variable {N : (Fin r →₀ ℕ) → K → ℝ≥0} (hN : X.IsMultigradedNorm N)
include hN

theorem map_one : N 0 1 = 1 := by
  simpa using hN.map_algebraMap 1 one_ne_zero

theorem map_neg {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) : N a (-f) = N a f := by
  have h := hN.map_mul (X.algebraMap_mem_piece_zero (-1)) hf
  rw [zero_add, hN.map_algebraMap _ (neg_ne_zero.2 one_ne_zero), one_mul, _root_.map_neg,
    _root_.map_one, neg_one_mul] at h
  exact h

theorem map_add_eq_of_lt {a : Fin r →₀ ℕ} {f g : K} (hf : f ∈ X.piece a) (hg : g ∈ X.piece a)
    (hlt : N a g < N a f) : N a (f + g) = N a f := by
  refine le_antisymm ((hN.map_add_le hf hg).trans (max_le le_rfl hlt.le)) ?_
  have h := hN.map_add_le (Submodule.add_mem _ hf hg) (Submodule.neg_mem _ hg)
  rw [add_neg_cancel_right, hN.map_neg hg] at h
  rcases le_max_iff.1 h with h | h
  · exact h
  · exact absurd h (not_le.2 hlt)

theorem map_sum_le {ι : Type*} (s : Finset ι) {a : Fin r →₀ ℕ} {H : ι → K}
    (hH : ∀ i ∈ s, H i ∈ X.piece a) : N a (∑ i ∈ s, H i) ≤ s.sup fun i => N a (H i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [hN.map_zero]
  | insert j s hj ih =>
    rw [Finset.sum_insert hj, Finset.sup_insert]
    have hs : ∑ i ∈ s, H i ∈ X.piece a :=
      Submodule.sum_mem _ fun i hi => hH i (Finset.mem_insert_of_mem hi)
    exact (hN.map_add_le (hH j (Finset.mem_insert_self j s)) hs).trans
      (max_le_max le_rfl (ih fun i hi => hH i (Finset.mem_insert_of_mem hi)))

/-- A sum of homogeneous elements of degree `a` with a strictly dominant term has the norm of that
term. -/
theorem map_sum_eq_of_lt {ι : Type*} [DecidableEq ι] (s : Finset ι) {a : Fin r →₀ ℕ}
    {H : ι → K} (hH : ∀ i ∈ s, H i ∈ X.piece a) {j : ι} (hj : j ∈ s)
    (hlt : ∀ i ∈ s, i ≠ j → N a (H i) < N a (H j)) : N a (∑ i ∈ s, H i) = N a (H j) := by
  rw [← Finset.add_sum_erase s H hj]
  rcases (s.erase j).eq_empty_or_nonempty with he | he
  · rw [he, Finset.sum_empty, add_zero]
  refine hN.map_add_eq_of_lt (hH j hj) (Submodule.sum_mem _ fun i hi =>
    hH i (Finset.mem_of_mem_erase hi)) ?_
  refine (hN.map_sum_le _ fun i hi => hH i (Finset.mem_of_mem_erase hi)).trans_lt ?_
  obtain ⟨i, hi⟩ := he
  have hpos : (⊥ : ℝ≥0) < N a (H j) :=
    zero_le.trans_lt (hlt i (Finset.mem_of_mem_erase hi) (Finset.ne_of_mem_erase hi))
  exact (Finset.sup_lt_iff hpos).2 fun i hi =>
    hlt i (Finset.mem_of_mem_erase hi) (Finset.ne_of_mem_erase hi)

theorem le_multigradedFun (p : X.S) (a : Fin r →₀ ℕ) :
    N a (p.1.coeff a) ≤ X.multigradedFun N p := by
  by_cases ha : a ∈ p.1.support
  · exact Finset.le_sup (f := fun a => N a (p.1.coeff a)) ha
  · rw [notMem_support_iff.1 ha, hN.map_zero]
    exact zero_le

theorem multigradedFun_le_iff (p : X.S) (t : ℝ≥0) :
    X.multigradedFun N p ≤ t ↔ ∀ a, N a (p.1.coeff a) ≤ t :=
  ⟨fun h a => (hN.le_multigradedFun p a).trans h, fun h => Finset.sup_le fun a _ => h a⟩

/-- On a homogeneous element `f T^a` the multigraded extension is `N(f T^a)`. -/
theorem multigradedFun_ofPiece {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) :
    X.multigradedFun N (X.ofPiece hf) = N a f := by
  refine le_antisymm ((hN.multigradedFun_le_iff _ _).2 fun b => ?_) ?_
  · rw [coe_ofPiece, coeff_monomial]
    split_ifs with h
    · rw [h]
    · rw [hN.map_zero]; exact zero_le
  · have h := hN.le_multigradedFun (X.ofPiece hf) a
    rwa [coe_ofPiece, coeff_monomial, if_pos rfl] at h

theorem multigradedFun_add_le (p q : X.S) :
    X.multigradedFun N (p + q) ≤ max (X.multigradedFun N p) (X.multigradedFun N q) := by
  refine (hN.multigradedFun_le_iff _ _).2 fun a => ?_
  rw [Subalgebra.coe_add, coeff_add]
  exact (hN.map_add_le (X.coeff_mem_piece p.2 a) (X.coeff_mem_piece q.2 a)).trans
    (max_le_max (hN.le_multigradedFun p a) (hN.le_multigradedFun q a))

theorem multigradedFun_mul_le (p q : X.S) :
    X.multigradedFun N (p * q) ≤ X.multigradedFun N p * X.multigradedFun N q := by
  refine (hN.multigradedFun_le_iff _ _).2 fun γ => ?_
  rw [Subalgebra.coe_mul, coeff_mul]
  refine (hN.map_sum_le _ fun x hx => ?_).trans (Finset.sup_le fun x hx => ?_)
  · rw [← Finset.HasAntidiagonal.mem_antidiagonal.1 hx]
    exact mul_mem_piece (X.coeff_mem_piece p.2 _) (X.coeff_mem_piece q.2 _)
  · rw [← Finset.HasAntidiagonal.mem_antidiagonal.1 hx,
      hN.map_mul (X.coeff_mem_piece p.2 _) (X.coeff_mem_piece q.2 _)]
    exact mul_le_mul' (hN.le_multigradedFun p _) (hN.le_multigradedFun q _)

/-- The lexicographically largest dominant degree: some `α₀` attains the maximum defining the
multigraded extension, and no lexicographically larger degree does. -/
theorem exists_dominant (p : X.S) (hp : X.multigradedFun N p ≠ 0) :
    ∃ α₀ : Fin r →₀ ℕ, N α₀ (p.1.coeff α₀) = X.multigradedFun N p ∧
      ∀ α : Fin r →₀ ℕ, (MonomialOrder.lex (σ := Fin r)).toSyn α₀ <
        (MonomialOrder.lex (σ := Fin r)).toSyn α → N α (p.1.coeff α) < X.multigradedFun N p := by
  classical
  set m := MonomialOrder.lex (σ := Fin r)
  have hsupp : p.1.support.Nonempty := by
    rcases p.1.support.eq_empty_or_nonempty with he | he
    · exact absurd (by rw [multigradedFun, he, Finset.sup_empty]; rfl) hp
    · exact he
  obtain ⟨a, ha, hamax⟩ := Finset.exists_mem_eq_sup _ hsupp fun a => N a (p.1.coeff a)
  set D := p.1.support.filter fun a => N a (p.1.coeff a) = X.multigradedFun N p
  have hD : D.Nonempty := ⟨a, Finset.mem_filter.2 ⟨ha, hamax.symm⟩⟩
  obtain ⟨α₀, hα₀, hmax⟩ := Finset.exists_max_image D m.toSyn hD
  refine ⟨α₀, (Finset.mem_filter.1 hα₀).2, fun α hα => ?_⟩
  refine lt_of_le_of_ne (hN.le_multigradedFun p α) fun heq => ?_
  have hαD : α ∈ D := by
    refine Finset.mem_filter.2 ⟨?_, heq⟩
    by_contra hα'
    rw [notMem_support_iff.1 hα', hN.map_zero] at heq
    exact hp heq.symm
  exact absurd (hmax α hαD) (not_le.2 hα)

/-- Multiplicativity of the multigraded extension (the multigraded Gauss lemma): for the
lexicographically largest dominant degrees `α₀`, `β₀` of `p`, `q`, the term `p_{α₀} q_{β₀}` is the
unique dominant term of `(pq)_{α₀ + β₀}`. -/
theorem mul_le_multigradedFun_mul (p q : X.S) :
    X.multigradedFun N p * X.multigradedFun N q ≤ X.multigradedFun N (p * q) := by
  classical
  set m := MonomialOrder.lex (σ := Fin r)
  by_cases hp : X.multigradedFun N p = 0
  · rw [hp, zero_mul]; exact zero_le
  by_cases hq : X.multigradedFun N q = 0
  · rw [hq, mul_zero]; exact zero_le
  have hppos : 0 < X.multigradedFun N p := pos_iff_ne_zero.2 hp
  have hqpos : 0 < X.multigradedFun N q := pos_iff_ne_zero.2 hq
  obtain ⟨α₀, hα₀, hα₀'⟩ := hN.exists_dominant p hp
  obtain ⟨β₀, hβ₀, hβ₀'⟩ := hN.exists_dominant q hq
  have key : N (α₀ + β₀) (p.1.coeff α₀ * q.1.coeff β₀) =
      X.multigradedFun N p * X.multigradedFun N q := by
    rw [hN.map_mul (X.coeff_mem_piece p.2 _) (X.coeff_mem_piece q.2 _), hα₀, hβ₀]
  have hj : ((α₀, β₀) : (Fin r →₀ ℕ) × (Fin r →₀ ℕ)) ∈
      Finset.HasAntidiagonal.antidiagonal (α₀ + β₀) :=
    Finset.HasAntidiagonal.mem_antidiagonal.2 rfl
  refine le_trans ?_ (hN.le_multigradedFun (p * q) (α₀ + β₀))
  rw [Subalgebra.coe_mul, coeff_mul, hN.map_sum_eq_of_lt _ (fun x hx => ?_) hj
    (fun x hx hne => ?_)]
  · exact key.ge
  · rw [← Finset.HasAntidiagonal.mem_antidiagonal.1 hx]
    exact mul_mem_piece (X.coeff_mem_piece p.2 _) (X.coeff_mem_piece q.2 _)
  · have hsum := Finset.HasAntidiagonal.mem_antidiagonal.1 hx
    have h : N (α₀ + β₀) (p.1.coeff x.1 * q.1.coeff x.2) =
        N x.1 (p.1.coeff x.1) * N x.2 (q.1.coeff x.2) := by
      rw [← hsum]
      exact hN.map_mul (X.coeff_mem_piece p.2 _) (X.coeff_mem_piece q.2 _)
    have hcases : m.toSyn α₀ < m.toSyn x.1 ∨ m.toSyn β₀ < m.toSyn x.2 := by
      by_contra hcon
      rw [not_or, not_lt, not_lt] at hcon
      apply hne
      rcases hcon.1.lt_or_eq with h1 | h1
      · have h2 : m.toSyn (x.1 + x.2) < m.toSyn (α₀ + β₀) := by
          rw [map_add, map_add]
          exact add_lt_add_of_lt_of_le h1 hcon.2
        rw [hsum] at h2
        exact absurd h2 (lt_irrefl _)
      · have h1' : x.1 = α₀ := m.toSyn.injective h1
        have h2' : x.2 = β₀ := by
          rw [h1'] at hsum
          exact add_left_cancel hsum
        exact Prod.ext h1' h2'
    refine (h.trans_lt ?_).trans_eq key.symm
    rcases hcases with h1 | h1
    · calc N x.1 (p.1.coeff x.1) * N x.2 (q.1.coeff x.2)
          ≤ N x.1 (p.1.coeff x.1) * X.multigradedFun N q := by
            gcongr; exact hN.le_multigradedFun q _
        _ < X.multigradedFun N p * X.multigradedFun N q := by
            gcongr; exact hα₀' _ h1
    · calc N x.1 (p.1.coeff x.1) * N x.2 (q.1.coeff x.2)
          ≤ X.multigradedFun N p * N x.2 (q.1.coeff x.2) := by
            gcongr; exact hN.le_multigradedFun p _
        _ < X.multigradedFun N p * X.multigradedFun N q := by
            gcongr; exact hβ₀' _ h1

theorem multigradedFun_mul (p q : X.S) :
    X.multigradedFun N (p * q) = X.multigradedFun N p * X.multigradedFun N q :=
  le_antisymm (hN.multigradedFun_mul_le p q) (hN.mul_le_multigradedFun_mul p q)

/-- The multigraded extension as a valuation on `S`. -/
def valuation : Valuation X.S ℝ≥0 where
  toFun := X.multigradedFun N
  map_zero' := by simp [multigradedFun]
  map_one' := by
    rw [← X.ofPiece_one, hN.multigradedFun_ofPiece, hN.map_one]
  map_mul' := hN.multigradedFun_mul
  map_add_le_max' := hN.multigradedFun_add_le

theorem valuation_apply (p : X.S) : hN.valuation p = X.multigradedFun N p :=
  rfl

end IsMultigradedNorm

/-- **Multigraded extension** (`lem:gl-multigraded-extension`): a function `N` on homogeneous
elements satisfying `IsMultigradedNorm` defines the point `|p| = max_a N(p_a T^a)` of `𝒳^an`. -/
def ofMultigradedNorm {N : (Fin r →₀ ℕ) → K → ℝ≥0} (hN : X.IsMultigradedNorm N) : X.an :=
  ⟨⟨hN.valuation, fun c hc => by
      rw [hN.valuation_apply, ← X.ofPiece_algebraMap, hN.multigradedFun_ofPiece,
        hN.map_algebraMap c hc]⟩,
    fun p a => by
      change X.multigradedFun N (X.homComp a p) ≤ X.multigradedFun N p
      rw [homComp, hN.multigradedFun_ofPiece]
      exact hN.le_multigradedFun p a,
    fun c => by
      change Finset.univ.sup (fun j : Fin (X.M c + 1) =>
        X.multigradedFun N (X.coordElem ⟨c, j⟩)) = 1
      simp_rw [coordElem_eq_ofPiece, hN.multigradedFun_ofPiece]
      exact hN.sup_coord c⟩

section ofMultigradedNorm

variable {N : (Fin r →₀ ℕ) → K → ℝ≥0} (hN : X.IsMultigradedNorm N)

theorem ofMultigradedNorm_val_apply (p : X.S) :
    (X.ofMultigradedNorm hN).1.val p = X.multigradedFun N p :=
  rfl

/-- On a homogeneous element, `|f T^a|_{ofMultigradedNorm N} = N(f T^a)`. -/
theorem ofMultigradedNorm_val_ofPiece {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) :
    (X.ofMultigradedNorm hN).1.val (X.ofPiece hf) = N a f :=
  hN.multigradedFun_ofPiece hf

end ofMultigradedNorm

/-- **`lem:gl-multigraded-extension`.** A function `N` on homogeneous elements satisfying
`IsMultigradedNorm` extends to a point `v ∈ 𝒳^an` with `|p|_v = max_a N(p_a T^a)`; in particular
`|f T^a|_v = N(f T^a)`. -/
theorem exists_multigradedExtension {N : (Fin r →₀ ℕ) → K → ℝ≥0} (hN : X.IsMultigradedNorm N) :
    ∃ v ∈ X.an, (∀ p : X.S, v.val p = p.1.support.sup fun a => N a (p.1.coeff a)) ∧
      ∀ (a : Fin r →₀ ℕ) (f : K) (hf : f ∈ X.piece a), v.val (X.ofPiece hf) = N a f :=
  ⟨X.ofMultigradedNorm hN, (X.ofMultigradedNorm hN).2, fun _ => rfl,
    fun _ _ hf => X.ofMultigradedNorm_val_ofPiece hN hf⟩

open Classical in
/-- The values `f ↦ |f T^a|_v` of a point on homogeneous elements (set to `0` off `S_a`). -/
def homNorm (v : Berk k X.S) (a : Fin r →₀ ℕ) (f : K) : ℝ≥0 :=
  if h : f ∈ X.piece a then v.val (X.ofPiece h) else 0

theorem homNorm_of_mem (v : Berk k X.S) {a : Fin r →₀ ℕ} {f : K} (hf : f ∈ X.piece a) :
    X.homNorm v a f = v.val (X.ofPiece hf) :=
  dif_pos hf

/-- The values of a point of `𝒳^an` on homogeneous elements satisfy the hypotheses of the
multigraded extension lemma. -/
theorem isMultigradedNorm_homNorm {v : Berk k X.S} (hv : v ∈ X.an) :
    X.IsMultigradedNorm (X.homNorm v) where
  map_zero a := by rw [X.homNorm_of_mem v (Submodule.zero_mem _), X.ofPiece_zero, map_zero]
  map_algebraMap c hc := by
    rw [X.homNorm_of_mem v (X.algebraMap_mem_piece_zero c), X.ofPiece_algebraMap,
      v.val_algebraMap c hc]
  map_mul hf hg := by
    rw [X.homNorm_of_mem v (mul_mem_piece hf hg), X.homNorm_of_mem v hf, X.homNorm_of_mem v hg,
      X.ofPiece_mul, map_mul]
  map_add_le hf hg := by
    rw [X.homNorm_of_mem v (Submodule.add_mem _ hf hg), X.homNorm_of_mem v hf,
      X.homNorm_of_mem v hg, X.ofPiece_add]
    exact v.val.map_add _ _
  sup_coord c := by
    simp_rw [X.homNorm_of_mem v (X.coord_mem_piece c _)]
    exact hv.2 c

/-- Every point of `𝒳^an` is the multigraded extension of its values on homogeneous elements. -/
theorem ofMultigradedNorm_homNorm {v : Berk k X.S} (hv : v ∈ X.an) :
    (X.ofMultigradedNorm (X.isMultigradedNorm_homNorm hv) : Berk k X.S) = v :=
  ext_of_ofPiece (X.ofMultigradedNorm _).2.1 hv.1 fun _ _ hf => by
    rw [ofMultigradedNorm_val_ofPiece, homNorm_of_mem]

end MultiModel

end EnvelopeProperty
