import EnvelopeProperty.Global.ModelChange
import EnvelopeProperty.Global.Sections
import EnvelopeProperty.Algebra.Veronese

/-!
# Segre–Veronese models

This file implements the point-level part of the blueprint node `lem:gl-veronese` of `global.tex`
(subsection `subsec:gl-model`) for the formalization of Fang–Han–Xia, *The envelope property for
unibranch projective varieties* (used in FHX `thm:normal-ample-EP`).

## The model

Let `𝒳 = (K, S, z)` be a model of rank `r ≥ 1` and `a ∈ ℕ^r` positive. The **Segre–Veronese
model** `𝒳_(a)` (`MultiModel.veronese`) has rank `1`, coordinate ring
`S_(a) = ⊕_n S_{n a} U^n ⊆ K[U]` (`MultiModel.veroneseS`, the preimage of `S` under
`ψ_a : K[U] → K[T]`, `U ↦ T^a`, `MultiModel.veroneseHom`) and coordinates `z̃^β U`, `β ∈ Mon(a)`
(enumerated by `MultiModel.monEnum`).

* (M2): `S_(a)` is integral over the Segre coordinates: an integral equation of `f T^{n a}` over
  `k[z]` gives a homogeneous one whose coefficients lie in `k[z]_{m a}`, which is spanned by the
  `z^γ`, `γ ∈ Mon(m a)`, products of `m` elements `z^β`, `β ∈ Mon(a)`
  (`MultiModel.exists_add_of_mem_monSet_add`, the decomposition `Mon(A + B) = Mon(A) + Mon(B)`).
* (M3): `f / g = (f z̃_j^{n a - b}) / (g z̃_j^{n a - b})` for a chart `j` and `n a ≥ b` (`a`
  positive).
* Finite generation (`MultiModel.fg_veroneseS`): with homogeneous generators `g_ℓ T^{d_ℓ}` of `S`,
  `S_(a)` is spanned by the products `g^α` with `∑ α_ℓ d_ℓ ∈ ℕ a`; these `α` form a subtractive
  submonoid of `ℕ^ℓ`, which is finitely generated by Dickson's lemma (Mathlib's
  `AddSubmonoid.fg_of_subtractive`, Gordan's lemma).

## Points (`lem:gl-veronese`)

* `MultiModel.veroneseAnMap : 𝒳^an → 𝒳_(a)^an`, `v ↦ v ∘ ψ_a` (restriction along the inclusion
  `S_(a) → S`, `MultiModel.veroneseAlgHom`), continuous, with `|f U^n|_{v ∘ ψ_a} = |f T^{n a}|_v`
  (`MultiModel.veroneseAnMap_val_ofPiece`) and `⋆ ↦ ⋆` (`MultiModel.veroneseAnMap_triv`).
* The inverse (`MultiModel.veroneseInv`): for `y ∈ 𝒳_(a)^an` and `p ∈ S_b`,
  `N(p T^b) = max_{γ ∈ Mon(n a - b)} |p z̃^γ U^n|_y` for any `n` with `n a ≥ b`
  (`MultiModel.veroneseNorm`; independent of `n`, `MultiModel.veroneseNormAux_eq`) satisfies the
  hypotheses of the multigraded extension lemma (`MultiModel.isMultigradedNorm_veroneseNorm`).
* `MultiModel.veroneseHomeomorph : 𝒳^an ≃ₜ 𝒳_(a)^an`.
* `MultiModel.isNormal_veronese`: `𝒳_(a)` is normal if `𝒳` is (`S_(a) = ψ_a⁻¹(S)` and `ψ_a` is
  injective; simpler than the componentwise argument of `lem:wu-veronese` in the blueprint).

Sections, Fubini–Study and psh functions, and the envelope property are compared in
`EnvelopeProperty.Global.VeronesePSH`.
-/

open scoped NNReal ENNReal Topology

open Topology MvPolynomial

noncomputable section

namespace EnvelopeProperty

universe u

namespace MultiModel

variable {k : Type u} [Field k] {K : Type u} [Field K] [Algebra k K] {r : ℕ}

/-- Every degree `b ∈ ℕ^1` is `single 0 (b 0)`. -/
theorem fin_one_eq_single (b : Fin 1 →₀ ℕ) : b = Finsupp.single 0 (b 0) := by
  refine Finsupp.ext fun i => ?_
  rw [Fin.fin_one_eq_zero i, Finsupp.single_eq_same]

/-! ### Decomposition of multi-indices -/

section MonSet

variable (X : MultiModel k K r)

/-- **`Mon(A + B) = Mon(A) + Mon(B)`**: every multi-index of degree `A + B` is the sum of one of
degree `A` and one of degree `B`. -/
theorem exists_add_of_mem_monSet_add {A B : Fin r →₀ ℕ} {γ : X.CoordIndex →₀ ℕ}
    (hγ : γ ∈ X.monSet (A + B)) :
    ∃ γ₁ ∈ X.monSet A, ∃ γ₂ ∈ X.monSet B, γ = γ₁ + γ₂ := by
  obtain ⟨γ₁, γ₂, rfl, h₁, h₂⟩ := exists_add_of_monDeg_eq_add ((X.mem_monSet).1 hγ)
  exact ⟨γ₁, (X.mem_monSet).2 h₁, γ₂, (X.mem_monSet).2 h₂, rfl⟩

variable {X} in
theorem zCoeff_nsmul (β : X.CoordIndex →₀ ℕ) (m : ℕ) : X.zCoeff (m • β) = X.zCoeff β ^ m := by
  induction m with
  | zero => rw [zero_smul, zCoeff_zero, pow_zero]
  | succ m ih => rw [succ_nsmul, zCoeff_add, ih, pow_succ]

variable {X} in
theorem nsmul_mem_monSet {β : X.CoordIndex →₀ ℕ} {b : Fin r →₀ ℕ} (hβ : β ∈ X.monSet b) (m : ℕ) :
    m • β ∈ X.monSet (m • b) := by
  rw [X.mem_monSet] at hβ ⊢
  induction m with
  | zero => rw [zero_smul, zero_smul, monDeg_zero]
  | succ m ih => rw [succ_nsmul, succ_nsmul, monDeg_add, ih, hβ]

variable {X} in
theorem add_mem_monSet {β γ : X.CoordIndex →₀ ℕ} {b c : Fin r →₀ ℕ} (hβ : β ∈ X.monSet b)
    (hγ : γ ∈ X.monSet c) : β + γ ∈ X.monSet (b + c) := by
  rw [X.mem_monSet] at hβ hγ ⊢
  rw [monDeg_add, hβ, hγ]

/-- `Mon(b)` is nonempty. -/
theorem monSet_nonempty (b : Fin r →₀ ℕ) : (X.monSet b).Nonempty := by
  classical
  refine ⟨Finsupp.equivFunOnFinite.symm fun i => if i.2 = 0 then b i.1 else 0,
    (X.mem_monSet).2 ?_⟩
  ext c
  rw [monDeg_apply, Finset.sum_eq_single 0 (fun j _ hj => by
    change (if j = 0 then b c else 0) = 0
    rw [if_neg hj]) (by simp)]
  change (if (0 : Fin (X.M c + 1)) = 0 then b c else 0) = b c
  rw [if_pos rfl]

end MonSet

/-! ### The map `ψ_a : K[U] → K[T]` -/

section VeroneseHom

variable (a : Fin r →₀ ℕ)

variable (k) in
/-- `ψ_a : K[U] → K[T]`, `U ↦ T^a`. -/
def veroneseHom : MvPolynomial (Fin 1) K →ₐ[k] MvPolynomial (Fin r) K :=
  (aeval fun _ : Fin 1 => (monomial a (1 : K) : MvPolynomial (Fin r) K)).restrictScalars k

theorem veroneseHom_monomial (u : Fin 1 →₀ ℕ) (f : K) :
    veroneseHom k a (monomial u f) = monomial (u 0 • a) f := by
  conv_lhs => rw [fin_one_eq_single u]
  rw [veroneseHom, AlgHom.restrictScalars_apply, aeval_monomial,
    Finsupp.prod_single_index (h := fun (_ : Fin 1) (n : ℕ) =>
      (monomial a (1 : K) : MvPolynomial (Fin r) K) ^ n) (pow_zero _), monomial_pow, one_pow,
    MvPolynomial.algebraMap_eq, C_mul_monomial, mul_one]

theorem veroneseHom_monomial_single (n : ℕ) (f : K) :
    veroneseHom k a (monomial (Finsupp.single 0 n) f) = monomial (n • a) f := by
  rw [veroneseHom_monomial, Finsupp.single_eq_same]

variable {a}

theorem coeff_veroneseHom (ha0 : a ≠ 0) (p : MvPolynomial (Fin 1) K) (n : ℕ) :
    (veroneseHom k a p).coeff (n • a) = p.coeff (Finsupp.single 0 n) := by
  induction p using MvPolynomial.induction_on' with
  | monomial u f =>
    rw [veroneseHom_monomial, coeff_monomial, coeff_monomial]
    by_cases h : u 0 = n
    · rw [if_pos (by rw [h]), if_pos (by rw [fin_one_eq_single u, h])]
    · rw [if_neg fun h' => h ((nsmul_eq_nsmul_iff ha0).1 h'),
        if_neg fun h' => h (by rw [h', Finsupp.single_eq_same])]
  | add p q hp hq => rw [map_add, coeff_add, coeff_add, hp, hq]

theorem veroneseHom_injective (ha0 : a ≠ 0) :
    Function.Injective (veroneseHom k a : MvPolynomial (Fin 1) K → MvPolynomial (Fin r) K) := by
  intro p q hpq
  ext u
  rw [fin_one_eq_single u, ← coeff_veroneseHom (k := k) ha0, ← coeff_veroneseHom (k := k) ha0,
    hpq]

end VeroneseHom

/-! ### The coordinate ring `S_(a)` -/

section VeroneseS

variable (X : MultiModel k K r) (a : Fin r →₀ ℕ)

/-- The coordinate ring `S_(a) = ⊕_n S_{n a} U^n ⊆ K[U]` of the Segre–Veronese model: the
preimage of `S` under `ψ_a`. -/
def veroneseS : Subalgebra k (MvPolynomial (Fin 1) K) :=
  X.S.comap (veroneseHom k a)

variable {X a}

theorem mem_veroneseS {p : MvPolynomial (Fin 1) K} :
    p ∈ X.veroneseS a ↔ veroneseHom k a p ∈ X.S :=
  Iff.rfl

theorem monomial_mem_veroneseS_iff (n : ℕ) (f : K) :
    monomial (Finsupp.single 0 n) f ∈ X.veroneseS a ↔ f ∈ X.piece (n • a) := by
  rw [mem_veroneseS, veroneseHom_monomial_single]
  rfl

/-- `S_(a)` is graded. -/
theorem isGraded_veroneseS (ha0 : a ≠ 0) {p : MvPolynomial (Fin 1) K} (hp : p ∈ X.veroneseS a)
    (u : Fin 1 →₀ ℕ) : monomial u (p.coeff u) ∈ X.veroneseS a := by
  rw [fin_one_eq_single u, monomial_mem_veroneseS_iff, ← coeff_veroneseHom (k := k) ha0]
  exact X.isGraded _ hp _

end VeroneseS

/-! ### Finite generation of `S_(a)` -/

section FG

variable (X : MultiModel k K r) {a : Fin r →₀ ℕ}

open Classical in
/-- The index `n` with `d = n a`, or `0`. -/
private def nOf (a d : Fin r →₀ ℕ) : ℕ :=
  if h : ∃ n : ℕ, d = n • a then h.choose else 0

private theorem nOf_nsmul (ha0 : a ≠ 0) (n : ℕ) : nOf a (n • a) = n := by
  have h : ∃ m : ℕ, n • a = m • a := ⟨n, rfl⟩
  rw [nOf, dif_pos h]
  exact ((nsmul_eq_nsmul_iff ha0).1 h.choose_spec).symm

open Classical in
/-- The projection `K[T] → K[U]` keeping the monomials of degree in `ℕ a`, `T^{n a} ↦ U^n`. -/
private def vProj (a : Fin r →₀ ℕ) (q : MvPolynomial (Fin r) K) : MvPolynomial (Fin 1) K :=
  (AddMonoidAlgebra.coeff q).sum fun d f =>
    if ∃ n : ℕ, d = n • a then monomial (Finsupp.single 0 (nOf a d)) f else 0

open Classical in
private theorem vProj_monomial (d : Fin r →₀ ℕ) (f : K) :
    vProj a (monomial d f) = if ∃ n : ℕ, d = n • a then
      monomial (Finsupp.single 0 (nOf a d)) f else 0 := by
  rw [vProj]
  exact MvPolynomial.sum_monomial_eq (by split_ifs <;> simp)

private theorem vProj_add (q q' : MvPolynomial (Fin r) K) :
    vProj a (q + q') = vProj a q + vProj a q' := by
  classical
  rw [vProj, vProj, vProj, AddMonoidAlgebra.coeff_add]
  exact Finsupp.sum_add_index' (fun d => by split_ifs <;> simp) fun d f g => by
    split_ifs <;> simp

private theorem vProj_zero : vProj a (0 : MvPolynomial (Fin r) K) = 0 := by
  rw [← monomial_zero (s := 0), vProj_monomial]
  split_ifs <;> simp

private theorem vProj_smul (c : k) (q : MvPolynomial (Fin r) K) :
    vProj a (c • q) = c • vProj a q := by
  induction q using MvPolynomial.induction_on' with
  | monomial d f =>
    rw [smul_monomial, vProj_monomial, vProj_monomial]
    split_ifs
    · rw [smul_monomial]
    · rw [smul_zero]
  | add p q hp hq => rw [smul_add, vProj_add, vProj_add, hp, hq, smul_add]

private theorem vProj_veroneseHom (ha0 : a ≠ 0) (p : MvPolynomial (Fin 1) K) :
    vProj a (veroneseHom k a p) = p := by
  induction p using MvPolynomial.induction_on' with
  | monomial u f =>
    rw [veroneseHom_monomial, vProj_monomial, if_pos ⟨u 0, rfl⟩, nOf_nsmul ha0,
      ← fin_one_eq_single u]
  | add p q hp hq => rw [map_add, vProj_add, hp, hq]

/-- **Finite generation of `S_(a)`** (`lem:gl-veronese`, the model condition: `S_(a)` f.g.): with
homogeneous generators `g_ℓ T^{d_ℓ}` of `S`, `S_(a)` is spanned by the `g^α` with
`∑ α_ℓ d_ℓ ∈ ℕ a`; these `α` form a subtractive submonoid of `ℕ^ℓ`, finitely generated by Dickson's
lemma (`AddSubmonoid.fg_of_subtractive`). -/
theorem fg_veroneseS (ha0 : a ≠ 0) : (X.veroneseS a).FG := by
  classical
  obtain ⟨t, ht⟩ := X.fg
  -- Homogeneous generators of `S`.
  set G : Finset ((Fin r →₀ ℕ) × K) := t.biUnion fun p => p.support.image fun d => (d, p.coeff d)
  have hG : ∀ x ∈ G, monomial x.1 x.2 ∈ X.S := by
    intro x hx
    obtain ⟨p, hp, hx⟩ := Finset.mem_biUnion.1 hx
    obtain ⟨d, -, rfl⟩ := Finset.mem_image.1 hx
    exact X.isGraded p (ht ▸ Algebra.subset_adjoin hp) d
  set gen : G → MvPolynomial (Fin r) K := fun ℓ => monomial ℓ.1.1 ℓ.1.2
  have hgen : Algebra.adjoin k (Set.range gen) = X.S := by
    refine le_antisymm (Algebra.adjoin_le (Set.range_subset_iff.2 fun ℓ => hG ℓ.1 ℓ.2)) ?_
    rw [← ht]
    refine Algebra.adjoin_le fun p hp => ?_
    rw [p.as_sum]
    refine Subalgebra.sum_mem _ fun d hd => Algebra.subset_adjoin ⟨⟨(d, p.coeff d), ?_⟩, rfl⟩
    exact Finset.mem_biUnion.2 ⟨p, hp, Finset.mem_image.2 ⟨d, hd, rfl⟩⟩
  -- The degree map `α ↦ ∑ α_ℓ d_ℓ` and the products `g^α`.
  set D : (G →₀ ℕ) → (Fin r →₀ ℕ) := fun α => α.sum fun ℓ n => n • ℓ.1.1
  set gp : (G →₀ ℕ) → K := fun α => α.prod fun ℓ n => ℓ.1.2 ^ n
  have hD_add : ∀ α β, D (α + β) = D α + D β := fun α β =>
    Finsupp.sum_add_index' (fun _ => zero_smul _ _) fun _ _ _ => add_smul _ _ _
  have hgp_add : ∀ α β, gp (α + β) = gp α * gp β := fun α β =>
    Finsupp.prod_add_index' (fun _ => pow_zero _) fun _ _ _ => pow_add _ _ _
  have hD_zero : D 0 = 0 := Finsupp.sum_zero_index
  have hgp_zero : gp 0 = 1 := Finsupp.prod_zero_index
  -- Products of the generators are the monomials `g^α T^{D α}`.
  have hclos : ∀ q ∈ Submonoid.closure (Set.range gen), ∃ α : G →₀ ℕ,
      q = monomial (D α) (gp α) := by
    intro q hq
    induction hq using Submonoid.closure_induction with
    | mem x hx =>
      obtain ⟨ℓ, rfl⟩ := hx
      refine ⟨Finsupp.single ℓ 1, ?_⟩
      simp only [D, gp, Finsupp.sum_single_index (h := fun (ℓ : G) (n : ℕ) => n • ℓ.1.1)
        (zero_smul _ _), Finsupp.prod_single_index (h := fun (ℓ : G) (n : ℕ) => ℓ.1.2 ^ n)
        (pow_zero _), one_smul, pow_one, gen]
    | one => exact ⟨0, by rw [hD_zero, hgp_zero, ← C_apply, C_1]⟩
    | mul x y _ _ hx hy =>
      obtain ⟨α, rfl⟩ := hx
      obtain ⟨β, rfl⟩ := hy
      exact ⟨α + β, by rw [monomial_mul, hD_add, hgp_add]⟩
  -- The submonoid `Λ` of the `α` with `D α ∈ ℕ a`, finitely generated.
  set Λ : AddSubmonoid (G →₀ ℕ) :=
    { carrier := {α | ∃ n : ℕ, D α = n • a}
      zero_mem' := ⟨0, by rw [hD_zero, zero_smul]⟩
      add_mem' := fun {α β} ⟨n, hn⟩ ⟨m, hm⟩ => ⟨n + m, by rw [hD_add, hn, hm, add_nsmul]⟩ }
  have hsub : ∀ x ∈ Λ, ∀ y, x + y ∈ Λ → y ∈ Λ := by
    rintro x ⟨n, hn⟩ y ⟨m, hm⟩
    rw [hD_add, hn] at hm
    obtain ⟨c, hc⟩ := Finsupp.ne_iff.1 ha0
    have hle : n ≤ m := by
      have := congrArg (fun d : Fin r →₀ ℕ => d c) hm
      simp only [Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul, Finsupp.coe_zero,
        Pi.zero_apply] at this hc
      exact Nat.le_of_mul_le_mul_right (this ▸ Nat.le_add_right _ _) (Nat.pos_of_ne_zero hc)
    refine ⟨m - n, ?_⟩
    have e : n • a + (m - n) • a = m • a := by rw [← add_nsmul, Nat.add_sub_cancel' hle]
    exact add_left_cancel (hm.trans e.symm)
  obtain ⟨F, hF⟩ := AddSubmonoid.fg_of_subtractive hsub
  -- The generators `g^α U^n`, `α ∈ F`.
  set elt : (G →₀ ℕ) → MvPolynomial (Fin 1) K :=
    fun α => monomial (Finsupp.single 0 (nOf a (D α))) (gp α)
  have hmono : ∀ α : G →₀ ℕ, monomial (D α) (gp α) ∈ X.S := by
    intro α
    have : monomial (D α) (gp α) ∈ Submonoid.closure (Set.range gen) := by
      induction α using Finsupp.induction with
      | zero => rw [hD_zero, hgp_zero, ← C_apply, C_1]; exact Submonoid.one_mem _
      | single_add ℓ n α _ _ ih =>
        rw [hD_add, hgp_add, ← monomial_mul]
        refine Submonoid.mul_mem _ ?_ ih
        have e : monomial (D (Finsupp.single ℓ n)) (gp (Finsupp.single ℓ n)) = gen ℓ ^ n := by
          simp only [D, gp, Finsupp.sum_single_index (h := fun (ℓ : G) (n : ℕ) => n • ℓ.1.1)
            (zero_smul _ _), Finsupp.prod_single_index (h := fun (ℓ : G) (n : ℕ) => ℓ.1.2 ^ n)
            (pow_zero _), gen, monomial_pow]
        rw [e]
        exact Submonoid.pow_mem _ (Submonoid.subset_closure (s := Set.range gen) ⟨ℓ, rfl⟩) n
    rw [← hgen]
    exact Algebra.adjoin_le_iff.2 Algebra.subset_adjoin
      (Submonoid.closure_le.2 Algebra.subset_adjoin this)
  have helt_mem : ∀ α ∈ Λ, elt α ∈ X.veroneseS a := by
    rintro α ⟨n, hn⟩
    rw [mem_veroneseS, veroneseHom_monomial_single, hn, nOf_nsmul ha0, ← hn]
    exact hmono α
  set A := Algebra.adjoin k (elt '' (F : Set (G →₀ ℕ)))
  have helt : ∀ α ∈ Λ, elt α ∈ A := by
    intro α hα
    rw [← hF] at hα
    induction hα using AddSubmonoid.closure_induction with
    | mem x hx => exact Algebra.subset_adjoin ⟨x, hx, rfl⟩
    | zero =>
      have : elt 0 = 1 := by
        simp only [elt, hD_zero, hgp_zero]
        rw [show (0 : Fin r →₀ ℕ) = 0 • a from (zero_smul _ _).symm, nOf_nsmul ha0,
          Finsupp.single_zero, ← C_apply, C_1]
      rw [this]; exact Subalgebra.one_mem _
    | add x y hx hy ihx ihy =>
      rw [hF] at hx hy
      obtain ⟨n, hn⟩ := hx
      obtain ⟨m, hm⟩ := hy
      have : elt (x + y) = elt x * elt y := by
        simp only [elt, hD_add, hgp_add, hn, hm, ← add_nsmul, nOf_nsmul ha0, monomial_mul,
          Finsupp.single_add]
      rw [this]
      exact Subalgebra.mul_mem _ ihx ihy
  -- The projection of an element of `S` lies in `A`.
  have hproj : ∀ q ∈ X.S, vProj a q ∈ A := by
    intro q hq
    rw [← hgen] at hq
    have hq' : q ∈ Submodule.span k (Submonoid.closure (Set.range gen) :
        Set (MvPolynomial (Fin r) K)) := by
      rw [← Algebra.adjoin_eq_span]; exact hq
    clear hq
    induction hq' using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨α, rfl⟩ := hclos x hx
      rw [vProj_monomial]
      split_ifs with h
      · obtain ⟨n, hn⟩ := h
        have := helt α ⟨n, hn⟩
        exact this
      · exact Subalgebra.zero_mem _
    | zero => rw [vProj_zero]; exact Subalgebra.zero_mem _
    | add x y _ _ hx hy => rw [vProj_add]; exact Subalgebra.add_mem _ hx hy
    | smul c x _ hx => rw [vProj_smul]; exact Subalgebra.smul_mem _ hx c
  refine ⟨F.image elt, ?_⟩
  rw [Finset.coe_image]
  refine le_antisymm (Algebra.adjoin_le ?_) fun p hp => ?_
  · rintro _ ⟨α, hα, rfl⟩
    exact helt_mem α (hF ▸ AddSubmonoid.subset_closure hα)
  · rw [← vProj_veroneseHom (k := k) ha0 p]
    exact hproj _ hp

end FG


/-! ### The Segre coordinates and integrality -/

/-- Integrality over a subalgebra implies integrality over a larger one. -/
theorem isIntegral_of_le_subalgebra {R : Type*} [CommRing R] [Algebra k R] {A B : Subalgebra k R}
    (h : A ≤ B) {x : R} (hx : IsIntegral A x) : IsIntegral B x := by
  obtain ⟨P, hPm, hP⟩ := hx
  refine ⟨P.map (Subalgebra.inclusion h : A →+* B), hPm.map _, ?_⟩
  rw [Polynomial.eval₂_map]
  exact hP

section Segre

variable (X : MultiModel k K r) (a : Fin r →₀ ℕ)

/-- The subalgebra `k[z̃^β U : β ∈ Mon(a)] ⊆ K[U]` generated by the Segre coordinates. -/
def segreAlg : Subalgebra k (MvPolynomial (Fin 1) K) :=
  Algebra.adjoin k (Set.range fun β : X.monSet a => monomial (Finsupp.single 0 1) (X.zCoeff β))

variable {X a}

theorem monDeg_eq_zero_iff {γ : X.CoordIndex →₀ ℕ} : X.monDeg γ = 0 ↔ γ = 0 := by
  refine ⟨fun h => ?_, fun h => by rw [h, monDeg_zero]⟩
  ext i
  have h1 := congrArg (fun d : Fin r →₀ ℕ => d i.1) h
  simp only [Finsupp.coe_zero, Pi.zero_apply] at h1
  rw [monDeg_apply] at h1
  exact (Finset.sum_eq_zero_iff.1 h1) i.2 (Finset.mem_univ _)

/-- For `γ ∈ Mon(q a)`, `z̃^γ U^q` is a product of `q` Segre coordinates. -/
theorem monomial_zCoeff_mem_segreAlg (q : ℕ) {γ : X.CoordIndex →₀ ℕ}
    (hγ : γ ∈ X.monSet (q • a)) :
    monomial (Finsupp.single 0 q) (X.zCoeff γ) ∈ X.segreAlg a := by
  induction q generalizing γ with
  | zero =>
    rw [zero_smul, X.mem_monSet, monDeg_eq_zero_iff] at hγ
    rw [hγ, zCoeff_zero, Finsupp.single_zero, ← C_apply, C_1]
    exact Subalgebra.one_mem _
  | succ q ih =>
    rw [succ_nsmul'] at hγ
    obtain ⟨γ₁, hγ₁, γ₂, hγ₂, rfl⟩ := X.exists_add_of_mem_monSet_add hγ
    rw [zCoeff_add, show Finsupp.single (0 : Fin 1) (q + 1) =
      Finsupp.single 0 1 + Finsupp.single 0 q by rw [← Finsupp.single_add, add_comm],
      ← monomial_mul]
    exact Subalgebra.mul_mem _ (Algebra.subset_adjoin ⟨⟨γ₁, hγ₁⟩, rfl⟩) (ih hγ₂)

/-- The `ℕ a`-homogeneous parts of elements of `k[z]` lie in the algebra of the Segre
coordinates. -/
theorem monomial_coeff_mem_segreAlg {P : MvPolynomial (Fin r) K} (hP : P ∈ X.coordAlg) (q : ℕ) :
    monomial (Finsupp.single 0 q) (P.coeff (q • a)) ∈ X.segreAlg a := by
  classical
  have hP' : P ∈ Submodule.span k (Submonoid.closure (Set.range X.coordMono) :
      Set (MvPolynomial (Fin r) K)) := by
    rw [← Algebra.adjoin_eq_span]; exact hP
  clear hP
  induction hP' using Submodule.span_induction with
  | mem x hx =>
    have hγ : ∃ γ : X.CoordIndex →₀ ℕ, x = monomial (X.monDeg γ) (X.zCoeff γ) := by
      induction hx using Submonoid.closure_induction with
      | mem x hx =>
        obtain ⟨i, rfl⟩ := hx
        exact ⟨Finsupp.single i 1, by rw [monDeg_single, zCoeff_single, pow_one]; rfl⟩
      | one => exact ⟨0, by rw [monDeg_zero, zCoeff_zero, ← C_apply, C_1]⟩
      | mul x y _ _ hx hy =>
        obtain ⟨γ, rfl⟩ := hx
        obtain ⟨γ', rfl⟩ := hy
        exact ⟨γ + γ', by rw [monomial_mul, monDeg_add, zCoeff_add]⟩
    obtain ⟨γ, rfl⟩ := hγ
    rw [coeff_monomial]
    split_ifs with h
    · exact monomial_zCoeff_mem_segreAlg q ((X.mem_monSet).2 h)
    · rw [monomial_zero]; exact Subalgebra.zero_mem _
  | zero => rw [coeff_zero, monomial_zero]; exact Subalgebra.zero_mem _
  | add x y _ _ hx hy => rw [coeff_add, map_add]; exact Subalgebra.add_mem _ hx hy
  | smul c x _ hx => rw [coeff_smul, ← smul_monomial]; exact Subalgebra.smul_mem _ hx c

/-- **(M2) for the Segre–Veronese model**: a homogeneous element `f U^n` of `S_(a)` is integral
over the Segre coordinates (the coefficient of `T^{m n a}` of an integral equation of `f T^{n a}`
over `k[z]`). -/
theorem isIntegral_segreAlg_monomial {n : ℕ} {f : K} (hf : f ∈ X.piece (n • a)) :
    IsIntegral (X.segreAlg a)
      (monomial (Finsupp.single (0 : Fin 1) n) f : MvPolynomial (Fin 1) K) := by
  obtain ⟨P, hPm, hP⟩ := X.isIntegral_coordAlg hf
  set e := n • a
  set m := P.natDegree
  set c : Fin m → K := fun i => (P.coeff i).1.coeff ((m - i) • e)
  have hterm : ∀ i : Fin m,
      ((algebraMap X.coordAlg (MvPolynomial (Fin r) K) (P.coeff i)) * monomial e f ^ (i : ℕ)).coeff
        (m • e) = c i * f ^ (i : ℕ) := by
    intro i
    have hle : (i : ℕ) • e ≤ m • e := nsmul_le_nsmul_left (zero_le) i.2.le
    have hsub : m • e - (i : ℕ) • e = (m - i) • e := by
      ext d
      simp [Nat.sub_mul]
    rw [monomial_pow, coeff_mul_monomial', if_pos hle, hsub]
    rfl
  have key := congrArg (fun q : MvPolynomial (Fin r) K => q.coeff (m • e)) hP
  rw [hPm.as_sum, Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum,
    coeff_add, coeff_sum, Finset.sum_range (fun i => (Polynomial.eval₂
      (algebraMap X.coordAlg (MvPolynomial (Fin r) K)) (monomial e f)
        (Polynomial.C (P.coeff i) * Polynomial.X ^ i)).coeff (m • e))] at key
  simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow] at key
  rw [Finset.sum_congr rfl fun i _ => hterm i, monomial_pow, coeff_monomial, if_pos rfl,
    coeff_zero] at key
  have hmem : ∀ i : Fin m, monomial (Finsupp.single 0 ((m - i) * n)) (c i) ∈ X.segreAlg a := by
    intro i
    have := monomial_coeff_mem_segreAlg (a := a) (P.coeff i).2 ((m - i) * n)
    rwa [← smul_smul] at this
  refine ⟨Polynomial.X ^ m + ∑ i : Fin m, Polynomial.C (⟨monomial (Finsupp.single 0 ((m - i) * n))
    (c i), hmem i⟩ : X.segreAlg a) * Polynomial.X ^ (i : ℕ),
    Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt _), ?_⟩
  rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum]
  simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
  have hdeg : ∀ i : Fin m, Finsupp.single (0 : Fin 1) ((m - i) * n) + (i : ℕ) • Finsupp.single 0 n =
      m • Finsupp.single 0 n := fun i => by
    rw [Finsupp.smul_single, Finsupp.smul_single, smul_eq_mul, smul_eq_mul, ← Finsupp.single_add,
      ← add_mul, Nat.sub_add_cancel i.2.le]
  change monomial (Finsupp.single 0 n) f ^ m + ∑ i : Fin m,
    monomial (Finsupp.single 0 ((m - i) * n)) (c i) * monomial (Finsupp.single 0 n) f ^ (i : ℕ) = 0
  simp only [monomial_pow, monomial_mul, hdeg]
  rw [← map_sum, ← map_add, key, map_zero]

/-- **(M2) for the Segre–Veronese model**: `S_(a)` is integral over the Segre coordinates. -/
theorem isIntegral_segreAlg (ha0 : a ≠ 0) {p : MvPolynomial (Fin 1) K}
    (hp : p ∈ X.veroneseS a) : IsIntegral (X.segreAlg a) p := by
  rw [← mem_integralClosure_iff, p.as_sum]
  refine Subalgebra.sum_mem _ fun u _ => ?_
  have hu := isGraded_veroneseS ha0 hp u
  rw [fin_one_eq_single u] at hu ⊢
  rw [monomial_mem_veroneseS_iff] at hu
  exact isIntegral_segreAlg_monomial hu

/-- **(M3) for the Segre–Veronese model** (`a` positive): `f / g = (f z̃_j^{n a - b}) /
(g z̃_j^{n a - b})` with `n = ∑_c b_c`. -/
theorem generates_veroneseS (ha : ∀ c, 0 < a c) :
    IntermediateField.adjoin k {x : K | ∃ (u : Fin 1 →₀ ℕ) (f g : K),
      monomial u f ∈ X.veroneseS a ∧ monomial u g ∈ X.veroneseS a ∧ g ≠ 0 ∧ x = f / g} = ⊤ := by
  classical
  rw [eq_top_iff, ← X.generates, IntermediateField.adjoin_le_iff]
  rintro _ ⟨b, f, g, hf, hg, hg0, rfl⟩
  obtain ⟨j, hj⟩ := X.exists_chartIndex_ne_zero
  set n := ∑ c, b c
  have hle : b ≤ n • a := by
    intro c
    simp only [Finsupp.smul_apply, smul_eq_mul]
    calc b c ≤ n := Finset.single_le_sum (f := fun c => b c) (fun _ _ => zero_le)
          (Finset.mem_univ c)
      _ ≤ n * a c := Nat.le_mul_of_pos_right _ (ha c)
  set d := n • a - b
  have hbd : b + d = n • a := add_tsub_cancel_of_le hle
  refine IntermediateField.subset_adjoin _ _ ⟨Finsupp.single 0 n, f * X.chartDen j d,
    g * X.chartDen j d, ?_, ?_, mul_ne_zero hg0 (chartDen_ne_zero hj d), ?_⟩
  · rw [monomial_mem_veroneseS_iff, ← hbd]
    exact mul_mem_piece hf (X.chartDen_mem_piece j d)
  · rw [monomial_mem_veroneseS_iff, ← hbd]
    exact mul_mem_piece hg (X.chartDen_mem_piece j d)
  · rw [mul_div_mul_right _ _ (chartDen_ne_zero hj d)]

end Segre

/-! ### The Segre–Veronese model -/

section Model

variable (X : MultiModel k K r) (a : Fin r →₀ ℕ)

/-- `|Mon(a)| - 1`, so that the Segre coordinates are indexed by `Fin (veroneseM + 1)`. -/
def veroneseM : ℕ :=
  (X.monSet a).card - 1

theorem card_monSet : (X.monSet a).card = X.veroneseM a + 1 :=
  (Nat.sub_add_cancel (Finset.card_pos.2 (X.monSet_nonempty a))).symm

/-- The enumeration `Fin (veroneseM + 1) ≃ Mon(a)` of the Segre coordinates. -/
def monEnum : Fin (X.veroneseM a + 1) ≃ X.monSet a :=
  ((X.monSet a).equivFin.trans (finCongr (X.card_monSet a))).symm

/-- `max_{j} g(β_j) = max_{β ∈ Mon(a)} g(β)` for the enumeration of `Mon(a)`. -/
theorem sup_monEnum (g : (X.CoordIndex →₀ ℕ) → ℝ≥0) :
    (Finset.univ.sup fun j : Fin (X.veroneseM a + 1) => g (X.monEnum a j).1) =
      (X.monSet a).sup g := by
  rw [← Finset.sup_attach (X.monSet a) g, ← Finset.univ_eq_attach,
    ← Finset.map_univ_equiv (X.monEnum a), Finset.sup_map]
  rfl


variable {a}

variable (a) in
/-- The Segre coordinates `z̃^β`, `β ∈ Mon(a)`, indexed by `Fin (veroneseM + 1)`. -/
def veroneseCoord (_ : Fin 1) (j : Fin (X.veroneseM a + 1)) : K :=
  X.zCoeff (X.monEnum a j).1

variable (a) in
theorem coord_mem_veroneseS (c : Fin 1) (j : Fin (X.veroneseM a + 1)) :
    monomial (Finsupp.single c 1) (X.veroneseCoord a c j) ∈ X.veroneseS a := by
  rw [Fin.fin_one_eq_zero c, monomial_mem_veroneseS_iff, one_smul]
  have h := X.zCoeff_mem_piece (X.monEnum a j).1
  rwa [(X.mem_monSet).1 (X.monEnum a j).2] at h

variable (a) in
theorem exists_veroneseCoord_ne_zero (c : Fin 1) : ∃ j, X.veroneseCoord a c j ≠ 0 := by
  obtain ⟨j, hj⟩ := X.exists_chartIndex_ne_zero
  refine ⟨(X.monEnum a).symm ⟨X.chartMultiIndex j a, X.chartMultiIndex_mem_monSet j a⟩, ?_⟩
  rw [veroneseCoord, Equiv.apply_symm_apply, zCoeff_chartMultiIndex]
  exact chartDen_ne_zero hj a

variable (a) in
/-- The Segre coordinates generate the same algebra as the coordinates of `𝒳_(a)`. -/
theorem segreAlg_le_adjoin :
    X.segreAlg a ≤ Algebra.adjoin k (Set.range fun i : (Σ _ : Fin 1, Fin (X.veroneseM a + 1)) =>
      (monomial (Finsupp.single i.1 1) (X.veroneseCoord a i.1 i.2) : MvPolynomial (Fin 1) K)) := by
  refine Algebra.adjoin_le ?_
  rintro _ ⟨β, rfl⟩
  refine Algebra.subset_adjoin ⟨⟨0, (X.monEnum a).symm β⟩, ?_⟩
  simp only [veroneseCoord, Equiv.apply_symm_apply]

theorem ne_zero_of_pos [NeZero r] (ha : ∀ c, 0 < a c) : a ≠ 0 := fun h =>
  (ha 0).ne' (by rw [h]; rfl)

theorem isIntegral_veroneseCoord [NeZero r] (ha : ∀ c, 0 < a c) {p : MvPolynomial (Fin 1) K}
    (hp : p ∈ X.veroneseS a) :
    IsIntegral (Algebra.adjoin k (Set.range fun i : (Σ _ : Fin 1, Fin (X.veroneseM a + 1)) =>
      (monomial (Finsupp.single i.1 1) (X.veroneseCoord a i.1 i.2) : MvPolynomial (Fin 1) K))) p :=
  isIntegral_of_le_subalgebra (X.segreAlg_le_adjoin a) (isIntegral_segreAlg (ne_zero_of_pos ha) hp)

/-- **The Segre–Veronese model** `𝒳_(a)` of rank `1` (`lem:gl-veronese`), for `a ∈ ℕ^r`
positive: `S_(a) = ⊕_n S_{n a} U^n ⊆ K[U]` with the coordinates `z̃^β U`, `β ∈ Mon(a)`. -/
def veronese [NeZero r] (ha : ∀ c, 0 < a c) : MultiModel k K 1 where
  S := X.veroneseS a
  isGraded _ hp u := isGraded_veroneseS (ne_zero_of_pos ha) hp u
  fg := X.fg_veroneseS (ne_zero_of_pos ha)
  M := fun _ => X.veroneseM a
  coord := X.veroneseCoord a
  coord_mem := X.coord_mem_veroneseS a
  exists_coord_ne_zero := X.exists_veroneseCoord_ne_zero a
  isIntegral _ hp := X.isIntegral_veroneseCoord ha hp
  generates := X.generates_veroneseS ha

end Model


/-! ### Points of the Segre–Veronese model -/

section Points

variable [NeZero r] (X : MultiModel k K r) {a : Fin r →₀ ℕ} (ha : ∀ c, 0 < a c)

theorem veronese_S : (X.veronese ha).S = X.veroneseS a :=
  rfl

theorem mem_veronese_piece_iff {n : ℕ} {f : K} :
    f ∈ (X.veronese ha).piece (Finsupp.single 0 n) ↔ f ∈ X.piece (n • a) :=
  monomial_mem_veroneseS_iff n f

theorem mem_veronese_piece_iff' {u : Fin 1 →₀ ℕ} {f : K} :
    f ∈ (X.veronese ha).piece u ↔ f ∈ X.piece (u 0 • a) := by
  conv_lhs => rw [fin_one_eq_single u]
  exact X.mem_veronese_piece_iff ha

/-- The inclusion `S_(a) → S`, `U ↦ T^a`. -/
def veroneseAlgHom : (X.veronese ha).S →ₐ[k] X.S :=
  ((veroneseHom k a).comp (X.veroneseS a).val).codRestrict X.S fun p => p.2

@[simp]
theorem coe_veroneseAlgHom (p : (X.veronese ha).S) :
    (X.veroneseAlgHom ha p : MvPolynomial (Fin r) K) = veroneseHom k a p.1 :=
  rfl

theorem veroneseAlgHom_injective : Function.Injective (X.veroneseAlgHom ha) := fun _ _ h =>
  Subtype.ext (veroneseHom_injective (k := k) (ne_zero_of_pos ha) (congrArg Subtype.val h))

theorem veroneseAlgHom_ofPiece {u : Fin 1 →₀ ℕ} {f : K} (hf : f ∈ (X.veronese ha).piece u) :
    X.veroneseAlgHom ha ((X.veronese ha).ofPiece hf) =
      X.ofPiece ((X.mem_veronese_piece_iff' ha).1 hf) :=
  Subtype.ext (veroneseHom_monomial (k := k) a u f)

theorem veroneseAlgHom_homComp (u : Fin 1 →₀ ℕ) (p : (X.veronese ha).S) :
    X.veroneseAlgHom ha ((X.veronese ha).homComp u p) =
      X.homComp (u 0 • a) (X.veroneseAlgHom ha p) := by
  apply Subtype.ext
  rw [coe_veroneseAlgHom, coe_homComp, coe_homComp, coe_veroneseAlgHom, veroneseHom_monomial,
    coeff_veroneseHom (ne_zero_of_pos ha), ← fin_one_eq_single u]

theorem veroneseAlgHom_coordElem (j : Fin (X.veroneseM a + 1)) :
    X.veroneseAlgHom ha ((X.veronese ha).coordElem ⟨0, j⟩) = X.zMon (X.monEnum a j).1 := by
  apply Subtype.ext
  rw [coe_veroneseAlgHom, coe_coordElem, zMon, coe_ofPiece, veroneseHom_monomial,
    Finsupp.single_eq_same, one_smul, (X.mem_monSet).1 (X.monEnum a j).2]
  rfl

/-- **Restriction of points** `𝒳^an → 𝒳_(a)^an`, `v ↦ v ∘ ψ_a` (`lem:gl-veronese`). -/
def veroneseAnMap (v : X.an) : (X.veronese ha).an :=
  ⟨Berk.comap (X.veroneseAlgHom ha) v.1, fun p u => by
      rw [Berk.comap_val_apply, Berk.comap_val_apply, veroneseAlgHom_homComp]
      exact v.2.1 _ _, fun c => by
      obtain rfl := Fin.fin_one_eq_zero c
      change Finset.univ.sup (fun j : Fin (X.veroneseM a + 1) =>
        (Berk.comap (X.veroneseAlgHom ha) v.1).val ((X.veronese ha).coordElem ⟨0, j⟩)) = 1
      simp_rw [Berk.comap_val_apply, veroneseAlgHom_coordElem]
      rw [X.sup_monEnum a (fun β => v.1.val (X.zMon β))]
      exact v.2.2.sup_monSet_val_zMon a⟩

theorem veroneseAnMap_val (v : X.an) (p : (X.veronese ha).S) :
    (X.veroneseAnMap ha v).1.val p = v.1.val (X.veroneseAlgHom ha p) :=
  rfl

/-- `|f U^n|_{v ∘ ψ_a} = |f T^{n a}|_v`: values of sections are preserved. -/
theorem veroneseAnMap_val_ofPiece (v : X.an) {u : Fin 1 →₀ ℕ} {f : K}
    (hf : f ∈ (X.veronese ha).piece u) :
    (X.veroneseAnMap ha v).1.val ((X.veronese ha).ofPiece hf) =
      v.1.val (X.ofPiece ((X.mem_veronese_piece_iff' ha).1 hf)) := by
  rw [veroneseAnMap_val, veroneseAlgHom_ofPiece]

theorem continuous_veroneseAnMap : Continuous (X.veroneseAnMap ha) :=
  (X.veronese ha).continuous_iff_an.2 fun p =>
    (Berk.continuous_val_apply (X.veroneseAlgHom ha p)).comp continuous_subtype_val

theorem veroneseAnMap_triv : X.veroneseAnMap ha X.triv = (X.veronese ha).triv := by
  classical
  refine Subtype.ext (Berk.ext_val fun p => ?_)
  rw [veroneseAnMap_val]
  by_cases hp : p = 0
  · rw [hp, map_zero, map_zero, map_zero]
  · rw [(X.veronese ha).triv_val_of_ne_zero hp, X.triv_val_of_ne_zero fun h0 =>
      hp (X.veroneseAlgHom_injective ha (h0.trans (map_zero _).symm))]

/-! #### The inverse: extension of points of `𝒳_(a)^an` -/

variable {X ha}

theorem mul_zCoeff_mem_piece {b : Fin r →₀ ℕ} {n : ℕ} (hb : b ≤ n • a) {f : K}
    (hf : f ∈ X.piece b) {γ : X.CoordIndex →₀ ℕ} (hγ : γ ∈ X.monSet (n • a - b)) :
    f * X.zCoeff γ ∈ (X.veronese ha).piece (Finsupp.single 0 n) := by
  rw [mem_veronese_piece_iff]
  have := mul_mem_piece hf (X.zCoeff_mem_piece γ)
  rwa [(X.mem_monSet).1 hγ, add_tsub_cancel_of_le hb] at this

variable (X ha) in
/-- `N_n(b, f) = max_{γ ∈ Mon(n a - b)} |f z̃^γ U^n|_y`. -/
def veroneseNormAux (y : Berk k (X.veronese ha).S) (n : ℕ) (b : Fin r →₀ ℕ) (f : K) : ℝ≥0 :=
  (X.monSet (n • a - b)).sup fun γ =>
    (X.veronese ha).homNorm y (Finsupp.single 0 n) (f * X.zCoeff γ)

/-- `|f g U^{n + m}|_y = |f U^n|_y |g U^m|_y`. -/
theorem homNorm_mul_veronese (y : Berk k (X.veronese ha).S) {n m : ℕ} {f g : K}
    (hf : f ∈ (X.veronese ha).piece (Finsupp.single 0 n))
    (hg : g ∈ (X.veronese ha).piece (Finsupp.single 0 m)) :
    (X.veronese ha).homNorm y (Finsupp.single 0 (n + m)) (f * g) =
      (X.veronese ha).homNorm y (Finsupp.single 0 n) f *
        (X.veronese ha).homNorm y (Finsupp.single 0 m) g := by
  have hfg := mul_mem_piece hf hg
  rw [← Finsupp.single_add] at hfg
  rw [(X.veronese ha).homNorm_of_mem y hfg, (X.veronese ha).homNorm_of_mem y hf,
    (X.veronese ha).homNorm_of_mem y hg, ← map_mul, ← (X.veronese ha).ofPiece_mul]
  exact congrArg y.val ((X.veronese ha).ofPiece_congr _ _ (Finsupp.single_add _ _ _) rfl)

theorem homNorm_veronese_le_one {y : (X.veronese ha).an} {u : Fin 1 →₀ ℕ} (f : K) :
    (X.veronese ha).homNorm y.1 u f ≤ 1 := by
  classical
  by_cases hf : f ∈ (X.veronese ha).piece u
  · rw [(X.veronese ha).homNorm_of_mem y.1 hf]
    exact val_le_one y.2 _
  · rw [homNorm, dif_neg hf]
    exact zero_le

/-- A Segre coordinate with `|z̃^β U|_y = 1`. -/
theorem exists_mem_monSet_homNorm_eq_one (y : (X.veronese ha).an) :
    ∃ β ∈ X.monSet a, (X.veronese ha).homNorm y.1 (Finsupp.single 0 1) (X.zCoeff β) = 1 := by
  obtain ⟨j, hj⟩ : ∃ j : Fin (X.veroneseM a + 1),
      y.1.val ((X.veronese ha).coordElem ⟨0, j⟩) = 1 := y.2.2.exists_val_coordElem_eq_one 0
  refine ⟨(X.monEnum a j).1, (X.monEnum a j).2, ?_⟩
  have h1 : X.zCoeff (X.monEnum a j).1 ∈ (X.veronese ha).piece (Finsupp.single 0 1) :=
    (X.veronese ha).coord_mem_piece 0 j
  rw [(X.veronese ha).homNorm_of_mem y.1 h1]
  exact hj

/-- **Independence of `n`** (as in `lem:gl-sections`(1)): for `b ≤ n a`,
`N_{n + m}(b, f) = N_n(b, f)` at a point `y ∈ 𝒳_(a)^an`. -/
theorem veroneseNormAux_add (y : (X.veronese ha).an) {b : Fin r →₀ ℕ} {n : ℕ} (hb : b ≤ n • a)
    {f : K} (hf : f ∈ X.piece b) (m : ℕ) :
    X.veroneseNormAux ha y.1 (n + m) b f = X.veroneseNormAux ha y.1 n b f := by
  have hdeg : (n + m) • a - b = (n • a - b) + m • a := by
    rw [add_nsmul, tsub_add_eq_add_tsub hb]
  have hz : ∀ {γ : X.CoordIndex →₀ ℕ} {q : ℕ}, γ ∈ X.monSet (q • a) →
      X.zCoeff γ ∈ (X.veronese ha).piece (Finsupp.single 0 q) := fun {γ q} hγ => by
    rw [mem_veronese_piece_iff, ← (X.mem_monSet).1 hγ]
    exact X.zCoeff_mem_piece γ
  refine le_antisymm (Finset.sup_le fun γ hγ => ?_) (Finset.sup_le fun γ₁ hγ₁ => ?_)
  · rw [hdeg] at hγ
    obtain ⟨γ₁, hγ₁, γ₂, hγ₂, rfl⟩ := X.exists_add_of_mem_monSet_add hγ
    have e1 : (X.veronese ha).homNorm y.1 (Finsupp.single 0 (n + m)) (f * X.zCoeff (γ₁ + γ₂)) =
        (X.veronese ha).homNorm y.1 (Finsupp.single 0 n) (f * X.zCoeff γ₁) *
          (X.veronese ha).homNorm y.1 (Finsupp.single 0 m) (X.zCoeff γ₂) := by
      rw [zCoeff_add, ← mul_assoc]
      exact homNorm_mul_veronese y.1 (mul_zCoeff_mem_piece hb hf hγ₁) (hz hγ₂)
    have e2 : (X.veronese ha).homNorm y.1 (Finsupp.single 0 m) (X.zCoeff γ₂) ≤ 1 :=
      homNorm_veronese_le_one _
    have e3 : (X.veronese ha).homNorm y.1 (Finsupp.single 0 n) (f * X.zCoeff γ₁) ≤
        X.veroneseNormAux ha y.1 n b f :=
      Finset.le_sup (f := fun γ =>
        (X.veronese ha).homNorm y.1 (Finsupp.single 0 n) (f * X.zCoeff γ)) hγ₁
    rw [e1]
    exact (mul_le_of_le_one_right zero_le e2).trans e3
  · obtain ⟨β, hβ, hβ1⟩ := exists_mem_monSet_homNorm_eq_one y
    have hmβ : m • β ∈ X.monSet (m • a) := nsmul_mem_monSet hβ m
    have hγ : γ₁ + m • β ∈ X.monSet ((n + m) • a - b) := by
      rw [hdeg]; exact add_mem_monSet hγ₁ hmβ
    have hβm : (X.veronese ha).homNorm y.1 (Finsupp.single 0 m) (X.zCoeff (m • β)) = 1 := by
      have hβ' : β ∈ X.monSet (1 • a) := by rw [one_nsmul]; exact hβ
      have h1 : X.zCoeff β ∈ (X.veronese ha).piece (Finsupp.single 0 1) := hz hβ'
      have h2 := hz hmβ
      rw [(X.veronese ha).homNorm_of_mem y.1 h2]
      rw [(X.veronese ha).homNorm_of_mem y.1 h1] at hβ1
      have e : (X.veronese ha).ofPiece h2 = (X.veronese ha).ofPiece h1 ^ m := by
        rw [← (X.veronese ha).ofPiece_pow]
        exact (X.veronese ha).ofPiece_congr _ _
          (by rw [Finsupp.smul_single, smul_eq_mul, mul_one]) (zCoeff_nsmul β m)
      rw [e, map_pow, hβ1, one_pow]
    have e1 : (X.veronese ha).homNorm y.1 (Finsupp.single 0 (n + m))
        (f * X.zCoeff (γ₁ + m • β)) =
        (X.veronese ha).homNorm y.1 (Finsupp.single 0 n) (f * X.zCoeff γ₁) := by
      rw [zCoeff_add, ← mul_assoc, homNorm_mul_veronese y.1 (mul_zCoeff_mem_piece hb hf hγ₁)
        (hz hmβ), hβm, mul_one]
    rw [← e1]
    exact Finset.le_sup (f := fun γ =>
      (X.veronese ha).homNorm y.1 (Finsupp.single 0 (n + m)) (f * X.zCoeff γ)) hγ

omit [NeZero r] in
theorem le_sum_nsmul (ha : ∀ c, 0 < a c) (b : Fin r →₀ ℕ) : b ≤ (∑ c, b c) • a := by
  intro c
  simp only [Finsupp.smul_apply, smul_eq_mul]
  calc b c ≤ ∑ c, b c := Finset.single_le_sum (f := fun c => b c) (fun _ _ => zero_le)
        (Finset.mem_univ c)
    _ ≤ (∑ c, b c) * a c := Nat.le_mul_of_pos_right _ (ha c)

/-- Independence of `n` for any `n` with `b ≤ n a`. -/
theorem veroneseNormAux_eq (y : (X.veronese ha).an) {b : Fin r →₀ ℕ} {n n' : ℕ} (hb : b ≤ n • a)
    (hb' : b ≤ n' • a) {f : K} (hf : f ∈ X.piece b) :
    X.veroneseNormAux ha y.1 n b f = X.veroneseNormAux ha y.1 n' b f := by
  rcases le_total n n' with h | h
  · obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le h
    exact (veroneseNormAux_add y hb hf m).symm
  · obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le h
    exact veroneseNormAux_add y hb' hf m


variable (X ha) in
/-- `N(b, f) = N_{|b|}(b, f) = max_{γ ∈ Mon(|b| a - b)} |f z̃^γ U^{|b|}|_y`, `|b| = ∑_c b_c`; the
values on homogeneous elements of the point of `𝒳^an` extending `y ∈ 𝒳_(a)^an`. -/
def veroneseNorm (y : Berk k (X.veronese ha).S) (b : Fin r →₀ ℕ) (f : K) : ℝ≥0 :=
  X.veroneseNormAux ha y (∑ c, b c) b f

theorem veroneseNormAux_le_one (y : (X.veronese ha).an) (n : ℕ) (b : Fin r →₀ ℕ) (f : K) :
    X.veroneseNormAux ha y.1 n b f ≤ 1 :=
  Finset.sup_le fun _ _ => homNorm_veronese_le_one _

/-- The value at `T^{n a}`: `N(n a, f) = |f U^n|_y`. -/
theorem veroneseNorm_nsmul (y : (X.veronese ha).an) {n : ℕ} {f : K} (hf : f ∈ X.piece (n • a)) :
    X.veroneseNorm ha y.1 (n • a) f =
      (X.veronese ha).homNorm y.1 (Finsupp.single 0 n) f := by
  rw [veroneseNorm, veroneseNormAux_eq y (le_sum_nsmul ha _) (le_refl (n • a)) hf,
    veroneseNormAux, tsub_self, X.monSet_zero, Finset.sup_singleton, zCoeff_zero, mul_one]

/-- The values `N` satisfy the hypotheses of the multigraded extension lemma
(`lem:gl-multigraded-extension`), as in the proof of `lem:gl-veronese`. -/
theorem isMultigradedNorm_veroneseNorm (y : (X.veronese ha).an) :
    X.IsMultigradedNorm (X.veroneseNorm ha y.1) where
  map_zero b := le_antisymm (Finset.sup_le fun γ _ => by rw [zero_mul, homNorm_apply_zero]) zero_le
  map_algebraMap c hc := by
    rw [veroneseNorm, veroneseNormAux]
    simp only [Finsupp.coe_zero, Pi.zero_apply, Finset.sum_const_zero, zero_smul, tsub_zero,
      X.monSet_zero, Finset.sup_singleton, zCoeff_zero, mul_one, Finsupp.single_zero]
    rw [(X.veronese ha).homNorm_of_mem y.1 ((X.veronese ha).algebraMap_mem_piece_zero c),
      (X.veronese ha).ofPiece_algebraMap, y.1.val_algebraMap c hc]
  map_mul {b b' f g} hf hg := by
    have hn : ∑ c, (b + b') c = ∑ c, b c + ∑ c, b' c := by
      simp only [Finsupp.add_apply, Finset.sum_add_distrib]
    have hb := le_sum_nsmul ha b
    have hb' := le_sum_nsmul ha b'
    have hdeg : (∑ c, b c + ∑ c, b' c) • a - (b + b') =
        ((∑ c, b c) • a - b) + ((∑ c, b' c) • a - b') := by
      rw [add_nsmul, tsub_add_tsub_comm hb hb']
    rw [veroneseNorm, veroneseNorm, veroneseNorm, veroneseNormAux, veroneseNormAux,
      veroneseNormAux, hn, hdeg]
    refine le_antisymm (Finset.sup_le fun γ hγ => ?_) ?_
    · obtain ⟨γ₁, hγ₁, γ₂, hγ₂, rfl⟩ := X.exists_add_of_mem_monSet_add hγ
      have e : f * g * X.zCoeff (γ₁ + γ₂) = (f * X.zCoeff γ₁) * (g * X.zCoeff γ₂) := by
        rw [zCoeff_add]; ring
      rw [e, homNorm_mul_veronese y.1 (mul_zCoeff_mem_piece hb hf hγ₁)
        (mul_zCoeff_mem_piece hb' hg hγ₂)]
      exact mul_le_mul' (Finset.le_sup (f := fun γ => (X.veronese ha).homNorm y.1
        (Finsupp.single 0 (∑ c, b c)) (f * X.zCoeff γ)) hγ₁)
        (Finset.le_sup (f := fun γ => (X.veronese ha).homNorm y.1
          (Finsupp.single 0 (∑ c, b' c)) (g * X.zCoeff γ)) hγ₂)
    · obtain ⟨γ₁, hγ₁, h₁⟩ := Finset.exists_mem_eq_sup _ (X.monSet_nonempty _) fun γ =>
        (X.veronese ha).homNorm y.1 (Finsupp.single 0 (∑ c, b c)) (f * X.zCoeff γ)
      obtain ⟨γ₂, hγ₂, h₂⟩ := Finset.exists_mem_eq_sup _ (X.monSet_nonempty _) fun γ =>
        (X.veronese ha).homNorm y.1 (Finsupp.single 0 (∑ c, b' c)) (g * X.zCoeff γ)
      rw [h₁, h₂, ← homNorm_mul_veronese y.1 (mul_zCoeff_mem_piece hb hf hγ₁)
        (mul_zCoeff_mem_piece hb' hg hγ₂)]
      have e : f * X.zCoeff γ₁ * (g * X.zCoeff γ₂) = f * g * X.zCoeff (γ₁ + γ₂) := by
        rw [zCoeff_add]; ring
      rw [e]
      exact Finset.le_sup (f := fun γ => (X.veronese ha).homNorm y.1
        (Finsupp.single 0 (∑ c, b c + ∑ c, b' c)) (f * g * X.zCoeff γ))
        (add_mem_monSet hγ₁ hγ₂)
  map_add_le {b f g} hf hg := by
    have hb := le_sum_nsmul ha b
    rw [veroneseNorm, veroneseNorm, veroneseNorm, veroneseNormAux, veroneseNormAux,
      veroneseNormAux]
    refine Finset.sup_le fun γ hγ => ?_
    rw [add_mul]
    refine (homNorm_add_le_max y.1 (mul_zCoeff_mem_piece hb hf hγ) (mul_zCoeff_mem_piece hb hg hγ)).trans
      (max_le_max ?_ ?_)
    · exact Finset.le_sup (f := fun γ => (X.veronese ha).homNorm y.1
        (Finsupp.single 0 (∑ c, b c)) (f * X.zCoeff γ)) hγ
    · exact Finset.le_sup (f := fun γ => (X.veronese ha).homNorm y.1
        (Finsupp.single 0 (∑ c, b c)) (g * X.zCoeff γ)) hγ
  sup_coord c := by
    classical
    have h1 : ∑ c', (Finsupp.single c 1 : Fin r →₀ ℕ) c' = 1 := by
      simp [Finsupp.single_apply]
    refine le_antisymm (Finset.sup_le fun j _ => veroneseNormAux_le_one y _ _ _) ?_
    obtain ⟨β, hβ, hβ1⟩ := exists_mem_monSet_homNorm_eq_one y
    have hβa := (X.mem_monSet).1 hβ
    have hsum : ∑ j : Fin (X.M c + 1), β ⟨c, j⟩ ≠ 0 := by
      rw [← monDeg_apply, hβa]; exact (ha c).ne'
    obtain ⟨j, -, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum
    have hle : Finsupp.single (⟨c, j⟩ : X.CoordIndex) 1 ≤ β :=
      Finsupp.single_le_iff.2 (Nat.one_le_iff_ne_zero.2 hj)
    set γ := β - Finsupp.single (⟨c, j⟩ : X.CoordIndex) 1
    have hβγ : β = Finsupp.single ⟨c, j⟩ 1 + γ := (add_tsub_cancel_of_le hle).symm
    have hγ : γ ∈ X.monSet (1 • a - Finsupp.single c 1) := by
      rw [one_nsmul, X.mem_monSet, ← hβa]
      have := X.monDeg_add (Finsupp.single ⟨c, j⟩ 1) γ
      rw [← hβγ, monDeg_single] at this
      rw [this, add_tsub_cancel_left]
    have e : X.coord c j * X.zCoeff γ = X.zCoeff β := by
      rw [hβγ, zCoeff_add, zCoeff_single, pow_one]
    refine le_trans ?_ (Finset.le_sup (f := fun j => X.veroneseNorm ha y.1 (Finsupp.single c 1)
      (X.coord c j)) (Finset.mem_univ j))
    rw [← hβ1, veroneseNorm, veroneseNormAux, h1]
    have := Finset.le_sup (f := fun γ => (X.veronese ha).homNorm y.1
      (Finsupp.single 0 1) (X.coord c j * X.zCoeff γ)) hγ
    rw [e] at this
    exact this

variable (X ha) in
/-- **The inverse of restriction** `𝒳_(a)^an → 𝒳^an`: the multigraded extension of `N`. -/
def veroneseInv (y : (X.veronese ha).an) : X.an :=
  X.ofMultigradedNorm (isMultigradedNorm_veroneseNorm y)

theorem veroneseAnMap_veroneseInv (y : (X.veronese ha).an) :
    X.veroneseAnMap ha (X.veroneseInv ha y) = y := by
  refine Subtype.ext (ext_of_ofPiece (X.veroneseAnMap ha _).2.1 y.2.1 fun u f hf => ?_)
  have hf' := (X.mem_veronese_piece_iff' ha).1 hf
  rw [veroneseAnMap_val_ofPiece, veroneseInv, ofMultigradedNorm_val_ofPiece,
    veroneseNorm_nsmul y hf', (X.veronese ha).homNorm_of_mem y.1 (by
      rw [← fin_one_eq_single u]; exact hf)]
  exact congrArg y.1.val ((X.veronese ha).ofPiece_congr _ _ (fin_one_eq_single u).symm rfl)

theorem veroneseInv_veroneseAnMap (v : X.an) :
    X.veroneseInv ha (X.veroneseAnMap ha v) = v := by
  refine Subtype.ext (ext_of_ofPiece (X.veroneseInv ha _).2.1 v.2.1 fun b f hf => ?_)
  have hb := le_sum_nsmul ha b
  rw [veroneseInv, ofMultigradedNorm_val_ofPiece, veroneseNorm, veroneseNormAux]
  rw [← mul_one (v.1.val (X.ofPiece hf)), ← v.2.2.sup_monSet_val_zMon ((∑ c, b c) • a - b),
    NNReal.mul_finset_sup]
  refine Finset.sup_congr rfl fun γ hγ => ?_
  rw [(X.veronese ha).homNorm_of_mem _ (mul_zCoeff_mem_piece hb hf hγ), veroneseAnMap_val_ofPiece,
    ← map_mul, zMon, ← X.ofPiece_mul]
  refine congrArg v.1.val (X.ofPiece_congr _ _ ?_ rfl)
  rw [Finsupp.single_eq_same, (X.mem_monSet).1 hγ, add_tsub_cancel_of_le hb]

variable (X ha) in
/-- **`lem:gl-veronese`** (points): restriction `v ↦ v ∘ ψ_a` is a homeomorphism
`𝒳^an ≃ₜ 𝒳_(a)^an`, with inverse the multigraded extension `veroneseInv`. -/
def veroneseHomeomorph : X.an ≃ₜ (X.veronese ha).an :=
  @Continuous.homeoOfEquivCompactToT2 _ _ _ _ _ _
    ⟨X.veroneseAnMap ha, X.veroneseInv ha, veroneseInv_veroneseAnMap,
      veroneseAnMap_veroneseInv⟩ (X.continuous_veroneseAnMap ha)

theorem veroneseHomeomorph_apply (v : X.an) : X.veroneseHomeomorph ha v = X.veroneseAnMap ha v :=
  rfl

/-- The homeomorphism preserves `⋆`. -/
theorem veroneseHomeomorph_triv : X.veroneseHomeomorph ha X.triv = (X.veronese ha).triv :=
  X.veroneseAnMap_triv ha

/-- **`𝒳_(a)` is normal if `𝒳` is** (`lem:gl-veronese`): `S_(a) = ψ_a⁻¹(S)`, so an element of
`K[U]` integral over `S_(a)` maps to an element of `K[T]` integral over `S`. -/
theorem isNormal_veronese (hX : X.IsNormal) : (X.veronese ha).IsNormal := by
  rw [isNormal_iff, isIntegrallyClosedIn_iff] at hX ⊢
  refine ⟨Subtype.val_injective, fun {x} hx => ?_⟩
  obtain ⟨P, hPm, hP⟩ := hx
  have hψ : IsIntegral X.S (veroneseHom k a x) := by
    refine ⟨P.map (X.veroneseAlgHom ha : (X.veronese ha).S →+* X.S), hPm.map _, ?_⟩
    rw [Polynomial.eval₂_map]
    have hcomp : (algebraMap X.S (MvPolynomial (Fin r) K)).comp
        (X.veroneseAlgHom ha : (X.veronese ha).S →+* X.S) =
        (veroneseHom k a).toRingHom.comp (algebraMap (X.veronese ha).S (MvPolynomial (Fin 1) K)) :=
      RingHom.ext fun _ => rfl
    have h2 := Polynomial.hom_eval₂ P (algebraMap (X.veronese ha).S (MvPolynomial (Fin 1) K))
      (veroneseHom k a).toRingHom x
    rw [hP, map_zero] at h2
    rw [hcomp]
    exact h2.symm
  obtain ⟨y, hy⟩ := hX.2 hψ
  exact ⟨⟨x, show veroneseHom k a x ∈ X.S from hy ▸ y.2⟩, rfl⟩

end Points

