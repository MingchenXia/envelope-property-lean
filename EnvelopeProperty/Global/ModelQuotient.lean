import EnvelopeProperty.Global.Model

/-!
# Quotient models `V(I) ⊆ ℙ^{M_1} × ⋯ × ℙ^{M_r}`

This file implements part (1) of the blueprint remark `rmk:gl-model-examples` (`global.tex`,
subsection `subsec:gl-model`) for the formalization of Fang–Han–Xia, *The envelope property for
unibranch projective varieties*: the multihomogeneous coordinate ring `R / I` of a subvariety
`X = V(I) ⊆ ℙ^{M_1} × ⋯ × ℙ^{M_r}` is the coordinate ring of an integral multiprojective model
(`EnvelopeProperty.MultiModel`, `def:gl-model`).

Let `R = k[x^{(c)}_j]` (`MvPolynomial (MultiModel.QuotVar M) k`), multigraded by
`deg x^{(c)}_j = e_c` (the weights `MultiModel.quotWeight M`, so that the multihomogeneous
component of degree `a` of `F` is Mathlib's `weightedHomogeneousComponent (quotWeight M) a F`), and
let `I ⊆ R` be a multihomogeneous (`MultiModel.IsMultihomogeneous`) prime ideal that is relevant:
`x^{(c)}_{j₀ c} ∉ I` for a chosen `j₀`.

* `MultiModel.QuotField I j₀ ⊆ Frac(R / I)`: the field of degree-zero fractions, generated over `k`
  by the ratios `x̄^{(c)}_j / x̄^{(c)}_{j₀ c}` (`MultiModel.quotRatio`); it contains every quotient
  `F̄ / Ḡ` of multihomogeneous elements of the same degree (`MultiModel.div_mem_quotField`). The
  model's `K` is the type synonym `MultiModel.QuotFieldTy I j₀` (so that `K[T]` carries only the
  instances coming from `Field K`), embedded in `Frac(R / I)` by `MultiModel.quotFieldEmb`.
* `MultiModel.quotModel I j₀ hj₀: MultiModel k (QuotField I j₀) r`: the model `𝒳_I` with
  `S = k[z] ⊆ K[T]` generated by the coordinates `z^{(c)}_j = (x̄^{(c)}_j / x̄^{(c)}_{j₀ c}) T_c`.
* `MultiModel.quotMap I j₀: R →ₐ[k] K[T]`, `x^{(c)}_j ↦ z^{(c)}_j`, with range `S`
  (`MultiModel.range_quotMap`) and kernel `I` (`MultiModel.ker_quotMap`): a multihomogeneous `F` of
  degree `a` maps to `(F̄ / ∏_c (x̄^{(c)}_{j₀ c})^{a_c}) T^a` (`MultiModel.quotMap_coeff_mul`), and
  components of distinct degrees go to distinct monomials, as in the blueprint.
* `MultiModel.quotModelEquiv: (R / I) ≃ₐ[k] S`, sending `x̄^{(c)}_j` to `z^{(c)}_j`.

The identification with `ProjSubvariety` (`r = 1`) and with the blowup model (`r = 2`) is the
bridge `rmk:gl-bridges` and is not part of this file.

The general fact `EnvelopeProperty.monomial_coeff_mem_adjoin`: a subalgebra of a polynomial ring
generated by monomials contains the homogeneous components (monomials) of its elements.
-/

open scoped NNReal ENNReal Topology

open MvPolynomial

noncomputable section

namespace EnvelopeProperty

universe u

/-! ### Subalgebras generated by monomials are graded -/

/-- A subalgebra of `K[T]` generated by monomials contains the monomials `p_a T^a` of its
elements. -/
theorem monomial_coeff_mem_adjoin {k K σ : Type*} [Field k] [CommRing K] [Algebra k K]
    {s : Set (MvPolynomial σ K)} (hs : ∀ p ∈ s, ∃ (a : σ →₀ ℕ) (f : K), p = monomial a f)
    {p : MvPolynomial σ K} (hp : p ∈ Algebra.adjoin k s) (a : σ →₀ ℕ) :
    monomial a (p.coeff a) ∈ Algebra.adjoin k s := by
  classical
  suffices h : ∀ (q : MvPolynomial σ K), q ∈ Algebra.adjoin k s →
      ∀ a, monomial a (q.coeff a) ∈ Algebra.adjoin k s from h p hp a
  intro q hq
  induction hq using Algebra.adjoin_induction with
  | mem x hx =>
    intro a
    obtain ⟨b, f, rfl⟩ := hs x hx
    rw [coeff_monomial]
    split_ifs with h
    · subst h; exact Algebra.subset_adjoin hx
    · rw [map_zero]; exact Subalgebra.zero_mem _
  | algebraMap c =>
    intro a
    rw [MvPolynomial.algebraMap_apply, coeff_C]
    split_ifs with h
    · subst h
      rw [← C_apply, ← MvPolynomial.algebraMap_apply]
      exact Subalgebra.algebraMap_mem _ c
    · rw [map_zero]; exact Subalgebra.zero_mem _
  | add x y _ _ hx hy =>
    intro a
    rw [coeff_add, map_add]
    exact Subalgebra.add_mem _ (hx a) (hy a)
  | mul x y _ _ hx hy =>
    intro a
    rw [coeff_mul, map_sum]
    refine Subalgebra.sum_mem _ fun z hz => ?_
    rw [← Finset.HasAntidiagonal.mem_antidiagonal.1 hz, ← monomial_mul]
    exact Subalgebra.mul_mem _ (hx _) (hy _)

namespace MultiModel

/-! ### The multigraded polynomial ring `k[x^{(c)}_j]` -/

section QuotientModel

variable {k : Type u} [Field k] {r : ℕ} (M : Fin r → ℕ)

/-- The variables `x^{(c)}_j`, `0 ≤ j ≤ M c`, of `R = k[x^{(c)}_j]`. -/
abbrev QuotVar : Type := Σ c : Fin r, Fin (M c + 1)

/-- The multigrading `deg x^{(c)}_j = e_c ∈ ℕ^r`. -/
def quotWeight : QuotVar M → (Fin r →₀ ℕ) := fun i => Finsupp.single i.1 1

variable {M}

/-- The weighted degree of a monomial `x^β` is `(∑_j β^{(c)}_j)_c`. -/
theorem weight_quotWeight (β : QuotVar M →₀ ℕ) :
    Finsupp.weight (quotWeight M) β = Finsupp.mapDomain Sigma.fst β := by
  rw [Finsupp.weight_apply, Finsupp.mapDomain]
  refine Finsupp.sum_congr fun i _ => ?_
  rw [quotWeight, Finsupp.smul_single, smul_eq_mul, mul_one]

/-- An ideal of `R` is **multihomogeneous** if it contains the multihomogeneous components of its
elements. -/
def IsMultihomogeneous (I : Ideal (MvPolynomial (QuotVar M) k)) : Prop :=
  ∀ F ∈ I, ∀ a, weightedHomogeneousComponent (quotWeight M) a F ∈ I

/-- A polynomial is the (finite) sum of its multihomogeneous components. -/
theorem sum_weightedHomogeneousComponent_quotWeight (F : MvPolynomial (QuotVar M) k) :
    ∑ a ∈ F.support.image (Finsupp.weight (quotWeight M)),
      weightedHomogeneousComponent (quotWeight M) a F = F := by
  classical
  have h := sum_weightedHomogeneousComponent (quotWeight M) F
  rw [finsum_eq_sum_of_support_subset (s := F.support.image (Finsupp.weight (quotWeight M))) _
    fun a ha => ?_] at h
  · exact h
  · by_contra h'
    apply ha
    refine weightedHomogeneousComponent_eq_zero' a F fun d hd hda => h' ?_
    exact Finset.mem_image.2 ⟨d, hd, hda⟩

/-- The relevance hypothesis: `x^{(c)}_{j₀ c} ∉ I` for every `c`. -/
def IsRelevantAt (I : Ideal (MvPolynomial (QuotVar M) k)) (j₀ : (c : Fin r) → Fin (M c + 1)) :
    Prop :=
  ∀ c, (X ⟨c, j₀ c⟩ : MvPolynomial (QuotVar M) k) ∉ I

variable (I : Ideal (MvPolynomial (QuotVar M) k)) [I.IsPrime] (j₀ : (c : Fin r) → Fin (M c + 1))

/-- The image `x̄^{(c)}_j ∈ Frac(R / I)` of a variable. -/
def quotVarImage (i : QuotVar M) : FractionRing (MvPolynomial (QuotVar M) k ⧸ I) :=
  algebraMap (MvPolynomial (QuotVar M) k ⧸ I) _ (Ideal.Quotient.mk I (X i))

/-- The ratio `x̄^{(c)}_j / x̄^{(c)}_{j₀ c} ∈ Frac(R / I)`. -/
def quotRatio (i : QuotVar M) : FractionRing (MvPolynomial (QuotVar M) k ⧸ I) :=
  quotVarImage I i / quotVarImage I ⟨i.1, j₀ i.1⟩

/-- The **field of degree-zero fractions** of `R / I`, generated over `k` by the ratios
`x̄^{(c)}_j / x̄^{(c)}_{j₀ c}`, as an intermediate field of `Frac(R / I)`. -/
def QuotField : IntermediateField k (FractionRing (MvPolynomial (QuotVar M) k ⧸ I)) :=
  IntermediateField.adjoin k (Set.range (quotRatio I j₀))

/-- The function field `K` of the quotient model: a type synonym of `QuotField I j₀`, so that all
algebraic structure on it (and on `K[T]`) comes from its `Field` and `Algebra k` instances. -/
def QuotFieldTy : Type u :=
  QuotField I j₀

instance instFieldQuotFieldTy : Field (QuotFieldTy I j₀) :=
  inferInstanceAs (Field (QuotField I j₀))

instance instAlgebraQuotFieldTy : Algebra k (QuotFieldTy I j₀) :=
  inferInstanceAs (Algebra k (QuotField I j₀))

/-- The embedding `K → Frac(R / I)`. -/
def quotFieldEmb : QuotFieldTy I j₀ →ₐ[k] FractionRing (MvPolynomial (QuotVar M) k ⧸ I) :=
  (QuotField I j₀).val

theorem quotFieldEmb_injective : Function.Injective (quotFieldEmb I j₀) :=
  Subtype.val_injective

theorem quotFieldEmb_mem (x : QuotFieldTy I j₀) : quotFieldEmb I j₀ x ∈ QuotField I j₀ :=
  (show QuotField I j₀ from x).2

/-- The ratio `x̄^{(c)}_j / x̄^{(c)}_{j₀ c}` as an element of `K`. -/
def quotCoord (c : Fin r) (j : Fin (M c + 1)) : QuotFieldTy I j₀ :=
  (⟨quotRatio I j₀ ⟨c, j⟩, IntermediateField.subset_adjoin _ _ ⟨⟨c, j⟩, rfl⟩⟩ : QuotField I j₀)

@[simp]
theorem quotFieldEmb_quotCoord (c : Fin r) (j : Fin (M c + 1)) :
    quotFieldEmb I j₀ (quotCoord I j₀ c j) = quotRatio I j₀ ⟨c, j⟩ :=
  rfl

/-- The coordinate `z^{(c)}_j = (x̄^{(c)}_j / x̄^{(c)}_{j₀ c}) T_c ∈ K[T]`. -/
def quotGen (i : QuotVar M) : MvPolynomial (Fin r) (QuotFieldTy I j₀) :=
  monomial (Finsupp.single i.1 1) (quotCoord I j₀ i.1 i.2)

/-- The coordinate ring `S = k[z] ⊆ K[T]` of the quotient model. -/
def quotS : Subalgebra k (MvPolynomial (Fin r) (QuotFieldTy I j₀)) :=
  Algebra.adjoin k (Set.range (quotGen I j₀))

variable {I}

omit [I.IsPrime] in
theorem quotVarImage_ne_zero [I.IsPrime] {i : QuotVar M} (hi : X i ∉ I) : quotVarImage I i ≠ 0 := by
  rw [quotVarImage, Ne, map_eq_zero_iff _ (IsFractionRing.injective _ _),
    Ideal.Quotient.eq_zero_iff_mem]
  exact hi

theorem quotCoord_self (hj₀ : IsRelevantAt I j₀) (c : Fin r) :
    quotCoord I j₀ c (j₀ c) = 1 := by
  apply quotFieldEmb_injective I j₀
  rw [quotFieldEmb_quotCoord, map_one]
  exact div_self (quotVarImage_ne_zero (hj₀ c))

variable (I)

/-- **`rmk:gl-model-examples`(1), quotient models.** For a relevant prime `I ⊆ k[x^{(c)}_j]`
(with `x^{(c)}_{j₀ c} ∉ I`), the subalgebra `S ⊆ K[T]` generated by the
`z^{(c)}_j = (x̄^{(c)}_j / x̄^{(c)}_{j₀ c}) T_c`, `K` the field of degree-zero fractions of `R / I`,
is a model `𝒳_I`; `S ≅ R / I` by `quotModelEquiv` when `I` is multihomogeneous. -/
def quotModel (hj₀ : IsRelevantAt I j₀) : MultiModel k (QuotFieldTy I j₀) r where
  S := quotS I j₀
  isGraded _ hp a := monomial_coeff_mem_adjoin (fun q hq => by
    obtain ⟨i, rfl⟩ := hq
    exact ⟨_, _, rfl⟩) hp a
  fg := ⟨(Set.finite_range (quotGen I j₀)).toFinset, by
    rw [Set.Finite.coe_toFinset]; rfl⟩
  M := M
  coord := quotCoord I j₀
  coord_mem c j := Algebra.subset_adjoin ⟨⟨c, j⟩, rfl⟩
  exists_coord_ne_zero c := ⟨j₀ c, by rw [quotCoord_self j₀ hj₀]; exact one_ne_zero⟩
  isIntegral p hp := isIntegral_algebraMap (R := quotS I j₀) (x := ⟨p, hp⟩)
  generates := by
    rw [eq_top_iff]
    rintro x -
    set s := {x : QuotFieldTy I j₀ | ∃ (a : Fin r →₀ ℕ) (f g : QuotFieldTy I j₀),
      monomial a f ∈ quotS I j₀ ∧ monomial a g ∈ quotS I j₀ ∧ g ≠ 0 ∧ x = f / g} with hs
    -- `s` contains the generators `x̄^{(c)}_j / x̄^{(c)}_{j₀ c} = z^{(c)}_j / z^{(c)}_{j₀ c}`.
    have hgen : ∀ (c : Fin r) (j : Fin (M c + 1)), quotCoord I j₀ c j ∈ s := fun c j =>
      ⟨Finsupp.single c 1, quotCoord I j₀ c j, quotCoord I j₀ c (j₀ c),
        Algebra.subset_adjoin ⟨⟨c, j⟩, rfl⟩, Algebra.subset_adjoin ⟨⟨c, j₀ c⟩, rfl⟩,
        by rw [quotCoord_self j₀ hj₀]; exact one_ne_zero,
        by rw [quotCoord_self j₀ hj₀, div_one]⟩
    have hle : QuotField I j₀ ≤ (IntermediateField.adjoin k s).map (quotFieldEmb I j₀) := by
      change IntermediateField.adjoin k (Set.range (quotRatio I j₀)) ≤ _
      rw [IntermediateField.adjoin_le_iff]
      rintro _ ⟨i, rfl⟩
      exact (IntermediateField.mem_map _).2 ⟨quotCoord I j₀ i.1 i.2,
        IntermediateField.subset_adjoin _ _ (hgen i.1 i.2), rfl⟩
    obtain ⟨y, hy, hyx⟩ := (IntermediateField.mem_map _).1 (hle (quotFieldEmb_mem I j₀ x))
    rwa [quotFieldEmb_injective I j₀ hyx] at hy

theorem quotModel_S (hj₀ : IsRelevantAt I j₀) : (quotModel I j₀ hj₀).S = quotS I j₀ :=
  rfl

theorem quotModel_coord (hj₀ : IsRelevantAt I j₀) :
    (quotModel I j₀ hj₀).coord = quotCoord I j₀ :=
  rfl

/-! ### The presentation `R / I ≅ S` -/

/-- The map `R → K[T]`, `x^{(c)}_j ↦ z^{(c)}_j`. -/
def quotMap : MvPolynomial (QuotVar M) k →ₐ[k] MvPolynomial (Fin r) (QuotFieldTy I j₀) :=
  aeval (quotGen I j₀)

theorem quotMap_X (i : QuotVar M) : quotMap I j₀ (X i) = quotGen I j₀ i :=
  aeval_X _ _

theorem range_quotMap : (quotMap I j₀).range = quotS I j₀ :=
  (Algebra.adjoin_range_eq_range_aeval k (quotGen I j₀)).symm

/-- The coefficient `∏ (x̄^{(c)}_j / x̄^{(c)}_{j₀ c})^{β^{(c)}_j} ∈ K` of the image of `x^β`. -/
def quotZ (β : QuotVar M →₀ ℕ) : QuotFieldTy I j₀ :=
  β.prod fun i n => quotCoord I j₀ i.1 i.2 ^ n

theorem quotZ_add (β γ : QuotVar M →₀ ℕ) : quotZ I j₀ (β + γ) = quotZ I j₀ β * quotZ I j₀ γ :=
  Finsupp.prod_add_index' (fun _ => pow_zero _) fun _ _ _ => pow_add _ _ _

theorem quotZ_single (i : QuotVar M) (n : ℕ) :
    quotZ I j₀ (Finsupp.single i n) = quotCoord I j₀ i.1 i.2 ^ n :=
  Finsupp.prod_single_index (pow_zero _)

/-- `∏ (z^{(c)}_j)^{β^{(c)}_j} = (∏ (x̄^{(c)}_j / x̄^{(c)}_{j₀ c})^{β^{(c)}_j}) T^{deg β}`. -/
theorem prod_quotGen_pow (β : QuotVar M →₀ ℕ) :
    (β.prod fun i n => quotGen I j₀ i ^ n) =
      monomial (Finsupp.mapDomain Sigma.fst β) (quotZ I j₀ β) := by
  induction β using Finsupp.induction with
  | zero => simp [quotZ, ← C_apply]
  | single_add i n β hi hn ih =>
    rw [Finsupp.prod_add_index' (fun _ => pow_zero _) fun _ _ _ => pow_add _ _ _, ih,
      Finsupp.prod_single_index (h := fun i n => quotGen I j₀ i ^ n) (pow_zero _), quotZ_add,
      quotZ_single, Finsupp.mapDomain_add, Finsupp.mapDomain_single, quotGen, monomial_pow,
      monomial_mul, Finsupp.smul_single, smul_eq_mul, mul_one]

/-- The image of a monomial:
`c x^β ↦ (c ∏ (x̄^{(c)}_j / x̄^{(c)}_{j₀ c})^{β^{(c)}_j}) T^{deg β}`. -/
theorem quotMap_monomial (β : QuotVar M →₀ ℕ) (c : k) :
    quotMap I j₀ (monomial β c) = monomial (Finsupp.mapDomain Sigma.fst β)
      (algebraMap k (QuotFieldTy I j₀) c * quotZ I j₀ β) := by
  rw [quotMap, aeval_monomial, prod_quotGen_pow, MvPolynomial.algebraMap_apply, C_mul_monomial]

/-- The coefficients of the image of `F`. -/
theorem coeff_quotMap (F : MvPolynomial (QuotVar M) k) (a : Fin r →₀ ℕ) :
    (quotMap I j₀ F).coeff a = ∑ β ∈ F.support with Finsupp.mapDomain Sigma.fst β = a,
      algebraMap k (QuotFieldTy I j₀) (F.coeff β) * quotZ I j₀ β := by
  classical
  conv_lhs => rw [F.as_sum, map_sum]
  rw [coeff_sum, Finset.sum_filter]
  refine Finset.sum_congr rfl fun β _ => ?_
  rw [quotMap_monomial, coeff_monomial]

/-- The denominators `∏_c (x̄^{(c)}_{j₀ c})^{a_c}`. -/
def quotDen (a : Fin r →₀ ℕ) : FractionRing (MvPolynomial (QuotVar M) k ⧸ I) :=
  a.prod fun c n => quotVarImage I ⟨c, j₀ c⟩ ^ n

variable {I j₀}

theorem quotDen_ne_zero (hj₀ : IsRelevantAt I j₀) (a : Fin r →₀ ℕ) : quotDen I j₀ a ≠ 0 :=
  Finset.prod_ne_zero_iff.2 fun c _ => pow_ne_zero _ (quotVarImage_ne_zero (hj₀ c))

variable (I j₀) in
/-- The image of `quotZ β` in `Frac(R / I)` is `x̄^β / ∏_c (x̄^{(c)}_{j₀ c})^{(deg β)_c}`. -/
theorem quotFieldEmb_quotZ (β : QuotVar M →₀ ℕ) :
    quotFieldEmb I j₀ (quotZ I j₀ β) =
      algebraMap (MvPolynomial (QuotVar M) k ⧸ I) _ (Ideal.Quotient.mk I (monomial β 1)) /
        quotDen I j₀ (Finsupp.mapDomain Sigma.fst β) := by
  rw [quotZ, quotDen, Finsupp.prod_mapDomain_index (fun _ => pow_zero _)
    fun _ _ _ => pow_add _ _ _, monomial_eq, C_1, one_mul, map_finsuppProd, map_finsuppProd,
    map_finsuppProd, Finsupp.prod, Finsupp.prod, Finsupp.prod, ← Finset.prod_div_distrib]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [map_pow, map_pow, map_pow, ← div_pow, quotFieldEmb_quotCoord]
  rfl

/-- **Degrees in the quotient model.** For every `F` and every degree `a`, the coefficient of
`T^a` in the image of `F` is `F̄_a / ∏_c (x̄^{(c)}_{j₀ c})^{a_c}`, where `F_a` is the
multihomogeneous component of degree `a` of `F`. -/
theorem quotMap_coeff_mul (hj₀ : IsRelevantAt I j₀) (F : MvPolynomial (QuotVar M) k)
    (a : Fin r →₀ ℕ) :
    quotFieldEmb I j₀ ((quotMap I j₀ F).coeff a) * quotDen I j₀ a =
      algebraMap (MvPolynomial (QuotVar M) k ⧸ I) _
        (Ideal.Quotient.mk I (weightedHomogeneousComponent (quotWeight M) a F)) := by
  classical
  rw [coeff_quotMap, weightedHomogeneousComponent_apply, map_sum, map_sum, map_sum,
    Finset.sum_mul]
  simp_rw [weight_quotWeight]
  refine Finset.sum_congr rfl fun β hβ => ?_
  have hβa := (Finset.mem_filter.1 hβ).2
  rw [map_mul, quotFieldEmb_quotZ, hβa, AlgHom.commutes, mul_assoc,
    div_mul_cancel₀ _ (quotDen_ne_zero hj₀ a),
    show monomial β (F.coeff β) = algebraMap k _ (F.coeff β) * monomial β 1 by
      rw [MvPolynomial.algebraMap_eq, C_mul_monomial, mul_one],
    map_mul, map_mul, Ideal.Quotient.mk_algebraMap, ← IsScalarTower.algebraMap_apply]

/-- `K` is the field of degree-zero fractions: for multihomogeneous `F, G` of the same degree `a`,
`F̄ / Ḡ ∈ K`. -/
theorem div_mem_quotField (hj₀ : IsRelevantAt I j₀) {a : Fin r →₀ ℕ}
    {F G : MvPolynomial (QuotVar M) k} (hF : F.IsWeightedHomogeneous (quotWeight M) a)
    (hG : G.IsWeightedHomogeneous (quotWeight M) a) :
    algebraMap (MvPolynomial (QuotVar M) k ⧸ I) _ (Ideal.Quotient.mk I F) /
      algebraMap (MvPolynomial (QuotVar M) k ⧸ I) _ (Ideal.Quotient.mk I G) ∈ QuotField I j₀ := by
  rw [← weightedHomogeneousComponent_eq_self hF, ← weightedHomogeneousComponent_eq_self hG,
    ← quotMap_coeff_mul hj₀, ← quotMap_coeff_mul hj₀,
    mul_div_mul_right _ _ (quotDen_ne_zero hj₀ a), ← map_div₀]
  exact quotFieldEmb_mem I j₀ _

/-- **The kernel of `R → K[T]` is `I`** (`rmk:gl-model-examples`(1)), for `I` multihomogeneous. -/
theorem ker_quotMap (hj₀ : IsRelevantAt I j₀) (hI : IsMultihomogeneous I) :
    RingHom.ker (quotMap I j₀) = I := by
  ext F
  rw [RingHom.mem_ker]
  have hcomp : ∀ a, (quotMap I j₀ F).coeff a = 0 ↔
      weightedHomogeneousComponent (quotWeight M) a F ∈ I := by
    intro a
    rw [← Ideal.Quotient.eq_zero_iff_mem,
      ← map_eq_zero_iff (algebraMap (MvPolynomial (QuotVar M) k ⧸ I)
        (FractionRing (MvPolynomial (QuotVar M) k ⧸ I))) (IsFractionRing.injective _ _),
      ← quotMap_coeff_mul hj₀, mul_eq_zero, or_iff_left (quotDen_ne_zero hj₀ a),
      map_eq_zero_iff _ (quotFieldEmb_injective I j₀)]
  constructor
  · intro h
    rw [← sum_weightedHomogeneousComponent_quotWeight F]
    exact Ideal.sum_mem _ fun a _ => (hcomp a).1 (by rw [h, coeff_zero])
  · intro h
    ext a
    rw [coeff_zero]
    exact (hcomp a).2 (hI F h a)

variable (I j₀) in
/-- **`rmk:gl-model-examples`(1).** The presentation `R / I ≅ S` of the coordinate ring of the
quotient model, `x̄^{(c)}_j ↦ z^{(c)}_j`. -/
def quotModelEquiv (hj₀ : IsRelevantAt I j₀) (hI : IsMultihomogeneous I) :
    (MvPolynomial (QuotVar M) k ⧸ I) ≃ₐ[k] (quotModel I j₀ hj₀).S :=
  ((Ideal.quotientEquivAlgOfEq k (ker_quotMap hj₀ hI).symm).trans
    (Ideal.quotientKerEquivRange (quotMap I j₀))).trans
    (Subalgebra.equivOfEq _ _ (range_quotMap I j₀))

theorem quotModelEquiv_mk (hj₀ : IsRelevantAt I j₀) (hI : IsMultihomogeneous I)
    (F : MvPolynomial (QuotVar M) k) :
    (quotModelEquiv I j₀ hj₀ hI (Ideal.Quotient.mk I F) :
      MvPolynomial (Fin r) (QuotFieldTy I j₀)) = quotMap I j₀ F :=
  rfl

theorem quotModelEquiv_mk_X (hj₀ : IsRelevantAt I j₀) (hI : IsMultihomogeneous I)
    (i : QuotVar M) :
    quotModelEquiv I j₀ hj₀ hI (Ideal.Quotient.mk I (X i)) = (quotModel I j₀ hj₀).coordElem i :=
  Subtype.ext (by rw [quotModelEquiv_mk, quotMap_X]; rfl)

end QuotientModel

end MultiModel

end EnvelopeProperty
