/-!
# The cotangent space at a smooth point

This file proves the bound on the embedding dimension used in the affine proof of Fang–Han–Xia,
*The envelope property for unibranch projective varieties*, Lemma 5.23
(`lem:projection-existence`): if `Z = Spec R₀` is smooth at a closed point `z` and `R₀` is integral
over `k[x₁, …, xₘ]` (so `dim Z ≤ m`), then `z / z²` is spanned by `m` elements
(`exists_le_span_sup_sq`). In the proof of Lemma 5.23 this is applied with `m = n - 1`, `n = dim Y`,
to the ring of the proper closed subset `Z ⊊ Y`; it is the only place where the smoothness of `Z`
at `z` is used, and it is where FHX's "general linear projection restricts to a closed immersion
near `z`" needs `dim_z Z < n`.

## Proof

* `finrank_cotangentSpace_le_finrank_kaehler`: for a noetherian local `k`-algebra `R` with residue
  field `k`, the conormal map `𝔪/𝔪² → k ⊗ Ω[R⁄k]` has a retraction
  (`retractionKerCotangentToTensorEquivSection`: `R / 𝔪² → k` has the section `k → R / 𝔪²`), so
  `dim 𝔪/𝔪² ≤ rank Ω[R⁄k]` if `Ω[R⁄k]` is free.
* `finrank_kaehler_localization_le`: if `Ω[R⁄k]`, `R = (R₀)_z`, is free (as it is when `R` is
  formally smooth over `k`), its rank is the dimension of `Ω[K⁄k]` for `K = R_P`, `P` a minimal
  prime (a field, as `R₀` is reduced); `K` is algebraic over `k(x₁, …, xₘ)`, so
  `exists_finset_span_D_eq_top` (a separating transcendence basis, `k` perfect,
  `exists_isTranscendenceBasis_and_isSeparable_of_perfectField`) bounds it by `m`.
* `IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace` turns this into `≤ m`
  generators of the maximal ideal of `R`, whose numerators span `z` modulo `z²`.

`exists_finset_span_D_eq_top` and `finiteDimensional_and_finrank_le` (differentials of a field
finitely generated over a perfect field are spanned by `trdeg` many differentials) are also used for
generic étaleness in `EnvelopeProperty.AlgGeom.ProjectionSeparable`.
-/

open scoped TensorProduct

namespace EnvelopeProperty

open KaehlerDifferential

/-- If `K` is a separable algebraic extension of the intermediate field generated by `s`, the
differentials `d s` span `Ω[K⁄k]`. -/
theorem span_D_eq_top_of_isSeparable (k K : Type*) [Field k] [Field K] [Algebra k K] (s : Set K)
    [Algebra.IsSeparable (IntermediateField.adjoin k s) K] :
    Submodule.span K (D k K '' s) = ⊤ := by
  set V := Submodule.span K (D k K '' s)
  set F := IntermediateField.adjoin k s
  -- the elements whose differential lies in `V` form an intermediate field containing `s`
  let E : IntermediateField k K :=
    { carrier := {x | D k K x ∈ V}
      mul_mem' := fun {a b} (ha : D k K a ∈ V) (hb : D k K b ∈ V) =>
        show D k K (a * b) ∈ V by
          rw [Derivation.leibniz]; exact V.add_mem (V.smul_mem _ hb) (V.smul_mem _ ha)
      add_mem' := fun {a b} (ha : D k K a ∈ V) (hb : D k K b ∈ V) =>
        show D k K (a + b) ∈ V by rw [map_add]; exact V.add_mem ha hb
      algebraMap_mem' := fun c => show D k K (algebraMap k K c) ∈ V by
        rw [Derivation.map_algebraMap]; exact V.zero_mem
      inv_mem' := fun a (ha : D k K a ∈ V) => show D k K a⁻¹ ∈ V by
        rw [Derivation.leibniz_inv]; exact V.smul_mem _ ha }
  have hFE : F ≤ E := IntermediateField.adjoin_le_iff.mpr fun x hx =>
    Submodule.subset_span ⟨x, hx, rfl⟩
  -- `Ω[K⁄F] = 0`, so `Ω[K⁄k]` is spanned by the differentials of elements of `F`
  have : Algebra.FormallyUnramified F K := Algebra.FormallyUnramified.of_isSeparable F K
  rw [eq_top_iff]
  intro ω hω0
  clear hω0
  have hω : KaehlerDifferential.map k F K K ω = 0 := Subsingleton.elim _ _
  obtain ⟨τ, rfl⟩ := (exact_mapBaseChange_map k F K ω).mp hω
  clear hω
  induction τ using TensorProduct.induction_on with
  | zero => simp
  | tmul a η =>
    rw [mapBaseChange_tmul]
    refine V.smul_mem a ?_
    have hspan := KaehlerDifferential.span_range_derivation k F
    have : η ∈ Submodule.span F (Set.range (D k F)) := hspan ▸ Submodule.mem_top
    induction this using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨y, rfl⟩ := hx
      rw [map_D]
      exact hFE y.2
    | zero => simp
    | add x y _ _ hx hy => rw [map_add]; exact V.add_mem hx hy
    | smul c x _ hx =>
      rw [map_smul, algebra_compatible_smul K c]
      exact V.smul_mem _ hx
  | add x y hx hy => rw [map_add]; exact V.add_mem hx hy

/-- **Differentials of a field finitely generated over a perfect field** (via a separating
transcendence basis). If `K` is essentially of finite type over the perfect field `k` and algebraic
over `k[x₁, …, xₘ]`, then `Ω[K⁄k]` is spanned by at most `m` differentials. -/
theorem exists_finset_span_D_eq_top (k K : Type*) [Field k] [PerfectField k] [Field K]
    [Algebra k K] [Algebra.EssFiniteType k K] {m : ℕ} (x : Fin m → K)
    [Algebra.IsAlgebraic (Algebra.adjoin k (Set.range x)) K] :
    ∃ s : Finset K, s.card ≤ m ∧ Submodule.span K (D k K '' (s : Set K)) = ⊤ := by
  obtain ⟨s, hs, hsep⟩ := exists_isTranscendenceBasis_and_isSeparable_of_perfectField k K
  refine ⟨s, ?_, span_D_eq_top_of_isSeparable k K _⟩
  have h1 := hs.cardinalMk_eq_trdeg
  have h2 := Algebra.IsAlgebraic.trdeg_le_cardinalMk k (Set.range x)
  have h3 : Cardinal.mk (Set.range x) ≤ m := by
    classical
    have : Set.range x = ↑(Finset.univ.image x) := by simp
    rw [this, Finset.coe_sort_coe, Cardinal.mk_coe_finset]
    exact_mod_cast (Finset.card_image_le).trans (by simp)
  have h4 : (s.card : Cardinal) ≤ m := by
    rw [← Cardinal.mk_coe_finset, h1]; exact h2.trans h3
  exact_mod_cast h4

/-- Under the hypotheses of `exists_finset_span_D_eq_top`, `Ω[K⁄k]` is finite dimensional of
dimension at most `m`. -/
theorem finiteDimensional_and_finrank_le (k K : Type*) [Field k] [PerfectField k] [Field K]
    [Algebra k K] [Algebra.EssFiniteType k K] {m : ℕ} (x : Fin m → K)
    [Algebra.IsAlgebraic (Algebra.adjoin k (Set.range x)) K] :
    FiniteDimensional K Ω[K⁄k] ∧ Module.finrank K Ω[K⁄k] ≤ m := by
  obtain ⟨s, hs, hspan⟩ := exists_finset_span_D_eq_top k K x
  have hfin : (D k K '' (s : Set K)).Finite := s.finite_toSet.image _
  have : FiniteDimensional K Ω[K⁄k] := ⟨by rw [← hspan]; exact Submodule.fg_span hfin⟩
  refine ⟨this, ?_⟩
  classical
  have hspan' : Submodule.span K ((s.image (D k K) : Finset Ω[K⁄k]) : Set Ω[K⁄k]) = ⊤ := by
    rw [Finset.coe_image]; exact hspan
  rw [← finrank_top, ← hspan']
  exact (finrank_span_finset_le_card _).trans (Finset.card_image_le.trans hs)


section cotangent

open IsLocalRing

/-- **The cotangent space at a rational point injects into the differentials.** For a noetherian
local `k`-algebra `R` with residue field `k`, `𝔪/𝔪² → κ ⊗ Ω[R⁄k]` is injective (it has a retraction,
`R / 𝔪² → κ` having the section `κ = k → R / 𝔪²`). Hence `dim 𝔪/𝔪² ≤ rank Ω[R⁄k]` when `Ω[R⁄k]` is
free of finite rank. -/
theorem finrank_cotangentSpace_le_finrank_kaehler (k R : Type*) [Field k] [CommRing R]
    [Algebra k R] [IsLocalRing R] [IsNoetherianRing R]
    (hk : Function.Bijective (algebraMap k (ResidueField R))) [Module.Finite R Ω[R⁄k]]
    [Module.Free R Ω[R⁄k]] :
    Module.finrank (ResidueField R) (CotangentSpace R) ≤ Module.finrank R Ω[R⁄k] := by
  have hsurj : Function.Surjective (algebraMap R (ResidueField R)) :=
    IsLocalRing.residue_surjective
  -- the section `κ = k → R / 𝔪²` of `R / 𝔪² → κ`
  let g : ResidueField R →ₐ[k] R ⧸ RingHom.ker (algebraMap R (ResidueField R)) ^ 2 :=
    (Algebra.ofId k _).comp
      (AlgEquiv.ofBijective (Algebra.ofId k (ResidueField R)) hk).symm.toAlgHom
  have hg : (IsScalarTower.toAlgHom k R (ResidueField R)).kerSquareLift.comp g =
      AlgHom.id k (ResidueField R) := by
    ext x
    obtain ⟨c, rfl⟩ := hk.2 x
    exact (AlgHom.commutes _ c).trans (AlgHom.commutes _ c).symm
  obtain ⟨l, hl⟩ := (retractionKerCotangentToTensorEquivSection (R := k) hsurj).symm ⟨g, hg⟩
  have hinj : Function.Injective (kerCotangentToTensor k R (ResidueField R)) := fun a b hab => by
    have := congrArg l hab
    rwa [← LinearMap.comp_apply, hl, ← LinearMap.comp_apply, hl] at this
  have hex : ∃ φ : (RingHom.ker (algebraMap R (ResidueField R))).Cotangent →ₗ[R]
      ResidueField R ⊗[R] Ω[R⁄k], Function.Injective φ := ⟨_, hinj⟩
  generalize hI : RingHom.ker (algebraMap R (ResidueField R)) = I at hex
  have hI' : I = maximalIdeal R := hI ▸ Ideal.mk_ker
  subst hI'
  obtain ⟨φ, hφ⟩ := hex
  have h2 : Module.finrank (ResidueField R) (CotangentSpace R) ≤
      Module.finrank (ResidueField R) (ResidueField R ⊗[R] Ω[R⁄k]) :=
    LinearMap.finrank_le_finrank_of_injective (f := LinearMap.extendScalarsOfSurjective hsurj φ) hφ
  rwa [Module.finrank_baseChange] at h2

/-- **The rank of the differentials at a point is at most the dimension.** Let `R₀` be a reduced
algebra of finite type over a perfect field `k`, integral over `k[x₁, …, xₘ]`, and `z` a prime of
`R₀` such that `Ω[R⁄k]` is free over `R = (R₀)_z`. Then its rank is at most `m`: at a minimal prime
`P` of `R`, `R_P = K` is a field (`R` is reduced), algebraic over `k(x₁, …, xₘ)`, and
`K ⊗ Ω[R⁄k] = Ω[K⁄k]` is spanned by at most `m` differentials
(`finiteDimensional_and_finrank_le`). -/
theorem finrank_kaehler_localization_le (k : Type*) [Field k] [PerfectField k] {R₀ : Type*}
    [CommRing R₀] [Algebra k R₀] [Algebra.FiniteType k R₀] [IsReduced R₀] (z : Ideal R₀)
    [z.IsPrime] [Module.Free (Localization.AtPrime z) Ω[Localization.AtPrime z⁄k]] {m : ℕ}
    (x : Fin m → R₀) (hx : ∀ r : R₀, IsIntegral (Algebra.adjoin k (Set.range x)) r) :
    Module.finrank (Localization.AtPrime z) Ω[Localization.AtPrime z⁄k] ≤ m := by
  let R := Localization.AtPrime z
  obtain ⟨P, hP, -⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ maximalIdeal R)
  have : P.IsPrime := hP.1.1
  let K := Localization.AtPrime P
  let := (isField_localization_atPrime_of_mem_minimalPrimes P hP).toField
  have : Algebra.FormallyEtale R K := Algebra.FormallyEtale.of_isLocalization P.primeCompl
  have hr : Module.finrank K Ω[K⁄k] = Module.finrank R Ω[R⁄k] := by
    rw [← (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k R K).finrank_eq,
      Module.finrank_baseChange]
  have : Algebra.EssFiniteType R₀ R := .of_isLocalization R z.primeCompl
  have : Algebra.EssFiniteType R K := .of_isLocalization K P.primeCompl
  have : Algebra.EssFiniteType k K := .comp k R K
  let x' : Fin m → K := fun i => algebraMap R₀ K (x i)
  set F := Algebra.adjoin k (Set.range x')
  -- images of elements of `R₀` are algebraic over `F`
  have hmem : ∀ y ∈ Algebra.adjoin k (Set.range x), algebraMap R₀ K y ∈ F := fun y hy => by
    have : (Algebra.adjoin k (Set.range x)).map (IsScalarTower.toAlgHom k R₀ K) = F := by
      rw [AlgHom.map_adjoin, ← Set.range_comp]; rfl
    rw [← this]; exact Subalgebra.mem_map.mpr ⟨y, hy, rfl⟩
  let φ : Algebra.adjoin k (Set.range x) →+* F :=
    ((algebraMap R₀ K).comp (algebraMap (Algebra.adjoin k (Set.range x)) R₀)).codRestrict F
      (fun y => hmem y y.2)
  have hint : ∀ a : R₀, IsAlgebraic F (algebraMap R₀ K a) := fun a =>
    (IsIntegral.map_of_comp_eq φ (algebraMap R₀ K) (RingHom.ext fun _ => rfl) (hx a)).isAlgebraic
  have hdiv : ∀ {q p w : K}, w ≠ 0 → q * w = p → IsAlgebraic F p → IsAlgebraic F w →
      IsAlgebraic F q := fun {q p w} hw h hp hw' => by
    rw [show q = p * w⁻¹ by rw [← h, mul_assoc, mul_inv_cancel₀ hw, mul_one]]
    exact hp.mul hw'.inv
  have hR : ∀ r : R, IsAlgebraic F (algebraMap R K r) := fun r => by
    obtain ⟨⟨a, v⟩, rfl⟩ := IsLocalization.mk'_surjective z.primeCompl r
    have hv : IsUnit (algebraMap R₀ K v) := by
      rw [IsScalarTower.algebraMap_apply R₀ R K]
      exact (IsLocalization.map_units R v).map _
    refine hdiv hv.ne_zero ?_ (hint a) (hint v)
    rw [IsScalarTower.algebraMap_apply R₀ R K v, ← map_mul, IsLocalization.mk'_spec,
      ← IsScalarTower.algebraMap_apply]
  have halg : Algebra.IsAlgebraic F K := ⟨fun q => by
    obtain ⟨⟨r, u⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl q
    have hu : IsUnit (algebraMap R K u) := IsLocalization.map_units K u
    exact hdiv hu.ne_zero (IsLocalization.mk'_spec K r u) (hR r) (hR u)⟩
  rw [← hr]
  exact (finiteDimensional_and_finrank_le k K x').2

/-- **A smooth point has embedding dimension at most the dimension** (in the form used for FHX
Lemma 5.23). Let `R₀` be a reduced algebra of finite type over the algebraically closed field `k`,
integral over `k[x₁, …, xₘ]`, and `z` a maximal ideal at which `R₀` is smooth over `k`. Then there
are `b₁, …, bₘ ∈ z` spanning `z` modulo `z²`.

Proof: `Ω[R⁄k]` is free over `R = (R₀)_z` (formal smoothness), of rank `≤ m`
(`finrank_kaehler_localization_le`); the cotangent space of `R` injects into `κ ⊗ Ω[R⁄k]`
(`finrank_cotangentSpace_le_finrank_kaehler`, `κ = k` by the Nullstellensatz), so the maximal ideal
of `R` is generated by `≤ m` elements; their numerators span `z` modulo `z²`. -/
theorem exists_le_span_sup_sq (k : Type*) [Field k] [IsAlgClosed k] {R₀ : Type*} [CommRing R₀]
    [Algebra k R₀] [Algebra.FiniteType k R₀] [IsReduced R₀] (z : Ideal R₀) [z.IsMaximal]
    (hz : Algebra.IsSmoothAt k z) {m : ℕ} (x : Fin m → R₀)
    (hx : ∀ r : R₀, IsIntegral (Algebra.adjoin k (Set.range x)) r) :
    ∃ b : Fin m → R₀, (∀ i, b i ∈ z) ∧ z ≤ Ideal.span (Set.range b) ⊔ z ^ 2 := by
  classical
  let R := Localization.AtPrime z
  have : IsNoetherianRing R₀ := Algebra.FiniteType.isNoetherianRing k R₀
  have : IsNoetherianRing R := IsLocalization.isNoetherianRing z.primeCompl R inferInstance
  have : Algebra.EssFiniteType R₀ R := .of_isLocalization R z.primeCompl
  have : Algebra.EssFiniteType k R := .comp k R₀ R
  have : Module.Free R Ω[R⁄k] := Module.free_of_flat_of_isLocalRing
  -- the residue field of `R` is `k`
  have hres : Function.Bijective (algebraMap k (ResidueField R)) := by
    have h := bijective_algebraMap_quotient_of_isMaximal k z
    let e := IsLocalization.AtPrime.equivQuotMaximalIdeal z R
    have he : ⇑(algebraMap k (ResidueField R)) = ⇑e ∘ ⇑(algebraMap k (R₀ ⧸ z)) := by
      funext c
      simp only [Function.comp_apply, e, ← Ideal.Quotient.mk_algebraMap,
        IsLocalization.AtPrime.equivQuotMaximalIdeal_apply_mk]
      rw [← IsScalarTower.algebraMap_apply]
      rfl
    rw [he]; exact e.bijective.comp h
  have h1 := finrank_cotangentSpace_le_finrank_kaehler k R hres
  have h2 : Module.finrank R Ω[R⁄k] ≤ m := finrank_kaehler_localization_le k z x hx
  have h3 : (maximalIdeal R).spanFinrank ≤ m := by
    rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]; omega
  obtain ⟨G, hGcard, hGspan⟩ :=
    (IsNoetherian.noetherian (maximalIdeal R)).exists_span_set_encard_eq_spanFinrank
  have hGfin : G.Finite := Set.finite_of_encard_eq_coe hGcard
  set L := hGfin.toFinset
  have hL : L.card ≤ m := by
    have := hGfin.encard_eq_coe_toFinset_card
    rw [hGcard] at this
    have h4 : (maximalIdeal R).spanFinrank = L.card := by exact_mod_cast this
    omega
  -- numerators of the generators
  have hnum : ∀ g ∈ G, ∃ a ∈ z, ∃ s : z.primeCompl, IsLocalization.mk' R a s = g := by
    intro g hg
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective z.primeCompl g
    refine ⟨a, ?_, s, rfl⟩
    have hg' : IsLocalization.mk' R a s ∈ maximalIdeal R := hGspan ▸ Submodule.subset_span hg
    exact (IsLocalization.AtPrime.mk'_mem_maximal_iff R z a s).mp hg'
  choose! num hnumz den hden using hnum
  let e := L.equivFin
  let b : Fin m → R₀ := fun i => if h : i.val < L.card then num (e.symm ⟨i, h⟩) else 0
  refine ⟨b, fun i => ?_, ?_⟩
  · simp only [b]
    split_ifs with h
    · exact hnumz _ (hGfin.mem_toFinset.mp (e.symm ⟨i, h⟩).2)
    · exact z.zero_mem
  have hmax : maximalIdeal R ≤ (Ideal.span (Set.range b)).map (algebraMap R₀ R) := by
    rw [← hGspan, Submodule.span_le]
    intro g hg
    have hgL : g ∈ L := hGfin.mem_toFinset.mpr hg
    set i := e ⟨g, hgL⟩
    have hi : i.val < L.card := i.2
    have hb : b ⟨i.val, by omega⟩ = num g := by
      simp only [b, dif_pos hi]
      congr
      simp [i]
    rw [SetLike.mem_coe, ← hden g hg, IsLocalization.mk'_eq_mul_mk'_one]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨_, hb⟩))
  intro y hyz
  have hy' : algebraMap R₀ R y ∈ (Ideal.span (Set.range b)).map (algebraMap R₀ R) :=
    hmax ((IsLocalization.AtPrime.to_map_mem_maximal_iff R z y).mpr hyz)
  obtain ⟨⟨j, s⟩, hjs⟩ := (IsLocalization.mem_map_algebraMap_iff z.primeCompl R).mp hy'
  obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists z.primeCompl R).mp
    (show algebraMap R₀ R (y * s) = algebraMap R₀ R j by rw [map_mul]; exact hjs)
  set J := Ideal.span (Set.range b) ⊔ z ^ 2
  have hus : (c * s : R₀) ∉ z := (z.primeCompl.mul_mem c.2 s.2)
  have hux : (c * s : R₀) * y ∈ J := by
    rw [show (c * s : R₀) * y = c * (y * s) by ring, hc]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_sup_left j.2)
  obtain ⟨α, w, hw, hαw⟩ := Ideal.IsMaximal.exists_inv inferInstance hus
  have : y = α * ((c * s : R₀) * y) + w * y := by
    rw [← mul_assoc, ← add_mul, hαw, one_mul]
  rw [this]
  refine J.add_mem (J.mul_mem_left _ hux) (Ideal.mem_sup_right ?_)
  rw [sq]; exact Ideal.mul_mem_mul hw hyz

end cotangent

end EnvelopeProperty
