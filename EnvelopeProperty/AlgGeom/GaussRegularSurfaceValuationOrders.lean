import EnvelopeProperty.AlgGeom.GaussRegularSurfaceValuations
import Mathlib.RingTheory.LocalRing.Quotient
import Mathlib.RingTheory.Noetherian.UniqueFactorizationDomain
import Mathlib.RingTheory.UniqueFactorizationDomain.Multiplicity

/-! # Actual original residual DVRs and eventual weighted-chart orders

The original rings, coefficients and uniformizers are constructed internally.
The leading expansion and eventual orders have no factorization or valuation
comparison certificate as an input.
-/

noncomputable section
open IsLocalRing IsDiscreteValuationRing
open scoped Classical nonZeroDivisors

universe u
namespace EnvelopeProperty.GaussRegularSurfaceValuationOrders

variable {S : Type u} [CommRing S] [IsDomain S]

/-- The actual original localization at the original prime parameter. -/
abbrev verticalRing (π : S) (hπ : Prime π) :=
  letI : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ
  Localization.AtPrime (Ideal.span {π})

private instance vertical_domain (π : S) (hπ : Prime π) : IsDomain (verticalRing π hπ) := by
  let : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ
  exact IsLocalization.isDomain_of_atPrime _ (Ideal.span {π})

/-- The original coefficient localization map, with no chosen field comparison. -/
def verticalCoefficientMap (π : S) (hπ : Prime π) : S →+* verticalRing π hπ := algebraMap S _

/-- The same original prime parameter in its true vertical local ring. -/
def verticalParameter (π : S) (hπ : Prime π) : verticalRing π hπ := verticalCoefficientMap π hπ π

omit [IsDomain S] in
/-- The actual vertical maximal ideal is generated by the original parameter. -/
theorem vertical_maximalIdeal (π : S) (hπ : Prime π) :
    maximalIdeal (verticalRing π hπ) = Ideal.span {verticalParameter π hπ} := by
  let : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (Ideal.span {π}) (verticalRing π hπ),
    Ideal.map_span,Set.image_singleton]
  rfl

/-- The SAME vertical localization is a DVR, internally derived from the
original Noetherian domain and genuine prime parameter. -/
theorem vertical_isDVR [IsNoetherianRing S] (π : S) (hπ : Prime π) :
    IsDiscreteValuationRing (verticalRing π hπ) := by
  let : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ
  have hn : verticalParameter π hπ ≠ 0 :=
    (map_ne_zero_iff _ (IsLocalization.injective (verticalRing π hπ)
      (Ideal.span {π}).primeCompl_le_nonZeroDivisors)).mpr hπ.ne_zero
  have hnot : ¬ IsField (verticalRing π hπ) := by
    intro h
    have he := IsLocalRing.isField_iff_maximalIdeal_eq.mp h
    rw [vertical_maximalIdeal,Ideal.span_singleton_eq_bot] at he
    exact hn he
  apply ((IsDiscreteValuationRing.TFAE (verticalRing π hπ) hnot).out 0 4).mpr
  exact ⟨verticalParameter π hπ,vertical_maximalIdeal π hπ⟩

private instance vertical_dvr [IsNoetherianRing S] (π : S) (hπ : Prime π) :
    IsDiscreteValuationRing (verticalRing π hπ) := vertical_isDVR π hπ

/-- The actual original parameter is a genuine vertical uniformizer. -/
theorem verticalParameter_irreducible [IsNoetherianRing S] (π : S) (hπ : Prime π) :
    Irreducible (verticalParameter π hπ) :=
  (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr (vertical_maximalIdeal π hπ)

section Residual
variable [IsLocalRing S]

/-- The literal original prime quotient; all structural hypotheses refer
only to the SAME original parameters and maximal ideal. -/
abbrev residualRing (π z : S) (hπ : Prime π) (_hz : ¬ π ∣ z)
    (_hm : maximalIdeal S = Ideal.span {π,z}) :=
  letI : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ
  S ⧸ Ideal.span {π}

private instance residual_domain (π z : S) (hπ : Prime π) (hz : ¬ π ∣ z)
    (hm : maximalIdeal S = Ideal.span {π,z}) : IsDomain (residualRing π z hπ hz hm) := by
  let : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ
  infer_instance

private instance residual_local (π z : S) (hπ : Prime π) (hz : ¬ π ∣ z)
    (hm : maximalIdeal S = Ideal.span {π,z}) : IsLocalRing (residualRing π z hπ hz hm) :=
  IsLocalRing.of_surjective' (Ideal.Quotient.mk (Ideal.span {π})) Ideal.Quotient.mk_surjective

/-- The actual original quotient coefficient map. -/
def residualCoefficientMap (π z : S) (hπ : Prime π) (hz : ¬ π ∣ z)
    (hm : maximalIdeal S = Ideal.span {π,z}) : S →+* residualRing π z hπ hz hm :=
  Ideal.Quotient.mk (Ideal.span {π})

/-- The actual image of the original second parameter in the residual ring. -/
def residualParameter (π z : S) (hπ : Prime π) (hz : ¬ π ∣ z)
    (hm : maximalIdeal S = Ideal.span {π,z}) : residualRing π z hπ hz hm :=
  residualCoefficientMap π z hπ hz hm z

omit [IsDomain S] in
/-- The genuine quotient maximal ideal is generated by the SAME original z. -/
theorem residual_maximalIdeal (π z : S) (hπ : Prime π) (hz : ¬ π ∣ z)
    (hm : maximalIdeal S = Ideal.span {π,z}) :
    maximalIdeal (residualRing π z hπ hz hm) = Ideal.span {residualParameter π z hπ hz hm} := by
  let ρ := residualCoefficientMap π z hπ hz hm
  have hρ : Function.Surjective ρ := Ideal.Quotient.mk_surjective
  have hp : ρ π = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.mem_span_singleton.mpr (dvd_refl π))
  rw [← IsLocalRing.map_maximalIdeal_of_surjective ρ hρ,hm,Ideal.map_span,Set.image_pair,hp,
    Ideal.span_pair_comm,Ideal.span_pair_zero]
  rfl

omit [IsDomain S] in
private theorem residualParameter_ne_zero (π z : S) (hπ : Prime π) (hz : ¬ π ∣ z)
    (hm : maximalIdeal S = Ideal.span {π,z}) : residualParameter π z hπ hz hm ≠ 0 := by
  intro he
  exact hz (Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp he))

omit [IsDomain S] in
/-- No residual-DVR assumption is supplied: this actual original quotient is
a DVR by its genuine original nonzero principal maximal ideal. -/
theorem residual_isDVR [IsNoetherianRing S] (π z : S) (hπ : Prime π) (hz : ¬ π ∣ z)
    (hm : maximalIdeal S = Ideal.span {π,z}) : IsDiscreteValuationRing (residualRing π z hπ hz hm) := by
  have hnot : ¬ IsField (residualRing π z hπ hz hm) := by
    intro h
    have he := IsLocalRing.isField_iff_maximalIdeal_eq.mp h
    rw [residual_maximalIdeal,Ideal.span_singleton_eq_bot] at he
    exact residualParameter_ne_zero π z hπ hz hm he
  apply ((IsDiscreteValuationRing.TFAE (residualRing π z hπ hz hm) hnot).out 0 4).mpr
  exact ⟨residualParameter π z hπ hz hm,residual_maximalIdeal π z hπ hz hm⟩

private instance residual_dvr [IsNoetherianRing S] (π z : S) (hπ : Prime π) (hz : ¬ π ∣ z)
    (hm : maximalIdeal S = Ideal.span {π,z}) : IsDiscreteValuationRing (residualRing π z hπ hz hm) :=
  residual_isDVR π z hπ hz hm

omit [IsDomain S] in
/-- The actual original residual parameter is a true uniformizer. -/
theorem residualParameter_irreducible [IsNoetherianRing S] (π z : S) (hπ : Prime π)
    (hz : ¬ π ∣ z) (hm : maximalIdeal S = Ideal.span {π,z}) :
    Irreducible (residualParameter π z hπ hz hm) :=
  (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr (residual_maximalIdeal π z hπ hz hm)

/-- Every nonzero ORIGINAL function internally admits an original leading
expansion, with its true native vertical and residual orders identified. -/
theorem exists_leadingExpansion [IsNoetherianRing S] (π z : S) (hπ : Prime π) (hz : ¬ π ∣ z)
    (hm : maximalIdeal S = Ideal.span {π,z}) (f : S) (hf : f ≠ 0) :
    ∃ (a b : ℕ) (f' u g : S), f = π ^ a * f' ∧ f' = z ^ b * u + π * g ∧ IsUnit u ∧
      ¬ π ∣ f' ∧ addVal (verticalRing π hπ) (verticalCoefficientMap π hπ f) = a ∧
      addVal (residualRing π z hπ hz hm) (residualCoefficientMap π z hπ hz hm f') = b := by
  obtain ⟨a,f',hnd,hf'⟩ := WfDvdMonoid.max_power_factor' hf hπ.not_isUnit
  let R := residualRing π z hπ hz hm
  let ρ := residualCoefficientMap π z hπ hz hm
  have hρ : Function.Surjective ρ := Ideal.Quotient.mk_surjective
  have hfn : ρ f' ≠ 0 := by
    intro he
    exact hnd (Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp he))
  obtain ⟨b,ū,hebar⟩ := eq_unit_mul_pow_irreducible hfn (residualParameter_irreducible π z hπ hz hm)
  obtain ⟨u,hu⟩ := hρ (ū : R)
  let : IsLocalHom ρ := IsLocalHom.of_surjective ρ hρ
  have hunit : IsUnit u := isUnit_of_map_unit ρ u (by rw [hu]; exact ū.isUnit)
  have hdiff : ρ (f' - z ^ b * u) = 0 := by
    rw [map_sub,map_mul,map_pow,hu]
    change ρ f' - residualParameter π z hπ hz hm ^ b * (ū : R) = 0
    rw [hebar,mul_comm,sub_self]
  obtain ⟨g,hg⟩ := Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp hdiff)
  have hexp : f' = z ^ b * u + π * g := by rw [← hg]; ring
  have hvunit : IsUnit (verticalCoefficientMap π hπ f') := by
    let : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ
    apply (IsLocalization.AtPrime.isUnit_to_map_iff _ (Ideal.span {π}) _).mpr
    change f' ∉ Ideal.span {π}
    simpa only [Ideal.mem_span_singleton] using hnd
  have hvπ : addVal (verticalRing π hπ) (verticalCoefficientMap π hπ π) = 1 :=
    addVal_uniformizer (verticalParameter_irreducible π hπ)
  have hva : addVal (verticalRing π hπ) (verticalCoefficientMap π hπ f) = a := by
    rw [hf',map_mul,map_pow,addVal_mul,addVal_pow,hvπ,
      addVal_eq_zero_iff.mpr hvunit,nsmul_one,add_zero]
  have hrb : addVal R (ρ f') = b := by
    rw [hebar,addVal_mul,addVal_eq_zero_of_unit,addVal_pow,
      addVal_uniformizer (residualParameter_irreducible π z hπ hz hm),nsmul_one,zero_add]
  exact ⟨a,b,f',u,g,hf',hexp,hunit,hnd,hva,hrb⟩

/-- The valuations are the ACTUAL already constructed original DVR valuations:
every nonzero original function has internally derived order a*N+b for ALL
N>b. The first coefficient is its true original vertical native order. -/
theorem exists_eventual_addVal [IsNoetherianRing S] (π z : S) (hπ : Prime π) (hz : ¬ π ∣ z)
    (hm : maximalIdeal S = Ideal.span {π,z}) (f : S) (hf : f ≠ 0) :
    ∃ a b : ℕ, addVal (verticalRing π hπ) (verticalCoefficientMap π hπ f) = a ∧
      ∀ (N : ℕ) (hN : 0 < N), b < N →
        addVal (GaussRegularSurfaceValuations.localRing π z hπ hz N hm hN)
          (GaussRegularSurfaceValuations.localCoefficientMap π z hπ hz N hm hN f) = a * N + b := by
  obtain ⟨a,b,f',u,g,hfactor,hlead,hunit,_,hvert,_⟩ := exists_leadingExpansion π z hπ hz hm f hf
  refine ⟨a,b,hvert,?_⟩
  intro N hN hbN
  let V := GaussRegularSurfaceValuations.localRing π z hπ hz N hm hN
  let j := GaussRegularSurfaceValuations.localCoefficientMap π z hπ hz N hm hN
  have hzv : addVal V (j z) = 1 := GaussRegularSurfaceValuations.parameter_addVal π z hπ hz N hm hN
  have hpv : addVal V (j π) = N := GaussRegularSurfaceValuations.vertical_addVal π z hπ hz N hm hN
  have huv : addVal V (j u) = 0 := addVal_eq_zero_iff.mpr (hunit.map j)
  have hsmall : addVal V (j (z ^ b * u)) = b := by
    rw [map_mul,map_pow,addVal_mul,addVal_pow,hzv,huv,add_zero,nsmul_one]
  have hbig : (N : ℕ∞) ≤ addVal V (j (π * g)) := by
    rw [map_mul,addVal_mul,hpv]
    exact le_self_add
  have hlt : addVal V (j (z ^ b * u)) < addVal V (j (π * g)) := by
    rw [hsmall]
    exact lt_of_lt_of_le (by exact_mod_cast hbN) hbig
  have hfv : addVal V (j f') = b := by
    rw [hlead,map_add,(addVal V).map_add_eq_of_lt_left hlt,hsmall]
  change addVal V (j f) = _
  rw [hfactor,map_mul,map_pow,addVal_mul,addVal_pow,hpv,hfv,nsmul_eq_mul]

end Residual
end EnvelopeProperty.GaussRegularSurfaceValuationOrders
