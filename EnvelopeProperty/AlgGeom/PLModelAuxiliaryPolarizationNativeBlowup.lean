import EnvelopeProperty.AlgGeom.BlowupHomogeneousTautologicalWholeComparisonNativeProduct
import EnvelopeProperty.AlgGeom.SchemeLineAmpleness
import EnvelopeProperty.AlgGeom.SegreProjectiveTwist
import EnvelopeProperty.AlgGeom.ProjectiveTwistTensorAddition
import EnvelopeProperty.Alterations.Geometry.BlowupProjective

/-! # A very ample twist of the tautological ideal on a blowup of a projective scheme

Let `X` be an integral scheme with a closed immersion `j : X ⟶ ℙⁿ_R` over a Noetherian ring `R`,
let `D` be an ideal sheaf on `X` and let `μ : Bl_D X ⟶ X` be the blowup. Writing
`D = (J̃)|_X` for a homogeneous ideal `J` generated by forms `F₀, …, F_m` of one degree `d`, the
forms give a closed immersion `Bl_D X ⟶ X ×_R ℙᵐ_R ⟶ ℙⁿ_R ×_R ℙᵐ_R` under which
`O_{ℙᵐ}(1)` pulls back to `μ^* j^* O(d) ⊗ D·O_{Bl}` (production
`BlowupHomogeneousTautologicalLine.exists_originalNativeProductWholeLine`). Composing with the
Segre embedding `ℙⁿ × ℙᵐ ⟶ ℙ^{(n+1)(m+1)-1}`, whose `O(1)` is `O(1) ⊠ O(1)`, shows that the
tautological twist
`μ^* j^* O(q) ⊗ D·O_{Bl}` with `q = d + 1`
is very ample over `R`.

Blueprint: `thm:pl-original-native-blowup-tautological-very-ample`.
-/
noncomputable section
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open Scheme.Modules MvPolynomial
open Alterations Alterations.Geometry
open Alterations.Geometry.ProjectiveIdeal
open Alterations.Geometry.BlowupProjectiveEmbedding
universe u
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace EnvelopeProperty.PLModelAuxiliaryPolarization
open SchemeLineSectionEvaluation SchemeLineSectionFactorization
attribute [local instance] MvPolynomial.gradedAlgebra Scheme.Modules.monoidalCategory

/-- The tautological twist `μ^* j^* O(q) ⊗ D·O_{Bl_D X}` on the blowup `μ : Bl_D X ⟶ X` of the
ideal sheaf `D`, for a morphism `j : X ⟶ ℙⁿ_R`. -/
def nativeTautologicalTwist {R : Type u} [CommRing R] {X : Scheme.{u}} {n : ℕ}
    (D : X.IdealSheafData) (j : X ⟶ projectiveSpace R n) (q : ℕ) : D.blowUp.Modules :=
  (Scheme.Modules.pullback D.blowUpπ).obj ((Scheme.Modules.pullback j).obj
    (coordinateHyperplaneTwist (R := R) (0 : Fin (n + 1)) (q : ℤ))) ⊗
      (D.comap D.blowUpπ).toModules

private theorem native_productClosedEmbedding_snd
    {R : Type u} [CommRing R] {X : Scheme.{u}} {n : ℕ}
    (j : X ⟶ projectiveSpace R n) (m : ℕ) :
    BlowupProjective.productClosedEmbedding j m ≫
      pullback.snd (projectiveSpaceStructure R n) (projectiveSpaceStructure R m) =
    pullback.snd (j ≫ projectiveSpaceStructure R n) (projectiveSpaceStructure R m) := by
  unfold BlowupProjective.productClosedEmbedding
  exact (Category.assoc _ _ _).trans (pullbackRightPullbackFstIso_inv_snd_snd
    (projectiveSpaceStructure R n) (projectiveSpaceStructure R m) j)

/-- On the blowup of an integral closed subscheme `j : X ⟶ ℙⁿ_R` (`R` Noetherian) along any
ideal sheaf `D`, some positive tautological twist `μ^* j^* O(q) ⊗ D·O_{Bl}` is very ample over
`R`. -/
theorem exists_veryAmple_nativeTautologicalTwist
    {R : Type u} [CommRing R] [IsNoetherianRing R]
    {X : Scheme.{u}} [IsIntegral X] {n : ℕ}
    (p : X ⟶ Spec (.of R)) (j : X ⟶ projectiveSpace R n) [IsClosedImmersion j]
    (hbase : j ≫ projectiveSpaceStructure R n = p) (D : X.IdealSheafData) :
    ∃ q : ℕ, 0 < q ∧ SchemeLineAmpleness.IsVeryAmple
      (D.blowUpπ ≫ p) (nativeTautologicalTwist D j q) := by
  subst p
  obtain ⟨m, d, F, J, hF, hspan, hD, hb, hfst, _hsnd, E₀, _hsections⟩ :=
    BlowupHomogeneousTautologicalLine.exists_originalNativeProductWholeLine D
      (j ≫ projectiveSpaceStructure R n) j
  subst D
  let D := (GradedQuotient.quotientIdealSheaf (ProjectiveGrading R n) J).comap j
  let μ := D.blowUpπ
  let b := (HironakaDeJongBlowupComparison.globalIso D).inv ≫
    formsProductMap (j ≫ projectiveSpaceStructure R n) j J F hspan hF
  let : IsClosedImmersion b := hb
  have hfst' : b ≫ pullback.fst (j ≫ projectiveSpaceStructure R n)
      (projectiveSpaceStructure R m) = μ := hfst
  let δ := b ≫ BlowupProjective.productClosedEmbedding j m
  let : IsClosedImmersion δ := by dsimp [δ]; infer_instance
  have hδleft : δ ≫ pullback.fst (projectiveSpaceStructure R n)
      (projectiveSpaceStructure R m) = μ ≫ j :=
    (Category.assoc b _ _).trans
      ((congrArg (b ≫ ·) (BlowupProjective.productClosedEmbedding_fst j m)).trans
        ((Category.assoc b _ _).symm.trans (congrArg (· ≫ j) hfst')))
  let v := b ≫ pullback.snd (j ≫ projectiveSpaceStructure R n) (projectiveSpaceStructure R m)
  have hδright : δ ≫ pullback.snd (projectiveSpaceStructure R n)
      (projectiveSpaceStructure R m) = v :=
    (Category.assoc b _ _).trans (congrArg (b ≫ ·) (native_productClosedEmbedding_snd j m))
  let O₁ := coordinateHyperplaneTwist (R := R) (0 : Fin (n + 1)) 1
  let Oₘ := coordinateHyperplaneTwist (R := R) (0 : Fin (m + 1)) 1
  let O_d := coordinateHyperplaneTwist (R := R) (0 : Fin (n + 1)) (d : ℤ)
  let K := (Scheme.Modules.pullback μ).obj ((Scheme.Modules.pullback j).obj O₁)
  let T := (Scheme.Modules.pullback μ).obj ((Scheme.Modules.pullback j).obj O_d)
  let E := (D.comap μ).toModules
  let : (Scheme.Modules.pullback μ).Monoidal := pullbackMonoidal μ
  let : (Scheme.Modules.pullback j).Monoidal := pullbackMonoidal j
  let : (Scheme.Modules.pullback δ).Monoidal := pullbackMonoidal δ
  let ev : (Scheme.Modules.pullback v).obj Oₘ ≅ T ⊗ E :=
    ((pullbackComp b (pullback.snd (j ≫ projectiveSpaceStructure R n)
      (projectiveSpaceStructure R m))).app Oₘ).symm ≪≫
      E₀ ≪≫ (ModularCurves.monoidalTensorObjIso T E).symm
  let el : (Scheme.Modules.pullback δ).obj (SegreProjectiveTwist.leftLine R n m) ≅ K :=
    frameFactorIso δ (pullback.fst (projectiveSpaceStructure R n)
      (projectiveSpaceStructure R m)) (μ ≫ j) hδleft O₁ ≪≫
      ((pullbackComp μ j).app O₁).symm
  let er : (Scheme.Modules.pullback δ).obj (SegreProjectiveTwist.rightLine R n m) ≅ T ⊗ E :=
    frameFactorIso δ (pullback.snd (projectiveSpaceStructure R n)
      (projectiveSpaceStructure R m)) v hδright Oₘ ≪≫ ev
  let O_q := coordinateHyperplaneTwist (R := R) (0 : Fin (n + 1)) ((d + 1 : ℕ) : ℤ)
  let eadd : O₁ ⊗ O_d ≅ O_q :=
    ProjectiveTwistTensorAddition.tensorIso (0 : Fin (n + 1)) 0 0 1 (d : ℤ) ≪≫
      eqToIso (congrArg (coordinateHyperplaneTwist (R := R) (0 : Fin (n + 1)))
        (show (1 : ℤ) + (d : ℤ) = ((d + 1 : ℕ) : ℤ) by omega))
  let et : K ⊗ T ≅ (Scheme.Modules.pullback μ).obj ((Scheme.Modules.pullback j).obj O_q) :=
    Functor.Monoidal.μIso (Scheme.Modules.pullback μ) ((Scheme.Modules.pullback j).obj O₁)
        ((Scheme.Modules.pullback j).obj O_d) ≪≫
      (Scheme.Modules.pullback μ).mapIso
        (Functor.Monoidal.μIso (Scheme.Modules.pullback j) O₁ O_d) ≪≫
      (Scheme.Modules.pullback μ).mapIso ((Scheme.Modules.pullback j).mapIso eadd)
  let es : (Scheme.Modules.pullback (δ ≫ Segre.segre R n m)).obj
      (coordinateHyperplaneTwist (R := R) (0 : Fin (Algebra.Segre.dimension n m + 1)) 1) ≅
      nativeTautologicalTwist D j (d + 1) :=
    ((pullbackComp δ (Segre.segre R n m)).app _).symm ≪≫
      (Scheme.Modules.pullback δ).mapIso (SegreProjectiveTwist.twistIso R n m) ≪≫
      (Functor.Monoidal.μIso (Scheme.Modules.pullback δ)
        (SegreProjectiveTwist.leftLine R n m) (SegreProjectiveTwist.rightLine R n m)).symm ≪≫
      (el ⊗ᵢ er) ≪≫ (α_ K T E).symm ≪≫ (et ⊗ᵢ Iso.refl E)
  have hstr : (δ ≫ Segre.segre R n m) ≫
      projectiveSpaceStructure R (Algebra.Segre.dimension n m) =
        μ ≫ j ≫ projectiveSpaceStructure R n :=
    (Category.assoc δ _ _).trans
      ((congrArg (δ ≫ ·) (Segre.segre_structure (R := R) (m := n) (n := m))).trans
        ((Category.assoc δ _ _).symm.trans
          ((congrArg (· ≫ projectiveSpaceStructure R n) hδleft).trans (Category.assoc μ j _))))
  exact ⟨d + 1, Nat.zero_lt_succ d, Algebra.Segre.dimension n m,
    δ ≫ Segre.segre R n m, inferInstance, hstr, ⟨es⟩⟩

end EnvelopeProperty.PLModelAuxiliaryPolarization
