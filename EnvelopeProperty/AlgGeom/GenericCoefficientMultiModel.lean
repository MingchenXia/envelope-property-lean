import EnvelopeProperty.Global.ModelQuotient
import EnvelopeProperty.AlgGeom.GeneratedLineGenericCoordinates
import EnvelopeProperty.AlgGeom.SchemeFunctionFieldSubalgebras

/-! # Genuine homogeneous model reconstructed over its actual original coordinate subfield -/

open AlgebraicGeometry CategoryTheory MvPolynomial TopologicalSpace
open Scheme.Modules
noncomputable section
universe u
namespace EnvelopeProperty.GenericCoefficientMultiModel
variable {k K : Type u} [Field k] [Field K] [Algebra k K]
  {r : ℕ} {M : Fin r → ℕ} (c : (i : Fin r) → Fin (M i + 1) → K)

/-- The actual intermediate field generated by ALL SAME original generic coefficients. -/
def coefficientField : IntermediateField k K :=
  IntermediateField.adjoin k (Set.range fun i : MultiModel.QuotVar M => c i.1 i.2)

/-- The actual coordinate subfield, with its field structure separated from the ambient carrier. -/
def FieldTy : Type u := coefficientField (k := k) c

instance : Field (FieldTy (k := k) c) := inferInstanceAs (Field (coefficientField (k := k) c))
instance : Algebra k (FieldTy (k := k) c) := inferInstanceAs (Algebra k (coefficientField (k := k) c))

/-- Its TRUE original inclusion into the original ambient field. -/
def fieldEmbedding : FieldTy (k := k) c →ₐ[k] K := (coefficientField (k := k) c).val

/-- Every coordinate is the SAME actual original coefficient, now in its own generated field. -/
def fieldCoordinate (i : Fin r) (j : Fin (M i + 1)) : FieldTy (k := k) c :=
  (⟨c i j, IntermediateField.subset_adjoin k _ ⟨⟨i, j⟩, rfl⟩⟩ : coefficientField (k := k) c)

/-- Every actual coordinate retains its literal original ambient-field value. -/
theorem fieldEmbedding_coordinate (i : Fin r) (j : Fin (M i + 1)) :
    fieldEmbedding (k := k) c (fieldCoordinate (k := k) c i j) = c i j := rfl

private theorem fieldCoordinate_pivot (j₀ : (i : Fin r) → Fin (M i + 1))
    (hc : ∀ i, c i (j₀ i) = 1) (i : Fin r) : fieldCoordinate (k := k) c i (j₀ i) = 1 :=
  Subtype.ext (hc i)

private def coordinateMonomial (i : MultiModel.QuotVar M) : MvPolynomial (Fin r) (FieldTy (k := k) c) :=
  monomial (Finsupp.single i.1 1) (fieldCoordinate (k := k) c i.1 i.2)

/-- A TRUE original homogeneous model, with field-generation DERIVED inside the actual
coefficient subfield. No full ambient-field-generation or model-comparison certificate. -/
def model (j₀ : (i : Fin r) → Fin (M i + 1)) (hc : ∀ i, c i (j₀ i) = 1) :
    MultiModel k (FieldTy (k := k) c) r where
  S := Algebra.adjoin k (Set.range (coordinateMonomial (k := k) c))
  isGraded _ hp a := monomial_coeff_mem_adjoin (fun q hq => by
    obtain ⟨i, rfl⟩ := hq
    exact ⟨_, _, rfl⟩) hp a
  fg := ⟨(Set.finite_range (coordinateMonomial (k := k) c)).toFinset, by
    rw [Set.Finite.coe_toFinset]⟩
  M := M
  coord := fieldCoordinate (k := k) c
  coord_mem i j := Algebra.subset_adjoin ⟨⟨i, j⟩, rfl⟩
  exists_coord_ne_zero i := ⟨j₀ i, by rw [fieldCoordinate_pivot c j₀ hc]; exact one_ne_zero⟩
  isIntegral p hp := isIntegral_algebraMap
    (R := Algebra.adjoin k (Set.range (coordinateMonomial (k := k) c))) (x := ⟨p, hp⟩)
  generates := by
    rw [eq_top_iff]
    rintro x -
    let s := {x : FieldTy (k := k) c | ∃ (a : Fin r →₀ ℕ) (f g : FieldTy (k := k) c),
      monomial a f ∈ Algebra.adjoin k (Set.range (coordinateMonomial (k := k) c)) ∧
        monomial a g ∈ Algebra.adjoin k (Set.range (coordinateMonomial (k := k) c)) ∧
          g ≠ 0 ∧ x = f / g}
    have hgen (i : Fin r) (j : Fin (M i + 1)) : fieldCoordinate (k := k) c i j ∈ s := by
      refine ⟨Finsupp.single i 1, fieldCoordinate (k := k) c i j, fieldCoordinate (k := k) c i (j₀ i),
        Algebra.subset_adjoin ⟨⟨i, j⟩, rfl⟩, Algebra.subset_adjoin ⟨⟨i, j₀ i⟩, rfl⟩, ?_, ?_⟩
      · rw [fieldCoordinate_pivot c j₀ hc]; exact one_ne_zero
      · rw [fieldCoordinate_pivot c j₀ hc, div_one]
    have hle : coefficientField (k := k) c ≤ (IntermediateField.adjoin k s).map (fieldEmbedding (k := k) c) := by
      rw [coefficientField, IntermediateField.adjoin_le_iff]
      rintro _ ⟨i, rfl⟩
      exact (IntermediateField.mem_map _).mpr
        ⟨fieldCoordinate (k := k) c i.1 i.2, IntermediateField.subset_adjoin _ _ (hgen i.1 i.2), rfl⟩
    obtain ⟨y, hy, hyx⟩ := (IntermediateField.mem_map _).mp
      (hle (show fieldEmbedding (k := k) c x ∈ coefficientField (k := k) c from (show coefficientField (k := k) c from x).property))
    rwa [(fieldEmbedding (k := k) c).injective hyx] at hy

variable {X : Scheme.{u}} [IsIntegral X] (p : X ⟶ Spec (.of k))
  (L : Fin r → X.Modules) (hL : ∀ i, IsInvertible (L i))
  (G : ∀ i, (L i).GeneratingSections) [∀ i, Fintype (G i).I]

/-- The model is INTERNALLY constructed from the SAME original finite global generators,
inside the actual intrinsic function field; equality with the ENTIRE K(X) is not presumed. -/
def generatedLineFamilyModel :
    letI := p.stalkAlgebra (genericPoint X)
    MultiModel k (FieldTy (k := k) (fun i => GeneratedLineGenericCoordinates.paddedCoefficient (hL i) (G i))) r := by
  letI := p.stalkAlgebra (genericPoint X)
  exact model (fun i => GeneratedLineGenericCoordinates.paddedCoefficient (hL i) (G i))
    (fun i => ((Fintype.equivFin (G i).I) (GeneratedLineGenericCoordinates.pivot (hL i) (G i))).succ)
    (fun i => GeneratedLineGenericCoordinates.paddedCoefficient_pivot (hL i) (G i))

end EnvelopeProperty.GenericCoefficientMultiModel
