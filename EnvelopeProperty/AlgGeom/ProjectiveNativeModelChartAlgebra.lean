import EnvelopeProperty.AlgGeom.ProjectiveChartFunctionFieldGeneration
import EnvelopeProperty.Global.ModelCharts

/-! # The SAME native affine sections and actual whole-native-field model chart algebra -/
open AlgebraicGeometry CategoryTheory MvPolynomial TopologicalSpace
open Alterations Alterations.Algebra.Segre
open Alterations.Geometry.ProjectiveIdeal Alterations.Geometry.Segre
noncomputable section
universe u
namespace EnvelopeProperty.ProjectiveNativeModelChartAlgebra
open ProjectiveChartFunctionFieldGeneration
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable {k : Type u} [Field k] {m : ℕ} {X : Scheme.{u}} [IsIntegral X]
  (f : X ⟶ projectiveSpace k m) (i : Fin (m + 1))
  [Nonempty (f ⁻¹ᵁ coordinateOpen (R := k) i)] [IsClosedImmersion f]

/-- The WHOLE actual original affine section algebra has literally the SAME image in
native K(X) as the subalgebra generated by all original pulled projective ratios. -/
theorem sectionSubalgebra_eq_adjoin_coordinates :
    let := (f ≫ projectiveSpaceStructure k m).stalkAlgebra (genericPoint X)
    (f ≫ projectiveSpaceStructure k m).sectionsFunctionFieldSubalgebra
        (f ⁻¹ᵁ coordinateOpen (R := k) i) =
      Algebra.adjoin k (Set.range (coordinate f i)) := by
  let p := f ≫ projectiveSpaceStructure k m
  let := p.stalkAlgebra (genericPoint X)
  let := p.sectionsAlgebra (f ⁻¹ᵁ coordinateOpen (R := k) i)
  let := (projectiveSpaceStructure k m).sectionsAlgebra (coordinateOpen (R := k) i)
  let A := Algebra.adjoin k (Set.range (coordinate f i))
  let φ := (SchemeFunctionFieldPullbackCoefficients.genericMap f (projectiveSpaceStructure k m)
    (coordinateOpen (R := k) i)).comp (sectionsEquiv (k := k) i).toAlgHom
  have hφ (j : ChartIndex i) : φ (MvPolynomial.X j) = coordinate f i j.val := by
    have hc := sectionsEquiv_coordinate (k := k) i j.val
    have he : coordinateDehomCoord (R := k) i j.val = MvPolynomial.X j := by
      simp only [coordinateDehomCoord, dif_neg j.property]
    rw [he] at hc
    change SchemeFunctionFieldPullbackCoefficients.genericMap f (projectiveSpaceStructure k m)
      (coordinateOpen (R := k) i) (sectionsEquiv i (MvPolynomial.X j)) = _
    rw [hc]
    rfl
  apply le_antisymm
  · rintro x ⟨a, rfl⟩
    obtain ⟨b, rfl⟩ := f.app_surjective (coordinateOpen (R := k) i) (coordinateOpen_isAffineOpen i) a
    obtain ⟨c, rfl⟩ := (sectionsEquiv (k := k) i).surjective b
    change φ c ∈ A
    induction c using MvPolynomial.induction_on with
    | C a =>
      rw [show MvPolynomial.C a = algebraMap k (CoordinateRing k i) a from rfl, φ.commutes]
      exact A.algebraMap_mem a
    | add a b ha hb => rw [map_add]; exact A.add_mem ha hb
    | mul_X a j ha =>
      rw [map_mul, hφ]
      exact A.mul_mem ha (Algebra.subset_adjoin ⟨j.val, rfl⟩)
  · apply Algebra.adjoin_le
    rintro x ⟨j, rfl⟩
    exact ⟨f.app (coordinateOpen (R := k) i)
      (ProjectiveHomogeneousSections.coefficient i 1 (MvPolynomial.X j)
        (MvPolynomial.isHomogeneous_X k j)), rfl⟩

/-- The actual reconstructed homogeneous model's pivot chart is the exact original
coordinate subalgebra of the ENTIRE SAME original native function field. -/
theorem modelChartAlg_eq_adjoin_coordinates :
    let := (f ≫ projectiveSpaceStructure k m).stalkAlgebra (genericPoint X)
    (fullFieldModel f i).chartAlg (fun _ => i) = Algebra.adjoin k (Set.range (coordinate f i)) := by
  let := (f ≫ projectiveSpaceStructure k m).stalkAlgebra (genericPoint X)
  let P := fullFieldModel f i
  let z (j : MultiModel.QuotVar (fun _ : Fin 1 => m)) : MvPolynomial (Fin 1) X.functionField :=
    monomial (Finsupp.single j.1 1) (coordinate f i j.2)
  have hz (c : Fin 1) (j : Fin (m + 1)) :
      P.dehom (fun _ => i) (monomial (Finsupp.single c 1) (coordinate f i j)) = coordinate f i j := by
    rw [P.dehom_monomial, P.chartDen_single]
    change coordinate f i j / coordinate f i i = coordinate f i j
    rw [coordinate_self, div_one]
  change (Algebra.adjoin k (Set.range z)).map (P.dehom (fun _ => i)) = _
  rw [← Algebra.adjoin_image]
  congr 1
  ext x
  constructor
  · rintro ⟨_, ⟨j, rfl⟩, rfl⟩
    exact ⟨j.2, (hz j.1 j.2).symm⟩
  · rintro ⟨j, rfl⟩
    exact ⟨z ⟨0, j⟩, ⟨⟨0, j⟩, rfl⟩, hz 0 j⟩

/-- An actual whole k-algebra equivalence identifies ALL native original chart sections
with the actual reconstructed model chart; every element retains its original native germ. -/
def nativeSectionsEquivModelChart :
    let := (f ≫ projectiveSpaceStructure k m).stalkAlgebra (genericPoint X)
    let := (f ≫ projectiveSpaceStructure k m).sectionsAlgebra (f ⁻¹ᵁ coordinateOpen (R := k) i)
    Γ(X, f ⁻¹ᵁ coordinateOpen (R := k) i) ≃ₐ[k] (fullFieldModel f i).chartAlg (fun _ => i) := by
  let p := f ≫ projectiveSpaceStructure k m
  let := p.stalkAlgebra (genericPoint X)
  let := p.sectionsAlgebra (f ⁻¹ᵁ coordinateOpen (R := k) i)
  exact (p.sectionsFunctionFieldEquiv (f ⁻¹ᵁ coordinateOpen (R := k) i)).trans
    (Subalgebra.equivOfEq _ _ ((sectionSubalgebra_eq_adjoin_coordinates f i).trans
      (modelChartAlg_eq_adjoin_coordinates f i).symm))

/-- Every original native section maps to its literal SAME generic germ in native K(X). -/
theorem nativeSectionsEquivModelChart_apply (s : Γ(X, f ⁻¹ᵁ coordinateOpen (R := k) i)) :
    let := (f ≫ projectiveSpaceStructure k m).stalkAlgebra (genericPoint X)
    let := (f ≫ projectiveSpaceStructure k m).sectionsAlgebra (f ⁻¹ᵁ coordinateOpen (R := k) i)
    ((nativeSectionsEquivModelChart f i s : (fullFieldModel f i).chartAlg (fun _ => i)) :
        X.functionField) = X.germToFunctionField (f ⁻¹ᵁ coordinateOpen (R := k) i) s := rfl

/-- A genuine WHOLE original native affine open is isomorphic to the spectrum of the
actual reconstructed homogeneous model chart algebra, with no chart-comparison premise. -/
def nativeChartIso :
    let := (f ≫ projectiveSpaceStructure k m).stalkAlgebra (genericPoint X)
    (f ⁻¹ᵁ coordinateOpen (R := k) i).toScheme ≅
      Spec (.of ((fullFieldModel f i).chartAlg (fun _ => i))) := by
  let := (f ≫ projectiveSpaceStructure k m).stalkAlgebra (genericPoint X)
  let := (f ≫ projectiveSpaceStructure k m).sectionsAlgebra (f ⁻¹ᵁ coordinateOpen (R := k) i)
  exact ((coordinateOpen_isAffineOpen i).preimage f).isoSpec ≪≫
    Scheme.Spec.mapIso (nativeSectionsEquivModelChart f i).symm.toRingEquiv.toCommRingCatIso.op

private theorem nativeOpen_structure {Y : Scheme.{u}} (p : Y ⟶ Spec (.of k)) (U : Y.Opens) :
    let := p.sectionsAlgebra U
    U.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (algebraMap k Γ(Y, U))) = U.ι ≫ p := by
  let := p.sectionsAlgebra U
  have hnat := Scheme.Opens.toSpecΓ_SpecMap_appLE p ⊤ U (by simp)
  change U.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (.of k)).inv ≫ p.appLE ⊤ U (by simp)) = _
  rw [Spec.map_comp, ← Category.assoc]
  erw [hnat]
  rw [Scheme.Opens.toSpecΓ_top, Category.assoc, Category.assoc,
    toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
  exact p.resLE_comp_ι (by simp)

/-- The WHOLE reconstructed native chart isomorphism retains the literal original
coefficient triangle, rather than only an abstract scheme or coordinate-ring isomorphism. -/
theorem nativeChartIso_structure :
    let := (f ≫ projectiveSpaceStructure k m).stalkAlgebra (genericPoint X)
    (nativeChartIso f i).hom ≫ Spec.map (CommRingCat.ofHom
        (algebraMap k ((fullFieldModel f i).chartAlg (fun _ => i)))) =
      (f ⁻¹ᵁ coordinateOpen (R := k) i).ι ≫ (f ≫ projectiveSpaceStructure k m) := by
  let p := f ≫ projectiveSpaceStructure k m
  let := p.stalkAlgebra (genericPoint X)
  let := p.sectionsAlgebra (f ⁻¹ᵁ coordinateOpen (R := k) i)
  let e := nativeSectionsEquivModelChart f i
  change (((coordinateOpen_isAffineOpen i).preimage f).isoSpec.hom ≫
      Spec.map (CommRingCat.ofHom e.symm.toRingHom)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap k ((fullFieldModel f i).chartAlg (fun _ => i)))) = _
  rw [Category.assoc, ← Spec.map_comp]
  have he : CommRingCat.ofHom (algebraMap k ((fullFieldModel f i).chartAlg (fun _ => i))) ≫
      CommRingCat.ofHom e.symm.toRingHom =
        CommRingCat.ofHom (algebraMap k Γ(X, f ⁻¹ᵁ coordinateOpen (R := k) i)) := by
    ext a
    exact e.symm.commutes a
  rw [he]
  exact nativeOpen_structure p _

end EnvelopeProperty.ProjectiveNativeModelChartAlgebra
