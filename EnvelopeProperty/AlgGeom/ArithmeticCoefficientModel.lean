import Mathlib.RingTheory.Extension.Presentation.Core

/-!
# A finite arithmetic coefficient model of the same equations

The coefficient ring is the actual integer subalgebra of the original field
generated by the original relations and any specified finite extra coefficients.
The native presentation model is a literal polynomial quotient, and its native
tensor equivalence retains the whole original polynomial map. No smoothness of
the arithmetic base or of the model is assumed or concluded.
-/

noncomputable section
open scoped TensorProduct Classical

namespace EnvelopeProperty.ArithmeticCoefficientModel

universe u v w z

variable {k : Type u} [Field k] {σ : Type v} {ι : Type w}

/-- The actual integer subalgebra of the same field, with specified finite extras. -/
def coefficientRing (fs : ι → MvPolynomial σ k) (extra : Finset k) : Subalgebra ℤ k :=
  Algebra.adjoin ℤ ((⋃ i, ((fs i).coeffs : Set k)) ∪ (extra : Set k))

/-- All specified extra coefficients lie in this actual arithmetic base. -/
theorem extra_mem_coefficientRing (fs : ι → MvPolynomial σ k) (extra : Finset k)
    {c : k} (hc : c ∈ extra) : c ∈ coefficientRing fs extra :=
  Algebra.subset_adjoin (Or.inr hc)

/-- Every original coefficient, including zero, lies in the arithmetic base. -/
theorem coeff_mem_coefficientRing (fs : ι → MvPolynomial σ k) (extra : Finset k)
    (i : ι) (m : σ →₀ ℕ) : MvPolynomial.coeff m (fs i) ∈ coefficientRing fs extra := by
  by_cases h : MvPolynomial.coeff m (fs i) = 0
  · simp [h]
  · apply Algebra.subset_adjoin
    exact Or.inl (Set.mem_iUnion.mpr ⟨i, MvPolynomial.coeff_mem_coeffs m h⟩)

/-- A finite family gives a genuinely finite-type integer algebra. -/
theorem coefficientRing_finiteType [Finite ι] (fs : ι → MvPolynomial σ k)
    (extra : Finset k) : Algebra.FiniteType ℤ (coefficientRing fs extra) :=
  .adjoin_of_finite ((Set.finite_iUnion fun i => (fs i).coeffs.finite_toSet).union
    extra.finite_toSet)

/-- Domain and characteristic zero come from the same original field inclusion. -/
theorem coefficientRing_arithmetic [CharZero k] [Finite ι]
    (fs : ι → MvPolynomial σ k) (extra : Finset k) :
    Algebra.FiniteType ℤ (coefficientRing fs extra) ∧
      IsDomain (coefficientRing fs extra) ∧ CharZero (coefficientRing fs extra) :=
  ⟨coefficientRing_finiteType fs extra, inferInstance, inferInstance⟩

variable {A : Type z} [CommRing A] [Algebra k A]

private instance presentationHasCoeffs (P : Algebra.Presentation k A σ ι)
    (extra : Finset k) : P.HasCoeffs (coefficientRing P.relation extra) where
  coeffs_subset_range := by
    intro c hc
    exact ⟨⟨c, Algebra.subset_adjoin (Or.inl hc)⟩, rfl⟩

/-- The original relations with their coefficients in the actual arithmetic ring. -/
def presentationRelations (P : Algebra.Presentation k A σ ι) (extra : Finset k) :
    ι → MvPolynomial σ (coefficientRing P.relation extra) :=
  P.relationOfHasCoeffs (coefficientRing P.relation extra)

/-- Inclusion returns the entire same original polynomial relation. -/
theorem map_presentationRelations (P : Algebra.Presentation k A σ ι) (extra : Finset k)
    (i : ι) : MvPolynomial.map (algebraMap (coefficientRing P.relation extra) k)
      (presentationRelations P extra i) = P.relation i :=
  P.map_relationOfHasCoeffs _ i

/-- Each original coefficient is retained under the original inclusion. -/
theorem coeff_presentationRelations (P : Algebra.Presentation k A σ ι) (extra : Finset k)
    (i : ι) (m : σ →₀ ℕ) :
    algebraMap (coefficientRing P.relation extra) k
        (MvPolynomial.coeff m (presentationRelations P extra i)) =
      MvPolynomial.coeff m (P.relation i) := by
  simpa only [MvPolynomial.coeff_map] using
    congrArg (MvPolynomial.coeff m) (map_presentationRelations P extra i)

/-- The actual model is literally the polynomial quotient by these relations. -/
abbrev presentationModel (P : Algebra.Presentation k A σ ι) (extra : Finset k) :=
  MvPolynomial σ (coefficientRing P.relation extra) ⧸
    Ideal.span (Set.range (presentationRelations P extra))

/-- Finitely many variables and relations give a finitely presented literal model. -/
theorem presentationModel_finitePresentation [Finite σ] [Finite ι]
    (P : Algebra.Presentation k A σ ι) (extra : Finset k) :
    Algebra.FinitePresentation (coefficientRing P.relation extra) (presentationModel P extra) :=
  inferInstanceAs (Algebra.FinitePresentation (coefficientRing P.relation extra)
    (P.ModelOfHasCoeffs (coefficientRing P.relation extra)))

/-- The native constructed equivalence has target the same original algebra. -/
def presentationTensorEquiv (P : Algebra.Presentation k A σ ι) (extra : Finset k) :
    k ⊗[coefficientRing P.relation extra] presentationModel P extra ≃ₐ[k] A :=
  P.tensorModelOfHasCoeffsEquiv (coefficientRing P.relation extra)

/-- Every pure tensor retains its whole polynomial evaluation and original coefficient. -/
theorem presentationTensorEquiv_tmul (P : Algebra.Presentation k A σ ι) (extra : Finset k)
    (c : k) (p : MvPolynomial σ (coefficientRing P.relation extra)) :
    presentationTensorEquiv P extra (c ⊗ₜ Ideal.Quotient.mk _ p) =
      algebraMap k A c * MvPolynomial.aeval P.val
        (MvPolynomial.map (algebraMap (coefficientRing P.relation extra) k) p) := by
  rw [MvPolynomial.aeval_map_algebraMap k]
  exact P.tensorModelOfHasCoeffsEquiv_tmul _ c p

/-- Every original base coefficient is retained. -/
theorem presentationTensorEquiv_coefficient (P : Algebra.Presentation k A σ ι)
    (extra : Finset k) (c : k) :
    presentationTensorEquiv P extra (c ⊗ₜ (1 : presentationModel P extra)) =
      algebraMap k A c := by
  simpa using presentationTensorEquiv_tmul P extra c 1

/-- Each original presentation variable is retained. -/
theorem presentationTensorEquiv_variable (P : Algebra.Presentation k A σ ι)
    (extra : Finset k) (j : σ) :
    presentationTensorEquiv P extra (1 ⊗ₜ Ideal.Quotient.mk _ (MvPolynomial.X j)) =
      P.val j := by
  simpa using presentationTensorEquiv_tmul P extra 1 (MvPolynomial.X j)

/-- The whole original polynomial map, including all original coefficients, commutes. -/
theorem presentationTensorEquiv_whole_polynomial (P : Algebra.Presentation k A σ ι)
    (extra : Finset k) :
    (presentationTensorEquiv P extra).toAlgHom.comp
        ((Algebra.TensorProduct.map (AlgHom.id k k)
          (Ideal.Quotient.mkₐ (coefficientRing P.relation extra)
            (Ideal.span (Set.range (presentationRelations P extra))))).comp
          (MvPolynomial.algebraTensorAlgEquiv (coefficientRing P.relation extra) k).symm.toAlgHom) =
      MvPolynomial.aeval P.val := by
  ext j
  simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
    MvPolynomial.algebraTensorAlgEquiv_symm_X, Algebra.TensorProduct.map_tmul,
    Ideal.Quotient.mkₐ_eq_mk, map_one]
  simpa using presentationTensorEquiv_variable P extra j

/-- The native presentation of the literal original quotient by exactly the given equations. -/
abbrev polynomialPresentation (fs : ι → MvPolynomial σ k) :
    Algebra.Presentation k (MvPolynomial σ k ⧸ Ideal.span (Set.range fs)) σ ι :=
  Algebra.Presentation.naive (v := fs)

/-- The original finite equation family descended to its actual coefficient ring. -/
def polynomialRelations (fs : ι → MvPolynomial σ k) (extra : Finset k) :
    ι → MvPolynomial σ (coefficientRing fs extra) :=
  presentationRelations (polynomialPresentation fs) extra

/-- The descended equations map back to precisely the original whole family. -/
theorem map_polynomialRelations (fs : ι → MvPolynomial σ k) (extra : Finset k) (i : ι) :
    MvPolynomial.map (algebraMap (coefficientRing fs extra) k) (polynomialRelations fs extra i) =
      fs i :=
  map_presentationRelations (polynomialPresentation fs) extra i

/-- The equation model with the coefficient ring written literally. -/
abbrev polynomialModel (fs : ι → MvPolynomial σ k) (extra : Finset k) :=
  MvPolynomial σ (coefficientRing fs extra) ⧸ Ideal.span (Set.range (polynomialRelations fs extra))

/-- This literal equation quotient is finitely presented over its actual arithmetic base. -/
theorem polynomialModel_finitePresentation [Finite σ] [Finite ι]
    (fs : ι → MvPolynomial σ k) (extra : Finset k) :
    Algebra.FinitePresentation (coefficientRing fs extra) (polynomialModel fs extra) :=
  presentationModel_finitePresentation (polynomialPresentation fs) extra

/-- The literal same original quotient is the scalar extension of its actual arithmetic model. -/
def polynomialTensorEquiv (fs : ι → MvPolynomial σ k) (extra : Finset k) :
    k ⊗[coefficientRing fs extra] polynomialModel fs extra ≃ₐ[k]
      (MvPolynomial σ k ⧸ Ideal.span (Set.range fs)) :=
  presentationTensorEquiv (polynomialPresentation fs) extra

/-- Every original coefficient times every polynomial quotient class is preserved. -/
theorem polynomialTensorEquiv_tmul (fs : ι → MvPolynomial σ k) (extra : Finset k)
    (c : k) (p : MvPolynomial σ (coefficientRing fs extra)) :
    polynomialTensorEquiv fs extra (c ⊗ₜ Ideal.Quotient.mk _ p) =
      algebraMap k (MvPolynomial σ k ⧸ Ideal.span (Set.range fs)) c *
        Ideal.Quotient.mk _ (MvPolynomial.map (algebraMap (coefficientRing fs extra) k) p) := by
  exact (presentationTensorEquiv_tmul (polynomialPresentation fs) extra c p).trans
    (congrArg (fun x => algebraMap k (MvPolynomial σ k ⧸ Ideal.span (Set.range fs)) c * x)
      (DFunLike.congr_fun (MvPolynomial.aeval_unique
        (Ideal.Quotient.mkₐ k (Ideal.span (Set.range fs)))).symm _))

/-- The entire original quotient map agrees with actual polynomial scalar extension. -/
theorem polynomialTensorEquiv_whole_quotient (fs : ι → MvPolynomial σ k)
    (extra : Finset k) :
    (polynomialTensorEquiv fs extra).toAlgHom.comp
        ((Algebra.TensorProduct.map (AlgHom.id k k)
          (Ideal.Quotient.mkₐ (coefficientRing fs extra)
            (Ideal.span (Set.range (polynomialRelations fs extra))))).comp
          (MvPolynomial.algebraTensorAlgEquiv (coefficientRing fs extra) k).symm.toAlgHom) =
      Ideal.Quotient.mkₐ k (Ideal.span (Set.range fs)) := by
  exact (presentationTensorEquiv_whole_polynomial (polynomialPresentation fs) extra).trans
    (MvPolynomial.aeval_unique (Ideal.Quotient.mkₐ k (Ideal.span (Set.range fs)))).symm

/-- The same original finitely presented algebra internally produces a finite arithmetic model.
The base, relations and tensor equivalence are the actual constructions above. -/
theorem exists_original_finitePresentation_model [CharZero k] [Algebra.FinitePresentation k A]
    (extra : Finset k) :
    ∃ (n r : ℕ) (P : Algebra.Presentation k A (Fin n) (Fin r)),
      Algebra.FiniteType ℤ (coefficientRing P.relation extra) ∧
      IsDomain (coefficientRing P.relation extra) ∧ CharZero (coefficientRing P.relation extra) ∧
      (∀ c ∈ extra, c ∈ coefficientRing P.relation extra) ∧
      Algebra.FinitePresentation (coefficientRing P.relation extra) (presentationModel P extra) ∧
      (∀ i, MvPolynomial.map (algebraMap (coefficientRing P.relation extra) k)
        (presentationRelations P extra i) = P.relation i) ∧
      (∀ (c : k) (p : MvPolynomial (Fin n) (coefficientRing P.relation extra)),
        presentationTensorEquiv P extra (c ⊗ₜ Ideal.Quotient.mk _ p) =
          algebraMap k A c * MvPolynomial.aeval P.val
            (MvPolynomial.map (algebraMap (coefficientRing P.relation extra) k) p)) ∧
      (presentationTensorEquiv P extra).toAlgHom.comp
        ((Algebra.TensorProduct.map (AlgHom.id k k)
          (Ideal.Quotient.mkₐ (coefficientRing P.relation extra)
            (Ideal.span (Set.range (presentationRelations P extra))))).comp
          (MvPolynomial.algebraTensorAlgEquiv (coefficientRing P.relation extra) k).symm.toAlgHom) =
        MvPolynomial.aeval P.val := by
  obtain ⟨n, r, ⟨P⟩⟩ := Algebra.Presentation.exists_presentation_fin k A
  obtain ⟨hFT, hD, hC⟩ := coefficientRing_arithmetic P.relation extra
  exact ⟨n, r, P, hFT, hD, hC, fun c hc => extra_mem_coefficientRing P.relation extra hc,
    presentationModel_finitePresentation P extra, map_presentationRelations P extra,
    presentationTensorEquiv_tmul P extra, presentationTensorEquiv_whole_polynomial P extra⟩

end EnvelopeProperty.ArithmeticCoefficientModel
