import EnvelopeProperty.AlgGeom.QuasicoherentImageIdeal
import EnvelopeProperty.AlgGeom.SchemeModuleGlobalSections
import ModularCurves.Picard.InvertibleSheafLocallyFree

/-! # The base ideal generated by all actual global sections of a line sheaf -/

open CategoryTheory AlgebraicGeometry MonoidalCategory
noncomputable section
universe u
set_option backward.isDefEq.respectTransparency false

namespace EnvelopeProperty.InvertibleSheafBaseIdeal

attribute [local instance] Scheme.Modules.monoidalCategory
open Scheme.Modules

/-- Evaluate the original local dual against the SAME original global section. -/
def sectionEvaluation {X : Scheme.{u}} (L : X.Modules) (s : Γ(L, ⊤)) :
    dualObj L ⟶ unitObj X :=
  (whiskerRightIso (ModularCurves.monoidalUnitObjIso X).symm (dualObj L) ≪≫
    λ_ (dualObj L)).inv ≫
      (SchemeModuleGlobalSections.sectionHom L s ▷ dualObj L) ≫
        ModularCurves.dualPairing L

/-- The actual image ideal of evaluation against one original global section. -/
def sectionIdeal {X : Scheme.{u}} {L : X.Modules} (hL : IsInvertible L)
    (s : Γ(L, ⊤)) : X.IdealSheafData := by
  let : (dualObj L).IsQuasicoherent := hL.dual.isQuasicoherent
  exact QuasicoherentImageIdeal.imageIdeal (dualObj L) (sectionEvaluation L s)

/-- The whole base ideal is generated by ALL actual original global sections. -/
def baseIdeal {X : Scheme.{u}} {L : X.Modules} (hL : IsInvertible L) :
    X.IdealSheafData := ⨆ s : Γ(L, ⊤), sectionIdeal hL s

/-- Every original affine coefficient ideal is the whole sum of the actual
evaluation images, with all global sections and all local dual sections retained. -/
theorem baseIdeal_ideal {X : Scheme.{u}} {L : X.Modules} (hL : IsInvertible L)
    (U : X.affineOpens) :
    (baseIdeal hL).ideal U =
      ⨆ s : Γ(L, ⊤), ((sectionEvaluation L s).val.app (.op U.1)).hom.range := by
  rw [baseIdeal, Scheme.IdealSheafData.ideal_iSup, iSup_apply]
  rfl

/-- The same original global/local evaluation coefficient belongs to the
whole original base ideal, without any chosen generating family. -/
theorem evaluation_mem_baseIdeal {X : Scheme.{u}} {L : X.Modules} (hL : IsInvertible L)
    (U : X.affineOpens) (s : Γ(L, ⊤)) (d : Γ(dualObj L, U.1)) :
    (sectionEvaluation L s).val.app (.op U.1) d ∈ (baseIdeal hL).ideal U := by
  rw [baseIdeal_ideal]
  exact Ideal.mem_iSup_of_mem (R := Γ(X, U.1)) s ⟨d, rfl⟩

/-- The original base ideal is the LEAST actual ideal sheaf containing
every original section-evaluation image; no compatible-subfamily proxy is used. -/
theorem baseIdeal_le_iff {X : Scheme.{u}} {L : X.Modules} (hL : IsInvertible L)
    (I : X.IdealSheafData) :
    baseIdeal hL ≤ I ↔ ∀ s : Γ(L, ⊤), sectionIdeal hL s ≤ I := iSup_le_iff

end EnvelopeProperty.InvertibleSheafBaseIdeal
