import EnvelopeProperty.AlgGeom.ArithmeticProjectiveCoefficientModel
import Mathlib.AlgebraicGeometry.Noetherian

/-! # A genuine projective arithmetic family recovering the whole ORIGINAL X

Only the original closed embedding is supplied. Its actual kernel produces the
finite homogeneous presentation internally; the frozen coefficient model then
gives the actual family, whole original pullback square and original O(d) lines.
-/

noncomputable section
universe u
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MvPolynomial
open Scheme.Modules
open scoped Classical
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace EnvelopeProperty.ArithmeticProjectiveOriginalFamily
open ProjBerk ArithmeticProjectiveCoefficientModel
attribute [local instance] MvPolynomial.gradedAlgebra

private theorem pasteTriangles {C : Type*} [Category C] {A B D E F : C}
    (e : A ⟶ B) (m : B ⟶ D) (q : D ⟶ F) (u : B ⟶ E) (v : E ⟶ F) (p : A ⟶ E)
    (hm : m ≫ q = u ≫ v) (he : e ≫ u = p) : (e ≫ m) ≫ q = p ≫ v := by
  rw [Category.assoc, hm, ← Category.assoc, he]

private theorem projectionTriangle {C : Type*} [Category C] {A B D E : C}
    (e : A ⟶ B) (i : B ⟶ D) (j : A ⟶ D) (q : D ⟶ E) (p : A ⟶ E)
    (he : e ≫ i = j) (hp : j ≫ q = p) : e ≫ (i ≫ q) = p := by
  rw [← Category.assoc, he, hp]

private theorem isoTrans_projection {C : Type*} [Category C] {A B D E : C}
    (e : A ≅ B) (J : B ≅ D) (q : D ⟶ E) (u : B ⟶ E) (hq : J.hom ≫ q = u) :
    (e ≪≫ J).hom ≫ q = e.hom ≫ u := by
  rw [Iso.trans_hom, Category.assoc, hq]

variable {k : Type u} [Field k] {N : ℕ} {X : Scheme.{u}}
variable (j : X ⟶ NativeProjectiveScheme k N) [IsClosedImmersion j]

/-- The actual original whole kernel internally supplies this original homogeneous ideal. -/
def presentationIdeal : HomogeneousIdeal (ProjectiveGrading k N) :=
  (exists_original_closed_presentation j).choose

/-- The actual finite original homogeneous forms are selected internally from that producer. -/
def presentationForms : Finset (MvPolynomial (Fin (N + 1)) k) :=
  (exists_original_closed_presentation j).choose_spec.choose

private theorem presentation_spec :
    (∀ F ∈ presentationForms j, ∃ d : ℕ, F.IsHomogeneous d) ∧
      Ideal.span (presentationForms j : Set _) = (presentationIdeal j).toIdeal ∧
      ∃ e : X ≅ quotientScheme (presentationIdeal j), e.hom ≫ quotientEmbedding (presentationIdeal j) = j :=
  (exists_original_closed_presentation j).choose_spec.choose_spec

/-- The isomorphism has the SAME original scheme as source; it is not an input. -/
def presentationIso : X ≅ quotientScheme (presentationIdeal j) :=
  (presentation_spec j).2.2.choose

/-- The constructed presentation retains the entire original closed embedding. -/
theorem presentationIso_embedding :
    (presentationIso j).hom ≫ quotientEmbedding (presentationIdeal j) = j :=
  (presentation_spec j).2.2.choose_spec

/-- The internally produced finite family, indexed by the actual finite set itself. -/
def relations : {F : MvPolynomial (Fin (N + 1)) k // F ∈ presentationForms j} →
    MvPolynomial (Fin (N + 1)) k := fun F => F.1

/-- Every actual original relation is homogeneous, with its original degree. -/
theorem relations_homogeneous (i : {F : MvPolynomial (Fin (N + 1)) k // F ∈ presentationForms j}) :
    ∃ d : ℕ, (relations j i).IsHomogeneous d :=
  (presentation_spec j).1 i.1 i.2

/-- The ENTIRE original homogeneous ideal is generated by precisely this same actual family. -/
theorem relations_span : Ideal.span (Set.range (relations j)) = (presentationIdeal j).toIdeal := by
  have hr : Set.range (relations j) = (presentationForms j : Set _) := by
    ext F
    constructor
    · rintro ⟨i, rfl⟩
      exact i.2
    · intro hF
      exact ⟨⟨F, hF⟩, rfl⟩
  rw [hr]
  exact (presentation_spec j).2.1

variable (extra : Finset k)

/-- The arithmetic base is the literal coefficient subalgebra of the SAME original field. -/
def coefficientBase : Subalgebra ℤ k := ArithmeticCoefficientModel.coefficientRing (relations j) extra

/-- The base is genuinely finite type over the integers, using the actual finite original forms. -/
theorem coefficientBase_finiteType : Algebra.FiniteType ℤ (coefficientBase j extra) :=
  modelCoefficientRing_finiteType (relations j) extra

/-- The actual family is the literal homogeneous quotient model internally supplied by25. -/
def family : Scheme.{u} := modelScheme (relations j) (relations_homogeneous j) extra

/-- Its actual quotient closed projective embedding over the produced arithmetic base. -/
def familyEmbedding : family j extra ⟶ NativeProjectiveScheme (coefficientBase j extra) N :=
  modelEmbedding (relations j) (relations_homogeneous j) extra

/-- The closed immersion is derived from that actual quotient. -/
theorem familyEmbedding_isClosedImmersion : IsClosedImmersion (familyEmbedding j extra) :=
  modelEmbedding_isClosedImmersion (relations j) (relations_homogeneous j) extra

private instance familyEmbedding_closed : IsClosedImmersion (familyEmbedding j extra) :=
  familyEmbedding_isClosedImmersion j extra

/-- The whole family has its actual projection to the produced original-coefficient ring. -/
def familyProjection : family j extra ⟶ Spec (.of (coefficientBase j extra)) :=
  modelProjection (relations j) (relations_homogeneous j) extra

/-- The original quotient embedding internally gives this actual projective factorization. -/
theorem familyProjection_isProjectiveFactorization : IsProjectiveFactorization (familyProjection j extra) :=
  modelProjection_isProjectiveFactorization (relations j) (relations_homogeneous j) extra

/-- The same entire original family is genuinely proper over its arithmetic base. -/
theorem familyProjection_isProper : IsProper (familyProjection j extra) :=
  (familyProjection_isProjectiveFactorization j extra).isProper

/-- Its finite-type arithmetic base is Noetherian, so this actual family is locally finitely presented. -/
theorem familyProjection_locallyOfFinitePresentation : LocallyOfFinitePresentation (familyProjection j extra) := by
  let : Algebra.FiniteType ℤ (coefficientBase j extra) := coefficientBase_finiteType j extra
  let : IsNoetherianRing (coefficientBase j extra) := Algebra.FiniteType.isNoetherianRing ℤ _
  let : IsProper (familyProjection j extra) := familyProjection_isProper j extra
  infer_instance

/-- The ENTIRE original X maps to its actual constructed arithmetic family. -/
def originalMap : X ⟶ family j extra :=
  (presentationIso j).hom ≫ coefficientModelMap (relations j) (relations_homogeneous j) extra
    (presentationIdeal j) (relations_span j)

/-- The original closed embedding is preserved on the entire original schemes. -/
theorem originalMap_embedding :
    originalMap j extra ≫ familyEmbedding j extra =
      j ≫ nativeCoefficientMap (algebraMap (coefficientBase j extra) k) :=
  pasteTriangles _ _ _ _ _ _
    (coefficientModelMap_embedding (relations j) (relations_homogeneous j) extra
      (presentationIdeal j) (relations_span j)) (presentationIso_embedding j)

variable (p : X ⟶ Spec (.of k)) (hjp : j ≫ nativeStructureMap = p)

include hjp in
/-- This is the original structure morphism's WHOLE coefficient triangle, not a newly named base map. -/
theorem originalMap_overBase :
    originalMap j extra ≫ familyProjection j extra =
      p ≫ Spec.map (CommRingCat.ofHom (algebraMap (coefficientBase j extra) k)) :=
  pasteTriangles _ _ _ _ _ _
    (isPullback_coefficientModelMap (relations j) (relations_homogeneous j) extra
      (presentationIdeal j) (relations_span j)).w
    (projectionTriangle _ _ _ _ _ (presentationIso_embedding j) hjp)

/-- The actual whole ORIGINAL X, rather than only its quotient presentation, is the constructed coefficient fibre. -/
def familyBaseChangeIso : X ≅ pullback (familyProjection j extra)
    (Spec.map (CommRingCat.ofHom (algebraMap (coefficientBase j extra) k))) :=
  presentationIso j ≪≫ baseChangeIso (relations j) (relations_homogeneous j) extra
    (presentationIdeal j) (relations_span j)

/-- Its whole original-to-model projection is exactly the constructed original map. -/
theorem familyBaseChangeIso_hom_fst :
    (familyBaseChangeIso j extra).hom ≫ pullback.fst _ _ = originalMap j extra :=
  isoTrans_projection (presentationIso j) _ _ _
    (baseChangeIso_hom_fst (relations j) (relations_homogeneous j) extra
      (presentationIdeal j) (relations_span j))

include hjp in
/-- Its original-field projection is EXACTLY the SAME  given p. -/
theorem familyBaseChangeIso_hom_snd :
    (familyBaseChangeIso j extra).hom ≫ pullback.snd _ _ = p := by
  exact (isoTrans_projection (presentationIso j) _ _ _
    (baseChangeIso_hom_snd (relations j) (relations_homogeneous j) extra
      (presentationIdeal j) (relations_span j))).trans
    (projectionTriangle _ _ _ _ _ (presentationIso_embedding j) hjp)

include hjp in
/-- The entire original X square is genuinely cartesian, with the SAME original p. -/
theorem isPullback_originalMap :
    IsPullback (originalMap j extra) p (familyProjection j extra)
      (Spec.map (CommRingCat.ofHom (algebraMap (coefficientBase j extra) k))) :=
  IsPullback.of_iso_pullback ⟨originalMap_overBase j extra p hjp⟩ (familyBaseChangeIso j extra)
    (familyBaseChangeIso_hom_fst j extra) (familyBaseChangeIso_hom_snd j extra p hjp)

/-- The actual model line is the original pulled O(d), on this SAME internally constructed family. -/
def familyTwist (d : ℕ) : (family j extra).Modules :=
  modelTwist (relations j) (relations_homogeneous j) extra d

/-- Every original O(d) is recovered as a WHOLE sheaf on the entire original X. -/
def familyTwistPullbackIso (d : ℕ) :
    (Scheme.Modules.pullback (originalMap j extra)).obj (familyTwist j extra d) ≅
      (Scheme.Modules.pullback j).obj (coordinateHyperplaneTwist (R := k) (0 : Fin (N + 1)) (d : ℤ)) :=
  ((Scheme.Modules.pullbackComp (presentationIso j).hom
    (coefficientModelMap (relations j) (relations_homogeneous j) extra
      (presentationIdeal j) (relations_span j))).app _).symm ≪≫
  (Scheme.Modules.pullback (presentationIso j).hom).mapIso
    (twistPullbackIso (relations j) (relations_homogeneous j) extra (presentationIdeal j) (relations_span j) d) ≪≫
  (Scheme.Modules.pullbackComp (presentationIso j).hom (quotientEmbedding (presentationIdeal j))).app _ ≪≫
  (Scheme.Modules.pullbackCongr (presentationIso_embedding j)).app _

/-- The first line of this SAME actual original-scheme family is very ample. -/
theorem familyTwist_one_isVeryAmple :
    SchemeLineAmpleness.IsVeryAmple (familyProjection j extra) (familyTwist j extra 1) :=
  modelTwist_one_isVeryAmple (relations j) (relations_homogeneous j) extra

/-- The same actual first model line is ample. -/
theorem familyTwist_one_isAmple :
    SchemeLineAmpleness.IsAmple (familyProjection j extra) (familyTwist j extra 1) :=
  modelTwist_one_isAmple (relations j) (relations_homogeneous j) extra

end EnvelopeProperty.ArithmeticProjectiveOriginalFamily
