import Mathlib.RingTheory.Localization.Integral
import Mathlib.FieldTheory.Separable

/-!
# Constructing the separable specialization locus

Generic separability gives a Bezout identity for a polynomial and its derivative
over the fraction field. Clearing its actual coefficients constructs a nonzero
base element on whose principal open every field specialization is separable.
-/

open scoped Polynomial Classical
noncomputable section

namespace EnvelopeProperty.FcSeparableGoodLocus

variable {R K : Type*} [CommRing R] [IsDomain R] [Field K]
variable [Algebra R K] [IsFractionRing R K]

/-- Clearing the actual generic Bezout coefficients constructs a nonzero
constant in the ideal generated by the original polynomial and its derivative. -/
theorem exists_nonzero_bezout_derivative (P : R[X])
    (hsep : (P.map (algebraMap R K)).Separable) :
    ∃ g : R, g ≠ 0 ∧ ∃ U V : R[X], U * P + V * P.derivative = Polynomial.C g := by
  obtain ⟨U, V, hbez⟩ := (Polynomial.separable_def _).mp hsep
  let U₀ := IsLocalization.integerNormalization (nonZeroDivisors R) U
  let V₀ := IsLocalization.integerNormalization (nonZeroDivisors R) V
  obtain ⟨r, hr, hU⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors R) U
  obtain ⟨s, hs, hV⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors R) V
  rw [Algebra.smul_def, Polynomial.algebraMap_apply] at hU hV
  refine ⟨r * s, mul_ne_zero (nonZeroDivisors.ne_zero hr) (nonZeroDivisors.ne_zero hs),
    Polynomial.C s * U₀, Polynomial.C r * V₀, ?_⟩
  apply Polynomial.map_injective (algebraMap R K) (IsFractionRing.injective R K)
  simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
    ← Polynomial.derivative_map]
  rw [hU, hV]
  calc
    _ = Polynomial.C (algebraMap R K (r * s)) *
        (U * P.map (algebraMap R K) + V * (P.map (algebraMap R K)).derivative) := by
      rw [map_mul, Polynomial.C_mul]
      ring
    _ = _ := by rw [hbez, mul_one]

/-- A nonzero principal open where ALL actual field specializations are
separable, constructed from generic separability without a supplied good locus. -/
theorem exists_separable_principal_locus (P : R[X])
    (hsep : (P.map (algebraMap R K)).Separable) :
    ∃ g : R, g ≠ 0 ∧ ∀ (E : Type*) [Field E] (w : R →+* E),
      w g ≠ 0 → (P.map w).Separable := by
  obtain ⟨g, hg, U, V, hbez⟩ := exists_nonzero_bezout_derivative P hsep
  refine ⟨g, hg, ?_⟩
  intro E _ w hw
  have hmap := congrArg (Polynomial.map w) hbez
  simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
    ← Polynomial.derivative_map] at hmap
  rw [Polynomial.separable_def]
  refine ⟨Polynomial.C (w g)⁻¹ * U.map w, Polynomial.C (w g)⁻¹ * V.map w, ?_⟩
  calc
    _ = Polynomial.C (w g)⁻¹ *
        (U.map w * P.map w + V.map w * (P.map w).derivative) := by ring
    _ = Polynomial.C (w g)⁻¹ * Polynomial.C (w g) := by rw [hmap]
    _ = 1 := by rw [← Polynomial.C_mul, inv_mul_cancel₀ hw, Polynomial.C_1]

end EnvelopeProperty.FcSeparableGoodLocus
