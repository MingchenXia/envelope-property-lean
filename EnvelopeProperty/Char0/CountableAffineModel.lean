import Mathlib.RingTheory.Extension.Presentation.Core
import Mathlib.SetTheory.Cardinal.Subfield
import Mathlib.Data.Finsupp.Encodable
import Mathlib.RingTheory.Etale.Descent
import Mathlib.RingTheory.TensorProduct.Maps

/-! # Actual countable coefficient models preserving whole original affine ideals

The model is a literal polynomial quotient. Its scalar extension is identified
with the original algebra by the existing presentation tensor equivalence;
every original chosen element, and every ideal generated by a subfamily, is
read back under that same actual map. No model, smoothness-descent, or
multiplier-base-change certificate is an input.
-/

noncomputable section
open scoped TensorProduct Classical
namespace EnvelopeProperty.Char0.CountableAffineModel

universe u v w
variable {K : Type u} [Field K]

/-- A finite ORIGINAL polynomial family produces an actual countable subfield
and entire original-polynomial coefficient readbacks. -/
theorem exists_countable_polynomial_coefficients {σ : Type v} {ι : Type w} [Finite ι]
    (p : ι → MvPolynomial σ K) :
    ∃ F : Subfield K, Countable F ∧
      ∃ p₀ : ι → MvPolynomial σ F,
        ∀ i, MvPolynomial.map (algebraMap F K) (p₀ i) = p i := by
  let S : Set K := ⋃ i, ((p i).coeffs : Set K)
  have hS : S.Finite := Set.finite_iUnion fun i => (p i).coeffs.finite_toSet
  let F : Subfield K := Subfield.closure S
  have hF : Countable F := Cardinal.mk_le_aleph0_iff.mp
    ((Subfield.cardinalMk_closure_le_max S).trans
      (max_le hS.countable.le_aleph0 le_rfl))
  have hcoeff (i : ι) : ((p i).coeffs : Set K) ⊆ Set.range (algebraMap F K) := by
    intro c hc
    exact ⟨⟨c, Subfield.subset_closure (Set.mem_iUnion.mpr ⟨i, hc⟩)⟩, rfl⟩
  have hp (i : ι) : ∃ p₀ : MvPolynomial σ F,
      MvPolynomial.map (algebraMap F K) p₀ = p i :=
    MvPolynomial.mem_range_map_iff_coeffs_subset.mpr (hcoeff i)
  choose p₀ hp₀ using hp
  exact ⟨F, hF, p₀, hp₀⟩

variable {A : Type v} [CommRing A] [Algebra K A]

/-- An actual finite presentation and finite original family produce the literal
countable quotient, actual tensor isomorphism, whole polynomial readback and
WHOLE original ideal readbacks for every subfamily. -/
theorem exists_countable_presentation_model {n r : ℕ} {ι : Type w} [Finite ι]
    (P : Algebra.Presentation K A (Fin n) (Fin r)) (a : ι → A) :
    ∃ F : Subfield K, Countable F ∧
      ∃ Q : Fin r → MvPolynomial (Fin n) F,
      ∃ a₀ : ι → (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q)),
      ∃ E : (K ⊗[F] (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q))) ≃ₐ[K] A,
        (∀ j, MvPolynomial.map (algebraMap F K) (Q j) = P.relation j) ∧
        (∀ p : MvPolynomial (Fin n) F,
          E (1 ⊗ₜ[F] Ideal.Quotient.mk _ p) =
            MvPolynomial.aeval P.val (MvPolynomial.map (algebraMap F K) p)) ∧
        (∀ i, E (1 ⊗ₜ[F] a₀ i) = a i) ∧
        (∀ s : Set ι, (Ideal.span (a₀ '' s)).map
            (E.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom) =
          Ideal.span (a '' s)) ∧
        Algebra.FinitePresentation F (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q)) ∧
        Countable (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q)) := by
  let p : Fin r ⊕ ι → MvPolynomial (Fin n) K := Sum.elim P.relation (fun i => P.σ (a i))
  obtain ⟨F, hF, p₀, hp₀⟩ := exists_countable_polynomial_coefficients p
  let : Countable F := hF
  let : P.HasCoeffs F := ⟨by
    intro c hc
    obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hc
    exact (MvPolynomial.mem_range_map_iff_coeffs_subset.mp
      ⟨p₀ (.inl j), hp₀ (.inl j)⟩) hj⟩
  let Q := P.relationOfHasCoeffs F
  let A₀ := MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q)
  let a₀ : ι → A₀ := fun i => Ideal.Quotient.mk _ (p₀ (.inr i))
  let E : (K ⊗[F] A₀) ≃ₐ[K] A := P.tensorModelOfHasCoeffsEquiv F
  have hE (p' : MvPolynomial (Fin n) F) :
      E (1 ⊗ₜ[F] Ideal.Quotient.mk _ p') =
        MvPolynomial.aeval P.val (MvPolynomial.map (algebraMap F K) p') := by
    rw [MvPolynomial.aeval_map_algebraMap K]
    exact (P.tensorModelOfHasCoeffsEquiv_tmul F 1 p').trans (by simp)
  have ha (i : ι) : E (1 ⊗ₜ[F] a₀ i) = a i := by
    rw [hE, hp₀ (.inr i)]
    exact P.aeval_val_σ (a i)
  let : Countable (AddMonoidAlgebra F (Fin n →₀ ℕ)) :=
    Function.Surjective.countable (f := AddMonoidAlgebra.ofCoeff) fun p => ⟨p.coeff, rfl⟩
  let : Countable (MvPolynomial (Fin n) F) := this
  refine ⟨F, hF, Q, a₀, E, P.map_relationOfHasCoeffs F, hE, ha, ?_, inferInstance,
    (Ideal.Quotient.mk_surjective).countable⟩
  intro s
  rw [Ideal.map_span, Set.image_image]
  congr 1
  congr 1
  funext i
  exact ha i

/-- The finite-type ORIGINAL algebra internally produces the actual finite
presentation, countable quotient tensor model and exact readback of every whole
ideal generated by a chosen original subfamily. -/
theorem exists_countable_affine_model {ι : Type w} [Finite ι]
    [Algebra.FiniteType K A] (a : ι → A) :
    ∃ F : Subfield K, Countable F ∧
      ∃ (n r : ℕ) (Q : Fin r → MvPolynomial (Fin n) F),
      ∃ a₀ : ι → (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q)),
      ∃ E : (K ⊗[F] (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q))) ≃ₐ[K] A,
        (∀ i, E (1 ⊗ₜ[F] a₀ i) = a i) ∧
        (∀ s : Set ι, (Ideal.span (a₀ '' s)).map
            (E.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom) =
          Ideal.span (a '' s)) ∧
        Algebra.FinitePresentation F (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q)) ∧
        Countable (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q)) := by
  let : Algebra.FinitePresentation K A := Algebra.FinitePresentation.of_finiteType.mp inferInstance
  obtain ⟨n, r, ⟨P⟩⟩ := Algebra.Presentation.exists_presentation_fin K A
  obtain ⟨F, hF, Q, a₀, E, _, _, ha, hspan, hFP, hcount⟩ :=
    exists_countable_presentation_model P a
  exact ⟨F, hF, n, r, Q, a₀, E, ha, hspan, hFP, hcount⟩

/-- The actual requested tensor order uses its genuine right-factor K-algebra,
with exactly the SAME original tensor isomorphism. -/
def rightTensorEquiv {F : Type*} [Field F] [Algebra F K]
    {A₀ : Type*} [CommRing A₀] [Algebra F A₀]
    (E : (K ⊗[F] A₀) ≃ₐ[K] A) :
    letI := Algebra.TensorProduct.rightAlgebra (R := F) (A := A₀) (B := K)
    (A₀ ⊗[F] K) ≃ₐ[K] A := by
  letI := Algebra.TensorProduct.rightAlgebra (R := F) (A := A₀) (B := K)
  exact (Algebra.TensorProduct.commRight F K A₀).symm.trans E

/-- Every pure tensor, including the WHOLE original generator readback,
is preserved under the requested tensor order. -/
theorem rightTensorEquiv_tmul {F : Type*} [Field F] [Algebra F K]
    {A₀ : Type*} [CommRing A₀] [Algebra F A₀]
    (E : (K ⊗[F] A₀) ≃ₐ[K] A) (b : A₀) (c : K) :
    rightTensorEquiv E (b ⊗ₜ[F] c) = E (c ⊗ₜ[F] b) := rfl

/-- Actual original smoothness and integrality descend along the SAME literal
model tensor isomorphism; no model smoothness or domain certificate is supplied. -/
theorem exists_countable_smooth_domain_model {ι : Type w} [Finite ι]
    [Algebra.Smooth K A] [IsDomain A] (a : ι → A) :
    ∃ F : Subfield K, Countable F ∧
      ∃ (n r : ℕ) (Q : Fin r → MvPolynomial (Fin n) F),
      ∃ a₀ : ι → (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q)),
      ∃ E : (K ⊗[F] (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q))) ≃ₐ[K] A,
        (∀ i, E (1 ⊗ₜ[F] a₀ i) = a i) ∧
        (∀ s : Set ι, (Ideal.span (a₀ '' s)).map
            (E.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom) =
          Ideal.span (a '' s)) ∧
        Algebra.FinitePresentation F (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q)) ∧
        Countable (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q)) ∧
        Algebra.Smooth F (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q)) ∧
        IsDomain (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q)) := by
  obtain ⟨F, hF, n, r, Q, a₀, E, ha, hspan, hFP, hcount⟩ := exists_countable_affine_model (K := K) a
  let A₀ := MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q)
  let : CommRing A₀ := inferInstanceAs (CommRing
    (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q)))
  let : Algebra F A₀ := inferInstanceAs (Algebra F
    (MvPolynomial (Fin n) F ⧸ Ideal.span (Set.range Q)))
  let : Algebra.Smooth K (K ⊗[F] A₀) := Algebra.Smooth.of_equiv (R := K) E.symm
  have hsm : Algebra.Smooth F A₀ :=
    Algebra.Smooth.of_smooth_tensorProduct_of_faithfullyFlat K
  let δ : A₀ →+* A := E.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom
  have hδ : Function.Injective δ := E.injective.comp
    (Algebra.TensorProduct.includeRight_injective (algebraMap F K).injective)
  have hdom : IsDomain A₀ := Function.Injective.isDomain δ hδ
  exact ⟨F, hF, n, r, Q, a₀, E, ha, hspan, hFP, hcount, hsm, hdom⟩

end EnvelopeProperty.Char0.CountableAffineModel
