import Mathlib

/-!
# Tensor products of domains over an algebraically closed field

This file formalizes `lem:c0-tensor-domain` of the blueprint chapter `char0.tex` (the
characteristic-zero route to Fang–Han–Xia, *The envelope property for unibranch projective
varieties*, Theorem 3.1 on `ℙⁿ`): if `k` is an algebraically closed field and `A`, `B` are
`k`-algebras which are domains, then `A ⊗[k] B` is a domain.

Mathlib (v4.33.1) has the statement only under linear disjointness hypotheses
(`Subalgebra.LinearDisjoint.isDomain`), so we prove it here, following the Nullstellensatz proof
of the blueprint.

## Main results

* `EnvelopeProperty.eq_zero_of_forall_algHom_eq_zero`: in a finitely generated reduced algebra
  over an algebraically closed field `k`, an element on which every `k`-point vanishes is `0`
  (Hilbert's Nullstellensatz, via Jacobson rings and Zariski's lemma).
* `EnvelopeProperty.mul_eq_zero_of_finiteType`: the case of a finitely generated domain `A`. Write
  `α = ∑ aᵢ ⊗ eᵢ`, `β = ∑ cⱼ ⊗ eⱼ` in a `k`-basis `(eᵢ)` of `B`. Every `k`-point `χ` of `A` gives a
  `k`-algebra map `χ ⊗ id : A ⊗ B → B` into the domain `B`, so `χ` kills all `aᵢ` or all `cⱼ`;
  hence `χ(aᵢ cⱼ) = 0` for all `χ` and the Nullstellensatz gives `aᵢ cⱼ = 0`.
* `EnvelopeProperty.isDomain_tensorProduct_of_isAlgClosed` (`lem:c0-tensor-domain`): the general
  case, by reduction to the finitely generated subalgebra generated by the coefficients
  (`A₀ ⊗ B → A ⊗ B` is injective since `B` is flat over the field `k`). It is also registered as
  an instance.
-/

open scoped TensorProduct

noncomputable section

namespace EnvelopeProperty

variable {k : Type*} [Field k]

/-- **Nullstellensatz.** In a finitely generated reduced algebra `A` over an algebraically closed
field `k`, an element `a` with `χ a = 0` for every `k`-algebra map `χ : A → k` is zero. -/
theorem eq_zero_of_forall_algHom_eq_zero [IsAlgClosed k] {A : Type*} [CommRing A] [Algebra k A]
    [Algebra.FiniteType k A] [IsReduced A] {a : A} (h : ∀ χ : A →ₐ[k] k, χ a = 0) : a = 0 := by
  have hJ : IsJacobsonRing A := isJacobsonRing_of_finiteType (A := k)
  have hrad : (⊥ : Ideal A).IsRadical := by
    intro x hx
    obtain ⟨n, hn⟩ := hx
    exact (IsReduced.eq_zero x ⟨n, (Ideal.mem_bot.1 hn)⟩).symm ▸ Ideal.zero_mem _
  suffices ha : a ∈ (⊥ : Ideal A).jacobson by
    rwa [IsJacobsonRing.out hJ hrad, Ideal.mem_bot] at ha
  rw [Ideal.jacobson, Submodule.mem_sInf]
  rintro m ⟨-, hm⟩
  let : Field (A ⧸ m) := Ideal.Quotient.field m
  have : Module.Finite k (A ⧸ m) := finite_of_finite_type_of_isJacobsonRing k (A ⧸ m)
  have hbij : Function.Bijective (algebraMap k (A ⧸ m)) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  let e : k ≃ₐ[k] A ⧸ m := AlgEquiv.ofBijective (Algebra.ofId k (A ⧸ m)) hbij
  have h1 := h (e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ k m))
  rw [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, map_eq_zero_iff _ e.symm.injective,
    Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem] at h1
  exact h1

variable {A : Type*} [CommRing A] [Algebra k A] {B : Type*} [CommRing B] [Algebra k B]

/-- The `k`-algebra map `χ ⊗ id : A ⊗[k] B → B`, `a ⊗ b ↦ χ(a) b`, attached to a `k`-point `χ`
of `A`. -/
def evalTensor (χ : A →ₐ[k] k) : A ⊗[k] B →ₐ[k] B :=
  Algebra.TensorProduct.lift ((Algebra.ofId k B).comp χ) (AlgHom.id k B)
    fun _ _ => Commute.all _ _

/-- `(χ ⊗ id)(a ⊗ b) = χ(a) b`. -/
theorem evalTensor_tmul (χ : A →ₐ[k] k) (a : A) (b : B) :
    evalTensor χ (a ⊗ₜ[k] b) = χ a • b := by
  rw [evalTensor, Algebra.TensorProduct.lift_tmul, AlgHom.comp_apply, AlgHom.id_apply,
    Algebra.ofId_apply, Algebra.smul_def]

/-- In a `k`-basis `ℬ` of `B`, `(χ ⊗ id)(∑ aᵢ ⊗ ℬᵢ) = 0` if and only if `χ(aᵢ) = 0` for all `i`. -/
theorem evalTensor_sum_eq_zero_iff {ι : Type*} (ℬ : Module.Basis ι k B) (χ : A →ₐ[k] k)
    (a : ι →₀ A) :
    evalTensor χ (a.sum fun i m => m ⊗ₜ[k] ℬ i) = 0 ↔ ∀ i, χ (a i) = 0 := by
  have hsum : evalTensor χ (a.sum fun i m => m ⊗ₜ[k] ℬ i) =
      Finsupp.linearCombination k ℬ (a.mapRange χ (map_zero χ)) := by
    rw [map_finsuppSum, Finsupp.linearCombination_apply,
      Finsupp.sum_mapRange_index (fun i => zero_smul k (ℬ i))]
    exact Finsupp.sum_congr fun i _ => evalTensor_tmul χ (a i) (ℬ i)
  rw [hsum]
  constructor
  · intro h i
    have := linearIndependent_iff.1 ℬ.linearIndependent _ h
    simpa using DFunLike.congr_fun this i
  · intro h
    have : a.mapRange χ (map_zero χ) = 0 := by
      ext i
      simpa using h i
    rw [this, map_zero]

variable [IsDomain A] [IsDomain B]

/-- `lem:c0-tensor-domain` for a finitely generated domain `A`: `A ⊗[k] B` has no zero
divisors. -/
theorem mul_eq_zero_of_finiteType [IsAlgClosed k] [Algebra.FiniteType k A] {α β : A ⊗[k] B}
    (h : α * β = 0) : α = 0 ∨ β = 0 := by
  let ℬ := Module.Free.chooseBasis k B
  obtain ⟨a, rfl⟩ := TensorProduct.eq_repr_basis_right ℬ α
  obtain ⟨c, rfl⟩ := TensorProduct.eq_repr_basis_right ℬ β
  -- Every `k`-point kills all `aᵢ` or all `cⱼ`.
  have key : ∀ χ : A →ₐ[k] k, (∀ i, χ (a i) = 0) ∨ (∀ j, χ (c j) = 0) := by
    intro χ
    have h0 := congrArg (evalTensor (B := B) χ) h
    rw [map_mul, map_zero] at h0
    rcases mul_eq_zero.1 h0 with h1 | h1
    · exact Or.inl ((evalTensor_sum_eq_zero_iff ℬ χ a).1 h1)
    · exact Or.inr ((evalTensor_sum_eq_zero_iff ℬ χ c).1 h1)
  have hac : ∀ i j, a i * c j = 0 := by
    intro i j
    refine eq_zero_of_forall_algHom_eq_zero (k := k) fun χ => ?_
    rw [map_mul]
    rcases key χ with h1 | h1
    · rw [h1 i, zero_mul]
    · rw [h1 j, mul_zero]
  by_cases ha : a = 0
  · left
    simp [ha]
  · right
    obtain ⟨i, hi⟩ : ∃ i, a i ≠ 0 := by
      by_contra! hcon
      exact ha (Finsupp.ext hcon)
    have hc : c = 0 := Finsupp.ext fun j => (mul_eq_zero.1 (hac i j)).resolve_left hi
    simp [hc]

omit [IsDomain A] [IsDomain B] in
/-- `A₀ ⊗[k] B → A ⊗[k] B` is injective for a subalgebra `A₀ ⊆ A` (`B` is flat over the field
`k`). -/
theorem map_val_tensor_injective (A₀ : Subalgebra k A) :
    Function.Injective (Algebra.TensorProduct.map A₀.val (AlgHom.id k B)) :=
  Module.Flat.rTensor_preserves_injective_linearMap (M := B) A₀.val.toLinearMap
    Subtype.val_injective

omit [IsDomain A] [IsDomain B] in
/-- An element `∑ aᵢ ⊗ ℬᵢ` of `A ⊗[k] B` comes from `A₀ ⊗[k] B` when all `aᵢ ∈ A₀`. -/
theorem exists_preimage_map_val {ι : Type*} (ℬ : ι → B) (A₀ : Subalgebra k A) (a : ι →₀ A)
    (ha : ∀ i, a i ∈ A₀) :
    ∃ α₀ : A₀ ⊗[k] B, Algebra.TensorProduct.map A₀.val (AlgHom.id k B) α₀ =
      a.sum fun i m => m ⊗ₜ[k] ℬ i := by
  refine ⟨∑ i ∈ a.support, (⟨a i, ha i⟩ : A₀) ⊗ₜ[k] ℬ i, ?_⟩
  rw [map_sum, Finsupp.sum]
  rfl

/-- **`lem:c0-tensor-domain`.** If `k` is algebraically closed and `A`, `B` are `k`-algebras which
are domains, then `A ⊗[k] B` is a domain. -/
theorem isDomain_tensorProduct_of_isAlgClosed [IsAlgClosed k] : IsDomain (A ⊗[k] B) := by
  have : Nontrivial (A ⊗[k] B) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain k A B
      (algebraMap k A).injective (algebraMap k B).injective
  have : NoZeroDivisors (A ⊗[k] B) := by
    refine ⟨fun {α β} h => ?_⟩
    let ℬ := Module.Free.chooseBasis k B
    obtain ⟨a, rfl⟩ := TensorProduct.eq_repr_basis_right ℬ α
    obtain ⟨c, rfl⟩ := TensorProduct.eq_repr_basis_right ℬ β
    classical
    let A₀ := Algebra.adjoin k ((a.frange ∪ c.frange : Finset A) : Set A)
    have : Algebra.FiniteType k A₀ := Algebra.FiniteType.adjoin_of_finite (Finset.finite_toSet _)
    have hmem : ∀ (f : Module.Free.ChooseBasisIndex k B →₀ A),
        f.frange ⊆ a.frange ∪ c.frange → ∀ i, f i ∈ A₀ := by
      intro f hf i
      by_cases hi : f i = 0
      · rw [hi]; exact Subalgebra.zero_mem _
      · refine Algebra.subset_adjoin (Finset.mem_coe.2 (hf ?_))
        exact Finsupp.mem_frange.2 ⟨hi, i, rfl⟩
    obtain ⟨α₀, hα⟩ := exists_preimage_map_val ℬ A₀ a (hmem a Finset.subset_union_left)
    obtain ⟨β₀, hβ⟩ := exists_preimage_map_val ℬ A₀ c (hmem c Finset.subset_union_right)
    have h0 : α₀ * β₀ = 0 := map_val_tensor_injective A₀ (by rw [map_mul, hα, hβ, h, map_zero])
    rcases mul_eq_zero_of_finiteType h0 with h1 | h1
    · left; rw [← hα, h1, map_zero]
    · right; rw [← hβ, h1, map_zero]
  exact NoZeroDivisors.to_isDomain _

instance instIsDomainTensorProductOfIsAlgClosed [IsAlgClosed k] : IsDomain (A ⊗[k] B) :=
  isDomain_tensorProduct_of_isAlgClosed

end EnvelopeProperty
