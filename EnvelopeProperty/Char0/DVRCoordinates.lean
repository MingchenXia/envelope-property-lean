import EnvelopeProperty.Char0.DVRCurve

/-!
# A primitive coordinate at a divisor

In the setting of `EnvelopeProperty.Char0.DVRCurve` (`V` a discrete valuation ring with fraction
field `K`, essentially of finite type over a field `L` of characteristic `0`, with `κ_V` algebraic
over `L`, uniformizer `π`, `A = L[π]_{(π)} = V ∩ L(π)`, `B` the integral closure of `A` in `K`,
`𝔫 = m_V ∩ B`), this file proves the blueprint lemma `lem:c0-dvr-primitive` (`char0.tex`): there
is `θ ∈ B` such that

1. `K = L(π)(θ)`, and the residue `ξ = θ̄ ∈ κ_V` is nonzero and generates `κ_V` over `L`;
2. the minimal polynomial `F_θ` of `θ` over `L(π)` lies in `A[T]`, and its reduction modulo `π` is
   `F̄_θ = G · T^e` with `G` the (separable) minimal polynomial of `ξ` over `L`, `G(0) ≠ 0`;
3. `V = A[θ]_{𝔫'}`: every `x ∈ V` is `P(θ)/S(θ)` with `P, S ∈ A[T]` and `S(θ)` a unit of `V`.

These are the coordinates `(π, u, θ)` used by the analytic chart `lem:c0-analytic-chart` for the
valuative bound in the characteristic-zero proof of FHX Theorem 3.1 (Fang–Han–Xia, *The envelope
property for unibranch projective varieties*, §3).

## Main results

* `EnvelopeProperty.Char0.exists_span_curveBPi_eq_mul`: `πB = 𝔫 J` with `𝔫 + J = B` (`𝔫` is
  unramified over `πA`, since `𝔫 B_𝔫 = π B_𝔫`).
* `EnvelopeProperty.Char0.charpoly_mulLeft_eq_minpoly`: `F_θ` is the characteristic polynomial of
  multiplication by `θ` on the free `A`-module `B`.
* `EnvelopeProperty.Char0.map_minpoly_curveResidue`: the reduction `F̄_θ` is the characteristic
  polynomial of `θ` on `B/πB ≅ B/𝔫 × B/J`, that is `G · T^{dim B/J}`.
* `EnvelopeProperty.Char0.IsPrimitiveCoordinate`: the properties (1)–(3), and
  `EnvelopeProperty.Char0.exists_isPrimitiveCoordinate`: such a `θ` exists.

## Implementation notes

The blueprint chooses `θ ≡ ξ (mod 𝔫₁)`, `θ ∈ 𝔫ⱼ` (`j ≥ 2`), and decomposes
`B/πB ≅ ∏ B/𝔫ⱼ^{eⱼ}`. Here the factorization `πB = 𝔫 J` with `𝔫 + J = B` is used instead: `θ ≡ ξ`
modulo `𝔫` and `θ ∈ J`, so `θ` acts by `0` on `B/J` and `B/πB ≅ B/𝔫 × B/J` gives `F̄_θ = G T^e`
directly. The primitive element is found as `θ₁ + mπb` with `m ∈ ℕ` (pigeonhole over the finitely
many intermediate fields of `K/L(π)`) and `b ∈ B` primitive. Part (3) uses Mathlib's conductor
formula `conductor_mul_differentIdeal`: `F_θ'(θ) B ⊆ A[θ]`, and `F_θ'(θ)` is a unit of `V` because
its residue `G'(ξ) ξ^e` is nonzero; this replaces the blueprint's computation of the maximal ideal
of `A[θ]_{𝔫'}`.
-/

noncomputable section

open scoped NNReal ENNReal Topology Polynomial IntermediateField

open Polynomial IsLocalRing

namespace EnvelopeProperty.Char0

/-! ### Reduction of characteristic polynomials (abstract setting)

`A` is an `L`-algebra with a retraction `ρ : A → L` whose kernel is generated by `ϖ`, and `B` is a
free `A`-module of finite rank which is an `L`-algebra compatibly. -/

section Reduction

variable {L A B : Type*} [Field L] [CommRing A] [CommRing B] [Algebra L A] [Algebra A B]
  [Algebra L B] [IsScalarTower L A B]
  (ρ : A →+* L) (hρ : ∀ ℓ : L, ρ (algebraMap L A ℓ) = ℓ) (ϖ : A)
  (hϖ : ∀ a : A, ∃ d : A, a - algebraMap L A (ρ a) = d * ϖ) (hρϖ : ρ ϖ = 0)

include hϖ in
/-- `a β ≡ ρ(a) β (mod ϖB)`. -/
theorem mk_smul_eq_smul_mk (a : A) (β : B) :
    Ideal.Quotient.mk (Ideal.span {algebraMap A B ϖ}) (a • β) =
      ρ a • Ideal.Quotient.mk (Ideal.span {algebraMap A B ϖ}) β := by
  set I := Ideal.span {algebraMap A B ϖ}
  have h1 : ρ a • Ideal.Quotient.mk I β = Ideal.Quotient.mk I (algebraMap L A (ρ a) • β) := by
    rw [algebraMap_smul]
    rfl
  rw [h1, Ideal.Quotient.eq, ← sub_smul]
  obtain ⟨d, hd⟩ := hϖ a
  rw [hd, Ideal.mem_span_singleton]
  refine ⟨d • β, ?_⟩
  rw [Algebra.smul_def, Algebra.smul_def, map_mul]
  ring

include hϖ in
/-- The reductions modulo `ϖ` of an `A`-basis of `B` span `B/ϖB` over `L`. -/
theorem span_reduction_eq_top {ι : Type*} [Fintype ι] (bA : Module.Basis ι A B) :
    ⊤ ≤ Submodule.span L
      (Set.range fun i => Ideal.Quotient.mk (Ideal.span {algebraMap A B ϖ}) (bA i)) := by
  rintro q -
  obtain ⟨β, rfl⟩ := Ideal.Quotient.mk_surjective q
  rw [← bA.sum_repr β, map_sum]
  refine Submodule.sum_mem _ fun i _ => ?_
  rw [mk_smul_eq_smul_mk ρ ϖ hϖ]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

include hρ hϖ hρϖ in
/-- The reductions modulo `ϖ` of an `A`-basis of `B` are linearly independent over `L`. -/
theorem linearIndependent_reduction {ι : Type*} [Fintype ι] (bA : Module.Basis ι A B) :
    LinearIndependent L (fun i => Ideal.Quotient.mk (Ideal.span {algebraMap A B ϖ}) (bA i)) := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro g hg i
  have h1 : ∑ j, algebraMap L A (g j) • bA j ∈ Ideal.span {algebraMap A B ϖ} := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sum]
    convert hg using 2 with j
    rw [mk_smul_eq_smul_mk ρ ϖ hϖ, hρ]
  obtain ⟨γ, hγ⟩ := Ideal.mem_span_singleton'.1 h1
  have h2 : γ * algebraMap A B ϖ = ∑ j, (bA.repr γ j * ϖ) • bA j := by
    conv_lhs => rw [← bA.sum_repr γ]
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Algebra.smul_def, Algebra.smul_def, map_mul]
    ring
  rw [h2] at hγ
  have h3 := congrArg (fun x => bA.repr x i) hγ
  simp only [Module.Basis.repr_sum_self] at h3
  have h4 := congrArg ρ h3
  rw [hρ, map_mul, hρϖ, mul_zero] at h4
  exact h4.symm

/-- The `L`-basis of `B/ϖB` obtained by reducing an `A`-basis of `B`. -/
def reductionBasis {ι : Type*} [Fintype ι] (bA : Module.Basis ι A B) :
    Module.Basis ι L (B ⧸ Ideal.span {algebraMap A B ϖ}) :=
  Module.Basis.mk (linearIndependent_reduction ρ hρ ϖ hϖ hρϖ bA)
    (span_reduction_eq_top ρ ϖ hϖ bA)

theorem reductionBasis_apply {ι : Type*} [Fintype ι] (bA : Module.Basis ι A B) (i : ι) :
    reductionBasis ρ hρ ϖ hϖ hρϖ bA i = Ideal.Quotient.mk (Ideal.span {algebraMap A B ϖ}) (bA i) :=
  Module.Basis.mk_apply _ _ _

/-- **The matrix of `θ` on `B/ϖB` is the reduction of its matrix on `B`.** -/
theorem leftMulMatrix_reductionBasis {ι : Type*} [Fintype ι] [DecidableEq ι]
    (bA : Module.Basis ι A B) (θ : B) :
    Algebra.leftMulMatrix (reductionBasis ρ hρ ϖ hϖ hρϖ bA)
        (Ideal.Quotient.mk (Ideal.span {algebraMap A B ϖ}) θ) =
      (Algebra.leftMulMatrix bA θ).map ρ := by
  ext i j
  rw [Algebra.leftMulMatrix_eq_repr_mul, Matrix.map_apply, Algebra.leftMulMatrix_eq_repr_mul,
    reductionBasis_apply, ← map_mul]
  conv_lhs => rw [← bA.sum_repr (θ * bA j), map_sum]
  simp only [mk_smul_eq_smul_mk ρ ϖ hϖ, ← reductionBasis_apply ρ hρ ϖ hϖ hρϖ bA,
    Module.Basis.repr_sum_self]

include hρ hϖ hρϖ in
/-- **Reduction of characteristic polynomials**: the reduction modulo `ϖ` of the characteristic
polynomial of `θ` on `B` is the characteristic polynomial of `θ` on `B/ϖB` over `L`. -/
theorem map_charpoly_mulLeft [Module.Free A B] [Module.Finite A B]
    [Module.Finite L (B ⧸ Ideal.span {algebraMap A B ϖ})] (θ : B) :
    (LinearMap.mulLeft A θ).charpoly.map ρ =
      (LinearMap.mulLeft L (Ideal.Quotient.mk (Ideal.span {algebraMap A B ϖ}) θ)).charpoly := by
  classical
  let bA := Module.Free.chooseBasis A B
  rw [← LinearMap.charpoly_toMatrix _ bA, Algebra.toMatrix_lmul_eq, ← Matrix.charpoly_map,
    ← leftMulMatrix_reductionBasis ρ hρ ϖ hϖ hρϖ bA, ← Algebra.toMatrix_lmul_eq,
    LinearMap.charpoly_toMatrix]

end Reduction

/-! ### Characteristic polynomials on a product (abstract setting) -/

section CRT

variable {L B κ : Type*} [Field L] [CommRing B] [Algebra L B] [Field κ] [Algebra L κ]

/-- The characteristic polynomial of multiplication by a primitive element of a finite field
extension is its minimal polynomial. -/
theorem charpoly_mulLeft_eq_minpoly_of_adjoin_eq_top [FiniteDimensional L κ] {x : κ}
    (hx : L⟮x⟯ = ⊤) : (LinearMap.mulLeft L x).charpoly = minpoly L x := by
  have hint : IsIntegral L x := .of_finite L x
  have hCH : aeval x (LinearMap.mulLeft L x).charpoly = 0 := by
    have h := LinearMap.aeval_self_charpoly (LinearMap.mulLeft L x)
    have h2 := Polynomial.aeval_algHom_apply (Algebra.lmul L κ) x (LinearMap.mulLeft L x).charpoly
    rw [Algebra.coe_lmul_eq_mul] at h2
    change aeval (LinearMap.mulLeft L x) _ = _ at h2
    rw [h2] at h
    simpa using congrArg (fun f => f 1) h
  refine Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hint)
    (LinearMap.charpoly_monic _) (minpoly.dvd L x hCH) ?_
  rw [LinearMap.charpoly_natDegree, ← IntermediateField.finrank_top', ← hx,
    IntermediateField.adjoin.finrank hint]

/-- **The characteristic polynomial of `θ` on `B/(𝔫 ∩ J) ≅ B/𝔫 × B/J`.** If `f : B → κ` is a
surjection onto a finite field extension of `L` with kernel `𝔫`, `𝔫 + J = B`, `θ ∈ J` and `f(θ)`
generates `κ`, then the characteristic polynomial of `θ` on `B/(𝔫 ∩ J)` is `minpoly(f θ) T^e`,
`e = dim_L B/J`. -/
theorem charpoly_mulLeft_quotient_inf [FiniteDimensional L κ] (f : B →ₐ[L] κ)
    (hf : Function.Surjective f) (J : Ideal B) (hcop : RingHom.ker f ⊔ J = ⊤) (I : Ideal B)
    (hI : I = RingHom.ker f ⊓ J) [Module.Finite L (B ⧸ I)] {θ : B} (hθ : θ ∈ J)
    (hξ : L⟮f θ⟯ = ⊤) :
    (LinearMap.mulLeft L (Ideal.Quotient.mk I θ)).charpoly =
      minpoly L (f θ) * X ^ Module.finrank L (B ⧸ J) := by
  subst hI
  set n := RingHom.ker f
  let eR := Ideal.quotientInfEquivQuotientProd n J (Ideal.isCoprime_iff_sup_eq.2 hcop)
  have heR : ∀ x : B, eR (Ideal.Quotient.mk (n ⊓ J) x) =
      (Ideal.Quotient.mk n x, Ideal.Quotient.mk J x) := by
    intro x
    ext
    · rw [Ideal.quotientInfEquivQuotientProd_fst, Ideal.Quotient.factor_mk]
    · rw [Ideal.quotientInfEquivQuotientProd_snd, Ideal.Quotient.factor_mk]
  let eA : (B ⧸ n ⊓ J) ≃ₐ[L] (B ⧸ n) × (B ⧸ J) :=
    AlgEquiv.ofRingEquiv (f := eR) fun c => by
      rw [← Ideal.Quotient.mk_algebraMap, heR, Prod.algebraMap_apply,
        Ideal.Quotient.mk_algebraMap, Ideal.Quotient.mk_algebraMap]
  have heA : ∀ x : B, eA (Ideal.Quotient.mk (n ⊓ J) x) =
      (Ideal.Quotient.mk n x, Ideal.Quotient.mk J x) := heR
  have : Module.Finite L (B ⧸ n) :=
    Module.Finite.of_surjective ((LinearMap.fst L _ _).comp eA.toLinearEquiv.toLinearMap)
      fun y => ⟨eA.symm (y, 0), by simp⟩
  have : Module.Finite L (B ⧸ J) :=
    Module.Finite.of_surjective ((LinearMap.snd L _ _).comp eA.toLinearEquiv.toLinearMap)
      fun y => ⟨eA.symm (0, y), by simp⟩
  -- conjugate by the Chinese remainder isomorphism
  have hconj : eA.toLinearEquiv.conj (LinearMap.mulLeft L (Ideal.Quotient.mk (n ⊓ J) θ)) =
      (LinearMap.mulLeft L (Ideal.Quotient.mk n θ)).prodMap
        (LinearMap.mulLeft L (Ideal.Quotient.mk J θ)) := by
    apply LinearMap.ext
    intro z
    rw [LinearEquiv.conj_apply_apply]
    change eA (Ideal.Quotient.mk (n ⊓ J) θ * eA.symm z) = _
    rw [map_mul, heA, AlgEquiv.apply_symm_apply]
    rfl
  have hθ0 : Ideal.Quotient.mk J θ = 0 := Ideal.Quotient.eq_zero_iff_mem.2 hθ
  rw [← LinearEquiv.charpoly_conj eA.toLinearEquiv, hconj, LinearMap.charpoly_prodMap, hθ0,
    LinearMap.mulLeft_zero_eq_zero, LinearMap.charpoly_zero]
  congr 1
  -- the factor `B/𝔫 ≅ κ`
  let φ := Ideal.quotientKerAlgEquivOfSurjective hf
  have hconj' : φ.toLinearEquiv.conj (LinearMap.mulLeft L (Ideal.Quotient.mk n θ)) =
      LinearMap.mulLeft L (f θ) := by
    apply LinearMap.ext
    intro z
    rw [LinearEquiv.conj_apply_apply]
    change φ (Ideal.Quotient.mk n θ * φ.symm z) = f θ * z
    rw [map_mul, AlgEquiv.apply_symm_apply, Ideal.quotientKerAlgEquivOfSurjective_mk]
  rw [← LinearEquiv.charpoly_conj φ.toLinearEquiv, hconj',
    charpoly_mulLeft_eq_minpoly_of_adjoin_eq_top hξ]

end CRT

section Primitive

variable {L K : Type*} [Field L] [Field K] [Algebra L K]
variable (V : Subalgebra L K) (π : V) [hπ : Fact (Irreducible π)] [IsDiscreteValuationRing V]
  [IsFractionRing V K] [Algebra.EssFiniteType L V] [Algebra.IsAlgebraic L (ResidueField V)]
  [CharZero L]

omit [Algebra.EssFiniteType L V] [Algebra.IsAlgebraic L (ResidueField V)] [CharZero L] in
/-- Elements of `𝔫` are divisible by `π` in `V`. -/
theorem pi_dvd_of_mem_curveIdeal {b : curveB V π} (hb : b ∈ curveIdeal V π) :
    π ∣ curveBToV V π b := by
  rw [← Ideal.mem_span_singleton, ← (IsDiscreteValuationRing.irreducible_iff_uniformizer π).1
    hπ.out]
  exact (mem_curveIdeal V π).1 hb

omit [Algebra.EssFiniteType L V] [Algebra.IsAlgebraic L (ResidueField V)] [CharZero L] in
/-- `π ∉ 𝔫²`: the prime `𝔫` is unramified over `πA`. -/
theorem curveBPi_not_mem_sq : curveBPi V π ∉ curveIdeal V π ^ 2 := by
  intro h
  have key : ∀ y ∈ curveIdeal V π ^ 2, π ^ 2 ∣ curveBToV V π y := by
    intro y hy
    rw [pow_two] at hy
    refine Submodule.mul_induction_on hy ?_ ?_
    · intro a ha b hb
      rw [RingHom.map_mul, pow_two]
      exact mul_dvd_mul (pi_dvd_of_mem_curveIdeal V π ha) (pi_dvd_of_mem_curveIdeal V π hb)
    · intro x y hx hy
      rw [RingHom.map_add]
      exact dvd_add hx hy
  obtain ⟨v, hv⟩ := key _ h
  rw [curveBToV_curveBPi, pow_two, mul_assoc] at hv
  have h1 : π * 1 = π * (π * v) := by rw [mul_one]; exact hv
  have h2 : 1 = π * v := mul_left_cancel₀ hπ.out.ne_zero h1
  exact hπ.out.not_isUnit (IsUnit.of_mul_eq_one v h2.symm)

/-- **`πB = 𝔫 J` with `𝔫 + J = B`.** -/
theorem exists_span_curveBPi_eq_mul :
    ∃ J : Ideal (curveB V π), Ideal.span {curveBPi V π} = curveIdeal V π * J ∧
      curveIdeal V π ⊔ J = ⊤ := by
  have hle : Ideal.span {curveBPi V π} ≤ curveIdeal V π :=
    (Ideal.span_singleton_le_iff_mem _).2 (curveBPi_mem_curveIdeal V π)
  obtain ⟨J, hJ⟩ := Ideal.dvd_iff_le.2 hle
  refine ⟨J, hJ, ?_⟩
  have hJn : ¬ J ≤ curveIdeal V π := by
    intro hJn
    apply curveBPi_not_mem_sq V π
    have : Ideal.span {curveBPi V π} ≤ curveIdeal V π ^ 2 := by
      rw [hJ, pow_two]
      exact Ideal.mul_mono_right hJn
    exact this (Ideal.mem_span_singleton_self _)
  exact (isMaximal_curveIdeal V π).out.2 _
    (lt_of_le_of_ne le_sup_left fun h => hJn (h ▸ le_sup_right))

omit [IsFractionRing V K] in
/-- A primitive element of `κ_V` over `L` which is nonzero. -/
theorem exists_primitive_residue : ∃ ξ : ResidueField V, ξ ≠ 0 ∧ L⟮ξ⟯ = ⊤ := by
  obtain ⟨ξ₀, hξ₀⟩ := Field.exists_primitive_element L (ResidueField V)
  by_cases h : ξ₀ = 0
  · refine ⟨1, one_ne_zero, ?_⟩
    rw [h, IntermediateField.adjoin_zero] at hξ₀
    rw [IntermediateField.adjoin_one, hξ₀]
  · exact ⟨ξ₀, h, hξ₀⟩

/-- A primitive element of `K` over `L(π)` lying in `B`. -/
theorem exists_primitive_curveB :
    ∃ b : curveB V π, IntermediateField.adjoin L⟮(π : K)⟯ {(b : K)} = ⊤ := by
  obtain ⟨α, hα⟩ := Field.exists_primitive_element L⟮(π : K)⟯ K
  have := IsIntegralClosure.isLocalization (curveDVR V π) L⟮(π : K)⟯ K (curveB V π)
  obtain ⟨⟨b, ⟨_, ⟨c, hc, rfl⟩⟩⟩, hbc⟩ :=
    IsLocalization.surj (Algebra.algebraMapSubmonoid (curveB V π)
      (nonZeroDivisors (curveDVR V π))) α
  refine ⟨b, ?_⟩
  have hc0 : c ≠ 0 := nonZeroDivisors.ne_zero hc
  have hcK : (c : K) ≠ 0 := fun h => hc0 (Subtype.ext h)
  -- `α = b / c` with `c ∈ A ⊆ L(π)`
  have hbK : (b : K) = α * (c : K) := hbc.symm
  have hcF : (c : K) ∈ L⟮(π : K)⟯ := ((mem_curveDVR V π).1 c.2).1
  rw [eq_top_iff, ← hα, IntermediateField.adjoin_simple_le_iff]
  have : α = (⟨(c : K), hcF⟩ : L⟮(π : K)⟯)⁻¹ • (b : K) := by
    rw [hbK, Algebra.smul_def, IntermediateField.algebraMap_apply, IntermediateField.coe_inv]
    field_simp
  rw [this]
  exact IntermediateField.smul_mem _ (IntermediateField.mem_adjoin_simple_self _ _)

/-- **Pigeonhole.** If `b` generates `K` over `L(π)`, then so does `x + mπb` for some `m ∈ ℕ`:
two values of `m` giving the same intermediate field `W` put `b` in `W`. -/
theorem exists_nat_adjoin_eq_top {x b : K}
    (hb : IntermediateField.adjoin L⟮(π : K)⟯ {b} = ⊤) :
    ∃ m : ℕ, IntermediateField.adjoin L⟮(π : K)⟯ {x + (m : K) * (π : K) * b} = ⊤ := by
  have : CharZero K := charZero_of_injective_algebraMap (algebraMap L K).injective
  have hfin : Finite (IntermediateField L⟮(π : K)⟯ K) :=
    Field.finite_intermediateField_of_exists_primitive_element _ _ ⟨_, hb⟩
  let f : ℕ → IntermediateField L⟮(π : K)⟯ K := fun m =>
    IntermediateField.adjoin L⟮(π : K)⟯ {x + (m : K) * (π : K) * b}
  obtain ⟨m₁, m₂, hne, heq⟩ := Finite.exists_ne_map_eq_of_infinite f
  refine ⟨m₁, ?_⟩
  have hx₁ : x + (m₁ : K) * (π : K) * b ∈ f m₁ := IntermediateField.mem_adjoin_simple_self _ _
  have hx₂ : x + (m₂ : K) * (π : K) * b ∈ f m₁ := by
    rw [heq]
    exact IntermediateField.mem_adjoin_simple_self _ _
  have hsub : ((m₁ : K) - m₂) * (π : K) * b ∈ f m₁ := by
    have := sub_mem hx₁ hx₂
    convert this using 1
    ring
  have hd : ((m₁ : K) - m₂) * (π : K) ≠ 0 :=
    mul_ne_zero (sub_ne_zero.2 (Nat.cast_injective.ne hne)) (curvePi_ne_zero V π)
  have hdF : ((m₁ : K) - m₂) * (π : K) ∈ L⟮(π : K)⟯ :=
    mul_mem (sub_mem (natCast_mem _ _) (natCast_mem _ _))
      (IntermediateField.mem_adjoin_simple_self L (π : K))
  have hinv : (((m₁ : K) - m₂) * (π : K))⁻¹ ∈ f m₁ := by
    have := (f m₁).algebraMap_mem (⟨_, hdF⟩ : L⟮(π : K)⟯)⁻¹
    rwa [IntermediateField.algebraMap_apply, IntermediateField.coe_inv] at this
  have hbW : b ∈ f m₁ := by
    have : b = (((m₁ : K) - m₂) * (π : K))⁻¹ * (((m₁ : K) - m₂) * (π : K) * b) := by
      rw [← mul_assoc, inv_mul_cancel₀ hd, one_mul]
    rw [this]
    exact mul_mem hinv hsub
  rw [eq_top_iff, ← hb, IntermediateField.adjoin_simple_le_iff]
  exact hbW

omit hπ [IsDiscreteValuationRing V] [IsFractionRing V K] [Algebra.EssFiniteType L V]
  [Algebra.IsAlgebraic L (ResidueField V)] [CharZero L] in
theorem coe_curveB_add_natCast_mul (x b : curveB V π) (m : ℕ) :
    ((x + (m : curveB V π) * curveBPi V π * b : curveB V π) : K) =
      (x : K) + (m : K) * (π : K) * (b : K) := by
  simp only [Subalgebra.coe_add, Subalgebra.coe_mul, SubringClass.coe_natCast, coe_curveBPi]

/-- **Construction of the primitive coordinate.** There are an ideal `J` with `πB = 𝔫J`,
`𝔫 + J = B`, and `θ ∈ J` with `K = L(π)(θ)` whose residue is a nonzero generator of `κ_V`. -/
theorem exists_theta : ∃ (J : Ideal (curveB V π)) (θ : curveB V π),
    Ideal.span {curveBPi V π} = curveIdeal V π * J ∧ curveIdeal V π ⊔ J = ⊤ ∧ θ ∈ J ∧
    IntermediateField.adjoin L⟮(π : K)⟯ {(θ : K)} = ⊤ ∧
    curveBToResidue V π θ ≠ 0 ∧ L⟮curveBToResidue V π θ⟯ = ⊤ := by
  obtain ⟨J, hJ, hcop⟩ := exists_span_curveBPi_eq_mul V π
  obtain ⟨ξ, hξ0, hξ⟩ := exists_primitive_residue V
  obtain ⟨θ₀, hθ₀⟩ := curveBToResidue_surjective V π ξ
  have h1 : (1 : curveB V π) ∈ curveIdeal V π ⊔ J := by rw [hcop]; exact Submodule.mem_top
  obtain ⟨a, ha, j, hj, haj⟩ := Submodule.mem_sup.1 h1
  obtain ⟨b, hb⟩ := exists_primitive_curveB V π
  obtain ⟨m, hm⟩ := exists_nat_adjoin_eq_top V π (x := ((θ₀ * j : curveB V π) : K)) hb
  have hπJ : curveBPi V π ∈ J := by
    have : curveBPi V π ∈ Ideal.span {curveBPi V π} := Ideal.mem_span_singleton_self _
    rw [hJ] at this
    exact (Ideal.mul_le_right : curveIdeal V π * J ≤ J) this
  have hres : curveBToResidue V π (θ₀ * j + (m : curveB V π) * curveBPi V π * b) = ξ := by
    have hja : curveBToResidue V π j = 1 := by
      have h := congrArg (curveBToResidue V π) haj
      rwa [RingHom.map_add, RingHom.map_one, show curveBToResidue V π a = 0 from ha,
        zero_add] at h
    have hπ0 : curveBToResidue V π (curveBPi V π) = 0 := curveBPi_mem_curveIdeal V π
    rw [RingHom.map_add, RingHom.map_mul, RingHom.map_mul, RingHom.map_mul, hja, hπ0, hθ₀]
    ring
  refine ⟨J, θ₀ * j + (m : curveB V π) * curveBPi V π * b, hJ, hcop, ?_, ?_, ?_, ?_⟩
  · exact J.add_mem (J.mul_mem_left _ hj) (J.mul_mem_right _ (J.mul_mem_left _ hπJ))
  · rw [coe_curveB_add_natCast_mul]
    exact hm
  · rw [hres]
    exact hξ0
  · rw [hres]
    exact hξ

/-! ### The characteristic polynomial of `θ` -/

omit hπ [IsDiscreteValuationRing V] [IsFractionRing V K] [Algebra.EssFiniteType L V]
  [Algebra.IsAlgebraic L (ResidueField V)] [CharZero L] in
/-- Stated explicitly: instance search does not find it fast through `curveB`. -/
instance : SMulCommClass (curveDVR V π) (curveDVR V π) (curveB V π) :=
  smulCommClass_self _ _

omit [CharZero L] in
theorem minpoly_curveB_eq (θ : curveB V π) :
    minpoly (curveDVR V π) (θ : K) = minpoly (curveDVR V π) θ :=
  minpoly.algebraMap_eq (IsFractionRing.injective (curveB V π) K) θ

/-- **`F_θ` is the characteristic polynomial of multiplication by `θ` on `B`** (Cayley–Hamilton
and `deg F_θ = [K : L(π)] = rank_A B`). -/
theorem charpoly_mulLeft_eq_minpoly (θ : curveB V π)
    (hθ : IntermediateField.adjoin L⟮(π : K)⟯ {(θ : K)} = ⊤) :
    (LinearMap.mulLeft (curveDVR V π) θ).charpoly = minpoly (curveDVR V π) (θ : K) := by
  have hint : IsIntegral (curveDVR V π) θ := integralClosure.isIntegral θ
  have hintK : IsIntegral (curveDVR V π) (θ : K) := θ.2
  have hCH : aeval θ (LinearMap.mulLeft (curveDVR V π) θ).charpoly = 0 := by
    have h := LinearMap.aeval_self_charpoly (LinearMap.mulLeft (curveDVR V π) θ)
    have h2 := Polynomial.aeval_algHom_apply (Algebra.lmul (curveDVR V π) (curveB V π)) θ
      (LinearMap.mulLeft (curveDVR V π) θ).charpoly
    rw [Algebra.coe_lmul_eq_mul] at h2
    change aeval (LinearMap.mulLeft (curveDVR V π) θ) _ = _ at h2
    rw [h2] at h
    have h3 := congrArg (fun f => f 1) h
    simpa using h3
  have hdvd := minpoly.isIntegrallyClosed_dvd hint hCH
  rw [minpoly_curveB_eq]
  refine Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hint)
    (LinearMap.charpoly_monic _) hdvd ?_
  rw [LinearMap.charpoly_natDegree, finrank_curveB, ← IntermediateField.finrank_top', ← hθ,
    IntermediateField.adjoin.finrank hintK.tower_top,
    minpoly.isIntegrallyClosed_eq_field_fractions' L⟮(π : K)⟯ hintK,
    (minpoly.monic hintK).natDegree_map, minpoly_curveB_eq]


/-! ### The reduction of `F_θ` -/

omit [IsFractionRing V K] [Algebra.EssFiniteType L V] [Algebra.IsAlgebraic L (ResidueField V)]
  [CharZero L] in
/-- `a - ρ(a) ∈ πA`. -/
theorem exists_sub_curveResidue_eq_mul (a : curveDVR V π) :
    ∃ d : curveDVR V π, a - algebraMap L (curveDVR V π) (curveResidue V π a) = d * curvePi V π := by
  obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.1
    ((maximalIdeal_curveDVR V π) ▸ sub_curveResidue_mem V π a)
  exact ⟨d, hd.symm⟩

omit [IsFractionRing V K] [Algebra.EssFiniteType L V] [Algebra.IsAlgebraic L (ResidueField V)]
  [CharZero L] in
theorem curveResidue_curvePi : curveResidue V π (curvePi V π) = 0 := by
  rw [← RingHom.mem_ker, ker_curveResidue]
  exact curvePi_mem_maximalIdeal V π

/-- The map `B → κ_V` as an `L`-algebra homomorphism. -/
def curveBToResidueAlgHom : curveB V π →ₐ[L] ResidueField V :=
  { curveBToResidue V π with commutes' := fun _ => rfl }

omit hπ [Algebra.EssFiniteType L V] [Algebra.IsAlgebraic L (ResidueField V)] [CharZero L] in
theorem ker_curveBToResidueAlgHom :
    RingHom.ker (curveBToResidueAlgHom V π) = curveIdeal V π :=
  rfl

/-- **The reduction `F̄_θ = G T^e`.** For `θ ∈ J` with `K = L(π)(θ)` and `ξ = θ̄` generating
`κ_V`, the reduction of `F_θ ∈ A[T]` modulo `π` is `minpoly_L(ξ) · T^{dim_L B/J}`. -/
theorem map_minpoly_curveResidue (J : Ideal (curveB V π))
    (hJ : Ideal.span {curveBPi V π} = curveIdeal V π * J) (hcop : curveIdeal V π ⊔ J = ⊤)
    {θ : curveB V π} (hθJ : θ ∈ J) (hθ : IntermediateField.adjoin L⟮(π : K)⟯ {(θ : K)} = ⊤)
    (hξ : L⟮curveBToResidue V π θ⟯ = ⊤) :
    (minpoly (curveDVR V π) (θ : K)).map (curveResidue V π) =
      minpoly L (curveBToResidue V π θ) * X ^ Module.finrank L (curveB V π ⧸ J) := by
  have hρ := curveResidue_algebraMap V π
  have hϖ := exists_sub_curveResidue_eq_mul V π
  have hρϖ := curveResidue_curvePi V π
  have hfin := Module.Finite.of_basis (reductionBasis (curveResidue V π) hρ (curvePi V π) hϖ hρϖ
    (Module.Free.chooseBasis (curveDVR V π) (curveB V π)))
  rw [← charpoly_mulLeft_eq_minpoly V π θ hθ,
    map_charpoly_mulLeft (curveResidue V π) hρ (curvePi V π) hϖ hρϖ θ]
  have hI : Ideal.span {algebraMap (curveDVR V π) (curveB V π) (curvePi V π)} =
      RingHom.ker (curveBToResidueAlgHom V π) ⊓ J := by
    rw [ker_curveBToResidueAlgHom, ← Ideal.mul_eq_inf_of_coprime hcop, ← hJ]
    rfl
  exact charpoly_mulLeft_quotient_inf (curveBToResidueAlgHom V π)
    (curveBToResidue_surjective V π) J hcop _ hI hθJ hξ

/-! ### Evaluation and residues -/

omit hπ [IsDiscreteValuationRing V] [IsFractionRing V K] [Algebra.EssFiniteType L V]
  [Algebra.IsAlgebraic L (ResidueField V)] [CharZero L] in
theorem coe_aeval_curveDVR_V (x : V) (P : (curveDVR V π)[X]) :
    ((aeval x P : V) : K) = aeval (x : K) P :=
  (Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom (curveDVR V π) V K) x P).symm

omit hπ [IsDiscreteValuationRing V] [IsFractionRing V K] [Algebra.EssFiniteType L V]
  [Algebra.IsAlgebraic L (ResidueField V)] [CharZero L] in
theorem coe_aeval_curveB (x : curveB V π) (P : (curveDVR V π)[X]) :
    ((aeval x P : curveB V π) : K) = aeval (x : K) P :=
  (Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom (curveDVR V π) (curveB V π) K) x P).symm

omit hπ [Algebra.EssFiniteType L V] [Algebra.IsAlgebraic L (ResidueField V)] [CharZero L] in
theorem curveBToV_aeval (x : curveB V π) (P : (curveDVR V π)[X]) :
    curveBToV V π (aeval x P) = aeval (curveBToV V π x) P := by
  apply Subtype.ext
  rw [coe_curveBToV, coe_aeval_curveB, coe_aeval_curveDVR_V, coe_curveBToV]

omit [IsFractionRing V K] [Algebra.EssFiniteType L V] [Algebra.IsAlgebraic L (ResidueField V)]
  [CharZero L] in
/-- The residue of `P(x)` is `P̄(x̄)`, where `P̄` is the reduction of `P ∈ A[T]` modulo `π`. -/
theorem residue_aeval_curveDVR (x : V) (P : (curveDVR V π)[X]) :
    residue V (aeval x P) = aeval (residue V x) (P.map (curveResidue V π)) := by
  have h : (residue V).comp (algebraMap (curveDVR V π) V) =
      (algebraMap L (ResidueField V)).comp (curveResidue V π) := by
    ext a
    exact residue_algebraMap_curveDVR V π a
  rw [aeval_def, Polynomial.hom_eval₂, h, ← Polynomial.eval₂_map, ← aeval_def]

omit [IsFractionRing V K] [Algebra.EssFiniteType L V] in
/-- **`F_θ'(θ)` is a unit of `V`**: its residue is `G'(ξ) ξ^e ≠ 0`. -/
theorem isUnit_aeval_derivative_minpoly {θ : V} (hξ0 : residue V θ ≠ 0) {e : ℕ}
    (hF : (minpoly (curveDVR V π) (θ : K)).map (curveResidue V π) =
      minpoly L (residue V θ) * X ^ e) :
    IsUnit (aeval θ (derivative (minpoly (curveDVR V π) (θ : K)))) := by
  rw [← residue_ne_zero_iff_isUnit, residue_aeval_curveDVR, ← Polynomial.derivative_map, hF,
    derivative_mul, map_add, map_mul, map_mul, minpoly.aeval, zero_mul, add_zero, aeval_X_pow]
  refine mul_ne_zero ?_ (pow_ne_zero _ hξ0)
  exact (Algebra.IsSeparable.isSeparable L (residue V θ)).aeval_derivative_ne_zero
    (minpoly.aeval L _)

omit [CharZero L] in
theorem algebra_adjoin_eq_top_of_adjoin {θ : curveB V π}
    (hθ : IntermediateField.adjoin L⟮(π : K)⟯ {(θ : K)} = ⊤) :
    Algebra.adjoin L⟮(π : K)⟯ {algebraMap (curveB V π) K θ} = ⊤ := by
  have hint : IsIntegral L⟮(π : K)⟯ (θ : K) := .of_finite _ _
  have h := IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic
  rw [hθ, IntermediateField.top_toSubalgebra] at h
  exact h.symm

/-- `F_θ'(θ)` lies in the conductor of `A[θ]` in `B` (`conductor_mul_differentIdeal`). -/
theorem aeval_derivative_mem_conductor {θ : curveB V π}
    (hθ : IntermediateField.adjoin L⟮(π : K)⟯ {(θ : K)} = ⊤) :
    aeval θ (derivative (minpoly (curveDVR V π) θ)) ∈ conductor (curveDVR V π) θ := by
  have h := conductor_mul_differentIdeal (curveDVR V π) L⟮(π : K)⟯ K θ
    (algebra_adjoin_eq_top_of_adjoin V π hθ)
  have : aeval θ (derivative (minpoly (curveDVR V π) θ)) ∈
      conductor (curveDVR V π) θ * differentIdeal (curveDVR V π) (curveB V π) := by
    rw [h]
    exact Ideal.mem_span_singleton_self _
  exact (Ideal.mul_le_left : conductor (curveDVR V π) θ *
    differentIdeal (curveDVR V π) (curveB V π) ≤ conductor (curveDVR V π) θ) this

/-- **Conductor.** If `K = L(π)(θ)` with `θ ∈ B`, then `F_θ'(θ) B ⊆ A[θ]`. -/
theorem exists_aeval_eq_derivative_mul {θ : curveB V π}
    (hθ : IntermediateField.adjoin L⟮(π : K)⟯ {(θ : K)} = ⊤) (b : curveB V π) :
    ∃ P : (curveDVR V π)[X],
      aeval θ P = aeval θ (derivative (minpoly (curveDVR V π) (θ : K))) * b := by
  have hb := (mem_conductor_iff.1 (aeval_derivative_mem_conductor V π hθ)) b
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hb
  obtain ⟨P, hP⟩ := hb
  refine ⟨P, ?_⟩
  rw [minpoly_curveB_eq]
  exact hP

/-! ### The primitive coordinate -/

/-- **A primitive coordinate at a divisor** (`lem:c0-dvr-primitive`). For the uniformizer `π` of
`V` and `A = L[π]_{(π)} = V ∩ L(π)` (`curveDVR V π`), `θ ∈ V` is a primitive coordinate if

1. `θ` lies in the integral closure `B` of `A` in `K`, `K = L(π)(θ)`, and the residue `ξ = θ̄` is
   nonzero and generates `κ_V` over `L`;
2. the minimal polynomial `F_θ` of `θ` over `L(π)` has coefficients in `A`, its reduction modulo
   `π` is `G · T^e` with `G` the minimal polynomial of `ξ` over `L`, and `F_θ'(θ)` is a unit
   of `V` (so `ξ` is a simple root of `F̄_θ`);
3. `V = A[θ]_{𝔫'}`: every `x ∈ V` is `P(θ)/S(θ)` with `P, S ∈ A[T]` and `S(θ)` a unit of `V`. -/
structure IsPrimitiveCoordinate (θ : V) : Prop where
  /-- `θ ∈ B`. -/
  mem_curveB : (θ : K) ∈ curveB V π
  /-- `K = L(π)(θ)`. -/
  adjoin_eq_top : IntermediateField.adjoin L⟮(π : K)⟯ {(θ : K)} = ⊤
  /-- `ξ = θ̄ ≠ 0`. -/
  residue_ne_zero : residue V θ ≠ 0
  /-- `κ_V = L(ξ)`. -/
  adjoin_residue_eq_top : L⟮residue V θ⟯ = ⊤
  /-- `F_θ ∈ A[T]`: the minimal polynomial over `A` maps to the one over `L(π)`. -/
  map_minpoly : (minpoly (curveDVR V π) (θ : K)).map (algebraMap (curveDVR V π) L⟮(π : K)⟯) =
    minpoly L⟮(π : K)⟯ (θ : K)
  /-- `F̄_θ = G · T^e`. -/
  exists_map_minpoly_curveResidue : ∃ e : ℕ,
    (minpoly (curveDVR V π) (θ : K)).map (curveResidue V π) = minpoly L (residue V θ) * X ^ e
  /-- `F_θ'(θ)` is a unit of `V`. -/
  isUnit_aeval_derivative : IsUnit (aeval θ (derivative (minpoly (curveDVR V π) (θ : K))))
  /-- `V = A[θ]_{𝔫'}`. -/
  exists_mul_eq_aeval : ∀ x : V, ∃ P S : (curveDVR V π)[X],
    IsUnit (aeval θ S) ∧ x * aeval θ S = aeval θ P

omit [IsFractionRing V K] [Algebra.EssFiniteType L V] in
variable {V π} in
/-- The minimal polynomial `G` of `ξ` over `L` is separable (characteristic `0`). -/
theorem IsPrimitiveCoordinate.separable_minpoly_residue {θ : V}
    (_ : IsPrimitiveCoordinate V π θ) : (minpoly L (residue V θ)).Separable :=
  Algebra.IsSeparable.isSeparable L (residue V θ)

omit [IsFractionRing V K] [CharZero L] in
variable {V π} in
/-- `G(0) ≠ 0`. -/
theorem IsPrimitiveCoordinate.coeff_zero_minpoly_residue_ne_zero {θ : V}
    (h : IsPrimitiveCoordinate V π θ) : (minpoly L (residue V θ)).coeff 0 ≠ 0 :=
  minpoly.coeff_zero_ne_zero (.of_finite L _) h.residue_ne_zero

/-- **Existence of a primitive coordinate** (`lem:c0-dvr-primitive`). -/
theorem exists_isPrimitiveCoordinate : ∃ θ : V, IsPrimitiveCoordinate V π θ := by
  obtain ⟨J, θ, hJ, hcop, hθJ, hθ, hξ0, hξ⟩ := exists_theta V π
  have hF := map_minpoly_curveResidue V π J hJ hcop hθJ hθ hξ
  have hunit : IsUnit (aeval (curveBToV V π θ)
      (derivative (minpoly (curveDVR V π) ((curveBToV V π θ : V) : K)))) :=
    isUnit_aeval_derivative_minpoly V π hξ0 hF
  refine ⟨curveBToV V π θ, θ.2, hθ, hξ0, hξ,
    (minpoly.isIntegrallyClosed_eq_field_fractions' L⟮(π : K)⟯ θ.2).symm, ⟨_, hF⟩, hunit, ?_⟩
  intro x
  obtain ⟨b, s, hs, h⟩ := exists_mul_mem_curveB V π x
  obtain ⟨P, hP⟩ := exists_aeval_eq_derivative_mul V π hθ b
  obtain ⟨S, hS⟩ := exists_aeval_eq_derivative_mul V π hθ s
  refine ⟨P, S, ?_, ?_⟩
  · rw [← curveBToV_aeval, hS, RingHom.map_mul, curveBToV_aeval]
    exact hunit.mul (isUnit_curveBToV V π hs)
  · apply Subtype.ext
    rw [Subalgebra.coe_mul, ← curveBToV_aeval, ← curveBToV_aeval, coe_curveBToV, coe_curveBToV,
      hS, hP, Subalgebra.coe_mul, Subalgebra.coe_mul, ← h]
    ring

end Primitive

end EnvelopeProperty.Char0
