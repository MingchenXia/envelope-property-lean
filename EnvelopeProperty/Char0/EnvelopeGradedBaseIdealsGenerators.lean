import EnvelopeProperty.Char0.EnvelopeGradedBaseIdealsParameter
import Mathlib.RingTheory.Noetherian.Basic

/-! # Finite ORIGINAL homogeneous obstacle generators, internally selected -/

open AlgebraicGeometry CategoryTheory MvPolynomial
open scoped Polynomial
noncomputable section
universe u
namespace EnvelopeProperty.ProjSubvariety.MultiplierBaseIdeals
attribute [local instance] MvPolynomial.gradedAlgebra
variable {k : Type u} [Field k] {M : ℕ} (X : ProjSubvariety k M)

/-- ALL original obstacle monomials, with their original parameter and form,
transported through the SAME actual polynomial equivalence. -/
def originalGeneratorSet (d : ℕ) (φ : X.an → ℝ) (m : ℕ) :
    Set (MvPolynomial (Fin (M + 1)) k[X]) :=
  (parameterEquiv (k := k) (M := M)) ''
    {g | g ∈ X.obstacleSpace d φ m ∧ ∃ l s, g = Polynomial.monomial l s}

/-- The ENTIRE original ideal is generated by this SAME original family. -/
theorem parameterObstacleIdeal_eq_span_originalGeneratorSet
    (d : ℕ) (φ : X.an → ℝ) (m : ℕ) :
    parameterObstacleIdeal X d φ m = Ideal.span (originalGeneratorSet X d φ m) := by
  rw [parameterObstacleIdeal, obstacleIdeal_eq_span_monomial, Ideal.map_span]
  rfl

/-- Every member of the actual original family has EXACTLY the original
x-degree md, not merely an assumed degree bound. -/
theorem originalGeneratorSet_homogeneous (d : ℕ) (φ : X.an → ℝ) (m : ℕ)
    {F : MvPolynomial (Fin (M + 1)) k[X]}
    (hF : F ∈ originalGeneratorSet X d φ m) : F.IsHomogeneous (m * d) := by
  obtain ⟨g, ⟨hg, l, s, rfl⟩, rfl⟩ := hF
  have hs : s.IsHomogeneous (m * d) := by simpa using hg.1 l
  rw [parameterEquiv_monomial]
  simpa only [mul_comm] using
    (hs.map (Polynomial.C : k →+* Polynomial k)).C_mul ((Polynomial.X : Polynomial k) ^ l)

/-- Ordinary Noetherianity INTERNALLY selects finitely many of the SAME
original homogeneous obstacle generators, with their true degree retained. -/
theorem exists_finite_original_homogeneous_generators
    (d : ℕ) (φ : X.an → ℝ) (m : ℕ) :
    ∃ G : Finset (MvPolynomial (Fin (M + 1)) k[X]),
      (G : Set _) ⊆ originalGeneratorSet X d φ m ∧
      parameterObstacleIdeal X d φ m = Ideal.span (G : Set _) ∧
      ∀ F ∈ G, F.IsHomogeneous (m * d) := by
  classical
  let S := originalGeneratorSet X d φ m
  have hfg : (Submodule.span (MvPolynomial (Fin (M + 1)) k[X]) S).FG :=
    IsNoetherian.noetherian _
  obtain ⟨G, hG, hspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset S).mp hfg
  refine ⟨G, hG, ?_, fun F hF => originalGeneratorSet_homogeneous X d φ m (hG hF)⟩
  rw [parameterObstacleIdeal_eq_span_originalGeneratorSet]
  exact hspan

end EnvelopeProperty.ProjSubvariety.MultiplierBaseIdeals
