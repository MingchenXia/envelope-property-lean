import EnvelopeProperty.Char0.PrincipalizationFamilyTree
import EnvelopeProperty.Char0.SmoothSourceReesCover
import EnvelopeProperty.Char0.JacobianSourceLocalization

/-!
# Simultaneous family trees over the arbitrary original smooth source

The initial unit Rees node supplies source coordinates internally. Actual BP
child trees retain all original factors and the original all-functions Jacobian.
-/

noncomputable section

namespace EnvelopeProperty.Char0

open AlgebraicGeometry CategoryTheory Module Ideal
open scoped Classical

universe u

variable {k K : Type u} [Field k] [Field K] [Algebra k K]

/-- An actual source localization preserves simultaneous family monomials and the genuine
Jacobian ideal generated by all functions of the original source. -/
theorem EtaleFamilyMonomialLeaf.of_source_localization
    (C D E : Subalgebra k K) (hCD : C ≤ D) (hDE : D ≤ E)
    (M : Submonoid C)
    (hlocal : letI : Algebra C D := (Subalgebra.inclusion hCD).toAlgebra
      IsLocalization M D)
    (n : ℕ) {κ : Type*} (I : κ → Ideal C)
    (h : EtaleFamilyMonomialLeaf D E hDE n
      (fun j => (I j).map (Subalgebra.inclusion hCD).toRingHom)) :
    EtaleFamilyMonomialLeaf C E (hCD.trans hDE) n I := by
  let _ : Algebra C D := (Subalgebra.inclusion hCD).toAlgebra
  let _ : Algebra D E := (Subalgebra.inclusion hDE).toAlgebra
  let _ : Algebra C E := (Subalgebra.inclusion (hCD.trans hDE)).toAlgebra
  have : IsScalarTower k C D := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower k D E := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower k C E := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower C D E := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsLocalization M D := hlocal
  obtain ⟨v, hv, ι, hι, c, hcinj, d, a, hd, hJac⟩ := h
  let _ : Fintype ι := hι
  refine ⟨v, hv, ι, hι, c, hcinj, d, a, ?_, ?_⟩
  · intro j
    have hmap : ((I j).map (Subalgebra.inclusion hCD).toRingHom).map
        (Subalgebra.inclusion hDE).toRingHom =
        (I j).map (Subalgebra.inclusion (hCD.trans hDE)).toRingHom := by
      rw [Ideal.map_map]
      rfl
    exact hmap.symm.trans (hd j)
  · rw [affineRelativeJacobianIdeal_source_localization (S := D) M]
    exact hJac

variable [CharZero k]

/-- The actual arbitrary smooth source produces a literal simultaneous family Rees tree.
No global source coordinates, separate pure dimension, or resolution certificate is supplied. -/
theorem exists_smooth_family_rees_tree
    (C : Subalgebra k K) [Smooth (Spec.map (CommRingCat.ofHom (algebraMap k C)))]
    {κ : Type*} [Fintype κ] (I : κ → Ideal C) (hI : ∀ j, I j ≠ ⊥) :
    ∃ (n : ℕ) (T : ReesChartTree k K C),
      ∀ i, EtaleFamilyMonomialLeaf C (T.leafAlgebra i)
        (T.root_le_of_mem_leaves (T.leafAlgebra_mem_leaves i)) n I := by
  obtain ⟨n, m, g, hg, hg0, hcoord⟩ := exists_smooth_source_unit_rees_etale_cover C
  have hchild (i : {i : Fin m // g i ≠ 0}) :
      ∃ T : ReesChartTree k K (reesTreeChart C g i),
        ∀ j, EtaleFamilyMonomialLeaf (reesTreeChart C g i) (T.leafAlgebra j)
          (T.root_le_of_mem_leaves (T.leafAlgebra_mem_leaves j)) n
          (fun l => (I l).map (reesTreeChartIncl C g i).toRingHom) := by
    obtain ⟨z, hz⟩ := hcoord i
    let D := reesTreeChart C g i
    let P : κ → Ideal D := fun j => (I j).map (reesTreeChartIncl C g i).toRingHom
    have hP (j : κ) : P j ≠ ⊥ :=
      (Ideal.map_eq_bot_iff_of_injective (Subalgebra.inclusion_injective _)).mp.mt (hI j)
    obtain ⟨S, _, _, T, φ, hopen, htriangle, hcover, hdata⟩ :=
      exists_etaleSource_principalization_family_tree D n P hP z hz
    exact ⟨T, hdata⟩
  choose child hdata using hchild
  refine ⟨n, .node C m g hg0 child, ?_⟩
  rintro ⟨i, j⟩
  exact EtaleFamilyMonomialLeaf.of_source_localization
    C (reesTreeChart C g i) ((child i).leafAlgebra j)
    (le_reesTreeChart C g i)
    ((child i).root_le_of_mem_leaves ((child i).leafAlgebra_mem_leaves j))
    (Submonoid.powers (g i)) (isLocalization_principalReesChart C g hg i i.2)
    n I (hdata i j)

end EnvelopeProperty.Char0
