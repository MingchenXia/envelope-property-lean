import EnvelopeProperty.Cartier.FieldPBasis

/-!
# Local `p`-bases of smooth algebras (Kunz)

Let `k` be an algebraically closed field of characteristic `p` and `A` a `k`-algebra of finite
type which is a domain, with fraction field `K`. Put `d = dim_K Ω[K⁄k]` (`= trdeg_k K`,
`EnvelopeProperty.Cartier.finrank_kaehler_eq_trdeg`). If `A` is smooth at a maximal ideal `𝔪`,
there are `u_1, …, u_d ∈ 𝔪` and `h ∉ 𝔪` such that `u` is a `p`-basis of `A_h`: every element of
`A_h` is uniquely `∑_{a ∈ [0,p)^d} f_a^p u^a` (`exists_isPBasis_away_of_isSmoothAt`). Hence a smooth
`k`-domain of finite type is covered by finitely many principal open sets with `p`-bases
(`exists_isPBasis_cover_of_smooth`).

These are FHX-blueprint `lem:sg-kunz` and `cor:sg-pbasis-cover` (chapter `smooth-general`,
`subsec:sg-smooth`): the local `p`-bases on the charts of a smooth projective variety, on which
the test ideals of FHX §3 (Fang–Han–Xia, *The envelope property for unibranch projective
varieties*, proof of Theorem 3.1) are computed. They generalize the DVR case
`EnvelopeProperty.Cartier.exists_isPBasis_of_essFiniteType`.

## Proof (following `lem:sg-kunz`)

* *Cotangent space* (`exists_span_eq_maximalIdeal_of_isSmoothAt`). `R = A_𝔪` has residue field
  `k` (Nullstellensatz) and `Ω[R⁄k]` is free (smoothness); the conormal map `𝔪/𝔪² → k ⊗ Ω[R⁄k]`
  is injective (`finrank_cotangentSpace_le_finrank_kaehler`), so `𝔪R` is generated by
  `e ≤ rank Ω[R⁄k] = dim_K Ω[K⁄k]` elements `u_i ∈ 𝔪`.
* *Spanning* (`surjective_pSum_of_span_eq_maximalIdeal`). `R = R^p[u] + 𝔪^j R` for every `j`
  (induction, `R = k + 𝔪R`, `k ⊆ R^p`), and `𝔪^J ⊆ (u_1^p, …, u_e^p)` for some `J`; Nakayama over
  the subring `R^p`, over which `R` is finite (`exists_surjective_pSum`), gives `R = ∑_a R^p u^a`.
* *Spreading out* (`exists_pow_mul_mem_range_pSum`). For each of the finitely many generators
  `s^b` of `A` over `A^p`, clearing denominators gives `g^p s^b = ∑_a z_a^p u^a` in `A` with
  `g ∉ 𝔪`; with `h = ∏ g` this makes `u` span `A_h` over `A_h^p`.
* *Independence.* The monomials `u^a` span `K` over `K^p` and `e ≤ dim_K Ω[K⁄k]`, so `u` is a
  `p`-basis of `K` (`isPBasis_of_surjective_pSum`); independence over `A_h^p` follows by mapping
  to `K`.

This replaces the blueprint's kernel/cokernel argument for the spreading out (only the cokernel is
needed: independence holds on all of `A_h` because it holds in `K`), and only the inequality
`dim 𝔪/𝔪² ≤ d` of the cotangent step is used (equality then follows from the count in `K`).

## Implementation notes

The local `p`-basis is stated for every model `B` of `A_h` (`[IsLocalization.Away h B]`) carrying
a `CharP B p` instance, since `Localization.Away h` has no such instance by default;
`charP_of_isLocalization_away` provides it for `h ≠ 0`. The size `d` is `dim_K Ω[K⁄k]`; the
`_of_trdeg` variants take `Algebra.trdeg k K = d` instead, and `exists_isPBasis_away_of_isPBasis`
indexes the local `p`-basis by the index type of a given `p`-basis of `K`.
-/

noncomputable section

open scoped NNReal ENNReal Topology TensorProduct

namespace EnvelopeProperty.Cartier

open Finset Module KaehlerDifferential IsLocalRing

variable {p : ℕ} [hp : Fact p.Prime]

/-! ### Spanning over the `p`-th powers at a local ring -/

section LocalSpanning

variable {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [CharP R p]

/-- **Kunz's spanning step.** Let `R` be a noetherian local ring of characteristic `p`, spanned over
`R^p` by the monomials of a finite family, with a perfect subfield `k` mapping onto the residue
field. If `u_1, …, u_e` generate the maximal ideal, the monomials `u^a`, `a ∈ [0,p)^e`, span `R`
over `R^p`. -/
theorem surjective_pSum_of_span_eq_maximalIdeal (k : Type*) [Field k] [CharP k p]
    [PerfectRing k p] [Algebra k R] (hk : Function.Surjective (algebraMap k (ResidueField R)))
    {n : ℕ} {s : Fin n → R} (hs : Function.Surjective (pSum p s)) {e : ℕ} {u : Fin e → R}
    (hu : Ideal.span (Set.range u) = maximalIdeal R) : Function.Surjective (pSum p u) := by
  classical
  set 𝔪 := maximalIdeal R
  let S : Subring R := (frobenius R p).range
  have hpowS : ∀ c : R, c ^ p ∈ S := fun c => ⟨c, frobenius_def p c⟩
  let N : Submodule S R := Submodule.span S (Set.range fun a : Box (Fin e) p => mono u a.toNat)
  have hmonoN : ∀ m : Fin e → ℕ, mono u m ∈ N := by
    intro m
    rw [mono_eq_pow_mul u p m]
    have : mono u (fun i => m i / p) ^ p * mono u (Box.ofNat (p := p) m).toNat =
        (⟨_, hpowS (mono u fun i => m i / p)⟩ : S) • mono u (Box.ofNat (p := p) m).toNat := rfl
    rw [this]
    exact N.smul_mem _ (Submodule.subset_span ⟨_, rfl⟩)
  -- `N` is stable under multiplication by the `u_i`
  have hmulN : ∀ i, ∀ y ∈ N, u i * y ∈ N := by
    intro i y hy
    induction hy using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, rfl⟩ := hx
      have : u i * mono u a.toNat = mono u (Pi.single i 1 + a.toNat) := by
        rw [mono_add, mono_single, pow_one]
      rw [this]
      exact hmonoN _
    | zero => rw [mul_zero]; exact N.zero_mem
    | add x y _ _ hx hy => rw [mul_add]; exact N.add_mem hx hy
    | smul c x _ hx => rw [mul_smul_comm]; exact N.smul_mem c hx
  -- the constants lie in `N`
  have hkN : ∀ c : k, algebraMap k R c ∈ N := by
    intro c
    have h : algebraMap k R c =
        (⟨_, hpowS (algebraMap k R ((frobeniusEquiv k p).symm c))⟩ : S) • mono u 0 := by
      rw [Subring.smul_def, smul_eq_mul, mono_zero, mul_one]
      show _ = (algebraMap k R ((frobeniusEquiv k p).symm c)) ^ p
      rw [← map_pow, frobeniusEquiv_symm_pow_p]
    rw [h]
    exact N.smul_mem _ (hmonoN 0)
  have hres : ∀ z : R, ∃ c : k, z - algebraMap k R c ∈ 𝔪 := by
    intro z
    obtain ⟨c, hc⟩ := hk (residue R z)
    refine ⟨c, ?_⟩
    rw [← residue_eq_zero_iff, map_sub, sub_eq_zero, ← hc,
      IsScalarTower.algebraMap_apply k R (ResidueField R) c]
    rfl
  -- `𝔪^j ⊆ N + 𝔪^{j+1}`
  have hclaim : ∀ j, ∀ z ∈ 𝔪 ^ j, z ∈ N ⊔ (𝔪 ^ (j + 1)).restrictScalars S := by
    intro j
    induction j with
    | zero =>
      intro z _
      obtain ⟨c, hc⟩ := hres z
      refine Submodule.mem_sup.2 ⟨_, hkN c, z - algebraMap k R c, ?_, by ring⟩
      simpa using hc
    | succ j ih =>
      intro z hz
      rw [pow_succ'] at hz
      refine Submodule.mul_induction_on hz (fun a ha b hb => ?_) (fun x y hx hy => ?_)
      · rw [← hu] at ha
        obtain ⟨r, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun R).1 ha
        rw [sum_mul]
        refine Submodule.sum_mem _ fun i _ => ?_
        obtain ⟨y, hy, w, hw, hyw⟩ :=
          Submodule.mem_sup.1 (ih (r i * b) (Ideal.mul_mem_left _ _ hb))
        rw [smul_eq_mul, mul_comm (r i) (u i), mul_assoc, ← hyw, mul_add]
        refine Submodule.add_mem_sup (hmulN i y hy) ?_
        show u i * w ∈ 𝔪 ^ (j + 1 + 1)
        rw [pow_succ' 𝔪 (j + 1)]
        exact Ideal.mul_mem_mul (hu ▸ Ideal.subset_span ⟨i, rfl⟩) hw
      · exact Submodule.add_mem _ hx hy
  -- `R = N + 𝔪^j`
  have hall : ∀ j, ∀ z : R, z ∈ N ⊔ (𝔪 ^ j).restrictScalars S := by
    intro j
    induction j with
    | zero =>
      intro z
      refine Submodule.mem_sup_right ?_
      show z ∈ 𝔪 ^ 0
      rw [pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
    | succ j ih =>
      intro z
      obtain ⟨y, hy, w, hw, rfl⟩ := Submodule.mem_sup.1 (ih z)
      obtain ⟨y', hy', w', hw', rfl⟩ := Submodule.mem_sup.1 (hclaim j w hw)
      rw [← add_assoc]
      exact Submodule.add_mem_sup (N.add_mem hy hy') hw'
  -- `𝔪^J ⊆ (u^p)`
  obtain ⟨J, hJ⟩ : ∃ J, 𝔪 ^ J ≤ Ideal.span (Set.range fun i => u i ^ p) := by
    refine Ideal.exists_pow_le_of_le_radical_of_fg ?_ (IsNoetherian.noetherian 𝔪)
    rw [← hu, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact ⟨p, Ideal.subset_span ⟨i, rfl⟩⟩
  -- Nakayama over `R^p`
  let I : Ideal S := Ideal.span (Set.range fun i => (⟨u i ^ p, hpowS _⟩ : S))
  have hIJ : I ≤ Ideal.jacobson ⊥ := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, Ideal.mem_jacobson_bot]
    rintro ⟨_, v, rfl⟩
    have hunit : IsUnit (u i * v + 1) := by
      have hmem : -(u i * v) ∈ nonunits R := by
        rw [← IsLocalRing.mem_maximalIdeal]
        exact 𝔪.neg_mem (Ideal.mul_mem_right _ _ (hu ▸ Ideal.subset_span ⟨i, rfl⟩))
      have h := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ hmem
      rwa [sub_neg_eq_add, add_comm] at h
    obtain ⟨w, hw⟩ := hunit.exists_right_inv
    refine IsUnit.of_mul_eq_one ⟨w ^ p, hpowS w⟩ ?_
    apply Subtype.ext
    simp only [Subring.coe_mul, Subring.coe_add, Subring.coe_one, frobenius_def]
    rw [← mul_pow, show (u i * v) ^ p + 1 = (u i * v + 1) ^ p by rw [add_pow_char, one_pow],
      ← mul_pow, hw, one_pow]
  have hNN : (⊤ : Submodule S R) ≤ N ⊔ I • ⊤ := by
    intro z _
    obtain ⟨y, hy, w, hw, rfl⟩ := Submodule.mem_sup.1 (hall J z)
    refine Submodule.add_mem_sup hy ?_
    obtain ⟨r, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun R).1 (hJ hw)
    refine Submodule.sum_mem _ fun i _ => ?_
    have : r i • u i ^ p = (⟨u i ^ p, hpowS _⟩ : S) • r i := by
      rw [smul_eq_mul, Subring.smul_def, smul_eq_mul, mul_comm]
    rw [this]
    exact Submodule.smul_mem_smul (Ideal.subset_span ⟨i, rfl⟩) trivial
  have htopFG : (⊤ : Submodule S R).FG := by
    refine ⟨(univ.image fun a : Box (Fin n) p => mono s a.toNat), eq_top_iff.2 fun z _ => ?_⟩
    obtain ⟨c, rfl⟩ := hs z
    rw [coe_image, coe_univ, Set.image_univ, pSum_apply]
    refine Submodule.sum_mem _ fun a _ => ?_
    have : c a ^ p * mono s a.toNat = (⟨c a ^ p, hpowS _⟩ : S) • mono s a.toNat := rfl
    rw [this]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, rfl⟩)
  have htop := Submodule.le_of_le_smul_of_le_jacobson_bot htopFG hIJ hNN
  intro z
  have hz : z ∈ N := htop trivial
  obtain ⟨g, hg⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 hz
  choose c hc using fun a => (g a).2
  refine ⟨c, ?_⟩
  rw [pSum_apply, ← hg]
  refine sum_congr rfl fun a _ => ?_
  show c a ^ p * mono u a.toNat = (g a : R) * mono u a.toNat
  rw [← hc a, frobenius_def]

end LocalSpanning

/-! ### Fraction fields and localizations -/

section Localization

variable {A : Type*} [CommRing A] [CharP A p] {e : ℕ} {u : Fin e → A}

/-- `pSum` is compatible with ring homomorphisms (images of the range). -/
theorem map_mem_range_pSum {B : Type*} [CommRing B] [CharP B p] (φ : A →+* B) {r : A}
    (hr : r ∈ AddMonoidHom.mrange (pSum p u)) :
    φ r ∈ AddMonoidHom.mrange (pSum p (φ ∘ u)) := by
  obtain ⟨c, rfl⟩ := hr
  exact ⟨φ ∘ c, (map_pSum p φ u c).symm⟩

omit [CharP A p] in
/-- If the image of every element of `A` lies in the `B^p`-span of the monomials of `u` and `B` is
a localization of `A` at `M`, then the monomials of `u` span `B` over `B^p`. -/
theorem surjective_pSum_of_isLocalization (M : Submonoid A) {B : Type*} [CommRing B] [CharP B p]
    [Algebra A B] [IsLocalization M B]
    (h : ∀ r : A, algebraMap A B r ∈ AddMonoidHom.mrange (pSum p (algebraMap A B ∘ u))) :
    Function.Surjective (pSum p (algebraMap A B ∘ u)) := by
  intro x
  obtain ⟨⟨a, m⟩, rfl⟩ := IsLocalization.mk'_surjective M x
  show ∃ c, pSum p _ c = IsLocalization.mk' B a m
  set v := IsLocalization.mk' B (1 : A) m
  have hv : v * algebraMap A B m = 1 := by
    rw [IsLocalization.mk'_spec, map_one]
  have hp1 : p = p - 1 + 1 := (Nat.sub_add_cancel hp.out.one_lt.le).symm
  have hx : IsLocalization.mk' B a m = v ^ p * algebraMap A B (a * (m : A) ^ (p - 1)) := by
    rw [IsLocalization.mk'_eq_mul_mk'_one]
    calc algebraMap A B a * v = algebraMap A B a * v * (v * algebraMap A B m) ^ (p - 1) := by
          rw [hv, one_pow, mul_one]
      _ = v ^ (p - 1 + 1) * algebraMap A B (a * (m : A) ^ (p - 1)) := by
          rw [map_mul, map_pow]; ring
      _ = _ := by rw [← hp1]
  rw [hx]
  exact pow_mul_mem_range_pSum p _ _ (h _)

variable [IsDomain A]

omit [IsDomain A] [CharP A p] in
/-- The fraction-field version of `surjective_pSum_of_isLocalization`. -/
theorem surjective_pSum_of_isFractionRing {K : Type*} [Field K] [CharP K p] [Algebra A K]
    [IsFractionRing A K]
    (h : ∀ r : A, algebraMap A K r ∈ AddMonoidHom.mrange (pSum p (algebraMap A K ∘ u))) :
    Function.Surjective (pSum p (algebraMap A K ∘ u)) :=
  surjective_pSum_of_isLocalization (nonZeroDivisors A) h

omit [CharP A p] hp in
/-- The localization of a domain at the powers of `h ≠ 0` embeds into its fraction field over
`A`. -/
theorem exists_injective_lift_away {h : A} (hh : h ≠ 0) (B : Type*) [CommRing B] [Algebra A B]
    [IsLocalization.Away h B] (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K] :
    ∃ φ : B →+* K, Function.Injective φ ∧ φ.comp (algebraMap A B) = algebraMap A K := by
  have hunit : ∀ y : Submonoid.powers h, IsUnit (algebraMap A K y) := by
    rintro ⟨_, n, rfl⟩
    refine IsUnit.mk0 _ ?_
    rw [map_pow]
    exact pow_ne_zero _ ((map_ne_zero_iff _ (IsFractionRing.injective A K)).2 hh)
  refine ⟨IsLocalization.lift hunit, ?_, RingHom.ext fun x => IsLocalization.lift_eq hunit x⟩
  rw [IsLocalization.lift_injective_iff]
  intro x y
  have hB : Function.Injective (algebraMap A B) :=
    IsLocalization.injective B (powers_le_nonZeroDivisors_of_noZeroDivisors hh)
  rw [hB.eq_iff, (IsFractionRing.injective A K).eq_iff]

omit hp in
/-- A localization of a domain of characteristic `p` at the powers of an element `h ≠ 0` has
characteristic `p`. -/
theorem charP_of_isLocalization_away {h : A} (hh : h ≠ 0) (B : Type*) [CommRing B] [Algebra A B]
    [IsLocalization.Away h B] : CharP B p :=
  charP_of_injective_algebraMap
    (IsLocalization.injective B (powers_le_nonZeroDivisors_of_noZeroDivisors hh)) p

omit [CharP A p] in
/-- A `p`-independent family of the fraction field is `p`-independent in every localization at
the powers of an element `h ≠ 0`. -/
theorem injective_pSum_away_of_isFractionRing {h : A} (hh : h ≠ 0) (B : Type*) [CommRing B]
    [CharP B p] [Algebra A B] [IsLocalization.Away h B] (K : Type*) [Field K] [CharP K p]
    [Algebra A K] [IsFractionRing A K] (hK : Function.Injective (pSum p (algebraMap A K ∘ u))) :
    Function.Injective (pSum p (algebraMap A B ∘ u)) := by
  obtain ⟨φ, hφ, hφA⟩ := exists_injective_lift_away hh B K
  rw [injective_iff_map_eq_zero]
  intro c hc
  have h1 : pSum p (algebraMap A K ∘ u) (φ ∘ c) = 0 := by
    have := congrArg φ hc
    rw [map_pSum, map_zero] at this
    rw [← this, ← hφA]
    rfl
  have h2 : φ ∘ c = 0 := hK (h1.trans (map_zero _).symm)
  funext a
  exact hφ ((congr_fun h2 a).trans (map_zero φ).symm)

end Localization

/-! ### Spreading out from the local ring -/

section Spread

variable {A : Type*} [CommRing A] [CharP A p] (𝔪 : Ideal A) [𝔪.IsPrime] {e : ℕ} {u : Fin e → A}

/-- **Clearing denominators.** If `u` spans `A_𝔪` over `A_𝔪^p`, then for every `r ∈ A` there is
`g ∉ 𝔪` with `g^p r ∈ ∑_a A^p u^a`. -/
theorem exists_pow_mul_mem_range_pSum [CharP (Localization.AtPrime 𝔪) p]
    (hR : Function.Surjective (pSum p (algebraMap A (Localization.AtPrime 𝔪) ∘ u))) (r : A) :
    ∃ g ∉ 𝔪, ∃ z : Box (Fin e) p → A, pSum p u z = g ^ p * r := by
  set R := Localization.AtPrime 𝔪
  obtain ⟨c, hc⟩ := hR (algebraMap A R r)
  obtain ⟨T, hT⟩ := IsLocalization.exist_integer_multiples 𝔪.primeCompl univ c
  choose d hd using fun a => hT a (mem_univ a)
  have h1 : algebraMap A R (pSum p u d) = algebraMap A R ((T : A) ^ p * r) := by
    rw [map_pSum]
    have : algebraMap A R ∘ d = (algebraMap A R T) • c := by
      funext a
      rw [Function.comp_apply, hd a, Pi.smul_apply, Algebra.smul_def, smul_eq_mul]
    rw [this, pSum_smul, hc, map_mul, map_pow]
  obtain ⟨c', hc'⟩ := (IsLocalization.eq_iff_exists 𝔪.primeCompl R).1 h1
  refine ⟨c' * T, 𝔪.primeCompl.mul_mem c'.2 T.2, (c' : A) • d, ?_⟩
  have hp1 : p = p - 1 + 1 := (Nat.sub_add_cancel hp.out.one_lt.le).symm
  have hpow : ∀ x : A, x ^ p = x ^ (p - 1) * x := fun x => by rw [← pow_succ, ← hp1]
  rw [pSum_smul]
  calc (c' : A) ^ p * pSum p u d = (c' : A) ^ (p - 1) * ((c' : A) * pSum p u d) := by
        rw [hpow]; ring
    _ = (c' : A) ^ (p - 1) * ((c' : A) * ((T : A) ^ p * r)) := by rw [hc']
    _ = ((c' : A) * T) ^ p * r := by rw [mul_pow, hpow (c' : A)]; ring

end Spread

/-! ### The cotangent space at a smooth closed point -/

section Cotangent

variable (k : Type*) [Field k] [IsAlgClosed k] {A : Type*} [CommRing A] [Algebra k A]
  [Algebra.FiniteType k A] (𝔪 : Ideal A) [𝔪.IsMaximal]

/-- The residue field of `A_𝔪` at a closed point of a variety over an algebraically closed field
is `k`. -/
theorem bijective_algebraMap_residueField_atPrime :
    Function.Bijective (algebraMap k (ResidueField (Localization.AtPrime 𝔪))) := by
  have h := bijective_algebraMap_quotient_of_isMaximal k 𝔪
  let e := IsLocalization.AtPrime.equivQuotMaximalIdeal 𝔪 (Localization.AtPrime 𝔪)
  have he : ⇑(algebraMap k (ResidueField (Localization.AtPrime 𝔪))) =
      ⇑e ∘ ⇑(algebraMap k (A ⧸ 𝔪)) := by
    funext c
    simp only [Function.comp_apply, e, ← Ideal.Quotient.mk_algebraMap,
      IsLocalization.AtPrime.equivQuotMaximalIdeal_apply_mk]
    rw [← IsScalarTower.algebraMap_apply]
    rfl
  rw [he]
  exact e.bijective.comp h

/-- **Generators of the maximal ideal at a smooth closed point.** If `A` is smooth over `k` at the
maximal ideal `𝔪`, the maximal ideal of `A_𝔪` is generated by the images of `e` elements of `𝔪`,
with `e ≤ rank Ω[A_𝔪⁄k]` (the conormal map `𝔪/𝔪² → k ⊗ Ω` is injective). -/
theorem exists_span_eq_maximalIdeal_of_isSmoothAt (h𝔪 : Algebra.IsSmoothAt k 𝔪) :
    ∃ (e : ℕ) (u : Fin e → A), (∀ i, u i ∈ 𝔪) ∧
      Ideal.span (Set.range (algebraMap A (Localization.AtPrime 𝔪) ∘ u)) =
        maximalIdeal (Localization.AtPrime 𝔪) ∧
      e ≤ finrank (Localization.AtPrime 𝔪) Ω[Localization.AtPrime 𝔪⁄k] := by
  classical
  let R := Localization.AtPrime 𝔪
  have : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
  have : IsNoetherianRing R := IsLocalization.isNoetherianRing 𝔪.primeCompl R inferInstance
  have : Algebra.EssFiniteType A R := .of_isLocalization R 𝔪.primeCompl
  have : Algebra.EssFiniteType k R := .comp k A R
  have : Algebra.FormallySmooth k R := h𝔪
  have : Module.Free R Ω[R⁄k] := Module.free_of_flat_of_isLocalRing
  have h1 := finrank_cotangentSpace_le_finrank_kaehler k R
    (bijective_algebraMap_residueField_atPrime k 𝔪)
  have h3 : (maximalIdeal R).spanFinrank ≤ finrank R Ω[R⁄k] := by
    rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]; exact h1
  obtain ⟨G, hGcard, hGspan⟩ :=
    (IsNoetherian.noetherian (maximalIdeal R)).exists_span_finset_card_eq_spanFinrank
  set e := G.card
  let f : Fin e → R := fun i => (G.equivFin.symm i : R)
  have hfrange : Set.range f = (G : Set R) := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact (G.equivFin.symm i).2
    · intro hx
      exact ⟨G.equivFin ⟨x, hx⟩, by simp [f]⟩
  -- numerators of the generators
  have hnum : ∀ i, ∃ a ∈ 𝔪, ∃ t : 𝔪.primeCompl, IsLocalization.mk' R a t = f i := by
    intro i
    obtain ⟨⟨a, t⟩, ht⟩ := IsLocalization.mk'_surjective 𝔪.primeCompl (f i)
    refine ⟨a, ?_, t, ht⟩
    have hfi : f i ∈ maximalIdeal R := hGspan ▸ Submodule.subset_span (hfrange ▸ ⟨i, rfl⟩)
    rw [← ht] at hfi
    exact (IsLocalization.AtPrime.mk'_mem_maximal_iff R 𝔪 a t).mp hfi
  choose num hnum𝔪 den hden using hnum
  refine ⟨e, num, hnum𝔪, le_antisymm ?_ ?_, by rw [← hGcard] at h3; exact h3⟩
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff R 𝔪 _).mpr (hnum𝔪 i)
  · rw [← hGspan, ← hfrange, Ideal.span, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, ← hden i, IsLocalization.mk'_eq_mul_mk'_one]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩)

end Cotangent

/-! ### Kunz's theorem -/

section Kunz

variable (k : Type*) [Field k] [IsAlgClosed k] [CharP k p] {A : Type*} [CommRing A] [IsDomain A]
  [Algebra k A] (K : Type*) [Field K] [CharP K p] [Algebra A K] [IsFractionRing A K]
  [Algebra k K] [IsScalarTower k A K]

omit [IsAlgClosed k] [CharP k p] hp in
/-- `dim_K Ω[K⁄k] = rank Ω[A_𝔪⁄k]` when `Ω[A_𝔪⁄k]` is free. -/
theorem finrank_kaehler_fractionRing_eq (𝔪 : Ideal A) [𝔪.IsPrime]
    [Module.Free (Localization.AtPrime 𝔪) Ω[Localization.AtPrime 𝔪⁄k]] :
    finrank K Ω[K⁄k] = finrank (Localization.AtPrime 𝔪) Ω[Localization.AtPrime 𝔪⁄k] := by
  set R := Localization.AtPrime 𝔪
  have hunit : ∀ y : 𝔪.primeCompl, IsUnit (algebraMap A K y) := fun y =>
    IsUnit.mk0 _ ((map_ne_zero_iff _ (IsFractionRing.injective A K)).2
      fun h0 => y.2 (h0 ▸ 𝔪.zero_mem))
  let : Algebra R K := (IsLocalization.lift (M := 𝔪.primeCompl) (S := R) hunit).toAlgebra
  have hAR : ∀ x : A, algebraMap R K (algebraMap A R x) = algebraMap A K x :=
    IsLocalization.lift_eq hunit
  have : IsScalarTower A R K := IsScalarTower.of_algebraMap_eq fun x => (hAR x).symm
  have : IsScalarTower k R K := IsScalarTower.of_algebraMap_eq fun c => by
    rw [IsScalarTower.algebraMap_apply k A R, hAR, ← IsScalarTower.algebraMap_apply]
  have : IsFractionRing R K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization 𝔪.primeCompl R K
  have : Algebra.FormallyEtale R K := .of_isLocalization (nonZeroDivisors R)
  rw [← (tensorKaehlerEquivOfFormallyEtale k R K).finrank_eq, Module.finrank_baseChange]

/-- **Kunz's theorem at a smooth closed point (`lem:sg-kunz`).** Let `k` be algebraically closed
of characteristic `p`, `A` a `k`-domain of finite type with fraction field `K`, smooth over `k` at
the maximal ideal `𝔪`, and `d = dim_K Ω[K⁄k]` (`= trdeg_k K`). There are `u_1, …, u_d ∈ 𝔪` and
`h ∉ 𝔪` such that `u` is a `p`-basis of `K` and of every localization `A_h` of `A` at the powers
of `h`. -/
theorem exists_isPBasis_away_of_isSmoothAt [Algebra.FiniteType k A] (𝔪 : Ideal A) [𝔪.IsMaximal]
    (h𝔪 : Algebra.IsSmoothAt k 𝔪) :
    ∃ h ∉ 𝔪, ∃ u : Fin (finrank K Ω[K⁄k]) → A, (∀ i, u i ∈ 𝔪) ∧
      IsPBasis p (algebraMap A K ∘ u) ∧
      ∀ (B : Type*) [CommRing B] [Algebra A B] [IsLocalization.Away h B] [CharP B p],
        IsPBasis p (algebraMap A B ∘ u) := by
  classical
  set R := Localization.AtPrime 𝔪
  have : CharP A p := charP_of_injective_algebraMap (algebraMap k A).injective p
  have : CharP R p := charP_of_injective_algebraMap (algebraMap k R).injective p
  have : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
  have : IsNoetherianRing R := IsLocalization.isNoetherianRing 𝔪.primeCompl R inferInstance
  have : Algebra.EssFiniteType A R := .of_isLocalization R 𝔪.primeCompl
  have : Algebra.EssFiniteType k R := .comp k A R
  have : Algebra.FormallySmooth k R := h𝔪
  have : Module.Free R Ω[R⁄k] := Module.free_of_flat_of_isLocalRing
  -- generators of the maximal ideal
  obtain ⟨e, u, hu𝔪, hspan, he⟩ := exists_span_eq_maximalIdeal_of_isSmoothAt k 𝔪 h𝔪
  -- spanning at `R = A_𝔪`
  obtain ⟨n, s, hs⟩ := exists_surjective_pSum p k R
  have hR : Function.Surjective (pSum p (algebraMap A R ∘ u)) :=
    surjective_pSum_of_span_eq_maximalIdeal k
      (bijective_algebraMap_residueField_atPrime k 𝔪).2 hs hspan
  have hspread := exists_pow_mul_mem_range_pSum 𝔪 hR
  have hne : ∀ g : A, g ∉ 𝔪 → g ≠ 0 := fun g hg h0 => hg (h0 ▸ 𝔪.zero_mem)
  -- `u` is a `p`-basis of `K`
  have hK : IsPBasis p (algebraMap A K ∘ u) := by
    refine isPBasis_of_surjective_pSum (k := k) (surjective_pSum_of_isFractionRing fun r => ?_) ?_
    · obtain ⟨g, hg, z, hz⟩ := hspread r
      have hg0 : algebraMap A K g ≠ 0 :=
        (map_ne_zero_iff _ (IsFractionRing.injective A K)).2 (hne g hg)
      have h1 : algebraMap A K r = (algebraMap A K g)⁻¹ ^ p * algebraMap A K (pSum p u z) := by
        rw [hz, map_mul, map_pow, ← mul_assoc, ← mul_pow, inv_mul_cancel₀ hg0, one_pow, one_mul]
      rw [h1]
      exact pow_mul_mem_range_pSum p _ _ (map_mem_range_pSum _ ⟨z, rfl⟩)
    · rw [finrank_kaehler_fractionRing_eq k K 𝔪]
      exact he
  have hed : e = finrank K Ω[K⁄k] := by
    rw [hK.finrank_kaehler k, Fintype.card_fin]
  subst hed
  -- spreading out
  obtain ⟨n', s', hs'⟩ := exists_surjective_pSum p k A
  choose g hg z hz using fun b : Box (Fin n') p => hspread (mono s' b.toNat)
  have hprod : ∏ b, g b ∈ 𝔪.primeCompl := prod_mem fun b _ => hg b
  refine ⟨∏ b, g b, hprod, u, hu𝔪, hK, fun B _ _ _ _ => ?_⟩
  set h := ∏ b, g b
  have hunit : ∀ b, IsUnit (algebraMap A B (g b)) := fun b =>
    isUnit_of_dvd_unit (map_dvd (algebraMap A B) (dvd_prod_of_mem g (mem_univ b)))
      (IsLocalization.Away.algebraMap_isUnit h)
  have hmono : ∀ b : Box (Fin n') p, algebraMap A B (mono s' b.toNat) ∈
      AddMonoidHom.mrange (pSum p (algebraMap A B ∘ u)) := by
    intro b
    obtain ⟨w, hw⟩ := (hunit b).exists_left_inv
    have h1 : algebraMap A B (mono s' b.toNat) = w ^ p * algebraMap A B (pSum p u (z b)) := by
      rw [hz, map_mul, map_pow, ← mul_assoc, ← mul_pow, hw, one_pow, one_mul]
    rw [h1]
    exact pow_mul_mem_range_pSum p _ _ (map_mem_range_pSum _ ⟨z b, rfl⟩)
  have halg : ∀ r : A, algebraMap A B r ∈ AddMonoidHom.mrange (pSum p (algebraMap A B ∘ u)) := by
    intro r
    obtain ⟨c, rfl⟩ := hs' r
    rw [pSum_apply, map_sum]
    refine sum_mem fun b _ => ?_
    rw [map_mul, map_pow]
    exact pow_mul_mem_range_pSum p _ _ (hmono b)
  exact ⟨injective_pSum_away_of_isFractionRing (hne h hprod) B K hK.injective,
    surjective_pSum_of_isLocalization (Submonoid.powers h) halg⟩

/-- **`lem:sg-kunz`.** Let `k` be algebraically closed of characteristic `p` and `A` a smooth
`k`-algebra which is a domain, with fraction field `K` and `d = dim_K Ω[K⁄k]` (`= trdeg_k K`). For
every maximal ideal `𝔪` there are `u_1, …, u_d ∈ 𝔪` and `h ∉ 𝔪` such that `u` is a `p`-basis of
`A_h` (and of `K`). -/
theorem exists_isPBasis_away_of_smooth [Algebra.Smooth k A] (𝔪 : Ideal A) [𝔪.IsMaximal] :
    ∃ h ∉ 𝔪, ∃ u : Fin (finrank K Ω[K⁄k]) → A, (∀ i, u i ∈ 𝔪) ∧
      IsPBasis p (algebraMap A K ∘ u) ∧
      ∀ (B : Type*) [CommRing B] [Algebra A B] [IsLocalization.Away h B] [CharP B p],
        IsPBasis p (algebraMap A B ∘ u) :=
  exists_isPBasis_away_of_isSmoothAt k K 𝔪 (by unfold Algebra.IsSmoothAt; infer_instance)

/-- **`lem:sg-kunz`, indexed by a given `p`-basis of `K`.** Same as
`exists_isPBasis_away_of_isSmoothAt`, with the local `p`-basis indexed by the index type of a given
`p`-basis `y` of the fraction field. -/
theorem exists_isPBasis_away_of_isPBasis [Algebra.FiniteType k A] {σ : Type*} [Fintype σ]
    [DecidableEq σ] {y : σ → K} (hy : IsPBasis p y) (𝔪 : Ideal A) [𝔪.IsMaximal]
    (h𝔪 : Algebra.IsSmoothAt k 𝔪) :
    ∃ h ∉ 𝔪, ∃ u : σ → A, (∀ i, u i ∈ 𝔪) ∧ IsPBasis p (algebraMap A K ∘ u) ∧
      ∀ (B : Type*) [CommRing B] [Algebra A B] [IsLocalization.Away h B] [CharP B p],
        IsPBasis p (algebraMap A B ∘ u) := by
  obtain ⟨h, hh, u, hu𝔪, hK, hB⟩ := exists_isPBasis_away_of_isSmoothAt k K 𝔪 h𝔪
  have hcard : Fintype.card σ = Fintype.card (Fin (finrank K Ω[K⁄k])) := hK.card_eq hy
  let eqv : σ ≃ Fin (finrank K Ω[K⁄k]) := Fintype.equivOfCardEq hcard
  exact ⟨h, hh, u ∘ eqv, fun i => hu𝔪 _, hK.comp_equiv eqv,
    fun B _ _ _ _ => (hB B).comp_equiv eqv⟩

variable (A) in
/-- **`cor:sg-pbasis-cover`.** A smooth `k`-domain `A` (`k` algebraically closed of characteristic
`p`) with fraction field `K` is covered by finitely many principal open sets `D(h)` on each of
which it has a `p`-basis of `d = dim_K Ω[K⁄k]` (`= trdeg_k K`) elements: there is a finite
`s ⊆ A` generating the unit ideal such that every `h ∈ s` is nonzero and some `u : Fin d → A` is a
`p`-basis of `K` and of every localization `A_h` (`charP_of_isLocalization_away` supplies the
characteristic of `A_h`). -/
theorem exists_isPBasis_cover_of_smooth [Algebra.Smooth k A] :
    ∃ s : Finset A, Ideal.span (s : Set A) = ⊤ ∧ ∀ h ∈ s, h ≠ 0 ∧
      ∃ u : Fin (finrank K Ω[K⁄k]) → A, IsPBasis p (algebraMap A K ∘ u) ∧
        ∀ (B : Type*) [CommRing B] [Algebra A B] [IsLocalization.Away h B] [CharP B p],
          IsPBasis p (algebraMap A B ∘ u) := by
  classical
  have H : ∀ 𝔪 : {𝔪 : Ideal A // 𝔪.IsMaximal}, ∃ h ∉ (𝔪 : Ideal A),
      ∃ u : Fin (finrank K Ω[K⁄k]) → A, IsPBasis p (algebraMap A K ∘ u) ∧
        ∀ (B : Type _) [CommRing B] [Algebra A B] [IsLocalization.Away h B] [CharP B p],
          IsPBasis p (algebraMap A B ∘ u) := by
    rintro ⟨𝔪, h𝔪⟩
    obtain ⟨h, hh, u, -, hK, hB⟩ := exists_isPBasis_away_of_smooth k K 𝔪
    exact ⟨h, hh, u, hK, hB⟩
  choose hm hhm um huK huB using H
  have htop : Ideal.span (Set.range hm) = ⊤ := by
    by_contra hne
    obtain ⟨𝔪, h𝔪, hle⟩ := Ideal.exists_le_maximal _ hne
    exact hhm ⟨𝔪, h𝔪⟩ (hle (Ideal.subset_span ⟨⟨𝔪, h𝔪⟩, rfl⟩))
  obtain ⟨s, hs, hspan⟩ := (Ideal.span_eq_top_iff_finite _).1 htop
  refine ⟨s, hspan, fun h hh => ?_⟩
  obtain ⟨𝔪, rfl⟩ := hs hh
  exact ⟨fun h0 => hhm 𝔪 (h0 ▸ (𝔪 : Ideal A).zero_mem), um 𝔪, huK 𝔪, huB 𝔪⟩

/-- **`lem:sg-kunz` with `d = trdeg_k K`.** If `A` is a smooth `k`-domain with fraction field `K`
of transcendence degree `d` over `k`, then for every maximal ideal `𝔪` there are
`u_1, …, u_d ∈ 𝔪` and `h ∉ 𝔪` such that `u` is a `p`-basis of `K` and of every `A_h`. -/
theorem exists_isPBasis_away_of_smooth_of_trdeg [Algebra.Smooth k A] {d : ℕ}
    (hd : Algebra.trdeg k K = d) (𝔪 : Ideal A) [𝔪.IsMaximal] :
    ∃ h ∉ 𝔪, ∃ u : Fin d → A, (∀ i, u i ∈ 𝔪) ∧ IsPBasis p (algebraMap A K ∘ u) ∧
      ∀ (B : Type*) [CommRing B] [Algebra A B] [IsLocalization.Away h B] [CharP B p],
        IsPBasis p (algebraMap A B ∘ u) := by
  have : Algebra.EssFiniteType A K := .of_isLocalization K (nonZeroDivisors A)
  have : Algebra.EssFiniteType k K := .comp k A K
  have hd' := finrank_kaehler_eq_of_trdeg (p := p) k K hd
  subst hd'
  exact exists_isPBasis_away_of_smooth k K 𝔪

variable (A) in
/-- **`cor:sg-pbasis-cover` with `d = trdeg_k K`.** -/
theorem exists_isPBasis_cover_of_smooth_of_trdeg [Algebra.Smooth k A] {d : ℕ}
    (hd : Algebra.trdeg k K = d) :
    ∃ s : Finset A, Ideal.span (s : Set A) = ⊤ ∧ ∀ h ∈ s, h ≠ 0 ∧
      ∃ u : Fin d → A, IsPBasis p (algebraMap A K ∘ u) ∧
        ∀ (B : Type*) [CommRing B] [Algebra A B] [IsLocalization.Away h B] [CharP B p],
          IsPBasis p (algebraMap A B ∘ u) := by
  have : Algebra.EssFiniteType A K := .of_isLocalization K (nonZeroDivisors A)
  have : Algebra.EssFiniteType k K := .comp k A K
  have hd' := finrank_kaehler_eq_of_trdeg (p := p) k K hd
  subst hd'
  exact exists_isPBasis_cover_of_smooth k A K

end Kunz

end EnvelopeProperty.Cartier
