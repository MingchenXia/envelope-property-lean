import EnvelopeProperty.Source.SignedProjectiveLines
import EnvelopeProperty.AlgGeom.NativeNumericalWholeFieldPresentations
import EnvelopeProperty.AlgGeom.NativeNumericalPositiveAmpleSums
import EnvelopeProperty.AlgGeom.AmpleLineTwistGeneration
import EnvelopeProperty.AlgGeom.ProjectiveBlowupSequence

/-! # Presentations of numerical classes

A *presentation* of an integral projective `k`-scheme `X` (`def:pm-presentation`) is a finite
family of morphisms `q c : X → ℙ^{d_c}` over `k`, `c ∈ Fin (r+1)`, whose first member `q 0` is a
closed immersion. Its factor lines `F_c = q_c^* 𝒪(1)` span a subspace of `N¹(X)_ℝ`, and a
presentation *of* a class `θ` is one together with coordinates `θm ∈ ℝ^{r+1}`,
`θ = ∑_c θm_c [F_c]`. The rank-`(r+1)` model `FiniteProjectiveNativeFieldModels.model q p hp`
of a presentation is the multiprojective model of the main theorem, and
`Source/PresentationFS.lean` compares its FS functions with the native ones.

* `exists_presentation` (`lem:pm-exists-presentation`): every class has a presentation. This
  repackages Codex's `exists_simultaneous_whole_field_presentation`: if
  `θ = ∑_i a_i ([F_{i+2}] - [F_1])` then `θm = (0, -∑ a_i, a_0, …)`.
* `exists_positive_presentation` (`lem:pm-exists-positive-presentation`): every ample class
  `ω ∈ Amp(X)` has a presentation with all coordinates positive. Fix a closed immersion
  `i : X → ℙ^N`; its line `F_0 = i^* 𝒪(1)` is very ample. By openness of the ample cone along
  `F_0`, `ω - ε [F_0] ∈ Amp(X)` for some `ε > 0`, hence `ω - ε [F_0] = ∑_j c_j [A_j]` with
  `c_j > 0` and `A_j` ample. Some power `A_j^{N_j}` is globally generated by finitely many
  sections; embed `X` by `i` and these powers. Then `ωm = (ε, c_j / N_j)`.
-/

open AlgebraicGeometry CategoryTheory CategoryTheory.MonoidalCategory MvPolynomial
open Scheme.Modules DeJongAlterations
noncomputable section
universe u
namespace EnvelopeProperty.Variety
open FiniteRelativeProjectiveProducts GeneratedLineFamilyProjectiveEmbedding
open NativeNumericalProjectivePresentations NativeRealNumericalClasses CanonicalGeometry
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
attribute [local instance] MvPolynomial.gradedAlgebra
noncomputable local instance presentationsMonoidal (X : Scheme.{u}) : MonoidalCategory X.Modules :=
  Scheme.Modules.monoidalCategory X

private theorem tensorInvertible {X : Scheme.{u}} {L M : X.Modules}
    (hL : IsInvertible L) (hM : IsInvertible M) : IsInvertible (L ⊗ M) :=
  (hL.tensorObj hM).of_iso (ModularCurves.monoidalTensorObjIso L M)

variable {k : Type u} [Field k] {X : Scheme.{u}} [IsIntegral X]

omit [IsIntegral X] in
/-- The first factor line of a presentation is very ample, hence ample. -/
theorem isAmple_presentationFactorLine_zero {r : ℕ} {d : Fin (r + 1) → ℕ}
    (q : ∀ c, X ⟶ projectiveSpace k (d c)) (p : X ⟶ Spec (.of k))
    (hp : ∀ c, q c ≫ projectiveSpaceStructure k (d c) = p) [IsClosedImmersion (q 0)] :
    SchemeLineAmpleness.IsAmple p (presentationFactorLine d q 0) :=
  AmpleLineTwistGeneration.isAmple_of_isVeryAmple ⟨d 0, q 0, inferInstance, hp 0, ⟨Iso.refl _⟩⟩

/-- **Every class has a presentation** (`lem:pm-exists-presentation`): there are morphisms
`q c : X → ℙ^{d_c}` over `k`, the first a closed immersion, and coordinates `θm` with
`θ = ∑_c θm_c [q_c^* 𝒪(1)]`. -/
theorem exists_presentation (p : X ⟶ Spec (.of k)) [IsProjective p] (θ : Space p) :
    ∃ (r : ℕ) (d : Fin (r + 1) → ℕ) (q : ∀ c, X ⟶ projectiveSpace k (d c))
      (_ : ∀ c, q c ≫ projectiveSpaceStructure k (d c) = p) (_ : IsClosedImmersion (q 0))
      (θm : Fin (r + 1) → ℝ),
      θ = lineFamilyMap p (presentationFactorLine d q) (presentationFactorLine_isInvertible d q)
        θm := by
  classical
  obtain ⟨n, d, f, -, hfp, h0, -, -, -, a, ha⟩ :=
    NativeNumericalWholeFieldPresentations.exists_simultaneous_whole_field_presentation p
      (fun _ : Unit => θ)
  let q := fun j : Fin (n + 1 + 1) => f ≫ (projection (polynomialFamily k d) j).left
  have hq (j : Fin (n + 1 + 1)) : q j ≫ projectiveSpaceStructure k (d j) = p := by
    change (f ≫ (projection (polynomialFamily k d) j).left) ≫ (polynomialFamily k d j).hom = p
    rw [Category.assoc, (projection (polynomialFamily k d) j).w]
    exact hfp
  have hF (c : Fin (n + 1 + 1)) :
      lineClass p (presentationFactorLine d q c) (presentationFactorLine_isInvertible d q c) =
        lineClass p (factorLine d f c) (factorLine_isInvertible d f c) := rfl
  refine ⟨n + 1, d, q, hq, h0,
    Fin.cons (0 : ℝ) (Fin.cons (-∑ i, a () i) (a ()) : Fin (n + 1) → ℝ), ?_⟩
  rw [lineFamilyMap_apply, ha (), Fin.sum_univ_succ, Fin.sum_univ_succ]
  simp only [hF, Fin.cons_zero, Fin.cons_succ, zero_smul, zero_add, smul_sub,
    Finset.sum_sub_distrib, neg_smul, ← Finset.sum_smul]
  abel

/-- An embedding by a prescribed closed immersion `i` followed by morphisms realizing finitely
many globally generated lines `L_j` (a variant of Codex's
`exists_embedding_with_closed_first_projection` whose first factor is an input). -/
theorem exists_presentation_with_first_factor (p : X ⟶ Spec (.of k)) {m₀ : ℕ}
    (i : X ⟶ projectiveSpace k m₀) (hi : IsClosedImmersion i)
    (hip : i ≫ projectiveSpaceStructure k m₀ = p) {n : ℕ}
    (L : Fin n → X.Modules) (hL : ∀ j, IsInvertible (L j))
    (G : ∀ j, (L j).GeneratingSections) (hG : ∀ j, (G j).IsFiniteType) :
    ∃ d : Fin (n + 1) → ℕ, ∃ q : ∀ c, X ⟶ projectiveSpace k (d c),
      (∀ c, q c ≫ projectiveSpaceStructure k (d c) = p) ∧ IsClosedImmersion (q 0) ∧
        Nonempty (presentationFactorLine d q 0 ≅
          (pullback i).obj (coordinateHyperplaneTwist (R := k) (0 : Fin (m₀ + 1)) 1)) ∧
        ∀ j : Fin n, Nonempty (presentationFactorLine d q j.succ ≅ L j) := by
  choose m g c e hg using fun j => GeneratedLineProjectiveTwist.exists_projective_morphism p
    (hL j) (G j) (hG j)
  let d : Fin (n + 1) → ℕ := Fin.cases m₀ m
  let F := polynomialFamily k d
  let h : ∀ j : Fin (n + 1), Over.mk p ⟶ F j := Fin.cases (Over.homMk i hip)
    (fun j => Over.homMk (g j) (hg j).1)
  let f := (lift F h).left
  have hfirst : f ≫ (projection F (0 : Fin (n + 1))).left = i :=
    congrArg (fun z => z.left) (lift_projection F h (0 : Fin (n + 1)))
  refine ⟨d, fun c => f ≫ (projection F c).left, fun c => ?_, ?_, ?_, fun j => ?_⟩
  · change (f ≫ (projection F c).left) ≫ (F c).hom = p
    rw [Category.assoc, (projection F c).w]
    exact (lift F h).w
  · change IsClosedImmersion (f ≫ (projection F (0 : Fin (n + 1))).left)
    rw [hfirst]
    exact hi
  · exact ⟨eqToIso (congrArg (fun z => (pullback z).obj
      (coordinateHyperplaneTwist (R := k) (0 : Fin (m₀ + 1)) 1)) hfirst)⟩
  · have hj : f ≫ (projection F j.succ).left = g j :=
      congrArg (fun z => z.left) (lift_projection F h j.succ)
    exact ⟨eqToIso (congrArg (fun z => (pullback z).obj
      (coordinateHyperplaneTwist (R := k) (0 : Fin (m j + 1)) 1)) hj) ≪≫ e j⟩

/-- **Every ample class has a positive presentation** (`lem:pm-exists-positive-presentation`):
a presentation `ω = ∑_c ωm_c [q_c^* 𝒪(1)]` with all `ωm_c > 0`. -/
theorem exists_positive_presentation (p : X ⟶ Spec (.of k)) [IsProjective p] (ω : Space p)
    (hω : ω ∈ ampleCone p) :
    ∃ (r : ℕ) (d : Fin (r + 1) → ℕ) (q : ∀ c, X ⟶ projectiveSpace k (d c))
      (_ : ∀ c, q c ≫ projectiveSpaceStructure k (d c) = p) (_ : IsClosedImmersion (q 0))
      (ωm : Fin (r + 1) → ℝ), (∀ c, 0 < ωm c) ∧
        ω = lineFamilyMap p (presentationFactorLine d q) (presentationFactorLine_isInvertible d q)
          ωm := by
  classical
  obtain ⟨m₀, i, hi, hip⟩ := (ProjectiveBlowupSequence.isProjectiveOver_iff p).mpr
    (ProjectiveFactorizationRingIso.of_isProjective p)
  let F₀ := (pullback i).obj (coordinateHyperplaneTwist (R := k) (0 : Fin (m₀ + 1)) 1)
  have hF₀ : SchemeLineAmpleness.IsAmple p F₀ :=
    AmpleLineTwistGeneration.isAmple_of_isVeryAmple ⟨m₀, i, hi, hip, ⟨Iso.refl _⟩⟩
  obtain ⟨ε, hε, hball⟩ := exists_ampleCone_lineFamily_radius p (fun _ : Unit => F₀)
    (fun _ => hF₀.isInvertible) ω hω
  have hsub : ω - (ε / 2) • lineClass p F₀ hF₀.isInvertible ∈ ampleCone p := by
    have h := hball (fun _ => -(ε / 2)) (fun _ => by
      show |-(ε / 2)| < ε
      rw [abs_neg, abs_of_pos (half_pos hε)]
      linarith)
    simp only [lineFamilyMap_apply, Fintype.sum_unique, neg_smul, ← sub_eq_add_neg] at h
    exact h
  obtain ⟨n, -, A, hA, a, ha, hsum⟩ := exists_positive_ample_line_sum p _ hsub
  choose N hN using fun j => AmpleLineTwistGeneration.exists_eventual_generatingSections p (A j)
    (hA j) (unitObj X) isInvertible_unit
  let M : Fin n → X.Modules := fun j => bundleTensorPower (A j) (N j + 1) ⊗ unitObj X
  have hP (j : Fin n) : IsInvertible (bundleTensorPower (A j) (N j + 1)) :=
    TensorPowerBaseIdealGrading.tensorPower_isInvertible (hA j).isInvertible (N j + 1)
  have hM (j : Fin n) : IsInvertible (M j) := tensorInvertible (hP j) isInvertible_unit
  choose G hG using fun j => hN j (N j + 1) (Nat.le_succ _)
  obtain ⟨d, q, hq, h0, ⟨e₀⟩, he⟩ := exists_presentation_with_first_factor p i hi hip M hM G hG
  have hc₀ : lineClass p (presentationFactorLine d q 0)
      (presentationFactorLine_isInvertible d q 0) =
      lineClass p F₀ hF₀.isInvertible := lineClass_eq_of_iso p _ _ e₀
  have hcj (j : Fin n) :
      lineClass p (presentationFactorLine d q j.succ)
          (presentationFactorLine_isInvertible d q j.succ) =
        ((N j + 1 : ℕ) : ℝ) • lineClass p (A j) (hA j).isInvertible := by
    calc
      _ = lineClass p (M j) (hM j) := lineClass_eq_of_iso p _ _ (he j).some
      _ = lineClass p (bundleTensorPower (A j) (N j + 1)) (hP j) +
          lineClass p (unitObj X) isInvertible_unit := lineClass_tensor p _ _ _ _
      _ = ((N j + 1 : ℕ) : ℝ) • lineClass p (A j) (hA j).isInvertible + 0 := by
          rw [lineClass_tensorPower p (A j) (hA j).isInvertible (N j + 1), lineClass_unit p]
      _ = _ := add_zero _
  have hN₀ (j : Fin n) : (0 : ℝ) < ((N j + 1 : ℕ) : ℝ) := Nat.cast_pos.mpr (Nat.succ_pos _)
  refine ⟨n, d, q, hq, h0, Fin.cons (ε / 2) (fun j => a j / ((N j + 1 : ℕ) : ℝ)), ?_, ?_⟩
  · intro c
    refine Fin.cases ?_ (fun j => ?_) c
    · simpa only [Fin.cons_zero] using half_pos hε
    · simpa only [Fin.cons_succ] using div_pos (ha j) (hN₀ j)
  · rw [lineFamilyMap_apply, Fin.sum_univ_succ]
    simp only [Fin.cons_zero, Fin.cons_succ, hc₀, hcj, smul_smul]
    have hcancel (j : Fin n) : a j / ((N j + 1 : ℕ) : ℝ) * ((N j + 1 : ℕ) : ℝ) = a j :=
      div_mul_cancel₀ _ (hN₀ j).ne'
    simp only [hcancel]
    rw [← lineFamilyMap_apply p A (fun j => (hA j).isInvertible) a, ← hsum]
    abel

end EnvelopeProperty.Variety
