import EnvelopeProperty.Local.PLGerms
import EnvelopeProperty.Projective.GaussModificationModel
import EnvelopeProperty.Projective.Jm

/-!
# Actual vertical product ideals for rational PL functions

Rational FS weights are cleared to construct genuine finite homogeneous ideals
on the actual projective product. Compactness allows a parameter-power generator
to be added without altering the function on the given subvariety. This supplies
ideal data toward the test-configuration construction in local positivity; it
does not assert a normal blowup, a Cartier line bundle, or any nefness theorem.
-/

open scoped Classical Polynomial NNReal ENNReal Topology
open CategoryTheory AlgebraicGeometry
open EnvelopeProperty.Berkovich
noncomputable section
universe u
attribute [local instance] MvPolynomial.gradedAlgebra

namespace EnvelopeProperty.ProjBerk
variable {k : Type u} [Field k] {n : ℕ}
private local instance productModelProper :
    IsProper (nativePolynomialLineProductStructure (R := k) (n := n)) :=
  nativePolynomialLineProductStructure_isProper

/-- A genuine homogeneous polynomial over the actual polynomial model base. -/
def modelMonomial (s : MvPolynomial (Fin (n + 1)) k) (N e : ℕ) :
    MvPolynomial (Fin (n + 1)) k[X] :=
  MvPolynomial.map Polynomial.C (s ^ N) * MvPolynomial.C (Polynomial.X ^ e)

private theorem swap_map_C (s : MvPolynomial (Fin (n + 1)) k) :
    polynomialCoefficientSwap k (Fin (n + 1)) (MvPolynomial.map Polynomial.C s) =
      Polynomial.C s := by
  induction s using MvPolynomial.induction_on with
  | C a => simp only [MvPolynomial.map_C, polynomialCoefficientSwap_C, Polynomial.map_C]
  | add p q hp hq => simp only [map_add, hp, hq]
  | mul_X p i hp => simp only [map_mul, MvPolynomial.map_X, polynomialCoefficientSwap_X, hp]

theorem swap_modelMonomial (s : MvPolynomial (Fin (n + 1)) k) (N e : ℕ) :
    polynomialCoefficientSwap k (Fin (n + 1)) (modelMonomial s N e) =
      Polynomial.C (s ^ N) * Polynomial.X ^ e := by
  simp only [modelMonomial, map_mul, swap_map_C, polynomialCoefficientSwap_C,
    Polynomial.map_pow, Polynomial.map_X]

theorem isHomogeneous_modelMonomial {s : MvPolynomial (Fin (n + 1)) k} {d : ℕ}
    (hs : s.IsHomogeneous d) (N e : ℕ) :
    (modelMonomial s N e).IsHomogeneous (d * N) := by
  simpa only [add_zero, modelMonomial] using
    ((hs.pow N).map Polynomial.C).mul (MvPolynomial.isHomogeneous_C _ (Polynomial.X ^ e))

/-- The ideal generated by an actual finite homogeneous family on the polynomial-base model. -/
def productIdealOfGenerators (s : Finset (MvPolynomial (Fin (n + 1)) k[X]))
    (hs : ∀ F ∈ s, ∃ d : ℕ, F.IsHomogeneous d) :
    HomogeneousIdeal (ProjectiveGrading k[X] n) :=
  ⟨Ideal.span (s : Set (MvPolynomial (Fin (n + 1)) k[X])),
    Ideal.homogeneous_span _ _ hs⟩

theorem productIdealOfGenerators_fg (s : Finset (MvPolynomial (Fin (n + 1)) k[X]))
    (hs : ∀ F ∈ s, ∃ d : ℕ, F.IsHomogeneous d) :
    (productIdealOfGenerators s hs).toIdeal.FG := ⟨s, rfl⟩

/-- The intrinsic actual-product logarithm of an explicitly generated ideal is the
finite maximum of the original whole Gauss generator logarithms. -/
theorem modelIdealLog_productIdealOfGenerators
    (s : Finset (MvPolynomial (Fin (n + 1)) k[X]))
    (hs : ∀ F ∈ s, ∃ d : ℕ, F.IsHomogeneous d) (v : ProjBerk k n) :
    RelativeSchemeValuedPoint.modelIdealLog
      (nativePolynomialLineProductIdeal (productIdealOfGenerators s hs))
      gaussModelCoefficient_le_one (gaussProductPoint v) =
      s.sup fun F => Berk.logAbs (polynomialCoefficientSwap k (Fin (n + 1)) F)
        (gaussExt v) := by
  rw [← phiIdeal_eq_gaussProductModelIdealLog]
  change phiIdeal ((Ideal.span (s : Set (MvPolynomial (Fin (n + 1)) k[X]))).map _) v = _
  rw [Ideal.map_span]
  have hset : (polynomialCoefficientSwap k (Fin (n + 1))).toRingHom ''
      (s : Set (MvPolynomial (Fin (n + 1)) k[X])) =
      (s.image (polynomialCoefficientSwap k (Fin (n + 1))) :
        Set (MvPolynomial (Fin (n + 1)) k)[X]) := by
    ext F
    simp
  rw [hset, phiIdeal_span_finset, Finset.sup_image]
  rfl

namespace FSData
variable {a : ℚ} (D : FSData k n a)

/-- Clearing the actual rational weights gives explicit nonnegative parameter
exponents and a single integer shift. -/
theorem exists_integral_model_weights (hD : D.IsRational) :
    ∃ (N : ℕ) (_ : 0 < N) (C : ℤ)
      (e : MvPolynomial (Fin (n + 1)) k × ℝ → ℕ),
      ∀ t ∈ D.terms, (e t : ℝ) = C - (N : ℝ) * t.2 := by
  obtain ⟨N, hN, hz⟩ := exists_pos_nat_mul_eq_int D.terms (fun t => t.2) hD
  choose z hz using fun t : {t // t ∈ D.terms} => hz t.1 t.2
  let z' (t : MvPolynomial (Fin (n + 1)) k × ℝ) : ℤ :=
    if ht : t ∈ D.terms then z ⟨t, ht⟩ else 0
  let C : ℤ := ∑ t ∈ D.terms, |z' t|
  have hle (t) (ht : t ∈ D.terms) : z' t ≤ C :=
    (le_abs_self (z' t)).trans
      (Finset.single_le_sum (fun j _ => abs_nonneg (z' j)) ht)
  refine ⟨N, hN, C, fun t => (C - z' t).toNat, fun t ht => ?_⟩
  have hcast : (((C - z' t).toNat : ℕ) : ℤ) = C - z' t :=
    Int.toNat_of_nonneg (sub_nonneg.mpr (hle t ht))
  have hzt : (z' t : ℝ) = (N : ℝ) * t.2 := by
    simp only [z', dif_pos ht]
    exact (hz ⟨t, ht⟩).symm
  calc (((C - z' t).toNat : ℕ) : ℝ) = ((C - z' t : ℤ) : ℝ) := by exact_mod_cast hcast
    _ = (C : ℝ) - (N : ℝ) * t.2 := by push_cast; rw [hzt]

/-- Rational FS data construct a genuine finite homogeneous product ideal whose
intrinsic whole Gauss logarithm is an integral multiple of the FS function,
up to a single integral constant. No model ideal is supplied as an input. -/
theorem exists_productIdeal_model (hD : D.IsRational) :
    ∃ (r : ℕ) (_ : 0 < r) (C : ℤ)
      (J : HomogeneousIdeal (ProjectiveGrading k[X] n)),
      J.toIdeal.FG ∧ ∀ v : ProjBerk k n,
      RelativeSchemeValuedPoint.modelIdealLog (nativePolynomialLineProductIdeal J)
        gaussModelCoefficient_le_one (gaussProductPoint v) =
        ((r : ℝ) : EReal) * D.eval v - ((C : ℝ) : EReal) := by
  obtain ⟨N, hN, C, e, he⟩ := D.exists_integral_model_weights hD
  let S := D.terms.image fun t => modelMonomial t.1 N (e t)
  have hS : ∀ F ∈ S, ∃ d : ℕ, F.IsHomogeneous d := by
    intro F hF
    obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hF
    exact ⟨D.deg * N, isHomogeneous_modelMonomial (D.isHomogeneous t ht) N (e t)⟩
  refine ⟨D.m * N, Nat.mul_pos D.m_pos hN, C,
    productIdealOfGenerators S hS, productIdealOfGenerators_fg S hS, fun v => ?_⟩
  rw [modelIdealLog_productIdealOfGenerators S hS v]
  have hlog (t) (ht : t ∈ D.terms) :
      Berk.logAbs (polynomialCoefficientSwap k (Fin (n + 1))
        (modelMonomial t.1 N (e t))) (gaussExt v) =
      ((N : ℝ) : EReal) * termVal t v - ((C : ℝ) : EReal) := by
    rw [swap_modelMonomial, logAbs_C_mul_X_pow_gaussExt, logAbs_pow,
      termVal_def, ereal_coe_mul_add (Nat.cast_nonneg N)]
    have he' : -((e t : ℝ) : EReal) =
        (((N : ℝ) * t.2 - (C : ℝ) : ℝ) : EReal) := by
      rw [← EReal.coe_neg, he t ht]
      congr 1
      ring
    change ((N : ℝ) : EReal) * logAbs t.1 v - ((e t : ℝ) : EReal) = _
    simp only [sub_eq_add_neg]
    rw [he', EReal.coe_sub, EReal.coe_mul, sub_eq_add_neg]
    ac_rfl
  have hshift : (D.terms.sup fun t =>
      ((N : ℝ) : EReal) * termVal t v - ((C : ℝ) : EReal)) =
      (D.terms.sup fun t => ((N : ℝ) : EReal) * termVal t v) - ((C : ℝ) : EReal) := by
    exact (Finset.apply_sup_eq_sup_comp_of_linearOrder
      (fun x : EReal => x - ((C : ℝ) : EReal))
      (fun _ _ h => by
        simpa only [sub_eq_add_neg] using add_le_add_left h (-((C : ℝ) : EReal)))
      (by simp)).symm
  calc S.sup (fun F => Berk.logAbs (polynomialCoefficientSwap k (Fin (n + 1)) F)
        (gaussExt v)) = D.terms.sup (fun t =>
          ((N : ℝ) : EReal) * termVal t v - ((C : ℝ) : EReal)) := by
        dsimp only [S]
        rw [Finset.sup_image]
        exact Finset.sup_congr rfl hlog
    _ = ((N : ℝ) : EReal) * (D.terms.sup fun t => termVal t v) - ((C : ℝ) : EReal) := by
        rw [hshift, ereal_coe_mul_finset_sup (Nat.cast_pos.mpr hN)]
    _ = ((D.m * N : ℕ) : ℝ) * D.eval v - ((C : ℝ) : EReal) := by
        rw [D.eval_def, ereal_coe_mul_coe_mul]
        have hc : ((D.m * N : ℕ) : ℝ) * (D.m : ℝ)⁻¹ = (N : ℝ) := by
          push_cast
          field_simp [D.m_ne_zero]
        rw [hc]

end FSData

/-- The actual principal homogeneous ideal generated by a model parameter power. -/
def parameterIdeal (A : ℕ) : HomogeneousIdeal (ProjectiveGrading k[X] n) :=
  productIdealOfGenerators {MvPolynomial.C (Polynomial.X ^ A)} (by
    intro F hF
    obtain rfl := Finset.mem_singleton.mp hF
    exact ⟨0, MvPolynomial.isHomogeneous_C _ _⟩)

theorem modelIdealLog_parameterIdeal (A : ℕ) (v : ProjBerk k n) :
    RelativeSchemeValuedPoint.modelIdealLog
      (nativePolynomialLineProductIdeal (parameterIdeal (k := k) (n := n) A))
      gaussModelCoefficient_le_one (gaussProductPoint v) = -((A : ℝ) : EReal) := by
  rw [parameterIdeal, modelIdealLog_productIdealOfGenerators]
  simp only [Finset.sup_singleton, polynomialCoefficientSwap_C, Polynomial.map_pow,
    Polynomial.map_X, Berk.logAbs_pow, logAbs_X_gaussExt, mul_neg_one]
  rfl

/-- Adjoining a genuine parameter-power generator, as a homogeneous ideal sum. -/
def verticalTruncation (J : HomogeneousIdeal (ProjectiveGrading k[X] n)) (A : ℕ) :
    HomogeneousIdeal (ProjectiveGrading k[X] n) := J ⊔ parameterIdeal A

theorem parameterPower_mem_verticalTruncation
    (J : HomogeneousIdeal (ProjectiveGrading k[X] n)) (A : ℕ) :
    MvPolynomial.C (Polynomial.X ^ A) ∈ (verticalTruncation J A).toIdeal := by
  apply Ideal.mem_sup_right
  exact Ideal.subset_span (by simp)

/-- The whole intrinsic model logarithm of parameter truncation is the actual
maximum with the logarithm of the adjoined generator. -/
theorem modelIdealLog_verticalTruncation
    (J : HomogeneousIdeal (ProjectiveGrading k[X] n)) (A : ℕ) (v : ProjBerk k n) :
    RelativeSchemeValuedPoint.modelIdealLog
      (nativePolynomialLineProductIdeal (verticalTruncation J A))
      gaussModelCoefficient_le_one (gaussProductPoint v) =
      max (RelativeSchemeValuedPoint.modelIdealLog (nativePolynomialLineProductIdeal J)
        gaussModelCoefficient_le_one (gaussProductPoint v)) (-((A : ℝ) : EReal)) := by
  rw [← modelIdealLog_parameterIdeal A v]
  simp only [← phiIdeal_eq_gaussProductModelIdealLog, verticalTruncation,
    HomogeneousIdeal.toIdeal_sup, Ideal.map_sup, phiIdeal_eq_idealLog]
  exact Berk.idealLog_sup (x := gaussExt v) (gaussExt_val_le_one v) _ _

/-- Actual homogeneous powers, retaining the entire original ideal. -/
def homogeneousIdealPow (J : HomogeneousIdeal (ProjectiveGrading k[X] n)) (r : ℕ) :
    HomogeneousIdeal (ProjectiveGrading k[X] n) :=
  ⟨J.toIdeal ^ r, by
    induction r with
    | zero =>
      simpa only [pow_zero, Ideal.one_eq_top] using
        (Ideal.IsHomogeneous.top (𝒜 := ProjectiveGrading k[X] n))
    | succ r hr =>
      rw [pow_succ]
      exact Ideal.IsHomogeneous.mul (𝒜 := ProjectiveGrading k[X] n) hr J.isHomogeneous⟩

theorem modelIdealLog_homogeneousIdealPow
    (J : HomogeneousIdeal (ProjectiveGrading k[X] n)) (r : ℕ) (v : ProjBerk k n) :
    RelativeSchemeValuedPoint.modelIdealLog
      (nativePolynomialLineProductIdeal (homogeneousIdealPow J r))
      gaussModelCoefficient_le_one (gaussProductPoint v) =
      ((r : ℝ) : EReal) *
        RelativeSchemeValuedPoint.modelIdealLog (nativePolynomialLineProductIdeal J)
          gaussModelCoefficient_le_one (gaussProductPoint v) := by
  simp only [← phiIdeal_eq_gaussProductModelIdealLog]
  change phiIdeal ((J.toIdeal ^ r).map _) v = _
  rw [Ideal.map_pow, phiIdeal_pow]
  rfl

end EnvelopeProperty.ProjBerk

namespace EnvelopeProperty.ProjSubvariety
variable {k : Type u} [Field k] {M : ℕ} {X : ProjSubvariety k M}
open ProjBerk
private local instance productModelProper :
    IsProper (nativePolynomialLineProductStructure (R := k) (n := M)) :=
  nativePolynomialLineProductStructure_isProper

/-- Every actual rational finite-FS function constructs a genuine finite vertical
homogeneous ideal on the actual ambient product, with its exact intrinsic Gauss
model logarithm on the given subvariety. Verticality is witnessed by an actual
positive parameter power in the ideal, rather than assumed. -/
theorem IsFiniteFS.exists_vertical_productIdeal_model {a : ℚ} {φ : X.an → ℝ}
    (hφ : X.IsFiniteFS a φ) :
    ∃ (r : ℕ) (_ : 0 < r) (C : ℤ)
      (J : HomogeneousIdeal (ProjectiveGrading k[X] M)),
      J.toIdeal.FG ∧
      (∃ A : ℕ, 0 < A ∧ MvPolynomial.C (Polynomial.X ^ A) ∈ J.toIdeal) ∧
      ∀ v : X.an, RelativeSchemeValuedPoint.modelIdealLog
        (nativePolynomialLineProductIdeal J) gaussModelCoefficient_le_one
        (gaussProductPoint v.1) = (((r : ℝ) * φ v - (C : ℝ) : ℝ) : EReal) := by
  have hφcont := hφ.continuous
  obtain ⟨D, hD, _hfin, heval⟩ := hφ
  obtain ⟨r, hr, C, J, _hfg, hJ⟩ := D.exists_productIdeal_model hD
  have hcont : Continuous fun v : X.an => (r : ℝ) * φ v - (C : ℝ) :=
    (continuous_const.mul hφcont).sub continuous_const
  obtain ⟨B, hB⟩ := isCompact_univ.exists_bound_of_continuousOn hcont.continuousOn
  obtain ⟨A, hA⟩ := exists_nat_gt (max B 0)
  have hApos : 0 < A := by
    have : (0 : ℝ) < A := lt_of_le_of_lt (le_max_right B 0) hA
    exact_mod_cast this
  have hbound (v : X.an) : -(A : ℝ) ≤ (r : ℝ) * φ v - (C : ℝ) := by
    have hb := hB v (Set.mem_univ v)
    rw [Real.norm_eq_abs] at hb
    have hBA : B ≤ (A : ℝ) := (le_max_left B 0).trans hA.le
    exact (neg_le_neg hBA).trans (neg_le_of_abs_le hb)
  refine ⟨r, hr, C, verticalTruncation J A, IsNoetherian.noetherian _,
    ⟨A, hApos, parameterPower_mem_verticalTruncation J A⟩, fun v => ?_⟩
  rw [modelIdealLog_verticalTruncation, hJ, ← heval, ← EReal.coe_mul, ← EReal.coe_sub]
  apply max_eq_left
  exact_mod_cast hbound v

/-- Actual PL data construct two genuine finite vertical homogeneous ideals on
the ambient product. Their finite intrinsic Gauss logarithms recover an integer
multiple of the original PL function, with an integral constant. -/
theorem IsPL.exists_vertical_productIdeal_models {φ : X.an → ℝ} (hφ : X.IsPL φ) :
    ∃ (r : ℕ) (_ : 0 < r) (C : ℤ)
      (I J : HomogeneousIdeal (ProjectiveGrading k[X] M)),
      I.toIdeal.FG ∧ J.toIdeal.FG ∧
      (∃ A : ℕ, 0 < A ∧ MvPolynomial.C (Polynomial.X ^ A) ∈ I.toIdeal) ∧
      (∃ B : ℕ, 0 < B ∧ MvPolynomial.C (Polynomial.X ^ B) ∈ J.toIdeal) ∧
      (∀ v : X.an,
        RelativeSchemeValuedPoint.modelIdealLog (nativePolynomialLineProductIdeal I)
          gaussModelCoefficient_le_one (gaussProductPoint v.1) ≠ ⊥ ∧
        RelativeSchemeValuedPoint.modelIdealLog (nativePolynomialLineProductIdeal J)
          gaussModelCoefficient_le_one (gaussProductPoint v.1) ≠ ⊥) ∧
      ∀ v : X.an, (((r : ℝ) * φ v : ℝ) : EReal) =
        RelativeSchemeValuedPoint.modelIdealLog (nativePolynomialLineProductIdeal I)
          gaussModelCoefficient_le_one (gaussProductPoint v.1) -
        RelativeSchemeValuedPoint.modelIdealLog (nativePolynomialLineProductIdeal J)
          gaussModelCoefficient_le_one (gaussProductPoint v.1) + ((C : ℝ) : EReal) := by
  obtain ⟨a, b, α, β, hα, hβ, heq⟩ := isPL_iff.mp hφ
  obtain ⟨r₁, hr₁, C₁, I₀, _hfgI, ⟨A, hA, hAI⟩, hI⟩ :=
    hα.exists_vertical_productIdeal_model
  obtain ⟨r₂, hr₂, C₂, J₀, _hfgJ, ⟨B, hB, hBJ⟩, hJ⟩ :=
    hβ.exists_vertical_productIdeal_model
  refine ⟨r₁ * r₂, Nat.mul_pos hr₁ hr₂, (r₂ : ℤ) * C₁ - (r₁ : ℤ) * C₂,
    homogeneousIdealPow I₀ r₂, homogeneousIdealPow J₀ r₁,
    IsNoetherian.noetherian _, IsNoetherian.noetherian _, ?_, ?_, ?_, ?_⟩
  · refine ⟨A * r₂, Nat.mul_pos hA hr₂, ?_⟩
    change MvPolynomial.C (Polynomial.X ^ (A * r₂)) ∈ I₀.toIdeal ^ r₂
    simpa only [← map_pow, ← pow_mul] using Ideal.pow_mem_pow hAI r₂
  · refine ⟨B * r₁, Nat.mul_pos hB hr₁, ?_⟩
    change MvPolynomial.C (Polynomial.X ^ (B * r₁)) ∈ J₀.toIdeal ^ r₁
    simpa only [← map_pow, ← pow_mul] using Ideal.pow_mem_pow hBJ r₁
  · intro v
    rw [modelIdealLog_homogeneousIdealPow, modelIdealLog_homogeneousIdealPow, hI, hJ,
      ← EReal.coe_mul, ← EReal.coe_mul]
    exact ⟨EReal.coe_ne_bot _, EReal.coe_ne_bot _⟩
  · intro v
    rw [modelIdealLog_homogeneousIdealPow, modelIdealLog_homogeneousIdealPow, hI, hJ,
      ← EReal.coe_mul, ← EReal.coe_mul, ← EReal.coe_sub, ← EReal.coe_add]
    congr 1
    rw [heq v]
    push_cast
    ring

/-- Local convexity supplies genuine vertical product ideal data through the
proved PL sheaf construction, before any nefness or positivity criterion. -/
theorem IsLocallyConvex.exists_vertical_productIdeal_models {a : ℚ} {φ : X.an → ℝ}
    (hφ : X.IsLocallyConvex a φ) :
    ∃ (r : ℕ) (_ : 0 < r) (C : ℤ)
      (I J : HomogeneousIdeal (ProjectiveGrading k[X] M)),
      I.toIdeal.FG ∧ J.toIdeal.FG ∧
      (∃ A : ℕ, 0 < A ∧ MvPolynomial.C (Polynomial.X ^ A) ∈ I.toIdeal) ∧
      (∃ B : ℕ, 0 < B ∧ MvPolynomial.C (Polynomial.X ^ B) ∈ J.toIdeal) ∧
      (∀ v : X.an,
        RelativeSchemeValuedPoint.modelIdealLog (nativePolynomialLineProductIdeal I)
          gaussModelCoefficient_le_one (gaussProductPoint v.1) ≠ ⊥ ∧
        RelativeSchemeValuedPoint.modelIdealLog (nativePolynomialLineProductIdeal J)
          gaussModelCoefficient_le_one (gaussProductPoint v.1) ≠ ⊥) ∧
      ∀ v : X.an, (((r : ℝ) * φ v : ℝ) : EReal) =
        RelativeSchemeValuedPoint.modelIdealLog (nativePolynomialLineProductIdeal I)
          gaussModelCoefficient_le_one (gaussProductPoint v.1) -
        RelativeSchemeValuedPoint.modelIdealLog (nativePolynomialLineProductIdeal J)
          gaussModelCoefficient_le_one (gaussProductPoint v.1) + ((C : ℝ) : EReal) :=
  hφ.isPL.exists_vertical_productIdeal_models

end EnvelopeProperty.ProjSubvariety
