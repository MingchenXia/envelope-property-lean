import EnvelopeProperty.Local.PLGaussVerticalCurveSurfaceSelectionSheaf
import EnvelopeProperty.Berkovich.SchemeIdealPullback

/-! # Actual original principal equations of the constructed closed cuts

The WHOLE actual quotient ideal and its pullback are the principal ideals
of the existing literal original form section and actual appLE image.
No local principal/matching certificate is assumed, including zero forms.
-/
noncomputable section
open CategoryTheory AlgebraicGeometry MvPolynomial
open EnvelopeProperty.ProjBerk
universe u
namespace EnvelopeProperty.PLGaussVerticalCurveSurfaceSelectionEquation
open PLGaussVerticalCurveSurfaceSelectionSheaf
attribute [local instance] MvPolynomial.gradedAlgebra
variable {R : Type u} [CommRing R] {n : ℕ}

/-- The original whole projective hypersurface ideal is generated by the literal native form section. -/
theorem projectiveHypersurfaceIdeal_coordinateIdeal {d : ℕ}
    (F : MvPolynomial (Fin (n + 1)) R) (hF : F.IsHomogeneous d) (j : Fin (n + 1)) :
    (projectiveHypersurfaceIdeal F hF).ideal ⟨nativeCoordinateOpen j, nativeCoordinateOpen_isAffine j⟩ =
      Ideal.span {nativeFormSection j F} := by
  have h := homogeneousQuotient_coordinateSectionIdeal (homogeneousPrincipalIdeal F hF) j
  have hcancel := Ideal.map_comap_of_surjective (nativeCoordinateSectionsIso (R := R) j).hom.hom
    (nativeCoordinateSectionsIso (R := R) j).commRingCatIsoToRingEquiv.surjective
    ((EnvelopeProperty.GradedQuotient.quotientIdealSheaf (ProjectiveGrading R n)
      (homogeneousPrincipalIdeal F hF)).ideal
        ⟨nativeCoordinateOpen j, nativeCoordinateOpen_isAffine j⟩)
  exact hcancel.symm.trans ((congrArg (Ideal.map (nativeCoordinateSectionsIso (R := R) j).hom.hom) h).trans
    (by
      change Ideal.map (nativeCoordinateSectionsIso (R := R) j).hom.hom
        (Ideal.map (coordinateDehom j).toRingHom (Ideal.span {F})) =
          Ideal.span {nativeFormSection j F}
      simp only [Ideal.map_span, Set.image_singleton]
      rfl))

/-- EVERY original affine refinement has the SAME actual appLE image as its whole principal cut generator. -/
theorem originalHypersurfaceCut_affineIdeal {Y : Scheme.{u}}
    (i : Y ⟶ NativeProjectiveScheme R n) {d : ℕ}
    (F : MvPolynomial (Fin (n + 1)) R) (hF : F.IsHomogeneous d)
    (U : Y.affineOpens) (j : Fin (n + 1)) (h : U.1 ≤ i ⁻¹ᵁ nativeCoordinateOpen j) :
    (originalHypersurfaceCut i F hF).ideal U =
      Ideal.span {(i.appLE (nativeCoordinateOpen j) U h) (nativeFormSection j F)} := by
  have hp := Scheme.IdealSheafData.comap_ideal_of_affine_opens
    (projectiveHypersurfaceIdeal F hF) i U
    ⟨nativeCoordinateOpen j, nativeCoordinateOpen_isAffine j⟩ h
  exact hp.trans (by rw [projectiveHypersurfaceIdeal_coordinateIdeal, Ideal.map_span, Set.image_singleton])

end EnvelopeProperty.PLGaussVerticalCurveSurfaceSelectionEquation
