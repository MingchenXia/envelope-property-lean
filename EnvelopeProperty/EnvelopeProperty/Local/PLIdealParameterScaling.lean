import EnvelopeProperty.Local.PLIdealModels

/-!
# Actual parameter substitutions and whole monomial-ideal invariance

The true ring substitutions t ↦ c t compose by multiplication. Explicit
parameter-monomial generators transform by their actual coefficient weights,
so the whole original generated ideal is invariant under every unit scaling.
No arbitrary vertical-ideal invariance or Gauss-function inference is used.
These are ring-level producers, prior to a scheme group action.
-/

open scoped Classical Polynomial
noncomputable section
universe u
namespace EnvelopeProperty
variable {R : Type u} [CommRing R] {σ : Type*}

/-- The genuine whole coefficient-polynomial substitution t ↦ c t. -/
def parameterScaleHom (c : R) : R[X] →+* R[X] :=
  Polynomial.eval₂RingHom Polynomial.C (Polynomial.C c * Polynomial.X)

@[simp]
theorem parameterScaleHom_C (c r : R) : parameterScaleHom c (Polynomial.C r) = Polynomial.C r := by
  simp [parameterScaleHom]

@[simp]
theorem parameterScaleHom_X (c : R) :
    parameterScaleHom c Polynomial.X = Polynomial.C c * Polynomial.X := by
  simp [parameterScaleHom]

theorem parameterScaleHom_comp (c d : R) :
    (parameterScaleHom c).comp (parameterScaleHom d) = parameterScaleHom (c * d) := by
  apply Polynomial.ringHom_ext
  · intro r
    simp
  · simp only [RingHom.comp_apply, map_mul, parameterScaleHom_C, parameterScaleHom_X]
    ring

theorem parameterScaleHom_one : parameterScaleHom (1 : R) = RingHom.id R[X] := by
  apply Polynomial.ringHom_ext
  · intro r
    simp
  · simp

/-- An actual parameter monomial over an arbitrary commutative coefficient ring. -/
def parameterMonomial (s : MvPolynomial σ R) (e : ℕ) : MvPolynomial σ R[X] :=
  MvPolynomial.map Polynomial.C s * MvPolynomial.C (Polynomial.X ^ e)

/-- The actual coefficient substitution preserves every original base form. -/
theorem parameterScale_map_base (c : R) (s : MvPolynomial σ R) :
    MvPolynomial.map (parameterScaleHom c) (MvPolynomial.map Polynomial.C s) =
      MvPolynomial.map Polynomial.C s := by
  have h : (parameterScaleHom c).comp Polynomial.C = Polynomial.C := by
    ext r
    simp
  rw [MvPolynomial.map_map, h]

/-- The genuine parameter-monomial weight formula on the whole original ring. -/
theorem parameterScale_monomial (c : R) (s : MvPolynomial σ R) (e : ℕ) :
    MvPolynomial.map (parameterScaleHom c) (parameterMonomial s e) =
      MvPolynomial.C (Polynomial.C (c ^ e)) * parameterMonomial s e := by
  rw [parameterMonomial, map_mul, parameterScale_map_base, MvPolynomial.map_C,
    map_pow, parameterScaleHom_X, mul_pow, ← Polynomial.C_pow, MvPolynomial.C_mul]
  ring

/-- Every actual parameter-monomial generator maps into the original generated
ideal, for all coefficient scalars, without an invariance assumption. -/
theorem parameterScale_span_monomials_le (c : R)
    (S : Set (MvPolynomial σ R × ℕ)) :
    (Ideal.span ((fun p => parameterMonomial p.1 p.2) '' S)).map
      (MvPolynomial.map (parameterScaleHom c)) ≤
      Ideal.span ((fun p => parameterMonomial p.1 p.2) '' S) := by
  rw [Ideal.map_le_iff_le_comap]
  apply Ideal.span_le.mpr
  rintro _ ⟨p, hp, rfl⟩
  change MvPolynomial.map (parameterScaleHom c) (parameterMonomial p.1 p.2) ∈
    Ideal.span ((fun q => parameterMonomial q.1 q.2) '' S)
  rw [parameterScale_monomial]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨p, hp, rfl⟩)

/-- The whole original ideal generated by actual parameter monomials is
invariant under a genuine coefficient-unit parameter scaling. -/
theorem parameterScale_span_monomials_eq (u : Rˣ)
    (S : Set (MvPolynomial σ R × ℕ)) :
    (Ideal.span ((fun p => parameterMonomial p.1 p.2) '' S)).map
      (MvPolynomial.map (parameterScaleHom (u : R))) =
      Ideal.span ((fun p => parameterMonomial p.1 p.2) '' S) := by
  apply le_antisymm (parameterScale_span_monomials_le (u : R) S)
  have hinv := Ideal.map_mono (f := MvPolynomial.map (parameterScaleHom (u : R)))
    (parameterScale_span_monomials_le (↑u⁻¹ : R) S)
  have hcomp : (MvPolynomial.map (σ := σ) (parameterScaleHom (u : R))).comp
      (MvPolynomial.map (parameterScaleHom (↑u⁻¹ : R))) = RingHom.id (MvPolynomial σ R[X]) := by
    apply RingHom.ext
    intro f
    simp only [RingHom.comp_apply, MvPolynomial.map_map, parameterScaleHom_comp,
      Units.mul_inv, parameterScaleHom_one, MvPolynomial.map_id, RingHom.id_apply]
  rw [Ideal.map_map, hcomp, Ideal.map_id] at hinv
  exact hinv

/-- Actual coefficient extension retains each original parameter monomial. -/
theorem map_parameterMonomial {K : Type*} [CommRing K] (φ : K →+* R)
    (s : MvPolynomial σ K) (e : ℕ) :
    MvPolynomial.map (Polynomial.mapRingHom φ) (parameterMonomial s e) =
      parameterMonomial (MvPolynomial.map φ s) e := by
  have h : (Polynomial.mapRingHom φ).comp Polynomial.C = Polynomial.C.comp φ := by
    ext r
    simp
  simp only [parameterMonomial, map_mul, MvPolynomial.map_C, Polynomial.coe_mapRingHom,
    Polynomial.map_pow, Polynomial.map_X]
  rw [MvPolynomial.map_map, h, ← MvPolynomial.map_map]

/-- Whole parameter-monomial ideals are invariant after every actual
coefficient extension and every unit scaling over the extended ring. -/
theorem parameterScale_span_baseChanged_monomials_eq {K : Type*} [CommRing K]
    (φ : K →+* R) (u : Rˣ) (S : Set (MvPolynomial σ K × ℕ)) :
    ((Ideal.span ((fun p => parameterMonomial p.1 p.2) '' S)).map
      (MvPolynomial.map (Polynomial.mapRingHom φ))).map
        (MvPolynomial.map (parameterScaleHom (u : R))) =
      (Ideal.span ((fun p => parameterMonomial p.1 p.2) '' S)).map
        (MvPolynomial.map (Polynomial.mapRingHom φ)) := by
  let T := (fun p : MvPolynomial σ K × ℕ => (MvPolynomial.map φ p.1, p.2)) '' S
  have h : (Ideal.span ((fun p => parameterMonomial p.1 p.2) '' S)).map
      (MvPolynomial.map (Polynomial.mapRingHom φ)) =
      Ideal.span ((fun p => parameterMonomial p.1 p.2) '' T) := by
    rw [Ideal.map_span]
    congr 1
    simp only [T, Set.image_image]
    congr 1
    funext p
    exact map_parameterMonomial φ p.1 p.2
  rw [h]
  exact parameterScale_span_monomials_eq u T

end EnvelopeProperty
