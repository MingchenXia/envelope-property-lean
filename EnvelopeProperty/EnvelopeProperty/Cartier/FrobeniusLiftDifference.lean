import Mathlib.RingTheory.Kaehler.Basic
import Mathlib.Algebra.CharP.Frobenius
import Mathlib.Tactic.Ring

/-! # Divided differences of actual lifts through flat square-zero reductions

The source and target residue rings may differ. Their coefficient action is the
actual common residue map. No existence of Witt or Frobenius lifts is asserted.
-/

noncomputable section
namespace EnvelopeProperty.Cartier.FrobeniusLiftDifference

universe u v w z

/-- A genuine surjective ring reduction with kernel generated by the integer `p`. -/
structure Reduction (p : ℕ) (T : Type u) (A : Type v) [CommRing T] [CommRing A] where
  map : T →+* A
  surjective : Function.Surjective map
  kernel_iff (x : T) : map x = 0 ↔ ∃ y, (p : T) * y = x

/-- The algebraic square-zero and flatness conditions of a flat lift modulo `p²`.
The annihilator condition is `ker(p) ⊆ pT`; the reverse follows from `p² = 0`. -/
structure FlatReduction (p : ℕ) (T : Type u) (A : Type v) [CommRing T] [CommRing A]
    extends Reduction p T A where
  p_sq_zero : (p : T) * (p : T) = 0
  flat (x : T) : (p : T) * x = 0 → map x = 0

variable {p : ℕ} {R : Type u} {S : Type v} {A : Type w} {B : Type z}
  [CommRing R] [CommRing S] [CommRing A] [CommRing B]

variable (a : Reduction p R A) (b : FlatReduction p S B) (φ : A →+* B)
  (f g : R →+* S)
  (hf : ∀ x, b.map (f x) = φ (a.map x))
  (hg : ∀ x, b.map (g x) = φ (a.map x))

private theorem reduction_eq_of_p_mul_eq (x y : S)
    (h : (p : S) * x = (p : S) * y) : b.map x = b.map y := by
  apply sub_eq_zero.mp
  rw [← map_sub]
  exact b.flat (x-y) (by rw [mul_sub, h, sub_self])

include a b φ hf hg

private theorem exists_divisor (x : R) : ∃ y : S, (p : S) * y = f x - g x := by
  apply (b.toReduction.kernel_iff _).mp
  rw [map_sub, hf, hg, sub_self]

/-- The reduction of the divided difference at an element of the thickening. -/
def differenceOnLift (x : R) : B :=
  b.map (Classical.choose (exists_divisor a b φ f g hf hg x))

theorem differenceOnLift_eq (x : R) (y : S)
    (hy : (p : S) * y = f x - g x) :
    differenceOnLift a b φ f g hf hg x = b.map y := by
  apply reduction_eq_of_p_mul_eq b
  exact (Classical.choose_spec (exists_divisor a b φ f g hf hg x)).trans hy.symm

private theorem lift_difference_eq {x y : R} (hxy : a.map x = a.map y) :
    f x - g x = f y - g y := by
  obtain ⟨r, hr⟩ := (a.kernel_iff (x-y)).mp (by rw [map_sub, hxy, sub_self])
  obtain ⟨s, hs⟩ := exists_divisor a b φ f g hf hg r
  apply sub_eq_zero.mp
  calc
    f x - g x - (f y - g y) = f (x-y) - g (x-y) := by
      simp only [map_sub]
      ring
    _ = f ((p : R)*r) - g ((p : R)*r) := by rw [hr]
    _ = (p : S)*(f r-g r) := by simp only [map_mul, map_natCast]; ring
    _ = (p : S)*((p : S)*s) := by rw [hs]
    _ = 0 := by rw [← mul_assoc, b.p_sq_zero, zero_mul]

theorem differenceOnLift_congr {x y : R} (hxy : a.map x = a.map y) :
    differenceOnLift a b φ f g hf hg x = differenceOnLift a b φ f g hf hg y := by
  apply differenceOnLift_eq a b φ f g hf hg x
  exact (Classical.choose_spec (exists_divisor a b φ f g hf hg y)).trans
    (lift_difference_eq a b φ f g hf hg hxy).symm

/-- The divided difference on the actual original residue ring. -/
def difference (x : A) : B :=
  differenceOnLift a b φ f g hf hg (Classical.choose (a.surjective x))

/-- Every genuine lift and every genuine divisor compute the SAME residue value. -/
theorem difference_eq_of_lift (x : R) (y : S)
    (hy : (p : S) * y = f x - g x) :
    difference a b φ f g hf hg (a.map x) = b.map y := by
  exact (differenceOnLift_congr a b φ f g hf hg
    (Classical.choose_spec (a.surjective (a.map x)))).trans
      (differenceOnLift_eq a b φ f g hf hg x y hy)

theorem difference_add (x y : A) :
    difference a b φ f g hf hg (x+y) =
      difference a b φ f g hf hg x + difference a b φ f g hf hg y := by
  obtain ⟨r, rfl⟩ := a.surjective x
  obtain ⟨s, rfl⟩ := a.surjective y
  obtain ⟨u, hu⟩ := exists_divisor a b φ f g hf hg r
  obtain ⟨v, hv⟩ := exists_divisor a b φ f g hf hg s
  rw [← map_add, difference_eq_of_lift a b φ f g hf hg (r+s) (u+v) (by
    rw [mul_add, hu, hv, map_add, map_add]; ring), map_add,
    difference_eq_of_lift a b φ f g hf hg r u hu,
    difference_eq_of_lift a b φ f g hf hg s v hv]

theorem difference_one : difference a b φ f g hf hg 1 = 0 := by
  simpa only [map_one, map_zero] using
    difference_eq_of_lift a b φ f g hf hg 1 0 (by simp)

/-- The Leibniz action is precisely the actual common residue morphism `φ`. -/
theorem difference_mul (x y : A) :
    difference a b φ f g hf hg (x*y) =
      φ x * difference a b φ f g hf hg y +
      φ y * difference a b φ f g hf hg x := by
  obtain ⟨r, rfl⟩ := a.surjective x
  obtain ⟨s, rfl⟩ := a.surjective y
  obtain ⟨u, hu⟩ := exists_divisor a b φ f g hf hg r
  obtain ⟨v, hv⟩ := exists_divisor a b φ f g hf hg s
  have huv : (p : S)*(f r*v+g s*u) = f (r*s)-g (r*s) := by
    calc
      (p : S)*(f r*v+g s*u) = f r*((p : S)*v)+g s*((p : S)*u) := by ring
      _ = f (r*s)-g (r*s) := by rw [hu, hv, map_mul, map_mul]; ring
  rw [← map_mul, difference_eq_of_lift a b φ f g hf hg (r*s) _ huv,
    map_add, map_mul, map_mul, hf, hg,
    difference_eq_of_lift a b φ f g hf hg r u hu,
    difference_eq_of_lift a b φ f g hf hg s v hv]

/-- The divisor formula uniquely determines the map on the entire residue ring. -/
theorem difference_unique (d : A → B)
    (hd : ∀ x y, (p : S)*y = f x-g x → d (a.map x) = b.map y) :
    d = difference a b φ f g hf hg := by
  funext x
  obtain ⟨r, rfl⟩ := a.surjective x
  obtain ⟨u, hu⟩ := exists_divisor a b φ f g hf hg r
  exact (hd r u hu).trans (difference_eq_of_lift a b φ f g hf hg r u hu).symm

/-- An actual derivation, constructed from actual ring lifts and p-division.
The module structure is restriction along the SAME original residue map. -/
def derivation :
    letI : Module A B := Module.compHom B φ
    Derivation ℤ A B := by
  let : Module A B := Module.compHom B φ
  exact
    { toLinearMap := (show A →+ B from
        { toFun := difference a b φ f g hf hg
          map_zero' := by
            simpa only [map_zero] using
              difference_eq_of_lift a b φ f g hf hg 0 0 (by simp)
          map_add' := difference_add a b φ f g hf hg }).toIntLinearMap
      map_one_eq_zero' := difference_one a b φ f g hf hg
      leibniz' := difference_mul a b φ f g hf hg }

/-- The exact triple-overlap identity, on every element of the residue ring. -/
theorem difference_cocycle (k : R →+* S)
    (hk : ∀ x, b.map (k x) = φ (a.map x)) (x : A) :
    difference a b φ f k hf hk x =
      difference a b φ f g hf hg x + difference a b φ g k hg hk x := by
  obtain ⟨r, rfl⟩ := a.surjective x
  obtain ⟨u, hu⟩ := exists_divisor a b φ f g hf hg r
  obtain ⟨v, hv⟩ := exists_divisor a b φ g k hg hk r
  rw [difference_eq_of_lift a b φ f k hf hk r (u+v) (by
    rw [mul_add, hu, hv]; ring), map_add,
    difference_eq_of_lift a b φ f g hf hg r u hu,
    difference_eq_of_lift a b φ g k hg hk r v hv]

section RelativeBase

variable {K C : Type*} [CommRing K] [CommRing C] [Algebra K A]
  (q₀ : C →+* K) (hq₀ : Function.Surjective q₀) (ι : C →+* R)
  (hι : ∀ c, a.map (ι c) = algebraMap K A (q₀ c))
  (hbase : ∀ c, f (ι c) = g (ι c))

include q₀ hq₀ ι hι hbase

/-- Agreement of the genuine lifts on the actual base forces base constants to vanish. -/
theorem difference_algebraMap (r : K) :
    difference a b φ f g hf hg (algebraMap K A r) = 0 := by
  obtain ⟨c, rfl⟩ := hq₀ r
  have h := difference_eq_of_lift a b φ f g hf hg (ι c) 0 (by
    rw [hbase, sub_self, mul_zero])
  simpa only [hι, map_zero] using h

/-- The actual RELATIVE derivation, with the coefficient action restricted along `φ`.
Base-linearity is proved from genuine compatible base-ring lifts. -/
def derivationOver :
    letI : Module A B := Module.compHom B φ
    letI : Module K B := Module.compHom B (algebraMap K A)
    Derivation K A B := by
  let : Module A B := Module.compHom B φ
  let : Module K B := Module.compHom B (algebraMap K A)
  exact
    { toFun := difference a b φ f g hf hg
      map_add' := difference_add a b φ f g hf hg
      map_smul' := fun r x => by
        rw [Algebra.smul_def, difference_mul,
          difference_algebraMap a b φ f g hf hg q₀ hq₀ ι hι hbase,
          mul_zero, add_zero]
        rfl
      map_one_eq_zero' := difference_one a b φ f g hf hg
      leibniz' := difference_mul a b φ f g hf hg }

/-- The genuine local degree-zero homotopy TERM on all relative one-forms.
The divided-differential comparison is a separate downstream obligation. -/
def cotangentMap :
    letI : Module A B := Module.compHom B φ
    KaehlerDifferential K A →ₗ[A] B := by
  let : Module A B := Module.compHom B φ
  let : Module K B := Module.compHom B (algebraMap K A)
  let : IsScalarTower K A B := IsScalarTower.of_compHom K A B
  exact (derivationOver a b φ f g hf hg q₀ hq₀ ι hι hbase).liftKaehlerDifferential

/-- The local term computes the divided difference on EVERY universal differential. -/
theorem cotangentMap_D (x : A) :
    letI : Module A B := Module.compHom B φ
    cotangentMap a b φ f g hf hg q₀ hq₀ ι hι hbase (KaehlerDifferential.D K A x) =
      difference a b φ f g hf hg x := by
  let : Module A B := Module.compHom B φ
  let : Module K B := Module.compHom B (algebraMap K A)
  let : IsScalarTower K A B := IsScalarTower.of_compHom K A B
  exact Derivation.liftKaehlerDifferential_comp_D
    (derivationOver a b φ f g hf hg q₀ hq₀ ι hι hbase) x

end RelativeBase

omit b φ hf hg in
/-- For two ACTUAL Frobenius lifts the action is the original pth-power action.
No perfection hypothesis or absolute Cartier assertion is used. -/
theorem difference_frobenius_mul [Fact p.Prime] [CharP A p]
    (b₀ : FlatReduction p S A) (f₀ g₀ : R →+* S)
    (hf₀ : ∀ r, b₀.map (f₀ r) = (a.map r)^p)
    (hg₀ : ∀ r, b₀.map (g₀ r) = (a.map r)^p) (x y : A) :
    difference a b₀ (frobenius A p) f₀ g₀ hf₀ hg₀ (x*y) =
      x^p * difference a b₀ (frobenius A p) f₀ g₀ hf₀ hg₀ y +
      y^p * difference a b₀ (frobenius A p) f₀ g₀ hf₀ hg₀ x := by
  exact difference_mul a b₀ (frobenius A p) f₀ g₀ hf₀ hg₀ x y

end EnvelopeProperty.Cartier.FrobeniusLiftDifference
