import Mathlib.RingTheory.LocalProperties.Exactness
import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.RingTheory.Localization.Basic

/-!
# Affine open subschemes of an affine scheme, and their principal opens

An affine open subscheme `U` of `Y = Spec A` is encoded by its coordinate ring `A'`, an
`A`-algebra, together with the property `IsAffineOpenImmersion A A'`: there are finitely many
`a ∈ A` such that

* the images of the `a` generate the unit ideal of `A'` (the opens `U_a = U ∩ D(a)` cover `U`),
* `A → A'_a` is a localization away from `a` (the restriction `U_a → D(a)` is an isomorphism, so
  `U_a = D(a)`).

Then `Spec A' → Spec A` is an open immersion with image `⋃ D(a)`: it is a local isomorphism, and
it is injective (two primes of `A'` with the same contraction `p` both lie in `U_a` for any `a ∉ p`
of the family, and `U_a → D(a)` is bijective). Conversely, if `U ⊆ Spec A` is an affine open with
`A' = 𝒪(U)`, cover the quasi-compact `U` by finitely many principal opens `D(a) ⊆ U`; then
`A'_a = 𝒪(U)_a = 𝒪(U_a) = 𝒪(D(a)) = A_a`. So `IsAffineOpenImmersion A A'` says exactly that
`A → A'` identifies `Spec A'` with an affine open subscheme of `Spec A`.

The main result is used in the shrinking step of FHX Lemma 5.23 (`lem:projection-existence`):

* `IsAffineOpenImmersion.isLocalization_away`: if `c` lies in the ideal of `A` generated by the
  family, then `D(c) ⊆ U` and `A'_c` is a localization of `A` away from `c` (`U_c = D(c)`);
* `isLocalization_away_mul_of_dvd`: if moreover `A'_c ≅ A_c` and `c ∣ g` in `A'`, the principal
  open `U_g ⊆ U_c = D(c)` is a principal open `D(c d)` of `Spec A`.
-/

namespace EnvelopeProperty

open Ideal

/-- **`Spec A' → Spec A` is an open immersion** (`A'` is the coordinate ring of an affine open
subscheme of `Spec A`): there are finitely many `a ∈ A` whose images generate the unit ideal of
`A'` and such that `A → A'_a` is a localization away from `a`. See the module docstring. -/
def IsAffineOpenImmersion (A A' : Type*) [CommRing A] [CommRing A'] [Algebra A A'] : Prop :=
  ∃ s : Finset A, Ideal.span (algebraMap A A' '' (s : Set A)) = ⊤ ∧
    ∀ a ∈ s, IsLocalization.Away a (Localization.Away (algebraMap A A' a))

variable {A A' : Type*} [CommRing A] [CommRing A'] [Algebra A A']

/-- If `A'_a` (localization of `A'` at the image of `a`) is a localization of `A` away from `a`,
then localizing further at the image of `c` gives a localization of `A` away from `c * a`, for any
model `S` of the localization of `A'` away from the image of `c * a`. -/
theorem isLocalization_away_mul_of_isLocalization_away (a c : A)
    [IsLocalization.Away a (Localization.Away (algebraMap A A' a))]
    (S : Type*) [CommRing S] [Algebra A' S] [Algebra A S] [IsScalarTower A A' S]
    [IsLocalization.Away (algebraMap A A' (c * a)) S] : IsLocalization.Away (c * a) S := by
  let A'a := Localization.Away (algebraMap A A' a)
  let T := Localization.Away (algebraMap A A'a c)
  have hT : IsLocalization.Away (a * c) T := IsLocalization.Away.mul' A'a T a c
  have hca : algebraMap A A'a c = algebraMap A' A'a (algebraMap A A' c) :=
    IsScalarTower.algebraMap_apply A A' A'a c
  have : IsLocalization.Away (algebraMap A' A'a (algebraMap A A' c)) T := by
    rw [← hca]; infer_instance
  have hT' : IsLocalization.Away (algebraMap A A' (c * a)) T := by
    rw [map_mul, mul_comm]; exact IsLocalization.Away.mul' A'a T _ _
  let e : S ≃ₐ[A'] T := IsLocalization.algEquiv (Submonoid.powers (algebraMap A A' (c * a))) S T
  rw [mul_comm] at hT
  exact IsLocalization.isLocalization_of_algEquiv (Submonoid.powers (c * a))
    (e.restrictScalars A).symm

/-- **Principal opens of `Spec A` inside an affine open `U`.** Let `s` be a family as in
`IsAffineOpenImmersion` (only the localization property is used) and `c` in the ideal generated by
`s`. Then `D(c) ⊆ U` and `A'_c` is a localization of `A` away from `c`: `U_c = D(c)`.

The canonical map `A_c → A'_c` is bijective because it is so after localizing at each `a ∈ s`
(these generate the unit ideal of `A_c`), where both sides become localizations of `A` away from
`c a` (`bijective_of_isLocalization_of_span_eq_top`). -/
theorem IsAffineOpenImmersion.isLocalization_away {s : Finset A}
    (hloc : ∀ a ∈ s, IsLocalization.Away a (Localization.Away (algebraMap A A' a))) {c : A}
    (hc : c ∈ Ideal.span (s : Set A)) :
    IsLocalization.Away c (Localization.Away (algebraMap A A' c)) := by
  let Ac := Localization.Away c
  let A'c := Localization.Away (algebraMap A A' c)
  let f : Ac →+* A'c := IsLocalization.Away.map Ac A'c (algebraMap A A') c
  have hf : ∀ x : A, f (algebraMap A Ac x) = algebraMap A A'c x := fun x => by
    simp only [f, IsLocalization.Away.map, IsLocalization.map_eq]
    exact (IsScalarTower.algebraMap_apply A A' A'c x).symm
  -- The images of `s` generate the unit ideal of `A_c`.
  let s₀ : Set Ac := algebraMap A Ac '' (s : Set A)
  have hs₀ : Ideal.span s₀ = ⊤ := by
    have h1 : algebraMap A Ac c ∈ Ideal.span s₀ := by
      rw [← Ideal.map_span]; exact Ideal.mem_map_of_mem _ hc
    exact Ideal.eq_top_of_isUnit_mem _ h1 (IsLocalization.Away.algebraMap_isUnit c)
  have hbij : Function.Bijective f := by
    refine bijective_of_isLocalization_of_span_eq_top hs₀ (fun r => Localization.Away r.1)
      (fun r => Localization.Away (f r.1)) f fun r => ?_
    obtain ⟨a, ha, hra⟩ := r.2
    let Rr := Localization.Away r.1
    let Sr := Localization.Away (f r.1)
    have : IsLocalization.Away a (Localization.Away (algebraMap A A' a)) := hloc a ha
    have : IsLocalization.Away (algebraMap A Ac a) Rr := by
      rw [hra]; infer_instance
    have hR : IsLocalization.Away (c * a) Rr := IsLocalization.Away.mul' Ac Rr c a
    have hfr : f r.1 = algebraMap A' A'c (algebraMap A A' a) := by
      rw [← hra, hf, IsScalarTower.algebraMap_apply A A' A'c]
    have : IsLocalization.Away (algebraMap A' A'c (algebraMap A A' a)) Sr := by
      rw [← hfr]; infer_instance
    have : IsLocalization.Away (algebraMap A A' (c * a)) Sr := by
      rw [map_mul]; exact IsLocalization.Away.mul' A'c Sr _ _
    have hS : IsLocalization.Away (c * a) Sr :=
      isLocalization_away_mul_of_isLocalization_away (A' := A') a c Sr
    let e : Rr ≃ₐ[A] Sr := IsLocalization.algEquiv (Submonoid.powers (c * a)) Rr Sr
    have key : IsLocalization.Away.map Rr Sr f r.1 = (e : Rr →+* Sr) := by
      refine IsLocalization.ringHom_ext (Submonoid.powers (c * a)) (RingHom.ext fun x => ?_)
      simp only [RingHom.comp_apply, RingHom.coe_coe, AlgEquiv.commutes]
      rw [IsScalarTower.algebraMap_apply A Ac Rr]
      simp only [IsLocalization.Away.map, IsLocalization.map_eq]
      rw [hf, ← IsScalarTower.algebraMap_apply]
    rw [key]
    exact e.bijective
  let F : Ac ≃ₐ[A] A'c := AlgEquiv.ofBijective
    { f with commutes' := hf } hbij
  exact IsLocalization.isLocalization_of_algEquiv (Submonoid.powers c) F

/-- **A principal open of `U` inside `D(c) = U_c` is a principal open of `Spec A`.** If `A'_c` is a
localization of `A` away from `c` and the image of `c` divides `g ∈ A'`, then `A'_g` is a
localization of `A` away from `c * d` for some `d ∈ A`. -/
theorem isLocalization_away_mul_of_dvd (c : A)
    [IsLocalization.Away c (Localization.Away (algebraMap A A' c))] {g : A'}
    (hg : algebraMap A A' c ∣ g) :
    ∃ d : A, IsLocalization.Away (c * d) (Localization.Away g) := by
  let A'c := Localization.Away (algebraMap A A' c)
  let g' : A'c := algebraMap A' A'c g
  obtain ⟨⟨d, ⟨_, m, rfl⟩⟩, hd⟩ := IsLocalization.surj (Submonoid.powers c) g'
  have hassoc : Associated (algebraMap A A'c d) g' := by
    have hu : IsUnit (algebraMap A A'c (c ^ m)) :=
      IsLocalization.map_units A'c (⟨c ^ m, m, rfl⟩ : Submonoid.powers c)
    exact ⟨hu.unit⁻¹, by
      simp only at hd
      rw [← hd, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
  refine ⟨d, ?_⟩
  let T := Localization.Away g'
  have hT : IsLocalization.Away (c * d) T :=
    IsLocalization.Away.mul_of_associated (S := A'c) c d g' hassoc
  let A₁ := Localization.Away g
  have hu : IsUnit (algebraMap A' A₁ (algebraMap A A' c)) := IsLocalization.Away.isUnit_of_dvd g hg
  have : IsLocalization.Away (algebraMap A A' c * g) A₁ :=
    IsLocalization.Away.mul_of_isUnit' _ _ hu
  have : IsLocalization.Away (algebraMap A A' c * g) T := IsLocalization.Away.mul' A'c T _ _
  let e : A₁ ≃ₐ[A'] T :=
    IsLocalization.algEquiv (Submonoid.powers (algebraMap A A' c * g)) A₁ T
  exact IsLocalization.isLocalization_of_algEquiv (Submonoid.powers (c * d))
    (e.restrictScalars A).symm

end EnvelopeProperty
