import Mathlib.RingTheory.Nakayama
import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.RingTheory.Noetherian.Basic
import Mathlib.RingTheory.Finiteness.Quotient

/-!
# The closed immersion condition

This file proves the commutative algebra behind "`π` restricts to a closed immersion on `Z` near
`z`" in the affine proof of Fang–Han–Xia, *The envelope property for unibranch projective
varieties*, Lemma 5.23 (`lem:projection-existence`).

* `exists_mem_sup_span_singleton_eq`: if `𝔞 ⊆ z` spans the maximal ideal `z` modulo `z²`, then
  `𝔞 + (β) = z` for some `β ∈ z` (Nakayama gives `r ≡ 1 mod z` with `r z ⊆ 𝔞`; take
  `β = 1 - y r`). In the proof of Lemma 5.23, `𝔞` is generated by the restrictions to `Z` of
  `n - 1` coordinates spanning the cotangent space of `Z` at `z`, and `β` is the restriction of the
  last coordinate, which separates `z` from the other points of `Z` in the fibre.
* `exists_sub_one_mem_forall_exists_sub_mem`: Nakayama for a finite `φ : B → A`: if
  `A = φ(B) + 𝔮 A + I`, there is `r ≡ 1 mod 𝔮` with `φ r · A ⊆ φ(B) + I`.
* `surjective_quotient_awayMap_of_forall`: then `B_r → A_{φ r} / I A_{φ r}` is surjective, i.e.
  `π = Spec φ` restricts to a closed immersion `Z ∩ π⁻¹(D(r)) → D(r)`.
-/

namespace EnvelopeProperty

/-- **Completing a system of local generators of a maximal ideal.** Let `z` be a maximal ideal of
a noetherian ring and `𝔞 ⊆ z` an ideal spanning `z` modulo `z²`. There is `β ∈ z` with
`𝔞 + (β) = z`.

By Nakayama, `r z ⊆ 𝔞` for some `r ≡ 1 mod z`; write `1 = y r + β` with `β ∈ z`. Then
`x = y (r x) + β x ∈ 𝔞 + (β)` for `x ∈ z`. (Geometrically: `V(𝔞) = {z} ⊔ V(𝔞 + (r))`, and `β`
vanishes at `z` and is `≡ 1` on the other component.) -/
theorem exists_mem_sup_span_singleton_eq {R : Type*} [CommRing R] [IsNoetherianRing R]
    (z : Ideal R) [z.IsMaximal] (𝔞 : Ideal R) (h𝔞 : 𝔞 ≤ z) (hsq : z ≤ 𝔞 ⊔ z ^ 2) :
    ∃ β ∈ z, 𝔞 ⊔ Ideal.span {β} = z := by
  let N : Submodule R (R ⧸ 𝔞) := Submodule.map (Submodule.mkQ 𝔞) z
  have hN : N.FG := (IsNoetherian.noetherian z).map _
  have hle : N ≤ z • N := by
    rw [← Submodule.map_smul'']
    refine Submodule.map_le_iff_le_comap.mpr fun x hx => ?_
    obtain ⟨a, ha, y, hy, rfl⟩ := Submodule.mem_sup.mp (hsq hx)
    rw [Submodule.mem_comap, map_add, Submodule.mkQ_apply,
      (Submodule.Quotient.mk_eq_zero 𝔞).mpr ha, zero_add]
    refine Submodule.mem_map_of_mem ?_
    rw [sq, ← Ideal.smul_eq_mul] at hy
    exact hy
  obtain ⟨r, hr1, hr⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul z N hN hle
  have hrz : ∀ x ∈ z, r * x ∈ 𝔞 := fun x hx => by
    have := hr _ (Submodule.mem_map_of_mem hx)
    rwa [Submodule.mkQ_apply, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero,
      smul_eq_mul] at this
  have hr : r ∉ z := fun h => (Ideal.IsMaximal.ne_top inferInstance)
    ((Ideal.eq_top_iff_one _).mpr (by simpa using z.sub_mem h hr1))
  obtain ⟨y, β, hβ, hyβ⟩ := Ideal.IsMaximal.exists_inv inferInstance hr
  refine ⟨β, hβ, le_antisymm (sup_le h𝔞 ((Ideal.span_singleton_le_iff_mem _).mpr hβ)) ?_⟩
  intro x hx
  have : x = y * (r * x) + x * β := by
    rw [← mul_assoc, mul_comm x β, ← add_mul, hyβ, one_mul]
  rw [this]
  exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mul_mem_left _ _ (hrz x hx)))
    (Ideal.mem_sup_right (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self β)))

/-- **Nakayama for a finite map.** Let `φ : B → A` be finite, `I` an ideal of `A` and `𝔮` an ideal
of `B` such that `A = φ(B) + 𝔮 A + I`. Then some `r ≡ 1 mod 𝔮` satisfies `φ r · A ⊆ φ(B) + I`; so
`B_r → A_{φ r} / I` is surjective. -/
theorem exists_sub_one_mem_forall_exists_sub_mem {B A : Type*} [CommRing B] [CommRing A]
    (φ : B →+* A) (hfin : φ.Finite) (I : Ideal A) (𝔮 : Ideal B)
    (h : ∀ x : A, ∃ b : B, x - φ b ∈ 𝔮.map φ ⊔ I) :
    ∃ r : B, r - 1 ∈ 𝔮 ∧ ∀ x : A, ∃ b : B, φ r * x - φ b ∈ I := by
  algebraize [φ]
  have : Module.Finite B A := hfin
  let N : Submodule B (A ⧸ I) := Submodule.span B {1}
  let π : A →ₗ[B] (A ⧸ I) ⧸ N := N.mkQ ∘ₗ (Ideal.Quotient.mkₐ B I).toLinearMap
  have hπ : Function.Surjective π :=
    (Submodule.mkQ_surjective N).comp (Ideal.Quotient.mkₐ_surjective B I)
  have : Module.Finite B (A ⧸ I) :=
    Module.Finite.of_surjective (Ideal.Quotient.mkₐ B I).toLinearMap
      (Ideal.Quotient.mkₐ_surjective B I)
  have htop : (⊤ : Submodule B ((A ⧸ I) ⧸ N)) ≤ 𝔮 • ⊤ := by
    intro q _
    obtain ⟨x, rfl⟩ := hπ q
    obtain ⟨b, hb⟩ := h x
    obtain ⟨y, hy, ι, hι, hyι⟩ := Submodule.mem_sup.mp hb
    have hx : x = algebraMap B A b + y + ι := by
      rw [add_assoc, hyι]; change x = φ b + (x - φ b); ring
    have h1 : π (algebraMap B A b) = 0 := by
      simp only [π, LinearMap.comp_apply, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      refine Submodule.mem_span_singleton.mpr ⟨b, ?_⟩
      simp [Algebra.smul_def]
    have h2 : π ι = 0 := by
      simp [π, Ideal.Quotient.eq_zero_iff_mem.mpr hι]
    have hy' : y ∈ 𝔮 • (⊤ : Submodule B A) := by
      rw [Ideal.smul_top_eq_map]; exact hy
    have h3 : π y ∈ 𝔮 • (⊤ : Submodule B ((A ⧸ I) ⧸ N)) := by
      have : π y ∈ (𝔮 • (⊤ : Submodule B A)).map π := Submodule.mem_map_of_mem hy'
      rw [Submodule.map_smul''] at this
      exact Submodule.smul_mono le_rfl le_top this
    rw [hx, map_add, map_add, h1, h2, zero_add, add_zero]
    exact h3
  obtain ⟨r, hr1, hr⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul 𝔮
    (⊤ : Submodule B ((A ⧸ I) ⧸ N)) (Module.Finite.fg_top) htop
  refine ⟨r, hr1, fun x => ?_⟩
  have := hr (π x) Submodule.mem_top
  rw [← map_smul] at this
  simp only [π, LinearMap.comp_apply, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
    AlgHom.toLinearMap_apply, Ideal.Quotient.mkₐ_eq_mk] at this
  obtain ⟨b, hb⟩ := Submodule.mem_span_singleton.mp this
  refine ⟨b, ?_⟩
  rw [← Ideal.Quotient.eq]
  calc Ideal.Quotient.mk I (φ r * x) = Ideal.Quotient.mk I (r • x) := by
        rw [Algebra.smul_def]; rfl
    _ = algebraMap B (A ⧸ I) b := by rw [← hb, Algebra.algebraMap_eq_smul_one]
    _ = Ideal.Quotient.mk I (φ b) := by rw [← Ideal.Quotient.mk_algebraMap]; rfl

/-- **Surjectivity onto `A_{φ r} / I` after inverting `r`.** If `φ r · A ⊆ φ(B) + I`, then
`B_r → A_{φ r} / I A_{φ r}` is surjective: `x / (φ r) ^ n ≡ φ b / (φ r) ^ {n + 1}` if
`φ r x - φ b ∈ I`. -/
theorem surjective_quotient_awayMap_of_forall {B A : Type*} [CommRing B] [CommRing A]
    (φ : B →+* A) (I : Ideal A) (r : B) (h : ∀ x : A, ∃ b : B, φ r * x - φ b ∈ I) :
    Function.Surjective ((Ideal.Quotient.mk (I.map (algebraMap A (Localization.Away (φ r))))).comp
      (Localization.awayMap φ r)) := by
  intro y
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨⟨x, ⟨_, n, rfl⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers (φ r)) y
  obtain ⟨b, hb⟩ := h x
  set L := Localization.Away (φ r)
  refine ⟨IsLocalization.mk' (Localization.Away r) b
    (⟨r ^ (n + 1), n + 1, rfl⟩ : Submonoid.powers r), ?_⟩
  have hmap : Localization.awayMap φ r (IsLocalization.mk' (Localization.Away r) b
      (⟨r ^ (n + 1), n + 1, rfl⟩ : Submonoid.powers r)) =
      IsLocalization.mk' L (φ b) (⟨φ r ^ (n + 1), n + 1, rfl⟩ : Submonoid.powers (φ r)) := by
    simp only [Localization.awayMap, IsLocalization.Away.map, IsLocalization.map_mk']
    congr 1
    ext; simp [map_pow]
  simp only [RingHom.comp_apply]
  rw [Ideal.Quotient.eq, hmap]
  have hu : IsUnit (algebraMap A L (φ r ^ (n + 1))) :=
    IsLocalization.map_units L (⟨φ r ^ (n + 1), n + 1, rfl⟩ : Submonoid.powers (φ r))
  have e1 : IsLocalization.mk' L (φ b) (⟨φ r ^ (n + 1), n + 1, rfl⟩ : Submonoid.powers (φ r)) *
      algebraMap A L (φ r ^ (n + 1)) = algebraMap A L (φ b) := IsLocalization.mk'_spec _ _ _
  have e2 : IsLocalization.mk' L x (⟨φ r ^ n, n, rfl⟩ : Submonoid.powers (φ r)) *
      algebraMap A L (φ r ^ (n + 1)) = algebraMap A L (φ r * x) := by
    rw [pow_succ, map_mul, ← mul_assoc, IsLocalization.mk'_spec, ← map_mul, mul_comm]
  have hmem : (IsLocalization.mk' L (φ b) (⟨φ r ^ (n + 1), n + 1, rfl⟩ : Submonoid.powers (φ r)) -
      IsLocalization.mk' L x (⟨φ r ^ n, n, rfl⟩ : Submonoid.powers (φ r))) *
      algebraMap A L (φ r ^ (n + 1)) ∈ I.map (algebraMap A L) := by
    rw [sub_mul, e1, e2, ← map_sub]
    refine Ideal.mem_map_of_mem _ ?_
    simpa using I.neg_mem hb
  obtain ⟨u, hu'⟩ := hu
  have := Ideal.mul_mem_right (↑u⁻¹ : L) _ hmem
  rwa [← hu', mul_assoc, Units.mul_inv, mul_one] at this

end EnvelopeProperty
