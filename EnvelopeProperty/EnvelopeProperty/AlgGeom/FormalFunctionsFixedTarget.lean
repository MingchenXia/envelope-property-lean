import EnvelopeProperty.AlgGeom.FormalFunctionsImageFiltration

/-! # Actual finite tail-Rees modules for every fixed original target power -/

open CategoryTheory Limits AlgebraicGeometry TopologicalSpace
open Scheme.Modules
open scoped Polynomial DirectSum
noncomputable section
universe u
namespace EnvelopeProperty.FormalFunctionsFixedTarget

open FcReesCechDegreeComplex FcReesCechDegreeTransitions

private def linearLocus {A M N : Type u} [Semiring A]
    [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (L : M →+ N) : Submodule A M where
  carrier := {x | ∀ a : A, L (a • x) = a • L x}
  zero_mem' a := by simp only [smul_zero, map_zero]
  add_mem' hx hy a := by rw [smul_add, map_add, hx a, hy a, map_add, smul_add]
  smul_mem' b x hx a := by rw [smul_smul, hx (a * b), mul_smul, hx b]

variable {R : Type u} [CommRing R] (I : Ideal R)
variable {X : Scheme.{u}} (f : X ⟶ Spec (.of R))
variable [X.IsSeparated] {ι : Type u} [LinearOrder ι] [Fintype ι]
variable (U : ι → X.Opens) (hU : ∀ i, IsAffineOpen (U i))

private abbrev H (d q : ℕ) := FormalFunctionsImageFiltration.cohomology I f U hU d q
private abbrev M (q : ℕ) := FcReesCechHomologyModule.degreeHomology I f U hU q

/-- The ACTUAL tail is the genuine Rees submodule generated by ALL
unchanged original cohomology summands of degree at least the original target. -/
def tailSpan (n q : ℕ) :
    letI := FcReesCechHomologyModule.reesModule I f U hU q
    Submodule (reesAlgebra I) (M I f U hU q) := by
  let := FcReesCechHomologyModule.reesModule I f U hU q
  exact Submodule.span (reesAlgebra I)
    {x | ∃ d, ∃ y : H I f U hU (n + d) q,
      DirectSum.lof R ℕ (fun j => H I f U hU j q) (n + d) y = x}

/-- The original transition polynomial map, with zero below the fixed
target and unchanged original transitions and shifted degrees above it. -/
def polynomialMap (n q : ℕ) :
    M I f U hU q →ₗ[R] PolynomialModule R (H I f U hU n q) :=
  DirectSum.toModule R ℕ (M := fun d => H I f U hU d q) _ fun d =>
    if h : n ≤ d then
      (PolynomialModule.lsingle R (d - n)).comp (homologyLower I f U hU h q).hom
    else 0

/-- EVERY actual original higher-degree summand retains its entire
literal original transition image and the precise shifted polynomial degree. -/
theorem polynomialMap_lof_of_le (n q d : ℕ) (h : n ≤ d) (x : H I f U hU d q) :
    polynomialMap I f U hU n q
        (DirectSum.lof R ℕ (fun j => H I f U hU j q) d x) =
      PolynomialModule.single R (d - n) ((homologyLower I f U hU h q).hom x) := by
  simp only [polynomialMap, DirectSum.toModule_lof, dif_pos h]
  rfl

/-- At EVERY original tail generator the polynomial exponent is exactly
its original excess over the fixed target, with the same whole original class. -/
theorem polynomialMap_lof (n q d : ℕ) (x : H I f U hU (n + d) q) :
    polynomialMap I f U hU n q
        (DirectSum.lof R ℕ (fun j => H I f U hU j q) (n + d) x) =
      PolynomialModule.single R d
        ((homologyLower I f U hU (Nat.le_add_right n d) q).hom x) := by
  exact (polynomialMap_lof_of_le I f U hU n q (n + d) (Nat.le_add_right n d) x).trans
    (congrArg (fun k => PolynomialModule.single R k
      ((homologyLower I f U hU (Nat.le_add_right n d) q).hom x))
        (Nat.add_sub_cancel_left n d))

/-- The original tail transition map commutes with EVERY genuine Rees scalar
on EVERY original tail generator, proved from the ACTUAL homogeneous action. -/
theorem polynomialMap_tail_smul (n q d : ℕ) (x : H I f U hU (n + d) q)
    (p : reesAlgebra I) :
    letI := FcReesCechHomologyModule.reesModule I f U hU q
    polynomialMap I f U hU n q
        (p • DirectSum.lof R ℕ (fun j => H I f U hU j q) (n + d) x) =
      p • polynomialMap I f U hU n q
        (DirectSum.lof R ℕ (fun j => H I f U hU j q) (n + d) x) := by
  let := FcReesCechHomologyModule.reesModule I f U hU q
  induction p using FormalFunctionsReesLinear.rees_induction_on I with
  | hzero => simp only [zero_smul, map_zero]
  | hadd p r hp hr => rw [add_smul, map_add, hp, hr, add_smul]
  | hmonomial e a =>
    rw [FcReesCechHomogeneousAction.reesModule_homogeneous,
      polynomialMap_lof_of_le I f U hU n q (e + (n + d))
        ((Nat.le_add_right n d).trans (Nat.le_add_left (n + d) e)),
      polynomialMap_lof]
    change PolynomialModule.single R (e + (n + d) - n)
        ((homologyLower I f U hU
          ((Nat.le_add_right n d).trans (Nat.le_add_left (n + d) e)) q).hom
          ((FcReesCechHomogeneousMultiplication.homologyMultiply I f U hU a (n + d) q).hom x)) =
      Polynomial.monomial e (a : R) • PolynomialModule.single R d
        ((homologyLower I f U hU (Nat.le_add_right n d) q).hom x)
    rw [PolynomialModule.monomial_smul_single]
    have h := congrArg (fun b => b.hom x)
      (homologyMultiply_lower I f U hU a (Nat.le_add_right n d) q)
    have hk : e + (n + d) - n = e + d := by omega
    exact (congrArg (fun k => PolynomialModule.single R k
      ((homologyLower I f U hU
        ((Nat.le_add_right n d).trans (Nat.le_add_left (n + d) e)) q).hom
        ((FcReesCechHomogeneousMultiplication.homologyMultiply I f U hU a (n + d) q).hom x))) hk).trans
      (congrArg (PolynomialModule.single R (e + d)) h)

private theorem tailSpan_le_linearLocus (n q : ℕ) :
    letI := FcReesCechHomologyModule.reesModule I f U hU q
    tailSpan I f U hU n q ≤ linearLocus (polynomialMap I f U hU n q).toAddMonoidHom := by
  let := FcReesCechHomologyModule.reesModule I f U hU q
  unfold tailSpan
  apply Submodule.span_le.mpr
  rintro _ ⟨d, x, rfl⟩
  exact polynomialMap_tail_smul I f U hU n q d x

/-- Restrict the ORIGINAL transition polynomial map to the ACTUAL tail;
this is genuinely Rees-linear on the entire original submodule. -/
def tailReesMap (n q : ℕ) :
    letI := FcReesCechHomologyModule.reesModule I f U hU q
    tailSpan I f U hU n q →ₗ[reesAlgebra I] PolynomialModule R (H I f U hU n q) := by
  let := FcReesCechHomologyModule.reesModule I f U hU q
  exact {
    toFun := fun x => polynomialMap I f U hU n q x.1
    map_add' := fun x y => (polynomialMap I f U hU n q).map_add x.1 y.1
    map_smul' := fun p x => (tailSpan_le_linearLocus I f U hU n q x.2) p }

private def imageAt (n q : ℕ) (j : {j : ℕ // n ≤ j}) : Submodule R (H I f U hU n q) :=
  LinearMap.range (homologyLower I f U hU j.2 q).hom

/-- The ENTIRE actual original images into EVERY fixed original ideal-power
cohomology group form their genuine original I-filtration. -/
def imageFiltration (n q : ℕ) : I.Filtration (H I f U hU n q) where
  N d := imageAt I f U hU n q ⟨n + d, Nat.le_add_right n d⟩
  mono d := by
    rintro _ ⟨y, rfl⟩
    refine ⟨(homologyLower I f U hU (Nat.add_le_add_left (Nat.le_succ d) n) q).hom y, ?_⟩
    exact congrArg (fun b => b.hom y)
      (homologyLower_comp I f U hU (Nat.le_add_right n d)
        (Nat.add_le_add_left (Nat.le_succ d) n) q)
  smul_le d := Submodule.smul_le.mpr (by
    intro a ha x hx
    rcases hx with ⟨y, rfl⟩
    let b : ↥(I ^ 1) := ⟨a, by simpa only [pow_one] using ha⟩
    let j₁ : {j : ℕ // n ≤ j} :=
      ⟨1 + (n + d), (Nat.le_add_right n d).trans (Nat.le_add_left (n + d) 1)⟩
    let j₂ : {j : ℕ // n ≤ j} := ⟨n + (d + 1), Nat.le_add_right n (d + 1)⟩
    have he : j₁ = j₂ := Subtype.ext (by dsimp only [j₁, j₂]; omega)
    have hmem : a • (homologyLower I f U hU (Nat.le_add_right n d) q).hom y ∈
        imageAt I f U hU n q j₁ :=
      ⟨(FcReesCechHomogeneousMultiplication.homologyMultiply I f U hU b (n + d) q).hom y,
        congrArg (fun c => c.hom y)
          (homologyMultiply_lower I f U hU b (Nat.le_add_right n d) q)⟩
    exact (congrArg (fun j =>
      a • (homologyLower I f U hU (Nat.le_add_right n d) q).hom y ∈
        imageAt I f U hU n q j) he).mp hmem)

/-- The fixed-target ORIGINAL image filtration starts at the WHOLE SAME
original cohomology module. -/
theorem imageFiltration_zero (n q : ℕ) : (imageFiltration I f U hU n q).N 0 = ⊤ := by
  change LinearMap.range (homologyLower I f U hU (Nat.le_add_right n 0) q).hom = ⊤
  rw [homologyLower_self]
  exact LinearMap.range_id

/-- The WHOLE actual original transition polynomial belongs to the SAME
original fixed-target associated image module, retaining every original coefficient. -/
theorem polynomialMap_mem (n q : ℕ) (x : M I f U hU q) :
    polynomialMap I f U hU n q x ∈ (imageFiltration I f U hU n q).submodule := by
  induction x using DirectSum.induction_on with
  | zero =>
    rw [map_zero]
    exact Submodule.zero_mem _
  | add x y hx hy =>
    rw [map_add]
    exact Submodule.add_mem _ hx hy
  | of e y =>
    change polynomialMap I f U hU n q
      (DirectSum.lof R ℕ (fun j => H I f U hU j q) e y) ∈ _
    by_cases h : n ≤ e
    · rw [polynomialMap_lof_of_le I f U hU n q e h]
      intro d
      rw [PolynomialModule.coeff_single, Finsupp.single_apply]
      split_ifs with hd
      · have he : (⟨e, h⟩ : {j : ℕ // n ≤ j}) =
            ⟨n + d, Nat.le_add_right n d⟩ := Subtype.ext (by change e = n + d; omega)
        have hm : (homologyLower I f U hU h q).hom y ∈
            imageAt I f U hU n q ⟨e, h⟩ := ⟨y, rfl⟩
        exact (congrArg (fun j => (homologyLower I f U hU h q).hom y ∈
          imageAt I f U hU n q j) he).mp hm
      · exact Submodule.zero_mem _
    · have hz : polynomialMap I f U hU n q
          (DirectSum.lof R ℕ (fun j => H I f U hU j q) e y) = 0 := by
        simp only [polynomialMap, DirectSum.toModule_lof, dif_neg h, LinearMap.zero_apply]
      rw [hz]
      exact Submodule.zero_mem _

/-- The ACTUAL original tail Rees map has ENTIRE range equal to the SAME
original fixed-target filtration module, not merely a dense or radical submodule. -/
theorem tailReesMap_range (n q : ℕ) :
    letI := FcReesCechHomologyModule.reesModule I f U hU q
    (tailReesMap I f U hU n q).range = (imageFiltration I f U hU n q).submodule := by
  let := FcReesCechHomologyModule.reesModule I f U hU q
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    exact polynomialMap_mem I f U hU n q x.1
  · rw [← (imageFiltration I f U hU n q).submodule_span_single]
    apply Submodule.span_le.mpr
    rw [Set.iUnion_subset_iff]
    intro d z hz
    rcases hz with ⟨x, hx, rfl⟩
    change x ∈ LinearMap.range
      (homologyLower I f U hU (Nat.le_add_right n d) q).hom at hx
    rcases hx with ⟨y, rfl⟩
    refine ⟨⟨DirectSum.lof R ℕ (fun j => H I f U hU j q) (n + d) y, ?_⟩,
      polynomialMap_lof I f U hU n q d y⟩
    exact Submodule.subset_span ⟨d, y, rfl⟩

/-- Original projective geometry derives finiteness of the ACTUAL entire
tail submodule of the SAME original finite Rees cohomology module. -/
theorem tailSpan_finite [IsNoetherianRing R] (hf : IsProjectiveFactorization f)
    (hcover : IsOpenCover U) (n q : ℕ) :
    letI := FcReesCechHomologyModule.reesModule I f U hU q
    Module.Finite (reesAlgebra I) (tailSpan I f U hU n q) := by
  let := FcReesCechHomologyModule.reesModule I f U hU q
  let : Module.Finite (reesAlgebra I) (M I f U hU q) :=
    FcReesCechHomologyModule.finiteReesHomology I f U hU hf hcover q
  infer_instance

/-- EVERY fixed-target actual image filtration is genuinely stable, derived
from original projective geometry with no cohomology, action or stability premise. -/
theorem imageFiltration_stable [IsNoetherianRing R] (hf : IsProjectiveFactorization f)
    (hcover : IsOpenCover U) (n q : ℕ) : (imageFiltration I f U hU n q).Stable := by
  let := FcReesCechHomologyModule.reesModule I f U hU q
  let : Module.Finite (reesAlgebra I) (tailSpan I f U hU n q) :=
    tailSpan_finite I f U hU hf hcover n q
  let L := tailReesMap I f U hU n q
  let : Module.Finite (reesAlgebra I) L.range := Module.Finite.range L
  have hfg : L.range.FG := Module.Finite.iff_fg.mp inferInstance
  let : Module.Finite R (H I f U hU n q) :=
    FormalFunctionsDegreeFinite.degreeCech_finite I f hf U hcover hU n q
  apply ((imageFiltration I f U hU n q).submodule_fg_iff_stable
    (fun d => IsNoetherian.noetherian ((imageFiltration I f U hU n q).N d))).mp
  exact (congrArg (fun S : Submodule (reesAlgebra I) (PolynomialModule R (H I f U hU n q)) => S.FG)
    (tailReesMap_range I f U hU n q)).mp hfg

end EnvelopeProperty.FormalFunctionsFixedTarget
