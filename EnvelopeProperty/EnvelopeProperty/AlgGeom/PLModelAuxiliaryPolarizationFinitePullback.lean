import EnvelopeProperty.AlgGeom.SchemeModuleAffineEpimorphisms
import EnvelopeProperty.AlgGeom.SchemeAmpleCoherentGlobalGeneration
import EnvelopeProperty.AlgGeom.SchemeVeryAmpleTensorGeneratingSections
import EnvelopeProperty.AlgGeom.BundleTensorPowerPullback
import EnvelopeProperty.AlgGeom.ProjectiveFactorizationRingIso
import ModularCurves.ForMathlib.SchemeModuleEpiCover
import Mathlib.AlgebraicGeometry.Morphisms.Finite

/-! # Ampleness is preserved by pullback along finite morphisms

Let `p : X ⟶ Spec R`, let `L` be an ample line on `X` over `R` and let `f : Y ⟶ X` be a finite
morphism with `f ≫ p` projective. Then `f^* L` is ample on `Y` over `R`.

Proof. For an affine morphism `f` the counit `f^* f_* M ⟶ M` is an epimorphism on every
quasicoherent `M` (on an affine `U ⊆ X` with affine preimage, the triangle identity shows that
the counit is surjective on sections over `f⁻¹ U`, and surjectivity on global sections of an
affine scheme with quasicoherent target gives an epimorphism). For a finite morphism `f_*`
preserves finite type quasicoherent modules. Choose a very ample `C` on `Y` from the
projectivity of `f ≫ p`. By Serre's global generation for the ample `L`, the finite type
coherent `f_* C^∨ ⊗ L^m` is generated by finitely many global sections for `m ≫ 0`; pulling back
and using the counit epimorphism and `f^*(L^m) ≅ (f^* L)^m`, so is `C^∨ ⊗ (f^* L)^m`. A very ample
line tensored with a line generated by finitely many global sections is very ample, hence
`(f^* L)^m ≅ C ⊗ (C^∨ ⊗ (f^* L)^m)` is very ample.

Blueprint: `thm:pl-auxiliary-native-finite-pullback-ample`.
-/
noncomputable section
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open Scheme.Modules TopologicalSpace MvPolynomial
universe u
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace EnvelopeProperty.PLModelAuxiliaryPolarization
open CanonicalGeometry
attribute [local instance] Scheme.Modules.monoidalCategory MvPolynomial.gradedAlgebra

/-- Along an affine morphism the counit `f^* f_* M ⟶ M` of the pullback-pushforward adjunction is
an epimorphism for every quasicoherent `M`: over an affine open `U` its sections over `f⁻¹ U` are
surjective by the triangle identity, which suffices since `f⁻¹ U` is affine. -/
theorem counit_epi_of_isAffineHom {X Y : Scheme.{u}} (f : Y ⟶ X) [IsAffineHom f]
    (M : Y.Modules) [M.IsQuasicoherent] :
    Epi ((pullbackPushforwardAdjunction f).counit.app M) := by
  let V : X.affineOpens → Y.Opens := fun U => f ⁻¹ᵁ U.1
  have hcover : ⨆ U : X.affineOpens, V U = ⊤ := by
    apply top_unique
    intro y _hy
    obtain ⟨U, hU, hy, _⟩ := exists_isAffineOpen_mem_and_subset
      (show f y ∈ (⊤ : X.Opens) from trivial)
    exact Opens.mem_iSup.mpr ⟨⟨U, hU⟩, hy⟩
  let adj := pullbackPushforwardAdjunction f
  let ε := adj.counit.app M
  let η := adj.unit.app ((pushforward f).obj M)
  have htriangle : η ≫ (pushforward f).map ε = 𝟙 ((pushforward f).obj M) :=
    adj.right_triangle_components M
  apply epi_of_restrictFunctor_map_epi_of_iSup_eq_top V hcover ε
  intro U
  let : IsAffine (V U).toScheme := U.2.preimage f
  have hsurj : Function.Surjective (ε.app (V U)) := by
    intro s
    refine ⟨η.app U.1 s, ?_⟩
    have h := congrArg (fun a => a.app U.1 s) htriangle
    exact h
  let : ((restrictFunctor (V U).ι).obj ((𝟭 Y.Modules).obj M)).IsQuasicoherent :=
    Scheme.Modules.isQuasicoherent_restrictFunctor (V U).ι M
  apply SchemeModuleAffineEpimorphisms.epi_of_appTop_surjective
  change Function.Surjective (ε.app ((V U).ι ''ᵁ (⊤ : (V U).toScheme.Opens)))
  rw [(V U).ι_image_top]
  exact hsurj

/-- The pushforward of a finite type quasicoherent module along a finite morphism is of finite
type: over an affine `U` its sections `Γ(M, f⁻¹ U)` are finite over the finite
`Γ(X, U)`-algebra `Γ(Y, f⁻¹ U)`. -/
theorem isFiniteType_pushforward_of_isFinite {X Y : Scheme.{u}}
    (f : Y ⟶ X) [IsFinite f] (M : Y.Modules)
    [M.IsQuasicoherent] [M.IsFiniteType] : ((pushforward f).obj M).IsFiniteType := by
  let Q := (pushforward f).obj M
  let : Q.IsQuasicoherent := isQuasicoherent_pushforward_of_isAffineHom f
  apply isFiniteType_of_sections_module_finite Q
  intro U
  let V : Y.affineOpens := ⟨f ⁻¹ᵁ U.1, U.2.preimage f⟩
  let : Module.Finite Γ(Y, V.1) Γ(M, V.1) :=
    sections_module_finite_of_isFiniteType_of_isAffineOpen M V
  let : Algebra Γ(X, U.1) Γ(Y, V.1) := (f.app U.1).hom.toAlgebra
  let : Module.Finite Γ(X, U.1) Γ(Y, V.1) := f.finite_app U.1 U.2
  let : Module Γ(X, U.1) Γ(M, V.1) := Module.compHom Γ(M, V.1) (f.app U.1).hom
  let : IsScalarTower Γ(X, U.1) Γ(Y, V.1) Γ(M, V.1) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  have hfin : Module.Finite Γ(X, U.1) Γ(M, V.1) := Module.Finite.trans Γ(Y, V.1) Γ(M, V.1)
  rw [Module.finite_def]
  change (⊤ : Submodule Γ(X, U.1) Γ(M, V.1)).FG
  exact hfin.fg_top

/-- Serre global generation along a finite morphism: if `L` is ample and `f` is finite, then for
every finite type quasicoherent `M` on `Y` the twists `M ⊗ (f^* L)^m` are generated by finitely
many global sections for all large `m`. -/
theorem exists_eventual_generatingSections_finite_pullback
    {R : Type u} [CommRing R] {X Y : Scheme.{u}}
    (p : X ⟶ Spec (.of R)) (L : X.Modules) (hL : SchemeLineAmpleness.IsAmple p L)
    (f : Y ⟶ X) [IsFinite f] (M : Y.Modules)
    [M.IsQuasicoherent] [M.IsFiniteType] :
    ∃ N : ℕ, ∀ m : ℕ, N ≤ m →
      ∃ G : (M ⊗ bundleTensorPower ((Scheme.Modules.pullback f).obj L) m).GeneratingSections,
        G.IsFiniteType := by
  let Q := (pushforward f).obj M
  let : Q.IsQuasicoherent := isQuasicoherent_pushforward_of_isAffineHom f
  let : Q.IsFiniteType := isFiniteType_pushforward_of_isFinite f M
  obtain ⟨N, hN⟩ := SchemeAmpleCoherentGlobalGeneration.exists_eventual_generatingSections p Q L hL
  refine ⟨N, fun m hm => ?_⟩
  obtain ⟨G, hG⟩ := hN m hm
  let : G.IsFiniteType := hG
  let P := bundleTensorPower L m
  have hP : IsInvertible P := TensorPowerBaseIdealGrading.tensorPower_isInvertible hL.1 m
  let B := (Scheme.Modules.pullback f).obj P
  have hB : IsInvertible B := hP.pullback f
  let : (tensorRight B).IsEquivalence :=
    SchemeInvertibleTensorEquivalence.tensorRight_isEquivalence B hB
  let : (Scheme.Modules.pullback f).Monoidal := pullbackMonoidal f
  let ε := (pullbackPushforwardAdjunction f).counit.app M
  let : Epi ε := counit_epi_of_isAffineHom f M
  let q : (Scheme.Modules.pullback f).obj (Q ⊗ P) ⟶ M ⊗ B :=
    (Functor.Monoidal.μIso (Scheme.Modules.pullback f) Q P).inv ≫ (tensorRight B).map ε
  let : Epi ((tensorRight B).map ε) := (tensorRight B).map_epi ε
  let : Epi q := epi_comp _ _
  let e : M ⊗ B ≅ M ⊗ bundleTensorPower ((Scheme.Modules.pullback f).obj L) m :=
    Iso.refl M ⊗ᵢ BundleTensorPowerPullback.pullbackIso f L m
  let H := ClosedProjectiveGlobalGeneration.pullback_generatingSections f G
  let : H.IsFiniteType :=
      ClosedProjectiveGlobalGeneration.pullback_generatingSections_isFiniteType f G
  exact ⟨(H.ofEpi q).ofEpi e.hom, inferInstance⟩

/-- The pullback of an ample line along a finite morphism `f` with `f ≫ p` projective is
ample. -/
theorem isAmple_finite_pullback
    {R : Type u} [CommRing R] {X Y : Scheme.{u}}
    (p : X ⟶ Spec (.of R)) (L : X.Modules) (hL : SchemeLineAmpleness.IsAmple p L)
    (f : Y ⟶ X) [IsFinite f] [IsProjective (f ≫ p)] :
    SchemeLineAmpleness.IsAmple (f ≫ p) ((Scheme.Modules.pullback f).obj L) := by
  obtain ⟨n, j, hj, hbase⟩ := ProjectiveFactorizationRingIso.of_isProjective (f ≫ p)
  let C := (Scheme.Modules.pullback j).obj (coordinateHyperplaneTwist (R := R) (0 : Fin (n + 1)) 1)
  have hC : SchemeLineAmpleness.IsVeryAmple (f ≫ p) C := by
    refine ⟨n, j, hj, ?_, ⟨Iso.refl C⟩⟩
    convert hbase using 1
    unfold homogeneousProjπ DeJongAlterations.projectiveSpaceStructure
    congr 1
  have hCdual : IsInvertible (dualObj C) := hC.isInvertible.dual
  let : (dualObj C).IsQuasicoherent := hCdual.isQuasicoherent
  let : (dualObj C).IsFinitePresentation := hCdual.isFinitePresentation
  let : (dualObj C).IsFiniteType :=
    SheafOfModules.instIsFiniteTypeOfIsFinitePresentation (R := Y.ringCatSheaf) (dualObj C)
  obtain ⟨N, hN⟩ := exists_eventual_generatingSections_finite_pullback p L hL f (dualObj C)
  obtain ⟨G, hG⟩ := hN (N + 1) (Nat.le_succ N)
  have hPower : IsInvertible (bundleTensorPower ((Scheme.Modules.pullback f).obj L) (N + 1)) :=
    TensorPowerBaseIdealGrading.tensorPower_isInvertible (hL.1.pullback f) (N + 1)
  have hV := SchemeVeryAmpleTensorGeneratingSections.isVeryAmple_of_inverse_twist_generated
    (f ≫ p) C (bundleTensorPower ((Scheme.Modules.pullback f).obj L) (N + 1)) hC hPower G hG
  exact ⟨hL.1.pullback f, N + 1, Nat.zero_lt_succ N, hV⟩

end EnvelopeProperty.PLModelAuxiliaryPolarization
