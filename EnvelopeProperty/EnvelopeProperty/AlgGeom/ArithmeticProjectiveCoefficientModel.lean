import EnvelopeProperty.AlgGeom.ArithmeticCoefficientModel
import EnvelopeProperty.Projective.IdealBaseChange
import EnvelopeProperty.Projective.IdealRepresentationFinite
import EnvelopeProperty.AlgGeom.ProjectiveTwistCoefficientPullback
import EnvelopeProperty.AlgGeom.AmpleLineTwistGeneration

/-! # Actual arithmetic models of the original homogeneous projective equations

The coefficient ring and homogeneous relations are constructed from the original
finite polynomial family. Actual quotient Proj schemes, entire kernel sheaves,
native cartesian squares and original O(d) pullback comparisons retain the same
original projective quotient and its whole embedding. No desired model, scheme
comparison or line comparison is supplied.
-/

noncomputable section
universe u
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MvPolynomial
open Scheme.Modules
open scoped Classical
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace EnvelopeProperty.ArithmeticProjectiveCoefficientModel
open ArithmeticCoefficientModel ProjBerk
attribute [local instance] MvPolynomial.gradedAlgebra

private def closedCoefficientMap {P Q Z W : Scheme.{u}} (i : Z ⟶ P) (j : W ⟶ Q)
    [IsClosedImmersion i] [IsClosedImmersion j] (f : P ⟶ Q)
    (h : j.ker.comap f = i.ker) : Z ⟶ W :=
  i.toImage ≫ Scheme.IdealSheafData.subschemeMap i.ker j.ker f
    (Scheme.IdealSheafData.le_map_iff_comap_le.mpr h.le) ≫ inv j.toImage

private theorem closedCoefficientMap_embedding {P Q Z W : Scheme.{u}} (i : Z ⟶ P) (j : W ⟶ Q)
    [IsClosedImmersion i] [IsClosedImmersion j] (f : P ⟶ Q)
    (h : j.ker.comap f = i.ker) : closedCoefficientMap i j f h ≫ j = i ≫ f := by
  have hj : inv j.toImage ≫ j = j.imageι := by
    apply (cancel_epi j.toImage).1
    calc
      j.toImage ≫ (inv j.toImage ≫ j) = j := by
        simp only [← Category.assoc, IsIso.hom_inv_id, Category.id_comp]
      _ = j.toImage ≫ j.imageι := j.toImage_imageι.symm
  dsimp only [closedCoefficientMap]
  simp only [Category.assoc, hj]
  rw [Scheme.IdealSheafData.subschemeMap_subschemeι, ← Category.assoc, i.toImage_imageι]

private theorem closedCoefficientMap_isPullback {P Q Z W : Scheme.{u}} (i : Z ⟶ P) (j : W ⟶ Q)
    [IsClosedImmersion i] [IsClosedImmersion j] (f : P ⟶ Q)
    (h : j.ker.comap f = i.ker) : IsPullback (closedCoefficientMap i j f h) i j f :=
  (isPullback_of_isClosedImmersion i j (closedCoefficientMap i j f h) f
    (closedCoefficientMap_embedding i j f h).symm h).flip

variable {R : Type u} [CommRing R] {N : ℕ}

/-- The literal original homogeneous quotient with its genuine native grading. -/
def quotientScheme (I : HomogeneousIdeal (ProjectiveGrading R N)) : Scheme.{u} :=
  Proj (GradedQuotient.grading (ProjectiveGrading R N) I.toIdeal)

/-- The original quotient's actual native closed projective embedding. -/
def quotientEmbedding (I : HomogeneousIdeal (ProjectiveGrading R N)) :
    quotientScheme I ⟶ NativeProjectiveScheme R N :=
  GradedQuotient.quotientSchemeMap (ProjectiveGrading R N) I

private instance quotientEmbedding_closed (I : HomogeneousIdeal (ProjectiveGrading R N)) :
    IsClosedImmersion (quotientEmbedding I) :=
  GradedQuotient.instIsClosedImmersion_quotientSchemeMap (ProjectiveGrading R N) I

/-- The actual coefficient structure of that same quotient. -/
def quotientProjection (I : HomogeneousIdeal (ProjectiveGrading R N)) :
    quotientScheme I ⟶ Spec (.of R) := quotientEmbedding I ≫ nativeStructureMap

variable {k : Type u} [Field k] {ι : Type u}
variable (fs : ι → MvPolynomial (Fin (N + 1)) k)
  (hfs : ∀ i, ∃ d : ℕ, (fs i).IsHomogeneous d) (extra : Finset k)

/-- Finitely many original forms give an actual finite-type integer coefficient ring. -/
theorem modelCoefficientRing_finiteType [Finite ι] : Algebra.FiniteType ℤ (coefficientRing fs extra) :=
  coefficientRing_finiteType fs extra

/-- Each descended original polynomial retains its exact original homogeneous degree. -/
theorem polynomialRelations_isHomogeneous (i : ι) (d : ℕ) (hi : (fs i).IsHomogeneous d) :
    (polynomialRelations fs extra i).IsHomogeneous d := by
  apply MvPolynomial.IsHomogeneous.of_map
    (f := algebraMap (coefficientRing fs extra) k) (Subtype.val_injective)
  rw [map_polynomialRelations]
  exact hi

/-- The model ideal is generated by the actual original relations over the actual integer subalgebra. -/
def modelIdeal : HomogeneousIdeal (ProjectiveGrading (coefficientRing fs extra) N) :=
  ⟨Ideal.span (Set.range (polynomialRelations fs extra)),
    Ideal.homogeneous_span _ _ (by
      rintro _ ⟨i, rfl⟩
      obtain ⟨d, hd⟩ := hfs i
      exact ⟨d, polynomialRelations_isHomogeneous fs extra i d hd⟩)⟩

/-- Its literal whole ring ideal is the original finite-family span, without radical replacement. -/
theorem modelIdeal_toIdeal :
    (modelIdeal fs hfs extra).toIdeal = Ideal.span (Set.range (polynomialRelations fs extra)) := rfl

/-- The actual quotient Proj model over the coefficient subalgebra. -/
def modelScheme : Scheme.{u} := quotientScheme (modelIdeal fs hfs extra)

/-- Its entire native projective embedding is the actual quotient morphism. -/
def modelEmbedding : modelScheme fs hfs extra ⟶ NativeProjectiveScheme (coefficientRing fs extra) N :=
  quotientEmbedding (modelIdeal fs hfs extra)

/-- Closedness is derived from the actual original homogeneous quotient. -/
theorem modelEmbedding_isClosedImmersion : IsClosedImmersion (modelEmbedding fs hfs extra) :=
  quotientEmbedding_closed _

private instance modelEmbedding_closed : IsClosedImmersion (modelEmbedding fs hfs extra) :=
  modelEmbedding_isClosedImmersion fs hfs extra

/-- The model has its actual original-coefficient projection. -/
def modelProjection : modelScheme fs hfs extra ⟶ Spec (.of (coefficientRing fs extra)) :=
  modelEmbedding fs hfs extra ≫ nativeStructureMap

/-- The genuine closed quotient embedding internally witnesses projective factorization. -/
theorem modelProjection_isProjectiveFactorization : IsProjectiveFactorization (modelProjection fs hfs extra) :=
  ⟨N, modelEmbedding fs hfs extra, inferInstance, rfl⟩

variable (I : HomogeneousIdeal (ProjectiveGrading k N))
  (hI : Ideal.span (Set.range fs) = I.toIdeal)

include hI in
/-- The whole ideal image is the SAME original homogeneous ideal, with its literal presentation. -/
theorem modelIdeal_map :
    (modelIdeal fs hfs extra).map
      (coefficientGradedMap (algebraMap (coefficientRing fs extra) k)) = I := by
  apply HomogeneousIdeal.toIdeal_injective
  change (Ideal.span (Set.range (polynomialRelations fs extra))).map
    (MvPolynomial.map (algebraMap (coefficientRing fs extra) k)) = I.toIdeal
  rw [Ideal.map_span]
  have hr : MvPolynomial.map (algebraMap (coefficientRing fs extra) k) ''
      Set.range (polynomialRelations fs extra) = Set.range fs := by
    ext x
    constructor
    · rintro ⟨y, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, (map_polynomialRelations fs extra i).symm⟩
    · rintro ⟨i, rfl⟩
      exact ⟨polynomialRelations fs extra i, ⟨i, rfl⟩, map_polynomialRelations fs extra i⟩
  rw [hr, hI]

include hI in
private theorem modelKernel_comap :
    (modelEmbedding fs hfs extra).ker.comap
      (nativeCoefficientMap (algebraMap (coefficientRing fs extra) k)) = (quotientEmbedding I).ker := by
  exact (homogeneousQuotientIdealSheaf_comap_coefficientMap
    (algebraMap (coefficientRing fs extra) k) (modelIdeal fs hfs extra)).trans
      (congrArg (GradedQuotient.quotientIdealSheaf (ProjectiveGrading k N))
        (modelIdeal_map fs hfs extra I hI))

/-- The original projective quotient maps to its internally constructed arithmetic model. -/
def coefficientModelMap : quotientScheme I ⟶ modelScheme fs hfs extra :=
  closedCoefficientMap (quotientEmbedding I) (modelEmbedding fs hfs extra)
    (nativeCoefficientMap (algebraMap (coefficientRing fs extra) k))
    (modelKernel_comap fs hfs extra I hI)

/-- The WHOLE embedding triangle retains both actual original quotient embeddings. -/
theorem coefficientModelMap_embedding :
    coefficientModelMap fs hfs extra I hI ≫ modelEmbedding fs hfs extra =
      quotientEmbedding I ≫ nativeCoefficientMap (algebraMap (coefficientRing fs extra) k) :=
  closedCoefficientMap_embedding _ _ _ _

/-- The entire embedding square is a native pullback, internally from whole kernel ideals. -/
theorem isPullback_coefficientModelMap_embedding :
    IsPullback (coefficientModelMap fs hfs extra I hI) (quotientEmbedding I)
      (modelEmbedding fs hfs extra) (nativeCoefficientMap (algebraMap (coefficientRing fs extra) k)) :=
  closedCoefficientMap_isPullback _ _ _ _

/-- Pasting with the native projective coefficient pullback gives the entire actual model base change. -/
theorem isPullback_coefficientModelMap :
    IsPullback (coefficientModelMap fs hfs extra I hI) (quotientProjection I)
      (modelProjection fs hfs extra) (Spec.map (CommRingCat.ofHom (algebraMap (coefficientRing fs extra) k))) :=
  (isPullback_coefficientModelMap_embedding fs hfs extra I hI).paste_vert
    (isPullback_nativeCoefficientBaseChange (algebraMap (coefficientRing fs extra) k))

/-- This actual scalar-extension isomorphism recovers precisely the SAME original quotient scheme. -/
def baseChangeIso : quotientScheme I ≅
    pullback (modelProjection fs hfs extra)
      (Spec.map (CommRingCat.ofHom (algebraMap (coefficientRing fs extra) k))) :=
  (isPullback_coefficientModelMap fs hfs extra I hI).isoPullback

/-- Its actual model projection is the internally constructed original quotient map. -/
theorem baseChangeIso_hom_fst :
    (baseChangeIso fs hfs extra I hI).hom ≫ pullback.fst _ _ = coefficientModelMap fs hfs extra I hI :=
  (isPullback_coefficientModelMap fs hfs extra I hI).isoPullback_hom_fst

/-- Its actual original-field projection is the SAME original quotient structure morphism. -/
theorem baseChangeIso_hom_snd :
    (baseChangeIso fs hfs extra I hI).hom ≫ pullback.snd _ _ = quotientProjection I :=
  (isPullback_coefficientModelMap fs hfs extra I hI).isoPullback_hom_snd

/-- The SAME original nonnegative O(d), pulled to the actual model quotient. -/
def modelTwist (d : ℕ) : (modelScheme fs hfs extra).Modules :=
  (Scheme.Modules.pullback (modelEmbedding fs hfs extra)).obj
    (coordinateHyperplaneTwist (R := coefficientRing fs extra) (0 : Fin (N + 1)) (d : ℤ))

/-- The entire original O(d) comparison is derived from the whole embedding triangle and existing scalar pullback. -/
def twistPullbackIso (d : ℕ) :
    (Scheme.Modules.pullback (coefficientModelMap fs hfs extra I hI)).obj (modelTwist fs hfs extra d) ≅
      (Scheme.Modules.pullback (quotientEmbedding I)).obj
        (coordinateHyperplaneTwist (R := k) (0 : Fin (N + 1)) (d : ℤ)) :=
  (Scheme.Modules.pullbackComp (coefficientModelMap fs hfs extra I hI)
    (modelEmbedding fs hfs extra)).app _ ≪≫
  (Scheme.Modules.pullbackCongr (coefficientModelMap_embedding fs hfs extra I hI)).app _ ≪≫
  ((Scheme.Modules.pullbackComp (quotientEmbedding I)
    (nativeCoefficientMap (algebraMap (coefficientRing fs extra) k))).app _).symm ≪≫
  (Scheme.Modules.pullback (quotientEmbedding I)).mapIso
    (ProjectiveTwistCoefficientPullback.coordinatePolePowerPullbackIso
      (algebraMap (coefficientRing fs extra) k) (0 : Fin (N + 1)) d)

/-- The actual first model twist has its internally witnessed genuine very-ample embedding. -/
theorem modelTwist_one_isVeryAmple :
    SchemeLineAmpleness.IsVeryAmple (modelProjection fs hfs extra) (modelTwist fs hfs extra 1) :=
  ⟨N, modelEmbedding fs hfs extra, inferInstance, rfl, ⟨Iso.refl _⟩⟩

/-- The same actual model first twist is ample, without an input ampleness certificate. -/
theorem modelTwist_one_isAmple :
    SchemeLineAmpleness.IsAmple (modelProjection fs hfs extra) (modelTwist fs hfs extra 1) :=
  AmpleLineTwistGeneration.isAmple_of_isVeryAmple (modelTwist_one_isVeryAmple fs hfs extra)

/-- An arbitrary ORIGINAL closed projective embedding internally supplies an actual finite
homogeneous quotient presentation and the entire original embedding identity. -/
theorem exists_original_closed_presentation {X : Scheme.{u}}
    (j : X ⟶ NativeProjectiveScheme k N) [IsClosedImmersion j] :
    ∃ (J : HomogeneousIdeal (ProjectiveGrading k N))
      (t : Finset (MvPolynomial (Fin (N + 1)) k)),
      (∀ F ∈ t, ∃ d : ℕ, F.IsHomogeneous d) ∧ Ideal.span (t : Set _) = J.toIdeal ∧
      ∃ e : X ≅ quotientScheme J, e.hom ≫ quotientEmbedding J = j := by
  obtain ⟨J, t, hhom, hspan, hker⟩ := exists_finite_homogeneous_generators_quotientIdealSheaf j.ker
  have hk : (quotientEmbedding J).ker = j.ker := hker
  let e := IsClosedImmersion.lift (quotientEmbedding J) j hk.le
  let := IsClosedImmersion.isIso_lift (quotientEmbedding J) j hk
  exact ⟨J, t, hhom, hspan, asIso e, IsClosedImmersion.lift_fac _ _ _⟩

end EnvelopeProperty.ArithmeticProjectiveCoefficientModel
