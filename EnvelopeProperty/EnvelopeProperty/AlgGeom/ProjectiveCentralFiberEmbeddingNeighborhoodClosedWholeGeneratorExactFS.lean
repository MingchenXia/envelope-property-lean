import EnvelopeProperty.AlgGeom.ProjectiveCentralFiberEmbeddingNeighborhoodClosedWholeGenerators
import EnvelopeProperty.AlgGeom.GeneratedLineBaseIdealUnit
import EnvelopeProperty.Berkovich.SchemeLineGlobalGeneratorNorms
import EnvelopeProperty.Global.NativeTestConfigurationModelFSApproximation

/-! # The model potential of a centrally ample line is a finite Fubini–Study function

Let `C` be a test configuration for `X` over an infinite field `k` with integral total space and
dominant projection, let `M` be an invertible line on the total space with a `𝔾ₘ`-linearization
`α` and an identification `e₁` of its restriction to the fibre over `1` with an invertible line
`L` on `X`. The model potential `φ_M = C.gaussNativeModelPotential M … L α e₁ …` (the model
function `φ_𝓛` of the test configuration `(C, M)`, as in the proof of FHX
`lem:local-PL-positivity`) satisfies:

* if `M^{⊗m}` is generated by global sections, its base ideal is the unit ideal, so the
  normalized logarithm of the base ideal vanishes at every Gauss point and the maximum of the
  model norms of a finite generating family is `1` at every point;
* hence, if the restriction of `M` to the central fibre is ample, `φ_M` is *exactly* a finite
  rational Fubini–Study function of class `1` for `L`
  (`isFinFS_modelPotential_of_central_ample`): by production
  `exists_positive_power_generators_of_central_ample` some `M^{⊗m}` is generated by finitely many
  global sections, and the weighted FS datum of their Laurent coefficients
  (`weightedFSData`, radius `e⁻¹`) evaluates to `φ_M` plus `m⁻¹ log max ‖sᵢ‖ = 0`.

This is the finite-FS step of the formalized route to FHX `lem:local-PL-positivity` (Lemma 5.5).
Blueprint: `thm:central-ample-original-exact-finite-fs`.
-/

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MonoidalCategory
open CartesianMonoidalCategory
open Scheme.Modules
open scoped Classical NNReal ENNReal
noncomputable section
universe u
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace EnvelopeProperty.ProjectiveCentralFiberEmbeddingNeighborhoodClosedWholeGeneratorExactFS
open Berkovich Berkovich.RelativeSchemeValuedPoint CanonicalGeometry
open NativeTestConfiguration NativeTestConfiguration.TestConfiguration
open ProjectiveCentralFiberEmbeddingNeighborhoodClosedWholeGenerators

variable {k : Type u} [Field k] {X : Over (Spec (.of k))}
    (C : TestConfiguration k X) (M : C.total.Modules) (hM : IsInvertible M)

private local instance projectionProper : IsProper C.projection := C.projection_isProper

/-- If `M^{⊗m}` is generated by global sections, its base ideal is the unit ideal. -/
theorem powerBaseIdeal_eq_top_of_generatingSections (m : ℕ)
    (G : (bundleTensorPower M m).GeneratingSections) :
    TensorPowerBaseIdealGrading.powerBaseIdeal hM m = ⊤ :=
  GeneratedLineBaseIdealUnit.baseIdeal_eq_top_of_generatingSections
    (TensorPowerBaseIdealGrading.tensorPower_isInvertible hM m) G

/-- If `M^{⊗m}` is generated by global sections, the normalized logarithm of its base ideal
vanishes at every Gauss point of every radius `0 < r ≤ 1`. -/
theorem gaussPowerBaseIdealLogNormalized_eq_zero_of_generatingSections
    (m : ℕ) (G : (bundleTensorPower M m).GeneratingSections)
    (r : ℝ≥0) (hr : 0 < r) (hru : r ≤ 1)
    (x : RelativeSchemeValuedPoint (1 : Valuation k ℝ≥0) X.hom) :
    C.gaussPowerBaseIdealLogNormalized M hM r hr hru x m = 0 := by
  unfold gaussPowerBaseIdealLogNormalized
  rw [powerBaseIdeal_eq_top_of_generatingSections C M hM m G,
    modelIdealNorm_top, ENNReal.log_one, mul_zero]

/-- The finite set of global sections of `M^{⊗m}` underlying a finite generating family. -/
def finiteGeneratorSections (m : ℕ) (G : (bundleTensorPower M m).GeneratingSections)
    [G.IsFiniteType] : Finset Γ(bundleTensorPower M m, ⊤) := by
  letI : Finite G.I := SheafOfModules.GeneratingSections.IsFiniteType.finite (σ := G)
  letI := Fintype.ofFinite G.I
  exact Finset.univ.image (GeneratedLineBaseIdealUnit.topSection G)

/-- The maximum of the model norms of a finite generating family of `M^{⊗m}` is `1` at every
Gauss point. -/
theorem finiteGeneratorSections_norm (m : ℕ)
    (G : (bundleTensorPower M m).GeneratingSections) [G.IsFiniteType]
    (r : ℝ≥0) (hr : 0 < r) (hru : r ≤ 1)
    (x : RelativeSchemeValuedPoint (1 : Valuation k ℝ≥0) X.hom) :
    (finiteGeneratorSections C M m G).sup
      (fun s => C.gaussPowerSectionNorm M hM r hr hru x m s) = 1 := by
  let : Finite G.I := SheafOfModules.GeneratingSections.IsFiniteType.finite (σ := G)
  let := Fintype.ofFinite G.I
  let y := C.relativeGaussPoint x r hr
  let hb := Spectrum.trivialGaussValuation_le_one k r hru
  let hMp := TensorPowerBaseIdealGrading.tensorPower_isInvertible hM m
  have hnorm (i : G.I) :
      C.gaussPowerSectionNorm M hM r hr hru x m
        (GeneratedLineBaseIdealUnit.topSection G i) =
      modelLineNorm hb y hMp
        (fibreSection y (SchemeGeneratingSectionsUnit.generatorHom G i)) := by
    rw [gaussPowerSectionNorm, GeneratedLineBaseIdealUnit.sectionHom_topSection]
  simp only [finiteGeneratorSections, Finset.sup_image]
  apply le_antisymm
  · apply Finset.sup_le
    intro i _hi
    show C.gaussPowerSectionNorm M hM r hr hru x m (GeneratedLineBaseIdealUnit.topSection G i) ≤ 1
    rw [hnorm i, modelLineNorm_fibreSection]
    exact modelHomNorm_le_one hb y (isInvertible_unit (X := C.total)) hMp
      (SchemeGeneratingSectionsUnit.generatorHom G i)
  · obtain ⟨i, hi⟩ := exists_modelLineNorm_generatorHom_eq_one hb y hMp G
    have hi' := (hnorm i).trans hi
    exact hi'.symm.le.trans
      (Finset.le_sup (f := fun j => C.gaussPowerSectionNorm M hM r hr hru x m
        (GeneratedLineBaseIdealUnit.topSection G j)) (Finset.mem_univ i))

variable (L : X.left.Modules)
    (α : (Scheme.Modules.pullback C.lineActionMap).obj M ≅
        (Scheme.Modules.pullback C.lineProjectionMap).obj M)
    (e₁ : (Scheme.Modules.pullback C.fibreOneInclusion.left).obj M ≅
      (Scheme.Modules.pullback C.fibreOneIso.hom.left).obj L) (hL : IsInvertible L)

/-- For a finite generating family of `M^{⊗m}`, the weighted FS datum of its Laurent coefficients
evaluates exactly to the model potential. -/
theorem weightedFSData_eval_eq_modelPotential_of_generatingSections
    (m : ℕ) (hm : 0 < m) (G : (bundleTensorPower M m).GeneratingSections) [G.IsFiniteType]
    (r : ℝ≥0) (hr : 0 < r) (hru : r ≤ 1) :
    letI : IsProper X.hom := C.original_isProper
    ∀ x : RelativeSchemeValuedPoint (1 : Valuation k ℝ≥0) X.hom,
      (C.weightedFSData M L α e₁ hL m hm (finiteGeneratorSections C M m G) r).eval X.hom hL x =
        (C.gaussNativeModelPotential M hM L α e₁ hL r hr hru x : EReal) := by
  let : IsProper X.hom := C.original_isProper
  intro x
  have h := C.gaussNativeModelPotential_weightedFSData_eval M hM L α e₁ hL
    r hr hru x m hm (finiteGeneratorSections C M m G)
  rw [finiteGeneratorSections_norm C M hM m G r hr hru x] at h
  simpa only [ENNReal.coe_one, ENNReal.log_one, mul_zero, add_zero] using h

/-- **Exact finite FS.** If the restriction of the linearized line `M` to the central fibre is
ample, the model potential of `M` (at the radius `e⁻¹`) is a finite rational Fubini–Study function
of class `1` for the fibre-one line `L`. -/
theorem isFinFS_modelPotential_of_central_ample [Infinite k]
    [IsIntegral C.total] [IsDominant C.projection]
    (hCentral : SchemeLineAmpleness.IsAmple
        (pullback.snd C.projection (ProjectiveCentralFiberSectionLifting.zeroMap k))
      ((Scheme.Modules.pullback
          (ProjectiveCentralFiberSectionLifting.zeroInclusion C.projection)).obj M)) :
    letI : IsProper X.hom := C.original_isProper
    NativeLineFubiniStudy.IsFinFS X.hom L hL 1
      (fun x => (C.gaussNativeModelPotential M hM L α e₁ hL weightedFSRadius
        weightedFSRadius_properties.1 weightedFSRadius_properties.2.1 x : EReal)) := by
  let : IsProper X.hom := C.original_isProper
  obtain ⟨m, hm, G, hG⟩ :=
    exists_positive_power_generators_of_central_ample C M hM α hCentral
  let : G.IsFiniteType := hG
  have he := weightedFSData_eval_eq_modelPotential_of_generatingSections
    C M hM L α e₁ hL m hm G weightedFSRadius
      weightedFSRadius_properties.1 weightedFSRadius_properties.2.1
  refine ⟨C.weightedFSData M L α e₁ hL m hm (finiteGeneratorSections C M m G) weightedFSRadius,
    C.weightedFSData_isRational M L α e₁ hL m hm (finiteGeneratorSections C M m G), ?_,
    fun x => (he x).symm⟩
  intro x
  apply ((C.weightedFSData M L α e₁ hL m hm (finiteGeneratorSections C M m G)
    weightedFSRadius).eval_ne_bot_iff_exists_norm_ne_zero X.hom L hL x).mp
  rw [he x]
  exact EReal.coe_ne_bot _

include α e₁ in
/-- If `M` is centrally ample and `L` is ample, the normalized logarithms of the base ideals of
the powers of `M` tend to `0`, and `0` is their supremum over positive degrees. -/
theorem gaussPowerBaseIdealLogNormalized_tendsto_zero_of_central_ample [Infinite k]
    [IsIntegral C.total] [IsDominant C.projection]
    (hCentral : SchemeLineAmpleness.IsAmple
        (pullback.snd C.projection (ProjectiveCentralFiberSectionLifting.zeroMap k))
      ((Scheme.Modules.pullback
          (ProjectiveCentralFiberSectionLifting.zeroInclusion C.projection)).obj M))
    (hAmp : SchemeLineAmpleness.IsAmple X.hom L)
    (r : ℝ≥0) (hr : 0 < r) (hru : r ≤ 1)
    (x : RelativeSchemeValuedPoint (1 : Valuation k ℝ≥0) X.hom) :
    Filter.Tendsto (C.gaussPowerBaseIdealLogNormalized M hM r hr hru x)
      Filter.atTop (nhds (0 : EReal)) ∧
      IsLUB {q : EReal | ∃ m : ℕ, 0 < m ∧
        q = C.gaussPowerBaseIdealLogNormalized M hM r hr hru x m} 0 := by
  obtain ⟨m, hm, G, _hG⟩ :=
    exists_positive_power_generators_of_central_ample C M hM α hCentral
  have hzero := gaussPowerBaseIdealLogNormalized_eq_zero_of_generatingSections
    C M hM m G r hr hru x
  obtain ⟨a, ha, hlim, hsup⟩ :=
    C.exists_gauss_log_normalized_supremum M hM L hAmp α e₁ r hr hru x
  have hnonneg : (0 : EReal) ≤ (a : EReal) := by
    have h := hsup.1 ⟨m, hm, rfl⟩
    simpa only [hzero] using h
  have ha0 : a = 0 := le_antisymm ha (EReal.coe_nonneg.mp hnonneg)
  simpa only [ha0, EReal.coe_zero] using And.intro hlim hsup

end EnvelopeProperty.ProjectiveCentralFiberEmbeddingNeighborhoodClosedWholeGeneratorExactFS
