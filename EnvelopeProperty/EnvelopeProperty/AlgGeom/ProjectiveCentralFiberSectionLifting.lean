/-! # Actual sections of the SAME line lift from its original zero fibre

All ideal, short-exact-sequence, finite-cohomology and restriction comparisons
are derived from actual original geometry. The fibre is allowed nonreduced.
-/

noncomputable section
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Scheme.Modules CategoryTheory.MonoidalCategory
universe u
namespace EnvelopeProperty.ProjectiveCentralFiberSectionLifting

/-- The original coefficient map defining the actual zero fibre. -/
def zeroMap (k : Type u) [Field k] : Spec (CommRingCat.of k) ⟶
    Spec (CommRingCat.of (Polynomial k)) :=
  Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0))

instance zeroMap_closed (k : Type u) [Field k] : IsClosedImmersion (zeroMap k) :=
  IsClosedImmersion.spec_of_surjective _ (fun a => ⟨Polynomial.C a, Polynomial.eval_C⟩)

/-- The actual categorical pullback, with its full scheme structure. -/
abbrev zeroFiber {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) : Scheme.{u} :=
  pullback p (zeroMap k)

/-- The actual original closed zero-fibre inclusion. -/
abbrev zeroInclusion {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) : zeroFiber p ⟶ Y :=
  pullback.fst p (zeroMap k)

private theorem specMap_ker {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) :
    (Spec.map (CommRingCat.ofHom φ)).ker = specIdealSheaf (RingHom.ker φ) := by
  rw [Scheme.ker_of_isAffine]
  apply congrArg Scheme.IdealSheafData.ofIdealTop
  let eR := (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom
  let eS := (Scheme.ΓSpecIso (CommRingCat.of S)).inv.hom
  have heR : Function.Bijective eR :=
    ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of R)).inv
  have heS : Function.Injective eS :=
    (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of S)).inv).injective
  apply Ideal.comap_injective_of_surjective eR heR.surjective
  have hc : (Spec.map (CommRingCat.ofHom φ)).appTop.hom.comp eR = eS.comp φ := by
    ext a
    exact (ConcreteCategory.congr_hom (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ)) a).symm
  rw [RingHom.comap_ker,hc,RingHom.ker_comp_of_injective φ heS,
    Ideal.comap_map_of_bijective eR heR]

/-- The actual eval0 closed immersion has exactly the actual parameter ideal. -/
theorem zeroMap_ker (k : Type u) [Field k] :
    (zeroMap k).ker = specIdealSheaf (Ideal.span {(Polynomial.X : Polynomial k)}) := by
  rw [zeroMap,specMap_ker,Polynomial.ker_evalRingHom]
  simp only [map_zero,sub_zero]

/-- On EVERY original affine open, the TRUE zero-fibre ideal is generated by SAME t. -/
theorem zeroInclusion_ideal {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) (U : Y.affineOpens) :
    (zeroInclusion p).ker.ideal U = Ideal.span {sectionsHom p U.1 Polynomial.X} := by
  rw [Scheme.IdealSheafData.ker_fst_of_isClosedImmersion,zeroMap_ker,
    ideal_comap_specIdealSheaf,Ideal.map_span,Set.image_singleton]

/-- Original integral dominance makes the SAME parameter nonzero in EVERY original stalk. -/
theorem parameter_stalk_ne_zero {k : Type u} [Field k] {Y : Scheme.{u}} [IsIntegral Y]
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) [IsDominant p] [QuasiCompact p] (y : Y) :
    SchemeStalkCoefficients.coefficientMap p y Polynomial.X ≠ 0 :=
  (map_ne_zero_iff _ (SchemeStalkCoefficients.coefficientMap_injective p y)).mpr Polynomial.X_ne_zero

/-- The SAME global original polynomial parameter, without a new scalar action. -/
def parameter {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) : Γ(Y, ⊤) :=
  sectionsHom p ⊤ Polynomial.X

private theorem sectionsHom_restrict {R : Type u} [CommRing R] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of R)) {U V : Y.Opens} (h : U ≤ V) (a : R) :
    Y.presheaf.map (homOfLE h).op (sectionsHom p V a) = sectionsHom p U a := by
  exact ConcreteCategory.congr_hom
    (p.appLE_map (U := ⊤) (V := V) le_top (homOfLE h).op)
      ((Scheme.ΓSpecIso (CommRingCat.of R)).inv a)

private theorem parameter_ne_zero {k : Type u} [Field k] {Y : Scheme.{u}} [IsIntegral Y]
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) [IsDominant p] [QuasiCompact p] :
    parameter p ≠ 0 := by
  let : IsSchemeTheoreticallyDominant p := IsSchemeTheoreticallyDominant.of_isDominant p
  let : Nonempty (⊤ : Y.Opens) := ⟨⟨genericPoint Y, trivial⟩⟩
  have hinj : Function.Injective (sectionsHom p ⊤) := by
    exact (map_injective_of_isIntegral Y
      (homOfLE (le_top : (⊤ : Y.Opens) ≤ p ⁻¹ᵁ ⊤))).comp
        ((p.app_injective ⊤).comp
          (ConcreteCategory.bijective_of_isIso
            (Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv).injective)
  exact (map_ne_zero_iff _ hinj).mpr Polynomial.X_ne_zero

private theorem parameter_regular {k : Type u} [Field k] {Y : Scheme.{u}} [IsIntegral Y]
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) [IsDominant p] [QuasiCompact p]
    (U : Y.Opens) [Nonempty U] : sectionsHom p U Polynomial.X ∈ nonZeroDivisors Γ(Y,U) := by
  rw [mem_nonZeroDivisors_iff_ne_zero]
  have hn := (map_ne_zero_iff _ (map_injective_of_isIntegral Y
    (homOfLE (le_top : U ≤ ⊤)))).mpr (parameter_ne_zero p)
  exact (sectionsHom_restrict p (le_top : U ≤ ⊤) Polynomial.X) ▸ hn

private def parameterIdealSection {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) : Γ((zeroInclusion p).ker.toModules,⊤) :=
  ⟨parameter p, by
    intro V hV
    rw [zeroInclusion_ideal]
    change Y.presheaf.map (homOfLE hV).op (sectionsHom p ⊤ Polynomial.X) ∈ _
    rw [sectionsHom_restrict]
    exact Ideal.mem_span_singleton_self _⟩

private def parameterIdealMap {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) : unitObj Y ⟶ (zeroInclusion p).ker.toModules :=
  SchemeModuleGlobalSections.sectionHom _ (parameterIdealSection p)

private theorem parameterIdealMap_apply {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) (U : Y.Opens) (a : Γ(Y,U)) :
    (show (zeroInclusion p).ker.toSubmodule.obj (op U) from
      (parameterIdealMap p).val.app (op U) a).1 = a * sectionsHom p U Polynomial.X := by
  change a * Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op (parameter p) = _
  change a * Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op
    (sectionsHom p ⊤ Polynomial.X) = _
  rw [sectionsHom_restrict]

private theorem parameterIdealMap_injective {k : Type u} [Field k]
    {Y : Scheme.{u}} [IsIntegral Y] (p : Y ⟶ Spec (CommRingCat.of (Polynomial k)))
    [IsDominant p] [QuasiCompact p] (U : Y.Opens) :
    Function.Injective ((parameterIdealMap p).val.app (op U)) := by
  intro a b hab
  let aR : Γ(Y,U) := a
  let bR : Γ(Y,U) := b
  change aR = bR
  by_cases hU : Nonempty U
  · let : Nonempty U := hU
    have ht : sectionsHom p U Polynomial.X ≠ 0 :=
      mem_nonZeroDivisors_iff_ne_zero.mp (parameter_regular p U)
    have hc := congrArg (fun z : Γ((zeroInclusion p).ker.toModules,U) =>
      (show (zeroInclusion p).ker.toSubmodule.obj (op U) from z).1) hab
    change aR * Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op
        (sectionsHom p ⊤ Polynomial.X) =
      bR * Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op
        (sectionsHom p ⊤ Polynomial.X) at hc
    rw [sectionsHom_restrict] at hc
    exact mul_right_cancel₀ ht hc
  · apply Y.IsSheaf.section_ext
    intro y hy
    exact (hU ⟨⟨y,hy⟩⟩).elim

private theorem parameterIdealMap_mono {k : Type u} [Field k]
    {Y : Scheme.{u}} [IsIntegral Y] (p : Y ⟶ Spec (CommRingCat.of (Polynomial k)))
    [IsDominant p] [QuasiCompact p] : Mono (parameterIdealMap p) := by
  constructor
  intro Z a b hab
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro U
  apply ModuleCat.hom_ext
  ext z
  apply parameterIdealMap_injective p U.unop
  exact congrArg (fun q : Z ⟶ (zeroInclusion p).ker.toModules => q.val.app U z) hab

private theorem parameterIdealMap_epi {k : Type u} [Field k]
    {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) :
    Epi (parameterIdealMap p) := by
  have hs : Sheaf.IsLocallySurjective
      ((SheafOfModules.toSheaf Y.ringCatSheaf).map (parameterIdealMap p)) := by
    constructor
    intro W s x hx
    obtain ⟨V,hV,hxV,hVW⟩ := exists_isAffineOpen_mem_and_subset (X := Y) (U := W) (x := x) hx
    let ss : Γ((zeroInclusion p).ker.toModules,V) :=
      (zeroInclusion p).ker.toModules.presheaf.map (homOfLE hVW).op s
    let a := (zeroInclusion p).ker.toModulesSectionsEquiv ⟨V,hV⟩ ss
    have ha : (a : Γ(Y,V)) ∈ Ideal.span {sectionsHom p V Polynomial.X} := by
      rw [← zeroInclusion_ideal p ⟨V,hV⟩]
      exact a.property
    obtain ⟨r,hr⟩ := Submodule.mem_span_singleton.mp ha
    refine ⟨V,homOfLE hVW,⟨r,?_⟩,hxV⟩
    apply Subtype.ext
    change (show (zeroInclusion p).ker.toSubmodule.obj (op V) from
      (parameterIdealMap p).val.app (op V) r).1 = _
    rw [parameterIdealMap_apply]
    exact hr
  let := hs
  exact (SheafOfModules.toSheaf Y.ringCatSheaf).epi_of_epi_map inferInstance

/-- The actual native zero-fibre ideal is trivially generated by the SAME regular parameter. -/
def parameterIdealIso {k : Type u} [Field k] {Y : Scheme.{u}} [IsIntegral Y]
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) [IsDominant p] [QuasiCompact p] :
    unitObj Y ≅ ModularCurves.idealModule (zeroInclusion p) := by
  let : Mono (parameterIdealMap p) := parameterIdealMap_mono p
  let : Epi (parameterIdealMap p) := parameterIdealMap_epi p
  let : IsIso (parameterIdealMap p) := isIso_of_mono_of_epi _
  exact asIso (parameterIdealMap p) ≪≫
    MorphismKernelIdealModuleComparison.kernelIdealModuleIso (zeroInclusion p)

/-- The WHOLE original inclusion is precisely the actual parameter section action. -/
theorem parameterIdealIso_inclusion {k : Type u} [Field k] {Y : Scheme.{u}} [IsIntegral Y]
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) [IsDominant p] [QuasiCompact p] :
    (parameterIdealIso p).hom ≫ ModularCurves.idealModuleToUnit (zeroInclusion p) =
      SchemeModuleGlobalSections.sectionHom (unitObj Y) (parameter p) := by
  change parameterIdealMap p ≫
    (MorphismKernelIdealModuleComparison.kernelIdealModuleIso (zeroInclusion p)).hom ≫ _ = _
  rw [MorphismKernelIdealModuleComparison.kernelIdealModuleIso_hom_inclusion]
  apply Scheme.Modules.hom_ext
  intro U
  apply AddCommGrpCat.hom_ext
  ext a
  let aR : Γ(Y,U) := a
  change (show (zeroInclusion p).ker.toSubmodule.obj (op U) from
    (parameterIdealMap p).val.app (op U) aR).1 =
      aR * Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op (parameter p)
  rw [parameterIdealMap_apply]
  change aR * sectionsHom p U Polynomial.X =
    aR * Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op (sectionsHom p ⊤ Polynomial.X)
  rw [sectionsHom_restrict]

private theorem homology_zero_surjective_of_self {R : Type u} [CommRing R] [IsNoetherianRing R]
    {C Q : CochainComplex (ModuleCat.{u} R) ℕ}
    (a : C ⟶ C) (b : C ⟶ Q) (hz : a ≫ b = 0)
    (hS : (ShortComplex.mk a b hz).ShortExact)
    [Module.Finite R (C.homology 1)] (hQ : IsZero (Q.homology 1)) :
    Function.Surjective (HomologicalComplex.homologyMap b 0) := by
  let A := HomologicalComplex.homologyMap a 1
  have hsurj : Function.Surjective A.hom := by
    apply LinearMap.range_eq_top.mp
    rw [(hS.homology_exact₂ 1).moduleCat_range_eq_ker]
    change LinearMap.ker (HomologicalComplex.homologyMap b 1).hom = ⊤
    have hb : HomologicalComplex.homologyMap b 1 = 0 := hQ.eq_of_tgt _ _
    rw [hb]
    exact LinearMap.ker_zero
  have hinj : Function.Injective A.hom :=
    IsNoetherian.injective_of_surjective_endomorphism A.hom hsurj
  have hd : (hS.δ 0 1 rfl).hom = 0 := by
    apply LinearMap.range_eq_bot.mp
    rw [(hS.homology_exact₁ 0 1 rfl).moduleCat_range_eq_ker]
    exact LinearMap.ker_eq_bot.mpr hinj
  apply LinearMap.range_eq_top.mp
  rw [(hS.homology_exact₃ 0 1 rfl).moduleCat_range_eq_ker]
  change LinearMap.ker (hS.δ 0 1 rfl).hom = ⊤
  rw [hd]
  exact LinearMap.ker_zero

private theorem finiteType_of_invertible {Y : Scheme.{u}} (L : Y.Modules) (hL : IsInvertible L) :
    L.IsFiniteType := by
  let : L.IsFinitePresentation := hL.isFinitePresentation
  obtain ⟨q,hq⟩ := SheafOfModules.IsFinitePresentation.exists_quasicoherentData L
  refine { exists_localGeneratorsData := ⟨q.localGeneratorsData,?_⟩ }
  constructor
  intro i
  exact (hq.isFinite_presentation i).isFiniteType_generators

/-- Actual projective geometry internally supplies the finite original first Cech cohomology. -/
theorem baseCech_hone_finite {R : Type u} [CommRing R] [IsNoetherianRing R]
    {Y : Scheme.{u}} (p : Y ⟶ Spec (CommRingCat.of R)) (hp : IsProjectiveFactorization p)
    (L : Y.Modules) (hL : IsInvertible L) {ι : Type u} [Finite ι]
    (U : ι → Y.Opens) (hU : IsOpenCover U) (hUa : ∀ i, IsAffineOpen (U i)) :
    Module.Finite Γ(Spec (CommRingCat.of R),⊤) ((baseCechComplex p L U).homology 1) := by
  let : L.IsQuasicoherent := hL.isQuasicoherent
  let : L.IsFiniteType := finiteType_of_invertible L hL
  exact hp.baseModuleCech_homology_one_module_finite_of_affine_openCover L U hU hUa

private theorem augmentation_naturality {Y S : Scheme.{u}} (p : Y ⟶ S)
    {ι : Type u} (U : ι → Y.Opens) {M N : Y.Modules} (f : M ⟶ N) :
    baseCechAugmentation p M U ≫ ((baseCechComplexFunctor p U).map f).f 0 =
      baseSectionsMap p f ≫ baseCechAugmentation p N U := by
  let θ : baseModulePresheaf p M ⟶ baseModulePresheaf p N := (baseModulePresheafFunctor p).map f
  let φ : baseCechComplex p M U ⟶ baseCechComplex p N U := (baseCechComplexFunctor p U).map f
  change baseCechAugmentation p M U ≫ φ.f 0 =
    baseSectionsMap p f ≫ baseCechAugmentation p N U
  apply Pi.hom_ext
  intro i
  change Fin 1 → ι at i
  have hn : φ.f 0 ≫
      Pi.π (fun j : Fin 1 → ι => (baseModulePresheaf p N).obj
        (op (∏ᶜ fun k : Fin 1 => U (j k)))) i =
    Pi.π (fun j : Fin 1 → ι => (baseModulePresheaf p M).obj
        (op (∏ᶜ fun k : Fin 1 => U (j k)))) i ≫
      θ.app (op (∏ᶜ fun k : Fin 1 => U (i k))) := by
    change Limits.Pi.map (fun j : Fin 1 → ι =>
      θ.app (op (∏ᶜ fun k : Fin 1 => U (j k)))) ≫ _ = _
    exact Limits.Pi.map_π _ i
  change (baseCechAugmentation p M U ≫ φ.f 0) ≫
      Pi.π (fun j : Fin 1 → ι => (baseModulePresheaf p N).obj
        (op (∏ᶜ fun k : Fin 1 => U (j k)))) i =
    (baseSectionsMap p f ≫ baseCechAugmentation p N U) ≫
      Pi.π (fun j : Fin 1 → ι => (baseModulePresheaf p N).obj
        (op (∏ᶜ fun k : Fin 1 => U (j k)))) i
  let qN := Pi.π (fun j : Fin 1 → ι => (baseModulePresheaf p N).obj
    (op (∏ᶜ fun k : Fin 1 => U (j k)))) i
  let qM := Pi.π (fun j : Fin 1 → ι => (baseModulePresheaf p M).obj
    (op (∏ᶜ fun k : Fin 1 => U (j k)))) i
  let fI := θ.app (op (∏ᶜ fun k : Fin 1 => U (i k)))
  have hAL : (baseCechAugmentation p M U ≫ φ.f 0) ≫ qN =
      baseCechAugmentation p M U ≫ (φ.f 0 ≫ qN) := Category.assoc _ _ _
  have hAR : (baseSectionsMap p f ≫ baseCechAugmentation p N U) ≫ qN =
      baseSectionsMap p f ≫ (baseCechAugmentation p N U ≫ qN) := Category.assoc _ _ _
  have hAP : baseCechAugmentation p M U ≫ (qM ≫ fI) =
      (baseCechAugmentation p M U ≫ qM) ≫ fI := (Category.assoc _ _ _).symm
  change (baseCechAugmentation p M U ≫ φ.f 0) ≫ qN =
      (baseSectionsMap p f ≫ baseCechAugmentation p N U) ≫ qN
  rw [hAL,hAR,hn]
  erw [hAP,baseCechAugmentation_comp_π,baseCechAugmentation_comp_π]
  exact θ.naturality (homOfLE le_top).op

private theorem sections_surjective_of_homology_zero {Y S : Scheme.{u}} (p : Y ⟶ S)
    {ι : Type u} (U : ι → Y.Opens) (hU : IsOpenCover U) {M N : Y.Modules} (f : M ⟶ N)
    (hf : Function.Surjective
      (HomologicalComplex.homologyMap ((baseCechComplexFunctor p U).map f) 0)) :
    Function.Surjective (baseSectionsMap p f) := by
  let C := baseCechComplex p M U
  let Q := baseCechComplex p N U
  let φ : C ⟶ Q := (baseCechComplexFunctor p U).map f
  intro σ
  let y : Q.cycles 0 := (Q.liftCycles (baseCechAugmentation p N U) 1 (by simp)
    (baseCechAugmentation_comp_d p N U)) σ
  obtain ⟨x,hx⟩ := hf (Q.homologyπ 0 y)
  let c : C.cycles 0 := (C.isoHomologyπ₀).inv x
  have hc : HomologicalComplex.cyclesMap φ 0 c = y := by
    apply (ConcreteCategory.bijective_of_isIso (Q.homologyπ 0)).injective
    calc
      _ = HomologicalComplex.homologyMap φ 0 (C.homologyπ 0 c) :=
        (ConcreteCategory.congr_hom (HomologicalComplex.homologyπ_naturality φ 0) c).symm
      _ = HomologicalComplex.homologyMap φ 0 x :=
        congrArg (HomologicalComplex.homologyMap φ 0)
          ((C.isoHomologyπ₀).inv_hom_id_apply x)
      _ = _ := hx
  have haug := baseCechAugmentedShortComplex_exact p M U hU
  obtain ⟨s,hs⟩ := (ShortComplex.moduleCat_exact_iff _).mp haug (C.iCycles 0 c)
    (ConcreteCategory.congr_hom (C.iCycles_d 0 1) c)
  change baseCechAugmentation p M U s = C.iCycles 0 c at hs
  refine ⟨s,?_⟩
  apply (ModuleCat.mono_iff_injective (baseCechAugmentation p N U)).mp
    (baseCechAugmentation_mono p N U hU)
  calc
    baseCechAugmentation p N U (baseSectionsMap p f s) =
        φ.f 0 (baseCechAugmentation p M U s) :=
      (ConcreteCategory.congr_hom (augmentation_naturality p U f) s).symm
    _ = φ.f 0 (C.iCycles 0 c) := congrArg (φ.f 0) hs
    _ = Q.iCycles 0 (HomologicalComplex.cyclesMap φ 0 c) :=
      (ConcreteCategory.congr_hom (HomologicalComplex.cyclesMap_i φ 0) c).symm
    _ = Q.iCycles 0 y := congrArg (Q.iCycles 0) hc
    _ = _ := ConcreteCategory.congr_hom
      (Q.liftCycles_i (baseCechAugmentation p N U) 1 (by simp)
        (baseCechAugmentation_comp_d p N U)) σ

private theorem pullbackUnit_comp {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
    (M : Z.Modules) :
    (pullbackPushforwardAdjunction g).unit.app M ≫
      (pushforward g).map ((pullbackPushforwardAdjunction f).unit.app ((Scheme.Modules.pullback g).obj M)) ≫
      (pushforwardComp f g).hom.app ((Scheme.Modules.pullback f).obj ((Scheme.Modules.pullback g).obj M)) =
    (pullbackPushforwardAdjunction (f ≫ g)).unit.app M ≫
      (pushforward (f ≫ g)).map ((pullbackComp f g).inv.app M) := by
  have h := unit_conjugateEquiv
    ((pullbackPushforwardAdjunction g).comp (pullbackPushforwardAdjunction f))
    (pullbackPushforwardAdjunction (f ≫ g)) (pullbackComp f g).inv M
  rw [conjugateEquiv_pullbackComp_inv] at h
  simpa only [Adjunction.comp_unit_app,Functor.comp_obj,Category.assoc] using h

/-- The SAME original restriction morphism is the genuine adjunction unit. -/
def lineRestrictionMap {Y Z : Scheme.{u}} (j : Z ⟶ Y) (L : Y.Modules) :
    L ⟶ (pushforward j).obj ((Scheme.Modules.pullback j).obj L) :=
  (pullbackPushforwardAdjunction j).unit.app L

private theorem parameter_zero {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) :
    (zeroInclusion p).appTop (parameter p) = 0 := by
  exact (MorphismKernelIdealModuleComparison.isLocallyMem_iff_app_eq_zero
    (zeroInclusion p) ⊤ (parameter p)).mp
      (show (zeroInclusion p).ker.IsLocallyMem ⊤ (parameter p) from
        (show (zeroInclusion p).ker.toSubmodule.obj (op ⊤) from parameterIdealSection p).2)

private theorem scalarAction_zero {Y : Scheme.{u}} (L : Y.Modules) :
    SchemeUnitScalarAction.globalScalarAction L 0 = 0 := by
  apply Scheme.Modules.hom_ext
  intro U
  apply AddCommGrpCat.hom_ext
  ext x
  change (SchemeUnitScalarAction.globalScalarAction L 0).val.app (op U) x = 0
  rw [SchemeUnitScalarAction.globalScalarAction_apply,map_zero,zero_smul]
  rfl

private theorem scalarAction_naturality {Y : Scheme.{u}} {L M : Y.Modules}
    (a : Γ(Y,⊤)) (φ : L ⟶ M) :
    SchemeUnitScalarAction.globalScalarAction L a ≫ φ =
      φ ≫ SchemeUnitScalarAction.globalScalarAction M a := by
  apply Scheme.Modules.hom_ext
  intro U
  apply AddCommGrpCat.hom_ext
  ext x
  change φ.val.app (op U) ((SchemeUnitScalarAction.globalScalarAction L a).val.app (op U) x) =
    (SchemeUnitScalarAction.globalScalarAction M a).val.app (op U) (φ.val.app (op U) x)
  erw [SchemeUnitScalarAction.globalScalarAction_apply L a U x,
    SchemeUnitScalarAction.globalScalarAction_apply M a U (φ.val.app (op U) x)]
  exact (φ.val.app (op U)).hom.map_smul _ _

private theorem parameter_action_restriction_zero {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) (L : Y.Modules) :
    SchemeUnitScalarAction.globalScalarAction L (parameter p) ≫ lineRestrictionMap (zeroInclusion p) L = 0 := by
  have hn := (pullbackPushforwardAdjunction (zeroInclusion p)).unit.naturality
    (SchemeUnitScalarAction.globalScalarAction L (parameter p))
  change SchemeUnitScalarAction.globalScalarAction L (parameter p) ≫
      lineRestrictionMap (zeroInclusion p) L =
    lineRestrictionMap (zeroInclusion p) L ≫ (pushforward (zeroInclusion p)).map
      ((Scheme.Modules.pullback (zeroInclusion p)).map
        (SchemeUnitScalarAction.globalScalarAction L (parameter p))) at hn
  rw [SchemeUnitScalarActionBaseChange.globalScalarAction_pullback,parameter_zero,
    scalarAction_zero,Functor.map_zero,comp_zero] at hn
  exact hn

/-- This complex uses the SAME original parameter action and SAME original restriction unit. -/
def parameterSequence {k : Type u} [Field k] {Y : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) (L : Y.Modules) : ShortComplex Y.Modules :=
  ShortComplex.mk (SchemeUnitScalarAction.globalScalarAction L (parameter p))
    (lineRestrictionMap (zeroInclusion p) L) (parameter_action_restriction_zero p L)

private theorem openUnit_comparison {Y Z : Scheme.{u}} (u : Z ⟶ Y) [IsOpenImmersion u]
    (L : Y.Modules) :
    (restrictAdjunction u).unit.app L ≫
      (pushforward u).map ((restrictFunctorIsoPullback u).hom.app L) =
    (pullbackPushforwardAdjunction u).unit.app L :=
  Adjunction.unit_leftAdjointUniq_hom_app (restrictAdjunction u)
    (pullbackPushforwardAdjunction u) L

attribute [local instance] Scheme.Modules.monoidalCategory

/-- The original line's actual parameter action is a monomorphism, derived by exact tensoring. -/
theorem parameterSequence_mono_f {k : Type u} [Field k] {Y : Scheme.{u}} [IsIntegral Y]
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) [IsDominant p] [QuasiCompact p]
    (L : Y.Modules) (hL : IsInvertible L) : Mono (parameterSequence p L).f := by
  let : (tensorRight L).IsEquivalence := SchemeInvertibleTensorEquivalence.tensorRight_isEquivalence L hL
  let : Mono (ModularCurves.idealModuleToUnit (zeroInclusion p)) :=
    (FiniteClosedIdealEuler.sequence_shortExact (zeroInclusion p)).mono_f
  let : Mono (ModularCurves.idealModuleToUnit (zeroInclusion p) ▷ L) := by
    change Mono ((tensorRight L).map (ModularCurves.idealModuleToUnit (zeroInclusion p)))
    infer_instance
  change Mono ((SchemeTensorUnitSections.leftUnitIso L).inv ≫
    (SchemeModuleGlobalSections.sectionHom (unitObj Y) (parameter p)) ▷ L ≫
      (SchemeTensorUnitSections.leftUnitIso L).hom)
  rw [← parameterIdealIso_inclusion p]
  simp only [comp_whiskerRight,Category.assoc]
  infer_instance

private theorem unit_structure_map {Y Z : Scheme.{u}} (j : Z ⟶ Y) :
    lineRestrictionMap j (unitObj Y) ≫ (pushforward j).map (pullbackUnitIso j).hom =
      FiniteClosedIdealEuler.quotientMap j := by
  have h := pullbackUnitIso_hom_homEquiv j
  rw [Adjunction.homEquiv_unit] at h
  exact h

private theorem scalarAction_unit {Y : Scheme.{u}} (a : Γ(Y,⊤)) :
    SchemeUnitScalarAction.globalScalarAction (unitObj Y) a =
      SchemeModuleGlobalSections.sectionHom (unitObj Y) a := by
  apply Scheme.Modules.hom_ext
  intro U
  apply AddCommGrpCat.hom_ext
  ext x
  let xR : Γ(Y,U) := x
  have h := SchemeUnitScalarAction.globalScalarAction_apply (unitObj Y) a U xR
  change (SchemeUnitScalarAction.globalScalarAction (unitObj Y) a).val.app (op U) xR =
    xR * Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op a
  exact h.trans (mul_comm _ xR)

private theorem parameterSequence_unit_shortExact {k : Type u} [Field k]
    {Y : Scheme.{u}} [IsIntegral Y] (p : Y ⟶ Spec (CommRingCat.of (Polynomial k)))
    [IsDominant p] [QuasiCompact p] : (parameterSequence p (unitObj Y)).ShortExact := by
  let j := zeroInclusion p
  let eQ := (pushforward j).mapIso (pullbackUnitIso j)
  let e : parameterSequence p (unitObj Y) ≅ FiniteClosedIdealEuler.sequence j :=
    ShortComplex.isoMk (parameterIdealIso p) (Iso.refl _) eQ
      (by
        change (parameterIdealIso p).hom ≫ ModularCurves.idealModuleToUnit j =
          SchemeUnitScalarAction.globalScalarAction (unitObj Y) (parameter p) ≫ 𝟙 _
        rw [Category.comp_id,scalarAction_unit]
        exact parameterIdealIso_inclusion p)
      (by
        change (𝟙 _) ≫ FiniteClosedIdealEuler.quotientMap j =
          lineRestrictionMap j (unitObj Y) ≫ (pushforward j).map (pullbackUnitIso j).hom
        rw [Category.id_comp]
        exact (unit_structure_map j).symm)
  exact ShortComplex.shortExact_of_iso e.symm (FiniteClosedIdealEuler.sequence_shortExact j)

private theorem parameterSequence_shortExact_of_iso_unit {k : Type u} [Field k]
    {Y : Scheme.{u}} [IsIntegral Y] (p : Y ⟶ Spec (CommRingCat.of (Polynomial k)))
    [IsDominant p] [QuasiCompact p] (L : Y.Modules) (e : L ≅ unitObj Y) :
    (parameterSequence p L).ShortExact := by
  let j := zeroInclusion p
  let eQ := (pushforward j).mapIso ((Scheme.Modules.pullback j).mapIso e)
  let E : parameterSequence p L ≅ parameterSequence p (unitObj Y) :=
    ShortComplex.isoMk e e eQ
      (scalarAction_naturality (parameter p) e.hom).symm
      ((pullbackPushforwardAdjunction j).unit.naturality e.hom)
  exact ShortComplex.shortExact_of_iso E.symm (parameterSequence_unit_shortExact p)

private def zeroFiberMap {k : Type u} [Field k] {Y T : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) (u : T ⟶ Y) :
    zeroFiber (u ≫ p) ⟶ zeroFiber p :=
  pullback.lift (zeroInclusion (u ≫ p) ≫ u) (pullback.snd (u ≫ p) (zeroMap k))
    (by simpa only [Category.assoc] using pullback.condition (f := u ≫ p) (g := zeroMap k))

private theorem zeroFiberMap_isPullback {k : Type u} [Field k] {Y T : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) (u : T ⟶ Y) :
    IsPullback (zeroInclusion (u ≫ p)) (zeroFiberMap p u) u (zeroInclusion p) := by
  have h : IsPullback (zeroFiberMap p u ≫ pullback.snd p (zeroMap k))
      (zeroInclusion (u ≫ p)) (zeroMap k) (u ≫ p) := by
    simpa only [zeroFiberMap,pullback.lift_snd] using (IsPullback.of_hasPullback (u ≫ p) (zeroMap k)).flip
  exact (h.of_right (by simp only [zeroFiberMap,zeroInclusion,pullback.lift_fst]) (IsPullback.of_hasPullback p (zeroMap k)).flip).flip

private theorem zeroFiberMap_open {k : Type u} [Field k] {Y T : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) (u : T ⟶ Y) [IsOpenImmersion u] :
    IsOpenImmersion (zeroFiberMap p u) :=
  MorphismProperty.of_isPullback (zeroFiberMap_isPullback p u) inferInstance

private def leftIsoOfRightIso {A B : Type*} [Category A] [Category B]
    {F₁ F₂ : A ⥤ B} {G₁ G₂ : B ⥤ A} (adj₁ : F₁ ⊣ G₁) (adj₂ : F₂ ⊣ G₂)
    (e : G₁ ≅ G₂) : F₁ ≅ F₂ :=
  adj₁.leftAdjointUniq (adj₂.ofNatIsoRight e.symm)

private theorem unit_leftIsoOfRightIso {A B : Type*} [Category A] [Category B]
    {F₁ F₂ : A ⥤ B} {G₁ G₂ : B ⥤ A} (adj₁ : F₁ ⊣ G₁) (adj₂ : F₂ ⊣ G₂)
    (e : G₁ ≅ G₂) (X : A) :
    adj₁.unit.app X ≫ e.hom.app (F₁.obj X) ≫
      G₂.map ((leftIsoOfRightIso adj₁ adj₂ e).hom.app X) = adj₂.unit.app X := by
  let adj₂' := adj₂.ofNatIsoRight e.symm
  have hu : adj₂'.unit.app X = adj₂.unit.app X ≫ e.inv.app (F₂.obj X) := by
    simpa only [adj₂',Adjunction.homEquiv_id,Iso.symm_hom] using
      (Adjunction.homEquiv_ofNatIsoRight_apply adj₂ e.symm (𝟙 (F₂.obj X)))
  have h := Adjunction.unit_leftAdjointUniq_hom_app adj₁ adj₂' X
  have h' := congrArg (fun q => q ≫ e.hom.app (F₂.obj X)) h
  simp only [hu,Category.assoc,Iso.inv_hom_id_app] at h'
  change adj₁.unit.app X ≫ G₁.map ((leftIsoOfRightIso adj₁ adj₂ e).hom.app X) ≫
    e.hom.app (F₂.obj X) = adj₂.unit.app X ≫ 𝟙 _ at h'
  rw [← e.hom.naturality]
  exact h'.trans (Category.comp_id _)

private def pushforwardSquareIso {X Y U V : Scheme.{u}}
    (f : X ⟶ Y) (f' : U ⟶ V) (iU : U ⟶ X) (iV : V ⟶ Y)
    (H : IsPullback f' iU iV f) :
    pushforward f' ⋙ pushforward iV ≅ pushforward iU ⋙ pushforward f :=
  pushforwardComp f' iV ≪≫ pushforwardCongr H.w ≪≫ (pushforwardComp iU f).symm

private theorem restrict_unit_square {X Y U V : Scheme.{u}}
    (f : X ⟶ Y) (f' : U ⟶ V) (iU : U ⟶ X) (iV : V ⟶ Y)
    [IsOpenImmersion iV] [IsOpenImmersion iU]
    (H : IsPullback f' iU iV f) (M : X.Modules) :
    (restrictAdjunction iV).unit.app ((pushforward f).obj M) ≫
      (pushforward iV).map ((restrictPushforwardIsoOfIsPullback f f' iU iV H).hom.app M) =
    (pushforward f).map ((restrictAdjunction iU).unit.app M) ≫
      (pushforwardSquareIso f f' iU iV H).inv.app ((restrictFunctor iU).obj M) := by
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro W
  apply ModuleCat.hom_ext
  ext x
  let h := IsOpenImmersion.image_preimage_eq_preimage_image_of_isPullback H
    (iV ⁻¹ᵁ W.unop)
  change M.presheaf.map _ (M.presheaf.map _ x) =
    M.presheaf.map _ (M.presheaf.map _ x)
  erw [← Functor.map_comp_apply,← Functor.map_comp_apply]
  exact ConcreteCategory.congr_hom (M.presheaf.congr_map (Subsingleton.elim _ _)) x

private def pullbackPushforwardOpenSquareApp {X Y U V : Scheme.{u}}
    (f : X ⟶ Y) (f' : U ⟶ V) (iU : U ⟶ X) (iV : V ⟶ Y)
    [IsOpenImmersion iV] [IsOpenImmersion iU]
    (H : IsPullback f' iU iV f) (M : X.Modules) :
    (Scheme.Modules.pullback iV).obj ((pushforward f).obj M) ≅
      (pushforward f').obj ((Scheme.Modules.pullback iU).obj M) :=
  ((restrictFunctorIsoPullback iV).symm.app ((pushforward f).obj M)) ≪≫
    (restrictPushforwardIsoOfIsPullback f f' iU iV H).app M ≪≫
    (pushforward f').mapIso ((restrictFunctorIsoPullback iU).app M)

private theorem pullback_open_unit_square {X Y U V : Scheme.{u}}
    (f : X ⟶ Y) (f' : U ⟶ V) (iU : U ⟶ X) (iV : V ⟶ Y)
    [IsOpenImmersion iV] [IsOpenImmersion iU]
    (H : IsPullback f' iU iV f) (M : X.Modules) :
    (pullbackPushforwardAdjunction iV).unit.app ((pushforward f).obj M) ≫
      (pushforward iV).map (pullbackPushforwardOpenSquareApp f f' iU iV H M).hom =
    (pushforward f).map ((pullbackPushforwardAdjunction iU).unit.app M) ≫
      (pushforwardSquareIso f f' iU iV H).inv.app ((Scheme.Modules.pullback iU).obj M) := by
  let C := restrictFunctorIsoPullback iV
  let D := restrictFunctorIsoPullback iU
  let R := pushforwardSquareIso f f' iU iV H
  let δ := restrictPushforwardIsoOfIsPullback f f' iU iV H
  have h := restrict_unit_square f f' iU iV H M
  have hn := (R.inv.naturality (D.hom.app M)).symm
  change R.inv.app ((restrictFunctor iU).obj M) ≫
      (pushforward iV).map ((pushforward f').map (D.hom.app M)) =
    (pushforward f).map ((pushforward iU).map (D.hom.app M)) ≫
      R.inv.app ((Scheme.Modules.pullback iU).obj M) at hn
  rw [← openUnit_comparison iV ((pushforward f).obj M),
    ← openUnit_comparison iU M]
  simp only [pullbackPushforwardOpenSquareApp,Iso.trans_hom,Iso.symm_hom,
    Iso.app_hom,Functor.mapIso_hom,Functor.map_comp,Category.assoc]
  simp only [← Functor.map_comp]
  rw [Iso.hom_inv_id_app_assoc]
  simp only [Functor.map_comp]
  rw [← Category.assoc,h,Category.assoc,hn]

private theorem unit_leftIsoOfRightIso_inv {A B : Type*} [Category A] [Category B]
    {F₁ F₂ : A ⥤ B} {G₁ G₂ : B ⥤ A} (adj₁ : F₁ ⊣ G₁) (adj₂ : F₂ ⊣ G₂)
    (e : G₁ ≅ G₂) (X : A) :
    adj₁.unit.app X ≫ G₁.map ((leftIsoOfRightIso adj₁ adj₂ e).hom.app X) =
      adj₂.unit.app X ≫ e.inv.app (F₂.obj X) := by
  apply (cancel_mono (e.hom.app (F₂.obj X))).mp
  simp only [Category.assoc,Iso.inv_hom_id_app]
  rw [e.hom.naturality,unit_leftIsoOfRightIso]
  exact (Category.comp_id _).symm

private def pullbackSquareIso {X Y U V : Scheme.{u}}
    (f : X ⟶ Y) (f' : U ⟶ V) (iU : U ⟶ X) (iV : V ⟶ Y)
    (H : IsPullback f' iU iV f) :
    Scheme.Modules.pullback iV ⋙ Scheme.Modules.pullback f' ≅
      Scheme.Modules.pullback f ⋙ Scheme.Modules.pullback iU :=
  leftIsoOfRightIso
    ((pullbackPushforwardAdjunction iV).comp (pullbackPushforwardAdjunction f'))
    ((pullbackPushforwardAdjunction f).comp (pullbackPushforwardAdjunction iU))
    (pushforwardSquareIso f f' iU iV H)

private theorem pullback_closed_unit_square {X Y U V : Scheme.{u}}
    (f : X ⟶ Y) (f' : U ⟶ V) (iU : U ⟶ X) (iV : V ⟶ Y)
    [IsOpenImmersion iV] [IsOpenImmersion iU]
    (H : IsPullback f' iU iV f) (L : Y.Modules) :
    (Scheme.Modules.pullback iV).map (lineRestrictionMap f L) ≫
      (pullbackPushforwardOpenSquareApp f f' iU iV H
        ((Scheme.Modules.pullback f).obj L)).hom =
    lineRestrictionMap f' ((Scheme.Modules.pullback iV).obj L) ≫
      (pushforward f').map ((pullbackSquareIso f f' iU iV H).hom.app L) := by
  apply ((pullbackPushforwardAdjunction iV).homEquiv _ _).injective
  simp only [Adjunction.homEquiv_unit,Functor.map_comp]
  have hn := (pullbackPushforwardAdjunction iV).unit.naturality (lineRestrictionMap f L)
  simp only [Functor.id_map,Functor.comp_map] at hn
  rw [← Category.assoc,← hn,Category.assoc,pullback_open_unit_square]
  simpa only [Adjunction.comp_unit_app,Functor.comp_obj,Functor.comp_map,
    Category.assoc,pullbackSquareIso,lineRestrictionMap] using
    (unit_leftIsoOfRightIso_inv
      ((pullbackPushforwardAdjunction iV).comp (pullbackPushforwardAdjunction f'))
      ((pullbackPushforwardAdjunction f).comp (pullbackPushforwardAdjunction iU))
      (pushforwardSquareIso f f' iU iV H) L).symm

private theorem parameter_pullback {k : Type u} [Field k] {Y T : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) (u : T ⟶ Y) :
    parameter (u ≫ p) = u.appTop (parameter p) := by
  have hu : u.appLE ⊤ ⊤ le_top = u.appTop := by
    change u.appTop ≫ T.presheaf.map (homOfLE le_rfl).op = u.appTop
    simp only [homOfLE_refl,op_id,CategoryTheory.Functor.map_id,Category.comp_id]
  have h := ConcreteCategory.congr_hom
    (Scheme.Hom.appLE_comp_appLE u p ⊤ ⊤ ⊤ le_top le_top)
    ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv Polynomial.X)
  rw [hu] at h
  exact h.symm

private def parameterSequence_openIso {k : Type u} [Field k] {Y T : Scheme.{u}}
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) (u : T ⟶ Y) [IsOpenImmersion u]
    (L : Y.Modules) :
    (parameterSequence p L).map (Scheme.Modules.pullback u) ≅
      parameterSequence (u ≫ p) ((Scheme.Modules.pullback u).obj L) := by
  let j := zeroInclusion p
  let j' := zeroInclusion (u ≫ p)
  let v := zeroFiberMap p u
  let : IsOpenImmersion v := zeroFiberMap_open p u
  let H := zeroFiberMap_isPullback p u
  let θ := (pullbackSquareIso j j' v u H).app L
  let β := pullbackPushforwardOpenSquareApp j j' v u H ((Scheme.Modules.pullback j).obj L)
  let eQ := β ≪≫ (pushforward j').mapIso θ.symm
  refine ShortComplex.isoMk (Iso.refl _) (Iso.refl _) eQ ?_ ?_
  · change (𝟙 _) ≫ SchemeUnitScalarAction.globalScalarAction _ (parameter (u ≫ p)) =
      (Scheme.Modules.pullback u).map
        (SchemeUnitScalarAction.globalScalarAction L (parameter p)) ≫ 𝟙 _
    rw [Category.id_comp,Category.comp_id,
      SchemeUnitScalarActionBaseChange.globalScalarAction_pullback,parameter_pullback]
  · have hθ : (pullbackSquareIso j j' v u H).hom.app L ≫ θ.inv = 𝟙 _ :=
      θ.hom_inv_id
    change (𝟙 _) ≫ lineRestrictionMap j' _ =
      (Scheme.Modules.pullback u).map (lineRestrictionMap j L) ≫
        β.hom ≫ (pushforward j').map θ.inv
    rw [Category.id_comp,← Category.assoc,pullback_closed_unit_square,Category.assoc,
      ← Functor.map_comp,hθ]
    erw [CategoryTheory.Functor.map_id]
    exact (Category.comp_id _).symm

private theorem exact_of_open_cover {Y : Scheme.{u}} {ι : Type u}
    (T : ι → Scheme.{u}) (u : (i : ι) → T i ⟶ Y) [∀ i, IsOpenImmersion (u i)]
    (hcover : ∀ y : Y, ∃ (i : ι) (x : T i), u i x = y)
    (S : ShortComplex Y.Modules)
    (hS : ∀ i, (S.map (Scheme.Modules.pullback (u i))).Exact) : S.Exact := by
  apply S.exact_iff_isZero_homology.mpr
  apply (IsZero.iff_id_eq_zero _).mpr
  apply (SchemeModuleOpenCoverDetection.eq_zero_iff T u hcover _).mpr
  intro i
  let F := Scheme.Modules.pullback (u i)
  let : PreservesLimits (restrictFunctor (u i)) := restrictFunctor_preservesLimits (u i)
  let : PreservesLimits F := preservesLimits_of_natIso (restrictFunctorIsoPullback (u i))
  have hz : IsZero (F.obj S.homology) := IsZero.of_iso
    ((S.map F).exact_iff_isZero_homology.mp (hS i)) (S.mapHomologyIso F).symm
  rw [CategoryTheory.Functor.map_id]
  exact hz.eq_zero_of_src _

private theorem epi_of_open_cover {Y : Scheme.{u}} {ι : Type u}
    (T : ι → Scheme.{u}) (u : (i : ι) → T i ⟶ Y) [∀ i, IsOpenImmersion (u i)]
    (hcover : ∀ y : Y, ∃ (i : ι) (x : T i), u i x = y)
    {M N : Y.Modules} (f : M ⟶ N)
    (hf : ∀ i, Epi ((Scheme.Modules.pullback (u i)).map f)) : Epi f := by
  constructor
  intro Z a b hab
  apply SchemeModuleOpenCoverDetection.hom_ext T u hcover
  intro i
  let F := Scheme.Modules.pullback (u i)
  let : Epi (F.map f) := hf i
  apply (cancel_epi (F.map f)).mp
  simpa only [Functor.map_comp] using congrArg (fun q => F.map q) hab

/-- EVERY actual invertible line has the SAME original parameter short exact sequence.
The actual local frames and all original-unit comparisons are derived internally. -/
theorem parameterSequence_shortExact {k : Type u} [Field k] {Y : Scheme.{u}} [IsIntegral Y]
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) [IsDominant p] [QuasiCompact p]
    (L : Y.Modules) (hL : IsInvertible L) : (parameterSequence p L).ShortExact := by
  classical
  obtain ⟨ι,U,hU,e⟩ := SchemeInvertibleTensorQuasicoherent.exists_affine_trivializing_cover L hL
  let κ := { i : ι // Nonempty (U i).1 }
  let T : κ → Scheme.{u} := fun i => (U i.1).1.toScheme
  let u : (i : κ) → T i ⟶ Y := fun i => (U i.1).1.ι
  have hcover : ∀ y : Y, ∃ (i : κ) (x : T i), u i x = y := by
    intro y
    have hy : y ∈ ⨆ i, (U i).1 := by rw [hU]; trivial
    obtain ⟨i,hi⟩ := Opens.mem_iSup.mp hy
    exact ⟨⟨i,⟨⟨y,hi⟩⟩⟩,⟨y,hi⟩,rfl⟩
  have hlocal (i : κ) : ((parameterSequence p L).map (Scheme.Modules.pullback (u i))).ShortExact := by
    let : Nonempty (T i) := i.2
    let : IsIntegral (T i) := isIntegral_of_isOpenImmersion (u i)
    have hne : ((U i.1).1 : Set Y).Nonempty := by
      obtain ⟨x⟩ := i.2
      exact ⟨x.1,x.2⟩
    let : IsDominant (u i) := AlgebraicGeometry.Opens.isDominant_ι ((U i.1).1.isOpen.dense hne)
    let : IsAffine (T i) := (U i.1).2
    let : QuasiCompact (u i ≫ p) := inferInstance
    let eL : (Scheme.Modules.pullback (u i)).obj L ≅ unitObj (T i) :=
      (restrictFunctorIsoPullback (u i)).symm.app L ≪≫ (e i.1).some
    exact ShortComplex.shortExact_of_iso (parameterSequence_openIso p (u i) L).symm
      (parameterSequence_shortExact_of_iso_unit (u i ≫ p) _ eL)
  let : Mono (parameterSequence p L).f := parameterSequence_mono_f p L hL
  let : Epi (parameterSequence p L).g :=
    epi_of_open_cover T u hcover _ (fun i => (hlocal i).epi_g)
  exact ShortComplex.ShortExact.mk
    (exact_of_open_cover T u hcover _ (fun i => (hlocal i).exact))

private def baseCechObjectPushforwardIso {X Y B : Scheme.{u}}
    (f : X ⟶ Y) (p : Y ⟶ B) (M : X.Modules)
    {ι : Type u} (U : ι → Y.Opens) (n : ℕ) :
    (baseCechComplex (f ≫ p) M (fun i => f ⁻¹ᵁ U i)).X n ≅
      (baseCechComplex p ((pushforward f).obj M) U).X n :=
  Pi.mapIso (fun i : Fin (n+1) → ι => baseCechFactorPushforwardIso f p M U n i)

private theorem baseCechObjectPushforwardIso_coface {X Y B : Scheme.{u}}
    (f : X ⟶ Y) (p : Y ⟶ B) (M : X.Modules)
    {ι : Type u} (U : ι → Y.Opens) (n : ℕ) (k : Fin (n+2)) :
    (baseCechObjectPushforwardIso f p M U n).hom ≫
      baseCechCoface p ((pushforward f).obj M) U n k =
    baseCechCoface (f ≫ p) M (fun i => f ⁻¹ᵁ U i) n k ≫
      (baseCechObjectPushforwardIso f p M U (n+1)).hom := by
  let A := baseCechComplex (f ≫ p) M (fun i => f ⁻¹ᵁ U i)
  let B' := baseCechComplex p ((pushforward f).obj M) U
  let E₀ := baseCechObjectPushforwardIso f p M U n
  let E₁ := baseCechObjectPushforwardIso f p M U (n+1)
  let φA : A.X n ⟶ A.X (n+1) := baseCechCoface (f ≫ p) M (fun i => f ⁻¹ᵁ U i) n k
  let φB : B'.X n ⟶ B'.X (n+1) := baseCechCoface p ((pushforward f).obj M) U n k
  apply Pi.hom_ext (f := fun i : Fin (n+2) → ι => baseCechFactor p ((pushforward f).obj M) U (n+1) i)
  intro i
  let δ := (SimplexCategory.δ k).toOrderHom.toFun
  let qAL : A.X n ⟶ baseCechFactor (f ≫ p) M (fun j => f ⁻¹ᵁ U j) n (i ∘ δ) := Pi.π _ (i ∘ δ)
  let qBL : B'.X n ⟶ baseCechFactor p ((pushforward f).obj M) U n (i ∘ δ) := Pi.π _ (i ∘ δ)
  let qAH : A.X (n+1) ⟶ baseCechFactor (f ≫ p) M (fun j => f ⁻¹ᵁ U j) (n+1) i := Pi.π _ i
  let qBH : B'.X (n+1) ⟶ baseCechFactor p ((pushforward f).obj M) U (n+1) i := Pi.π _ i
  let eL := baseCechFactorPushforwardIso f p M U n (i ∘ δ)
  let eH := baseCechFactorPushforwardIso f p M U (n+1) i
  let rA := (baseModulePresheaf (f ≫ p) M).map
    (((FormalCoproduct.mk _ (fun j => f ⁻¹ᵁ U j)).mapPower δ).φ i).op
  let rB := (baseModulePresheaf p ((pushforward f).obj M)).map
    (((FormalCoproduct.mk _ U).mapPower δ).φ i).op
  have heL : E₀.hom ≫ qBL = qAL ≫ eL.hom := Pi.mapIso_hom_π _ _
  have heH : E₁.hom ≫ qBH = qAH ≫ eH.hom := Pi.mapIso_hom_π _ _
  have hfA : φA ≫ qAH = qAL ≫ rA := baseCechCoface_comp_π _ _ _ _ _ _
  have hfB : φB ≫ qBH = qBL ≫ rB := baseCechCoface_comp_π _ _ _ _ _ _
  have hn : rA ≫ eH.hom = eL.hom ≫ rB := baseCechFactorPushforwardIso_naturality f p M U n k i
  change (E₀.hom ≫ φB) ≫ qBH = (φA ≫ E₁.hom) ≫ qBH
  have hAL : (E₀.hom ≫ φB) ≫ qBH = E₀.hom ≫ (φB ≫ qBH) := Category.assoc _ _ _
  have hAR : (φA ≫ E₁.hom) ≫ qBH = φA ≫ (E₁.hom ≫ qBH) := Category.assoc _ _ _
  have hPL : E₀.hom ≫ (qBL ≫ rB) = (E₀.hom ≫ qBL) ≫ rB := (Category.assoc _ _ _).symm
  have hPR : φA ≫ (qAH ≫ eH.hom) = (φA ≫ qAH) ≫ eH.hom := (Category.assoc _ _ _).symm
  rw [hAL,hAR,hfB,heH]
  erw [hPL,hPR,heL,hfA]
  exact (Category.assoc _ _ _).trans (congrArg (fun q => qAL ≫ q) hn.symm) |>.trans (Category.assoc _ _ _).symm

private def baseCechComplexPushforwardIso {X Y B : Scheme.{u}}
    (f : X ⟶ Y) (p : Y ⟶ B) (M : X.Modules)
    {ι : Type u} (U : ι → Y.Opens) :
    baseCechComplex (f ≫ p) M (fun i => f ⁻¹ᵁ U i) ≅
      baseCechComplex p ((pushforward f).obj M) U := by
  refine HomologicalComplex.Hom.isoOfComponents
    (fun n => baseCechObjectPushforwardIso f p M U n) ?_
  intro i j hij
  simp only [ComplexShape.up_Rel] at hij
  subst j
  rw [baseCechComplex_d_eq_sum_cofaces,baseCechComplex_d_eq_sum_cofaces]
  simp only [Preadditive.comp_sum,Preadditive.sum_comp,
    Preadditive.comp_zsmul,Preadditive.zsmul_comp]
  apply Finset.sum_congr rfl
  intro k _
  exact congrArg ((-1 : ℤ) ^ (k : ℕ) • ·)
    (baseCechObjectPushforwardIso_coface f p M U i k)

/-- The actual self-sequence has no H0 obstruction when its ACTUAL right Cech H1 vanishes.
Projective finiteness, original short exactness and the LES are derived internally. -/
theorem sections_surjective_of_self_sequence {k : Type u} [Field k]
    {Y : Scheme.{u}} [IsIntegral Y]
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) [IsDominant p]
    (hp : IsProjectiveFactorization p) (L : Y.Modules) (hL : IsInvertible L)
    {ι : Type u} [Finite ι] (U : ι → Y.Opens) (hU : IsOpenCover U)
    (hUa : ∀ i, IsAffineOpen (U i))
    (hQ : IsZero ((baseCechComplex p
      ((pushforward (zeroInclusion p)).obj ((Scheme.Modules.pullback (zeroInclusion p)).obj L)) U).homology 1)) :
    Function.Surjective (baseSectionsMap p (lineRestrictionMap (zeroInclusion p) L)) := by
  let : IsProper p := hp.isProper
  let : Y.IsSeparated := ⟨by rw [← terminal.comp_from p]; infer_instance⟩
  let j := zeroInclusion p
  let M := (Scheme.Modules.pullback j).obj L
  let Q := (pushforward j).obj M
  let : L.IsQuasicoherent := hL.isQuasicoherent
  let : M.IsQuasicoherent := (hL.pullback j).isQuasicoherent
  let : Q.IsQuasicoherent := isQuasicoherent_pushforward_of_isAffineHom j
  let S := parameterSequence p L
  let F := baseCechComplexFunctor p U
  let : S.X₁.IsQuasicoherent := by change L.IsQuasicoherent; infer_instance
  let : S.X₂.IsQuasicoherent := by change L.IsQuasicoherent; infer_instance
  let : S.X₃.IsQuasicoherent := by change Q.IsQuasicoherent; infer_instance
  let : IsNoetherianRing Γ(Spec (CommRingCat.of (Polynomial k)),⊤) :=
    IsLocallyNoetherian.component_noetherian ⟨⊤,isAffineOpen_top _⟩
  have hS : (S.map F).ShortExact :=
    (parameterSequence_shortExact p L hL).map_baseCechComplexFunctor_of_affine_openCover p U hUa
  let : Module.Finite Γ(Spec (CommRingCat.of (Polynomial k)),⊤)
      ((S.map F).X₁.homology 1) := by
    change Module.Finite Γ(Spec (CommRingCat.of (Polynomial k)),⊤)
      ((baseCechComplex p L U).homology 1)
    exact baseCech_hone_finite p hp L hL U hU hUa
  apply sections_surjective_of_homology_zero p U hU
  exact homology_zero_surjective_of_self (S.map F).f (S.map F).g (S.map F).zero hS hQ

/-- Every prescribed section of the SAME actual zero-fibre line lifts to the SAME original L.
The only vanishing input is genuine ordinary H1 of that actual fibre line; Y0 may be nonreduced. -/
theorem restriction_surjective_of_hone_zero {k : Type u} [Field k]
    {Y : Scheme.{u}} [IsIntegral Y]
    (p : Y ⟶ Spec (CommRingCat.of (Polynomial k))) [IsDominant p]
    (hp : IsProjectiveFactorization p) (L : Y.Modules) (hL : IsInvertible L)
    (h0 : Subsingleton (CategoryTheory.Sheaf.H
      ((Scheme.Modules.pullback (zeroInclusion p)).obj L).sheaf 1)) :
    Function.Surjective (affinePullbackUnitTop (zeroInclusion p) L) := by
  classical
  let : IsProper p := hp.isProper
  let : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace p
  obtain ⟨s,hs,he⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp
    (show IsCompact ((⊤ : Y.Opens) : Set Y) from isCompact_univ)
  let ι := s
  let : Finite ι := hs.to_subtype
  let U : ι → Y.Opens := fun i => i.1.1
  have hU : IsOpenCover U := by
    change (⨆ i : s, i.1.1) = ⊤
    simpa only [iSup_subtype] using he.symm
  have hUa (i : ι) : IsAffineOpen (U i) := i.1.2
  let j := zeroInclusion p
  let M := (Scheme.Modules.pullback j).obj L
  let : M.IsQuasicoherent := (hL.pullback j).isQuasicoherent
  have hU0 : IsOpenCover (fun i => j ⁻¹ᵁ U i) := by
    apply le_antisymm le_top
    intro x _
    have hx : j x ∈ ⨆ i, U i := by rw [hU]; trivial
    obtain ⟨i,hi⟩ := Opens.mem_iSup.mp hx
    exact Opens.mem_iSup.mpr ⟨i,hi⟩
  have hC := (baseCechComplex_exactAt_one_iff_subsingleton_H
    (j ≫ p) M (fun i => j ⁻¹ᵁ U i) hU0 (fun i => (hUa i).preimage j)).mpr h0
  have hQ : IsZero ((baseCechComplex p ((pushforward j).obj M) U).homology 1) :=
    IsZero.of_iso hC.isZero_homology
      (HomologicalComplex.homologyMapIso (baseCechComplexPushforwardIso j p M U) 1).symm
  have hsurj := sections_surjective_of_self_sequence p hp L hL U hU hUa hQ
  intro σ
  let σ' : baseSections p ((pushforward j).obj M) := (baseSectionsPushforwardIso j p M).hom σ
  obtain ⟨τ,hτ⟩ := hsurj σ'
  refine ⟨τ,?_⟩
  have h : (baseSectionsPushforwardIso j p M).inv
      (baseSectionsMap p (lineRestrictionMap j L) τ) = σ := by
    rw [hτ]
    exact (baseSectionsPushforwardIso j p M).hom_inv_id_apply σ
  exact h

end EnvelopeProperty.ProjectiveCentralFiberSectionLifting
