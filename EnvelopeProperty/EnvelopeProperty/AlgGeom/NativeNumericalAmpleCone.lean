import EnvelopeProperty.AlgGeom.NativeNumericalAmpleDomination

/-! # Intrinsic actual ample cone and openness in every finite original line family -/

open AlgebraicGeometry CategoryTheory
open Scheme.Modules
noncomputable section
universe u v
namespace EnvelopeProperty.NativeRealNumericalClasses
variable {k : Type u} [Field k] {X : Scheme.{u}} (p : X ⟶ Spec (.of k)) [IsProjective p]

/-- The convex cone generated by SAME original actual geometrically ample line classes. -/
def ampleCone : ConvexCone ℝ (Space p) :=
  ConvexCone.hull ℝ {θ | ∃ L : X.Modules, ∃ hA : SchemeLineAmpleness.IsAmple p L,
    θ = lineClass p L hA.isInvertible}

/-- Every original geometric ample line gives an actual generator of the intrinsic ample cone. -/
theorem ampleLineClass_mem_ampleCone (L : X.Modules) (hA : SchemeLineAmpleness.IsAmple p L) :
    lineClass p L hA.isInvertible ∈ ampleCone p :=
  ConvexCone.subset_hull ⟨L, hA, rfl⟩

/-- The ENTIRE intrinsic ample cone satisfies all genuine original closed-curve nef inequalities. -/
theorem ampleCone_le_nefCone : ampleCone p ≤ nefCone p := by
  apply ConvexCone.hull_min
  rintro θ ⟨L, hA, rfl⟩
  exact ampleLineClass_mem_nefCone p L hA

private theorem add_sum_mem_cone {M : Type*} [AddCommMonoid M] [Module ℝ M]
    (C : ConvexCone ℝ M) {x : M} (hx : x ∈ C) {ι : Type*} (s : Finset ι)
    (y : ι → M) (hy : ∀ i ∈ s, y i ∈ C) : x + ∑ i ∈ s, y i ∈ C := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using hx
  | @insert i s hi ih =>
    rw [Finset.sum_insert hi]
    simpa only [add_assoc, add_left_comm, add_comm] using
      C.add_mem (ih (fun j hj => hy j (Finset.mem_insert_of_mem hj)))
        (hy i (Finset.mem_insert_self i s))

private theorem small_perturbation_mem_cone {M : Type*} [AddCommGroup M] [Module ℝ M]
    {ι : Type*} [Fintype ι] (C : ConvexCone ℝ M) (x : M) (v : ι → M)
    (hx : x ∈ C) (m : ℝ) (hm : 0 < m)
    (haxes : ∀ i, m • x + v i ∈ C ∧ m • x - v i ∈ C) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ a : ι → ℝ, (∀ i, |a i| < ε) → x + ∑ i, a i • v i ∈ C := by
  classical
  let c : ℝ := 1 / ((Fintype.card ι : ℝ) + 1)
  let δ : ℝ := c / (2 * m)
  have hc : 0 < c := by dsimp [c]; positivity
  have hδ : 0 < δ := div_pos hc (mul_pos (by norm_num) hm)
  refine ⟨2 * δ, mul_pos (by norm_num) hδ, fun a ha => ?_⟩
  let y : ι → M := fun i => (δ + a i / 2) • (m • x + v i) +
    (δ - a i / 2) • (m • x - v i)
  have hy (i : ι) : y i ∈ C := by
    have hi := abs_lt.mp (ha i)
    exact C.add_mem (C.smul_mem (by linarith) (haxes i).1)
      (C.smul_mem (by linarith) (haxes i).2)
  have heach (i : ι) : y i = (2 * δ * m) • x + a i • v i := by
    dsimp [y]
    module
  have hscalar : c + (Fintype.card ι : ℝ) * (2 * δ * m) = 1 := by
    dsimp [δ, c]
    field_simp
    ring
  have hsum : c • x + ∑ i, y i = x + ∑ i, a i • v i := by
    simp_rw [heach]
    rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, ← Nat.cast_smul_eq_nsmul ℝ, smul_smul,
      ← add_assoc, ← add_smul, hscalar, one_smul]
  rw [← hsum]
  exact add_sum_mem_cone C (C.smul_mem hc hx) Finset.univ y (fun i _ => hy i)

variable [IsIntegral X] (A : X.Modules) (hA : SchemeLineAmpleness.IsAmple p A)
  {ι : Type v} [Fintype ι] (B : ι → X.Modules) (hB : ∀ i, IsInvertible (B i))

/-- Genuine geometric ampleness DERIVES a true positive coefficient radius in EVERY finite
family of original numerical lines; no domination or global finite-dimensionality premise. -/
theorem exists_ample_lineFamily_radius :
    ∃ ε : ℝ, 0 < ε ∧ ∀ a : ι → ℝ, (∀ i, |a i| < ε) →
      lineClass p A hA.isInvertible + lineFamilyMap p B hB a ∈ ampleCone p := by
  obtain ⟨N, hN⟩ := exists_eventual_ample_numerical_lifts p A hA B hB
  have haxes (i : ι) :
      ((N + 1 : ℕ) : ℝ) • lineClass p A hA.isInvertible + lineClass p (B i) (hB i) ∈ ampleCone p ∧
      ((N + 1 : ℕ) : ℝ) • lineClass p A hA.isInvertible - lineClass p (B i) (hB i) ∈ ampleCone p := by
    obtain ⟨hp, hn, hep, hen⟩ := hN (N + 1) (Nat.le_succ N) i
    exact ⟨hep ▸ ampleLineClass_mem_ampleCone p _ hp, hen ▸ ampleLineClass_mem_ampleCone p _ hn⟩
  exact small_perturbation_mem_cone (ampleCone p) _ _ (ampleLineClass_mem_ampleCone p A hA)
    ((N + 1 : ℕ) : ℝ) (by positivity) haxes

/-- An actual ordinary OPEN neighborhood of zero on the ENTIRE original finite coefficient
space maps into the SAME intrinsic ample cone around the original actual ample class. -/
theorem exists_open_ample_lineFamily_neighborhood :
    ∃ U : Set (ι → ℝ), IsOpen U ∧ 0 ∈ U ∧
      ∀ a ∈ U, lineClass p A hA.isInvertible + lineFamilyMap p B hB a ∈ ampleCone p := by
  obtain ⟨ε, hε, h⟩ := exists_ample_lineFamily_radius p A hA B hB
  refine ⟨{a | ∀ i, |a i| < ε}, ?_, ?_, fun a ha => h a ha⟩
  · simp only [Set.ofPred_forall]
    exact isOpen_iInter_of_finite fun i => isOpen_lt (continuous_apply i |>.abs) continuous_const
  · simpa using fun _ : ι => hε

end EnvelopeProperty.NativeRealNumericalClasses
