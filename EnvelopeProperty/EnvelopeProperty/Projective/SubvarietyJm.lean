import EnvelopeProperty.Projective.Jm
import EnvelopeProperty.Projective.FSSystemPL
import EnvelopeProperty.Projective.SubvarietyGauss

/-!
# The ideals `J_m` of an obstacle on `X = V(I)`

Let `k` be a field with the trivial absolute value, `X = V(I) ⊆ ℙᴹ` a projective subvariety
(`EnvelopeProperty.ProjSubvariety`), `R_M = k[x₀, …, x_M]`, `S = R_M / I` and `T = S[t]` the
coordinate ring of the affine cone over `X × 𝔸¹` (`ProjSubvariety.ConeRing`). For an integer
`d > 0` and an obstacle `φ : X^an → ℝ`, the proof of Fang–Han–Xia, *The envelope property for
unibranch projective varieties*, Theorem 3.1 (`thm:smooth-EP`, §3 = `sec:smooth`) uses a graded
sequence of ideals `J_m` of `T`; as on `ℙⁿ` (`EnvelopeProperty.Projective.Jm`) they are defined
directly from the obstacle, without test configurations (blueprint `def:sg-Jm`, chapter
`smooth-general.tex`, subsection `subsec:sg-Jm`):

* `V_m(φ)` is the set of `g`, homogeneous of `x`-degree `m d`, with `log|g|_{σ(v)} ≤ m φ(v)` for
  all `v ∈ X^an`, where `σ(v)` is the Gauss extension (`ProjSubvariety.obstacleSpace`);
* `J_m(φ)` is the ideal generated by `V_m(φ)`.

Following the modelling advice of the plan (PLAN-31G §4), `V_m(φ)` and `J_m(φ)` live on the
ambient ring `R_M[t] = (MvPolynomial (Fin (M + 1)) k)[X]` (`ProjSubvariety.obstacleIdeal`), where
the functions `φ_𝔟 = ProjBerk.phiIdeal 𝔟` are defined; for `v ∈ X^an` the Gauss extension `σ(v)`
vanishes on `I[t]`, so on `X^an` everything only depends on the image in `T`. The ideal of `T` is
`ProjSubvariety.coneObstacleIdeal X d φ m = J_m(φ) T` (the image under `coneMk : R_M[t] → T`); the
statements needed for the test ideals of `T` (`lem:sg-test-X`) are also given for it.

## Main results

* `lem:sg-Jm-basic`:
  - `V_m(φ)` is a `k[t]`-submodule (`ProjSubvariety.obstacleSpace` is a `k`-submodule, and
    `ProjSubvariety.map_mul_mem_obstacleSpace`, `ProjSubvariety.X_mul_mem_obstacleSpace`)
    containing the `t`-homogeneous components of its elements
    (`ProjSubvariety.monomial_coeff_mem_obstacleSpace`);
  - `V_m V_r ⊆ V_{m+r}` (`ProjSubvariety.mul_mem_obstacleSpace`), hence `J_m J_r ⊆ J_{m+r}`
    (`ProjSubvariety.obstacleIdeal_mul_le`, and in `T`: `ProjSubvariety.coneObstacleIdeal_mul_le`)
    and `J_m^r ⊆ J_{mr}` (`ProjSubvariety.obstacleIdeal_pow_le`,
    `ProjSubvariety.coneObstacleIdeal_pow_le`);
  - `J_m` is generated by bihomogeneous elements `s t^ℓ ∈ V_m` with `s` a form of degree `m d`
    (`ProjSubvariety.obstacleIdeal_eq_span_monomial`,
    `ProjSubvariety.exists_obstacleIdeal_pow_eq_span`, and in `T`:
    `ProjSubvariety.exists_coneObstacleIdeal_eq_span`,
    `ProjSubvariety.exists_coneObstacleIdeal_pow_eq_span`);
  - for `φ` bounded below, `J_m ≠ 0` in `T` (`ProjSubvariety.coneObstacleIdeal_ne_bot`) and
    `m⁻¹ φ_{J_m} ∈ 𝓗_fin(X, d)` (`ProjSubvariety.isFinFS_obstacleIdeal`), with
    `m⁻¹ φ_{J_m} ≤ φ` (`ProjSubvariety.inv_mul_phiIdeal_obstacleIdeal_le`);
  - `φ_{J_m}` computed in `T` agrees with `φ_{J_m}` on `X^an`
    (`ProjSubvariety.phiIdeal_comap_coneObstacleIdeal`).
* `prop:sg-envelope-Jm` (FHX `prop:ample-envelopes`, BJ addendum `lem:envline`): for `d > 0` and
  `φ` lsc with `φ(⋆) ≤ 0`, `P_d(φ) = sup_{m ≥ 1} m⁻¹ φ_{J_m(φ)}` pointwise on `X^an`
  (`ProjSubvariety.envelope_eq_iSup_obstacleIdeal`), and `m⁻¹ φ_{J_m} ≤ (mr)⁻¹ φ_{J_{mr}}`
  (`ProjSubvariety.inv_mul_phiIdeal_obstacleIdeal_le_mul`).

## Deviations from the blueprint

* `prop:sg-envelope-Jm` assumes `φ` lsc and `φ(⋆) ≤ 0` (`⋆ = ProjSubvariety.triv`) instead of `φ`
  bounded, lsc and `φ ≤ 0`: only the value at `⋆` enters the proof (through
  `λ_ℓ ≤ M ψ(⋆) ≤ M φ(⋆)`), and the boundedness is not needed (if `J_m T = 0` then
  `m⁻¹ φ_{J_m} = -∞` on `X^an`, `ProjSubvariety.inv_mul_phiIdeal_obstacleIdeal_le_envelope`). The
  same deviation is made on `ℙⁿ` (`ProjBerk.envelope_eq_iSup_obstacleIdeal`).
* `V_m(φ)` and `J_m(φ)` are a `k`-submodule and an ideal of the ambient ring `R_M[t]`, not of
  `T`; `J_m(φ) T` is `ProjSubvariety.coneObstacleIdeal`. As a consequence `V_m(φ)` contains the
  elements of `I[t]` homogeneous of `x`-degree `m d`, which changes neither `J_m(φ) T` nor
  `φ_{J_m}` on `X^an`. The stability of `V_m(φ)` under `k[t]` is
  `ProjSubvariety.map_mul_mem_obstacleSpace` (multiplication by the image of `q ∈ k[t]`).
* The bihomogeneous generators of `J_m(φ) T` are stated as images `s̄ t^ℓ` of `s t^ℓ` with `s` a
  form of degree `m d` (`ProjSubvariety.exists_coneObstacleIdeal_eq_span`); no bigrading of `T`
  is formalized.
-/

open scoped NNReal ENNReal Topology Polynomial

open Set Topology

noncomputable section

namespace EnvelopeProperty

open ProjBerk (gaussExt phiIdeal termVal)

universe u

namespace ProjSubvariety

variable {k : Type u} [Field k] {M : ℕ} (X : ProjSubvariety k M)

/-! ### The spaces `V_m(φ)` and the ideals `J_m(φ)` -/

/-- **The space `V_m(φ)`** (blueprint `def:sg-Jm`): the elements `g ∈ R_M[t]` homogeneous of
`x`-degree `m d` with `log|g|_{σ(v)} ≤ m φ(v)` for all `v ∈ X^an`. It is a `k`-submodule of
`R_M[t]`, stable under multiplication by `k[t]` (`map_mul_mem_obstacleSpace`). -/
def obstacleSpace (d : ℕ) (φ : X.an → ℝ) (m : ℕ) :
    Submodule k (MvPolynomial (Fin (M + 1)) k)[X] where
  carrier := {g | IsXHomogeneous g (m * d) ∧
    ∀ v : X.an, Berk.logAbs g (gaussExt v.1) ≤ (((m : ℝ) * φ v : ℝ) : EReal)}
  add_mem' := by
    rintro g h ⟨hg, hg'⟩ ⟨hh, hh'⟩
    exact ⟨hg.add hh, fun v => (Berk.logAbs_add_le g h _).trans (max_le (hg' v) (hh' v))⟩
  zero_mem' := ⟨IsXHomogeneous.zero _, fun v => by simp⟩
  smul_mem' := by
    rintro a g ⟨hg, hg'⟩
    refine ⟨fun ℓ => ?_, fun v => (ProjBerk.logAbs_smul_gaussExt_le a g v.1).trans (hg' v)⟩
    rw [Polynomial.coeff_smul, MvPolynomial.smul_eq_C_mul]
    exact (hg ℓ).C_mul a

/-- **The ideal `J_m(φ)`** (blueprint `def:sg-Jm`), as an ideal of the ambient ring `R_M[t]`:
the ideal generated by `V_m(φ)`. -/
def obstacleIdeal (d : ℕ) (φ : X.an → ℝ) (m : ℕ) : Ideal (MvPolynomial (Fin (M + 1)) k)[X] :=
  Ideal.span (X.obstacleSpace d φ m)

/-- **The ideal `J_m(φ)` of `T`** (blueprint `def:sg-Jm`): the image `J_m(φ) T` of
`obstacleIdeal` under `coneMk : R_M[t] → T = (R_M / I)[t]`, i.e. the ideal of `T` generated by the
images of `V_m(φ)`. -/
def coneObstacleIdeal (d : ℕ) (φ : X.an → ℝ) (m : ℕ) : Ideal X.ConeRing :=
  (X.obstacleIdeal d φ m).map X.coneMk

variable {X} {d : ℕ} {φ : X.an → ℝ} {m r : ℕ} {g h : (MvPolynomial (Fin (M + 1)) k)[X]}

theorem mem_obstacleSpace :
    g ∈ X.obstacleSpace d φ m ↔ IsXHomogeneous g (m * d) ∧
      ∀ v : X.an, Berk.logAbs g (gaussExt v.1) ≤ (((m : ℝ) * φ v : ℝ) : EReal) :=
  Iff.rfl

theorem obstacleSpace_subset_obstacleIdeal :
    (X.obstacleSpace d φ m : Set (MvPolynomial (Fin (M + 1)) k)[X]) ⊆ X.obstacleIdeal d φ m :=
  Ideal.subset_span

theorem mem_obstacleIdeal_of_mem (hg : g ∈ X.obstacleSpace d φ m) :
    g ∈ X.obstacleIdeal d φ m :=
  Ideal.subset_span hg

/-- Membership in `V_m(φ)` only depends on the image in `T` among elements of `x`-degree `m d`:
`V_m(φ)` is the preimage of the blueprint's `V_m(φ) ⊆ S_{md}[t]`. -/
theorem mem_obstacleSpace_of_coneMk_eq (hg : g ∈ X.obstacleSpace d φ m)
    (hh : IsXHomogeneous h (m * d)) (hgh : X.coneMk g = X.coneMk h) :
    h ∈ X.obstacleSpace d φ m :=
  ⟨hh, fun v => (logAbs_gaussExt_eq_of_coneMk_eq v hgh).symm ▸ hg.2 v⟩

theorem coneMk_mem_coneObstacleIdeal (hg : g ∈ X.obstacleIdeal d φ m) :
    X.coneMk g ∈ X.coneObstacleIdeal d φ m :=
  Ideal.mem_map_of_mem _ hg

/-- `V_m(φ)` is stable under multiplication by `k[t]` (blueprint `lem:sg-Jm-basic`). -/
theorem map_mul_mem_obstacleSpace (q : k[X]) (hg : g ∈ X.obstacleSpace d φ m) :
    q.map (MvPolynomial.C (σ := Fin (M + 1))) * g ∈ X.obstacleSpace d φ m := by
  refine ⟨by simpa using (IsXHomogeneous.map_C q).mul hg.1, fun v => ?_⟩
  rw [Berk.logAbs_mul]
  calc Berk.logAbs (q.map MvPolynomial.C) (gaussExt v.1) + Berk.logAbs g (gaussExt v.1)
      ≤ 0 + Berk.logAbs g (gaussExt v.1) := by
        gcongr
        exact ProjBerk.logAbs_gaussExt_le_zero v.1 _
    _ = Berk.logAbs g (gaussExt v.1) := zero_add _
    _ ≤ _ := hg.2 v

theorem X_mul_mem_obstacleSpace (hg : g ∈ X.obstacleSpace d φ m) :
    Polynomial.X * g ∈ X.obstacleSpace d φ m := by
  simpa using map_mul_mem_obstacleSpace Polynomial.X hg

/-- `V_m V_r ⊆ V_{m+r}` (blueprint `lem:sg-Jm-basic`), by multiplicativity of `σ(v)`. -/
theorem mul_mem_obstacleSpace (hg : g ∈ X.obstacleSpace d φ m)
    (hh : h ∈ X.obstacleSpace d φ r) : g * h ∈ X.obstacleSpace d φ (m + r) := by
  refine ⟨by rw [add_mul]; exact hg.1.mul hh.1, fun v => ?_⟩
  rw [Berk.logAbs_mul]
  calc Berk.logAbs g (gaussExt v.1) + Berk.logAbs h (gaussExt v.1)
      ≤ (((m : ℝ) * φ v : ℝ) : EReal) + (((r : ℝ) * φ v : ℝ) : EReal) :=
        add_le_add (hg.2 v) (hh.2 v)
    _ = ((((m + r : ℕ) : ℝ) * φ v : ℝ) : EReal) := by
        rw [← EReal.coe_add]
        congr 1
        push_cast
        ring

theorem one_mem_obstacleSpace_zero :
    (1 : (MvPolynomial (Fin (M + 1)) k)[X]) ∈ X.obstacleSpace d φ 0 :=
  ⟨by simpa using IsXHomogeneous.one, fun v => by simp⟩

/-- `J_0 = R_M[t]`. -/
@[simp]
theorem obstacleIdeal_zero : X.obstacleIdeal d φ 0 = ⊤ :=
  (Ideal.eq_top_iff_one _).2 (mem_obstacleIdeal_of_mem one_mem_obstacleSpace_zero)

/-- `J_m J_r ⊆ J_{m+r}`: `(J_m)` is a graded sequence of ideals (blueprint `lem:sg-Jm-basic`). -/
theorem obstacleIdeal_mul_le (m r : ℕ) :
    X.obstacleIdeal d φ m * X.obstacleIdeal d φ r ≤ X.obstacleIdeal d φ (m + r) := by
  rw [obstacleIdeal, obstacleIdeal, Ideal.span_mul_span', Ideal.span_le]
  rintro _ ⟨a, ha, b, hb, rfl⟩
  exact mem_obstacleIdeal_of_mem (mul_mem_obstacleSpace ha hb)

/-- `J_m^r ⊆ J_{mr}`. -/
theorem obstacleIdeal_pow_le (m r : ℕ) :
    X.obstacleIdeal d φ m ^ r ≤ X.obstacleIdeal d φ (m * r) := by
  induction r with
  | zero => simp
  | succ r ih =>
    rw [pow_succ (X.obstacleIdeal d φ m) r, mul_add, mul_one]
    exact (Ideal.mul_mono_left ih).trans (obstacleIdeal_mul_le _ _)

/-- The `t`-homogeneous parts of an element of `V_m` lie in `V_m`, by the Gauss formula
(blueprint `lem:sg-Jm-basic`). -/
theorem monomial_coeff_mem_obstacleSpace (hg : g ∈ X.obstacleSpace d φ m) (ℓ : ℕ) :
    Polynomial.monomial ℓ (g.coeff ℓ) ∈ X.obstacleSpace d φ m := by
  refine ⟨IsXHomogeneous.monomial (hg.1 ℓ) ℓ, fun v => ?_⟩
  rw [← Polynomial.C_mul_X_pow_eq_monomial, ProjBerk.logAbs_C_mul_X_pow_gaussExt]
  exact (ProjBerk.logAbs_coeff_sub_le_logAbs_gaussExt g ℓ v.1).trans (hg.2 v)

/-- `J_m` is **bihomogeneous**: it is generated by the bihomogeneous elements `s t^ℓ` of `V_m`
(blueprint `lem:sg-Jm-basic`). -/
theorem obstacleIdeal_eq_span_monomial :
    X.obstacleIdeal d φ m = Ideal.span {g | g ∈ X.obstacleSpace d φ m ∧
      ∃ ℓ s, g = Polynomial.monomial ℓ s} := by
  refine le_antisymm (Ideal.span_le.2 fun g hg => ?_) (Ideal.span_mono fun g hg => hg.1)
  rw [SetLike.mem_coe, Polynomial.as_sum_support g]
  exact Ideal.sum_mem _ fun ℓ _ => Ideal.subset_span
    ⟨monomial_coeff_mem_obstacleSpace hg ℓ, ℓ, _, rfl⟩

/-- `J_q^r` is generated by bihomogeneous elements `s t^ℓ` with `s` a form of degree `q r d`
(blueprint `lem:sg-Jm-basic`). -/
theorem exists_obstacleIdeal_pow_eq_span (q : ℕ) : ∀ r : ℕ,
    ∃ S : Set (MvPolynomial (Fin (M + 1)) k)[X], X.obstacleIdeal d φ q ^ r = Ideal.span S ∧
      ∀ g ∈ S, ∃ ℓ s, g = Polynomial.monomial ℓ s ∧ s.IsHomogeneous (r * (q * d))
  | 0 => ⟨{1}, by simp, fun g hg => ⟨0, 1, by simpa using hg, by
      simpa using MvPolynomial.isHomogeneous_one (Fin (M + 1)) k⟩⟩
  | r + 1 => by
    obtain ⟨S, hS, hS'⟩ := exists_obstacleIdeal_pow_eq_span q r
    refine ⟨Set.image2 (· * ·) S
      {g | g ∈ X.obstacleSpace d φ q ∧ ∃ ℓ s, g = Polynomial.monomial ℓ s}, ?_, ?_⟩
    · rw [pow_succ (X.obstacleIdeal d φ q) r, hS, obstacleIdeal_eq_span_monomial,
        Ideal.span_mul_span']
      rfl
    · rintro _ ⟨a, ha, b, ⟨hb, ℓ', s', rfl⟩, rfl⟩
      obtain ⟨ℓ, s, rfl, hs⟩ := hS' a ha
      refine ⟨ℓ + ℓ', s * s', Polynomial.monomial_mul_monomial _ _ _ _, ?_⟩
      have h2 : s'.IsHomogeneous (q * d) := by simpa using hb.1 ℓ'
      rw [add_mul, one_mul]
      exact hs.mul h2

/-! ### The ideals `J_m(φ) T` of the cone ring -/

/-- `J_m T = (ḡ : g ∈ V_m(φ))`. -/
theorem coneObstacleIdeal_eq_span :
    X.coneObstacleIdeal d φ m = Ideal.span (X.coneMk '' (X.obstacleSpace d φ m)) :=
  Ideal.map_span _ _

/-- `J_m T J_r T ⊆ J_{m+r} T`: `(J_m T)` is a graded sequence of ideals of `T`
(blueprint `lem:sg-Jm-basic`). -/
theorem coneObstacleIdeal_mul_le (m r : ℕ) :
    X.coneObstacleIdeal d φ m * X.coneObstacleIdeal d φ r ≤ X.coneObstacleIdeal d φ (m + r) := by
  rw [coneObstacleIdeal, coneObstacleIdeal, ← Ideal.map_mul]
  exact Ideal.map_mono (obstacleIdeal_mul_le m r)

/-- `(J_m T)^r ⊆ J_{mr} T`. -/
theorem coneObstacleIdeal_pow_le (m r : ℕ) :
    X.coneObstacleIdeal d φ m ^ r ≤ X.coneObstacleIdeal d φ (m * r) := by
  rw [coneObstacleIdeal, coneObstacleIdeal, ← Ideal.map_pow]
  exact Ideal.map_mono (obstacleIdeal_pow_le m r)

/-- `J_0 T = T`. -/
@[simp]
theorem coneObstacleIdeal_zero : X.coneObstacleIdeal d φ 0 = ⊤ := by
  rw [coneObstacleIdeal, obstacleIdeal_zero, Ideal.map_top]

/-- `J_q^r T` is generated by the images `s̄ t^ℓ` of bihomogeneous elements `s t^ℓ`, `s` a form of
degree `r q d` (blueprint `lem:sg-Jm-basic`). -/
theorem exists_coneObstacleIdeal_pow_eq_span (q r : ℕ) :
    ∃ S : Set X.ConeRing, X.coneObstacleIdeal d φ q ^ r = Ideal.span S ∧
      ∀ f ∈ S, ∃ ℓ s, s.IsHomogeneous (r * (q * d)) ∧ f = Polynomial.monomial ℓ (X.coordMk s) := by
  obtain ⟨S, hS, hS'⟩ := exists_obstacleIdeal_pow_eq_span (X := X) (d := d) (φ := φ) q r
  refine ⟨X.coneMk '' S, ?_, ?_⟩
  · rw [coneObstacleIdeal, ← Ideal.map_pow, hS, Ideal.map_span]
  · rintro _ ⟨g, hg, rfl⟩
    obtain ⟨ℓ, s, rfl, hs⟩ := hS' g hg
    refine ⟨ℓ, s, hs, ?_⟩
    rw [← Polynomial.C_mul_X_pow_eq_monomial, ← Polynomial.C_mul_X_pow_eq_monomial, map_mul,
      map_pow, coneMk_C, coneMk_X]

/-- **`J_m T` is generated by bihomogeneous elements of `x`-degree `m d`** (blueprint
`lem:sg-Jm-basic`): by images `s̄ t^ℓ` of elements `s t^ℓ ∈ V_m(φ)`, `s` a form of degree
`m d`. -/
theorem exists_coneObstacleIdeal_eq_span (m : ℕ) :
    ∃ S : Set X.ConeRing, X.coneObstacleIdeal d φ m = Ideal.span S ∧
      ∀ f ∈ S, ∃ ℓ s, s.IsHomogeneous (m * d) ∧ f = Polynomial.monomial ℓ (X.coordMk s) ∧
        Polynomial.monomial ℓ s ∈ X.obstacleSpace d φ m := by
  refine ⟨X.coneMk '' {g | g ∈ X.obstacleSpace d φ m ∧ ∃ ℓ s, g = Polynomial.monomial ℓ s}, ?_,
    ?_⟩
  · rw [coneObstacleIdeal, obstacleIdeal_eq_span_monomial, Ideal.map_span]
  · rintro _ ⟨g, ⟨hgV, ℓ, s, rfl⟩, rfl⟩
    refine ⟨ℓ, s, by simpa using hgV.1 ℓ, ?_, hgV⟩
    rw [← Polynomial.C_mul_X_pow_eq_monomial, ← Polynomial.C_mul_X_pow_eq_monomial, map_mul,
      map_pow, coneMk_C, coneMk_X]

/-- `φ_𝔟` on `X^an` only depends on the image `𝔟 T` of `𝔟` (blueprint `lem:sg-phi-basic`(1)):
`φ_{(𝔟 T) ∩ R_M[t]} = φ_𝔟` on `X^an`. -/
theorem phiIdeal_comap_map_coneMk (𝔟 : Ideal (MvPolynomial (Fin (M + 1)) k)[X]) (v : X.an) :
    phiIdeal ((𝔟.map X.coneMk).comap X.coneMk) v.1 = phiIdeal 𝔟 v.1 := by
  rw [Ideal.comap_map_of_surjective' _ coneMk_surjective, phiIdeal_sup_ker_coneMk]

/-- `(J_m T) ∩ R_M[t] = J_m + I[t]`. -/
theorem comap_coneObstacleIdeal :
    (X.coneObstacleIdeal d φ m).comap X.coneMk = X.obstacleIdeal d φ m ⊔ RingHom.ker X.coneMk :=
  Ideal.comap_map_of_surjective' _ coneMk_surjective _

/-- `φ_{J_m T} = φ_{J_m}` on `X^an`, where `φ` of an ideal of `T` is computed on its preimage in
`R_M[t]` (as in `lem:sg-phi-basic`). -/
theorem phiIdeal_comap_coneObstacleIdeal (v : X.an) :
    phiIdeal ((X.coneObstacleIdeal d φ m).comap X.coneMk) v.1 =
      phiIdeal (X.obstacleIdeal d φ m) v.1 :=
  phiIdeal_comap_map_coneMk _ v

/-! ### Nonvanishing, Fubini–Study property and the bound `m⁻¹ φ_{J_m} ≤ φ` -/

/-- If `m φ ≥ -N` on `X^an` then `xᵢ^{md} t^N ∈ V_m(φ)`. -/
theorem C_X_pow_mul_X_pow_mem_obstacleSpace {N : ℕ} (hN : ∀ v : X.an, -(N : ℝ) ≤ m * φ v)
    (i : Fin (M + 1)) :
    Polynomial.C (MvPolynomial.X i ^ (m * d)) * Polynomial.X ^ N ∈ X.obstacleSpace d φ m := by
  refine ⟨IsXHomogeneous.C_mul_X_pow (MvPolynomial.isHomogeneous_X_pow i _) N, fun v => ?_⟩
  rw [ProjBerk.logAbs_C_mul_X_pow_gaussExt]
  calc ProjBerk.logAbs (MvPolynomial.X i ^ (m * d)) v.1 - (N : EReal) ≤ 0 - (N : EReal) := by
        rw [sub_eq_add_neg, sub_eq_add_neg]
        exact add_le_add_left (ProjBerk.logAbs_le_zero _ v.1) _
    _ = ((-(N : ℝ) : ℝ) : EReal) := by rw [zero_sub, EReal.coe_neg]; rfl
    _ ≤ _ := EReal.coe_le_coe_iff.2 (hN v)

/-- For `φ ≥ C` on `X^an`, the integer `N = ⌈-m C⌉₊` satisfies `m φ ≥ -N`. -/
theorem neg_ceil_le_mul_obstacle {C : ℝ} (hC : ∀ v, C ≤ φ v) (m : ℕ) (v : X.an) :
    -((⌈-((m : ℝ) * C)⌉₊ : ℕ) : ℝ) ≤ m * φ v := by
  have h1 := Nat.le_ceil (-((m : ℝ) * C))
  have h2 : (m : ℝ) * C ≤ m * φ v := mul_le_mul_of_nonneg_left (hC v) (Nat.cast_nonneg m)
  linarith

/-- `x̄ⱼ^{md} t^N ≠ 0` in `T` for `xⱼ ∉ I`. -/
theorem coneMk_C_X_pow_mul_X_pow_ne_zero {j : Fin (M + 1)}
    (hj : (MvPolynomial.X j : MvPolynomial (Fin (M + 1)) k) ∉ X.ideal) (e N : ℕ) :
    X.coneMk (Polynomial.C (MvPolynomial.X j ^ e) * Polynomial.X ^ N) ≠ 0 := by
  intro h0
  have h := coneMk_eq_zero_iff.1 h0 N
  rw [Polynomial.coeff_C_mul_X_pow, if_pos rfl] at h
  exact hj (X.isPrime.mem_of_pow_mem e h)

/-- `J_m ≠ 0` in `T` for `φ` bounded below (blueprint `lem:sg-Jm-basic`): it contains
`x̄ⱼ^{md} t^N` for `xⱼ ∉ I` and `N ≥ -m inf φ`. -/
theorem coneObstacleIdeal_ne_bot {C : ℝ} (hC : ∀ v, C ≤ φ v) (m : ℕ) :
    X.coneObstacleIdeal d φ m ≠ ⊥ := by
  obtain ⟨j, hj⟩ := X.exists_X_notMem
  intro h
  have hmem := coneMk_mem_coneObstacleIdeal (mem_obstacleIdeal_of_mem
    (C_X_pow_mul_X_pow_mem_obstacleSpace (d := d) (neg_ceil_le_mul_obstacle hC m) j))
  rw [h, Ideal.mem_bot] at hmem
  exact coneMk_C_X_pow_mul_X_pow_ne_zero hj _ _ hmem

/-- `J_m ≠ 0` in `R_M[t]` for `φ` bounded below. -/
theorem obstacleIdeal_ne_bot {C : ℝ} (hC : ∀ v, C ≤ φ v) (m : ℕ) :
    X.obstacleIdeal d φ m ≠ ⊥ := fun h =>
  coneObstacleIdeal_ne_bot hC m (by rw [coneObstacleIdeal, h, Ideal.map_bot])

/-- `φ_{J_m} > -∞` on `X^an` for `φ` bounded below: at `v` choose `xⱼ` with `|xⱼ|_v = 1`, then
`log|xⱼ^{md} t^N|_{σ(v)} = -N`. -/
theorem phiIdeal_obstacleIdeal_ne_bot {C : ℝ} (hC : ∀ v, C ≤ φ v) (m : ℕ) (v : X.an) :
    phiIdeal (X.obstacleIdeal d φ m) v.1 ≠ ⊥ := by
  obtain ⟨j, hj⟩ := ProjBerk.exists_val_X_eq_one v.1
  refine ne_bot_of_le_ne_bot ?_ (ProjBerk.le_phiIdeal _ v.1 (mem_obstacleIdeal_of_mem
    (C_X_pow_mul_X_pow_mem_obstacleSpace (d := d) (neg_ceil_le_mul_obstacle hC m) j)))
  rw [ProjBerk.logAbs_C_mul_X_pow_gaussExt, ProjBerk.logAbs_def (MvPolynomial.X j ^ (m * d)),
    map_pow, hj, one_pow, ENNReal.coe_one, ENNReal.log_one, zero_sub]
  rw [Ne, EReal.neg_eq_bot_iff]
  exact EReal.natCast_ne_top _

/-- `φ_{J_m} ≤ m φ` on `X^an`. -/
theorem phiIdeal_obstacleIdeal_le (v : X.an) :
    phiIdeal (X.obstacleIdeal d φ m) v.1 ≤ (((m : ℝ) * φ v : ℝ) : EReal) := by
  rw [obstacleIdeal, ProjBerk.phiIdeal_span]
  exact iSup₂_le fun g hg => hg.2 v

/-- `m⁻¹ φ_{J_m} ≤ φ` on `X^an` for `m > 0` (blueprint `lem:sg-Jm-basic`). -/
theorem inv_mul_phiIdeal_obstacleIdeal_le (hm : 0 < m) (v : X.an) :
    (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (X.obstacleIdeal d φ m) v.1 ≤ (φ v : EReal) := by
  have hm' : (m : ℝ) ≠ 0 := Nat.cast_ne_zero.2 hm.ne'
  calc (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (X.obstacleIdeal d φ m) v.1
      ≤ (((m : ℝ)⁻¹ : ℝ) : EReal) * (((m : ℝ) * φ v : ℝ) : EReal) :=
        ProjBerk.ereal_coe_mul_monotone (inv_nonneg.2 (Nat.cast_nonneg m))
          (phiIdeal_obstacleIdeal_le v)
    _ = (φ v : EReal) := by rw [← EReal.coe_mul, inv_mul_cancel_left₀ hm']

/-- If `J_m T = 0`, then `φ_{J_m} = -∞` on `X^an`. -/
theorem phiIdeal_obstacleIdeal_eq_bot (h : X.coneObstacleIdeal d φ m = ⊥) (v : X.an) :
    phiIdeal (X.obstacleIdeal d φ m) v.1 = ⊥ := by
  refine le_bot_iff.1 (iSup₂_le fun g hg => ?_)
  rw [Berk.logAbs, gaussExt_val_eq_zero_of_coneMk_eq_zero v
    (RingHom.mem_ker.1 ((Ideal.map_eq_bot_iff_le_ker _).1 h hg)), ENNReal.coe_zero,
    ENNReal.log_zero]

/-- `m⁻¹ φ_{J_m} ∈ 𝓗(X, d)` as soon as `J_m T ≠ 0`, for `m > 0`. The Fubini–Study data have
rational (indeed integer) weights. -/
theorem isFS_obstacleIdeal (hm : 0 < m) (hne : X.coneObstacleIdeal d φ m ≠ ⊥) :
    X.IsFS (d : ℚ) fun v => (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (X.obstacleIdeal d φ m) v.1 := by
  have hex : ∃ g ∈ (X.obstacleSpace d φ m : Set (MvPolynomial (Fin (M + 1)) k)[X]),
      X.coneMk g ≠ 0 := by
    by_contra h0
    push Not at h0
    refine hne ((Ideal.map_eq_bot_iff_le_ker _).2 ?_)
    rw [obstacleIdeal, Ideal.span_le]
    exact fun g hg => RingHom.mem_ker.2 (h0 g hg)
  obtain ⟨D, -, hD, hDeq⟩ := isFS_inv_mul_phiIdeal hm rfl
    (fun _ hg ℓ => ⟨m * d, le_rfl, hg.1 ℓ⟩) hex
  exact ⟨D, hD, fun v => (hDeq v.1).symm⟩

/-- **`m⁻¹ φ_{J_m} ∈ 𝓗_fin(X, d)`** (blueprint `lem:sg-Jm-basic`): for `φ` bounded below and
`m > 0`, `m⁻¹ φ_{J_m}` is a finite Fubini–Study function on `X^an` for `O(d)` with rational
(indeed integer) weights: `φ_{J_m} = max_{ℓ, λ} (log|s_{ℓλ}| - λ)` for finitely many generators
`∑_λ s_{ℓλ} t^λ ∈ V_m`, padded to degree `m d`, with no common zero on `X^an` since
`φ_{J_m} ≥ -N`. -/
theorem isFinFS_obstacleIdeal {C : ℝ} (hC : ∀ v, C ≤ φ v) (hm : 0 < m) :
    X.IsFinFS (d : ℚ) fun v =>
      (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (X.obstacleIdeal d φ m) v.1 := by
  obtain ⟨D, hD, hDeq⟩ := ProjBerk.isRatFS_inv_mul_phiIdeal hm rfl
    (fun _ hg ℓ => ⟨m * d, le_rfl, (hg : _ ∈ X.obstacleSpace d φ m).1 ℓ⟩)
    (obstacleIdeal_ne_bot hC m)
  refine ⟨D, hD, (X.forall_exists_val_ne_zero_iff D).2 fun v => ?_, fun v => congrFun hDeq v.1⟩
  rw [← congrFun hDeq v.1]
  exact ProjBerk.ereal_coe_mul_ne_bot (inv_nonneg.2 (Nat.cast_nonneg m))
    (phiIdeal_obstacleIdeal_ne_bot hC m v)

/-- The real-valued form of `isFinFS_obstacleIdeal`: `m⁻¹ φ_{J_m}` is a finite Fubini–Study
function of class `O(d)` on `X^an` in the sense of `def:wu-proj-functions`(1). -/
theorem isFiniteFS_obstacleIdeal {C : ℝ} (hC : ∀ v, C ≤ φ v) (hm : 0 < m) :
    X.IsFiniteFS (d : ℚ) fun v =>
      ((((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (X.obstacleIdeal d φ m) v.1).toReal :=
  (isFinFS_obstacleIdeal hC hm).isFiniteFS

/-! ### Envelopes of obstacles (`prop:sg-envelope-Jm`) -/

/-- **Monotonicity** (blueprint `prop:sg-envelope-Jm`): `m⁻¹ φ_{J_m} ≤ (mr)⁻¹ φ_{J_{mr}}` for
`m, r > 0`, from `J_m^r ⊆ J_{mr}` and `φ_{𝔟^r} = r φ_𝔟`. -/
theorem inv_mul_phiIdeal_obstacleIdeal_le_mul (hm : 0 < m) (hr : 0 < r) (v : X.an) :
    (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (X.obstacleIdeal d φ m) v.1 ≤
      ((((m * r : ℕ) : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (X.obstacleIdeal d φ (m * r)) v.1 := by
  have hm' : (m : ℝ) ≠ 0 := Nat.cast_ne_zero.2 hm.ne'
  have hr' : (r : ℝ) ≠ 0 := Nat.cast_ne_zero.2 hr.ne'
  have h1 : (r : EReal) * phiIdeal (X.obstacleIdeal d φ m) v.1 ≤
      phiIdeal (X.obstacleIdeal d φ (m * r)) v.1 := by
    rw [← ProjBerk.phiIdeal_pow]
    exact ProjBerk.phiIdeal_mono v.1 (obstacleIdeal_pow_le m r)
  calc (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (X.obstacleIdeal d φ m) v.1
      = ((((m * r : ℕ) : ℝ)⁻¹ : ℝ) : EReal) *
          (((r : ℝ) : EReal) * phiIdeal (X.obstacleIdeal d φ m) v.1) := by
        rw [ProjBerk.ereal_coe_mul_coe_mul]
        congr 2
        push_cast
        field_simp
    _ ≤ _ := ProjBerk.ereal_coe_mul_monotone (inv_nonneg.2 (Nat.cast_nonneg _)) h1

/-- `m⁻¹ φ_{J_m} ≤ P_d(φ)` on `X^an` for `m > 0`: it is `-∞` if `J_m T = 0`, and otherwise a
Fubini–Study function for `O(d)` below `φ`. -/
theorem inv_mul_phiIdeal_obstacleIdeal_le_envelope (hm : 0 < m) (v : X.an) :
    (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (X.obstacleIdeal d φ m) v.1 ≤
      X.envelope (d : ℝ) (fun w => (φ w : EReal)) v := by
  by_cases hne : X.coneObstacleIdeal d φ m = ⊥
  · have hpos : (0 : EReal) < (((m : ℝ)⁻¹ : ℝ) : EReal) :=
      EReal.coe_pos.2 (inv_pos.2 (Nat.cast_pos.2 hm))
    rw [phiIdeal_obstacleIdeal_eq_bot hne, EReal.mul_bot_of_pos hpos]
    exact bot_le
  · have h := (isFS_obstacleIdeal hm hne).isPSH
    rw [Rat.cast_natCast] at h
    exact FSSystem.le_envelope (F := X.fsSystem) h (inv_mul_phiIdeal_obstacleIdeal_le hm) v

/-- The key step of `prop:sg-envelope-Jm`: if `ψ = M⁻¹ max_ℓ (log|s_ℓ| + λ_ℓ) ∈ 𝓗_fin(X, d)`
satisfies `ψ ≤ φ` and `φ(⋆) ≤ 0`, then (after clearing denominators of the `λ_ℓ`) `λ_ℓ ≤ 0` for
`s_ℓ ∉ I`, the `g_ℓ = s_ℓ t^{-λ_ℓ}` lie in `V_M(φ)`, and `ψ ≤ M⁻¹ φ_{J_M}`; the terms with
`s_ℓ ∈ I` are `-∞` on `X^an`. -/
theorem exists_le_inv_mul_phiIdeal_obstacleIdeal (hφ0 : φ X.triv ≤ 0) {ψ : X.an → EReal}
    (hψ : X.IsFinFS (d : ℚ) ψ) (hψφ : ∀ v, ψ v ≤ (φ v : EReal)) :
    ∃ M' : ℕ, 0 < M' ∧ ∀ v : X.an, ψ v ≤
      (((M' : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (X.obstacleIdeal d φ M') v.1 := by
  obtain ⟨D, hD, -, hψD⟩ := hψ
  obtain ⟨N, hN, hNz⟩ := ProjBerk.exists_pos_nat_mul_eq_int D.terms (fun t => t.2) hD
  have hdeg : D.deg = D.m * d := by exact_mod_cast D.deg_eq
  have hNr : (0 : ℝ) < N := Nat.cast_pos.2 hN
  refine ⟨D.m * N, Nat.mul_pos D.m_pos hN, fun v => ?_⟩
  -- each term, multiplied by `N`, is bounded by `φ_{J_M}` on `X^an`
  have key : ∀ t ∈ D.terms, ((N : ℝ) : EReal) * termVal t v.1 ≤
      phiIdeal (X.obstacleIdeal d φ (D.m * N)) v.1 := by
    intro t ht
    by_cases ht0 : t.1 ∈ X.ideal
    · rw [ProjBerk.termVal_def, (ProjBerk.logAbs_eq_bot_iff t.1 v.1).2 (v.2 t.1 ht0),
        EReal.bot_add, EReal.mul_bot_of_pos (EReal.coe_pos.2 hNr)]
      exact bot_le
    obtain ⟨z, hz⟩ := hNz t ht
    -- `λ_t ≤ 0`, by evaluation at `⋆`
    have hlam : t.2 ≤ 0 := by
      have h1 := D.termVal_le_eval_mul (X.triv : ProjBerk k M) ht
      rw [ProjBerk.termVal_def, X.logAbs_triv_of_notMem ht0, zero_add, ← EReal.coe_mul] at h1
      have h2 : D.eval (X.triv : ProjBerk k M) ≤ 0 := by
        rw [← hψD]
        exact (hψφ X.triv).trans (EReal.coe_le_coe_iff.2 hφ0)
      have h3 : (D.m : ℝ)⁻¹ * t.2 ≤ 0 := EReal.coe_le_coe_iff.1 (h1.trans h2)
      exact nonpos_of_mul_nonpos_right h3 D.inv_m_pos
    have hz0 : z ≤ 0 := by
      have : (z : ℝ) ≤ 0 := hz ▸ mul_nonpos_of_nonneg_of_nonpos hNr.le hlam
      exact_mod_cast this
    have hcast : (((-z).toNat : ℕ) : ℝ) = -((N : ℝ) * t.2) := by
      rw [hz]
      have : (((-z).toNat : ℕ) : ℤ) = -z := Int.toNat_of_nonneg (by omega)
      exact_mod_cast this
    -- `g = s^N t^{-Nλ}` and `log|g|_{σ(w)} = N (log|s|_w + λ)`
    set g := Polynomial.C (t.1 ^ N) * Polynomial.X ^ (-z).toNat with hg_def
    have hlog : ∀ w : ProjBerk k M, Berk.logAbs g (gaussExt w) =
        ((N : ℝ) : EReal) * termVal t w := by
      intro w
      rw [← ProjBerk.termVal_pow, ProjBerk.termVal_def, ProjBerk.logAbs_C_mul_X_pow_gaussExt,
        sub_eq_add_neg]
      congr 1
      rw [show (((-z).toNat : ℕ) : EReal) = ((((-z).toNat : ℕ) : ℝ) : EReal) from rfl, hcast,
        EReal.coe_neg, neg_neg]
    have hgV : g ∈ X.obstacleSpace d φ (D.m * N) := by
      refine ⟨IsXHomogeneous.C_mul_X_pow ?_ _, fun w => ?_⟩
      · have := (D.isHomogeneous t ht).pow N
        rwa [hdeg, show D.m * d * N = D.m * N * d by ring] at this
      · rw [hlog w.1]
        have h1 : termVal t w.1 ≤ ((D.m : ℝ) : EReal) * (φ w : EReal) := by
          have h2 := D.termVal_le_eval_mul w.1 ht
          have h3 : ((D.m : ℝ) : EReal) * ((((D.m : ℝ)⁻¹ : ℝ) : EReal) * termVal t w.1) =
              termVal t w.1 := by
            rw [ProjBerk.ereal_coe_mul_coe_mul, mul_inv_cancel₀ D.m_ne_zero, EReal.coe_one,
              one_mul]
          rw [← h3]
          exact ProjBerk.ereal_coe_mul_monotone (Nat.cast_nonneg _)
            (h2.trans ((hψD w).symm ▸ hψφ w))
        calc ((N : ℝ) : EReal) * termVal t w.1
            ≤ ((N : ℝ) : EReal) * (((D.m : ℝ) : EReal) * (φ w : EReal)) :=
              ProjBerk.ereal_coe_mul_monotone hNr.le h1
          _ = ((((D.m * N : ℕ) : ℝ) * φ w : ℝ) : EReal) := by
              rw [← EReal.coe_mul, ← EReal.coe_mul]
              congr 1
              push_cast
              ring
    rw [← hlog v.1]
    exact ProjBerk.le_phiIdeal _ v.1 (mem_obstacleIdeal_of_mem hgV)
  have hsup : ((N : ℝ) : EReal) * D.terms.sup (fun t => termVal t v.1) ≤
      phiIdeal (X.obstacleIdeal d φ (D.m * N)) v.1 := by
    rw [ProjBerk.ereal_coe_mul_finset_sup hNr]
    exact Finset.sup_le key
  rw [hψD v]
  calc D.eval v.1 = ((((D.m * N : ℕ) : ℝ)⁻¹ : ℝ) : EReal) *
        (((N : ℝ) : EReal) * D.terms.sup (fun t => termVal t v.1)) := by
        rw [ProjBerk.FSData.eval_def, ProjBerk.ereal_coe_mul_coe_mul]
        congr 2
        push_cast
        field_simp [D.m_ne_zero]
    _ ≤ _ := ProjBerk.ereal_coe_mul_monotone (inv_nonneg.2 (Nat.cast_nonneg _)) hsup

/-- **Envelopes of obstacles on `X`** (blueprint `prop:sg-envelope-Jm`; FHX
`prop:ample-envelopes`, BJ addendum `lem:envline`): for `d > 0` and a lsc obstacle
`φ : X^an → ℝ` with `φ(⋆) ≤ 0` (e.g. `φ ≤ 0`), `P_d(φ) = sup_{m ≥ 1} m⁻¹ φ_{J_m(φ)}` pointwise on
`X^an`. By the Fubini–Study envelope lemma (`lem:sg-fs-envelope`,
`ProjSubvariety.envelope_eq_iSup_isFinFS`) it suffices to bound every `ψ ∈ 𝓗_fin(X, d)` with
`ψ ≤ φ`, which is `exists_le_inv_mul_phiIdeal_obstacleIdeal`. -/
theorem envelope_eq_iSup_obstacleIdeal (hd : 0 < d) (hφ : LowerSemicontinuous φ)
    (hφ0 : φ X.triv ≤ 0) (v : X.an) :
    X.envelope (d : ℝ) (fun w => (φ w : EReal)) v =
      ⨆ (m : ℕ) (_ : 0 < m),
        (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (X.obstacleIdeal d φ m) v.1 := by
  refine le_antisymm ?_ (iSup₂_le fun m hm => inv_mul_phiIdeal_obstacleIdeal_le_envelope hm v)
  have hd' : (0 : ℚ) < d := Nat.cast_pos.2 hd
  have e := envelope_eq_iSup_isFinFS (X := X) (a := (d : ℚ)) (φ := fun w => (φ w : EReal)) hd'
    (continuous_coe_real_ereal.comp_lowerSemicontinuous hφ EReal.coe_strictMono.monotone)
    (fun _ => EReal.coe_ne_bot _) v
  rw [Rat.cast_natCast] at e
  rw [e]
  refine iSup₂_le fun ψ hψ => ?_
  obtain ⟨M', hM', hle⟩ := exists_le_inv_mul_phiIdeal_obstacleIdeal hφ0 hψ.1 hψ.2
  exact (hle v).trans (le_iSup₂_of_le (f := fun (m : ℕ) (_ : 0 < m) =>
    (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (X.obstacleIdeal d φ m) v.1) M' hM' le_rfl)

/-- `prop:sg-envelope-Jm` with the hypotheses of the blueprint: `φ` lsc and `φ ≤ 0` (`φ` is then
automatically bounded, `X^an` being compact). -/
theorem envelope_eq_iSup_obstacleIdeal_of_nonpos (hd : 0 < d) (hφ : LowerSemicontinuous φ)
    (hφ0 : ∀ v, φ v ≤ 0) (v : X.an) :
    X.envelope (d : ℝ) (fun w => (φ w : EReal)) v =
      ⨆ (m : ℕ) (_ : 0 < m),
        (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (X.obstacleIdeal d φ m) v.1 :=
  envelope_eq_iSup_obstacleIdeal hd hφ (hφ0 X.triv) v

/-- `prop:sg-envelope-Jm` in terms of the ideals `J_m T` of the cone ring (`φ` of an ideal of `T`
computed on its preimage in `R_M[t]`). -/
theorem envelope_eq_iSup_coneObstacleIdeal (hd : 0 < d) (hφ : LowerSemicontinuous φ)
    (hφ0 : φ X.triv ≤ 0) (v : X.an) :
    X.envelope (d : ℝ) (fun w => (φ w : EReal)) v =
      ⨆ (m : ℕ) (_ : 0 < m), (((m : ℝ)⁻¹ : ℝ) : EReal) *
        phiIdeal ((X.coneObstacleIdeal d φ m).comap X.coneMk) v.1 := by
  simp only [phiIdeal_comap_coneObstacleIdeal]
  exact envelope_eq_iSup_obstacleIdeal hd hφ hφ0 v

end ProjSubvariety

end EnvelopeProperty
