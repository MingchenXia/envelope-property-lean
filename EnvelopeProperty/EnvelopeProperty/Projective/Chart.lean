/-!
# Graded extension and affine charts of `(ℙⁿ)^an`

Let `k` be a field with the trivial absolute value and `R = k[x₀, …, xₙ]`. In the model
`ProjBerk k n` of `(ℙⁿ)^an` (graded normalized seminorms on `R`, `EnvelopeProperty.Projective.Basic`)
this file proves the two bridges of the blueprint chapter on Boucksom–Jonsson's global theory on
`ℙⁿ` (`bj22.tex`, subsection "Charts and divisorial points"), used for the compactification lemma
(Fang–Han–Xia, *The envelope property for unibranch projective varieties*, Lemma 5.10,
`lem:compactification`) and the extension step of FHX Proposition 5.22.

## Graded extension (`lem:bj-graded-extension`)

A family `N d : R → ℝ≥0` of which only the values on forms of degree `d` matter, with `N = 1` on
nonzero constants, multiplicative and ultrametric on forms and `max_i N(xᵢ) = 1`
(`ProjBerk.IsGradedNorm`), defines the point `|f| = max_d N(f_d)` of `(ℙⁿ)^an`
(`ProjBerk.ofGradedNorm`). Multiplicativity is the graded Gauss lemma: for the minimal degrees
`i`, `j` where the maxima for `f`, `g` are attained, `f_i g_j` is the unique dominant term of
`(fg)_{i+j}` (the blueprint uses the largest degrees; either works). Conversely every point is
the graded extension of its values on forms (`ProjBerk.ofGradedNorm_val`).

## Affine charts (`lem:bj-chart`)

For a form `σ` of degree `e ≥ 1`, the chart algebra `A_σ = (R_σ)_0` is modelled as the
`k`-subalgebra `ProjBerk.chartAlg σ e` of `Localization.Away σ` generated by the fractions
`τ / σ^N` (`ProjBerk.frac`) with `τ` a form of degree `N e`; for homogeneous `σ` these fractions
are all of `A_σ` (`ProjBerk.mem_chartAlg_iff`), written `ProjBerk.chartMk σ e N τ`.

* `ProjBerk.adjoin_chartGen`, `ProjBerk.finiteType_chartAlg`: `A_σ` is generated by the
  `x^α / σ`, `|α| = e` (part (1)).
* `ProjBerk.chartHomeomorph`: `U_σ = {|σ| ≠ 0}` (`ProjBerk.chartDomain`, open) is homeomorphic to
  `(Spec A_σ)^an = Berk k A_σ` by `ι_σ(v)(τ / σ^N) = |τ|_v / |σ|_v^N` (`ProjBerk.chartMap`); the
  inverse `ProjBerk.chartInv` is the graded extension of
  `N_c(g) = (|g^e / σ^c|_y / M(y)^c)^{1/e}`, `M(y) = max_i |xᵢ^e / σ|_y ≥ 1`
  (`ProjBerk.chartNorm`, `ProjBerk.one_le_chartScale`), part (2). The inverse chart is an open
  embedding with image `U_σ` (`ProjBerk.isOpenEmbedding_chartInv`, `ProjBerk.range_chartInv`).
* `ProjBerk.logAbs_chartMap_chartMk`: `log|τ / σ^N| ∘ ι_σ = log|τ| - N log|σ|`;
  `ProjBerk.sup_logAbs_chartMap_chartGen`: `max_{|α| = e} log|x^α / σ| ∘ ι_σ = -log|σ|`
  (part (3)).
* `ProjBerk.chartMap_triv`: `ι_σ(v_triv) = v_triv` (part (4)).
* Standard charts `σ = xⱼ`: `ProjBerk.chartEquiv : A_{xⱼ} ≃ₐ[k] k[y₀, …, y_{n-1}]` by
  dehomogenization `ProjBerk.dehom j` (`xⱼ ↦ 1`, `x_{j.succAbove m} ↦ y_m`), and
  `ProjBerk.stdChart j : U_{xⱼ} ≃ₜ (𝔸ⁿ)^an` with `|dehom τ| = |τ|_v / |xⱼ|_v^N`
  (`ProjBerk.stdChart_val_dehom`) and inverse given on forms by `ProjBerk.stdChart_symm_val`.
* Charts `σ = xⱼ h`, `h` a form of degree `d`: `ProjBerk.mulChartEquiv :
  A_{xⱼ h} ≃ₐ[k] k[y]_{dehom h}` and `ProjBerk.mulChart : U_{xⱼ h} ≃ₜ (Spec k[y]_{dehom h})^an`,
  compatible with `stdChart` (`ProjBerk.awayComap_mulChart`); this is the identification
  `S ⊆ 𝔸ⁿ` of `rmk:bj-compactification-full` for `σ = x₀ h`.

The general `Berk.homeomorphOfAlgEquiv` transports analytifications along `k`-algebra isomorphisms.

## Not formalized here

The integral closedness of `A_σ` for a general form `σ` (part of `lem:bj-chart`(1)); for
`σ = xⱼ` and `σ = xⱼ h`, `A_σ` is identified with a polynomial ring, resp. its localization.
-/

open scoped NNReal ENNReal Topology

open Topology MvPolynomial

noncomputable section

namespace EnvelopeProperty

universe u

/-! ### Homogeneous components of a product -/

section HomogeneousComponent

variable {R : Type*} [CommRing R] {ι : Type*}

/-- The homogeneous component of degree `c` of a product: `(fg)_c = ∑_{a + b = c} f_a g_b`. -/
theorem homogeneousComponent_mul (c : ℕ) (f g : MvPolynomial ι R) :
    homogeneousComponent c (f * g) = ∑ p ∈ Finset.HasAntidiagonal.antidiagonal c,
      homogeneousComponent p.1 f * homogeneousComponent p.2 g := by
  classical
  induction f using MvPolynomial.induction_on' with
  | add f₁ f₂ h₁ h₂ => simp only [add_mul, map_add, h₁, h₂, Finset.sum_add_distrib]
  | monomial α a =>
    induction g using MvPolynomial.induction_on' with
    | add g₁ g₂ h₁ h₂ => simp only [mul_add, map_add, h₁, h₂, Finset.sum_add_distrib]
    | monomial β b =>
      rw [monomial_mul, homogeneousComponent_of_mem (isHomogeneous_monomial (a * b) rfl)]
      simp only [homogeneousComponent_of_mem (isHomogeneous_monomial a rfl),
        homogeneousComponent_of_mem (isHomogeneous_monomial b rfl), map_add]
      by_cases hc : c = α.degree + β.degree
      · rw [if_pos hc, Finset.sum_eq_single (α.degree, β.degree)]
        · rw [if_pos rfl, if_pos rfl, monomial_mul]
        · rintro ⟨p₁, p₂⟩ _ hne
          by_cases h₁ : p₁ = α.degree
          · have h₂ : p₂ ≠ β.degree := fun h₂ => hne (Prod.ext h₁ h₂)
            rw [if_neg h₂, mul_zero]
          · rw [if_neg h₁, zero_mul]
        · intro h
          exact absurd (Finset.HasAntidiagonal.mem_antidiagonal.2 hc.symm) h
      · rw [if_neg hc]
        refine (Finset.sum_eq_zero fun p hp => ?_).symm
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        by_cases h₁ : p.1 = α.degree
        · have h₂ : p.2 ≠ β.degree := fun h₂ => hc (by rw [← hp, h₁, h₂])
          rw [if_neg h₂, mul_zero]
        · rw [if_neg h₁, zero_mul]

end HomogeneousComponent

/-! ### Functoriality of `Berk` under algebra isomorphisms -/

namespace Berk

variable {k : Type*} [Field k] {A B : Type*} [CommRing A] [Algebra k A] [CommRing B] [Algebra k B]

/-- A `k`-algebra isomorphism `A ≃ B` induces a homeomorphism `(Spec A)^an ≃ (Spec B)^an`,
`|b|_{φ_* x} = |φ⁻¹ b|_x`. -/
def homeomorphOfAlgEquiv (φ : A ≃ₐ[k] B) : Berk k A ≃ₜ Berk k B where
  toFun := comap (φ.symm : B →ₐ[k] A)
  invFun := comap (φ : A →ₐ[k] B)
  left_inv x := ext_val fun a => by simp
  right_inv y := ext_val fun b => by simp
  continuous_toFun := continuous_comap _
  continuous_invFun := continuous_comap _

@[simp]
theorem homeomorphOfAlgEquiv_val_apply (φ : A ≃ₐ[k] B) (x : Berk k A) (b : B) :
    (homeomorphOfAlgEquiv φ x).val b = x.val (φ.symm b) :=
  rfl

@[simp]
theorem homeomorphOfAlgEquiv_symm_val_apply (φ : A ≃ₐ[k] B) (y : Berk k B) (a : A) :
    ((homeomorphOfAlgEquiv φ).symm y).val a = y.val (φ a) :=
  rfl

end Berk

/-- If `e ≤ |β|`, then `β` dominates a multi-index of degree `e`. -/
theorem exists_le_degree_eq {ι : Type*} {β : ι →₀ ℕ} :
    ∀ {e : ℕ}, e ≤ β.degree → ∃ α ≤ β, α.degree = e
  | 0, _ => ⟨0, zero_le, map_zero _⟩
  | e + 1, h => by
    classical
    obtain ⟨α, hα, hdeg⟩ := exists_le_degree_eq (Nat.le_of_succ_le h)
    have hne : α ≠ β := by rintro rfl; omega
    obtain ⟨i, hi⟩ : ∃ i, α i < β i := by
      by_contra hcon
      simp only [not_exists, not_lt] at hcon
      exact hne (Finsupp.ext fun i => le_antisymm (hα i) (hcon i))
    refine ⟨α + Finsupp.single i 1, fun j => ?_, by rw [map_add, hdeg, Finsupp.degree_single]⟩
    rcases eq_or_ne j i with rfl | hj
    · simp only [Finsupp.coe_add, Pi.add_apply, Finsupp.single_eq_same]; omega
    · simp only [Finsupp.coe_add, Pi.add_apply, Finsupp.single_eq_of_ne hj, add_zero]
      exact hα j

namespace ProjBerk

variable {k : Type u} [Field k] {n : ℕ}

/-! ### Graded extension -/

/-- The hypotheses of the **graded extension** lemma (`lem:bj-graded-extension`) on a family
`N d : k[x₀, …, xₙ] → ℝ≥0`, `d ∈ ℕ`, of which only the values on forms of degree `d` matter:
`N` vanishes at `0`, is `1` on nonzero constants, is multiplicative and ultrametric on forms,
and `max_i N(xᵢ) = 1`. -/
structure IsGradedNorm (N : ℕ → MvPolynomial (Fin (n + 1)) k → ℝ≥0) : Prop where
  map_zero : ∀ d, N d 0 = 0
  map_C : ∀ c : k, c ≠ 0 → N 0 (C c) = 1
  map_mul : ∀ {d e : ℕ} {f g : MvPolynomial (Fin (n + 1)) k}, f.IsHomogeneous d →
    g.IsHomogeneous e → N (d + e) (f * g) = N d f * N e g
  map_add_le : ∀ {d : ℕ} {f g : MvPolynomial (Fin (n + 1)) k}, f.IsHomogeneous d →
    g.IsHomogeneous d → N d (f + g) ≤ max (N d f) (N d g)
  sup_X : Finset.univ.sup (fun i => N 1 (X i)) = 1

namespace IsGradedNorm

variable {N : ℕ → MvPolynomial (Fin (n + 1)) k → ℝ≥0} (hN : IsGradedNorm N)
include hN

theorem map_neg {d : ℕ} {f : MvPolynomial (Fin (n + 1)) k} (hf : f.IsHomogeneous d) :
    N d (-f) = N d f := by
  have h := hN.map_mul (isHomogeneous_C (Fin (n + 1)) (-1 : k)) hf
  rw [zero_add, hN.map_C _ (neg_ne_zero.2 one_ne_zero), one_mul, _root_.map_neg, map_one,
    neg_one_mul] at h
  exact h

theorem map_add_eq_of_lt {d : ℕ} {f g : MvPolynomial (Fin (n + 1)) k} (hf : f.IsHomogeneous d)
    (hg : g.IsHomogeneous d) (hlt : N d g < N d f) : N d (f + g) = N d f := by
  refine le_antisymm ((hN.map_add_le hf hg).trans (max_le le_rfl hlt.le)) ?_
  have h := hN.map_add_le (hf.add hg) hg.neg
  rw [add_neg_cancel_right, hN.map_neg hg] at h
  rcases le_max_iff.1 h with h | h
  · exact h
  · exact absurd h (not_le.2 hlt)

theorem map_sum_le {ι : Type*} (s : Finset ι) {d : ℕ} {h : ι → MvPolynomial (Fin (n + 1)) k}
    (hh : ∀ i ∈ s, (h i).IsHomogeneous d) :
    N d (∑ i ∈ s, h i) ≤ s.sup fun i => N d (h i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [hN.map_zero]
  | insert j s hj ih =>
    rw [Finset.sum_insert hj, Finset.sup_insert]
    have hs : (∑ i ∈ s, h i).IsHomogeneous d :=
      IsHomogeneous.sum _ _ _ fun i hi => hh i (Finset.mem_insert_of_mem hi)
    exact (hN.map_add_le (hh j (Finset.mem_insert_self j s)) hs).trans
      (max_le_max le_rfl (ih fun i hi => hh i (Finset.mem_insert_of_mem hi)))

/-- A sum of forms of degree `d` with a strictly dominant term has the norm of that term. -/
theorem map_sum_eq_of_lt {ι : Type*} [DecidableEq ι] (s : Finset ι) {d : ℕ}
    {h : ι → MvPolynomial (Fin (n + 1)) k} (hh : ∀ i ∈ s, (h i).IsHomogeneous d) {j : ι}
    (hj : j ∈ s) (hlt : ∀ i ∈ s, i ≠ j → N d (h i) < N d (h j)) :
    N d (∑ i ∈ s, h i) = N d (h j) := by
  rw [← Finset.add_sum_erase s h hj]
  rcases (s.erase j).eq_empty_or_nonempty with he | he
  · rw [he, Finset.sum_empty, add_zero]
  refine hN.map_add_eq_of_lt (hh j hj) (IsHomogeneous.sum _ _ _ fun i hi =>
    hh i (Finset.mem_of_mem_erase hi)) ?_
  refine (hN.map_sum_le _ fun i hi => hh i (Finset.mem_of_mem_erase hi)).trans_lt ?_
  obtain ⟨i, hi⟩ := he
  have hpos : (⊥ : ℝ≥0) < N d (h j) :=
    zero_le.trans_lt (hlt i (Finset.mem_of_mem_erase hi) (Finset.ne_of_mem_erase hi))
  exact (Finset.sup_lt_iff hpos).2 fun i hi =>
    hlt i (Finset.mem_of_mem_erase hi) (Finset.ne_of_mem_erase hi)

end IsGradedNorm

/-- The **graded extension** `|f| = max_d N d (f_d)` of a family `N` on forms, the maximum over
the homogeneous components `f_d` of `f`. -/
def gradedFun (N : ℕ → MvPolynomial (Fin (n + 1)) k → ℝ≥0) (f : MvPolynomial (Fin (n + 1)) k) :
    ℝ≥0 :=
  (Finset.range (f.totalDegree + 1)).sup fun d => N d (homogeneousComponent d f)

theorem exists_eq_gradedFun (N : ℕ → MvPolynomial (Fin (n + 1)) k → ℝ≥0)
    (f : MvPolynomial (Fin (n + 1)) k) : ∃ d, gradedFun N f = N d (homogeneousComponent d f) := by
  obtain ⟨d, -, hd⟩ := Finset.exists_mem_eq_sup (Finset.range (f.totalDegree + 1))
    Finset.nonempty_range_add_one fun d => N d (homogeneousComponent d f)
  exact ⟨d, hd⟩

namespace IsGradedNorm

variable {N : ℕ → MvPolynomial (Fin (n + 1)) k → ℝ≥0} (hN : IsGradedNorm N)
include hN

theorem le_gradedFun (f : MvPolynomial (Fin (n + 1)) k) (d : ℕ) :
    N d (homogeneousComponent d f) ≤ gradedFun N f := by
  by_cases hd : d ≤ f.totalDegree
  · exact Finset.le_sup (f := fun d => N d (homogeneousComponent d f))
      (Finset.mem_range.2 (Nat.lt_succ_of_le hd))
  · rw [homogeneousComponent_eq_zero d f (not_le.1 hd), hN.map_zero]
    exact zero_le

omit hN in
theorem gradedFun_le_iff (f : MvPolynomial (Fin (n + 1)) k) (r : ℝ≥0) (hN : IsGradedNorm N) :
    gradedFun N f ≤ r ↔ ∀ d, N d (homogeneousComponent d f) ≤ r :=
  ⟨fun h d => (hN.le_gradedFun f d).trans h, fun h => Finset.sup_le fun d _ => h d⟩

/-- On a form of degree `d` the graded extension is `N d`. -/
theorem gradedFun_of_isHomogeneous {d : ℕ} {f : MvPolynomial (Fin (n + 1)) k}
    (hf : f.IsHomogeneous d) : gradedFun N f = N d f := by
  refine le_antisymm ((gradedFun_le_iff f _ hN).2 fun c => ?_) ?_
  · rw [homogeneousComponent_of_mem hf]
    split_ifs with h
    · rw [h]
    · rw [hN.map_zero]; exact zero_le
  · calc N d f = N d (homogeneousComponent d f) := by rw [homogeneousComponent_eq_self hf]
      _ ≤ gradedFun N f := hN.le_gradedFun f d

theorem gradedFun_add_le (f g : MvPolynomial (Fin (n + 1)) k) :
    gradedFun N (f + g) ≤ max (gradedFun N f) (gradedFun N g) := by
  refine (gradedFun_le_iff _ _ hN).2 fun d => ?_
  rw [map_add]
  exact (hN.map_add_le (homogeneousComponent_isHomogeneous d f)
    (homogeneousComponent_isHomogeneous d g)).trans
    (max_le_max (hN.le_gradedFun f d) (hN.le_gradedFun g d))

theorem gradedFun_mul_le (f g : MvPolynomial (Fin (n + 1)) k) :
    gradedFun N (f * g) ≤ gradedFun N f * gradedFun N g := by
  refine (gradedFun_le_iff _ _ hN).2 fun c => ?_
  rw [homogeneousComponent_mul]
  refine (hN.map_sum_le _ fun p hp => ?_).trans (Finset.sup_le fun p hp => ?_)
  · rw [← Finset.HasAntidiagonal.mem_antidiagonal.1 hp]
    exact (homogeneousComponent_isHomogeneous _ f).mul (homogeneousComponent_isHomogeneous _ g)
  · have h : N c (homogeneousComponent p.1 f * homogeneousComponent p.2 g) =
        N p.1 (homogeneousComponent p.1 f) * N p.2 (homogeneousComponent p.2 g) := by
      rw [← Finset.HasAntidiagonal.mem_antidiagonal.1 hp]
      exact hN.map_mul (homogeneousComponent_isHomogeneous _ f)
        (homogeneousComponent_isHomogeneous _ g)
    rw [h]
    exact mul_le_mul' (hN.le_gradedFun f _) (hN.le_gradedFun g _)

/-- Multiplicativity of the graded extension: for the minimal degrees `i`, `j` where the maxima
for `f`, `g` are attained, `(fg)_{i+j}` has the unique dominant term `f_i g_j`. -/
theorem mul_le_gradedFun_mul (f g : MvPolynomial (Fin (n + 1)) k) :
    gradedFun N f * gradedFun N g ≤ gradedFun N (f * g) := by
  classical
  by_cases hF : gradedFun N f = 0
  · rw [hF, zero_mul]; exact zero_le
  by_cases hG : gradedFun N g = 0
  · rw [hG, mul_zero]; exact zero_le
  have hFpos : 0 < gradedFun N f := pos_iff_ne_zero.2 hF
  have hGpos : 0 < gradedFun N g := pos_iff_ne_zero.2 hG
  have hexF := exists_eq_gradedFun N f
  have hexG := exists_eq_gradedFun N g
  set i := Nat.find hexF
  set j := Nat.find hexG
  have hi : gradedFun N f = N i (homogeneousComponent i f) := Nat.find_spec hexF
  have hj : gradedFun N g = N j (homogeneousComponent j g) := Nat.find_spec hexG
  have hi' : ∀ a < i, N a (homogeneousComponent a f) < gradedFun N f := fun a ha =>
    lt_of_le_of_ne (hN.le_gradedFun f a) fun h => Nat.find_min hexF ha h.symm
  have hj' : ∀ b < j, N b (homogeneousComponent b g) < gradedFun N g := fun b hb =>
    lt_of_le_of_ne (hN.le_gradedFun g b) fun h => Nat.find_min hexG hb h.symm
  have key : N (i + j) (homogeneousComponent i f * homogeneousComponent j g) =
      gradedFun N f * gradedFun N g := by
    rw [hN.map_mul (homogeneousComponent_isHomogeneous _ f)
      (homogeneousComponent_isHomogeneous _ g), ← hi, ← hj]
  refine le_trans ?_ (hN.le_gradedFun (f * g) (i + j))
  rw [homogeneousComponent_mul, hN.map_sum_eq_of_lt _ (fun p hp => ?_) (j := (i, j))
    (Finset.HasAntidiagonal.mem_antidiagonal.2 rfl) (fun p hp hne => ?_), key]
  · rw [← Finset.HasAntidiagonal.mem_antidiagonal.1 hp]
    exact (homogeneousComponent_isHomogeneous _ f).mul (homogeneousComponent_isHomogeneous _ g)
  · rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
    have h : N (i + j) (homogeneousComponent p.1 f * homogeneousComponent p.2 g) =
        N p.1 (homogeneousComponent p.1 f) * N p.2 (homogeneousComponent p.2 g) := by
      rw [← hp]
      exact hN.map_mul (homogeneousComponent_isHomogeneous _ f)
        (homogeneousComponent_isHomogeneous _ g)
    rw [h, key]
    have hp1 : p.1 ≠ i := by
      intro h1
      apply hne
      ext
      · exact h1
      · simp only; omega
    rcases lt_or_gt_of_ne hp1 with h1 | h1
    · calc N p.1 (homogeneousComponent p.1 f) * N p.2 (homogeneousComponent p.2 g)
          ≤ N p.1 (homogeneousComponent p.1 f) * gradedFun N g := by
            gcongr; exact hN.le_gradedFun g _
        _ < gradedFun N f * gradedFun N g := by
            gcongr; exact hi' _ h1
    · have h2 : p.2 < j := by omega
      calc N p.1 (homogeneousComponent p.1 f) * N p.2 (homogeneousComponent p.2 g)
          ≤ gradedFun N f * N p.2 (homogeneousComponent p.2 g) := by
            gcongr; exact hN.le_gradedFun f _
        _ < gradedFun N f * gradedFun N g := by
            gcongr; exact hj' _ h2

theorem gradedFun_mul (f g : MvPolynomial (Fin (n + 1)) k) :
    gradedFun N (f * g) = gradedFun N f * gradedFun N g :=
  le_antisymm (hN.gradedFun_mul_le f g) (hN.mul_le_gradedFun_mul f g)

/-- The graded extension as a valuation on `k[x₀, …, xₙ]`. -/
def valuation : Valuation (MvPolynomial (Fin (n + 1)) k) ℝ≥0 where
  toFun := gradedFun N
  map_zero' := by
    rw [hN.gradedFun_of_isHomogeneous (isHomogeneous_zero (Fin (n + 1)) k 0), hN.map_zero]
  map_one' := by
    rw [hN.gradedFun_of_isHomogeneous (isHomogeneous_one (Fin (n + 1)) k)]
    have h := hN.map_C 1 one_ne_zero
    rwa [C_1] at h
  map_mul' := hN.gradedFun_mul
  map_add_le_max' := hN.gradedFun_add_le

theorem valuation_apply (f : MvPolynomial (Fin (n + 1)) k) : hN.valuation f = gradedFun N f :=
  rfl

end IsGradedNorm

/-- **Graded extension** (`lem:bj-graded-extension`): a family `N` of norms on forms satisfying
`IsGradedNorm` defines the point `|f| = max_d N d (f_d)` of `(ℙⁿ)^an`. -/
def ofGradedNorm {N : ℕ → MvPolynomial (Fin (n + 1)) k → ℝ≥0} (hN : IsGradedNorm N) :
    ProjBerk k n :=
  ⟨⟨hN.valuation, fun c hc => by
      rw [hN.valuation_apply, algebraMap_eq, hN.gradedFun_of_isHomogeneous (isHomogeneous_C _ c),
        hN.map_C c hc]⟩,
    (isGraded_iff _).2 fun f d => by
      change gradedFun N (homogeneousComponent d f) ≤ gradedFun N f
      rw [hN.gradedFun_of_isHomogeneous (homogeneousComponent_isHomogeneous d f)]
      exact hN.le_gradedFun f d,
    by
      change Finset.univ.sup (fun i => gradedFun N (X i)) = 1
      simp_rw [hN.gradedFun_of_isHomogeneous (isHomogeneous_X k _)]
      exact hN.sup_X⟩

section ofGradedNorm

variable {N : ℕ → MvPolynomial (Fin (n + 1)) k → ℝ≥0} (hN : IsGradedNorm N)

theorem ofGradedNorm_val_apply (f : MvPolynomial (Fin (n + 1)) k) :
    (ofGradedNorm hN).1.val f = gradedFun N f :=
  rfl

/-- On a form `f` of degree `d`, `|f|_{ofGradedNorm N} = N d f`. -/
theorem ofGradedNorm_val_of_isHomogeneous {d : ℕ} {f : MvPolynomial (Fin (n + 1)) k}
    (hf : f.IsHomogeneous d) : (ofGradedNorm hN).1.val f = N d f :=
  hN.gradedFun_of_isHomogeneous hf

end ofGradedNorm

/-- A point of `(ℙⁿ)^an` is determined by its values on forms (it is graded). -/
theorem ext_of_isHomogeneous {v w : ProjBerk k n}
    (h : ∀ (d : ℕ) (f : MvPolynomial (Fin (n + 1)) k), f.IsHomogeneous d →
      v.1.val f = w.1.val f) : v = w := by
  refine ProjBerk.ext (Berk.ext_val fun f => ?_)
  rw [v.isGraded f, w.isGraded f]
  exact Finset.sup_congr rfl fun d _ => h d _ (homogeneousComponent_isHomogeneous d f)

/-- Every point of `(ℙⁿ)^an` is the graded extension of its values on forms. -/
theorem isGradedNorm_val (v : ProjBerk k n) :
    IsGradedNorm fun (_ : ℕ) (f : MvPolynomial (Fin (n + 1)) k) => v.1.val f where
  map_zero _ := map_zero _
  map_C c hc := by rw [← algebraMap_eq]; exact v.1.val_algebraMap c hc
  map_mul _ _ := map_mul _ _ _
  map_add_le _ _ := v.1.val.map_add _ _
  sup_X := v.sup_val_X

theorem ofGradedNorm_val (v : ProjBerk k n) : ofGradedNorm (isGradedNorm_val v) = v :=
  ext_of_isHomogeneous fun _ _ hf => ofGradedNorm_val_of_isHomogeneous _ hf


/-! ### The chart algebra `A_σ` -/

section ChartAlg

variable (σ : MvPolynomial (Fin (n + 1)) k) (e : ℕ)

/-- The fraction `τ / σ ^ N` in the localization `R_σ`. -/
def frac (N : ℕ) (τ : MvPolynomial (Fin (n + 1)) k) : Localization.Away σ :=
  algebraMap _ _ τ * (IsLocalization.Away.invSelf σ : Localization.Away σ) ^ N

variable {σ}

theorem frac_eq_mk' (N : ℕ) (τ : MvPolynomial (Fin (n + 1)) k) :
    frac σ N τ = IsLocalization.mk' (Localization.Away σ) τ
      (⟨σ ^ N, N, rfl⟩ : Submonoid.powers σ) :=
  (Berk.Away.mk'_eq_algebraMap_mul_invSelf_pow _ σ τ N).symm

theorem frac_mul (N₁ N₂ : ℕ) (τ₁ τ₂ : MvPolynomial (Fin (n + 1)) k) :
    frac σ (N₁ + N₂) (τ₁ * τ₂) = frac σ N₁ τ₁ * frac σ N₂ τ₂ := by
  simp only [frac, map_mul, pow_add]; ring

theorem frac_add (N : ℕ) (τ₁ τ₂ : MvPolynomial (Fin (n + 1)) k) :
    frac σ N (τ₁ + τ₂) = frac σ N τ₁ + frac σ N τ₂ := by
  simp only [frac, map_add, add_mul]

theorem frac_zero (N : ℕ) : frac σ N (0 : MvPolynomial (Fin (n + 1)) k) = 0 := by
  simp [frac]

theorem frac_smul (N : ℕ) (c : k) (τ : MvPolynomial (Fin (n + 1)) k) :
    frac σ N (c • τ) = c • frac σ N τ := by
  simp only [frac, Algebra.smul_def, map_mul, mul_assoc]
  rw [← IsScalarTower.algebraMap_apply]

theorem frac_pow (N m : ℕ) (τ : MvPolynomial (Fin (n + 1)) k) :
    frac σ (N * m) (τ ^ m) = frac σ N τ ^ m := by
  simp only [frac, map_pow, mul_pow, pow_mul]

theorem frac_zero_left (τ : MvPolynomial (Fin (n + 1)) k) : frac σ 0 τ = algebraMap _ _ τ := by
  simp [frac]

/-- Expanding a fraction: `τ σ^M / σ^{N + M} = τ / σ^N`. -/
theorem frac_mul_pow_self (N M : ℕ) (τ : MvPolynomial (Fin (n + 1)) k) :
    frac σ (N + M) (τ * σ ^ M) = frac σ N τ := by
  have h := IsLocalization.Away.mul_invSelf (S := Localization.Away σ) σ
  calc frac σ (N + M) (τ * σ ^ M) = frac σ N τ *
        (algebraMap _ _ σ * (IsLocalization.Away.invSelf σ : Localization.Away σ)) ^ M := by
        simp only [frac, map_mul, map_pow, pow_add, mul_pow]; ring
    _ = frac σ N τ := by rw [h, one_pow, mul_one]

theorem frac_pow_self (N : ℕ) : frac σ N (σ ^ N) = 1 := by
  have h := frac_mul_pow_self (σ := σ) 0 N 1
  rwa [zero_add, one_mul, frac_zero_left, map_one] at h

variable (σ)

/-- The **chart algebra** `A_σ = (R_σ)_0`, the degree-zero part of the localization of
`R = k[x₀, …, xₙ]` at a form `σ` of degree `e`: the `k`-subalgebra of `R_σ` generated by the
fractions `τ / σ^N` with `τ` a form of degree `N e`. For `σ` homogeneous of degree `e`, these
fractions already form a subalgebra (`mem_chartAlg_iff`). -/
def chartAlg : Subalgebra k (Localization.Away σ) :=
  Algebra.adjoin k {a | ∃ (N : ℕ) (τ : MvPolynomial (Fin (n + 1)) k),
    τ.IsHomogeneous (N * e) ∧ a = frac σ N τ}

variable {σ e}

theorem frac_mem_chartAlg {N : ℕ} {τ : MvPolynomial (Fin (n + 1)) k}
    (hτ : τ.IsHomogeneous (N * e)) : frac σ N τ ∈ chartAlg σ e :=
  Algebra.subset_adjoin ⟨N, τ, hτ, rfl⟩

/-- Every element of `A_σ` is a fraction `τ / σ^N` with `τ` a form of degree `N e`. -/
theorem mem_chartAlg_iff (hσ : σ.IsHomogeneous e) {a : Localization.Away σ} :
    a ∈ chartAlg σ e ↔ ∃ (N : ℕ) (τ : MvPolynomial (Fin (n + 1)) k),
      τ.IsHomogeneous (N * e) ∧ a = frac σ N τ := by
  refine ⟨fun ha => ?_, fun ⟨N, τ, hτ, h⟩ => h ▸ frac_mem_chartAlg hτ⟩
  induction ha using Algebra.adjoin_induction with
  | mem a ha => exact ha
  | algebraMap c =>
    refine ⟨0, C c, by rw [zero_mul]; exact isHomogeneous_C _ c, ?_⟩
    rw [frac_zero_left, ← algebraMap_eq, ← IsScalarTower.algebraMap_apply]
  | add a b _ _ ha hb =>
    obtain ⟨N₁, τ₁, h₁, rfl⟩ := ha
    obtain ⟨N₂, τ₂, h₂, rfl⟩ := hb
    refine ⟨N₁ + N₂, τ₁ * σ ^ N₂ + τ₂ * σ ^ N₁, ?_, ?_⟩
    · refine IsHomogeneous.add ?_ ?_
      · have := h₁.mul (hσ.pow N₂)
        rwa [show N₁ * e + e * N₂ = (N₁ + N₂) * e by ring] at this
      · have := h₂.mul (hσ.pow N₁)
        rwa [show N₂ * e + e * N₁ = (N₁ + N₂) * e by ring] at this
    · rw [frac_add, frac_mul_pow_self, add_comm N₁ N₂, frac_mul_pow_self]
  | mul a b _ _ ha hb =>
    obtain ⟨N₁, τ₁, h₁, rfl⟩ := ha
    obtain ⟨N₂, τ₂, h₂, rfl⟩ := hb
    refine ⟨N₁ + N₂, τ₁ * τ₂, ?_, (frac_mul _ _ _ _).symm⟩
    have := h₁.mul h₂
    rwa [show N₁ * e + N₂ * e = (N₁ + N₂) * e by ring] at this

variable (σ e)

/-- The element `τ_{Ne} / σ^N` of `A_σ`, where `τ_{Ne}` is the homogeneous component of degree
`N e` of `τ`; for a form `τ` of degree `N e` this is `τ / σ^N` (`coe_chartMk`). -/
def chartMk (N : ℕ) (τ : MvPolynomial (Fin (n + 1)) k) : chartAlg σ e :=
  ⟨frac σ N (homogeneousComponent (N * e) τ),
    frac_mem_chartAlg (homogeneousComponent_isHomogeneous _ _)⟩

variable {σ e}

theorem coe_chartMk' (N : ℕ) (τ : MvPolynomial (Fin (n + 1)) k) :
    (chartMk σ e N τ : Localization.Away σ) = frac σ N (homogeneousComponent (N * e) τ) :=
  rfl

theorem coe_chartMk {N : ℕ} {τ : MvPolynomial (Fin (n + 1)) k} (hτ : τ.IsHomogeneous (N * e)) :
    (chartMk σ e N τ : Localization.Away σ) = frac σ N τ := by
  rw [coe_chartMk', homogeneousComponent_eq_self hτ]

theorem chartMk_homogeneousComponent (N : ℕ) (τ : MvPolynomial (Fin (n + 1)) k) :
    chartMk σ e N (homogeneousComponent (N * e) τ) = chartMk σ e N τ :=
  Subtype.ext (by
    rw [coe_chartMk', coe_chartMk',
      homogeneousComponent_eq_self (homogeneousComponent_isHomogeneous _ _)])

/-- Every element of `A_σ` is `τ / σ^N` for a form `τ` of degree `N e`. -/
theorem exists_eq_chartMk (hσ : σ.IsHomogeneous e) (a : chartAlg σ e) :
    ∃ (N : ℕ) (τ : MvPolynomial (Fin (n + 1)) k), τ.IsHomogeneous (N * e) ∧
      a = chartMk σ e N τ := by
  obtain ⟨N, τ, hτ, h⟩ := (mem_chartAlg_iff hσ).1 a.2
  exact ⟨N, τ, hτ, Subtype.ext (by rw [coe_chartMk hτ, h])⟩

theorem chartMk_add (N : ℕ) (τ₁ τ₂ : MvPolynomial (Fin (n + 1)) k) :
    chartMk σ e N (τ₁ + τ₂) = chartMk σ e N τ₁ + chartMk σ e N τ₂ :=
  Subtype.ext (by simp only [chartMk, map_add, frac_add]; rfl)

theorem chartMk_zero (N : ℕ) : chartMk σ e N (0 : MvPolynomial (Fin (n + 1)) k) = 0 :=
  Subtype.ext (by simp only [chartMk, map_zero, frac_zero]; rfl)

theorem chartMk_smul (N : ℕ) (c : k) (τ : MvPolynomial (Fin (n + 1)) k) :
    chartMk σ e N (c • τ) = c • chartMk σ e N τ :=
  Subtype.ext (by simp only [chartMk, map_smul, frac_smul]; rfl)

theorem chartMk_sum {ι : Type*} (s : Finset ι) (N : ℕ) (τ : ι → MvPolynomial (Fin (n + 1)) k) :
    chartMk σ e N (∑ i ∈ s, τ i) = ∑ i ∈ s, chartMk σ e N (τ i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [chartMk_zero]
  | insert j s hj ih => rw [Finset.sum_insert hj, Finset.sum_insert hj, chartMk_add, ih]

theorem chartMk_C (c : k) : chartMk σ e 0 (C c) = algebraMap k (chartAlg σ e) c :=
  Subtype.ext (by
    rw [coe_chartMk (by rw [zero_mul]; exact isHomogeneous_C _ c), frac_zero_left, ← algebraMap_eq,
      ← IsScalarTower.algebraMap_apply]
    rfl)

theorem chartMk_mul {N₁ N₂ : ℕ} {τ₁ τ₂ : MvPolynomial (Fin (n + 1)) k}
    (h₁ : τ₁.IsHomogeneous (N₁ * e)) (h₂ : τ₂.IsHomogeneous (N₂ * e)) :
    chartMk σ e (N₁ + N₂) (τ₁ * τ₂) = chartMk σ e N₁ τ₁ * chartMk σ e N₂ τ₂ := by
  have h : (τ₁ * τ₂).IsHomogeneous ((N₁ + N₂) * e) := by rw [add_mul]; exact h₁.mul h₂
  exact Subtype.ext (by
    rw [Subalgebra.coe_mul, coe_chartMk h, coe_chartMk h₁, coe_chartMk h₂, frac_mul])

theorem chartMk_pow {N : ℕ} {τ : MvPolynomial (Fin (n + 1)) k} (hτ : τ.IsHomogeneous (N * e))
    (m : ℕ) : chartMk σ e (N * m) (τ ^ m) = chartMk σ e N τ ^ m := by
  have h : (τ ^ m).IsHomogeneous (N * m * e) := by
    rw [show N * m * e = N * e * m by ring]; exact hτ.pow m
  exact Subtype.ext (by
    rw [SubmonoidClass.coe_pow, coe_chartMk h, coe_chartMk hτ, frac_pow])

theorem chartMk_prod {ι : Type*} (s : Finset ι) {N : ι → ℕ} {τ : ι → MvPolynomial (Fin (n + 1)) k}
    (hτ : ∀ i ∈ s, (τ i).IsHomogeneous (N i * e)) :
    chartMk σ e (∑ i ∈ s, N i) (∏ i ∈ s, τ i) = ∏ i ∈ s, chartMk σ e (N i) (τ i) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty, Finset.prod_empty]
    rw [← C_1, chartMk_C, map_one]
  | insert j s hj ih =>
    rw [Finset.sum_insert hj, Finset.prod_insert hj, Finset.prod_insert hj,
      chartMk_mul (hτ j (Finset.mem_insert_self j s)), ih fun i hi => hτ i
        (Finset.mem_insert_of_mem hi)]
    rw [Finset.sum_mul]
    exact IsHomogeneous.prod _ _ _ fun i hi => hτ i (Finset.mem_insert_of_mem hi)

theorem chartMk_pow_self (hσ : σ.IsHomogeneous e) (N : ℕ) : chartMk σ e N (σ ^ N) = 1 :=
  Subtype.ext (by
    rw [coe_chartMk (by rw [mul_comm]; exact hσ.pow N), frac_pow_self]
    rfl)

theorem chartMk_mul_pow_self (hσ : σ.IsHomogeneous e) {N : ℕ} {τ : MvPolynomial (Fin (n + 1)) k}
    (hτ : τ.IsHomogeneous (N * e)) (M : ℕ) :
    chartMk σ e (N + M) (τ * σ ^ M) = chartMk σ e N τ := by
  have h : (τ * σ ^ M).IsHomogeneous ((N + M) * e) := by
    rw [add_mul, mul_comm M]; exact hτ.mul (hσ.pow M)
  exact Subtype.ext (by rw [coe_chartMk h, coe_chartMk hτ, frac_mul_pow_self])

/-! ### Generators of `A_σ` -/

variable (σ e)

/-- The generator `x^α / σ` of `A_σ` attached to a multi-index `α` (for `|α| = e`). -/
def chartGen (α : Fin (n + 1) →₀ ℕ) : chartAlg σ e :=
  chartMk σ e 1 (monomial α 1)

open Classical in
/-- The finite set of generators `x^α / σ`, `|α| = e`, of `A_σ`. -/
def chartGens : Finset (chartAlg σ e) :=
  (Finset.finsuppAntidiag Finset.univ e).image (chartGen σ e)

variable {σ e}

theorem mem_finsuppAntidiag_univ {α : Fin (n + 1) →₀ ℕ} :
    α ∈ Finset.finsuppAntidiag Finset.univ e ↔ α.degree = e := by
  rw [Finset.mem_finsuppAntidiag, Finsupp.degree_eq_sum]
  simp

theorem coe_chartGens : (chartGens σ e : Set (chartAlg σ e)) =
    chartGen σ e '' {α | α.degree = e} := by
  classical
  ext a
  simp only [chartGens, Finset.coe_image, Set.mem_image, Finset.mem_coe, mem_finsuppAntidiag_univ]
  rfl

theorem chartMk_monomial_mem_adjoin :
    ∀ (N : ℕ) (β : Fin (n + 1) →₀ ℕ), β.degree = N * e →
      chartMk σ e N (monomial β 1) ∈ Algebra.adjoin k (chartGen σ e '' {α | α.degree = e})
  | 0, β, h => by
    rw [zero_mul, Finsupp.degree_eq_zero_iff] at h
    subst h
    rw [monomial_zero', chartMk_C, map_one]
    exact Subalgebra.one_mem _
  | N + 1, β, h => by
    obtain ⟨α, hα, hdeg⟩ := exists_le_degree_eq (show e ≤ β.degree by rw [h]; nlinarith)
    have hβ : β = α + (β - α) := (add_tsub_cancel_of_le hα).symm
    have hdeg' : (β - α).degree = N * e := by
      have h' := congrArg Finsupp.degree hβ
      rw [map_add, hdeg, h] at h'
      linarith
    rw [hβ, show monomial (α + (β - α)) (1 : k) = monomial α 1 * monomial (β - α) 1 by
      rw [monomial_mul, one_mul], add_comm N 1,
      chartMk_mul (isHomogeneous_monomial _ (by rw [hdeg, one_mul]))
        (isHomogeneous_monomial _ hdeg')]
    exact Subalgebra.mul_mem _ (Algebra.subset_adjoin ⟨α, hdeg, rfl⟩)
      (chartMk_monomial_mem_adjoin N (β - α) hdeg')

/-- `A_σ` is generated by the `x^α / σ` with `|α| = e` (`lem:bj-chart`(1)). -/
theorem adjoin_chartGen (hσ : σ.IsHomogeneous e) :
    Algebra.adjoin k (chartGen σ e '' {α | α.degree = e}) = ⊤ := by
  refine eq_top_iff.2 fun a _ => ?_
  obtain ⟨N, τ, hτ, rfl⟩ := exists_eq_chartMk hσ a
  rw [τ.as_sum, chartMk_sum]
  refine Subalgebra.sum_mem _ fun β hβ => ?_
  rw [show monomial β (coeff β τ) = coeff β τ • monomial β 1 by
    rw [smul_monomial, smul_eq_mul, mul_one], chartMk_smul]
  refine Subalgebra.smul_mem _ (chartMk_monomial_mem_adjoin N β ?_) _
  rw [Finsupp.degree_eq_weight_one]
  exact hτ (mem_support_iff.1 hβ)

theorem adjoin_chartGens (hσ : σ.IsHomogeneous e) :
    Algebra.adjoin k (chartGens σ e : Set (chartAlg σ e)) = ⊤ := by
  rw [coe_chartGens, adjoin_chartGen hσ]

/-- `A_σ` is a finitely generated `k`-algebra. -/
theorem finiteType_chartAlg (hσ : σ.IsHomogeneous e) : Algebra.FiniteType k (chartAlg σ e) :=
  ⟨⟨chartGens σ e, adjoin_chartGens hσ⟩⟩

end ChartAlg

/-! ### The chart map `ι_σ : U_σ → (Spec A_σ)^an` -/

section ChartMap

variable (σ : MvPolynomial (Fin (n + 1)) k) (e : ℕ)

/-- The chart `U_σ = {v : |σ|_v ≠ 0} ⊆ (ℙⁿ)^an`. -/
def chartDomain : Set (ProjBerk k n) := {v | v.1.val σ ≠ 0}

theorem isOpen_chartDomain : IsOpen (chartDomain σ) :=
  (Berk.isOpen_setOf_val_ne_zero σ).preimage continuous_val

/-- The chart map `ι_σ(v)(τ / σ^N) = |τ|_v / |σ|_v^N` (`lem:bj-chart`(2)): the restriction to
`A_σ` of the extension of `v` to `R_σ`. -/
def chartMap (v : ProjBerk k n) (hv : v.1.val σ ≠ 0) : Berk k (chartAlg σ e) :=
  Berk.comap (chartAlg σ e).val (Berk.awayLift σ v.1 hv)

variable {σ e}

theorem chartMap_val_apply (v : ProjBerk k n) (hv : v.1.val σ ≠ 0) (a : chartAlg σ e) :
    (chartMap σ e v hv).val a = (Berk.awayLift σ v.1 hv).val (a : Localization.Away σ) :=
  rfl

theorem awayLift_val_frac (v : ProjBerk k n) (hv : v.1.val σ ≠ 0) (N : ℕ)
    (τ : MvPolynomial (Fin (n + 1)) k) :
    (Berk.awayLift σ v.1 hv).val (frac σ N τ) = v.1.val τ / v.1.val σ ^ N := by
  rw [frac_eq_mk', Berk.awayLift_val_mk']

theorem chartMap_val_chartMk (v : ProjBerk k n) (hv : v.1.val σ ≠ 0) (N : ℕ)
    (τ : MvPolynomial (Fin (n + 1)) k) :
    (chartMap σ e v hv).val (chartMk σ e N τ) =
      v.1.val (homogeneousComponent (N * e) τ) / v.1.val σ ^ N := by
  rw [chartMap_val_apply, coe_chartMk', awayLift_val_frac]

/-- `|τ / σ^N|_{ι_σ(v)} = |τ|_v / |σ|_v^N` for a form `τ` of degree `N e`. -/
theorem chartMap_val_chartMk_of_isHomogeneous (v : ProjBerk k n) (hv : v.1.val σ ≠ 0) {N : ℕ}
    {τ : MvPolynomial (Fin (n + 1)) k} (hτ : τ.IsHomogeneous (N * e)) :
    (chartMap σ e v hv).val (chartMk σ e N τ) = v.1.val τ / v.1.val σ ^ N := by
  rw [chartMap_val_chartMk, homogeneousComponent_eq_self hτ]

/-- `log|τ / σ^N| ∘ ι_σ = log|τ| - N log|σ|` on `U_σ` (`lem:bj-chart`(3)). -/
theorem logAbs_chartMap_chartMk (v : ProjBerk k n) (hv : v.1.val σ ≠ 0) {N : ℕ}
    {τ : MvPolynomial (Fin (n + 1)) k} (hτ : τ.IsHomogeneous (N * e)) :
    Berk.logAbs (chartMk σ e N τ) (chartMap σ e v hv) = logAbs τ v - N * logAbs σ v := by
  rw [chartMap, Berk.logAbs_comap, Subalgebra.coe_val, coe_chartMk hτ, frac_eq_mk',
    Berk.logAbs_awayComap_mk', Berk.awayComap_awayLift]
  rfl

theorem continuous_chartMap :
    Continuous fun v : chartDomain σ => chartMap σ e v.1 v.2 := by
  rw [Berk.continuous_iff]
  intro a
  have h : Continuous fun v : chartDomain σ =>
      (⟨v.1.1, v.2⟩ : {x : Berk k (MvPolynomial (Fin (n + 1)) k) // x.val σ ≠ 0}) :=
    (continuous_val.comp continuous_subtype_val).subtype_mk _
  exact (Berk.continuous_abs (a : Localization.Away σ)).comp ((Berk.continuous_awayLift σ).comp h)

/-! ### The scale `M(y) = max_i |xᵢ^e / σ|_y` -/

variable (σ e) in
/-- `M(y) = max_i |xᵢ^e / σ|_y` for `y ∈ (Spec A_σ)^an`; at `y = ι_σ(v)` it is `|σ|_v⁻¹`. -/
def chartScale (y : Berk k (chartAlg σ e)) : ℝ≥0 :=
  Finset.univ.sup fun i => y.val (chartMk σ e 1 (X i ^ e))

variable (σ e) in
theorem continuous_chartScale : Continuous (chartScale (k := k) (n := n) σ e) :=
  Continuous.finset_sup_apply fun _ _ => Berk.continuous_val_apply _

/-- `(x^α / σ)^e = ∏_i (xᵢ^e / σ)^{αᵢ}` for `|α| = e`. -/
theorem chartGen_pow {α : Fin (n + 1) →₀ ℕ} (hα : α.degree = e) :
    chartGen σ e α ^ e = ∏ i, chartMk σ e 1 (X i ^ e) ^ α i := by
  have h1 : (monomial α (1 : k)).IsHomogeneous (1 * e) :=
    isHomogeneous_monomial _ (by rw [hα, one_mul])
  rw [chartGen, ← chartMk_pow h1]
  have hmon : (monomial α (1 : k)) ^ e = ∏ i, (X i ^ e) ^ α i := by
    rw [monomial_eq, C_1, one_mul, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
      ← Finset.prod_pow]
    exact Finset.prod_congr rfl fun i _ => by rw [← pow_mul, ← pow_mul, mul_comm]
  have hsum : 1 * e = ∑ i, α i := by rw [one_mul, ← hα, Finsupp.degree_eq_sum]
  rw [hmon, hsum, chartMk_prod _ (fun i _ => by
    rw [mul_comm]; exact (isHomogeneous_X_pow i e).pow (α i))]
  refine Finset.prod_congr rfl fun i _ => ?_
  have h := chartMk_pow (σ := σ) (N := 1) (τ := X i ^ e)
    (by rw [one_mul]; exact isHomogeneous_X_pow i e) (α i)
  rwa [one_mul] at h

theorem val_chartGen_le_chartScale (he : 0 < e) (y : Berk k (chartAlg σ e))
    {α : Fin (n + 1) →₀ ℕ} (hα : α.degree = e) : y.val (chartGen σ e α) ≤ chartScale σ e y := by
  refine le_of_pow_le_pow_left₀ he.ne' zero_le ?_
  rw [← map_pow, chartGen_pow hα, map_prod]
  calc ∏ i, y.val (chartMk σ e 1 (X i ^ e) ^ α i) ≤ ∏ i, chartScale σ e y ^ α i := by
        refine Finset.prod_le_prod' fun i _ => ?_
        rw [map_pow]
        exact pow_le_pow_left₀ zero_le (Finset.le_sup (f := fun i =>
          y.val (chartMk σ e 1 (X i ^ e))) (Finset.mem_univ i)) _
    _ = chartScale σ e y ^ e := by
        rw [Finset.prod_pow_eq_pow_sum, ← Finsupp.degree_eq_sum, hα]

theorem val_smul_le (y : Berk k (chartAlg σ e)) (c : k) (a : chartAlg σ e) :
    y.val (c • a) ≤ y.val a := by
  rw [Algebra.smul_def, map_mul]
  exact mul_le_of_le_one_left zero_le (Berk.abs_algebraMap_le_one y c)

/-- `M(y) ≥ 1`: since `σ = ∑_α c_α x^α`, `1 = ∑_α c_α x^α/σ` in `A_σ`. -/
theorem one_le_chartScale (hσ : σ.IsHomogeneous e) (he : 0 < e) (y : Berk k (chartAlg σ e)) :
    1 ≤ chartScale σ e y := by
  have h1 : (1 : chartAlg σ e) = chartMk σ e 1 σ := by
    rw [← chartMk_pow_self hσ 1, pow_one]
  have h2 : chartMk σ e 1 σ = ∑ β ∈ σ.support, coeff β σ • chartGen σ e β := by
    rw [congrArg (chartMk σ e 1) σ.as_sum, chartMk_sum]
    refine Finset.sum_congr rfl fun β _ => ?_
    rw [chartGen, ← chartMk_smul, smul_monomial, smul_eq_mul, mul_one]
  rw [← y.val.map_one, h1, h2]
  refine y.val.map_sum_le fun β hβ => (val_smul_le y _ _).trans
    (val_chartGen_le_chartScale he y ?_)
  rw [Finsupp.degree_eq_weight_one]
  exact hσ (mem_support_iff.1 hβ)

theorem chartScale_pos (hσ : σ.IsHomogeneous e) (he : 0 < e) (y : Berk k (chartAlg σ e)) :
    0 < chartScale σ e y :=
  zero_lt_one.trans_le (one_le_chartScale hσ he y)

/-- At `ι_σ(v)`, `M = |σ|_v⁻¹` (as `max_i |xᵢ|_v = 1`). -/
theorem chartScale_chartMap (he : 0 < e) (v : ProjBerk k n) (hv : v.1.val σ ≠ 0) :
    chartScale σ e (chartMap σ e v hv) = (v.1.val σ)⁻¹ := by
  have h : ∀ i, (chartMap σ e v hv).val (chartMk σ e 1 (X i ^ e)) =
      (fun t : ℝ≥0 => t ^ e / v.1.val σ) (v.1.val (X i)) := fun i => by
    rw [chartMap_val_chartMk_of_isHomogeneous v hv (by rw [one_mul]; exact isHomogeneous_X_pow i e),
      pow_one, map_pow]
  have key := Finset.apply_sup_eq_sup_comp_of_linearOrder (s := Finset.univ)
    (f := fun i => v.1.val (X i)) (fun t : ℝ≥0 => t ^ e / v.1.val σ)
    (fun a b hab => div_le_div_of_nonneg_right (pow_le_pow_left₀ zero_le hab e) zero_le)
    (by simp [zero_pow he.ne'])
  rw [sup_val_X] at key
  simp only [Function.comp_def, one_pow, one_div] at key
  simp only [chartScale, h]
  exact key.symm

/-! ### The inverse chart by graded extension -/

variable (σ e) in
/-- The family `N_c(g) = (|g^e / σ^c|_y / M(y)^c)^{1/e}` on forms `g` of degree `c`, attached to
`y ∈ (Spec A_σ)^an` (proof of `lem:bj-chart`(2)). -/
def chartNorm (y : Berk k (chartAlg σ e)) (c : ℕ) (g : MvPolynomial (Fin (n + 1)) k) : ℝ≥0 :=
  (y.val (chartMk σ e c (g ^ e)) / chartScale σ e y ^ c) ^ ((e : ℝ)⁻¹)

/-- The ultrametric inequality for `|g^e / σ^c|`, via the binomial expansion of `(f + g)^e` and
`|f^i g^{e-i} / σ^c|^e = |f^e / σ^c|^i |g^e / σ^c|^{e-i}`. -/
theorem val_chartMk_add_pow_le (he : 0 < e) (y : Berk k (chartAlg σ e)) {d : ℕ}
    {f g : MvPolynomial (Fin (n + 1)) k} (hf : f.IsHomogeneous d) (hg : g.IsHomogeneous d) :
    y.val (chartMk σ e d ((f + g) ^ e)) ≤
      max (y.val (chartMk σ e d (f ^ e))) (y.val (chartMk σ e d (g ^ e))) := by
  rw [add_pow, chartMk_sum]
  refine y.val.map_sum_le fun m hm => ?_
  have hm' : m ≤ e := Nat.lt_succ_iff.1 (Finset.mem_range.1 hm)
  rw [show f ^ m * g ^ (e - m) * (e.choose m : MvPolynomial (Fin (n + 1)) k) =
      ((e.choose m : ℕ) : k) • (f ^ m * g ^ (e - m)) by
    rw [Nat.cast_smul_eq_nsmul, nsmul_eq_mul, mul_comm], chartMk_smul]
  refine (val_smul_le y _ _).trans ?_
  set Yf := y.val (chartMk σ e d (f ^ e))
  set Yg := y.val (chartMk σ e d (g ^ e))
  have hfe : (f ^ e).IsHomogeneous (d * e) := hf.pow e
  have hge : (g ^ e).IsHomogeneous (d * e) := hg.pow e
  have hfg : (f ^ m * g ^ (e - m)).IsHomogeneous (d * e) := by
    have := (hf.pow m).mul (hg.pow (e - m))
    rwa [← mul_add, Nat.add_sub_cancel' hm'] at this
  refine le_of_pow_le_pow_left₀ he.ne' zero_le ?_
  have h1 : chartMk σ e d (f ^ m * g ^ (e - m)) ^ e =
      chartMk σ e d (f ^ e) ^ m * chartMk σ e d (g ^ e) ^ (e - m) := by
    rw [← chartMk_pow hfg, ← chartMk_pow hfe, ← chartMk_pow hge]
    have h2 := chartMk_mul (σ := σ) (e := e) (N₁ := d * m) (N₂ := d * (e - m))
      (τ₁ := (f ^ e) ^ m) (τ₂ := (g ^ e) ^ (e - m))
      (by rw [show d * m * e = d * e * m by ring]; exact hfe.pow m)
      (by rw [show d * (e - m) * e = d * e * (e - m) by ring]; exact hge.pow (e - m))
    rw [← mul_add, Nat.add_sub_cancel' hm'] at h2
    rw [← h2]
    congr 1
    rw [mul_pow, ← pow_mul, ← pow_mul, ← pow_mul, ← pow_mul, mul_comm m e, mul_comm (e - m) e]
  rw [← map_pow, h1, map_mul, map_pow, map_pow]
  calc Yf ^ m * Yg ^ (e - m) ≤ max Yf Yg ^ m * max Yf Yg ^ (e - m) := by
        gcongr
        · exact le_max_left _ _
        · exact le_max_right _ _
    _ = max Yf Yg ^ e := by rw [← pow_add, Nat.add_sub_cancel' hm']

theorem isGradedNorm_chartNorm (hσ : σ.IsHomogeneous e) (he : 0 < e) (y : Berk k (chartAlg σ e)) :
    IsGradedNorm (chartNorm σ e y) where
  map_zero d := by
    rw [chartNorm, zero_pow he.ne', chartMk_zero, map_zero, zero_div,
      NNReal.zero_rpow (inv_ne_zero (Nat.cast_ne_zero.2 he.ne'))]
  map_C c hc := by
    rw [chartNorm, ← map_pow, chartMk_C, y.val_algebraMap _ (pow_ne_zero _ hc), pow_zero, div_one,
      NNReal.one_rpow]
  map_mul {d d'} {f g} hf hg := by
    rw [chartNorm, chartNorm, chartNorm, mul_pow, chartMk_mul (hf.pow e) (hg.pow e), map_mul,
      pow_add, mul_div_mul_comm, NNReal.mul_rpow]
  map_add_le {d} {f g} hf hg := by
    simp only [chartNorm]
    rw [← (NNReal.monotone_rpow_of_nonneg (by positivity : (0 : ℝ) ≤ (e : ℝ)⁻¹)).map_max]
    refine NNReal.rpow_le_rpow ?_ (by positivity)
    rw [max_div_div_right zero_le]
    exact div_le_div_of_nonneg_right (val_chartMk_add_pow_le he y hf hg) zero_le
  sup_X := by
    have hM := (chartScale_pos hσ he y).ne'
    have key := Finset.apply_sup_eq_sup_comp_of_linearOrder (s := Finset.univ)
      (f := fun i => y.val (chartMk σ e 1 (X i ^ e)))
      (fun t : ℝ≥0 => (t / chartScale σ e y ^ 1) ^ ((e : ℝ)⁻¹))
      (fun a b hab => NNReal.rpow_le_rpow (div_le_div_of_nonneg_right hab zero_le) (by positivity))
      (by simp [NNReal.zero_rpow (inv_ne_zero (Nat.cast_ne_zero.2 he.ne'))])
    simp only [Function.comp_def] at key
    simp only [chartNorm]
    rw [← key]
    change (chartScale σ e y / chartScale σ e y ^ 1) ^ _ = 1
    rw [pow_one, div_self hM, NNReal.one_rpow]

variable (σ e) in
/-- The inverse chart `(Spec A_σ)^an → U_σ`, the graded extension of `chartNorm`. -/
def chartInv (hσ : σ.IsHomogeneous e) (he : 0 < e) (y : Berk k (chartAlg σ e)) : ProjBerk k n :=
  ofGradedNorm (isGradedNorm_chartNorm hσ he y)

section chartInv

variable (hσ : σ.IsHomogeneous e) (he : 0 < e)
include hσ he

theorem chartInv_val_of_isHomogeneous (y : Berk k (chartAlg σ e)) {c : ℕ}
    {g : MvPolynomial (Fin (n + 1)) k} (hg : g.IsHomogeneous c) :
    (chartInv σ e hσ he y).1.val g = chartNorm σ e y c g :=
  ofGradedNorm_val_of_isHomogeneous _ hg

/-- `|σ|_{ι_σ⁻¹(y)} = M(y)⁻¹`. -/
theorem chartInv_val_self (y : Berk k (chartAlg σ e)) :
    (chartInv σ e hσ he y).1.val σ = (chartScale σ e y)⁻¹ := by
  rw [chartInv_val_of_isHomogeneous hσ he y hσ, chartNorm, chartMk_pow_self hσ e, map_one, one_div,
    ← inv_pow, NNReal.pow_rpow_inv_natCast _ he.ne']

theorem chartInv_val_ne_zero (y : Berk k (chartAlg σ e)) : (chartInv σ e hσ he y).1.val σ ≠ 0 := by
  rw [chartInv_val_self hσ he y]
  exact inv_ne_zero (chartScale_pos hσ he y).ne'

theorem chartInv_mem_chartDomain (y : Berk k (chartAlg σ e)) :
    chartInv σ e hσ he y ∈ chartDomain σ :=
  chartInv_val_ne_zero hσ he y

theorem chartMap_chartInv (y : Berk k (chartAlg σ e)) :
    chartMap σ e (chartInv σ e hσ he y) (chartInv_val_ne_zero hσ he y) = y := by
  have hM := (chartScale_pos hσ he y).ne'
  refine Berk.ext_val fun a => ?_
  obtain ⟨N, τ, hτ, rfl⟩ := exists_eq_chartMk hσ a
  rw [chartMap_val_chartMk_of_isHomogeneous _ _ hτ, chartInv_val_of_isHomogeneous hσ he y hτ,
    chartInv_val_self, chartNorm, chartMk_pow hτ e, map_pow, pow_mul, ← div_pow,
    NNReal.pow_rpow_inv_natCast _ he.ne', inv_pow, div_inv_eq_mul,
    div_mul_cancel₀ _ (pow_ne_zero _ hM)]

theorem chartInv_chartMap (v : ProjBerk k n) (hv : v.1.val σ ≠ 0) :
    chartInv σ e hσ he (chartMap σ e v hv) = v := by
  refine ext_of_isHomogeneous fun c g hg => ?_
  rw [chartInv_val_of_isHomogeneous hσ he _ hg, chartNorm, chartScale_chartMap he v hv,
    chartMap_val_chartMk_of_isHomogeneous v hv (hg.pow e), map_pow, inv_pow, div_inv_eq_mul,
    div_mul_cancel₀ _ (pow_ne_zero _ hv), NNReal.pow_rpow_inv_natCast _ he.ne']

theorem continuous_chartNorm (d : ℕ) (g : MvPolynomial (Fin (n + 1)) k) :
    Continuous fun y : Berk k (chartAlg σ e) => chartNorm σ e y d g := by
  have h1 : Continuous fun y : Berk k (chartAlg σ e) => y.val (chartMk σ e d (g ^ e)) :=
    Berk.continuous_val_apply _
  have h2 : Continuous fun y : Berk k (chartAlg σ e) => chartScale σ e y ^ d :=
    (continuous_chartScale σ e).pow d
  have h3 : Continuous fun y : Berk k (chartAlg σ e) =>
      y.val (chartMk σ e d (g ^ e)) / chartScale σ e y ^ d :=
    h1.div₀ h2 fun y => pow_ne_zero _ (chartScale_pos hσ he y).ne'
  have h4 : Continuous fun x : ℝ≥0 => x ^ ((e : ℝ)⁻¹) :=
    NNReal.continuous_rpow_const (inv_nonneg.2 (Nat.cast_nonneg e))
  exact h4.comp h3

theorem chartInv_val_apply (y : Berk k (chartAlg σ e)) (f : MvPolynomial (Fin (n + 1)) k) :
    (chartInv σ e hσ he y).1.val f = (Finset.range (f.totalDegree + 1)).sup
      fun d => chartNorm σ e y d (homogeneousComponent d f) :=
  ofGradedNorm_val_apply _ f

theorem continuous_chartInv : Continuous (chartInv σ e hσ he) := by
  rw [continuous_iff]
  intro f
  simp only [chartInv_val_apply hσ he]
  exact Continuous.finset_sup_apply fun d _ => continuous_chartNorm hσ he d _

end chartInv

variable (σ e) in
/-- **Affine charts** (`lem:bj-chart`(2)): for a form `σ` of degree `e ≥ 1`, the chart map
`ι_σ` is a homeomorphism from `U_σ = {|σ| ≠ 0}` onto `(Spec A_σ)^an`; its inverse is the graded
extension `chartInv`. -/
def chartHomeomorph (hσ : σ.IsHomogeneous e) (he : 0 < e) :
    chartDomain σ ≃ₜ Berk k (chartAlg σ e) where
  toFun v := chartMap σ e v.1 v.2
  invFun y := ⟨chartInv σ e hσ he y, chartInv_val_ne_zero hσ he y⟩
  left_inv v := Subtype.ext (chartInv_chartMap hσ he v.1 v.2)
  right_inv y := chartMap_chartInv hσ he y
  continuous_toFun := continuous_chartMap
  continuous_invFun := (continuous_chartInv hσ he).subtype_mk _

section chartHomeomorph

variable (hσ : σ.IsHomogeneous e) (he : 0 < e)

@[simp]
theorem chartHomeomorph_apply (v : chartDomain σ) :
    chartHomeomorph σ e hσ he v = chartMap σ e v.1 v.2 :=
  rfl

@[simp]
theorem coe_chartHomeomorph_symm_apply (y : Berk k (chartAlg σ e)) :
    ((chartHomeomorph σ e hσ he).symm y : ProjBerk k n) = chartInv σ e hσ he y :=
  rfl

theorem chartHomeomorph_val_chartMk (v : chartDomain σ) {N : ℕ}
    {τ : MvPolynomial (Fin (n + 1)) k} (hτ : τ.IsHomogeneous (N * e)) :
    (chartHomeomorph σ e hσ he v).val (chartMk σ e N τ) = v.1.1.val τ / v.1.1.val σ ^ N :=
  chartMap_val_chartMk_of_isHomogeneous v.1 v.2 hτ

/-- The inverse chart is an open embedding of `(Spec A_σ)^an` into `(ℙⁿ)^an` with image `U_σ`. -/
theorem isOpenEmbedding_chartInv : IsOpenEmbedding (chartInv σ e hσ he) :=
  (isOpen_chartDomain σ).isOpenEmbedding_subtypeVal.comp
    (chartHomeomorph σ e hσ he).symm.isOpenEmbedding

theorem range_chartInv : Set.range (chartInv σ e hσ he) = chartDomain σ := by
  refine Set.Subset.antisymm ?_ fun v hv => ⟨chartMap σ e v hv, chartInv_chartMap hσ he v hv⟩
  rintro _ ⟨y, rfl⟩
  exact chartInv_mem_chartDomain hσ he y

end chartHomeomorph

/-! ### Generators on the chart -/

theorem chartMap_val_chartGen (v : ProjBerk k n) (hv : v.1.val σ ≠ 0) {α : Fin (n + 1) →₀ ℕ}
    (hα : α.degree = e) :
    (chartMap σ e v hv).val (chartGen σ e α) = v.1.val (monomial α 1) / v.1.val σ := by
  rw [chartGen, chartMap_val_chartMk_of_isHomogeneous v hv
    (isHomogeneous_monomial _ (by rw [hα, one_mul])), pow_one]

/-- `max_{|α| = e} |x^α / σ| ∘ ι_σ = |σ|⁻¹` on `U_σ` (`lem:bj-chart`(3)). -/
theorem sup_chartMap_val_chartGen (v : ProjBerk k n) (hv : v.1.val σ ≠ 0) :
    (Finset.finsuppAntidiag Finset.univ e).sup
      (fun α => (chartMap σ e v hv).val (chartGen σ e α)) = (v.1.val σ)⁻¹ := by
  refine le_antisymm (Finset.sup_le fun α hα => ?_) ?_
  · rw [chartMap_val_chartGen v hv (mem_finsuppAntidiag_univ.1 hα), ← one_div]
    exact div_le_div_of_nonneg_right (val_le_one v _) zero_le
  · obtain ⟨j, hj⟩ := exists_val_X_eq_one v
    have hα : Finsupp.single j e ∈ Finset.finsuppAntidiag Finset.univ e :=
      mem_finsuppAntidiag_univ.2 (Finsupp.degree_single j e)
    refine le_trans ?_ (Finset.le_sup (f := fun α => (chartMap σ e v hv).val (chartGen σ e α)) hα)
    rw [chartMap_val_chartGen v hv (Finsupp.degree_single j e), ← X_pow_eq_monomial, map_pow, hj,
      one_pow, one_div]

/-- `max_{|α| = e} log|x^α / σ| ∘ ι_σ = -log|σ|` on `U_σ` (`lem:bj-chart`(3)). -/
theorem sup_logAbs_chartMap_chartGen (v : ProjBerk k n) (hv : v.1.val σ ≠ 0) :
    (Finset.finsuppAntidiag Finset.univ e).sup
      (fun α => Berk.logAbs (chartGen σ e α) (chartMap σ e v hv)) = -logAbs σ v := by
  have h := Finset.apply_sup_eq_sup_comp_of_linearOrder (s := Finset.finsuppAntidiag Finset.univ e)
    (f := fun α => (chartMap σ e v hv).val (chartGen σ e α)) (fun t : ℝ≥0 => ENNReal.log (t : ℝ≥0∞))
    (ENNReal.log_monotone.comp ENNReal.coe_mono) (by simp)
  rw [sup_chartMap_val_chartGen v hv, ENNReal.coe_inv hv, ENNReal.log_inv] at h
  rw [logAbs_def, h]
  rfl

theorem logAbs_chartMap_chartGen_le (v : ProjBerk k n) (hv : v.1.val σ ≠ 0)
    {α : Fin (n + 1) →₀ ℕ} (hα : α.degree = e) :
    Berk.logAbs (chartGen σ e α) (chartMap σ e v hv) ≤ -logAbs σ v := by
  rw [← sup_logAbs_chartMap_chartGen v hv]
  exact Finset.le_sup (f := fun α => Berk.logAbs (chartGen σ e α) (chartMap σ e v hv))
    (mem_finsuppAntidiag_univ.2 hα)

/-! ### The trivial valuation -/

theorem triv_val_ne_zero {σ : MvPolynomial (Fin (n + 1)) k} (hσ0 : σ ≠ 0) :
    (triv : ProjBerk k n).1.val σ ≠ 0 := by
  rw [triv_val_of_ne_zero hσ0]
  exact one_ne_zero

/-- `v_triv ∈ U_σ` and `ι_σ(v_triv) = v_triv` (`lem:bj-chart`(4)); the domain instance can be
supplied by `Berk.isDomain_localizationAway`. -/
theorem chartMap_triv [IsDomain (Localization.Away σ)] (hσ0 : σ ≠ 0) :
    chartMap σ e triv (triv_val_ne_zero hσ0) = Berk.triv := by
  have h : Berk.awayLift σ (triv : ProjBerk k n).1 (triv_val_ne_zero hσ0) = Berk.triv := by
    apply Berk.awayComap_injective σ
    rw [Berk.awayComap_awayLift, Berk.awayComap_triv]
    rfl
  unfold chartMap
  rw [h]
  refine Berk.ext_val fun a => ?_
  by_cases ha : a = 0
  · simp [ha]
  · rw [Berk.comap_val_apply, Berk.triv_val_of_ne_zero ha, Berk.triv_val_of_ne_zero]
    simpa using ha

end ChartMap

/-! ### Polynomial expressions in the `xᵢ h / σ` -/

section DegreeOne

variable {σ : MvPolynomial (Fin (n + 1)) k}

/-- For `σ` of degree `d + 1` and a form `h` of degree `d`,
`τ(x₀h/σ, …, xₙh/σ) = τ h^N / σ^N` for a form `τ` of degree `N`. -/
theorem aeval_chartMk_X_mul {d : ℕ} {h : MvPolynomial (Fin (n + 1)) k} (hh : h.IsHomogeneous d)
    {N : ℕ} {τ : MvPolynomial (Fin (n + 1)) k} (hτ : τ.IsHomogeneous N) :
    aeval (fun i => chartMk σ (d + 1) 1 (X i * h)) τ = chartMk σ (d + 1) N (τ * h ^ N) := by
  have hXh : ∀ i, (X i * h : MvPolynomial (Fin (n + 1)) k).IsHomogeneous (1 * (d + 1)) := fun i => by
    have := (isHomogeneous_X k i).mul hh
    rwa [one_mul, add_comm d 1]
  have hmon : ∀ β ∈ τ.support, aeval (fun i => chartMk σ (d + 1) 1 (X i * h))
      (monomial β (coeff β τ)) = chartMk σ (d + 1) N (monomial β (coeff β τ) * h ^ N) := by
    intro β hβ
    have hβN : β.degree = N := by
      rw [Finsupp.degree_eq_weight_one]; exact hτ (mem_support_iff.1 hβ)
    rw [show monomial β (coeff β τ) = coeff β τ • monomial β (1 : k) by
      rw [smul_monomial, smul_eq_mul, mul_one], map_smul, smul_mul_assoc, chartMk_smul]
    congr 1
    rw [aeval_monomial, map_one, one_mul, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
      monomial_eq, C_1, one_mul, Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
    have hsum : N = ∑ i, β i := by rw [← hβN, Finsupp.degree_eq_sum]
    have hprod : (∏ i, X i ^ β i) * h ^ N = ∏ i, (X i * h) ^ β i := by
      rw [hsum, ← Finset.prod_pow_eq_pow_sum, ← Finset.prod_mul_distrib]
      exact Finset.prod_congr rfl fun i _ => (mul_pow _ _ _).symm
    rw [hprod, hsum, chartMk_prod _ (fun i _ => by
      rw [show β i * (d + 1) = 1 * (d + 1) * β i by ring]; exact (hXh i).pow (β i))]
    refine Finset.prod_congr rfl fun i _ => ?_
    have h' := chartMk_pow (σ := σ) (e := d + 1) (N := 1) (hXh i) (β i)
    rw [one_mul] at h'
    exact h'.symm
  conv_rhs => rw [τ.as_sum]
  rw [Finset.sum_mul, chartMk_sum]
  conv_lhs => rw [τ.as_sum]
  rw [map_sum]
  exact Finset.sum_congr rfl hmon

/-- For `σ` of degree one, `τ(x₀/σ, …, xₙ/σ) = τ / σ^N` for a form `τ` of degree `N`. -/
theorem aeval_chartMk_X {N : ℕ} {τ : MvPolynomial (Fin (n + 1)) k} (hτ : τ.IsHomogeneous N) :
    aeval (fun i => chartMk σ 1 1 (X i)) τ = chartMk σ 1 N τ := by
  have h := aeval_chartMk_X_mul (σ := σ) (isHomogeneous_one (Fin (n + 1)) k) hτ
  simpa using h

end DegreeOne

/-! ### The standard charts `U_j = {xⱼ ≠ 0}` -/

section StdChart

variable (j : Fin (n + 1))

/-- **Dehomogenization** at `xⱼ`: the `k`-algebra map `k[x₀, …, xₙ] → k[y₀, …, y_{n-1}]` with
`xⱼ ↦ 1` and `x_{j.succAbove m} ↦ y_m`; on a form `τ` of degree `N` it is `τ / xⱼ^N` written in
the affine coordinates `y_m = x_{j.succAbove m} / xⱼ`. -/
def dehom : MvPolynomial (Fin (n + 1)) k →ₐ[k] MvPolynomial (Fin n) k :=
  aeval (Fin.insertNth (α := fun _ => MvPolynomial (Fin n) k) j 1 X)

@[simp]
theorem dehom_X_self : dehom j (X j : MvPolynomial (Fin (n + 1)) k) = 1 := by
  simp [dehom]

@[simp]
theorem dehom_X_succAbove (m : Fin n) :
    dehom j (X (j.succAbove m) : MvPolynomial (Fin (n + 1)) k) = X m := by
  simp [dehom]

/-- The extension `R_{xⱼ} → k[y]` of the dehomogenization. -/
def awayDehom :
    Localization.Away (X j : MvPolynomial (Fin (n + 1)) k) →ₐ[k] MvPolynomial (Fin n) k :=
  IsLocalization.Away.liftAlgHom (X j) (f := dehom j) (by rw [dehom_X_self]; exact isUnit_one)

theorem awayDehom_frac (N : ℕ) (τ : MvPolynomial (Fin (n + 1)) k) :
    awayDehom j (frac (X j) N τ) = dehom j τ := by
  have hinv : awayDehom j (IsLocalization.Away.invSelf (X j : MvPolynomial (Fin (n + 1)) k) :
      Localization.Away (X j : MvPolynomial (Fin (n + 1)) k)) = 1 := by
    have h := congrArg (awayDehom j) (IsLocalization.Away.mul_invSelf
      (S := Localization.Away (X j : MvPolynomial (Fin (n + 1)) k))
      (X j : MvPolynomial (Fin (n + 1)) k))
    rw [map_mul, map_one, awayDehom, IsLocalization.Away.liftAlgHom_apply,
      IsLocalization.Away.lift_eq] at h
    rw [awayDehom, IsLocalization.Away.liftAlgHom_apply]
    simpa using h
  rw [frac, map_mul, map_pow, hinv, one_pow, mul_one, awayDehom,
    IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
  rfl

/-- The dehomogenization `A_{xⱼ} → k[y]`. -/
def chartDehom : chartAlg (X j : MvPolynomial (Fin (n + 1)) k) 1 →ₐ[k] MvPolynomial (Fin n) k :=
  (awayDehom j).comp (chartAlg (X j) 1).val

/-- The homogenization `k[y] → A_{xⱼ}`, `y_m ↦ x_{j.succAbove m} / xⱼ`. -/
def chartHomog : MvPolynomial (Fin n) k →ₐ[k] chartAlg (X j : MvPolynomial (Fin (n + 1)) k) 1 :=
  aeval fun m => chartMk (X j) 1 1 (X (j.succAbove m))

theorem chartDehom_chartMk (N : ℕ) (τ : MvPolynomial (Fin (n + 1)) k) :
    chartDehom j (chartMk (X j) 1 N τ) = dehom j (homogeneousComponent N τ) := by
  rw [chartDehom, AlgHom.comp_apply, Subalgebra.coe_val, coe_chartMk', awayDehom_frac, mul_one]

theorem chartDehom_chartMk_of_isHomogeneous {N : ℕ} {τ : MvPolynomial (Fin (n + 1)) k}
    (hτ : τ.IsHomogeneous N) : chartDehom j (chartMk (X j) 1 N τ) = dehom j τ := by
  rw [chartDehom_chartMk, homogeneousComponent_eq_self hτ]

theorem chartDehom_comp_chartHomog :
    (chartDehom j).comp (chartHomog (k := k) j) = AlgHom.id k (MvPolynomial (Fin n) k) := by
  refine MvPolynomial.algHom_ext fun m => ?_
  rw [AlgHom.comp_apply, chartHomog, aeval_X,
    chartDehom_chartMk_of_isHomogeneous j (isHomogeneous_X k _), dehom_X_succAbove, AlgHom.id_apply]

theorem chartHomog_chartDehom (a : chartAlg (X j : MvPolynomial (Fin (n + 1)) k) 1) :
    chartHomog j (chartDehom j a) = a := by
  obtain ⟨N, τ, hτ, rfl⟩ := exists_eq_chartMk (isHomogeneous_X k j) a
  rw [mul_one] at hτ
  have hfun : (fun i => chartHomog j (Fin.insertNth (α := fun _ => MvPolynomial (Fin n) k) j 1 X i))
      = fun i => chartMk (X j) 1 1 (X i) := by
    funext i
    rcases Fin.eq_self_or_eq_succAbove j i with rfl | ⟨m, rfl⟩
    · rw [Fin.insertNth_apply_same, map_one, ← chartMk_pow_self (isHomogeneous_X k i) 1, pow_one]
    · rw [Fin.insertNth_apply_succAbove, chartHomog, aeval_X]
  rw [chartDehom_chartMk_of_isHomogeneous j hτ, dehom, ← AlgHom.comp_apply, comp_aeval, hfun,
    aeval_chartMk_X hτ]

/-- The standard chart algebra `A_{xⱼ}` is the polynomial ring `k[y₀, …, y_{n-1}]`, via
dehomogenization (`lem:bj-chart`(1)). -/
def chartEquiv :
    chartAlg (X j : MvPolynomial (Fin (n + 1)) k) 1 ≃ₐ[k] MvPolynomial (Fin n) k :=
  AlgEquiv.ofAlgHom (chartDehom j) (chartHomog j) (chartDehom_comp_chartHomog j)
    (AlgHom.ext fun a => chartHomog_chartDehom j a)

theorem chartEquiv_apply (a : chartAlg (X j : MvPolynomial (Fin (n + 1)) k) 1) :
    chartEquiv j a = chartDehom j a :=
  rfl

theorem chartEquiv_symm_apply (p : MvPolynomial (Fin n) k) :
    (chartEquiv j).symm p = chartHomog j p :=
  rfl

theorem chartEquiv_symm_dehom {N : ℕ} {τ : MvPolynomial (Fin (n + 1)) k}
    (hτ : τ.IsHomogeneous N) : (chartEquiv j).symm (dehom j τ) = chartMk (X j) 1 N τ := by
  rw [AlgEquiv.symm_apply_eq, chartEquiv_apply, chartDehom_chartMk_of_isHomogeneous j hτ]

/-- The **standard affine chart** (`lem:bj-chart`(2) for `σ = xⱼ`): `U_j = {|xⱼ| ≠ 0}` is
homeomorphic to `(𝔸ⁿ)^an = Berk k k[y₀, …, y_{n-1}]` by `v ↦ (p ↦ |p(x/xⱼ)|_v)`, i.e.
`|dehom τ| = |τ|_v / |xⱼ|_v^N` for forms `τ` of degree `N` (`stdChart_val_dehom`). -/
def stdChart : chartDomain (X j : MvPolynomial (Fin (n + 1)) k) ≃ₜ
    Berk k (MvPolynomial (Fin n) k) :=
  (chartHomeomorph (X j) 1 (isHomogeneous_X k j) one_pos).trans (Berk.homeomorphOfAlgEquiv (chartEquiv j))

theorem stdChart_val_dehom (v : chartDomain (X j : MvPolynomial (Fin (n + 1)) k)) {N : ℕ}
    {τ : MvPolynomial (Fin (n + 1)) k} (hτ : τ.IsHomogeneous N) :
    (stdChart j v).val (dehom j τ) = v.1.1.val τ / v.1.1.val (X j) ^ N := by
  rw [stdChart, Homeomorph.trans_apply, Berk.homeomorphOfAlgEquiv_val_apply, chartEquiv_symm_dehom j hτ,
    chartHomeomorph_val_chartMk _ _ _ (by rwa [mul_one])]

theorem stdChart_val_X (v : chartDomain (X j : MvPolynomial (Fin (n + 1)) k)) (m : Fin n) :
    (stdChart j v).val (X m) = v.1.1.val (X (j.succAbove m)) / v.1.1.val (X j) := by
  rw [← dehom_X_succAbove j m, stdChart_val_dehom j v (isHomogeneous_X k _), pow_one]

/-- The inverse of the standard chart on forms: for `y ∈ (𝔸ⁿ)^an` and a form `g` of degree `c`,
`|g| = |dehom g|_y / M^c` with `M = max(1, max_m |y_m|_y)` written as `max_i |dehom xᵢ|_y`. -/
theorem stdChart_symm_val (y : Berk k (MvPolynomial (Fin n) k)) {c : ℕ}
    {g : MvPolynomial (Fin (n + 1)) k} (hg : g.IsHomogeneous c) :
    ((stdChart j).symm y).1.1.val g =
      y.val (dehom j g) / (Finset.univ.sup fun i => y.val (dehom j (X i))) ^ c := by
  rw [stdChart, Homeomorph.symm_trans_apply, coe_chartHomeomorph_symm_apply,
    chartInv_val_of_isHomogeneous _ _ _ hg, chartNorm, chartScale]
  simp only [Berk.homeomorphOfAlgEquiv_symm_val_apply, chartEquiv_apply, pow_one, Nat.cast_one, inv_one,
    NNReal.rpow_one]
  rw [chartDehom_chartMk_of_isHomogeneous j hg]
  simp only [chartDehom_chartMk_of_isHomogeneous j (isHomogeneous_X k _)]

/-- Every polynomial in the affine coordinates is the dehomogenization of a form. -/
theorem exists_dehom_eq (p : MvPolynomial (Fin n) k) :
    ∃ (M : ℕ) (τ : MvPolynomial (Fin (n + 1)) k), τ.IsHomogeneous M ∧ dehom j τ = p := by
  obtain ⟨M, τ, hτ, h⟩ := exists_eq_chartMk (isHomogeneous_X k j) (chartHomog j p)
  rw [mul_one] at hτ
  refine ⟨M, τ, hτ, ?_⟩
  rw [← chartDehom_chartMk_of_isHomogeneous j hτ, ← h, ← chartEquiv_apply, ← chartEquiv_symm_apply,
    AlgEquiv.apply_symm_apply]

end StdChart

/-! ### The charts `U_{xⱼ h}` as principal opens of `𝔸ⁿ` -/

section MulChart

variable (j : Fin (n + 1)) {d : ℕ} {h : MvPolynomial (Fin (n + 1)) k}

theorem isHomogeneous_X_mul (hh : h.IsHomogeneous d) : (X j * h).IsHomogeneous (d + 1) := by
  have := (isHomogeneous_X k j).mul hh
  rwa [add_comm 1 d] at this

variable (d h) in
/-- `k[y] → A_{xⱼ h}`, `y_m ↦ x_{j.succAbove m} h / (xⱼ h) = x_{j.succAbove m} / xⱼ`. -/
def mulChartHom : MvPolynomial (Fin n) k →ₐ[k] chartAlg (X j * h) (d + 1) :=
  aeval fun m => chartMk (X j * h) (d + 1) 1 (X (j.succAbove m) * h)

theorem mulChartHom_dehom (hh : h.IsHomogeneous d) {M : ℕ} {τ : MvPolynomial (Fin (n + 1)) k}
    (hτ : τ.IsHomogeneous M) :
    mulChartHom j d h (dehom j τ) = chartMk (X j * h) (d + 1) M (τ * h ^ M) := by
  have hfun : (fun i => mulChartHom j d h
      (Fin.insertNth (α := fun _ => MvPolynomial (Fin n) k) j 1 X i)) =
      fun i => chartMk (X j * h) (d + 1) 1 (X i * h) := by
    funext i
    rcases Fin.eq_self_or_eq_succAbove j i with rfl | ⟨m, rfl⟩
    · rw [Fin.insertNth_apply_same, map_one, ← chartMk_pow_self (isHomogeneous_X_mul i hh) 1,
        pow_one]
    · rw [Fin.insertNth_apply_succAbove, mulChartHom, aeval_X]
  rw [dehom, ← AlgHom.comp_apply, comp_aeval, hfun, aeval_chartMk_X_mul hh hτ]

theorem mulChartHom_dehom_mul (hh : h.IsHomogeneous d) :
    mulChartHom j d h (dehom j h) * chartMk (X j * h) (d + 1) 1 (X j ^ (d + 1)) = 1 := by
  have h1 : (h * h ^ d).IsHomogeneous (d * (d + 1)) := by
    have := hh.mul (hh.pow d); rwa [show d + d * d = d * (d + 1) by ring] at this
  have h2 : (X j ^ (d + 1) : MvPolynomial (Fin (n + 1)) k).IsHomogeneous (1 * (d + 1)) := by
    rw [one_mul]; exact isHomogeneous_X_pow j (d + 1)
  rw [mulChartHom_dehom j hh hh, ← chartMk_mul h1 h2,
    show h * h ^ d * X j ^ (d + 1) = (X j * h) ^ (d + 1) by ring,
    chartMk_pow_self (isHomogeneous_X_mul j hh)]

theorem isUnit_mulChartHom_dehom (hh : h.IsHomogeneous d) :
    IsUnit (mulChartHom j d h (dehom j h)) :=
  isUnit_iff_exists_inv.2 ⟨_, mulChartHom_dehom_mul j hh⟩

variable (d h) in
/-- `k[y]_{dehom h} → A_{xⱼ h}`. -/
def mulChartInv (hh : h.IsHomogeneous d) :
    Localization.Away (dehom j h) →ₐ[k] chartAlg (X j * h) (d + 1) :=
  IsLocalization.Away.liftAlgHom (dehom j h) (f := mulChartHom j d h)
    (isUnit_mulChartHom_dehom j hh)

theorem mulChartInv_algebraMap (hh : h.IsHomogeneous d) (p : MvPolynomial (Fin n) k) :
    mulChartInv j d h hh (algebraMap _ _ p) = mulChartHom j d h p := by
  rw [mulChartInv, IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
  rfl

theorem mulChartInv_invSelf (hh : h.IsHomogeneous d) :
    mulChartInv j d h hh (IsLocalization.Away.invSelf (dehom j h)) =
      chartMk (X j * h) (d + 1) 1 (X j ^ (d + 1)) := by
  have h1 := congrArg (mulChartInv j d h hh)
    (IsLocalization.Away.mul_invSelf (S := Localization.Away (dehom j h)) (dehom j h))
  rw [map_mul, map_one, mulChartInv_algebraMap] at h1
  have h2 := mulChartHom_dehom_mul j hh
  calc mulChartInv j d h hh (IsLocalization.Away.invSelf (dehom j h))
      = mulChartInv j d h hh (IsLocalization.Away.invSelf (dehom j h)) *
        (mulChartHom j d h (dehom j h) * chartMk (X j * h) (d + 1) 1 (X j ^ (d + 1))) := by
        rw [h2, mul_one]
    _ = (mulChartHom j d h (dehom j h) * mulChartInv j d h hh
        (IsLocalization.Away.invSelf (dehom j h))) * chartMk (X j * h) (d + 1) 1 (X j ^ (d + 1)) :=
        by ring
    _ = _ := by rw [h1, one_mul]

variable (h) in
/-- `R_{xⱼ h} → k[y]_{dehom h}`, extending the dehomogenization. -/
def mulChartFwdAway :
    Localization.Away (X j * h) →ₐ[k] Localization.Away (dehom j h) :=
  IsLocalization.Away.liftAlgHom (X j * h)
    (f := (IsScalarTower.toAlgHom k (MvPolynomial (Fin n) k) (Localization.Away (dehom j h))).comp
      (dehom j))
    (by
      rw [AlgHom.comp_apply, map_mul, dehom_X_self, one_mul, IsScalarTower.coe_toAlgHom']
      exact IsLocalization.Away.algebraMap_isUnit _)

theorem mulChartFwdAway_frac (N : ℕ) (τ : MvPolynomial (Fin (n + 1)) k) :
    mulChartFwdAway j h (frac (X j * h) N τ) = algebraMap _ _ (dehom j τ) *
      (IsLocalization.Away.invSelf (dehom j h) : Localization.Away (dehom j h)) ^ N := by
  have hlift : ∀ a, mulChartFwdAway j h (algebraMap _ (Localization.Away (X j * h)) a) =
      algebraMap _ (Localization.Away (dehom j h)) (dehom j a) := fun a => by
    rw [mulChartFwdAway, IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
    rfl
  have hinv : mulChartFwdAway j h (IsLocalization.Away.invSelf (X j * h)) =
      IsLocalization.Away.invSelf (dehom j h) := by
    have h1 := congrArg (mulChartFwdAway j h)
      (IsLocalization.Away.mul_invSelf (S := Localization.Away (X j * h)) (X j * h))
    rw [map_mul, map_one, hlift, map_mul, dehom_X_self, one_mul] at h1
    have h2 := IsLocalization.Away.mul_invSelf (S := Localization.Away (dehom j h)) (dehom j h)
    calc mulChartFwdAway j h (IsLocalization.Away.invSelf (X j * h))
        = mulChartFwdAway j h (IsLocalization.Away.invSelf (X j * h)) *
          (algebraMap _ (Localization.Away (dehom j h)) (dehom j h) *
            IsLocalization.Away.invSelf (dehom j h)) := by rw [h2, mul_one]
      _ = (algebraMap _ (Localization.Away (dehom j h)) (dehom j h) *
          mulChartFwdAway j h (IsLocalization.Away.invSelf (X j * h))) *
            IsLocalization.Away.invSelf (dehom j h) := by ring
      _ = _ := by rw [h1, one_mul]
  rw [frac, map_mul, map_pow, hlift, hinv]

variable (d h) in
/-- `A_{xⱼ h} → k[y]_{dehom h}`. -/
def mulChartFwd : chartAlg (X j * h) (d + 1) →ₐ[k] Localization.Away (dehom j h) :=
  (mulChartFwdAway j h).comp (chartAlg (X j * h) (d + 1)).val

theorem mulChartFwd_chartMk {N : ℕ} {τ : MvPolynomial (Fin (n + 1)) k}
    (hτ : τ.IsHomogeneous (N * (d + 1))) :
    mulChartFwd j d h (chartMk (X j * h) (d + 1) N τ) = algebraMap _ _ (dehom j τ) *
      (IsLocalization.Away.invSelf (dehom j h) : Localization.Away (dehom j h)) ^ N := by
  rw [mulChartFwd, AlgHom.comp_apply, Subalgebra.coe_val, coe_chartMk hτ, mulChartFwdAway_frac]

theorem mulChartFwd_comp_mulChartInv (hh : h.IsHomogeneous d) :
    (mulChartFwd j d h).comp (mulChartInv j d h hh) = AlgHom.id k _ := by
  refine Localization.algHom_ext (Submonoid.powers (dehom j h)) ?_
  refine MvPolynomial.algHom_ext fun m => ?_
  change mulChartFwd j d h (mulChartInv j d h hh (algebraMap _ _ (X m))) =
    algebraMap (MvPolynomial (Fin n) k) (Localization.Away (dehom j h)) (X m)
  have hXh : (X (j.succAbove m) * h : MvPolynomial (Fin (n + 1)) k).IsHomogeneous (1 * (d + 1)) := by
    rw [one_mul]; exact isHomogeneous_X_mul _ hh
  rw [mulChartInv_algebraMap, mulChartHom, aeval_X, mulChartFwd_chartMk j hXh, map_mul,
    dehom_X_succAbove, map_mul, pow_one, mul_assoc, IsLocalization.Away.mul_invSelf, mul_one]

theorem mulChartInv_mulChartFwd (hh : h.IsHomogeneous d) (a : chartAlg (X j * h) (d + 1)) :
    mulChartInv j d h hh (mulChartFwd j d h a) = a := by
  obtain ⟨N, τ, hτ, rfl⟩ := exists_eq_chartMk (isHomogeneous_X_mul j hh) a
  have hτ' : τ.IsHomogeneous (N * (d + 1)) := hτ
  rw [mulChartFwd_chartMk j hτ', map_mul, map_pow, mulChartInv_algebraMap, mulChartInv_invSelf,
    mulChartHom_dehom j hh hτ']
  have h2 : (X j ^ (d + 1) : MvPolynomial (Fin (n + 1)) k).IsHomogeneous (1 * (d + 1)) := by
    rw [one_mul]; exact isHomogeneous_X_pow j (d + 1)
  have h3 : (τ * h ^ (N * (d + 1))).IsHomogeneous (N * (d + 1) * (d + 1)) := by
    have := hτ'.mul (hh.pow (N * (d + 1)))
    rwa [show N * (d + 1) + d * (N * (d + 1)) = N * (d + 1) * (d + 1) by ring] at this
  rw [← chartMk_pow h2, ← chartMk_mul h3 (by
      rw [show 1 * N * (d + 1) = 1 * (d + 1) * N by ring]; exact h2.pow N),
    show τ * h ^ (N * (d + 1)) * (X j ^ (d + 1)) ^ N = τ * (X j * h) ^ (N * (d + 1)) by ring,
    show N * (d + 1) + 1 * N = N + N * (d + 1) by ring,
    chartMk_mul_pow_self (isHomogeneous_X_mul j hh) hτ']

/-- For a form `h` of degree `d`, the chart algebra `A_{xⱼ h}` is the localization
`k[y]_{dehom h}` of the polynomial ring in the affine coordinates (`lem:bj-chart`(1)). -/
def mulChartEquiv (hh : h.IsHomogeneous d) :
    chartAlg (X j * h) (d + 1) ≃ₐ[k] Localization.Away (dehom j h) :=
  AlgEquiv.ofAlgHom (mulChartFwd j d h) (mulChartInv j d h hh)
    (mulChartFwd_comp_mulChartInv j hh) (AlgHom.ext fun a => mulChartInv_mulChartFwd j hh a)

theorem mulChartEquiv_symm_algebraMap_dehom (hh : h.IsHomogeneous d) {M : ℕ}
    {τ : MvPolynomial (Fin (n + 1)) k} (hτ : τ.IsHomogeneous M) :
    (mulChartEquiv j hh).symm (algebraMap _ _ (dehom j τ)) =
      chartMk (X j * h) (d + 1) M (τ * h ^ M) := by
  change mulChartInv j d h hh _ = _
  rw [mulChartInv_algebraMap, mulChartHom_dehom j hh hτ]

/-- The chart `U_{xⱼ h} = {|xⱼ h| ≠ 0}` is homeomorphic to the analytification of the principal
open `{dehom h ≠ 0} ⊆ 𝔸ⁿ` (`lem:bj-chart`(1),(2) for `σ = xⱼ h`). -/
def mulChart (hh : h.IsHomogeneous d) :
    chartDomain (X j * h) ≃ₜ Berk k (Localization.Away (dehom j h)) :=
  (chartHomeomorph (X j * h) (d + 1) (isHomogeneous_X_mul j hh) (Nat.succ_pos d)).trans
    (Berk.homeomorphOfAlgEquiv (mulChartEquiv j hh))

theorem val_X_ne_zero_of_mem_chartDomain_mul {v : ProjBerk k n}
    (hv : v ∈ chartDomain (X j * h)) : v.1.val (X j) ≠ 0 := by
  intro h0
  apply hv
  rw [map_mul, h0, zero_mul]

theorem val_ne_zero_of_mem_chartDomain_mul {v : ProjBerk k n}
    (hv : v ∈ chartDomain (X j * h)) : v.1.val h ≠ 0 := by
  intro h0
  apply hv
  rw [map_mul, h0, mul_zero]

/-- On `U_{xⱼ h}`, `|dehom τ| = |τ|_v / |xⱼ|_v^M` for a form `τ` of degree `M`, as in the
standard chart. -/
theorem mulChart_val_algebraMap_dehom (hh : h.IsHomogeneous d) (v : chartDomain (X j * h))
    {M : ℕ} {τ : MvPolynomial (Fin (n + 1)) k} (hτ : τ.IsHomogeneous M) :
    (mulChart j hh v).val (algebraMap _ _ (dehom j τ)) = v.1.1.val τ / v.1.1.val (X j) ^ M := by
  have hX := val_X_ne_zero_of_mem_chartDomain_mul j v.2
  have hh0 := val_ne_zero_of_mem_chartDomain_mul j v.2
  have hτh : (τ * h ^ M).IsHomogeneous (M * (d + 1)) := by
    have := hτ.mul (hh.pow M)
    rwa [show M + d * M = M * (d + 1) by ring] at this
  rw [mulChart, Homeomorph.trans_apply, Berk.homeomorphOfAlgEquiv_val_apply,
    mulChartEquiv_symm_algebraMap_dehom j hh hτ, chartHomeomorph_val_chartMk _ _ _ hτh,
    map_mul, map_mul, map_pow, mul_pow]
  field_simp

/-- Compatibility of the charts `U_{xⱼ h} ⊆ U_{xⱼ}`: the point of `{dehom h ≠ 0} ⊆ 𝔸ⁿ` attached to
`v ∈ U_{xⱼ h}` lies over the point `stdChart j v` of `𝔸ⁿ`. -/
theorem awayComap_mulChart (hh : h.IsHomogeneous d) (v : chartDomain (X j * h)) :
    Berk.awayComap (dehom j h) (mulChart j hh v) =
      stdChart j ⟨v.1, val_X_ne_zero_of_mem_chartDomain_mul j v.2⟩ := by
  refine Berk.ext_val fun p => ?_
  obtain ⟨M, τ, hτ, rfl⟩ := exists_dehom_eq j p
  rw [Berk.awayComap_val_apply, mulChart_val_algebraMap_dehom j hh v hτ,
    stdChart_val_dehom j _ hτ]

end MulChart


end ProjBerk

end EnvelopeProperty
