import EnvelopeProperty.Projective.SmoothConeTest

/-!
# Uniform generation of the asymptotic test ideals of the cone

Let `k` be a perfect field of characteristic `p`, `X = V(I) ⊆ ℙᴹ` with cone ring `T = S[t]`,
`K = Frac T`, and `D : X.ConeTraceData p` the chart data of the punctured cone (homogeneous
`p`-basis `z`, charts `D_c = T_{s_c}`, twisted forms `μ_c`, `ι_c`; blueprint `def:sg-charts`,
`def:sg-forms`, chapter `smooth-general.tex`). For a graded sequence `J_•` of nonzero ideals of
`T` with `J_r` generated by bihomogeneous elements of `x`-degree `r d`, this file proves
**`prop:sg-uniform-generation`**: the asymptotic test ideal `B_m` (`ConeTraceData.testSeq`) is,
up to saturation, generated by finitely many bihomogeneous elements of `x`-degree
`≤ m d + c₀`, with `c₀ = M + 1 + max_c N₁ deg(s_c)` independent of `m`. This replaces the
uniform global generation of Fang–Han–Xia, *The envelope property for unibranch projective
varieties*, Lemma 3.2 (`lem:smooth-uniform-twist`; relative Castelnuovo–Mumford regularity,
Serre vanishing and `F^e_*`) by a count of degrees.

The proof (blueprint): by `lem:sg-test-X`(1), `Θ ⊆ B_m ⊆ Θ^sat` for `Θ = Φ^e_z(J_r^N M₀) 𝔍₀`,
`N = ⌈(m/r) p^e⌉`, `e ≫ 0`. Every monomial of `T` is `u^{p^e} x̄^a t^b` with `a_i, b < p^e`
(`k` is perfect), so `Θ` is generated by the elements `Φ^e_z(x̄^a t^b g μ_c) ι_{c'}`, `g` a
product of `N` generators of `J_r` (`ConeTraceData.theta_eq_span_genSet`). These are
bihomogeneous, and the degree shift of `Φ^e_z` (`lem:sg-homog-pbasis`(2),
`ProjSubvariety.IsBihom.traceIter_coneZ`) bounds their `x`-degree by `m d + c₀` once
`p^e ≥ r d + max_c N₁ deg(s_c)`.

## Main definitions

* `ProjSubvariety.coneMono X a b = x̄^a t^b ∈ T` for `a : Fin (M + 1) →₀ ℕ`, `b ∈ ℕ`.
* `ConeTraceData.c0 D = M + 1 + max_c N₁ deg(s_c)`, the twist of `prop:sg-uniform-generation`.

## Main results

* `ProjSubvariety.exists_coneMk_monomial_eq`: `c x^β t^l = u^{p^e} x̄^a t^b` in `T` with
  `a_i, b < p^e`.
* `ProjSubvariety.pow_eq_span_isBihom`: `𝔞^N` is generated by bihomogeneous elements of
  `x`-degree `N D₀` if `𝔞` is generated by bihomogeneous elements of `x`-degree `D₀`.
* `ConeTraceData.theta_eq_span_genSet`: `Θ^e_N(𝔞)` is generated by the
  `Φ^e_z(x̄^a t^b g μ_c) ι_{c'}`, `a_i, b < p^e`, `g` in a generating set of `𝔞^N`.
* **`ConeTraceData.exists_span_le_testSeq_le_saturation`** (`prop:sg-uniform-generation`): there is
  a finite set `G ⊆ T` of elements `s̄ t^l`, `s` a form of degree `≤ m d + c₀`, with
  `(G) ⊆ B_m ⊆ (G)^sat`.
* **`ConeTraceData.isFS_inv_mul_phiIdeal_testSeq`** (`prop:sg-uniform-generation`, consequence):
  `m⁻¹ φ_{B_m} ∈ 𝓗(X, d + c₀/m)` for `m ≥ 1`.

## Deviations from the blueprint

* The blueprint's `c₀ = M - n + 1 + max(δ_𝔍, 0)`, `δ_𝔍 = max_c deg ι_c = max_c N₁ deg(s_c) + n`,
  is the same number `M + 1 + max_c N₁ deg(s_c)`; it is written in this form, which needs no
  `n ≤ M`. The bound `p^e ≥ r d + max(δ_M, 0)` is replaced by `p^e ≥ r d + max_c N₁ deg(s_c)`
  (`δ_M = max_c N₁ deg(s_c) - n`).
* The generators of `J_r` are given as `t^l s̄` (`Polynomial.monomial l (coordMk s)`), `s` a form
  of degree `r d`, as produced by `ProjSubvariety.exists_coneObstacleIdeal_eq_span` for the
  ideals `J_m(φ)`; the generators of `B_m` are given as `coneMk (C s * X^l)`, the form consumed by
  `ProjSubvariety.isFS_inv_mul_phiIdeal`.
-/

open scoped NNReal ENNReal Topology Polynomial Pointwise

noncomputable section

namespace EnvelopeProperty

open ProjBerk (phiIdeal)

universe u

namespace ProjSubvariety

variable {k : Type u} [Field k] {M : ℕ} {X : ProjSubvariety k M}

/-! ### Monomials of `T` -/

variable (X) in
/-- The monomial `x̄^a t^b ∈ T`. -/
def coneMono (a : Fin (M + 1) →₀ ℕ) (b : ℕ) : X.ConeRing :=
  X.coneMk (Polynomial.C (MvPolynomial.monomial a 1) * Polynomial.X ^ b)

/-- `x̄^a t^b` is bihomogeneous of bidegree `(|a|, b)`. -/
theorem isBihom_coneMono (a : Fin (M + 1) →₀ ℕ) (b : ℕ) :
    X.IsBihom (algebraMap X.ConeRing (FractionRing X.ConeRing) (X.coneMono a b)) a.degree b :=
  isBihom_algebraMap_coneMk (MvPolynomial.isHomogeneous_monomial 1 rfl) b

/-- **Monomials over a perfect field** (proof of `prop:sg-uniform-generation`): every monomial
`c x^β t^l` of `T` is `u^{p^e} x̄^a t^b` with `a_i < p^e` and `b < p^e`. -/
theorem exists_coneMk_monomial_eq (p : ℕ) [hp : Fact p.Prime] [CharP k p] [PerfectRing k p]
    (e : ℕ) (β : Fin (M + 1) →₀ ℕ) (c : k) (l : ℕ) :
    ∃ (u : X.ConeRing) (a : Fin (M + 1) →₀ ℕ) (b : ℕ), (∀ i, a i < p ^ e) ∧ b < p ^ e ∧
      X.coneMk (Polynomial.monomial l (MvPolynomial.monomial β c)) =
        u ^ p ^ e * X.coneMono a b := by
  set Q := p ^ e
  have hQ : 0 < Q := pow_pos hp.out.pos e
  obtain ⟨c', hc'⟩ := (iterateFrobeniusEquiv k p e).surjective c
  rw [iterateFrobeniusEquiv_apply, iterateFrobenius_def] at hc'
  set β' := β.mapRange (· / Q) (Nat.zero_div Q)
  set a := β.mapRange (· % Q) (Nat.zero_mod Q)
  refine ⟨X.coneMk (Polynomial.C (MvPolynomial.monomial β' c') * Polynomial.X ^ (l / Q)), a,
    l % Q, fun i => Nat.mod_lt _ hQ, Nat.mod_lt _ hQ, ?_⟩
  rw [coneMono, ← map_pow, ← map_mul, ← Polynomial.C_mul_X_pow_eq_monomial]
  congr 1
  have hβ : Q • β' + a = β := by
    ext i
    simp only [β', a, Finsupp.add_apply, Finsupp.smul_apply, Finsupp.mapRange_apply, smul_eq_mul]
    exact Nat.div_add_mod (β i) Q
  rw [mul_pow, ← Polynomial.C_pow, MvPolynomial.monomial_pow, ← pow_mul, mul_mul_mul_comm,
    ← Polynomial.C_mul, MvPolynomial.monomial_mul, ← pow_add, hc', mul_one, hβ, mul_comm (l / Q),
    Nat.div_add_mod]

/-- **Generators of powers** (`lem:sg-Jm-basic`): if `𝔞` is generated by bihomogeneous elements
of `x`-degree `D₀`, then `𝔞^N` is generated by its bihomogeneous elements of `x`-degree `N D₀`. -/
theorem pow_eq_span_isBihom {𝔞 : Ideal X.ConeRing} {D₀ : ℕ} {S : Set X.ConeRing}
    (h𝔞 : 𝔞 = Ideal.span S)
    (hS : ∀ f ∈ S, ∃ l, X.IsBihom (algebraMap X.ConeRing (FractionRing X.ConeRing) f) D₀ l)
    (N : ℕ) :
    𝔞 ^ N = Ideal.span {g | g ∈ 𝔞 ^ N ∧
      ∃ l, X.IsBihom (algebraMap X.ConeRing (FractionRing X.ConeRing) g) (N * D₀ : ℕ) l} := by
  refine le_antisymm ?_ (Ideal.span_le.2 fun g hg => hg.1)
  induction N with
  | zero =>
    rw [pow_zero, Ideal.one_eq_top, top_le_iff, Ideal.eq_top_iff_one]
    refine Ideal.subset_span ⟨Submodule.mem_top, 0, ?_⟩
    simpa using isBihom_fracMk_mul (X := X) (MvPolynomial.isHomogeneous_one _ _) 0
  | succ N ih =>
    rw [pow_succ]
    calc 𝔞 ^ N * 𝔞 ≤ Ideal.span {g | g ∈ 𝔞 ^ N ∧
          ∃ l, X.IsBihom (algebraMap X.ConeRing (FractionRing X.ConeRing) g) (N * D₀ : ℕ) l} *
            Ideal.span S := Ideal.mul_mono ih h𝔞.le
      _ = Ideal.span ({g | g ∈ 𝔞 ^ N ∧
          ∃ l, X.IsBihom (algebraMap X.ConeRing (FractionRing X.ConeRing) g) (N * D₀ : ℕ) l} *
            S) := Ideal.span_mul_span' _ _
      _ ≤ _ := by
        refine Ideal.span_mono ?_
        rintro _ ⟨g, ⟨hg, l, hgl⟩, f, hf, rfl⟩
        obtain ⟨l', hfl'⟩ := hS f hf
        refine ⟨Ideal.mul_mem_mul hg (h𝔞 ▸ Ideal.subset_span hf), l + l', ?_⟩
        change X.IsBihom (algebraMap X.ConeRing (FractionRing X.ConeRing) (g * f)) _ _
        rw [map_mul]
        convert hgl.mul hfl' using 1
        push_cast
        ring

namespace ConeTraceData

open Cartier

variable {p : ℕ} [hp : Fact p.Prime] [CharP k p] [PerfectRing k p] (D : X.ConeTraceData p)

/-! ### Generators of `Θ` -/

/-- The generators `Φ^e_z(x̄^a t^b g μ_c) ι_{c'}` (`a_i, b < p^e`, `g ∈ S`) of `Θ^e_N(𝔞)` in `K`,
for a generating set `S` of `𝔞^N` (proof of `prop:sg-uniform-generation`). -/
def genSet (e : ℕ) (S : Set X.ConeRing) : Set (FractionRing X.ConeRing) :=
  {y | ∃ (a : Fin (M + 1) →₀ ℕ) (b : ℕ), (∀ i, a i < p ^ e) ∧ b < p ^ e ∧ ∃ g ∈ S,
    ∃ c c' : Fin D.nCharts, y = D.isPBasis_z.traceIter e
      (algebraMap X.ConeRing (FractionRing X.ConeRing) (X.coneMono a b * g) * D.mu c) *
        algebraMap X.ConeRing (FractionRing X.ConeRing) (D.iota c')}

omit [PerfectRing k p] in
/-- The generators lie in `Φ^e_z(𝔞^N M₀) 𝔍₀`. -/
theorem genSet_subset_thetaK {e N : ℕ} {𝔞 : Ideal X.ConeRing} {S : Set X.ConeRing}
    (hS : S ⊆ ((𝔞 ^ N : Ideal X.ConeRing) : Set X.ConeRing)) : D.genSet e S ⊆ D.thetaK e N 𝔞 := by
  rintro _ ⟨a, b, -, -, g, hg, c, c', rfl⟩
  refine D.traceIter_mul_iota_mem_thetaK ?_ (D.iota_mem_J0 c')
  rw [← Algebra.smul_def]
  exact Submodule.smul_mem_smul (Ideal.mul_mem_left _ _ (hS hg)) (D.mu_mem_M0 c)

/-- `Φ^e_z(t g μ_c) ι_{c'}` lies in the span of the generators for every `t ∈ T`: write `t` as a
sum of monomials `u^{p^e} x̄^a t^b` (`exists_coneMk_monomial_eq`). -/
theorem traceIter_mul_iota_mem_span_genSet {e : ℕ} {S : Set X.ConeRing} {g : X.ConeRing}
    (hg : g ∈ S) (c c' : Fin D.nCharts) (t : X.ConeRing) :
    D.isPBasis_z.traceIter e (algebraMap X.ConeRing (FractionRing X.ConeRing) t *
        (algebraMap X.ConeRing (FractionRing X.ConeRing) g * D.mu c)) *
      algebraMap X.ConeRing (FractionRing X.ConeRing) (D.iota c') ∈
        Submodule.span X.ConeRing (D.genSet e S) := by
  obtain ⟨F, rfl⟩ := coneMk_surjective (X := X) t
  induction F using Polynomial.induction_on' with
  | add F G hF hG =>
    rw [map_add, map_add, add_mul, D.isPBasis_z.traceIter_add, add_mul]
    exact Submodule.add_mem _ hF hG
  | monomial l A =>
    induction A using MvPolynomial.induction_on' with
    | add A B hA hB =>
      rw [map_add, map_add, map_add, add_mul, D.isPBasis_z.traceIter_add, add_mul]
      exact Submodule.add_mem _ hA hB
    | monomial β c₀ =>
      obtain ⟨u, a, b, ha, hb, hu⟩ := exists_coneMk_monomial_eq (X := X) p e β c₀ l
      rw [hu, map_mul, map_pow, mul_assoc, D.isPBasis_z.traceIter_pow_mul, mul_assoc,
        ← Algebra.smul_def]
      refine Submodule.smul_mem _ u (Submodule.subset_span ⟨a, b, ha, hb, g, hg, c, c', ?_⟩)
      rw [map_mul, mul_assoc]

/-- **Generators of `Θ`** (proof of `prop:sg-uniform-generation`): if `𝔞^N = (S)`, then
`Φ^e_z(𝔞^N M₀) 𝔍₀` is the `T`-span of the `Φ^e_z(x̄^a t^b g μ_c) ι_{c'}`, `a_i, b < p^e`,
`g ∈ S`. -/
theorem thetaK_le_span_genSet {e N : ℕ} {𝔞 : Ideal X.ConeRing} {S : Set X.ConeRing}
    (hS : 𝔞 ^ N = Ideal.span S) :
    D.thetaK e N 𝔞 ≤ Submodule.span X.ConeRing (D.genSet e S) := by
  -- the statement for `Φ^e_z(x) ι_{c'}`, `x ∈ 𝔞^N M₀`
  have key : ∀ x ∈ 𝔞 ^ N • D.M0, ∀ c' : Fin D.nCharts, D.isPBasis_z.traceIter e x *
      algebraMap X.ConeRing (FractionRing X.ConeRing) (D.iota c') ∈
        Submodule.span X.ConeRing (D.genSet e S) := by
    intro x hx
    have hx' : x ∈ Submodule.span X.ConeRing (S • Set.range D.mu) := by
      rw [← Submodule.span_smul_span, ← hS]
      exact hx
    suffices H : ∀ t : X.ConeRing, ∀ c', D.isPBasis_z.traceIter e (t • x) *
        algebraMap X.ConeRing (FractionRing X.ConeRing) (D.iota c') ∈
          Submodule.span X.ConeRing (D.genSet e S) by
      simpa using H 1
    clear hx
    induction hx' using Submodule.span_induction with
    | mem x h =>
      obtain ⟨g, hg, _, ⟨c, rfl⟩, rfl⟩ := h
      intro t c'
      change D.isPBasis_z.traceIter e (t • (g • D.mu c)) * _ ∈ _
      rw [Algebra.smul_def, Algebra.smul_def]
      exact D.traceIter_mul_iota_mem_span_genSet hg c c' t
    | zero =>
      intro t c'
      rw [smul_zero, D.isPBasis_z.traceIter_map_zero, zero_mul]
      exact Submodule.zero_mem _
    | add x y _ _ hx hy =>
      intro t c'
      rw [smul_add, D.isPBasis_z.traceIter_add, add_mul]
      exact Submodule.add_mem _ (hx t c') (hy t c')
    | smul s x _ hx =>
      intro t c'
      rw [smul_smul]
      exact hx (t * s) c'
  rw [thetaK, Submodule.mul_le]
  rintro _ ⟨x, hx, rfl⟩ _ ⟨j, hj, rfl⟩
  induction hj using Submodule.span_induction with
  | mem j h =>
    obtain ⟨c', rfl⟩ := h
    exact key x hx c'
  | zero =>
    rw [map_zero, mul_zero]
    exact Submodule.zero_mem _
  | add j j' _ _ hj hj' =>
    rw [map_add, mul_add]
    exact Submodule.add_mem _ hj hj'
  | smul t j _ hj =>
    rw [LinearMap.map_smul, mul_smul_comm]
    exact Submodule.smul_mem _ t hj

/-- **`Θ^e_N(𝔞)` is generated by the preimages of the generators** (proof of
`prop:sg-uniform-generation`). -/
theorem theta_eq_span_genSet {e N : ℕ} {𝔞 : Ideal X.ConeRing} {S : Set X.ConeRing}
    (hS : 𝔞 ^ N = Ideal.span S) :
    D.theta e N 𝔞 = Ideal.span
      {θ | algebraMap X.ConeRing (FractionRing X.ConeRing) θ ∈ D.genSet e S} := by
  have hSN : S ⊆ ((𝔞 ^ N : Ideal X.ConeRing) : Set X.ConeRing) := hS ▸ Ideal.subset_span
  apply le_antisymm
  · intro f hf
    have h1 : Submodule.span X.ConeRing (D.genSet e S) ≤
        Submodule.map (Algebra.linearMap X.ConeRing (FractionRing X.ConeRing))
          (Ideal.span {θ | algebraMap X.ConeRing (FractionRing X.ConeRing) θ ∈ D.genSet e S}) := by
      rw [Submodule.span_le]
      intro y hy
      obtain ⟨a, rfl⟩ := D.exists_eq_algebraMap_of_mem_thetaK (D.genSet_subset_thetaK hSN hy)
      exact Submodule.mem_map_of_mem (Ideal.subset_span hy)
    have h2 : f ∈ Submodule.comap (Algebra.linearMap X.ConeRing (FractionRing X.ConeRing))
        (Submodule.map (Algebra.linearMap X.ConeRing (FractionRing X.ConeRing))
          (Ideal.span {θ | algebraMap X.ConeRing (FractionRing X.ConeRing) θ ∈ D.genSet e S})) :=
      h1 (D.thetaK_le_span_genSet hS (D.mem_theta.1 hf))
    rwa [Submodule.comap_map_eq_of_injective
      (IsFractionRing.injective X.ConeRing (FractionRing X.ConeRing))] at h2
  · rw [Ideal.span_le]
    intro θ hθ
    exact D.mem_theta.2 (D.genSet_subset_thetaK hSN hθ)

/-! ### Degrees of the generators -/

/-- The generators are bihomogeneous: `Φ^e_z(x̄^a t^b g μ_c) ι_{c'}` is `0` or bihomogeneous of
some bidegree `(B, l')` with `p^e (B - n - N₁ deg s_{c'}) + (n + 1)(p^e - 1) =
|a| + deg g + N₁ deg s_c - n` (`lem:sg-homog-pbasis`(2)). -/
theorem genSet_isBihom (e : ℕ) (a : Fin (M + 1) →₀ ℕ) (b : ℕ) {g : X.ConeRing} {Dg l : ℕ}
    (hg : X.IsBihom (algebraMap X.ConeRing (FractionRing X.ConeRing) g) Dg l)
    (c c' : Fin D.nCharts) :
    D.isPBasis_z.traceIter e
        (algebraMap X.ConeRing (FractionRing X.ConeRing) (X.coneMono a b * g) * D.mu c) *
      algebraMap X.ConeRing (FractionRing X.ConeRing) (D.iota c') = 0 ∨
    ∃ (B : ℤ) (l' : ℕ), (p : ℤ) ^ e * (B - X.dim - (D.N1 * ((D.chart c').e + 1) : ℕ)) +
        (X.dim + 1) * ((p : ℤ) ^ e - 1) =
          (a.degree : ℤ) + Dg + ((D.N1 * ((D.chart c).e + 1) : ℕ) - X.dim) ∧
      X.IsBihom (D.isPBasis_z.traceIter e
        (algebraMap X.ConeRing (FractionRing X.ConeRing) (X.coneMono a b * g) * D.mu c) *
          algebraMap X.ConeRing (FractionRing X.ConeRing) (D.iota c')) B l' := by
  have hf : X.IsBihom (algebraMap X.ConeRing (FractionRing X.ConeRing) (X.coneMono a b * g) *
      D.mu c) ((a.degree : ℤ) + Dg + ((D.N1 * ((D.chart c).e + 1) : ℕ) - X.dim)) (b + l + 0) := by
    rw [map_mul]
    exact ((isBihom_coneMono a b).mul hg).mul (D.isBihom_mu c)
  rcases hf.traceIter_coneZ p D.isPBasis_z e with h0 | ⟨b', l', hb', -, hbih⟩
  · left
    rw [h0, zero_mul]
  · right
    refine ⟨b' + X.dim + (D.N1 * ((D.chart c').e + 1) : ℕ), l' + 0, by rw [← hb']; ring, ?_⟩
    have := hbih.mul (D.isBihom_iota c')
    rwa [show b' + (((D.N1 * ((D.chart c').e + 1) : ℕ) : ℤ) + X.dim) =
      b' + X.dim + (D.N1 * ((D.chart c').e + 1) : ℕ) by ring] at this

/-! ### Uniform generation (`prop:sg-uniform-generation`) -/

/-- The twist `c₀ = M + 1 + max_c N₁ deg(s_c)` of `prop:sg-uniform-generation` (the blueprint's
`M - n + 1 + max_c deg(ι_c)`, as `deg ι_c = N₁ deg(s_c) + n`). -/
def c0 : ℕ := M + 1 + Finset.univ.sup fun c => D.N1 * ((D.chart c).e + 1)

/-- The degree count of `prop:sg-uniform-generation`: if
`Q (B - n - E') + (n + 1)(Q - 1) = A + N r d + E - n` with `A ≤ (M + 1)(Q - 1)` (the degree of
`x̄^a`, `a_i < Q`), `N r ≤ m Q + r`, `E, E' ≤ δ` and `r d + δ ≤ Q`, then `B ≤ m d + M + 1 + δ`. -/
theorem le_of_degree_eq {Q M n m d r N δ E E' A : ℕ} {B : ℤ} (hQ : 0 < Q)
    (hA : A ≤ (M + 1) * (Q - 1)) (hN : N * r ≤ m * Q + r) (hE : E ≤ δ) (hE' : E' ≤ δ)
    (hQd : r * d + δ ≤ Q)
    (h : (Q : ℤ) * (B - n - E') + (n + 1) * ((Q : ℤ) - 1) = (A : ℤ) + (N * (r * d) : ℕ) + (E - n)) :
    B ≤ (m * d + (M + 1 + δ) : ℕ) := by
  have hQ1 : ((Q - 1 : ℕ) : ℤ) = (Q : ℤ) - 1 := by rw [Nat.cast_sub hQ]; simp
  have hA' : (A : ℤ) ≤ ((M : ℤ) + 1) * ((Q : ℤ) - 1) := by
    rw [← hQ1]; exact_mod_cast hA
  have hN' : ((N * (r * d) : ℕ) : ℤ) ≤ (m : ℤ) * Q * d + r * d := by
    have : N * r * d ≤ (m * Q + r) * d := Nat.mul_le_mul_right d hN
    have : ((N * r * d : ℕ) : ℤ) ≤ (((m * Q + r) * d : ℕ) : ℤ) := by exact_mod_cast this
    push_cast at this ⊢
    linarith
  have hE1 : (E : ℤ) ≤ δ := by exact_mod_cast hE
  have hE2 : (E' : ℤ) ≤ δ := by exact_mod_cast hE'
  have hQd' : (r : ℤ) * d + δ ≤ Q := by exact_mod_cast hQd
  have hQ' : (0 : ℤ) < Q := by exact_mod_cast hQ
  have key : (Q : ℤ) * (B - n - E') ≤ Q * ((M : ℤ) + 1 + m * d - n) := by
    nlinarith
  have h2 : B - n - E' ≤ (M : ℤ) + 1 + m * d - n := le_of_mul_le_mul_left key hQ'
  push_cast
  linarith

/-- **Uniform generation** (`prop:sg-uniform-generation`): let `J_•` be a graded sequence of
nonzero ideals of `T` with `J_r` generated by elements `t^l s̄`, `s` a form of degree `r d`. For
every `m` there is a finite set `G ⊆ T` of elements `s̄ t^l`, `s` a form of degree
`≤ m d + c₀`, with `(G) ⊆ B_m ⊆ (G)^sat`; `c₀ = ConeTraceData.c0 D` does not depend on `m`,
`d` or `J_•`. -/
theorem exists_span_le_testSeq_le_saturation {J : ℕ → Ideal X.ConeRing}
    (hJ : ∀ m r, J m * J r ≤ J (m + r)) (hne : ∀ q, 0 < q → J q ≠ ⊥) {d : ℕ}
    (hgen : ∀ r, 0 < r → ∃ S : Set X.ConeRing, J r = Ideal.span S ∧
      ∀ f ∈ S, ∃ (l : ℕ) (s : MvPolynomial (Fin (M + 1)) k), s.IsHomogeneous (r * d) ∧
        f = Polynomial.monomial l (X.coordMk s))
    (m : ℕ) :
    ∃ G : Set X.ConeRing, G.Finite ∧
      (∀ g ∈ G, ∃ (s : MvPolynomial (Fin (M + 1)) k) (b l : ℕ), b ≤ m * d + D.c0 ∧
        s.IsHomogeneous b ∧ g = X.coneMk (Polynomial.C s * Polynomial.X ^ l)) ∧
      Ideal.span G ≤ D.testSeq J m ∧ D.testSeq J m ≤ X.saturation (Ideal.span G) := by
  set δ := Finset.univ.sup fun c => D.N1 * ((D.chart c).e + 1) with hδ
  obtain ⟨r, hr, h⟩ := D.exists_theta_le_testSeq hJ hne m
  obtain ⟨e₀, he₀⟩ := h r hr dvd_rfl
  set e := e₀ + (r * d + δ)
  obtain ⟨h1, h2, -⟩ := he₀ e (Nat.le_add_right _ _)
  have hQ : 0 < p ^ e := pow_pos hp.out.pos e
  have hQd : r * d + δ ≤ p ^ e :=
    ((Nat.le_add_left _ e₀).trans_lt (Nat.lt_pow_self hp.out.one_lt)).le
  set N := ⌈(m : ℚ) / r * (p : ℚ) ^ e⌉₊
  have hNr : N * r ≤ m * p ^ e + r := by
    have h3 : (N : ℚ) < (m : ℚ) / r * (p : ℚ) ^ e + 1 := Nat.ceil_lt_add_one (by positivity)
    have hr' : (0 : ℚ) < r := by exact_mod_cast hr
    have h4 : (N : ℚ) * r < (m : ℚ) * (p : ℚ) ^ e + r :=
      calc (N : ℚ) * r < ((m : ℚ) / r * (p : ℚ) ^ e + 1) * r := mul_lt_mul_of_pos_right h3 hr'
        _ = (m : ℚ) * (p : ℚ) ^ e + r := by field_simp
    have h5 : N * r < m * p ^ e + r := by exact_mod_cast h4
    exact h5.le
  -- generators of `J_r` and of `J_r^N`
  obtain ⟨S, hS, hS'⟩ := hgen r hr
  have hSb : ∀ f ∈ S, ∃ l,
      X.IsBihom (algebraMap X.ConeRing (FractionRing X.ConeRing) f) (r * d : ℕ) l := by
    intro f hf
    obtain ⟨l, s, hs, rfl⟩ := hS' f hf
    refine ⟨l, ?_⟩
    rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, ← fracMk_apply]
    exact isBihom_fracMk_mul hs l
  have hpow := pow_eq_span_isBihom hS hSb N
  have hΘ := D.theta_eq_span_genSet (e := e) hpow
  -- the degrees of the generators
  have hdeg : ∀ θ ∈ {θ | algebraMap X.ConeRing (FractionRing X.ConeRing) θ ∈ D.genSet e
      {g | g ∈ J r ^ N ∧
        ∃ l, X.IsBihom (algebraMap X.ConeRing (FractionRing X.ConeRing) g) (N * (r * d) : ℕ) l}},
      ∃ (s : MvPolynomial (Fin (M + 1)) k) (b l : ℕ), b ≤ m * d + D.c0 ∧
        s.IsHomogeneous b ∧ θ = X.coneMk (Polynomial.C s * Polynomial.X ^ l) := by
    rintro θ ⟨a, b, ha, -, g, ⟨-, l, hgl⟩, c, c', hθ⟩
    rcases D.genSet_isBihom e a b hgl c c' with h0 | ⟨B, l', hB, hBih⟩
    · refine ⟨0, 0, 0, Nat.zero_le _, MvPolynomial.isHomogeneous_zero _ _ _, ?_⟩
      rw [h0] at hθ
      rw [(map_eq_zero_iff _ (IsFractionRing.injective _ _)).1 hθ]
      simp
    · rw [← hθ] at hBih
      obtain ⟨s, hs, hθs⟩ := exists_eq_coneMk_of_isBihom hBih
      refine ⟨s, B.toNat, l', ?_, hs, hθs⟩
      have hA : a.degree ≤ (M + 1) * (p ^ e - 1) := by
        rw [Finsupp.degree_eq_sum]
        calc ∑ i, a i ≤ ∑ _i : Fin (M + 1), (p ^ e - 1) :=
              Finset.sum_le_sum fun i _ => Nat.le_sub_one_of_lt (ha i)
          _ = (M + 1) * (p ^ e - 1) := by simp
      have hE : ∀ c : Fin D.nCharts, D.N1 * ((D.chart c).e + 1) ≤ δ := fun c =>
        Finset.le_sup (f := fun c => D.N1 * ((D.chart c).e + 1)) (Finset.mem_univ c)
      have hB' := le_of_degree_eq (Q := p ^ e) (n := X.dim) (m := m) (d := d) (r := r) (N := N)
        (δ := δ) (E := D.N1 * ((D.chart c).e + 1)) (E' := D.N1 * ((D.chart c').e + 1))
        (A := a.degree) (B := B) hQ hA hNr (hE c) (hE c') hQd (by push_cast; exact hB)
      have : B.toNat ≤ m * d + (M + 1 + δ) := by omega
      exact this
  -- a finite subset of generators
  obtain ⟨G, hGsub, hGspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset _).1
    (IsNoetherian.noetherian (Ideal.span {θ | algebraMap X.ConeRing (FractionRing X.ConeRing) θ ∈
      D.genSet e {g | g ∈ J r ^ N ∧
        ∃ l, X.IsBihom (algebraMap X.ConeRing (FractionRing X.ConeRing) g) (N * (r * d) : ℕ) l}}))
  have hGΘ : Ideal.span (G : Set X.ConeRing) = D.theta e N (J r) := by
    rw [hΘ]
    exact hGspan.symm
  refine ⟨G, G.finite_toSet, fun g hg => hdeg g (hGsub hg), ?_, ?_⟩
  · rw [hGΘ]
    exact h1
  · rw [hGΘ]
    exact h2

end ConeTraceData

/-- The saturation of `0` is `0` (`T` is a domain and `𝔪₊ ≠ 0`). -/
theorem saturation_bot : X.saturation (⊥ : Ideal X.ConeRing) = ⊥ := by
  refine le_bot_iff.1 fun f hf => ?_
  obtain ⟨r, hr⟩ := mem_saturation_iff.1 hf
  obtain ⟨j, hj⟩ := X.exists_X_notMem
  have hx : X.coneS (MvPolynomial.X j) ^ r ∈ X.coneIrrelevant ^ r :=
    Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self
      (f := fun i => Polynomial.C (X.coordMk (MvPolynomial.X i))) j)) r
  have h0 := hr _ hx
  rw [Ideal.mem_bot, mul_eq_zero] at h0
  rw [Ideal.mem_bot]
  exact h0.resolve_left (pow_ne_zero _ (coneS_ne_zero hj))

namespace ConeTraceData

variable {p : ℕ} [hp : Fact p.Prime] [CharP k p] [PerfectRing k p] (D : X.ConeTraceData p)

/-- **`m⁻¹ φ_{B_m} ∈ 𝓗(X, d + c₀/m)`** (`prop:sg-uniform-generation`, consequence; step (a) of
`thm:sg-ep-charp`): for `J_•` as in `exists_span_le_testSeq_le_saturation` and `m ≥ 1`,
`φ_{B_m} = φ_{(G)}` is a Fubini–Study function of class `m d + c₀` with integer weights
(`lem:sg-phi-basic`(2),(3)), and `m⁻¹ φ_{B_m}` one of class `d + c₀/m` (FS4). -/
theorem isFS_inv_mul_phiIdeal_testSeq {J : ℕ → Ideal X.ConeRing}
    (hJ : ∀ m r, J m * J r ≤ J (m + r)) (hne : ∀ q, 0 < q → J q ≠ ⊥) {d : ℕ}
    (hgen : ∀ r, 0 < r → ∃ S : Set X.ConeRing, J r = Ideal.span S ∧
      ∀ f ∈ S, ∃ (l : ℕ) (s : MvPolynomial (Fin (M + 1)) k), s.IsHomogeneous (r * d) ∧
        f = Polynomial.monomial l (X.coordMk s))
    {m : ℕ} (hm : 0 < m) :
    X.IsFS ((d : ℚ) + D.c0 / m) fun v =>
      (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal ((D.testSeq J m).comap X.coneMk) v.1 := by
  classical
  obtain ⟨G, -, hGdeg, hGle, hGsat⟩ := D.exists_span_le_testSeq_le_saturation hJ hne hgen m
  choose s b l hb hs hg using hGdeg
  set G' : Set (MvPolynomial (Fin (M + 1)) k)[X] :=
    Set.range fun g : G => Polynomial.C (s g.1 g.2) * Polynomial.X ^ l g.1 g.2
  have hG' : Ideal.span G = (Ideal.span G').map X.coneMk := by
    rw [Ideal.map_span]
    congr 1
    ext g
    constructor
    · intro hgG
      exact ⟨_, ⟨⟨g, hgG⟩, rfl⟩, (hg g hgG).symm⟩
    · rintro ⟨_, ⟨⟨g', hg'⟩, rfl⟩, rfl⟩
      rw [← hg g' hg']
      exact hg'
  -- `φ_{B_m} = φ_{(G')}` on `X^an`
  have hφ : ∀ v : X.an, phiIdeal ((D.testSeq J m).comap X.coneMk) v.1 =
      phiIdeal (Ideal.span G') v.1 := by
    intro v
    rw [phiIdeal_comap_eq_of_le_of_le_saturation hGle hGsat, hG',
      Ideal.comap_map_of_surjective' _ coneMk_surjective, phiIdeal_sup_ker_coneMk]
  -- some generator is nonzero in `T`
  have hne' : ∃ F ∈ G', X.coneMk F ≠ 0 := by
    by_contra h0
    push Not at h0
    have hbot : Ideal.span G = ⊥ := by
      rw [hG', Ideal.map_eq_bot_iff_le_ker, Ideal.span_le]
      exact fun F hF => RingHom.mem_ker.2 (h0 F hF)
    have hB : D.testSeq J m = ⊥ := by
      rw [hbot, saturation_bot] at hGsat
      exact le_bot_iff.1 hGsat
    exact hne m hm (le_bot_iff.1 (hB ▸ D.le_testSeq J hm))
  have hdegG' : ∀ F ∈ G', ∀ ℓ, ∃ e ≤ 1 * (m * d + D.c0), (F.coeff ℓ).IsHomogeneous e := by
    rintro _ ⟨⟨g, hgG⟩, rfl⟩ ℓ
    rw [Polynomial.coeff_C_mul_X_pow]
    split_ifs
    · exact ⟨b g hgG, by rw [one_mul]; exact hb g hgG, hs g hgG⟩
    · exact ⟨0, Nat.zero_le _, MvPolynomial.isHomogeneous_zero _ _ _⟩
  obtain ⟨D', -, hD't, hD'⟩ := isFS_inv_mul_phiIdeal (X := X) (m := 1) (d := m * d + D.c0)
    one_pos rfl hdegG' hne'
  have hFS : X.IsFS ((m * d + D.c0 : ℕ) : ℚ) fun v => phiIdeal (Ideal.span G') v.1 :=
    ⟨D', hD't, fun v => by rw [hD' v.1]; simp⟩
  have hm' : (0 : ℚ) < (m : ℚ)⁻¹ := inv_pos.2 (Nat.cast_pos.2 hm)
  have h := hFS.smul hm'
  have hclass : (m : ℚ)⁻¹ * ((m * d + D.c0 : ℕ) : ℚ) = (d : ℚ) + D.c0 / m := by
    have : (m : ℚ) ≠ 0 := Nat.cast_ne_zero.2 hm.ne'
    push_cast
    field_simp
  rw [hclass] at h
  convert h using 2 with v
  rw [hφ v]
  push_cast
  rfl

end ConeTraceData

