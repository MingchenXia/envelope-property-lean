import EnvelopeProperty.Algebra.Rees

/-!
# Graded subalgebras of `A[T]`

Let `k` be a field and `A` a commutative `k`-algebra. The polynomial ring `A[T]` (Lean:
`Polynomial A`, the variable `T` is `Polynomial.X`) is graded by the degree in `T`. Following
`conv:wu-graded` of the blueprint chapter `wu-discharge.tex` (subsection
`subsec:wu-compactification`, used for Fang–Han–Xia, *The envelope property for unibranch
projective varieties*, Lemma 5.9 `lem:boundary-presentation` and Corollary 5.26), a *graded
subalgebra* `B ⊆ A[T]` is a `k`-subalgebra containing the homogeneous components of its
elements, and `B_d = B ∩ A T^d`.

Mathlib has no theory of graded integral closures or Veronese subalgebras, so we work
concretely inside `A[T]`:

* `EnvelopeProperty.homogComp d p = p_d T^d` is the homogeneous component of degree `d`, an
  `A`-linear map `A[T] → A[T]`; `EnvelopeProperty.IsHomog d p` says `p = a T^d`.
* `EnvelopeProperty.IsTGraded B` says that `B` contains the homogeneous components of its
  elements, and `EnvelopeProperty.gradedPiece B d : Submodule k A[T]` is `B_d`.
* `EnvelopeProperty.homLoc B s d : Subalgebra k (FractionRing A)` models `B_{(σ)}`, the degree
  zero part of `B[σ⁻¹]` for `σ = s T^d`: its elements are the fractions `a / s^j` with
  `a T^{jd} ∈ B`. When `A` is a domain, `s ≠ 0` and `σ ∈ B`, the map `b / σ^j ↦ b_{jd} / s^j`
  identifies the degree zero part of `B[σ⁻¹] ⊆ Frac A[T]` with this subalgebra of `Frac A`
  (`EnvelopeProperty.mem_homLoc_iff`).

## Main results

* `EnvelopeProperty.isGraded_adjoin`: a subalgebra generated by homogeneous elements is graded.
* `EnvelopeProperty.homogComp_mem_of_torus`: a `k`-submodule of `A[T]` stable under the torus
  automorphisms `T ↦ λ T` (`EnvelopeProperty.torusAut`, `λ ∈ kˣ`) contains the homogeneous
  components of its elements, if `k` is infinite (the Vandermonde argument of
  `lem:wu-graded-closure`(1)).
* `EnvelopeProperty.exists_homog_integral_eq`: an element `b ∈ B_d` integral over a graded
  subalgebra `S` satisfies a homogeneous integral equation
  `b^n + s_{n-1} b^{n-1} + ⋯ + s_0 = 0` with `s_i ∈ S_{(n-i)d}` ("taking homogeneous components
  of an integral equation", used in `lem:wu-graded-closure`(3),(4),(6)).
* `EnvelopeProperty.gradedPiece_adjoin_le_span`,
  `EnvelopeProperty.finiteDimensional_gradedPiece_adjoin`: if `B` is generated by homogeneous
  elements `b_i` of degrees `d_i`, then `B_n` is spanned by the monomials `∏ b_i^{α_i}` with
  `∑ α_i d_i = n`, hence is finite dimensional when all `d_i > 0`.
* `EnvelopeProperty.exists_homog_generators`: a finitely generated graded subalgebra with
  `B_0 = k` is generated by finitely many homogeneous elements of positive degree.
* `EnvelopeProperty.homLoc_one_eq_range`, `EnvelopeProperty.homLocOneEquiv`: if every `a ∈ A`
  has some `a T^{jd} ∈ B`, then `B_{(T^d)} ≅ A` via `b T^{jd} / T^{jd} ↦ b`.
-/

open Polynomial

noncomputable section

namespace EnvelopeProperty

/-! ### Homogeneous components -/

section Homog

variable {A : Type*} [CommRing A]

/-- The homogeneous component `p_d T^d` of degree `d` of `p ∈ A[T]`. -/
def homogComp (d : ℕ) : A[X] →ₗ[A] A[X] :=
  (monomial d).comp (lcoeff A d)

theorem homogComp_apply (d : ℕ) (p : A[X]) : homogComp d p = monomial d (p.coeff d) :=
  rfl

theorem coeff_homogComp (d n : ℕ) (p : A[X]) :
    (homogComp d p).coeff n = if d = n then p.coeff d else 0 := by
  rw [homogComp_apply, coeff_monomial]

theorem homogComp_monomial (d n : ℕ) (a : A) :
    homogComp d (monomial n a) = if n = d then monomial n a else 0 := by
  rw [homogComp_apply, coeff_monomial]
  split_ifs with h
  · rw [h]
  · rw [map_zero]

/-- `p` is homogeneous of degree `d` in `T`: `p = a T^d`. -/
def IsHomog (d : ℕ) (p : A[X]) : Prop :=
  ∃ a, p = monomial d a

theorem isHomog_monomial (d : ℕ) (a : A) : IsHomog d (monomial d a) :=
  ⟨a, rfl⟩

theorem isHomog_C_mul_X_pow (d : ℕ) (a : A) : IsHomog d (C a * X ^ d) :=
  ⟨a, C_mul_X_pow_eq_monomial⟩

theorem isHomog_zero (d : ℕ) : IsHomog d (0 : A[X]) :=
  ⟨0, (map_zero _).symm⟩

theorem isHomog_homogComp (d : ℕ) (p : A[X]) : IsHomog d (homogComp d p) :=
  ⟨_, rfl⟩

theorem isHomog_iff {d : ℕ} {p : A[X]} : IsHomog d p ↔ homogComp d p = p := by
  refine ⟨?_, fun h => ⟨p.coeff d, h.symm⟩⟩
  rintro ⟨a, rfl⟩
  rw [homogComp_monomial, if_pos rfl]

theorem IsHomog.homogComp_self {d : ℕ} {p : A[X]} (h : IsHomog d p) : homogComp d p = p :=
  isHomog_iff.1 h

theorem IsHomog.homogComp_of_ne {d n : ℕ} {p : A[X]} (h : IsHomog d p) (hn : d ≠ n) :
    homogComp n p = 0 := by
  obtain ⟨a, rfl⟩ := h
  rw [homogComp_monomial, if_neg hn]

theorem IsHomog.coeff_of_ne {d n : ℕ} {p : A[X]} (h : IsHomog d p) (hn : n ≠ d) :
    p.coeff n = 0 := by
  obtain ⟨a, rfl⟩ := h
  rw [coeff_monomial, if_neg (Ne.symm hn)]

theorem IsHomog.eq_monomial {d : ℕ} {p : A[X]} (h : IsHomog d p) : p = monomial d (p.coeff d) :=
  h.homogComp_self.symm

theorem IsHomog.add {d : ℕ} {p q : A[X]} (hp : IsHomog d p) (hq : IsHomog d q) :
    IsHomog d (p + q) := by
  obtain ⟨a, rfl⟩ := hp
  obtain ⟨b, rfl⟩ := hq
  exact ⟨a + b, (map_add _ _ _).symm⟩

theorem IsHomog.mul {d e : ℕ} {p q : A[X]} (hp : IsHomog d p) (hq : IsHomog e q) :
    IsHomog (d + e) (p * q) := by
  obtain ⟨a, rfl⟩ := hp
  obtain ⟨b, rfl⟩ := hq
  exact ⟨a * b, monomial_mul_monomial _ _ _ _⟩

theorem IsHomog.pow {d : ℕ} {p : A[X]} (hp : IsHomog d p) (n : ℕ) : IsHomog (n * d) (p ^ n) := by
  obtain ⟨a, rfl⟩ := hp
  exact ⟨a ^ n, by rw [monomial_pow, mul_comm]⟩

theorem isHomog_prod {ι : Type*} (s : Finset ι) (f : ι → A[X]) (d : ι → ℕ)
    (h : ∀ i ∈ s, IsHomog (d i) (f i)) : IsHomog (∑ i ∈ s, d i) (∏ i ∈ s, f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨1, by simp⟩
  | insert i s hi ih =>
    rw [Finset.sum_insert hi, Finset.prod_insert hi]
    exact (h i (Finset.mem_insert_self i s)).mul
      (ih fun j hj => h j (Finset.mem_insert_of_mem hj))

theorem IsHomog.smul {R : Type*} [CommSemiring R] [Algebra R A] {d : ℕ} {p : A[X]}
    (hp : IsHomog d p) (c : R) : IsHomog d (c • p) := by
  obtain ⟨a, rfl⟩ := hp
  exact ⟨c • a, smul_monomial _ _ _⟩

theorem homogComp_smul {R : Type*} [CommSemiring R] [Algebra R A] (d : ℕ) (c : R) (p : A[X]) :
    homogComp d (c • p) = c • homogComp d p := by
  rw [homogComp_apply, homogComp_apply, coeff_smul, smul_monomial]

theorem homogComp_algebraMap {R : Type*} [CommSemiring R] [Algebra R A] (d : ℕ) (c : R) :
    homogComp d (algebraMap R A[X] c) = if d = 0 then algebraMap R A[X] c else 0 := by
  rw [Polynomial.algebraMap_apply, ← monomial_zero_left, homogComp_monomial]
  split_ifs with h h' h' <;> first | rfl | omega

/-- The homogeneous components of a product: `(pq)_n = ∑_{i + j = n} p_i q_j`. -/
theorem homogComp_mul (n : ℕ) (p q : A[X]) :
    homogComp n (p * q) =
      ∑ x ∈ Finset.HasAntidiagonal.antidiagonal n, homogComp x.1 p * homogComp x.2 q := by
  rw [homogComp_apply, coeff_mul, map_sum]
  refine Finset.sum_congr rfl fun x hx => ?_
  rw [homogComp_apply, homogComp_apply, monomial_mul_monomial,
    Finset.HasAntidiagonal.mem_antidiagonal.1 hx]

/-- Multiplying by a homogeneous element of degree `j` shifts homogeneous components by `j`. -/
theorem homogComp_mul_of_isHomog {j : ℕ} {q : A[X]} (hq : IsHomog j q) (i : ℕ) (p : A[X]) :
    homogComp (i + j) (p * q) = homogComp i p * q := by
  obtain ⟨b, rfl⟩ := hq
  rw [homogComp_apply, homogComp_apply, coeff_mul_monomial, monomial_mul_monomial]

theorem homogComp_mul_of_isHomog_of_lt {j n : ℕ} {q : A[X]} (hq : IsHomog j q) (h : n < j)
    (p : A[X]) : homogComp n (p * q) = 0 := by
  obtain ⟨b, rfl⟩ := hq
  rw [homogComp_apply, show monomial j b = C b * X ^ j from C_mul_X_pow_eq_monomial.symm,
    ← mul_assoc, coeff_mul_X_pow', if_neg (by omega), map_zero]

/-- A polynomial is the sum of its homogeneous components. -/
theorem sum_homogComp (p : A[X]) :
    ∑ d ∈ Finset.range (p.natDegree + 1), homogComp d p = p :=
  (as_sum_range p).symm

theorem homogComp_eq_zero_of_natDegree_lt {d : ℕ} {p : A[X]} (h : p.natDegree < d) :
    homogComp d p = 0 := by
  rw [homogComp_apply, coeff_eq_zero_of_natDegree_lt h, map_zero]

end Homog

/-! ### Graded subalgebras -/

section Graded

variable {k A : Type*} [Field k] [CommRing A] [Algebra k A]

/-- A `k`-subalgebra `B ⊆ A[T]` is *graded* if it contains the homogeneous components of its
elements (`conv:wu-graded`). -/
def IsTGraded (B : Subalgebra k A[X]) : Prop :=
  ∀ p ∈ B, ∀ d, homogComp d p ∈ B

/-- The graded piece `B_d = B ∩ A T^d` of a subalgebra `B ⊆ A[T]`, as a `k`-submodule. -/
def gradedPiece (B : Subalgebra k A[X]) (d : ℕ) : Submodule k A[X] where
  carrier := {p | p ∈ B ∧ IsHomog d p}
  zero_mem' := ⟨B.zero_mem, isHomog_zero d⟩
  add_mem' := fun hp hq => ⟨B.add_mem hp.1 hq.1, hp.2.add hq.2⟩
  smul_mem' := fun c _ hp => ⟨B.smul_mem hp.1 c, hp.2.smul c⟩

variable {B : Subalgebra k A[X]}

theorem mem_gradedPiece {d : ℕ} {p : A[X]} : p ∈ gradedPiece B d ↔ p ∈ B ∧ IsHomog d p :=
  Iff.rfl

theorem monomial_mem_gradedPiece {d : ℕ} {a : A} :
    monomial d a ∈ gradedPiece B d ↔ monomial d a ∈ B :=
  ⟨fun h => h.1, fun h => ⟨h, isHomog_monomial d a⟩⟩

theorem IsTGraded.homogComp_mem (hB : IsTGraded B) {p : A[X]} (hp : p ∈ B) (d : ℕ) :
    homogComp d p ∈ gradedPiece B d :=
  ⟨hB p hp d, isHomog_homogComp d p⟩

theorem IsTGraded.monomial_coeff_mem (hB : IsTGraded B) {p : A[X]} (hp : p ∈ B) (d : ℕ) :
    monomial d (p.coeff d) ∈ B :=
  hB p hp d

theorem gradedPiece_mul_le (d e : ℕ) :
    gradedPiece B d * gradedPiece B e ≤ gradedPiece B (d + e) :=
  Submodule.mul_le.2 fun _ hp _ hq => ⟨B.mul_mem hp.1 hq.1, hp.2.mul hq.2⟩

theorem one_le_gradedPiece_zero : (1 : Submodule k A[X]) ≤ gradedPiece B 0 :=
  Submodule.one_le.2 ⟨B.one_mem, ⟨1, by rw [monomial_zero_left, C_1]⟩⟩

theorem gradedPiece_pow_le (d n : ℕ) : gradedPiece B d ^ n ≤ gradedPiece B (n * d) := by
  induction n with
  | zero => rw [pow_zero, zero_mul]; exact one_le_gradedPiece_zero
  | succ n ih =>
    rw [pow_succ, Nat.succ_mul]
    exact Submodule.mul_le.2 fun x hx y hy =>
      gradedPiece_mul_le _ _ (Submodule.mul_mem_mul (ih hx) hy)

/-- A subalgebra generated by homogeneous elements is graded. -/
theorem isGraded_adjoin {s : Set A[X]} (hs : ∀ p ∈ s, ∃ d, IsHomog d p) :
    IsTGraded (Algebra.adjoin k s) := by
  intro p hp
  induction hp using Algebra.adjoin_induction with
  | mem p hp =>
    intro d
    obtain ⟨e, he⟩ := hs p hp
    by_cases hed : e = d
    · rw [← hed, he.homogComp_self]
      exact Algebra.subset_adjoin hp
    · rw [he.homogComp_of_ne hed]
      exact Subalgebra.zero_mem _
  | algebraMap c =>
    intro d
    rw [homogComp_algebraMap]
    split_ifs
    · exact Subalgebra.algebraMap_mem _ c
    · exact Subalgebra.zero_mem _
  | add p q _ _ hp hq =>
    intro d
    rw [map_add]
    exact Subalgebra.add_mem _ (hp d) (hq d)
  | mul p q _ _ hp hq =>
    intro d
    rw [homogComp_mul]
    exact Subalgebra.sum_mem _ fun x _ => Subalgebra.mul_mem _ (hp x.1) (hq x.2)

/-- If all generators have zero constant term, then every element of the generated subalgebra
has constant term in `k`. -/
theorem exists_algebraMap_eq_coeff_zero {s : Set A[X]} (hs : ∀ p ∈ s, p.coeff 0 = 0)
    {p : A[X]} (hp : p ∈ Algebra.adjoin k s) : ∃ c : k, algebraMap k A c = p.coeff 0 := by
  induction hp using Algebra.adjoin_induction with
  | mem p hp => exact ⟨0, by rw [hs p hp, map_zero]⟩
  | algebraMap c => exact ⟨c, by rw [Polynomial.algebraMap_apply, coeff_C_zero]⟩
  | add p q _ _ hp hq =>
    obtain ⟨a, ha⟩ := hp
    obtain ⟨b, hb⟩ := hq
    exact ⟨a + b, by rw [map_add, ha, hb, coeff_add]⟩
  | mul p q _ _ hp hq =>
    obtain ⟨a, ha⟩ := hp
    obtain ⟨b, hb⟩ := hq
    exact ⟨a * b, by rw [map_mul, ha, hb, mul_coeff_zero]⟩

end Graded

/-! ### The torus action and gradedness -/

section Torus

variable {k A : Type*} [Field k] [CommRing A] [Algebra k A]

omit [Algebra k A] in
/-- An infinite field has infinitely many units. -/
theorem infinite_units_of_infinite [Infinite k] : Infinite kˣ := by
  have : Infinite ↥(({0} : Set k)ᶜ) := (Set.finite_singleton (0 : k)).infinite_compl.to_subtype
  exact Infinite.of_injective (fun x : ↥(({0} : Set k)ᶜ) => Units.mk0 x.1 x.2)
    fun x y hxy => Subtype.ext (congrArg Units.val hxy)

variable (k) in
/-- **Vandermonde step of `lem:wu-graded-closure`(1).** Each homogeneous component `p_d T^d` of
`p ∈ A[T]` is a `k`-linear combination of the `p(λ_i T)` for `deg p + 1` distinct `λ_i ∈ kˣ`. -/
theorem homogComp_mem_span_torusAut [Infinite k] (p : A[X]) (d : ℕ) :
    homogComp d p ∈ Submodule.span k (Set.range fun c : kˣ => torusAut A c p) := by
  rcases lt_or_ge p.natDegree d with hd | hd
  · rw [homogComp_eq_zero_of_natDegree_lt hd]
    exact Submodule.zero_mem _
  have := infinite_units_of_infinite (k := k)
  set n := p.natDegree + 1
  let μ : Fin n ↪ kˣ := Fin.valEmbedding.trans (Infinite.natEmbedding kˣ)
  set ν : Fin n → k := fun i => (μ i : k)
  have hν : Function.Injective ν := fun i j hij => μ.injective (Units.ext hij)
  set Vd := Matrix.vandermonde ν
  have hdet : IsUnit Vd.det := isUnit_iff_ne_zero.2 (Matrix.det_vandermonde_ne_zero_iff.2 hν)
  have hAV : Vd⁻¹ * Vd = 1 := Matrix.nonsing_inv_mul Vd hdet
  set d' : Fin n := ⟨d, Nat.lt_succ_of_le hd⟩
  have key : homogComp d p = ∑ i, Vd⁻¹ d' i • torusAut A (μ i) p := by
    ext j
    rw [coeff_homogComp, finsetSum_coeff]
    simp only [coeff_smul, coeff_torusAut]
    simp only [Algebra.smul_def]
    have hsum : ∑ i, algebraMap k A (Vd⁻¹ d' i) * (p.coeff j * algebraMap k A (ν i ^ j)) =
        p.coeff j * algebraMap k A (∑ i, Vd⁻¹ d' i * ν i ^ j) := by
      rw [map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul]
      ring
    change _ = ∑ i, algebraMap k A (Vd⁻¹ d' i) * (p.coeff j * algebraMap k A (ν i ^ j))
    rw [hsum]
    rcases lt_or_ge p.natDegree j with hj | hj
    · rw [coeff_eq_zero_of_natDegree_lt hj, zero_mul, if_neg (by omega)]
    · have : ∑ i, Vd⁻¹ d' i * ν i ^ j = (Vd⁻¹ * Vd) d' ⟨j, Nat.lt_succ_of_le hj⟩ := by
        rw [Matrix.mul_apply]
        rfl
      rw [this, hAV, Matrix.one_apply]
      by_cases hjd : d = j
      · subst hjd
        rw [if_pos rfl, if_pos rfl, map_one, mul_one]
      · rw [if_neg hjd, if_neg (fun h => hjd (congrArg Fin.val h)), map_zero, mul_zero]
  rw [key]
  exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨μ i, rfl⟩)

/-- A `k`-submodule of `A[T]` stable under the torus automorphisms `T ↦ λ T`, `λ ∈ kˣ`, contains
the homogeneous components of its elements, if `k` is infinite. -/
theorem homogComp_mem_of_torus [Infinite k] (M : Submodule k A[X])
    (hM : ∀ (c : kˣ), ∀ p ∈ M, torusAut A c p ∈ M) {p : A[X]} (hp : p ∈ M) (d : ℕ) :
    homogComp d p ∈ M :=
  Submodule.span_le.2 (Set.range_subset_iff.2 fun c => hM c p hp)
    (homogComp_mem_span_torusAut k p d)

/-- A subalgebra of `A[T]` stable under the torus automorphisms is graded, if `k` is infinite. -/
theorem isGraded_of_torus [Infinite k] {B : Subalgebra k A[X]}
    (hB : ∀ (c : kˣ), ∀ p ∈ B, torusAut A c p ∈ B) : IsTGraded B :=
  fun _ hp d => homogComp_mem_of_torus (Subalgebra.toSubmodule B) hB hp d

end Torus

/-! ### Homogeneous integral equations -/

section IntegralEquation

variable {k A : Type*} [Field k] [CommRing A] [Algebra k A]

/-- **Homogeneous integral equations.** If `S ⊆ A[T]` is graded and `b` is homogeneous of degree
`d` and integral over `S`, then `b^n + ∑_{i < n} s_i b^i = 0` for some `n > 0` and
`s_i ∈ S_{(n-i)d}` (take the components of degree `nd` of any integral equation). -/
theorem exists_homog_integral_eq [Nontrivial A] {S : Subalgebra k A[X]} (hS : IsTGraded S)
    {b : A[X]} {d : ℕ} (hb : IsHomog d b) (hint : IsIntegral S b) :
    ∃ (n : ℕ) (s : ℕ → A[X]), 0 < n ∧ (∀ i, s i ∈ gradedPiece S ((n - i) * d)) ∧
      b ^ n + ∑ i ∈ Finset.range n, s i * b ^ i = 0 := by
  obtain ⟨f, hmon, hf⟩ := hint
  set n := f.natDegree
  have hn : 0 < n := by
    rcases Nat.eq_zero_or_pos n with h | h
    · rw [(Monic.natDegree_eq_zero hmon).1 h, eval₂_one] at hf
      exact absurd hf one_ne_zero
    · exact h
  refine ⟨n, fun i => homogComp ((n - i) * d) (f.coeff i : A[X]), hn,
    fun i => hS.homogComp_mem (f.coeff i).2 _, ?_⟩
  rw [hmon.as_sum, eval₂_add, eval₂_X_pow, eval₂_finsetSum] at hf
  simp only [eval₂_mul, eval₂_C, eval₂_X_pow] at hf
  have h := congrArg (homogComp (n * d)) hf
  rw [map_add, map_sum, (hb.pow n).homogComp_self, map_zero] at h
  rw [← h]
  congr 1
  refine Finset.sum_congr rfl fun i hi => ?_
  have hi : i < n := Finset.mem_range.1 hi
  have : n * d = (n - i) * d + i * d := by
    rw [← add_mul, Nat.sub_add_cancel hi.le]
  rw [this, homogComp_mul_of_isHomog (hb.pow i)]
  rfl

end IntegralEquation

/-! ### Monomials in homogeneous generators -/

section Monomials

variable {k A : Type*} [Field k] [CommRing A] [Algebra k A]
variable {ι : Type*} [Fintype ι]

theorem isHomog_prod_pow {b : ι → A[X]} {d : ι → ℕ} (hb : ∀ i, IsHomog (d i) (b i))
    (α : ι → ℕ) : IsHomog (∑ i, α i * d i) (∏ i, b i ^ α i) :=
  isHomog_prod _ _ _ fun i _ => (hb i).pow (α i)

theorem prod_pow_mem_adjoin (b : ι → A[X]) (α : ι → ℕ) :
    ∏ i, b i ^ α i ∈ Algebra.adjoin k (Set.range b) :=
  Subalgebra.prod_mem _ fun i _ =>
    Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_range_self i)) _

/-- If `B = k[b_i]` with `b_i` homogeneous of degree `d_i`, then `B_n` is spanned by the
monomials `∏ b_i^{α_i}` of degree `∑ α_i d_i = n`. -/
theorem gradedPiece_adjoin_le_span {b : ι → A[X]} {d : ι → ℕ} (hb : ∀ i, IsHomog (d i) (b i))
    (n : ℕ) :
    gradedPiece (Algebra.adjoin k (Set.range b)) n ≤
      Submodule.span k ((fun α : ι → ℕ => ∏ i, b i ^ α i) '' {α | ∑ i, α i * d i = n}) := by
  rintro p ⟨hp, hpn⟩
  rw [← hpn.homogComp_self]
  have hp' : p ∈ Submodule.span k (Submonoid.closure (Set.range b) : Set A[X]) := by
    rw [← Algebra.adjoin_eq_span]
    exact hp
  clear hp hpn
  induction hp' using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨α, rfl⟩ := Submonoid.mem_closure_range_iff.1 hx
    rw [Finsupp.prod_fintype _ _ (fun i => pow_zero _)]
    have hα := isHomog_prod_pow hb α
    by_cases h : ∑ i, α i * d i = n
    · rw [← h, hα.homogComp_self]
      exact Submodule.subset_span ⟨α, rfl, rfl⟩
    · rw [hα.homogComp_of_ne h]
      exact Submodule.zero_mem _
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | smul c x _ hx => rw [homogComp_smul]; exact Submodule.smul_mem _ c hx

/-- If `B = k[b_i]` with `b_i` homogeneous of positive degree, every `B_n` is finite
dimensional. -/
theorem finiteDimensional_gradedPiece_adjoin {b : ι → A[X]} {d : ι → ℕ}
    (hb : ∀ i, IsHomog (d i) (b i)) (hd : ∀ i, 0 < d i) (n : ℕ) :
    FiniteDimensional k (gradedPiece (Algebra.adjoin k (Set.range b)) n) := by
  have hfin : {α : ι → ℕ | ∑ i, α i * d i = n}.Finite := by
    refine (Set.Finite.pi (t := fun _ : ι => Set.Iic n) fun _ => Set.finite_Iic n).subset ?_
    intro α hα i _
    have h1 : α i * d i ≤ n := by
      rw [← (hα : ∑ i, α i * d i = n)]
      exact Finset.single_le_sum (f := fun j => α j * d j) (fun _ _ => Nat.zero_le _)
        (Finset.mem_univ i)
    exact Set.mem_Iic.2 (le_trans (Nat.le_mul_of_pos_right _ (hd i)) h1)
  have := FiniteDimensional.span_of_finite k (hfin.image fun α : ι → ℕ => ∏ i, b i ^ α i)
  exact Submodule.finiteDimensional_of_le (gradedPiece_adjoin_le_span hb n)

/-- A finitely generated graded subalgebra `B ⊆ A[T]` with `B_0 = k` is generated by finitely many
homogeneous elements of positive degree. -/
theorem exists_homog_generators {B : Subalgebra k A[X]} (hB : IsTGraded B) (hfg : B.FG)
    (h0 : ∀ a : A, C a ∈ B → ∃ c : k, algebraMap k A c = a) :
    ∃ (r : ℕ) (b : Fin r → A[X]) (d : Fin r → ℕ), (∀ i, 0 < d i) ∧ (∀ i, IsHomog (d i) (b i)) ∧
      Algebra.adjoin k (Set.range b) = B := by
  classical
  obtain ⟨t, ht⟩ := hfg
  set D := t.sup natDegree
  set P := t ×ˢ Finset.Icc 1 D
  let e := P.equivFin
  refine ⟨P.card, fun i => homogComp (e.symm i).1.2 (e.symm i).1.1, fun i => (e.symm i).1.2,
    fun i => (Finset.mem_Icc.1 (Finset.mem_product.1 (e.symm i).2).2).1,
    fun i => isHomog_homogComp _ _, le_antisymm ?_ ?_⟩
  · rw [Algebra.adjoin_le_iff]
    rintro _ ⟨i, rfl⟩
    exact hB _ (ht ▸ Algebra.subset_adjoin (Finset.mem_product.1 (e.symm i).2).1) _
  · rw [← ht, Algebra.adjoin_le_iff]
    intro p hp
    have hpB : p ∈ B := ht ▸ Algebra.subset_adjoin hp
    rw [← sum_homogComp p, Finset.sum_range_succ']
    refine Subalgebra.add_mem _ (Subalgebra.sum_mem _ fun j hj => ?_) ?_
    · have hj : j + 1 ∈ Finset.Icc 1 D := Finset.mem_Icc.2 ⟨by omega,
        le_trans (by have := Finset.mem_range.1 hj; omega) (Finset.le_sup (f := natDegree) hp)⟩
      have hmem : (p, j + 1) ∈ P := Finset.mem_product.2 ⟨hp, hj⟩
      refine Algebra.subset_adjoin ⟨e ⟨(p, j + 1), hmem⟩, ?_⟩
      simp only [Equiv.symm_apply_apply]
    · obtain ⟨c, hc⟩ := h0 (p.coeff 0) (by rw [← monomial_zero_left]; exact hB p hpB 0)
      rw [homogComp_apply, monomial_zero_left, ← hc, ← Polynomial.algebraMap_apply]
      exact Subalgebra.algebraMap_mem _ c

end Monomials

/-! ### Degree zero parts of homogeneous localizations -/

section HomLoc

variable {k A : Type*} [Field k] [CommRing A] [IsDomain A] [Algebra k A]

/-- The degree zero part `B_{(σ)}` of `B[σ⁻¹]` for `σ = s T^d ∈ B`, modelled inside `Frac A` as
the `k`-subalgebra of fractions `a / s^j` with `a T^{jd} ∈ B` (`conv:wu-graded`). For `A` a domain
and `s ≠ 0`, the degree zero element `b / σ^j` (`b = a T^{jd} ∈ B_{jd}`) of `B[σ⁻¹] ⊆ Frac A[T]`
corresponds to `a / s^j`, and this identification is injective. -/
def homLoc (B : Subalgebra k A[X]) (s : A) (d : ℕ) : Subalgebra k (FractionRing A) :=
  Algebra.adjoin k {x | ∃ (j : ℕ) (a : A), monomial (j * d) a ∈ B ∧
    x = algebraMap A (FractionRing A) a / algebraMap A (FractionRing A) s ^ j}

theorem div_mem_homLoc {B : Subalgebra k A[X]} {s : A} {d j : ℕ} {a : A}
    (h : monomial (j * d) a ∈ B) :
    algebraMap A (FractionRing A) a / algebraMap A (FractionRing A) s ^ j ∈ homLoc B s d :=
  Algebra.subset_adjoin ⟨j, a, h, rfl⟩

/-- Membership in `B_{(σ)}`, `σ = s T^d ∈ B`, `s ≠ 0`: the elements are exactly the `a / s^j` with
`a T^{jd} ∈ B`. -/
theorem mem_homLoc_iff {B : Subalgebra k A[X]} {s : A} {d : ℕ} (hs : s ≠ 0)
    (hσ : monomial d s ∈ B) {x : FractionRing A} :
    x ∈ homLoc B s d ↔ ∃ (j : ℕ) (a : A), monomial (j * d) a ∈ B ∧
      x = algebraMap A (FractionRing A) a / algebraMap A (FractionRing A) s ^ j := by
  refine ⟨fun hx => ?_, fun ⟨j, a, h, hx⟩ => hx ▸ div_mem_homLoc h⟩
  have hs' : algebraMap A (FractionRing A) s ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective A (FractionRing A))).2 hs
  -- `σ^j` lies in `B`
  have hσpow : ∀ j : ℕ, monomial (j * d) (s ^ j) ∈ B := fun j => by
    rw [mul_comm, ← monomial_pow]
    exact Subalgebra.pow_mem _ hσ j
  induction hx using Algebra.adjoin_induction with
  | mem x hx => exact hx
  | algebraMap c =>
    refine ⟨0, algebraMap k A c, ?_, ?_⟩
    · rw [zero_mul, monomial_zero_left, ← Polynomial.algebraMap_apply]
      exact Subalgebra.algebraMap_mem _ c
    · rw [pow_zero, div_one, ← IsScalarTower.algebraMap_apply]
  | add x y _ _ hx hy =>
    obtain ⟨i, a, ha, rfl⟩ := hx
    obtain ⟨j, b, hb, rfl⟩ := hy
    refine ⟨i + j, a * s ^ j + b * s ^ i, ?_, ?_⟩
    · have h1 : monomial ((i + j) * d) (a * s ^ j) =
          monomial (i * d) a * monomial (j * d) (s ^ j) := by
        rw [monomial_mul_monomial, add_mul]
      have h2 : monomial ((i + j) * d) (b * s ^ i) =
          monomial (j * d) b * monomial (i * d) (s ^ i) := by
        rw [monomial_mul_monomial, add_mul, add_comm (i * d)]
      rw [map_add, h1, h2]
      exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ ha (hσpow j))
        (Subalgebra.mul_mem _ hb (hσpow i))
    · rw [map_add, map_mul, map_mul, map_pow, map_pow]
      field_simp
      ring
  | mul x y _ _ hx hy =>
    obtain ⟨i, a, ha, rfl⟩ := hx
    obtain ⟨j, b, hb, rfl⟩ := hy
    refine ⟨i + j, a * b, ?_, ?_⟩
    · rw [add_mul, ← monomial_mul_monomial]
      exact Subalgebra.mul_mem _ ha hb
    · rw [map_mul, pow_add]
      field_simp

/-- If every `a ∈ A` has `a T^{jd} ∈ B` for some `j`, then `B_{(T^d)}` is all of `A ⊆ Frac A`. -/
theorem homLoc_one_eq_range {B : Subalgebra k A[X]} {d : ℕ}
    (h : ∀ a : A, ∃ j, monomial (j * d) a ∈ B) :
    homLoc B 1 d = (IsScalarTower.toAlgHom k A (FractionRing A)).range := by
  refine le_antisymm (Algebra.adjoin_le ?_) fun x hx => ?_
  · rintro _ ⟨j, a, -, rfl⟩
    exact ⟨a, by rw [map_one, one_pow, div_one]; rfl⟩
  · obtain ⟨a, rfl⟩ := hx
    obtain ⟨j, hj⟩ := h a
    have := div_mem_homLoc (s := (1 : A)) hj
    rw [map_one, one_pow, div_one] at this
    exact this

/-- If `B_{(T^d)}` is all of `A ⊆ Frac A`, the isomorphism `B_{(T^d)} ≃ A`,
`b T^{jd} / T^{jd} ↦ b`. -/
def homLocOneEquiv {B : Subalgebra k A[X]} {d : ℕ}
    (h : homLoc B 1 d = (IsScalarTower.toAlgHom k A (FractionRing A)).range) :
    homLoc B 1 d ≃ₐ[k] A :=
  (Subalgebra.equivOfEq _ _ h).trans
    (AlgEquiv.ofInjective (IsScalarTower.toAlgHom k A (FractionRing A))
      (IsFractionRing.injective A (FractionRing A))).symm

/-- `homLocOneEquiv` is inverse to the inclusion `A ⊆ Frac A`. -/
theorem algebraMap_homLocOneEquiv {B : Subalgebra k A[X]} {d : ℕ}
    (h : homLoc B 1 d = (IsScalarTower.toAlgHom k A (FractionRing A)).range)
    (x : homLoc B 1 d) : algebraMap A (FractionRing A) (homLocOneEquiv h x) = x :=
  congrArg Subtype.val ((AlgEquiv.ofInjective (IsScalarTower.toAlgHom k A (FractionRing A))
    (IsFractionRing.injective A (FractionRing A))).apply_symm_apply (Subalgebra.equivOfEq _ _ h x))

/-- `homLocOneEquiv` maps `b T^{jd} / T^{jd}` to `b`. -/
theorem homLocOneEquiv_div {B : Subalgebra k A[X]} {d : ℕ}
    (h : homLoc B 1 d = (IsScalarTower.toAlgHom k A (FractionRing A)).range) {j : ℕ} {b : A}
    (hb : monomial (j * d) b ∈ B) :
    homLocOneEquiv h ⟨_, div_mem_homLoc (s := (1 : A)) hb⟩ = b := by
  apply IsFractionRing.injective A (FractionRing A)
  rw [algebraMap_homLocOneEquiv]
  change _ / _ = _
  rw [map_one, one_pow, div_one]

end HomLoc

end EnvelopeProperty
