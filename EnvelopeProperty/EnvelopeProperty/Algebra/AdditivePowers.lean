import EnvelopeProperty.Algebra.AdditivePowersBasic
import EnvelopeProperty.Algebra.SubintegralTower

/-!
# Additive powers along subintegral towers (FHX Lemma 8.2, first assertion)

This file states the additive-powers theorem (blueprint `thm:gl-additive-powers`; Fang–Han–Xia,
*The envelope property for unibranch projective varieties*, Lemma 8.2
`lem:normalization-local-sandwich`, first assertion; Roberts–Singh, Compositio Math. 85 (1993),
Theorem (4.17) (ii)⇒(i)) for the tower predicates of `EnvelopeProperty.Algebra.SubintegralTower`
(decision D-H3′): if `A → B` is a subintegral tower of `ℚ`-algebras
(`EnvelopeProperty.Algebra.IsSubintegralTower A B`, Stacks 0CND (2)) and `b ∈ B`, there are
`N ≥ d ≥ 0` and `c₁, …, c_d ∈ B` with `bᵐ + ∑_{i=1}^d binom(m, i) cᵢ b^{m-i} ∈ A` for all `m ≥ N`.

"`∈ A`" means "in the image of `algebraMap A B`"; as a `ℚ`-subalgebra of `B` this image is
`(⊥ : Subalgebra A B).restrictScalars ℚ`. The `ℚ`-algebra structures on `A` and `B` are only used
to make sense of the rational coefficients in the proof; `IsScalarTower ℚ A B` is automatic
(`IsScalarTower.rat`).

## Main results

* `EnvelopeProperty.IsSubintegralChain.isAddPowSubintegral`: every element of `A[b₁, …, bₙ]` for a
  subintegral chain `[b₁, …, bₙ]` is additively power subintegral over `A`.
* `EnvelopeProperty.Algebra.IsSubintegralTower.isAddPowSubintegral`: the same for every element of
  a subintegral tower `A → B`.
* `EnvelopeProperty.Algebra.IsSubintegralTower.exists_addPow_mem_range` (**FHX Lemma 8.2, first
  assertion**, with `N ≥ d`).

The proofs only use that the additively power subintegral elements form a `ℚ`-subalgebra closed
under `b², b³ ↦ b` (`EnvelopeProperty.addPowSubintegralClosure`,
`EnvelopeProperty.IsAddPowSubintegral.of_sq_of_cube`).
-/

noncomputable section

namespace EnvelopeProperty

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] [Algebra ℚ A] [Algebra ℚ B]

/-- An `A`-subalgebra generated by additively power subintegral elements consists of additively
power subintegral elements (over the image of `A`). -/
theorem adjoin_subset_addPowSubintegralClosure {s : Set B}
    (hs : s ⊆ addPowSubintegralClosure ((⊥ : Subalgebra A B).restrictScalars ℚ)) :
    (Algebra.adjoin A s : Set B) ⊆
      addPowSubintegralClosure ((⊥ : Subalgebra A B).restrictScalars ℚ) := by
  intro x hx
  induction hx using Algebra.adjoin_induction with
  | mem x hx => exact hs hx
  | algebraMap a =>
    exact le_addPowSubintegralClosure _
      ((Subalgebra.mem_restrictScalars ℚ).2 (Subalgebra.algebraMap_mem _ a))
  | add x y _ _ hx hy => exact Subalgebra.add_mem _ hx hy
  | mul x y _ _ hx hy => exact Subalgebra.mul_mem _ hx hy

/-- **Additive powers along a subintegral chain** (`thm:gl-additive-powers`, Roberts–Singh (4.17)
(ii)⇒(i)): if `[b₁, …, bₙ]` is a subintegral chain over `A` (`bᵢ², bᵢ³ ∈ A[b₁, …, b_{i-1}]`),
every element of `A[b₁, …, bₙ]` is additively power subintegral over (the image of) `A`. -/
theorem IsSubintegralChain.isAddPowSubintegral {l : List B} (hl : IsSubintegralChain A l) :
    ∀ b ∈ Algebra.adjoin A {x | x ∈ l},
      IsAddPowSubintegral ((⊥ : Subalgebra A B).restrictScalars ℚ) b := by
  induction hl with
  | nil =>
    intro b hb
    exact adjoin_subset_addPowSubintegralClosure (fun x hx => absurd hx List.not_mem_nil) hb
  | @concat l e _ he2 he3 ih =>
    intro b hb
    refine adjoin_subset_addPowSubintegralClosure (fun x hx => ?_) hb
    rcases List.mem_append.1 hx with hx | hx
    · exact ih x (Algebra.subset_adjoin hx)
    · rw [List.mem_singleton.1 hx]
      exact IsAddPowSubintegral.of_sq_of_cube (ih _ he2) (ih _ he3)

/-- **Additive powers for subintegral towers** (`thm:gl-additive-powers`): if `A → B` is a
subintegral tower (Stacks 0CND (2)), every `b ∈ B` is additively power subintegral over the image
of `A`. -/
theorem Algebra.IsSubintegralTower.isAddPowSubintegral (h : Algebra.IsSubintegralTower A B)
    (b : B) : IsAddPowSubintegral ((⊥ : Subalgebra A B).restrictScalars ℚ) b := by
  obtain ⟨l, hl, hb⟩ := Algebra.isSubintegralTower_iff_forall_mem.1 h b
  exact hl.isAddPowSubintegral b hb

/-- **FHX Lemma 8.2, first assertion** (`lem:normalization-local-sandwich`,
`thm:gl-additive-powers`): for a subintegral tower `A → B` of `ℚ`-algebras and `b ∈ B` there are
integers `N ≥ d ≥ 0` and `c₁, …, c_d ∈ B` (here `c i = c_{i+1}`) such that
`aₘ = bᵐ + ∑_{i=1}^d binom(m, i) cᵢ b^{m-i}` lies in the image of `A` for every `m ≥ N`. -/
theorem Algebra.IsSubintegralTower.exists_addPow_mem_range (h : Algebra.IsSubintegralTower A B)
    (b : B) : ∃ (N d : ℕ) (c : Fin d → B), d ≤ N ∧ ∀ m, N ≤ m →
      b ^ m + ∑ i : Fin d, (m.choose (i + 1) : B) * c i * b ^ (m - (i + 1)) ∈
        Set.range (algebraMap A B) := by
  obtain ⟨N, d, c, hdN, hc⟩ := (h.isAddPowSubintegral b).exists_le
  exact ⟨N, d, c, hdN, fun m hm => Algebra.mem_bot.1 ((Subalgebra.mem_restrictScalars ℚ).1
    (hc m hm))⟩

end EnvelopeProperty
