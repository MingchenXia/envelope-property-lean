import EnvelopeProperty.Char0.EtaleDerivationJacobian
import TranscendentalNakamaye.Pending.HolomorphicGermCoordinateDerivation

/-!
# Actual analytic Jacobians and the whole original algebraic Jacobian ideal

The restricted derivatives are manufactured from the actual holomorphic germ
map. Existing etale differential expansion gives whole derivative-germ,
determinant and ideal equalities; normalized coordinates internally remove the
unit factor. No derivative or Jacobian comparison certificate is assumed.
-/

set_option autoImplicit false

noncomputable section

namespace EnvelopeProperty.Char0.AnalyticEtaleJacobian

open Filter Module Ideal
open TranscendentalNakamaye.FirstPass TranscendentalNakamaye.Pending
open HolomorphicGermCoordinateDerivation HironakaHolomorphicJetMonomialSpan
open scoped Topology

variable {A : Type*} [CommRing A] [Algebra ℂ A] {n : ℕ}

/-- Every original algebra element has its actual entire analytic etale derivative expansion. -/
theorem partial_apply_eq_sum_etale (φ : A →ₐ[ℂ] HolGerm (ComplexModel n))
    (v : Fin n → A) (hv : (MvPolynomial.aeval (R := ℂ) v).toRingHom.Etale)
    (j : Fin n) (a : A) :
    coordinatePartial j (φ a) = ∑ l, φ (etalePartialDeriv v hv l a) *
      coordinatePartial j (φ (v l)) := by
  let := φ.toAlgebra
  let : IsScalarTower ℂ A (HolGerm (ComplexModel n)) :=
    IsScalarTower.of_algebraMap_eq fun c => (φ.commutes c).symm
  exact derivation_apply_eq_sum_etale v hv (along φ j) a

/-- Normalized original coordinates give exact partial comparison on EVERY original function. -/
theorem partial_apply_normalized (φ : A →ₐ[ℂ] HolGerm (ComplexModel n))
    (u : Fin n → A) (hu : (MvPolynomial.aeval (R := ℂ) u).toRingHom.Etale)
    (c : Fin n → ℂ) (hφ : ∀ i, φ (u i) = coordinateGerm i + HolGerm.constHom (c i))
    (j : Fin n) (a : A) :
    coordinatePartial j (φ a) = φ (etalePartialDeriv u hu j a) := by
  rw [partial_apply_eq_sum_etale φ u hu]
  have hD (i : Fin n) : coordinatePartial j (φ (u i)) =
      if i = j then 1 else 0 := along_coordinate φ u c hφ i j
  simp only [hD, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true]

variable {R : Type*} [CommRing R] [Algebra R A]

/-- The actual analytic determinant of an original source-function tuple. -/
def analyticSourceJacobian (φ : A →ₐ[ℂ] HolGerm (ComplexModel n)) (w : Fin n → R) :
    HolGerm (ComplexModel n) :=
  (Matrix.of fun i j => coordinatePartial j (φ (algebraMap R A (w i)))).det

/-- The ENTIRE determinant germ is the actual derivative determinant of any original representatives. -/
theorem analyticSourceJacobian_representative
    (φ : A →ₐ[ℂ] HolGerm (ComplexModel n)) (w : Fin n → R)
    (F : Fin n → ComplexModel n → ℂ)
    (hF : ∀ i, ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ (F i) z)
    (hφ : ∀ i, φ (algebraMap R A (w i)) = HolGerm.mk (F i) (hF i)) :
    ((analyticSourceJacobian φ w : HolGerm (ComplexModel n)) :
      Germ (𝓝 (0 : ComplexModel n)) ℂ) =
        (fun z : ComplexModel n =>
          (Matrix.of fun i j => fderiv ℂ (F i) z (EuclideanSpace.single j 1)).det) := by
  let M : Matrix (Fin n) (Fin n) (ComplexModel n → ℂ) :=
    fun i j z => fderiv ℂ (F i) z (EuclideanSpace.single j 1)
  have hm : M.det = fun z =>
      (Matrix.of fun i j => fderiv ℂ (F i) z (EuclideanSpace.single j 1)).det := by
    funext z
    exact (Pi.evalRingHom (fun _ : ComplexModel n => ℂ) z).map_det M
  change (holGermSubring (ComplexModel n)).subtype
    (Matrix.of fun i j => coordinatePartial j (φ (algebraMap R A (w i)))).det =
      (Germ.coeRingHom (𝓝 (0 : ComplexModel n))) _
  rw [(holGermSubring (ComplexModel n)).subtype.map_det, ← hm,
    (Germ.coeRingHom (𝓝 (0 : ComplexModel n))).map_det M]
  congr 1
  funext i j
  change ((coordinatePartial j (φ (algebraMap R A (w i))) : HolGerm (ComplexModel n)) :
    Germ (𝓝 (0 : ComplexModel n)) ℂ) = _
  rw [hφ i, coordinatePartial_mk]
  rfl

/-- The whole actual analytic Jacobian ideal, generated by ALL original source tuples. -/
def analyticSourceJacobianIdeal (φ : A →ₐ[ℂ] HolGerm (ComplexModel n)) :
    Ideal (HolGerm (ComplexModel n)) :=
  Ideal.span (Set.range (analyticSourceJacobian (R := R) φ))

/-- Whole actual derivative determinants factor through the actual original etale basis. -/
theorem analyticSourceJacobian_factor (φ : A →ₐ[ℂ] HolGerm (ComplexModel n))
    (v : Fin n → A) (hv : (MvPolynomial.aeval (R := ℂ) v).toRingHom.Etale)
    (w : Fin n → R) :
    analyticSourceJacobian φ w =
      (Matrix.of fun i j => coordinatePartial j (φ (v i))).det *
        φ (sourceFunctionDifferentialMatrix (R := R) (etaleDifferentialBasis v hv) w).det := by
  let := φ.toAlgebra
  let : IsScalarTower ℂ A (HolGerm (ComplexModel n)) :=
    IsScalarTower.of_algebraMap_eq fun c => (φ.commutes c).symm
  exact derivation_source_det_comp v hv (fun j => along φ j) w

/-- Equality of the WHOLE actual analytic ideal and the mapped original ideal with its coordinate factor. -/
theorem analyticSourceJacobianIdeal_factor (φ : A →ₐ[ℂ] HolGerm (ComplexModel n))
    (v : Fin n → A) (hv : (MvPolynomial.aeval (R := ℂ) v).toRingHom.Etale) :
    analyticSourceJacobianIdeal (R := R) φ =
      Ideal.span {(Matrix.of fun i j => coordinatePartial j (φ (v i))).det} *
        (affineRelativeJacobianIdeal (R := R) (etaleDifferentialBasis v hv)).map φ.toRingHom := by
  let := φ.toAlgebra
  let : IsScalarTower ℂ A (HolGerm (ComplexModel n)) :=
    IsScalarTower.of_algebraMap_eq fun c => (φ.commutes c).symm
  exact derivationSourceJacobianIdeal_eq v hv (fun j => along φ j)

/-- Normalized coordinates identify the entire actual analytic determinant with the original one. -/
theorem analyticSourceJacobian_normalized (φ : A →ₐ[ℂ] HolGerm (ComplexModel n))
    (u : Fin n → A) (hu : (MvPolynomial.aeval (R := ℂ) u).toRingHom.Etale)
    (c : Fin n → ℂ) (hφ : ∀ i, φ (u i) = coordinateGerm i + HolGerm.constHom (c i))
    (w : Fin n → R) :
    analyticSourceJacobian φ w =
      φ (etaleJacobian u hu (fun i => algebraMap R A (w i))) := by
  unfold analyticSourceJacobian
  rw [etaleJacobian, φ.map_det]
  congr 1
  funext i j
  exact partial_apply_normalized φ u hu c hφ j _

omit [Algebra R A] in
/-- Two genuine algebraic etale coordinate systems give an internally proved analytic unit factor. -/
theorem coordinateJacobian_isUnit (φ : A →ₐ[ℂ] HolGerm (ComplexModel n))
    (u : Fin n → A) (hu : (MvPolynomial.aeval (R := ℂ) u).toRingHom.Etale)
    (c : Fin n → ℂ) (hφ : ∀ i, φ (u i) = coordinateGerm i + HolGerm.constHom (c i))
    (v : Fin n → A) (hv : (MvPolynomial.aeval (R := ℂ) v).toRingHom.Etale) :
    IsUnit (Matrix.of fun i j => coordinatePartial j (φ (v i))).det := by
  have he : (Matrix.of fun i j => coordinatePartial j (φ (v i))).det =
      φ (etaleJacobian u hu v) := by
    rw [etaleJacobian, φ.map_det]
    congr 1
    funext i j
    exact partial_apply_normalized φ u hu c hφ j _
  rw [he]
  exact (isUnit_etaleJacobian u hu v hv).map φ.toRingHom

/-- The WHOLE actual analytic Jacobian ideal is exactly the extended original algebraic ideal. -/
theorem analyticSourceJacobianIdeal_eq_map (φ : A →ₐ[ℂ] HolGerm (ComplexModel n))
    (u : Fin n → A) (hu : (MvPolynomial.aeval (R := ℂ) u).toRingHom.Etale)
    (c : Fin n → ℂ) (hφ : ∀ i, φ (u i) = coordinateGerm i + HolGerm.constHom (c i))
    (v : Fin n → A) (hv : (MvPolynomial.aeval (R := ℂ) v).toRingHom.Etale) :
    analyticSourceJacobianIdeal (R := R) φ =
      (affineRelativeJacobianIdeal (R := R) (etaleDifferentialBasis v hv)).map φ.toRingHom := by
  rw [analyticSourceJacobianIdeal_factor φ v hv,
    Ideal.span_singleton_eq_top.mpr (coordinateJacobian_isUnit φ u hu c hφ v hv), top_mul]

end EnvelopeProperty.Char0.AnalyticEtaleJacobian
