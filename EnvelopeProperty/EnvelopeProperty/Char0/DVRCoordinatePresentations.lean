import EnvelopeProperty.Char0.DVRSourceCoordinateInvariant
import EnvelopeProperty.Char0.DivisorialFamilyCoordinates

/-!
# Independence of every finite divisorial coordinate presentation

Both the enumeration and finite dimension are removed from the genuine
original-source Jacobian ideal, using actual fraction-field differential bases.
-/

noncomputable section

namespace EnvelopeProperty.Char0

open AlgebraicGeometry IsDiscreteValuationRing IsLocalRing Module Ideal
open scoped Classical

universe u

variable {k K : Type u} [Field k] [Field K] [Algebra k K] [CharZero k]
  (C V : Subalgebra k K) [IsDiscreteValuationRing V] [IsFractionRing V K]
  [Algebra.EssFiniteType k V] (hCV : C ≤ V) {ι : Type u} [Fintype ι]
  {π : V} {u : ι → V} {n : ℕ}

/-- The genuine ideal generated by every original-source tuple is independent of
its finite enumeration, with no chosen tuple or subfamily discarded. -/
theorem dvrOriginalSourceJacobianIdeal_reindex (hπ : Irreducible π)
    (hu : IsTranscendenceBasis k (residue V ∘ u)) (e e' : Fin n ≃ Option ι) :
    dvrOriginalSourceJacobianIdeal C V hCV hπ hu e =
      dvrOriginalSourceJacobianIdeal C V hCV hπ hu e' := by
  have hle (e e' : Fin n ≃ Option ι) :
      dvrOriginalSourceJacobianIdeal C V hCV hπ hu e ≤
        dvrOriginalSourceJacobianIdeal C V hCV hπ hu e' := by
    let _ : Algebra C V := (Subalgebra.inclusion hCV).toAlgebra
    have : IsScalarTower k C V := IsScalarTower.of_algebraMap_eq fun _ => rfl
    unfold dvrOriginalSourceJacobianIdeal derivationSourceJacobianIdeal
    apply Ideal.span_le.mpr
    rintro _ ⟨w, rfl⟩
    let w' : Fin n → C := fun i => w (e.symm (e' i))
    have hdet :
        (Matrix.of fun i j => dvrLeafPartials C V hCV hπ hu e j (w i)).det =
          (Matrix.of fun i j => dvrLeafPartials C V hCV hπ hu e' j (w' i)).det := by
      apply Subtype.ext
      rw [coe_original_source_dvr_tuple_det C V hCV hπ hu e w,
        coe_original_source_dvr_tuple_det C V hCV hπ hu e' w']
      congr 1
      funext i
      simp only [w', Equiv.apply_symm_apply]
    simpa only [Algebra.algebraMap_self, RingHom.id_apply, hdet] using
      (Ideal.subset_span (Set.mem_range_self w') :
        (Matrix.of fun i j => dvrLeafPartials C V hCV hπ hu e' j (w' i)).det ∈
          span (Set.range fun w : Fin n → C =>
            (Matrix.of fun i j => dvrLeafPartials C V hCV hπ hu e' j (w i)).det))
  exact le_antisymm (hle e e') (hle e' e)

/-- The genuine original-source ideal is independent of all finite coordinate
presentations, including the number and enumeration of residue coordinates. -/
theorem dvrOriginalSourceJacobianIdeal_presentation_independent
    {m m' n' : ℕ} {π' : V}
    {v : ULift.{u} (Fin m) → V} {v' : ULift.{u} (Fin m') → V}
    (hπ : Irreducible π) (hv : IsTranscendenceBasis k (residue V ∘ v))
    (hπ' : Irreducible π') (hv' : IsTranscendenceBasis k (residue V ∘ v'))
    (e : Fin n ≃ Option (ULift.{u} (Fin m)))
    (e' : Fin n' ≃ Option (ULift.{u} (Fin m'))) :
    dvrOriginalSourceJacobianIdeal C V hCV hπ hv e =
      dvrOriginalSourceJacobianIdeal C V hCV hπ' hv' e' := by
  have hn : n = n' := by
    have h := (Module.finrank_eq_card_basis (dvrFieldDifferentialBasis V hπ hv e)).symm.trans
      (Module.finrank_eq_card_basis (dvrFieldDifferentialBasis V hπ' hv' e'))
    simpa only [Fintype.card_fin] using h
  subst n'
  have hm : m = m' := by
    have h := (Fintype.card_congr e).symm.trans (Fintype.card_congr e')
    simp only [Fintype.card_option, Fintype.card_ulift, Fintype.card_fin] at h
    omega
  subst m'
  exact (dvrOriginalSourceJacobianIdeal_coordinate_independent C V hCV hπ hv hπ' hv' e).trans
    (dvrOriginalSourceJacobianIdeal_reindex C V hCV hπ' hv' e e')

end EnvelopeProperty.Char0
