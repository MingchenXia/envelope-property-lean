import EnvelopeProperty.Char0.RelativeDifferentialJacobian
import EnvelopeProperty.Char0.SNCMonomials

/-!
# The actual affine Jacobian image ideal

The ideal generated by Jacobians of all pulled-back source function families is
principal in actual étale source coordinates. The generator is the determinant
of the genuine relative differential map, rather than an assumed image ideal.
-/

noncomputable section

namespace EnvelopeProperty.Char0

open Module
open scoped Classical

variable {k R A : Type*} [CommRing k] [CommRing R] [CommRing A]
  [Algebra k R] [Algebra k A] [Algebra R A] [IsScalarTower k R A] {n : ℕ}

/-- The genuine source-function differential matrix in an actual target basis. -/
def sourceFunctionDifferentialMatrix (bA : Basis (Fin n) A (KaehlerDifferential k A))
    (w : Fin n → R) : Matrix (Fin n) (Fin n) A :=
  fun i j => bA.coord i (KaehlerDifferential.D k A (algebraMap R A (w j)))

/-- The genuine affine image ideal generated by all source-function Jacobians. -/
def affineRelativeJacobianIdeal (bA : Basis (Fin n) A (KaehlerDifferential k A)) : Ideal A :=
  Ideal.span (Set.range fun w : Fin n → R => (sourceFunctionDifferentialMatrix bA w).det)

/-- The actual differential matrix factors by expanding the actual source differentials. -/
theorem sourceFunctionDifferentialMatrix_factor
    (bR : Basis (Fin n) R (KaehlerDifferential k R))
    (bA : Basis (Fin n) A (KaehlerDifferential k A)) (w : Fin n → R) :
    sourceFunctionDifferentialMatrix bA w = relativeDifferentialMatrix bR bA *
      (algebraMap R A).mapMatrix (bR.toMatrix (fun j => KaehlerDifferential.D k R (w j))) := by
  ext i j
  change bA.coord i (KaehlerDifferential.D k A (algebraMap R A (w j))) =
    ∑ l, bA.coord i (KaehlerDifferential.map k k R A (bR l)) *
      algebraMap R A (bR.repr (KaehlerDifferential.D k R (w j)) l)
  rw [← KaehlerDifferential.map_D k k R A]
  conv_lhs => rw [← bR.sum_repr (KaehlerDifferential.D k R (w j))]
  simp only [map_sum, map_smul]
  apply Finset.sum_congr rfl
  intro l _
  rw [← IsScalarTower.algebraMap_smul A]
  rw [map_smul, smul_eq_mul, mul_comm]

/-- Taking determinants gives genuine source-function Jacobian factorization. -/
theorem sourceFunctionDifferentialMatrix_det_factor
    (bR : Basis (Fin n) R (KaehlerDifferential k R))
    (bA : Basis (Fin n) A (KaehlerDifferential k A)) (w : Fin n → R) :
    (sourceFunctionDifferentialMatrix bA w).det = relativeDifferentialDet bR bA *
      algebraMap R A (bR.toMatrix (fun j => KaehlerDifferential.D k R (w j))).det := by
  rw [sourceFunctionDifferentialMatrix_factor bR, Matrix.det_mul, ← (algebraMap R A).map_det]
  rfl

/-- Every source-function Jacobian belongs to the principal ideal of the actual determinant. -/
theorem affineRelativeJacobianIdeal_le_span
    (bR : Basis (Fin n) R (KaehlerDifferential k R))
    (bA : Basis (Fin n) A (KaehlerDifferential k A)) :
    affineRelativeJacobianIdeal (R := R) bA ≤ Ideal.span {relativeDifferentialDet bR bA} := by
  apply Ideal.span_le.mpr
  rintro _ ⟨w, rfl⟩
  change (sourceFunctionDifferentialMatrix bA w).det ∈ _
  rw [sourceFunctionDifferentialMatrix_det_factor bR bA w]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_singleton _))

/-- In genuine source étale coordinates the all-functions Jacobian ideal is exactly the
principal ideal of the actual relative differential determinant. -/
theorem affineRelativeJacobianIdeal_eq_span (z : Fin n → R)
    (hz : (MvPolynomial.aeval (R := k) z).toRingHom.Etale)
    (bA : Basis (Fin n) A (KaehlerDifferential k A)) :
    affineRelativeJacobianIdeal (R := R) bA =
      Ideal.span {relativeDifferentialDet (etaleDifferentialBasis z hz) bA} := by
  apply le_antisymm (affineRelativeJacobianIdeal_le_span _ _)
  apply Ideal.span_le.mpr
  rintro _ (rfl : _ = _)
  have hzM : sourceFunctionDifferentialMatrix bA z =
      relativeDifferentialMatrix (etaleDifferentialBasis z hz) bA := by
    ext i j
    simp only [sourceFunctionDifferentialMatrix, relativeDifferentialMatrix,
      etaleDifferentialBasis_apply, KaehlerDifferential.map_D]
  change (relativeDifferentialMatrix (etaleDifferentialBasis z hz) bA).det ∈ _
  rw [← hzM]
  exact Ideal.subset_span ⟨z, rfl⟩

/-- The actual affine Jacobian image ideal is the unit ideal for an actual formally étale map. -/
theorem affineRelativeJacobianIdeal_eq_top [Algebra.FormallyEtale R A] (z : Fin n → R)
    (hz : (MvPolynomial.aeval (R := k) z).toRingHom.Etale)
    (bA : Basis (Fin n) A (KaehlerDifferential k A)) :
    affineRelativeJacobianIdeal (R := R) bA = ⊤ := by
  rw [affineRelativeJacobianIdeal_eq_span z hz, Ideal.span_singleton_eq_top]
  exact isUnit_relativeDifferentialDet _ _

/-- An actual common fraction field makes the genuine all-functions image ideal nonzero. -/
theorem affineRelativeJacobianIdeal_ne_bot_of_common_fractionField (L : Type*) [Field L]
    [Algebra k L] [Algebra R L] [Algebra A L]
    [IsScalarTower k R L] [IsScalarTower k A L] [IsScalarTower R A L]
    [IsFractionRing R L] [IsFractionRing A L] (z : Fin n → R)
    (hz : (MvPolynomial.aeval (R := k) z).toRingHom.Etale)
    (bA : Basis (Fin n) A (KaehlerDifferential k A)) :
    affineRelativeJacobianIdeal (R := R) bA ≠ ⊥ := by
  rw [affineRelativeJacobianIdeal_eq_span z hz]
  intro hzero
  apply relativeDifferentialDet_ne_zero_of_common_fractionField L (etaleDifferentialBasis z hz) bA
  have hmem : relativeDifferentialDet (etaleDifferentialBasis z hz) bA ∈
      Ideal.span ({relativeDifferentialDet (etaleDifferentialBasis z hz) bA} : Set A) :=
    Ideal.subset_span (Set.mem_singleton _)
  rw [hzero] at hmem
  exact Ideal.mem_bot.mp hmem

section Localization

variable (S : Type*) [CommRing S] [Algebra k S] [Algebra R S] [Algebra A S]
  [IsScalarTower k R S] [IsScalarTower k A S] [IsScalarTower R A S]

/-- Actual étaleness after localization makes the actual determinant a unit there. -/
theorem isUnit_localized_relativeDifferentialDet (q : A) [IsLocalization.Away q S]
    [Algebra.FormallyEtale R S] (bR : Basis (Fin n) R (KaehlerDifferential k R))
    (bA : Basis (Fin n) A (KaehlerDifferential k A)) :
    IsUnit (algebraMap A S (relativeDifferentialDet bR bA)) := by
  have : Algebra.FormallyEtale A S := Algebra.FormallyEtale.of_isLocalization (Submonoid.powers q)
  rw [relativeDifferentialDet_baseChange]
  exact isUnit_relativeDifferentialDet _ _

/-- The genuine image ideal localizes to the unit ideal on an actual étale localization. -/
theorem map_affineRelativeJacobianIdeal_eq_top (q : A) [IsLocalization.Away q S]
    [Algebra.FormallyEtale R S] (z : Fin n → R)
    (hz : (MvPolynomial.aeval (R := k) z).toRingHom.Etale)
    (bA : Basis (Fin n) A (KaehlerDifferential k A)) :
    (affineRelativeJacobianIdeal (R := R) bA).map (algebraMap A S) = ⊤ := by
  rw [affineRelativeJacobianIdeal_eq_span z hz, Ideal.map_span, Set.image_singleton,
    Ideal.span_singleton_eq_top]
  exact isUnit_localized_relativeDifferentialDet S q _ _

/-- The genuine image ideal is a boundary monomial once the actual map is étale off a prime
boundary; the determinant's unit-localization hypothesis is produced internally. -/
theorem exists_monomial_affineRelativeJacobianIdeal [IsDomain A]
    {ι : Type*} [Fintype ι] [DecidableEq ι] (p : ι → A) (hp : ∀ i, Prime (p i))
    [IsLocalization.Away (∏ i, p i) S] [Algebra.FormallyEtale R S]
    (z : Fin n → R) (hz : (MvPolynomial.aeval (R := k) z).toRingHom.Etale)
    (bA : Basis (Fin n) A (KaehlerDifferential k A)) :
    ∃ a : ι → ℕ, affineRelativeJacobianIdeal (R := R) bA = Ideal.span {∏ i, p i ^ a i} := by
  have hunit := isUnit_localized_relativeDifferentialDet S (∏ i, p i)
    (etaleDifferentialBasis z hz) bA
  obtain ⟨u, a, ha⟩ := exists_unit_mul_monomial_of_isUnit_away_product p hp S hunit
  refine ⟨a, ?_⟩
  rw [affineRelativeJacobianIdeal_eq_span z hz, ha,
    Ideal.span_singleton_mul_left_unit u.isUnit]

end Localization

end EnvelopeProperty.Char0
