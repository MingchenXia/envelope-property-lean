import EnvelopeProperty.Berkovich.Finite
import EnvelopeProperty.Berkovich.Localization

/-!
# Affine charts of a blowup and their analytifications

Let `A` be a domain, `K = Frac A`, `Y = Spec A` and `s ⊆ A` a finite set containing a nonzero
element. The blowup `μ : Y' → Y` of `Y` along the ideal generated by `s` is covered by the affine
charts `Spec A[s/g]`, `g ∈ s`, `g ≠ 0`, where `A[s/g] = A[h/g : h ∈ s] ⊆ K`. Since every proper
birational morphism to an affine variety is dominated by a blowup (Chow's lemma and Hartshorne
II.7.17), these charts are the witnesses used for weakly psh functions (Fang–Han–Xia,
Definition 5.6, `def:weakly-psh`; see `EnvelopeProperty.Local.WeaklyPSH`).

This file proves the two properties of `μ^an` used there: it is surjective, and it is proper,
in the following chart-wise form.

* **Surjectivity** (`exists_comap_chartMap_eq_of_le_one`): every `x ∈ Y^an` is the image of a
  point `y` of some chart `Spec A[s/g]^an` with `|h/g|_y ≤ 1` for all `h ∈ s`, i.e. of a point of
  the closed subchart `{|h/g| ≤ 1 : h ∈ s}`; these closed subcharts cover `Y'^an`.
  First, some chart contains a point over `x` (`exists_comap_chartMap_eq`): if `p = supp x`,
  choose a valuation ring `V ⊆ K` dominating `A_p` and `g ∈ s \ {0}` dividing every `h ∈ s` in
  `V`; then `A[s/g] ⊆ V` and `𝔪_V ∩ A[s/g]` lies over `p`, so the fibre algebra
  `H(x) ⊗_A A[s/g]` is nonzero (`Berk.nontrivial_fibre_of_comap_eq`), and a maximal ideal of it
  gives a point over `x` (`Berk.exists_comap_eq_of_nontrivial_fibre`: by Zariski's lemma its
  residue field is finite over the complete field `H(x)`, whose norm extends). Then a point `y`
  of a chart is moved to the chart of `g'` maximizing `|g'/g|_y`, through the localization
  `A[s/g][g/g'] ⊇ A[s/g']` (`exists_comap_chartMap_eq_of_le_one`).
* **Properness** (`isCompact_closedChart`): for compact `K ⊆ Y^an`, the part of the closed
  subchart lying over `K` is compact, since it lies in a closed polydisc for the generators of
  `A[s/g]` given by generators of `A` and the `h/g`.

## Main definitions

* `EnvelopeProperty.blowupChart s g`: the `A`-subalgebra `A[s/g]` of `Frac A`; it is a domain
  of finite type over `k` when `A` is.
* `EnvelopeProperty.chartMap s g : A →ₐ[k] A[s/g]` (injective) and the element
  `EnvelopeProperty.chartFrac s g hh = h/g` of `A[s/g]` for `h ∈ s`.
-/

open scoped NNReal ENNReal Topology TensorProduct

open Topology

noncomputable section

namespace EnvelopeProperty

/-! ### Points over `x` for morphisms of finite type -/

namespace Berk

section fibre

open TensorProduct

variable {k : Type*} [Field k] {B : Type*} [CommRing B] [Algebra k B]
  {A : Type*} [CommRing A] [Algebra k A] [Algebra B A] [IsScalarTower k B A]

omit [Algebra k A] [IsScalarTower k B A] in
/-- If some prime `Q` of `A` lies over the support of `x`, the fibre algebra `H(x) ⊗_B A` is
nonzero. -/
theorem nontrivial_fibre_of_comap_eq (x : Berk k B) (Q : Ideal A) [Q.IsPrime]
    (hQ : Q.comap (algebraMap B A) = x.val.supp) : Nontrivial (H x ⊗[B] A) := by
  have : Nontrivial (x.ResidueField ⊗[B] A) :=
    (PrimeSpectrum.nontrivial_iff_mem_rangeComap ⟨x.val.supp, inferInstance⟩).2
      ⟨⟨Q, inferInstance⟩, PrimeSpectrum.ext hQ⟩
  have : Nontrivial (H x ⊗[x.ResidueField] (x.ResidueField ⊗[B] A)) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_flat_left (R := x.ResidueField)
      (H x) (x.ResidueField ⊗[B] A) (algebraMap x.ResidueField (x.ResidueField ⊗[B] A)).injective
  exact (Algebra.TensorProduct.cancelBaseChange B x.ResidueField (H x) (H x)
    A).symm.toAlgHom.toRingHom.domain_nontrivial

/-- **Points over `x` for morphisms of finite type.** If `A` is a `B`-algebra of finite type and
the fibre algebra `H(x) ⊗_B A` is nonzero, there is a point `y ∈ (Spec A)^an` over `x`: for a
maximal ideal `m` of `H(x) ⊗_B A`, the field `L = (H(x) ⊗_B A) / m` is finite over `H(x)` by
Zariski's lemma, the norm of the complete field `H(x)` extends to a valuation `w` on `L`, and
`|a|_y = w(1 ⊗ a mod m)`. -/
theorem exists_comap_eq_of_nontrivial_fibre [Algebra.FiniteType B A] (x : Berk k B)
    [Nontrivial (H x ⊗[B] A)] :
    ∃ y : Berk k A, comap (IsScalarTower.toAlgHom k B A) y = x := by
  obtain ⟨m, hm⟩ := Ideal.exists_maximal (H x ⊗[B] A)
  let : Field (H x ⊗[B] A ⧸ m) := Ideal.Quotient.field m
  have : Algebra.FiniteType (H x) (H x ⊗[B] A) := Algebra.FiniteType.baseChange (H x)
  have : Algebra.FiniteType (H x) (H x ⊗[B] A ⧸ m) :=
    Algebra.FiniteType.trans (S := H x ⊗[B] A) inferInstance inferInstance
  have : Module.Finite (H x) (H x ⊗[B] A ⧸ m) :=
    finite_of_finite_type_of_isJacobsonRing (H x) (H x ⊗[B] A ⧸ m)
  obtain ⟨w, hw⟩ := Valuation.exists_extends_norm (K := H x) (L := H x ⊗[B] A ⧸ m)
  let q : H x ⊗[B] A →+* H x ⊗[B] A ⧸ m := Ideal.Quotient.mk m
  let ρ : A →+* (H x ⊗[B] A ⧸ m) :=
    q.comp (Algebra.TensorProduct.includeRight (R := B) (A := H x)).toRingHom
  have hρq : ∀ a, ρ a = q ((1 : H x) ⊗ₜ a) := fun _ => rfl
  have hqc : ∀ c, q (c ⊗ₜ (1 : A)) = algebraMap (H x) (H x ⊗[B] A ⧸ m) c := fun c => by
    rw [← Ideal.Quotient.mk_algebraMap, Algebra.TensorProduct.algebraMap_apply,
      Algebra.algebraMap_self, RingHom.id_apply]
  have hρb : ∀ b : B, ρ (algebraMap B A b) = algebraMap (H x) (H x ⊗[B] A ⧸ m) (toH x b) := by
    intro b
    rw [hρq, ← algebraMap_tmul_one_eq, ← hqc]
    rfl
  have hρ : ∀ b : B, w (ρ (algebraMap B A b)) = x.val b := fun b => by
    rw [hρb, hw, nnnorm_toH]
  refine ⟨⟨w.comap ρ, fun c hc => ?_⟩, ext_val fun b => ?_⟩
  · rw [Valuation.comap_apply, IsScalarTower.algebraMap_apply k B A, hρ, x.val_algebraMap c hc]
  · rw [comap_val_apply, IsScalarTower.toAlgHom_apply]
    exact hρ b

end fibre

end Berk

/-! ### The affine charts of a blowup -/

open Berk

variable {k : Type*} [Field k] {A : Type*} [CommRing A] [IsDomain A] [Algebra k A]

/-- The **affine chart** `A[s/g] = A[h/g : h ∈ s] ⊆ Frac A` of the blowup of `Spec A` along the
ideal generated by `s` (nonempty, i.e. a chart of the blowup, when `g ∈ s` and `g ≠ 0`). -/
def blowupChart (s : Finset A) (g : A) : Subalgebra A (FractionRing A) :=
  Algebra.adjoin A ((fun h => algebraMap A (FractionRing A) h / algebraMap A (FractionRing A) g) ''
    (s : Set A))

variable (s : Finset A) (g : A)

/-- The element `h/g` of the chart `A[s/g]`, for `h ∈ s`. -/
def chartFrac {h : A} (hh : h ∈ s) : blowupChart s g :=
  ⟨algebraMap A (FractionRing A) h / algebraMap A (FractionRing A) g,
    Algebra.subset_adjoin ⟨h, hh, rfl⟩⟩

@[simp]
theorem coe_chartFrac {h : A} (hh : h ∈ s) :
    ((chartFrac s g hh : blowupChart s g) : FractionRing A) =
      algebraMap A (FractionRing A) h / algebraMap A (FractionRing A) g := rfl

variable (k) in
/-- The map `A → A[s/g]`, inducing the chart `Spec A[s/g] → Spec A` of the blowup. -/
def chartMap : A →ₐ[k] blowupChart s g :=
  IsScalarTower.toAlgHom k A (blowupChart s g)

@[simp]
theorem coe_chartMap (a : A) :
    ((chartMap k s g a : blowupChart s g) : FractionRing A) = algebraMap A (FractionRing A) a :=
  rfl

theorem chartMap_apply (a : A) : chartMap k s g a = algebraMap A (blowupChart s g) a := rfl

/-- `A → A[s/g]` is injective (the blowup is birational). -/
theorem chartMap_injective : Function.Injective (chartMap k s g) := fun _ _ hab =>
  IsFractionRing.injective A (FractionRing A) (congrArg Subtype.val hab)

variable {s g} in
/-- `g/g = 1` in `A[s/g]`. -/
theorem chartFrac_self (hg : g ∈ s) (hg0 : g ≠ 0) : chartFrac s g hg = 1 := by
  refine Subtype.ext ?_
  rw [coe_chartFrac, OneMemClass.coe_one]
  exact div_self ((map_ne_zero_iff _ (IsFractionRing.injective A (FractionRing A))).2 hg0)

variable {s g} in
/-- `g · (h/g) = h` in `A[s/g]`. -/
theorem chartMap_mul_chartFrac (hg0 : g ≠ 0) {h : A} (hh : h ∈ s) :
    chartMap k s g g * chartFrac s g hh = chartMap k s g h := by
  refine Subtype.ext ?_
  rw [MulMemClass.coe_mul, coe_chartFrac, coe_chartMap, coe_chartMap]
  exact mul_div_cancel₀ _ ((map_ne_zero_iff _ (IsFractionRing.injective A (FractionRing A))).2 hg0)

instance : Algebra.FiniteType A (blowupChart s g) := by
  classical
  have : blowupChart s g = Algebra.adjoin A
      ((s.image fun h => algebraMap A (FractionRing A) h / algebraMap A (FractionRing A) g :
        Finset (FractionRing A)) : Set (FractionRing A)) := by
    rw [Finset.coe_image]; rfl
  rw [← Subalgebra.fg_iff_finiteType, this]
  exact Subalgebra.fg_adjoin_finset _

instance [Algebra.FiniteType k A] : Algebra.FiniteType k (blowupChart s g) :=
  Algebra.FiniteType.trans (S := A) inferInstance inferInstance

/-! ### Surjectivity -/

variable {s} in
/-- **Some chart contains a point over `x`.** Let `p = supp x`, `V ⊆ Frac A` a valuation ring
dominating `A_p`, and `g ∈ s` with `|g|_V` maximal, so that `g ≠ 0` and `h/g ∈ V` for all
`h ∈ s`. Then `A[s/g] ⊆ V`, the prime `𝔪_V ∩ A[s/g]` lies over `p`, so the fibre algebra
`H(x) ⊗_A A[s/g]` is nonzero and has a point over `x`. -/
theorem exists_comap_chartMap_eq (hs : ∃ g ∈ s, g ≠ 0) (x : Berk k A) :
    ∃ g ∈ s, g ≠ 0 ∧ ∃ y : Berk k (blowupChart s g), comap (chartMap k s g) y = x := by
  classical
  have hinj := IsFractionRing.injective A (FractionRing A)
  let p := x.val.supp
  -- the valuation ring `V` dominating `A_p`
  have hunit : ∀ a : p.primeCompl, IsUnit (algebraMap A (FractionRing A) a) := fun a =>
    isUnit_iff_ne_zero.2 ((map_ne_zero_iff _ hinj).2 fun h => a.2 (h ▸ p.zero_mem))
  let f : Localization.AtPrime p →+* FractionRing A := IsLocalization.lift (M := p.primeCompl) hunit
  obtain ⟨V, hV, hloc⟩ := IsLocalRing.exists_factor_valuationRing f
  have hfa : ∀ a : A, f (algebraMap A _ a) = algebraMap A (FractionRing A) a :=
    IsLocalization.lift_eq hunit
  have hAV : ∀ a : A, algebraMap A (FractionRing A) a ∈ V := fun a => hfa a ▸ hV _
  let φV : A →+* V :=
    (f.codRestrict V.toSubring hV).comp (algebraMap A (Localization.AtPrime p))
  have hφV : (IsLocalRing.maximalIdeal V).comap φV = p := by
    ext a
    rw [Ideal.mem_comap, RingHom.comp_apply, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
      isUnit_map_iff, ← mem_nonunits_iff, ← IsLocalRing.mem_maximalIdeal,
      IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime p) p a]
  -- the choice of `g`
  obtain ⟨g₀, hg₀, hg₀0⟩ := hs
  obtain ⟨g, hg, hgmax⟩ := Finset.exists_max_image s
    (fun h => V.valuation (algebraMap A (FractionRing A) h)) ⟨g₀, hg₀⟩
  have hg0 : g ≠ 0 := by
    rintro rfl
    have := hgmax g₀ hg₀
    rw [map_zero, map_zero, le_zero_iff, Valuation.zero_iff, map_eq_zero_iff _ hinj] at this
    exact hg₀0 this
  have hfrac : ∀ h ∈ s,
      algebraMap A (FractionRing A) h / algebraMap A (FractionRing A) g ∈ V := fun h hh => by
    rw [← ValuationSubring.valuation_le_one_iff, map_div₀]
    exact div_le_one_of_le₀ (hgmax h hh) zero_le
  -- `A[s/g] ⊆ V` and the prime of `A[s/g]` over `p`
  let Vsub : Subalgebra A (FractionRing A) := { V.toSubring with algebraMap_mem' := hAV }
  have hle : blowupChart s g ≤ Vsub := Algebra.adjoin_le (by
    rintro _ ⟨h, hh, rfl⟩
    exact hfrac h hh)
  let ι : blowupChart s g →+* V :=
    (blowupChart s g).val.toRingHom.codRestrict V.toSubring fun c => hle c.2
  let Q := (IsLocalRing.maximalIdeal V).comap ι
  have hQ : Q.comap (algebraMap A (blowupChart s g)) = x.val.supp := by
    change _ = p
    rw [Ideal.comap_comap, ← hφV]
    congr 1
    refine RingHom.ext fun a => Subtype.ext ?_
    exact (hfa a).symm
  have := nontrivial_fibre_of_comap_eq x Q hQ
  obtain ⟨y, hy⟩ := exists_comap_eq_of_nontrivial_fibre (A := blowupChart s g) x
  exact ⟨g, hg, hg0, y, hy⟩

variable {s} in
/-- **Surjectivity of the closed subcharts** (FHX Definition 5.6: `μ^an` is surjective). Every
`x ∈ Y^an` is the image of a point `y` of a chart `Spec A[s/g]^an`, `g ∈ s`, `g ≠ 0`, with
`|h/g|_y ≤ 1` for all `h ∈ s`. Starting from any point `y` over `x` on the chart of `g`
(`exists_comap_chartMap_eq`), take `g' ∈ s` maximizing `|g'/g|_y`, so `t = g'/g` has `|t|_y ≥ 1`;
then `A[s/g'] ⊆ A[s/g][1/t] ⊆ Frac A` (`h/g' = (h/g)/t`), and the point of `Spec A[s/g][1/t]^an`
over `y` restricts to a point of `Spec A[s/g']^an` over `x` with `|h/g'| = |h/g|_y/|t|_y ≤ 1`. -/
theorem exists_comap_chartMap_eq_of_le_one (hs : ∃ g ∈ s, g ≠ 0) (x : Berk k A) :
    ∃ g ∈ s, g ≠ 0 ∧ ∃ y : Berk k (blowupChart s g), comap (chartMap k s g) y = x ∧
      ∀ h (hh : h ∈ s), y.val (chartFrac s g hh) ≤ 1 := by
  classical
  obtain ⟨g, hg, hg0, y, rfl⟩ := exists_comap_chartMap_eq hs x
  have hinj := IsFractionRing.injective A (FractionRing A)
  have hgK : algebraMap A (FractionRing A) g ≠ 0 := (map_ne_zero_iff _ hinj).2 hg0
  obtain ⟨⟨g', hg'⟩, -, hmax⟩ := Finset.exists_max_image s.attach
    (fun h => y.val (chartFrac s g h.2)) ⟨⟨g, hg⟩, Finset.mem_attach _ _⟩
  set t := chartFrac s g hg' with ht
  have hmax' : ∀ h (hh : h ∈ s), y.val (chartFrac s g hh) ≤ y.val t := fun h hh =>
    hmax ⟨h, hh⟩ (Finset.mem_attach _ _)
  have ht1 : 1 ≤ y.val t := by
    have := hmax' g hg
    rwa [chartFrac_self hg hg0, map_one] at this
  have hyt : y.val t ≠ 0 := (zero_lt_one.trans_le ht1).ne'
  have hg'0 : g' ≠ 0 := by
    rintro rfl
    apply hyt
    have : t = 0 := Subtype.ext (by rw [ht, coe_chartFrac, map_zero, zero_div]; rfl)
    rw [this, map_zero]
  have hg'K : algebraMap A (FractionRing A) g' ≠ 0 := (map_ne_zero_iff _ hinj).2 hg'0
  have htK : (t : FractionRing A) ≠ 0 := by
    rw [ht, coe_chartFrac]; exact div_ne_zero hg'K hgK
  have ht0 : t ≠ 0 := fun h => htK (by rw [h]; rfl)
  -- the localization `A[s/g][1/t]` embeds in `Frac A`
  let C := blowupChart s g
  let L := Localization.Away t
  have hunit : ∀ c : Submonoid.powers t, IsUnit (C.val.toRingHom c) := by
    rintro ⟨_, n, rfl⟩
    refine isUnit_iff_ne_zero.2 ?_
    change ((t ^ n : C) : FractionRing A) ≠ 0
    rw [SubmonoidClass.coe_pow]
    exact pow_ne_zero n htK
  let ι : L →+* FractionRing A := IsLocalization.lift hunit
  have hιc : ∀ c : C, ι (algebraMap C L c) = c := IsLocalization.lift_eq hunit
  have hιinj : Function.Injective ι := by
    rw [IsLocalization.lift_injective_iff]
    intro a b
    refine ⟨fun h => congrArg Subtype.val (IsLocalization.injective L
      (powers_le_nonZeroDivisors_of_noZeroDivisors ht0) h), fun h => ?_⟩
    have : a = b := Subtype.ext h
    rw [this]
  -- `A[s/g'] ⊆ A[s/g][1/t]`
  have hιfrac : ∀ h (hh : h ∈ s),
      ι (IsLocalization.mk' L (chartFrac s g hh) (⟨t ^ 1, 1, rfl⟩ : Submonoid.powers t)) =
        chartFrac s g' hh := by
    intro h hh
    rw [IsLocalization.lift_mk'_spec]
    change ((chartFrac s g hh : C) : FractionRing A) = ((t ^ 1 : C) : FractionRing A) * _
    rw [pow_one, ht, coe_chartFrac, coe_chartFrac, coe_chartFrac]
    field_simp
  let R : Subalgebra A (FractionRing A) :=
    { ι.range with
      algebraMap_mem' := fun a => ⟨algebraMap C L (algebraMap A C a), hιc _⟩ }
  have hle : blowupChart s g' ≤ R := Algebra.adjoin_le (by
    rintro _ ⟨h, hh, rfl⟩
    exact ⟨_, hιfrac h hh⟩)
  let e : L ≃+* ι.range := RingEquiv.ofBijective ι.rangeRestrict
    ⟨fun a b hab => hιinj (congrArg Subtype.val hab), ι.rangeRestrict_surjective⟩
  let ψ : blowupChart s g' →+* L := e.symm.toRingHom.comp
    ((blowupChart s g').val.toRingHom.codRestrict ι.range fun d => hle d.2)
  have hιψ : ∀ d, ι (ψ d) = d := fun d => by
    change ((e (e.symm _) : ι.range) : FractionRing A) = d
    rw [RingEquiv.apply_symm_apply]
    rfl
  have hψeq : ∀ (d : blowupChart s g') (z : L), ι z = d → ψ d = z := fun d z h =>
    hιinj (by rw [hιψ, h])
  let ψk : blowupChart s g' →ₐ[k] L :=
    { ψ with
      commutes' := fun c => hψeq _ _ (by
        rw [IsScalarTower.algebraMap_apply k C L c, hιc, Subalgebra.coe_algebraMap,
          Subalgebra.coe_algebraMap]) }
  refine ⟨g', hg', hg'0, comap ψk (awayLift t y hyt), ext_val fun a => ?_, fun h hh => ?_⟩
  · change (awayLift t y hyt).val (ψ (chartMap k s g' a)) = y.val (chartMap k s g a)
    rw [hψeq _ (algebraMap C L (chartMap k s g a)) (by rw [hιc, coe_chartMap, coe_chartMap]),
      awayLift_val_algebraMap]
  · change (awayLift t y hyt).val (ψ (chartFrac s g' hh)) ≤ 1
    rw [hψeq _ _ (hιfrac h hh), awayLift_val_mk', pow_one]
    exact div_le_one_of_le₀ (hmax' h hh) zero_le

/-! ### Properness -/

/-- Generators of `A` together with the `h/g`, `h ∈ s`, generate the `k`-algebra `A[s/g]`. -/
theorem adjoin_chartMap_union_chartFrac {S : Set A} (hS : Algebra.adjoin k S = ⊤) :
    Algebra.adjoin k (chartMap k s g '' S ∪ Set.range fun h : s => chartFrac s g h.2) = ⊤ := by
  rw [eq_top_iff]
  rintro ⟨z, hz⟩ -
  induction hz using Algebra.adjoin_induction with
  | mem z hz =>
    obtain ⟨h, hh, rfl⟩ := hz
    exact Algebra.subset_adjoin (Or.inr ⟨⟨h, hh⟩, rfl⟩)
  | algebraMap a =>
    have ha : a ∈ Algebra.adjoin k S := hS ▸ Algebra.mem_top
    have h2 : chartMap k s g a ∈ (Algebra.adjoin k S).map (chartMap k s g) := ⟨a, ha, rfl⟩
    rw [AlgHom.map_adjoin] at h2
    exact Algebra.adjoin_mono Set.subset_union_left h2
  | add z w hz hw ihz ihw => exact Subalgebra.add_mem _ ihz ihw
  | mul z w hz hw ihz ihw => exact Subalgebra.mul_mem _ ihz ihw

/-- **Properness of the closed subcharts** (FHX Definition 5.6: `μ^an` is proper). For a compact
`K ⊆ Y^an`, the set of points `y` of the chart `Spec A[s/g]^an` over `K` with `|h/g|_y ≤ 1` for
all `h ∈ s` is compact: it is closed and lies in a closed polydisc for the generators of `A[s/g]`
given by generators of `A` (bounded on `K`) and the `h/g`. -/
theorem isCompact_closedChart [Algebra.FiniteType k A] {K : Set (Berk k A)} (hK : IsCompact K) :
    IsCompact {y : Berk k (blowupChart s g) | comap (chartMap k s g) y ∈ K ∧
      ∀ h (hh : h ∈ s), y.val (chartFrac s g hh) ≤ 1} := by
  obtain ⟨S, hS⟩ := exists_finset_adjoin_eq_top (k := k) (A := A)
  obtain ⟨R, hR⟩ := exists_forall_abs_le_of_isCompact hK S
  refine isCompact_of_isClosed_of_forall_abs_le (adjoin_chartMap_union_chartFrac s g hS) ?_
    (max R 1) ?_
  · have e : {y : Berk k (blowupChart s g) | comap (chartMap k s g) y ∈ K ∧
        ∀ h (hh : h ∈ s), y.val (chartFrac s g hh) ≤ 1} =
        comap (chartMap k s g) ⁻¹' K ∩ ⋂ h : s, {y | y.val (chartFrac s g h.2) ≤ 1} := by
      ext y
      simp
    rw [e]
    exact (hK.isClosed.preimage (continuous_comap _)).inter
      (isClosed_iInter fun h => isClosed_setOf_abs_le _ _)
  · rintro y ⟨hyK, hy1⟩ _ (⟨a, ha, rfl⟩ | ⟨⟨h, hh⟩, rfl⟩)
    · exact (hR hyK a ha).trans (le_max_left _ _)
    · exact (hy1 h hh).trans (le_max_right _ _)

end EnvelopeProperty
