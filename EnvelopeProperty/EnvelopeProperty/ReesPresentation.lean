import Mathlib.RingTheory.ReesAlgebra
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Whole original homogeneous Rees presentations

Every ring and family is allowed: no domain, finiteness or nonzero-generator
assumption is imposed. The kernel and image are the actual original maps and
subalgebras; no radical or prescribed presentation is substituted.
-/

open scoped Polynomial
noncomputable section
namespace EnvelopeProperty.ReesPresentation
variable {A ι : Type*} [CommRing A] (g : ι → A)

/-- The original ideal generated by the given actual family. -/
def generatorIdeal : Ideal A := Ideal.span (Set.range g)

/-- The genuine original map `Yᵢ ↦ gᵢ T`, retaining the entire coefficient ring. -/
def presentation : MvPolynomial ι A →ₐ[A] A[X] :=
  MvPolynomial.aeval fun i => Polynomial.C (g i) * Polynomial.X

@[simp]
theorem presentation_C (a : A) : presentation g (MvPolynomial.C a) = Polynomial.C a :=
  MvPolynomial.aeval_C _ _

@[simp]
theorem presentation_X (i : ι) :
    presentation g (MvPolynomial.X i) = Polynomial.C (g i) * Polynomial.X :=
  MvPolynomial.aeval_X _ _

/-- The full original monomial image records the actual total degree. -/
theorem presentation_monomial (m : ι →₀ ℕ) (a : A) :
    presentation g (MvPolynomial.monomial m a) =
      Polynomial.C (MvPolynomial.aeval g (MvPolynomial.monomial m a)) *
        Polynomial.X ^ Finsupp.degree m := by
  simp only [presentation, MvPolynomial.aeval_monomial]
  change Polynomial.C a *
      (∏ i ∈ m.support, (Polynomial.C (g i) * Polynomial.X) ^ m i) =
    Polynomial.C (a * ∏ i ∈ m.support, g i ^ m i) *
      Polynomial.X ^ (∑ i ∈ m.support, m i)
  simp_rw [mul_pow, ← map_pow]
  rw [Finset.prod_mul_distrib, ← map_prod, Finset.prod_pow_eq_pow_sum, map_mul, mul_assoc]

/-- Every ORIGINAL homogeneous polynomial has its entire actual pure-power image. -/
theorem presentation_of_isHomogeneous {H : MvPolynomial ι A} {d : ℕ}
    (hH : H.IsHomogeneous d) :
    presentation g H = Polynomial.C (MvPolynomial.aeval g H) * Polynomial.X ^ d := by
  classical
  rw [← H.support_sum_monomial_coeff, map_sum, map_sum, map_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun m hm => ?_
  rw [presentation_monomial]
  have hdeg : Finsupp.degree m = d := hH.degree_eq_sum_deg_support hm |>.symm
  rw [hdeg]

/-- Actual original polynomial coefficients recover the original homogeneous components. -/
theorem presentation_coeff (H : MvPolynomial ι A) (d : ℕ) :
    (presentation g H).coeff d = MvPolynomial.aeval g (MvPolynomial.homogeneousComponent d H) := by
  classical
  conv_lhs => rw [← H.support_sum_monomial_coeff]
  rw [map_sum, Polynomial.finsetSum_coeff]
  rw [MvPolynomial.homogeneousComponent_apply, map_sum, Finset.sum_filter]
  refine Finset.sum_congr rfl fun m hm => ?_
  rw [presentation_monomial, Polynomial.coeff_C_mul_X_pow]
  simp only [eq_comm]

/-- The ORIGINAL presentation kernel, without taking its radical. -/
def kernel : Ideal (MvPolynomial ι A) := RingHom.ker (presentation g)

/-- The true original kernel retains every actual total-degree component. -/
theorem homogeneousComponent_mem_kernel {H : MvPolynomial ι A} (hH : H ∈ kernel g) (d : ℕ) :
    MvPolynomial.homogeneousComponent d H ∈ kernel g := by
  change presentation g (MvPolynomial.homogeneousComponent d H) = 0
  rw [presentation_of_isHomogeneous g (MvPolynomial.homogeneousComponent_isHomogeneous d H)]
  have hcoeff := congrArg (fun p : A[X] => p.coeff d) hH
  rw [presentation_coeff, Polynomial.coeff_zero] at hcoeff
  rw [hcoeff, Polynomial.C_0, zero_mul]

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The ACTUAL kernel is homogeneous in the genuine original polynomial grading. -/
theorem kernel_isHomogeneous :
    (kernel g).IsHomogeneous (MvPolynomial.homogeneousSubmodule ι A) := by
  intro d H hH
  change GradedRing.proj (MvPolynomial.homogeneousSubmodule ι A) d H ∈ kernel g
  rw [show GradedRing.proj (MvPolynomial.homogeneousSubmodule ι A) d H =
    MvPolynomial.homogeneousComponent d H from MvPolynomial.decomposition.decompose'_apply H d]
  exact homogeneousComponent_mem_kernel g hH d

/-- The genuine homogeneous ideal used by the actual quotient grading. -/
def homogeneousKernel : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule ι A) where
  toSubmodule := kernel g
  is_homogeneous' := kernel_isHomogeneous g

@[simp]
theorem homogeneousKernel_toIdeal : (homogeneousKernel g).toIdeal = kernel g := rfl

/-- The WHOLE original image is the LITERAL coefficient-power Rees algebra. -/
theorem range_eq_reesAlgebra :
    (presentation g).range = reesAlgebra (generatorIdeal g) := by
  rw [presentation, MvPolynomial.aeval_range, ← adjoin_monomial_eq_reesAlgebra]
  change Algebra.adjoin A (Set.range fun i => Polynomial.C (g i) * Polynomial.X) =
    Algebra.adjoin A (Submodule.map (Polynomial.monomial 1 : A →ₗ[A] A[X])
      (Submodule.span A (Set.range g)) : Set A[X])
  rw [Submodule.map_span, Algebra.adjoin_span]
  congr 1
  ext p
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨g i, ⟨i, rfl⟩, Polynomial.C_mul_X_eq_monomial.symm⟩
  · rintro ⟨a, ⟨i, rfl⟩, rfl⟩
    exact ⟨i, Polynomial.C_mul_X_eq_monomial⟩

/-- The ORIGINAL kernel quotient is genuinely the same whole Rees algebra. -/
def quotientEquiv : (MvPolynomial ι A ⧸ kernel g) ≃ₐ[A] reesAlgebra (generatorIdeal g) :=
  (Ideal.quotientKerEquivRange (presentation g)).trans
    (Subalgebra.equivOfEq _ _ (range_eq_reesAlgebra g))

/-- EVERY original quotient class retains its ENTIRE original polynomial image. -/
@[simp]
theorem quotientEquiv_mk_coe (H : MvPolynomial ι A) :
    ((quotientEquiv g (Ideal.Quotient.mk (kernel g) H) : reesAlgebra (generatorIdeal g)) : A[X]) =
      presentation g H := rfl

/-- Every original coefficient is preserved by the actual quotient equivalence. -/
@[simp]
theorem quotientEquiv_algebraMap (a : A) :
    quotientEquiv g (algebraMap A (MvPolynomial ι A ⧸ kernel g) a) =
      algebraMap A (reesAlgebra (generatorIdeal g)) a :=
  (quotientEquiv g).commutes a

end EnvelopeProperty.ReesPresentation
