import EnvelopeProperty.Global.ModelChange
import EnvelopeProperty.Global.MorphismsPSH

/-!
# Change of model: sections, Fubini–Study and psh functions

This file completes the blueprint node `lem:gl-model-change` of `global.tex` (subsection
`subsec:gl-model`) for the formalization of Fang–Han–Xia, *The envelope property for unibranch
projective varieties* (revision `832e086`, FHX `prop:BJ-package`): for a change of model
`h : IsModelChange 𝒳 𝒳'` (`S ⊆ S' ⊆ S^ν`, coordinates mutually integral in each degree) such that
the elements of `S'` are sections of `𝒳` (`IsModelChange.HasSections`, which holds when the chart
algebras of `𝒳` are integrally closed, `IsModelChange.hasSections`), `R_a(𝒳) = R_a(𝒳')` with
equal values, `PSH(𝒳, θ) = PSH(𝒳', θ)`, `EP_𝒳(θ) ↔ EP_{𝒳'}(θ)` and `C(𝒳) = C(𝒳')`. The
point-level part (`IsModelChange.restrictHomeomorph : 𝒳'^an ≃ₜ 𝒳^an`) is in
`EnvelopeProperty.Global.ModelChange`.

## Powers of coordinates

* `MultiModel.exists_coeff_nsmul_eq_sum_mul`: the homogeneous component of degree `m e`, `m ≥ 1`,
  of an element of `k[w_l T^e]` is `∑_l w_l t_l` with `t_l T^{(m-1) e} ∈ S`.
* `MultiModel.exists_pow_eq_sum_mul`: if `g T^e` is integral over `k[w_l T^e]`, then
  `g^n = ∑_l w_l s_l` with `s_l T^{(n-1) e} ∈ S` for some `n ≥ 1` (the homogeneous integral equation
  `g^n + ∑_{i<n} c_i g^i = 0`, `c_i` of degree `(n - i) e ≥ e`). So a power of every coordinate of
  one model lies in the ideal of `S'` generated by the coordinates of the other model in the same
  block (`IsModelChange.exists_pow_coord_eq_sum`, `IsModelChange.exists_pow_coord_eq_sum'`).

## Admissible degrees

* `MultiModel.mul_chartDen_mem_piece_of_forall`: if `f z̃_Y^γ T^{a+b} ∈ S_W` for all
  `γ ∈ Mon_Y(b)` and every coordinate of `Z` satisfies `z_Z^n = ∑_l z_Y^{(c)}_l s_l`
  (`s_l ∈ S_W` of degree `(n - 1) e_c`), then `f z̃_{Z,j}^{n b} T^{a + n b} ∈ S_W` for every chart
  index `j` of `Z` (replace the factors `z_Z^n` block by block).
* `MultiModel.isAdmissible_of_forall_mul_chartDen` (the pigeonhole step of the ideal argument, for
  degrees `a ∈ ℤ^r`): if `f z̃_j^C T^{a + C} ∈ S` for all chart indices `j`, then
  `b_c = (M_c + 1) C_c` is admissible for `f`.
* `IsModelChange.isAdmissible_of_isAdmissible`: `R_a(𝒳) ⊆ R_a(𝒳')`;
  `IsModelChange.isAdmissible_of_isAdmissible'`: `R_a(𝒳') ⊆ R_a(𝒳)` (with `HasSections` for the
  elements `f z̃_j^{n b'} ∈ S'`); `IsModelChange.sections_eq`.
* `IsModelChange.secAbs_restrictAn`: `|f|_{v'} = |f|_{v'|_S}` (both are
  `max_{β, γ'} |f z̃^β z̃'^{γ'}|_{v'}`, the points being normalized for both coordinate systems).

## Fubini–Study and psh functions

`IsModelChange.isFS_comp_iff`, `IsModelChange.isFinFS_comp_iff`, `IsModelChange.isPSH_comp_iff`,
`IsModelChange.hasEnvelopeProperty_iff`, `IsModelChange.semiampleCone_eq`,
`IsModelChange.nefCone_eq`.

The blueprint's proof says "Hence `R(𝒳') = R(𝒳)`" after proving `S^ν_a ⊆ R_a(𝒳)`; for different
coordinates the two section spaces are defined with different monomials `z̃^β`, `z̃'^{γ'}`, and the
comparison needs the power relations above (this is the only additional input).
-/

open scoped NNReal ENNReal Topology

open Topology MvPolynomial

noncomputable section

namespace EnvelopeProperty

universe u

namespace MultiModel

variable {k : Type u} [Field k] {K : Type u} [Field K] [Algebra k K] {r : ℕ}

/-! ### Powers of integral elements in the ideal of the generators -/

section Core

variable {W : MultiModel k K r} {ι : Type*} [Fintype ι] {e : Fin r →₀ ℕ} {w : ι → K}

private theorem nsmul_ne_zero_of_ne_zero (he : e ≠ 0) {m : ℕ} (hm : m ≠ 0) : m • e ≠ 0 := fun h =>
  hm ((nsmul_eq_nsmul_iff he).1 (h.trans (zero_smul ℕ e).symm))

/-- **Homogeneous components of `k[w_l T^e]` in positive degree**: for `q ∈ k[w_l T^e]` and
`m ≥ 1`, `q_{m e} = ∑_l w_l t_l` with `t_l ∈ S_{(m - 1) e}`. -/
theorem exists_coeff_nsmul_eq_sum_mul (he : e ≠ 0) (hw : ∀ l, w l ∈ W.piece e)
    {q : MvPolynomial (Fin r) K} (hq : q ∈ Algebra.adjoin k (Set.range fun l => monomial e (w l)))
    {m : ℕ} (hm : 0 < m) :
    ∃ t : ι → K, (∀ l, t l ∈ W.piece ((m - 1) • e)) ∧ q.coeff (m • e) = ∑ l, w l * t l := by
  classical
  have hq' : q ∈ Submodule.span k (Submonoid.closure (Set.range fun l => monomial e (w l)) :
      Set (MvPolynomial (Fin r) K)) := by
    rw [← Algebra.adjoin_eq_span]; exact hq
  clear hq
  induction hq' using Submodule.span_induction with
  | mem x hx =>
    induction hx using Submonoid.closure_induction_left with
    | one =>
      refine ⟨0, fun _ => Submodule.zero_mem _, ?_⟩
      rw [coeff_one, if_neg (nsmul_ne_zero_of_ne_zero he hm.ne').symm]
      simp
    | mul_left x hx y hy _ =>
      obtain ⟨l₀, rfl⟩ := hx
      obtain ⟨p, hyp, hym, -⟩ := exists_eq_monomial_of_mem_closure hw (W.triv : Berk k W.S) hy
      set cy := y.coeff (p • e)
      rw [hyp, monomial_mul, coeff_monomial, ← succ_nsmul']
      by_cases hpm : p + 1 = m
      · subst hpm
        refine ⟨Pi.single l₀ cy, fun l => ?_, ?_⟩
        · by_cases hl : l = l₀
          · subst hl
            rw [Pi.single_eq_same, Nat.add_sub_cancel]
            exact hym
          · rw [Pi.single_eq_of_ne hl]
            exact Submodule.zero_mem _
        · rw [if_pos rfl, Finset.sum_eq_single l₀ (fun l _ hl => by
            rw [Pi.single_eq_of_ne hl, mul_zero]) (by simp), Pi.single_eq_same]
      · refine ⟨0, fun _ => Submodule.zero_mem _, ?_⟩
        rw [if_neg fun h => hpm ((nsmul_eq_nsmul_iff he).1 h)]
        simp
  | zero =>
    exact ⟨0, fun _ => Submodule.zero_mem _, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨t, ht, hxt⟩ := hx
    obtain ⟨t', ht', hyt⟩ := hy
    refine ⟨t + t', fun l => Submodule.add_mem _ (ht l) (ht' l), ?_⟩
    rw [coeff_add, hxt, hyt, ← Finset.sum_add_distrib]
    simp only [Pi.add_apply, mul_add]
  | smul c x _ hx =>
    obtain ⟨t, ht, hxt⟩ := hx
    refine ⟨c • t, fun l => Submodule.smul_mem _ c (ht l), ?_⟩
    rw [coeff_smul, hxt, Finset.smul_sum]
    simp only [Pi.smul_apply, mul_smul_comm]

/-- **Powers of an integral element in the ideal of the generators**: if `g T^e` (`e ≠ 0`) is
integral over `k[w_l T^e]`, then `g^n = ∑_l w_l s_l` with `s_l ∈ S_{(n-1) e}` for some `n ≥ 1`. -/
theorem exists_pow_eq_sum_mul (he : e ≠ 0) (hw : ∀ l, w l ∈ W.piece e) {g : K}
    (hg : g ∈ W.piece e)
    (hint : IsIntegral (Algebra.adjoin k (Set.range fun l => monomial e (w l))) (monomial e g)) :
    ∃ n : ℕ, 0 < n ∧ ∃ s : ι → K, (∀ l, s l ∈ W.piece ((n - 1) • e)) ∧
      g ^ n = ∑ l, w l * s l := by
  classical
  set B := Algebra.adjoin k (Set.range fun l => monomial e (w l))
  obtain ⟨P, hPm, hP⟩ := hint
  set n := P.natDegree
  have hn : 0 < n := by
    refine Nat.pos_of_ne_zero fun h0 => ?_
    rw [Polynomial.eq_one_of_monic_natDegree_zero hPm h0, Polynomial.eval₂_one] at hP
    exact one_ne_zero hP
  set c : Fin n → K := fun i => (P.coeff i).1.coeff ((n - i) • e)
  -- The homogeneous integral equation `g^n + ∑ c_i g^i = 0` in `K`.
  have hterm : ∀ i : Fin n,
      ((algebraMap B (MvPolynomial (Fin r) K) (P.coeff i)) * monomial e g ^ (i : ℕ)).coeff (n • e) =
        c i * g ^ (i : ℕ) := by
    intro i
    have hle : (i : ℕ) • e ≤ n • e := nsmul_le_nsmul_left (zero_le) i.2.le
    have hsub : n • e - (i : ℕ) • e = (n - i) • e := by
      ext d
      simp [Nat.sub_mul]
    rw [monomial_pow, coeff_mul_monomial', if_pos hle, hsub]
    rfl
  have key := congrArg (fun q : MvPolynomial (Fin r) K => q.coeff (n • e)) hP
  rw [hPm.as_sum, Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum,
    coeff_add, coeff_sum, Finset.sum_range (fun i => (Polynomial.eval₂
      (algebraMap B (MvPolynomial (Fin r) K)) (monomial e g)
        (Polynomial.C (P.coeff i) * Polynomial.X ^ i)).coeff (n • e))] at key
  simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow] at key
  rw [Finset.sum_congr rfl fun i _ => hterm i, monomial_pow, coeff_monomial, if_pos rfl,
    coeff_zero] at key
  -- Each `c_i` lies in the ideal generated by the `w_l`.
  have ht : ∀ i : Fin n, ∃ t : ι → K, (∀ l, t l ∈ W.piece ((n - i - 1) • e)) ∧
      c i = ∑ l, w l * t l :=
    fun i => exists_coeff_nsmul_eq_sum_mul he hw (P.coeff i).2 (Nat.sub_pos_of_lt i.2)
  choose t ht1 ht2 using ht
  refine ⟨n, hn, fun l => -∑ i : Fin n, t i l * g ^ (i : ℕ), fun l => ?_, ?_⟩
  · refine Submodule.neg_mem _ (Submodule.sum_mem _ fun i _ => ?_)
    have := mul_mem_piece (ht1 i l) (pow_mem_piece hg i)
    have hi := i.2
    rwa [← add_nsmul, show n - i - 1 + i = n - 1 by omega] at this
  · rw [eq_neg_of_add_eq_zero_left key]
    simp only [ht2, Finset.sum_mul, Finset.mul_sum, mul_neg, Finset.sum_neg_distrib, mul_assoc]
    rw [Finset.sum_comm]

/-- A relation `g^n = ∑_l w_l s_l` persists for larger exponents. -/
theorem exists_pow_eq_sum_mul_of_le {g : K} (hg : g ∈ W.piece e) {n n' : ℕ} (hn : 0 < n)
    (hnn' : n ≤ n') {s : ι → K} (hs : ∀ l, s l ∈ W.piece ((n - 1) • e))
    (hgs : g ^ n = ∑ l, w l * s l) :
    ∃ s' : ι → K, (∀ l, s' l ∈ W.piece ((n' - 1) • e)) ∧ g ^ n' = ∑ l, w l * s' l := by
  refine ⟨fun l => s l * g ^ (n' - n), fun l => ?_, ?_⟩
  · have := mul_mem_piece (hs l) (pow_mem_piece hg (n' - n))
    rwa [← add_nsmul, show n - 1 + (n' - n) = n' - 1 by omega] at this
  · have e1 : g ^ n' = g ^ n * g ^ (n' - n) := by rw [← pow_add, Nat.add_sub_cancel' hnn']
    rw [e1, hgs, Finset.sum_mul]
    exact Finset.sum_congr rfl fun l _ => mul_assoc _ _ _

end Core

/-! ### Chart denominators of one model times sections of another -/

section Iteration

theorem chartDen_single_eq_pow (X : MultiModel k K r) (j : X.ChartIndex) (c : Fin r) (m : ℕ) :
    X.chartDen j (Finsupp.single c m) = X.coord c (j c) ^ m := by
  classical
  rw [chartDen, Finset.prod_eq_single c (fun c' _ hc' => by
    rw [Finsupp.single_apply, if_neg (Ne.symm hc'), pow_zero]) (by simp),
    Finsupp.single_eq_same]

variable {W Y Z : MultiModel k K r} {a : Fin r → ℤ} {f : K} {n : ℕ}
  (hZ : ∀ c (j : Fin (Z.M c + 1)), ∃ s : Fin (Y.M c + 1) → K,
    (∀ l, s l ∈ W.piece ((n - 1) • Finsupp.single c 1)) ∧ Z.coord c j ^ n = ∑ l, Y.coord c l * s l)
include hZ

/-- One step: replace a factor `z^{(c)}_{Z,j}{}^n` by `∑_l z^{(c)}_{Y,l} s_l`. -/
theorem mul_pow_zCoeff_mem_piece {D E : Fin r →₀ ℕ} (hD : ∀ c, 0 ≤ a c + D c) {x : K} (c : Fin r)
    (j : Fin (Z.M c + 1))
    (hx : ∀ γ ∈ Y.monSet (E + Finsupp.single c 1), f * (x * Y.zCoeff γ) ∈ W.piece (addDeg a D))
    {γ : Y.CoordIndex →₀ ℕ} (hγ : γ ∈ Y.monSet E) :
    f * (x * Z.coord c j ^ n * Y.zCoeff γ) ∈
      W.piece (addDeg a (D + (n - 1) • Finsupp.single c 1)) := by
  obtain ⟨s, hs, hpow⟩ := hZ c j
  have e1 : f * (x * Z.coord c j ^ n * Y.zCoeff γ) =
      ∑ l, f * (x * Y.zCoeff (γ + Finsupp.single ⟨c, l⟩ 1)) * s l := by
    rw [hpow, Finset.mul_sum, Finset.sum_mul, Finset.mul_sum]
    refine Finset.sum_congr rfl fun l _ => ?_
    simp only [zCoeff_add, zCoeff_single, pow_one]
    ring
  rw [e1, addDeg_add hD]
  refine Submodule.sum_mem _ fun l _ => mul_mem_piece (hx _ ?_) (hs l)
  rw [Y.mem_monSet, monDeg_add, (Y.mem_monSet).1 hγ, monDeg_single]

/-- `m` steps in one block. -/
theorem mul_pow_mul_zCoeff_mem_piece (c : Fin r) (j : Fin (Z.M c + 1)) (m : ℕ) :
    ∀ {D E : Fin r →₀ ℕ}, (∀ c, 0 ≤ a c + D c) → ∀ {x : K},
      (∀ γ ∈ Y.monSet (E + m • Finsupp.single c 1), f * (x * Y.zCoeff γ) ∈
        W.piece (addDeg a D)) →
      ∀ γ ∈ Y.monSet E, f * (x * Z.coord c j ^ (n * m) * Y.zCoeff γ) ∈
        W.piece (addDeg a (D + (m * (n - 1)) • Finsupp.single c 1)) := by
  induction m with
  | zero =>
    intro D E hD x hx γ hγ
    simp only [zero_smul, add_zero, mul_zero, pow_zero, mul_one, zero_mul] at hx ⊢
    exact hx γ hγ
  | succ m ih =>
    intro D E hD x hx γ hγ
    have hD' : ∀ c', 0 ≤ a c' + ((D + (m * (n - 1)) • (Finsupp.single c 1 : Fin r →₀ ℕ)) c' : ℤ) :=
      fun c' => by
      have := hD c'
      simp only [Finsupp.add_apply, Nat.cast_add]
      omega
    have h1 := ih hD (E := E + Finsupp.single c 1) (x := x) fun γ' hγ' => hx γ' (by
      rw [succ_nsmul, ← add_assoc, add_right_comm]
      exact hγ')
    have h2 := mul_pow_zCoeff_mem_piece hZ hD' (x := x * Z.coord c j ^ (n * m)) c j h1 hγ
    have e1 : x * Z.coord c j ^ (n * (m + 1)) = x * Z.coord c j ^ (n * m) * Z.coord c j ^ n := by
      ring
    have e2 : D + ((m + 1) * (n - 1)) • Finsupp.single c 1 =
        D + (m * (n - 1)) • Finsupp.single c 1 + (n - 1) • Finsupp.single c 1 := by
      rw [add_assoc, ← add_nsmul, add_mul, one_mul]
    rw [e1, e2]
    exact h2

/-- All blocks: replace `z̃_{Z,j}^{n B}` by monomials `z̃_Y^γ`, `γ ∈ Mon_Y(B)`. -/
theorem mul_chartDen_mul_zCoeff_mem_piece (j : Z.ChartIndex) (B : Fin r →₀ ℕ) :
    ∀ {D E : Fin r →₀ ℕ}, (∀ c, 0 ≤ a c + D c) → ∀ {x : K},
      (∀ γ ∈ Y.monSet (E + B), f * (x * Y.zCoeff γ) ∈ W.piece (addDeg a D)) →
      ∀ γ ∈ Y.monSet E, f * (x * Z.chartDen j (n • B) * Y.zCoeff γ) ∈
        W.piece (addDeg a (D + (n - 1) • B)) := by
  induction B using Finsupp.induction with
  | zero =>
    intro D E hD x hx γ hγ
    simp only [add_zero, smul_zero, chartDen_zero, mul_one] at hx ⊢
    exact hx γ hγ
  | single_add c m B _ _ ih =>
    intro D E hD x hx γ hγ
    have h1 := ih hD (E := E + Finsupp.single c m) (x := x) fun γ' hγ' => hx γ' (by
      rw [← add_assoc]
      exact hγ')
    have hD' : ∀ c', 0 ≤ a c' + ((D + (n - 1) • B) c' : ℤ) := fun c' => by
      have := hD c'
      simp only [Finsupp.add_apply, Nat.cast_add]
      omega
    have h2 := mul_pow_mul_zCoeff_mem_piece hZ c (j c) m hD' (E := E)
      (x := x * Z.chartDen j (n • B)) (fun γ' hγ' => h1 γ' (by
        rw [Finsupp.smul_single, smul_eq_mul, mul_one] at hγ'
        exact hγ')) γ hγ
    have e1 : x * Z.chartDen j (n • (Finsupp.single c m + B)) =
        x * Z.chartDen j (n • B) * Z.coord c (j c) ^ (n * m) := by
      rw [smul_add, chartDen_add, Finsupp.smul_single, smul_eq_mul, chartDen_single_eq_pow]
      ring
    have e2 : D + (n - 1) • (Finsupp.single c m + B) =
        D + (n - 1) • B + (m * (n - 1)) • Finsupp.single c 1 := by
      ext c'
      simp only [Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul, Finsupp.single_apply]
      split_ifs <;> ring
    rw [e1, e2]
    exact h2

/-- **Chart denominators of `Z` times `f`**: if `f z̃_Y^γ T^{a+b} ∈ S_W` for all `γ ∈ Mon_Y(b)` and
the coordinates of `Z` satisfy `z_Z^n = ∑_l z^{(c)}_{Y,l} s_l`, then
`f z̃_{Z,j}^{n b} T^{a + n b} ∈ S_W` for every chart index `j` of `Z`. -/
theorem mul_chartDen_mem_piece_of_forall (hn : 0 < n) {b : Fin r →₀ ℕ}
    (hb0 : ∀ c, 0 ≤ a c + b c) (hb : ∀ γ ∈ Y.monSet b, f * Y.zCoeff γ ∈ W.piece (addDeg a b))
    (j : Z.ChartIndex) : f * Z.chartDen j (n • b) ∈ W.piece (addDeg a (n • b)) := by
  have h := mul_chartDen_mul_zCoeff_mem_piece (f := f) hZ j b hb0 (E := 0) (x := 1)
    (fun γ hγ => by
      rw [one_mul]
      rw [zero_add] at hγ
      exact hb γ hγ) 0 (by rw [Y.monSet_zero]; exact Finset.mem_singleton_self _)
  rw [one_mul, zCoeff_zero, mul_one] at h
  rwa [← succ_nsmul', Nat.sub_add_cancel hn] at h

end Iteration

/-! ### The pigeonhole step for degrees in `ℤ^r` -/

/-- **The pigeonhole step of the ideal argument** for `a ∈ ℤ^r`: if `f z̃_j^C T^{a+C} ∈ S` for every
chart index `j` with nonzero coordinates, then `b_c = (M_c + 1) C_c` is admissible for `f` in degree
`a`. -/
theorem isAdmissible_of_forall_mul_chartDen {Y : MultiModel k K r} {a : Fin r → ℤ} {f : K}
    {C : Fin r →₀ ℕ} (hC : ∀ c, 0 ≤ a c + C c)
    (h : ∀ j : Y.ChartIndex, (∀ c, Y.coord c (j c) ≠ 0) →
      f * Y.chartDen j C ∈ Y.piece (addDeg a C)) :
    Y.IsAdmissible a (Finsupp.equivFunOnFinite.symm fun c => (Y.M c + 1) * C c) f := by
  classical
  set b : Fin r →₀ ℕ := Finsupp.equivFunOnFinite.symm fun c => (Y.M c + 1) * C c
  have hb : ∀ c, b c = (Y.M c + 1) * C c := fun c => rfl
  refine ⟨fun c => ?_, fun β hβ => ?_⟩
  · have h1 := hC c
    have h2 : (C c : ℤ) ≤ (b c : ℤ) := by
      rw [hb]
      exact_mod_cast Nat.le_mul_of_pos_left (C c) (Nat.succ_pos _)
    omega
  have hβb : Y.monDeg β = b := (Y.mem_monSet).1 hβ
  -- If a coordinate occurring in `β` vanishes, `z̃^β = 0`.
  by_cases hz : ∃ i ∈ β.support, Y.coord i.1 i.2 = 0
  · obtain ⟨i, hi, hi0⟩ := hz
    have h0 : Y.zCoeff β = 0 := by
      rw [zCoeff, Finsupp.prod]
      exact Finset.prod_eq_zero hi (by rw [hi0, zero_pow (Finsupp.mem_support_iff.1 hi)])
    rw [h0, mul_zero]
    exact Submodule.zero_mem _
  push Not at hz
  -- Pigeonhole: in each block some exponent is `≥ C_c`.
  have hpig : ∀ c' : Fin r, ∃ j' : Fin (Y.M c' + 1), Y.coord c' j' ≠ 0 ∧ C c' ≤ β ⟨c', j'⟩ := by
    intro c'
    by_cases hC0 : C c' = 0
    · obtain ⟨j', hj'⟩ := Y.exists_coord_ne_zero c'
      exact ⟨j', hj', by rw [hC0]; exact zero_le⟩
    · by_contra hcon
      push Not at hcon
      have hlt : ∀ j' : Fin (Y.M c' + 1), β ⟨c', j'⟩ < C c' := by
        intro j'
        by_cases hj' : Y.coord c' j' = 0
        · have : β ⟨c', j'⟩ = 0 := by
            by_contra hne
            exact hz _ (Finsupp.mem_support_iff.2 hne) hj'
          rw [this]; exact Nat.pos_of_ne_zero hC0
        · exact hcon j' hj'
      have hsum := Finset.sum_lt_sum_of_nonempty Finset.univ_nonempty fun j' _ => hlt j'
      rw [← monDeg_apply, hβb, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
        smul_eq_mul, hb] at hsum
      exact lt_irrefl _ hsum
  choose j hj hjβ using hpig
  set γ := Y.chartMultiIndex j C
  have hγβ : γ ≤ β := by
    rintro ⟨c', j'⟩
    rw [chartMultiIndex_apply]
    split_ifs with hi
    · simp only at hi
      subst hi
      exact hjβ c'
    · exact zero_le
  have e : β = γ + (β - γ) := (add_tsub_cancel_of_le hγβ).symm
  have hdeg : addDeg a C + Y.monDeg (β - γ) = addDeg a b := by
    rw [← addDeg_add hC, ← Y.monDeg_chartMultiIndex j C, ← monDeg_add, ← e, hβb]
  have hmem := mul_mem_piece (h j hj) (Y.zCoeff_mem_piece (β - γ))
  rw [hdeg, ← Y.zCoeff_chartMultiIndex j C, mul_assoc, ← zCoeff_add, ← e] at hmem
  exact hmem

/-! ### Change of model -/

namespace IsModelChange

variable {X X' : MultiModel k K r} (h : IsModelChange X X')

private theorem single_one_ne_zero (c : Fin r) : (Finsupp.single c 1 : Fin r →₀ ℕ) ≠ 0 :=
  Finsupp.single_ne_zero.2 one_ne_zero

/- A uniform exponent `n` from finitely many exponents `n_i`. -/
private theorem exists_uniform_pow {ι' : Type*} [Fintype ι'] {P : ℕ → ι' → Prop}
    (hP : ∀ i, ∃ n, 0 < n ∧ P n i) (hmono : ∀ i n n', 0 < n → n ≤ n' → P n i → P n' i) :
    ∃ n, 0 < n ∧ ∀ i, P n i := by
  choose m hm hPm using hP
  refine ⟨Finset.univ.sup m + 1, Nat.succ_pos _, fun i => hmono i _ _ (hm i) ?_ (hPm i)⟩
  exact (Finset.le_sup (f := m) (Finset.mem_univ i)).trans (Nat.le_succ _)

include h in
/-- **Powers of the coordinates of `𝒳'`** lie in the ideal of `S'` generated by the coordinates of
`𝒳` in the same block: `z'^{(c)}_j{}^n = ∑_l z^{(c)}_l s_l`, `s_l ∈ S'_{(n-1) e_c}`, with one `n`. -/
theorem exists_pow_coord_eq_sum : ∃ n : ℕ, 0 < n ∧ ∀ (c : Fin r) (j : Fin (X'.M c + 1)),
    ∃ s : Fin (X.M c + 1) → K, (∀ l, s l ∈ X'.piece ((n - 1) • Finsupp.single c 1)) ∧
      X'.coord c j ^ n = ∑ l, X.coord c l * s l := by
  have hP := exists_uniform_pow (ι' := X'.CoordIndex) (P := fun n i =>
    ∃ s : Fin (X.M i.1 + 1) → K, (∀ l, s l ∈ X'.piece ((n - 1) • Finsupp.single i.1 1)) ∧
      X'.coord i.1 i.2 ^ n = ∑ l, X.coord i.1 l * s l)
    (fun i => exists_pow_eq_sum_mul (single_one_ne_zero i.1)
      (fun l => h.mem_piece (X.coord_mem_piece i.1 l)) (X'.coord_mem_piece i.1 i.2)
      (h.coord_isIntegral i.1 i.2))
    (fun i n n' hn hnn' ⟨s, hs, hgs⟩ =>
      exists_pow_eq_sum_mul_of_le (X'.coord_mem_piece i.1 i.2) hn hnn' hs hgs)
  obtain ⟨n, hn, hall⟩ := hP
  exact ⟨n, hn, fun c j => hall ⟨c, j⟩⟩

include h in
/-- **Powers of the coordinates of `𝒳`** lie in the ideal of `S'` generated by the coordinates of
`𝒳'` in the same block. -/
theorem exists_pow_coord_eq_sum' : ∃ n : ℕ, 0 < n ∧ ∀ (c : Fin r) (j : Fin (X.M c + 1)),
    ∃ s : Fin (X'.M c + 1) → K, (∀ l, s l ∈ X'.piece ((n - 1) • Finsupp.single c 1)) ∧
      X.coord c j ^ n = ∑ l, X'.coord c l * s l := by
  have hP := exists_uniform_pow (ι' := X.CoordIndex) (P := fun n i =>
    ∃ s : Fin (X'.M i.1 + 1) → K, (∀ l, s l ∈ X'.piece ((n - 1) • Finsupp.single i.1 1)) ∧
      X.coord i.1 i.2 ^ n = ∑ l, X'.coord i.1 l * s l)
    (fun i => exists_pow_eq_sum_mul (single_one_ne_zero i.1)
      (fun l => X'.coord_mem_piece i.1 l) (h.mem_piece (X.coord_mem_piece i.1 i.2))
      (h.coord_isIntegral' i.1 i.2))
    (fun i n n' hn hnn' ⟨s, hs, hgs⟩ =>
      exists_pow_eq_sum_mul_of_le (h.mem_piece (X.coord_mem_piece i.1 i.2)) hn hnn' hs hgs)
  obtain ⟨n, hn, hall⟩ := hP
  exact ⟨n, hn, fun c j => hall ⟨c, j⟩⟩

private theorem nonneg_nsmul {a : Fin r → ℤ} {b : Fin r →₀ ℕ} (hb : ∀ c, 0 ≤ a c + b c) {n : ℕ}
    (hn : 0 < n) (B : Fin r →₀ ℕ) (c : Fin r) : 0 ≤ a c + ((n • b + B) c : ℤ) := by
  have h1 := hb c
  have h2 : (b c : ℤ) ≤ ((n • b + B) c : ℤ) := by
    simp only [Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul, Nat.cast_add, Nat.cast_mul]
    have : (1 : ℤ) ≤ n := by exact_mod_cast hn
    nlinarith [Nat.cast_nonneg (α := ℤ) (b c), Nat.cast_nonneg (α := ℤ) (B c)]
  omega

include h in
/-- **`R_a(𝒳) ⊆ R_a(𝒳')`** (`lem:gl-model-change`): an admissible degree `b` of `f` for `𝒳` gives
the admissible degree `((M'_c + 1) n b_c)_c` for `𝒳'`. -/
theorem isAdmissible_of_isAdmissible {a : Fin r → ℤ} {b : Fin r →₀ ℕ} {f : K}
    (hf : X.IsAdmissible a b f) : ∃ b' : Fin r →₀ ℕ, X'.IsAdmissible a b' f := by
  obtain ⟨n, hn, hZ⟩ := h.exists_pow_coord_eq_sum
  have hC := fun c => by simpa using nonneg_nsmul hf.1 hn 0 c
  exact ⟨_, isAdmissible_of_forall_mul_chartDen (C := n • b) hC fun j _ =>
    mul_chartDen_mem_piece_of_forall (W := X') (Y := X) (Z := X') hZ hn hf.1
      (fun γ hγ => h.mem_piece (hf.2 γ hγ)) j⟩

include h in
/-- **`R_a(𝒳') ⊆ R_a(𝒳)`** (`lem:gl-model-change`) when the elements of `S'` are sections of `𝒳`
(e.g. integrally closed chart algebras of `𝒳`). -/
theorem isAdmissible_of_isAdmissible' (hR : HasSections X X') {a : Fin r → ℤ}
    {b' : Fin r →₀ ℕ} {f : K} (hf : X'.IsAdmissible a b' f) :
    ∃ b : Fin r →₀ ℕ, X.IsAdmissible a b f := by
  classical
  obtain ⟨n, hn, hZ⟩ := h.exists_pow_coord_eq_sum'
  have hC0 : ∀ c, 0 ≤ a c + ((n • b') c : ℤ) := fun c => by simpa using nonneg_nsmul hf.1 hn 0 c
  have hmem : ∀ j : X.ChartIndex, f * X.chartDen j (n • b') ∈ X'.piece (addDeg a (n • b')) :=
    fun j => mul_chartDen_mem_piece_of_forall (W := X') (Y := X') (Z := X) hZ hn hf.1 hf.2 j
  have hex : ∀ j : X.ChartIndex, ∃ B : Fin r →₀ ℕ,
      f * X.chartDen j (n • b' + B) ∈ X.piece (addDeg a (n • b') + B) := by
    intro j
    obtain ⟨B, hB⟩ := hR _ _ (hmem j)
    refine ⟨B, ?_⟩
    have := hB _ (X.chartMultiIndex_mem_monSet j B)
    rw [zCoeff_chartMultiIndex, mul_assoc, ← chartDen_add] at this
    exact this
  choose B hB using hex
  set Bt := ∑ j, B j
  refine ⟨_, isAdmissible_of_forall_mul_chartDen (C := n • b' + Bt)
    (fun c => nonneg_nsmul hf.1 hn Bt c) fun j _ => ?_⟩
  have hle : B j ≤ Bt := Finset.single_le_sum (f := B) (fun _ _ => zero_le) (Finset.mem_univ j)
  have := mul_mem_piece (hB j) (X.chartDen_mem_piece j (Bt - B j))
  rw [mul_assoc, ← chartDen_add, add_assoc, add_assoc, add_tsub_cancel_of_le hle,
    ← addDeg_add hC0] at this
  exact this

include h in
/-- **`R_a(𝒳') = R_a(𝒳)`** (`lem:gl-model-change`). -/
theorem sections_eq (hR : HasSections X X') (a : Fin r → ℤ) : X'.sections a = X.sections a := by
  ext f
  refine ⟨fun ⟨b', hb'⟩ => ?_, fun ⟨b, hb⟩ => ?_⟩
  · obtain ⟨b, hb⟩ := h.isAdmissible_of_isAdmissible' hR hb'
    exact hb.mem_sections
  · obtain ⟨b', hb'⟩ := h.isAdmissible_of_isAdmissible hb
    exact hb'.mem_sections

/-- **Equal values** at admissible degrees: `max_{γ'} |f z̃'^{γ'}|_{v'} = max_β |f z̃^β|_{v'|_S}`;
both are `max_{β, γ'} |f z̃^β z̃'^{γ'}|_{v'}`. -/
theorem secAbsAt_eq (v : X'.an) {a : Fin r → ℤ} {b b' : Fin r →₀ ℕ} {f : K}
    (hb : X.IsAdmissible a b f) (hb' : X'.IsAdmissible a b' f) :
    X'.secAbsAt v.1 a b' f = X.secAbsAt (h.restrictAn v).1 a b f := by
  set Φ : (X'.CoordIndex →₀ ℕ) → ℝ≥0 := fun γ => X'.homNorm v.1 (addDeg a b') (f * X'.zCoeff γ)
  set Ψ : (X.CoordIndex →₀ ℕ) → ℝ≥0 := fun β => X'.homNorm v.1 (addDeg a b) (f * X.zCoeff β)
  set ζ : (X.CoordIndex →₀ ℕ) → ℝ≥0 := fun β => X'.homNorm v.1 (X.monDeg β) (X.zCoeff β)
  set ζ' : (X'.CoordIndex →₀ ℕ) → ℝ≥0 := fun γ => X'.homNorm v.1 (X'.monDeg γ) (X'.zCoeff γ)
  have hζ : (X.monSet b).sup ζ = 1 := by
    rw [← (h.restrictAn v).2.2.sup_monSet_val_zMon b]
    refine Finset.sup_congr rfl fun β _ => ?_
    change X'.homNorm v.1 (X.monDeg β) (X.zCoeff β) = _
    rw [X'.homNorm_of_mem _ (h.mem_piece (X.zCoeff_mem_piece β))]
    rfl
  have hζ' : (X'.monSet b').sup ζ' = 1 := by
    rw [← v.2.2.sup_monSet_val_zMon b']
    refine Finset.sup_congr rfl fun γ _ => ?_
    change X'.homNorm v.1 (X'.monDeg γ) (X'.zCoeff γ) = _
    rw [X'.homNorm_of_mem _ (X'.zCoeff_mem_piece γ)]
    rfl
  have hX : X.secAbsAt (h.restrictAn v).1 a b f = (X.monSet b).sup Ψ := by
    refine Finset.sup_congr rfl fun β hβ => ?_
    change X.homNorm (h.restrictAn v).1 (addDeg a b) (f * X.zCoeff β) =
      X'.homNorm v.1 (addDeg a b) (f * X.zCoeff β)
    rw [X.homNorm_of_mem _ (hb.2 β hβ), X'.homNorm_of_mem _ (h.mem_piece (hb.2 β hβ))]
    rfl
  have key : ∀ β ∈ X.monSet b, ∀ γ ∈ X'.monSet b', Φ γ * ζ β = Ψ β * ζ' γ := by
    intro β hβ γ hγ
    change X'.homNorm v.1 (addDeg a b') (f * X'.zCoeff γ) *
        X'.homNorm v.1 (X.monDeg β) (X.zCoeff β) =
      X'.homNorm v.1 (addDeg a b) (f * X.zCoeff β) * X'.homNorm v.1 (X'.monDeg γ) (X'.zCoeff γ)
    rw [← homNorm_mul v.1 (hb'.2 γ hγ) (h.mem_piece (X.zCoeff_mem_piece β)),
      ← homNorm_mul v.1 (h.mem_piece (hb.2 β hβ)) (X'.zCoeff_mem_piece γ),
      (X.mem_monSet).1 hβ, (X'.mem_monSet).1 hγ, ← addDeg_add hb'.1, ← addDeg_add hb.1,
      add_comm b' b, show f * X'.zCoeff γ * X.zCoeff β = f * X.zCoeff β * X'.zCoeff γ by ring]
  rw [hX]
  calc X'.secAbsAt v.1 a b' f = (X'.monSet b').sup Φ * (X.monSet b).sup ζ := by
        rw [hζ, mul_one]
        rfl
    _ = (X'.monSet b').sup fun γ => (X.monSet b).sup fun β => Φ γ * ζ β := by
        rw [NNReal.finset_sup_mul]
        exact Finset.sup_congr rfl fun γ _ => NNReal.mul_finset_sup _ _ _
    _ = (X.monSet b).sup fun β => (X'.monSet b').sup fun γ => Φ γ * ζ β :=
        Finset.sup_comm _ _ _
    _ = (X.monSet b).sup fun β => (X'.monSet b').sup fun γ => Ψ β * ζ' γ :=
        Finset.sup_congr rfl fun β hβ => Finset.sup_congr rfl fun γ hγ => key β hβ γ hγ
    _ = (X.monSet b).sup Ψ := by
        refine Finset.sup_congr rfl fun β _ => ?_
        rw [← NNReal.mul_finset_sup, hζ', mul_one]

/-- **Equal values of sections** (`lem:gl-model-change`): `|f|_{v'} = |f|_{v'|_S}`. -/
theorem secAbs_restrictAn (hR : HasSections X X') (v : X'.an) (a : Fin r → ℤ) (f : K) :
    X'.secAbs v.1 a f = X.secAbs (h.restrictAn v).1 a f := by
  by_cases hf : f ∈ X.sections a
  · obtain ⟨b, hb⟩ := hf
    obtain ⟨b', hb'⟩ := h.isAdmissible_of_isAdmissible hb
    rw [secAbs_eq v.2.2 hb', secAbs_eq (h.restrictAn v).2.2 hb, h.secAbsAt_eq v hb hb']
  · rw [secAbs_of_notMem _ hf, secAbs_of_notMem _ (by rwa [h.sections_eq hR])]

theorem logSecAbs_restrictAn (hR : HasSections X X') (v : X'.an) (a : Fin r → ℤ) (f : K) :
    X'.logSecAbs v.1 a f = X.logSecAbs (h.restrictAn v).1 a f := by
  rw [logSecAbs, logSecAbs, h.secAbs_restrictAn hR]

theorem termVal_restrictAn (hR : HasSections X X') (v : X'.an) (d : Fin r → ℤ) (t : K × ℝ) :
    X'.termVal d t v = X.termVal d t (h.restrictAn v) := by
  rw [termVal_def, termVal_def, h.logSecAbs_restrictAn hR]

/-! #### Fubini–Study functions -/

/-- Fubini–Study data of `𝒳'` as data of `𝒳` (the same terms). -/
def pushFSData (hR : HasSections X X') {q : Fin r → ℚ} (D : X'.FSData q) : X.FSData q where
  m := D.m
  m_pos := D.m_pos
  deg := D.deg
  deg_eq := D.deg_eq
  terms := D.terms
  mem_sections t ht := by
    rw [← h.sections_eq hR]
    exact D.mem_sections t ht

theorem eval_pushFSData (hR : HasSections X X') {q : Fin r → ℚ} (D : X'.FSData q) (v : X'.an) :
    (h.pushFSData hR D).eval (h.restrictAn v) = D.eval v := by
  rw [FSData.eval_def, FSData.eval_def]
  refine congrArg _ (Finset.sup_congr rfl fun t _ => ?_)
  rw [h.termVal_restrictAn hR]
  rfl

/-- Fubini–Study data of `𝒳` as data of `𝒳'` (the same terms). -/
def pullFSData (hR : HasSections X X') {q : Fin r → ℚ} (D : X.FSData q) : X'.FSData q where
  m := D.m
  m_pos := D.m_pos
  deg := D.deg
  deg_eq := D.deg_eq
  terms := D.terms
  mem_sections t ht := by
    rw [h.sections_eq hR]
    exact D.mem_sections t ht

theorem eval_pullFSData (hR : HasSections X X') {q : Fin r → ℚ} (D : X.FSData q) (v : X'.an) :
    (h.pullFSData hR D).eval v = D.eval (h.restrictAn v) := by
  rw [FSData.eval_def, FSData.eval_def]
  refine congrArg _ (Finset.sup_congr rfl fun t _ => ?_)
  rw [h.termVal_restrictAn hR]
  rfl

/-- **`𝓗(𝒳', a) = 𝓗(𝒳, a) ∘ ρ`** (`lem:gl-model-change`), `ρ = v' ↦ v'|_S`. -/
theorem isFS_comp_iff (hR : HasSections X X') {q : Fin r → ℚ} {φ : X.an → EReal} :
    X'.IsFS q (φ ∘ h.restrictAn) ↔ X.IsFS q φ := by
  refine ⟨fun ⟨D, hD0, hD⟩ => ⟨h.pushFSData hR D, hD0, fun y => ?_⟩,
    fun ⟨D, hD0, hD⟩ => ⟨h.pullFSData hR D, hD0, fun v => ?_⟩⟩
  · obtain ⟨v, rfl⟩ := h.restrictAn_surjective y
    rw [eval_pushFSData, ← hD v]
    rfl
  · rw [eval_pullFSData, Function.comp_apply, hD]

/-- **`𝓗_fin(𝒳', a) = 𝓗_fin(𝒳, a) ∘ ρ`**. -/
theorem isFinFS_comp_iff (hR : HasSections X X') {q : Fin r → ℚ} {φ : X.an → EReal} :
    X'.IsFinFS q (φ ∘ h.restrictAn) ↔ X.IsFinFS q φ := by
  rw [isFinFS_iff, isFinFS_iff]
  refine ⟨fun ⟨D, hDr, hne, hD⟩ => ⟨h.pushFSData hR D, hDr, fun y => ?_, fun y => ?_⟩,
    fun ⟨D, hDr, hne, hD⟩ => ⟨h.pullFSData hR D, hDr, fun v => ?_, fun v => ?_⟩⟩
  · obtain ⟨v, rfl⟩ := h.restrictAn_surjective y
    rw [eval_pushFSData]
    exact hne v
  · obtain ⟨v, rfl⟩ := h.restrictAn_surjective y
    rw [eval_pushFSData, ← hD v]
    rfl
  · rw [eval_pullFSData]
    exact hne _
  · rw [eval_pullFSData, Function.comp_apply, hD]

/-- **`PSH(𝒳', θ) = PSH(𝒳, θ) ∘ ρ`** (`lem:gl-model-change`). -/
theorem isPSH_comp_iff (hR : HasSections X X') {θ : Fin r → ℝ} {u : X.an → EReal} :
    X'.IsPSH θ (u ∘ h.restrictAn) ↔ X.IsPSH θ u :=
  FSSystemC.isPSH_comp_iff (F := X.fsSystem) (G := X'.fsSystem) (h.restrictHomeomorph hR)
    h.restrictAn_triv fun _ _ => (h.isFS_comp_iff hR).symm

include h in
/-- **`EP_{𝒳'}(θ) ↔ EP_𝒳(θ)`** (`lem:gl-model-change`). -/
theorem hasEnvelopeProperty_iff (hR : HasSections X X') {θ : Fin r → ℝ} :
    X'.HasEnvelopeProperty θ ↔ X.HasEnvelopeProperty θ :=
  FSSystemC.hasEnvelopeProperty_iff (F := X.fsSystem) (G := X'.fsSystem)
    (h.restrictHomeomorph hR) h.restrictAn_triv fun _ _ => (h.isFS_comp_iff hR).symm

include h in
/-- **`C(𝒳') = C(𝒳)`** (`lem:gl-model-change`): base point free families correspond. -/
theorem semiampleCone_eq (hR : HasSections X X') : X'.semiampleCone = X.semiampleCone := by
  have hbpf : ∀ (d : Fin r → ℤ) (s : Finset K), X'.IsBasePointFree d s ↔ X.IsBasePointFree d s := by
    intro d s
    refine ⟨fun hs => ⟨fun f hf => (h.sections_eq hR d) ▸ hs.1 f hf, fun y => ?_⟩,
      fun hs => ⟨fun f hf => (h.sections_eq hR d).symm ▸ hs.1 f hf, fun v => ?_⟩⟩
    · obtain ⟨v, rfl⟩ := h.restrictAn_surjective y
      obtain ⟨f, hf, hne⟩ := hs.2 v
      exact ⟨f, hf, by rwa [← h.secAbs_restrictAn hR]⟩
    · obtain ⟨f, hf, hne⟩ := hs.2 (h.restrictAn v)
      exact ⟨f, hf, by rwa [h.secAbs_restrictAn hR]⟩
  ext a
  simp only [mem_semiampleCone, hbpf]

include h in
/-- `N(𝒳') = N(𝒳)`. -/
theorem nefCone_eq (hR : HasSections X X') : X'.nefCone = X.nefCone := by
  rw [nefCone, nefCone, h.semiampleCone_eq hR]

