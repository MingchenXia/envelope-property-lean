import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
import Mathlib.AlgebraicGeometry.FunctionField
import Hironaka.Algebra.RegularSmooth.Stalk

/-!
# Pulling back the coordinate ratios of `Proj` to a function field

Let `𝒜` be a graded `k`-algebra, `Y` an integral scheme and `ψ : Y ⟶ Proj 𝒜` a morphism; let
`𝔭 ⊆ A` be the homogeneous prime of `ψ(η_Y)`, `η_Y` the generic point. Every homogeneous fraction
`a / b` (`a, b ∈ 𝒜_d`, `b ∉ 𝔭`) defines an element of the stalk `A⁰_𝔭 = 𝒪_{Proj 𝒜, ψ(η_Y)}`, and
the stalk map of `ψ` sends it to the function field `k(Y)`:

* `DeJongEPBridge.ProjChart.genMap 𝒜 ψ : A⁰_𝔭 →+* k(Y)`, a local ring homomorphism; for a
  homogeneous `f ∉ 𝔭` of positive degree, the pull-back to `k(Y)` of a section of
  `Γ(D₊(f)) = A⁰_(f)` is its image under `genMap` (`germ_app_awayToSection`);
* `genMap_frac_ne_zero_iff`: the image of `a / b` is nonzero iff `a ∉ 𝔭`;
* `genMap_fromZero`: when `ψ` is a morphism over `k` (for the structure map
  `Proj 𝒜 → Spec 𝒜₀ → Spec k`), `genMap` is `k`-linear on constants;
* `range_germ_app_eq_adjoin`: if `A` is generated over `k` by elements `v_i` of degree `1` and
  `𝒜₀ = k`, then the image of `Γ(D₊(f))` (`f` of degree `1`, `f ∉ 𝔭`) in `k(Y)` is the
  `k`-subalgebra generated by the images of the ratios `v_i / f`.

This is the chart computation of the bridge (plan PLAN-DJ-MAIN §6.2, steps 4–6): for
`ψ = φ : Y → X ⊆ ℙ^N` it computes the ratios `a_i = φ^*(x_i / x_{j₀})` and the coordinate rings of
the charts. The scalar compatibility `projectiveStructureSectionSquare` is adapted from Codex's
`DeJongAlterations/Geometry/ProperSteinProjectiveCechStructureCoefficients.lean` (itself adapted
from `EnvelopeProperty/deps/aintlib-ep33/ModularCurves/ForMathlib/ProjToSpecZero.lean`).
-/

noncomputable section

open CategoryTheory AlgebraicGeometry HomogeneousLocalization

namespace DeJongEPBridge.ProjChart

universe u

/-- A homogeneous polynomial of degree `d` scales by `t^d`. -/
theorem eval₂_mul_of_isHomogeneous {R L σ : Type*} [CommSemiring R] [CommSemiring L] [Fintype σ]
    (φ : R →+* L) (w : σ → L) (t : L) {G : MvPolynomial σ R} {d : ℕ}
    (hG : G.IsHomogeneous d) :
    MvPolynomial.eval₂ φ (fun i => w i * t) G = t ^ d * MvPolynomial.eval₂ φ w G := by
  rw [MvPolynomial.eval₂_eq', MvPolynomial.eval₂_eq', Finset.mul_sum]
  refine Finset.sum_congr rfl fun β hβ => ?_
  have hd : ∑ i, β i = d := by
    rw [← Finsupp.degree_eq_sum]
    by_contra h
    exact (MvPolynomial.mem_support_iff.mp hβ) (hG.coeff_eq_zero h)
  simp only [mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hd]
  ring

variable {k : Type u} [Field k] {A : Type u} [CommRing A] [Algebra k A]
  (𝒜 : ℕ → Submodule k A) [GradedAlgebra 𝒜]

/-! ### Constants and the structure morphism -/

/-- The constants `k → 𝒜₀`. -/
def zeroConst : k →+* 𝒜 0 where
  toFun c := ⟨algebraMap k A c, SetLike.algebraMap_mem_graded 𝒜 c⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' _ _ := Subtype.ext (map_mul _ _ _)
  map_zero' := Subtype.ext (map_zero _)
  map_add' _ _ := Subtype.ext (map_add _ _ _)

@[simp]
theorem coe_zeroConst (c : k) : (zeroConst 𝒜 c : A) = algebraMap k A c :=
  rfl

/-- The structure morphism `Proj 𝒜 → Spec 𝒜₀ → Spec k`. -/
def structureMap : Proj 𝒜 ⟶ Spec (.of k) :=
  Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom (zeroConst 𝒜))

/-- For a positive-degree homogeneous element, the map on global sections induced by
`Proj.awayι` is restriction to the basic open followed by the inverse of the canonical
presentation (adapted from Codex's `projectiveAwayPullbackSquare`). -/
theorem projectiveAwayPullbackSquare {m : ℕ} (f : A) (f_deg : f ∈ 𝒜 m) (hm : 0 < m) :
    (Proj.awayι 𝒜 f f_deg hm).appTop ≫
      (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).hom =
    (Proj 𝒜).presheaf.map (homOfLE le_top).op ≫
      (Proj.basicOpenIsoAway 𝒜 f f_deg hm).inv := by
  rw [Iso.eq_comp_inv, Category.assoc]
  have hσ : (Proj.basicOpenIsoAway 𝒜 f f_deg hm).hom = Proj.awayToSection 𝒜 f := rfl
  rw [hσ]
  have hhomTop : (Proj.basicOpenToSpec 𝒜 f).appTop ≫
      (Proj.basicOpen 𝒜 f).topIso.hom =
      (Scheme.ΓSpecIso _).hom ≫ Proj.awayToSection 𝒜 f := by
    rw [show (Proj.basicOpenToSpec 𝒜 f).appTop =
      (Proj.basicOpenToSpec 𝒜 f).app ⊤ from rfl]
    rw [Proj.basicOpenToSpec_app_top, Category.assoc, Category.assoc,
      Iso.inv_hom_id, Category.comp_id]
  rw [← hhomTop, ← Proj.basicOpenIsoSpec_inv_ι 𝒜 f f_deg hm,
    Scheme.Hom.comp_appTop, Category.assoc]
  rw [show Proj.basicOpenToSpec 𝒜 f =
    (Proj.basicOpenIsoSpec 𝒜 f f_deg hm).hom from rfl]
  rw [← Category.assoc ((Proj.basicOpenIsoSpec 𝒜 f f_deg hm).inv.appTop)]
  rw [show (Proj.basicOpenIsoSpec 𝒜 f f_deg hm).inv.appTop ≫
      (Proj.basicOpenIsoSpec 𝒜 f f_deg hm).hom.appTop = 𝟙 _ from by
    rw [← Scheme.Hom.comp_appTop, Iso.hom_inv_id]
    simp]
  rw [Category.id_comp, Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
  refine ((Proj 𝒜).presheaf.map_comp _ _).symm.trans
    (congrArg ((Proj 𝒜).presheaf.map) ?_)
  exact Quiver.Hom.unop_inj (Subsingleton.elim _ _)

/-- The composite from `k` to the sections on a positive basic open `D₊(f)`, then to `A⁰_(f)`,
is the canonical map on constants (adapted from Codex's `projectiveStructureSectionSquare`). -/
theorem projectiveStructureSectionSquare {m : ℕ} (f : A) (f_deg : f ∈ 𝒜 m) (hm : 0 < m) :
    (Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (structureMap 𝒜).appTop ≫
      (Proj 𝒜).presheaf.map (homOfLE le_top).op ≫
      (Proj.basicOpenIsoAway 𝒜 f f_deg hm).inv =
    CommRingCat.ofHom
      ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f)).comp (zeroConst 𝒜)) := by
  have hbridge := projectiveAwayPullbackSquare 𝒜 f f_deg hm
  have hscheme : Proj.awayι 𝒜 f f_deg hm ≫ structureMap 𝒜 =
      Spec.map (CommRingCat.ofHom
        ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f)).comp
          (zeroConst 𝒜))) := by
    rw [structureMap, ← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp]
  have hΓ := congrArg Scheme.Hom.appTop hscheme
  rw [Scheme.Hom.comp_appTop] at hΓ
  calc
    (Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (structureMap 𝒜).appTop ≫
          (Proj 𝒜).presheaf.map (homOfLE le_top).op ≫
          (Proj.basicOpenIsoAway 𝒜 f f_deg hm).inv =
        (Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          ((structureMap 𝒜).appTop ≫ (Proj.awayι 𝒜 f f_deg hm).appTop) ≫
          (Scheme.ΓSpecIso
            (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).hom := by
      rw [← hbridge]
      simp only [Category.assoc]
    _ = (Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          (Spec.map (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f)).comp
              (zeroConst 𝒜)))).appTop ≫
          (Scheme.ΓSpecIso
            (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).hom := by
      rw [hΓ]
    _ = _ := by
      rw [Scheme.ΓSpecIso_naturality, ← Category.assoc, Iso.inv_hom_id,
        Category.id_comp]

/-- The constant `c / 1 ∈ A⁰_(f)` is the scalar `c` of the `k`-algebra `Γ(D₊(f))` for the structure
morphism `Proj 𝒜 → Spec k`. -/
theorem awayToSection_fromZero {m : ℕ} (f : A) (f_deg : f ∈ 𝒜 m) (hm : 0 < m) (c : k) :
    Proj.awayToSection 𝒜 f (fromZeroRingHom 𝒜 (Submonoid.powers f) (zeroConst 𝒜 c)) =
      (structureMap 𝒜).appLE ⊤ (Proj.basicOpen 𝒜 f) le_top
        ((Scheme.ΓSpecIso (CommRingCat.of k)).inv c) := by
  have h := congrArg (fun φ => φ.hom c) (projectiveStructureSectionSquare 𝒜 f f_deg hm)
  simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply,
    CommRingCat.hom_ofHom] at h
  rw [← h]
  change (Proj.basicOpenIsoAway 𝒜 f f_deg hm).hom ((Proj.basicOpenIsoAway 𝒜 f f_deg hm).inv _) = _
  rw [← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply]
  rfl

/-! ### The generic stalk map -/

variable {Y : Scheme.{u}} [IsIntegral Y] (ψ : Y ⟶ Proj 𝒜)

/-- The homogeneous prime `𝔭` of the image `ψ(η_Y)` of the generic point. -/
abbrev genPrime : Ideal A :=
  (ψ (genericPoint Y)).asHomogeneousIdeal.toIdeal

instance isPrime_genPrime : (genPrime 𝒜 ψ).IsPrime :=
  (ψ (genericPoint Y)).isPrime

/-- The generic stalk map `A⁰_𝔭 = 𝒪_{Proj 𝒜, ψ(η_Y)} → k(Y)`. -/
def genMap : AtPrime 𝒜 (genPrime 𝒜 ψ) →+* Y.functionField :=
  (ψ.stalkMap (genericPoint Y)).hom.comp (Proj.stalkIso 𝒜 (ψ (genericPoint Y))).inv.hom

instance isLocalHom_genMap : IsLocalHom (genMap 𝒜 ψ) := by
  have : IsLocalHom (Proj.stalkIso 𝒜 (ψ (genericPoint Y))).inv.hom :=
    ⟨fun a ha => by
      have h := ha.map (Proj.stalkIso 𝒜 (ψ (genericPoint Y))).hom.hom
      rwa [← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply] at h⟩
  exact RingHom.isLocalHom_comp _ _

theorem genericPoint_mem_preimage_basicOpen {f : A} (hfP : f ∉ genPrime 𝒜 ψ) :
    genericPoint Y ∈ ψ ⁻¹ᵁ Proj.basicOpen 𝒜 f :=
  hfP

set_option backward.isDefEq.respectTransparency false in
/-- **Pull-backs of sections of `D₊(f)` to `k(Y)`.** -/
theorem germ_app_awayToSection {f : A} (hfP : f ∉ genPrime 𝒜 ψ) (s : Away 𝒜 f) :
    Y.presheaf.germ (ψ ⁻¹ᵁ Proj.basicOpen 𝒜 f) (genericPoint Y)
        (genericPoint_mem_preimage_basicOpen 𝒜 ψ hfP)
        (ψ.app (Proj.basicOpen 𝒜 f) (Proj.awayToSection 𝒜 f s)) =
      genMap 𝒜 ψ (mapId 𝒜 (Submonoid.powers_le.mpr hfP) s) := by
  rw [← Scheme.Hom.germ_stalkMap_apply]
  have h := congrArg (fun φ => φ.hom s)
    (ProjectiveSpectrum.Proj.awayToSection_germ 𝒜 f (ψ (genericPoint Y)) hfP)
  simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply,
    CommRingCat.hom_ofHom] at h
  exact congrArg (ψ.stalkMap (genericPoint Y)) h

/-! ### Homogeneous fractions -/

variable {𝒜} in
/-- The homogeneous fraction `a / b ∈ A⁰_𝔭` (`a, b ∈ 𝒜_d`, `b ∉ 𝔭`). -/
def frac (P : Ideal A) [P.IsPrime] {d : ℕ} {a b : A} (ha : a ∈ 𝒜 d) (hb : b ∈ 𝒜 d)
    (hbP : b ∉ P) : AtPrime 𝒜 P :=
  HomogeneousLocalization.mk ⟨d, ⟨a, ha⟩, ⟨b, hb⟩, hbP⟩

variable {𝒜}

omit [GradedAlgebra 𝒜] in
theorem val_frac (P : Ideal A) [P.IsPrime] {d : ℕ} {a b : A} (ha : a ∈ 𝒜 d) (hb : b ∈ 𝒜 d)
    (hbP : b ∉ P) : (frac P ha hb hbP).val = Localization.mk a ⟨b, hbP⟩ :=
  rfl

theorem frac_mul_frac (P : Ideal A) [P.IsPrime] {d : ℕ} {a b c : A} (ha : a ∈ 𝒜 d)
    (hb : b ∈ 𝒜 d) (hc : c ∈ 𝒜 d) (hbP : b ∉ P) (hcP : c ∉ P) :
    frac P ha hb hbP * frac P hb hc hcP = frac P ha hc hcP := by
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul, val_frac, val_frac, val_frac, Localization.mk_mul,
    Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  exact ⟨1, by simp only [Submonoid.coe_mul]; ring⟩

theorem isUnit_frac (P : Ideal A) [P.IsPrime] {d : ℕ} {a b : A} (ha : a ∈ 𝒜 d)
    (hb : b ∈ 𝒜 d) (haP : a ∉ P) (hbP : b ∉ P) : IsUnit (frac P ha hb hbP) := by
  refine IsUnit.of_mul_eq_one (frac P hb ha haP) ?_
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul, val_frac, val_frac, HomogeneousLocalization.val_one,
    Localization.mk_mul, ← Localization.mk_one, Localization.mk_eq_mk_iff,
    Localization.r_iff_exists]
  exact ⟨1, by simp only [Submonoid.coe_mul, Submonoid.coe_one]; ring⟩

theorem notMem_of_isUnit_frac (P : Ideal A) [P.IsPrime] {d : ℕ} {a b : A} (ha : a ∈ 𝒜 d)
    (hb : b ∈ 𝒜 d) (hbP : b ∉ P) (h : IsUnit (frac P ha hb hbP)) : a ∉ P := by
  rw [← HomogeneousLocalization.isUnit_iff_isUnit_val, val_frac, Localization.mk_eq_mk',
    IsLocalization.AtPrime.isUnit_mk'_iff] at h
  exact h

variable (𝒜)

/-- The image of `a / b` in `k(Y)` is nonzero iff `a ∉ 𝔭`. -/
theorem genMap_frac_ne_zero_iff {d : ℕ} {a b : A} (ha : a ∈ 𝒜 d) (hb : b ∈ 𝒜 d)
    (hbP : b ∉ genPrime 𝒜 ψ) :
    genMap 𝒜 ψ (frac (genPrime 𝒜 ψ) ha hb hbP) ≠ 0 ↔ a ∉ genPrime 𝒜 ψ := by
  constructor
  · intro h
    exact notMem_of_isUnit_frac _ ha hb hbP
      ((isUnit_map_iff (genMap 𝒜 ψ) _).1 (Ne.isUnit h))
  · intro haP
    exact ((isUnit_frac _ ha hb haP hbP).map (genMap 𝒜 ψ)).ne_zero

/-- `a / b = (a / c) / (b / c)` in `k(Y)`. -/
theorem genMap_frac_eq_div {d : ℕ} {a b c : A} (ha : a ∈ 𝒜 d) (hb : b ∈ 𝒜 d) (hc : c ∈ 𝒜 d)
    (hbP : b ∉ genPrime 𝒜 ψ) (hcP : c ∉ genPrime 𝒜 ψ) :
    genMap 𝒜 ψ (frac _ ha hb hbP) =
      genMap 𝒜 ψ (frac _ ha hc hcP) /
        genMap 𝒜 ψ (frac _ hb hc hcP) := by
  rw [eq_div_iff ((genMap_frac_ne_zero_iff 𝒜 ψ hb hc hcP).2 hbP), ← map_mul,
    frac_mul_frac]

/-- `a / a = 1` in `k(Y)`. -/
theorem genMap_frac_self {d : ℕ} {a : A} (ha : a ∈ 𝒜 d) (haP : a ∉ genPrime 𝒜 ψ) :
    genMap 𝒜 ψ (frac _ ha ha haP) = 1 := by
  have h : frac (genPrime 𝒜 ψ) ha ha haP = 1 := by
    apply HomogeneousLocalization.val_injective
    rw [val_frac, HomogeneousLocalization.val_one, ← Localization.mk_one,
      Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp only [Submonoid.coe_one]; ring⟩
  rw [h, map_one]

theorem mapId_away_mk {f : A} {d : ℕ} (hfP : f ∉ genPrime 𝒜 ψ) (hf : f ∈ 𝒜 d) (n : ℕ) {a : A}
    (ha : a ∈ 𝒜 (n • d)) :
    mapId 𝒜 (Submonoid.powers_le.mpr hfP) (Away.mk 𝒜 hf n a ha) =
      frac (genPrime 𝒜 ψ) ha (SetLike.pow_mem_graded n hf)
        (fun h => hfP (Ideal.IsPrime.mem_of_pow_mem inferInstance n h)) := by
  apply HomogeneousLocalization.val_injective
  rfl

/-- If `A` is generated over `k` by `v`, it is generated over `𝒜₀` by `v`. -/
theorem adjoin_zero_eq_top {ι : Type*} (v : ι → A) (hgen : Algebra.adjoin k (Set.range v) = ⊤) :
    Algebra.adjoin (𝒜 0) (Set.range v) = ⊤ := by
  rw [eq_top_iff]
  rintro a -
  have ha : a ∈ Algebra.adjoin k (Set.range v) := hgen ▸ Algebra.mem_top
  induction ha using Algebra.adjoin_induction with
  | mem x hx => exact Algebra.subset_adjoin hx
  | algebraMap c => exact (Algebra.adjoin (𝒜 0) (Set.range v)).algebraMap_mem (zeroConst 𝒜 c)
  | add x y _ _ hx hy => exact add_mem hx hy
  | mul x y _ _ hx hy => exact mul_mem hx hy

/-- Some generator `v_i` of degree `1` is not in `𝔭`. -/
theorem exists_notMem_genPrime {ι : Type*} (v : ι → A) (hv : ∀ i, v i ∈ 𝒜 1)
    (hgen : Algebra.adjoin k (Set.range v) = ⊤) : ∃ i, v i ∉ genPrime 𝒜 ψ := by
  have h := Proj.iSup_basicOpen_eq_top' 𝒜 v (fun i => ⟨1, hv i⟩) (adjoin_zero_eq_top 𝒜 v hgen)
  have hx : ψ (genericPoint Y) ∈ (⨆ i, Proj.basicOpen 𝒜 (v i)) := h ▸ trivial
  obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  exact ⟨i, hi⟩

/-! ### Constants and the image of `Γ(D₊(f))` -/

set_option backward.isDefEq.respectTransparency false in
/-- **Constants.** If `ψ` is a morphism over `k`, `genMap` sends the constant `c / 1` to `c`. -/
theorem genMap_fromZero (pY : Y ⟶ Spec (.of k)) (hψ : ψ ≫ structureMap 𝒜 = pY)
    {f : A} {m : ℕ} (hf : f ∈ 𝒜 m) (hm : 0 < m) (hfP : f ∉ genPrime 𝒜 ψ) (c : k) :
    letI := pY.stalkAlgebra (genericPoint Y)
    genMap 𝒜 ψ (fromZeroRingHom 𝒜 _ (zeroConst 𝒜 c)) = algebraMap k Y.functionField c := by
  subst hψ
  have e1 : fromZeroRingHom 𝒜 (genPrime 𝒜 ψ).primeCompl (zeroConst 𝒜 c) =
      mapId 𝒜 (Submonoid.powers_le.mpr hfP)
        (fromZeroRingHom 𝒜 (Submonoid.powers f) (zeroConst 𝒜 c)) := by
    apply HomogeneousLocalization.val_injective
    rfl
  rw [e1, ← germ_app_awayToSection 𝒜 ψ hfP, awayToSection_fromZero 𝒜 f hf hm c,
    Scheme.Hom.algebraMap_stalkAlgebra]
  have key : (structureMap 𝒜).appLE ⊤ (Proj.basicOpen 𝒜 f) le_top ≫
      ψ.app (Proj.basicOpen 𝒜 f) ≫ Y.presheaf.germ (ψ ⁻¹ᵁ Proj.basicOpen 𝒜 f) (genericPoint Y)
        (genericPoint_mem_preimage_basicOpen 𝒜 ψ hfP) =
      (ψ ≫ structureMap 𝒜).app ⊤ ≫ Y.presheaf.germ ((ψ ≫ structureMap 𝒜) ⁻¹ᵁ ⊤)
        (genericPoint Y) trivial := by
    simp only [Scheme.Hom.appLE, Scheme.Hom.comp_app, Category.assoc]
    rw [Scheme.Hom.naturality_assoc]
    simp
  have := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (CommRingCat.of k)).inv c)) key
  simpa using this

/-- The ring map `Γ(D₊(f)) → k(Y)`: pull back by `ψ`, then take the germ at the generic point. -/
def pullGerm {f : A} (hfP : f ∉ genPrime 𝒜 ψ) :
    Γ(Proj 𝒜, Proj.basicOpen 𝒜 f) →+* Y.functionField :=
  (ψ.app (Proj.basicOpen 𝒜 f) ≫ Y.presheaf.germ (ψ ⁻¹ᵁ Proj.basicOpen 𝒜 f) (genericPoint Y)
    (genericPoint_mem_preimage_basicOpen 𝒜 ψ hfP)).hom

theorem pullGerm_awayToSection {f : A} (hfP : f ∉ genPrime 𝒜 ψ) (s : Away 𝒜 f) :
    pullGerm 𝒜 ψ hfP (Proj.awayToSection 𝒜 f s) =
      genMap 𝒜 ψ (mapId 𝒜 (Submonoid.powers_le.mpr hfP) s) :=
  germ_app_awayToSection 𝒜 ψ hfP s

/-- `x^β / f^{|β|} = ∏ (x_i / f)^{β_i}` for elements `x_i, f` of degree `1`. -/
theorem frac_prod_pow (P : Ideal A) [P.IsPrime] {n : ℕ} (v : Fin (n + 1) → A)
    (hv : ∀ i, v i ∈ 𝒜 1) {f : A} (hf : f ∈ 𝒜 1) (hfP : f ∉ P) (a : ℕ) (ai : Fin (n + 1) → ℕ)
    (hai : ∑ i, ai i • 1 = a • 1) (hmem : ∏ i, v i ^ ai i ∈ 𝒜 (a • 1)) :
    frac P hmem (SetLike.pow_mem_graded a hf)
        (fun h => hfP (Ideal.IsPrime.mem_of_pow_mem inferInstance a h)) =
      ∏ i, frac P (hv i) hf hfP ^ ai i := by
  apply HomogeneousLocalization.val_injective
  have ha : a = ∑ i, ai i := by simpa using hai.symm
  change _ = algebraMap (AtPrime 𝒜 P) (Localization P.primeCompl) _
  rw [map_prod]
  simp only [map_pow, HomogeneousLocalization.algebraMap_apply, val_frac, Localization.mk_pow,
    Localization.mk_prod]
  congr 1
  apply Subtype.ext
  simp only [SubmonoidClass.coe_pow, Finset.prod_pow_eq_pow_sum, ← ha]

/-- **The image of `Γ(D₊(f))` in `k(Y)`.** If `A` is generated over `k` by `v_0, …, v_n ∈ 𝒜₁`,
`𝒜₀ = k` and `f ∈ 𝒜₁ \ 𝔭`, the pull-backs to `k(Y)` of the sections over `D₊(f)` form the
`k`-subalgebra generated by the images of the ratios `v_i / f`. -/
theorem range_pullGerm_eq_adjoin (pY : Y ⟶ Spec (.of k)) (hψ : ψ ≫ structureMap 𝒜 = pY)
    {n : ℕ} (v : Fin (n + 1) → A) (hv : ∀ i, v i ∈ 𝒜 1)
    (hgen : Algebra.adjoin k (Set.range v) = ⊤) (h0 : ∀ a ∈ 𝒜 0, ∃ c : k, algebraMap k A c = a)
    {f : A} (hf : f ∈ 𝒜 1) (hfP : f ∉ genPrime 𝒜 ψ) :
    letI := pY.stalkAlgebra (genericPoint Y)
    Set.range (pullGerm 𝒜 ψ hfP) =
      Algebra.adjoin k (Set.range fun i => genMap 𝒜 ψ (frac (genPrime 𝒜 ψ) (hv i) hf hfP)) := by
  let := pY.stalkAlgebra (genericPoint Y)
  have hconst : ∀ c : k, genMap 𝒜 ψ (fromZeroRingHom 𝒜 _ (zeroConst 𝒜 c)) ∈
      Algebra.adjoin k (Set.range fun i => genMap 𝒜 ψ (frac (genPrime 𝒜 ψ) (hv i) hf hfP)) :=
    fun c => by
      rw [genMap_fromZero 𝒜 ψ pY hψ hf one_pos hfP c]
      exact Subalgebra.algebraMap_mem _ c
  apply le_antisymm
  · rintro _ ⟨s, rfl⟩
    obtain ⟨s, rfl⟩ := (Proj.basicOpenIsoAway 𝒜 f hf one_pos).commRingCatIsoToRingEquiv.surjective s
    change pullGerm 𝒜 ψ hfP (Proj.awayToSection 𝒜 f s) ∈
      Algebra.adjoin k (Set.range fun i => genMap 𝒜 ψ (frac (genPrime 𝒜 ψ) (hv i) hf hfP))
    rw [pullGerm_awayToSection]
    have hx : Algebra.adjoin (𝒜 0) (Set.range v) = ⊤ := adjoin_zero_eq_top 𝒜 v hgen
    have hs : s ∈ Submodule.span (𝒜 0) _ :=
      (Away.span_mk_prod_pow_eq_top hf v hx (fun _ => 1) hv).symm ▸ Submodule.mem_top
    induction hs using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, ai, hai, rfl⟩ := hx
      rw [mapId_away_mk 𝒜 ψ hfP hf, frac_prod_pow 𝒜 _ v hv hf hfP a ai hai, map_prod]
      simp only [map_pow]
      refine prod_mem fun i _ => pow_mem (Algebra.subset_adjoin ?_) _
      exact ⟨i, rfl⟩
    | zero => rw [map_zero, map_zero]; exact zero_mem _
    | add x y _ _ hx hy => rw [map_add, map_add]; exact add_mem hx hy
    | smul r x _ hx =>
      obtain ⟨c, hc⟩ := h0 r r.2
      have hr : r = zeroConst 𝒜 c := Subtype.ext hc.symm
      rw [Algebra.smul_def, map_mul, map_mul, hr, HomogeneousLocalization.algebraMap_eq]
      have e : mapId 𝒜 (Submonoid.powers_le.mpr (show f ∈ (genPrime 𝒜 ψ).primeCompl from hfP))
          (fromZeroRingHom 𝒜 (Submonoid.powers f) (zeroConst 𝒜 c)) =
          fromZeroRingHom 𝒜 (genPrime 𝒜 ψ).primeCompl (zeroConst 𝒜 c) := by
        apply HomogeneousLocalization.val_injective
        rfl
      rw [e]
      exact mul_mem (hconst c) hx
  · intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      refine ⟨Proj.awayToSection 𝒜 f (Away.mk 𝒜 hf 1 (v i) (by simpa using hv i)), ?_⟩
      rw [pullGerm_awayToSection, mapId_away_mk 𝒜 ψ hfP hf]
      congr 1
      apply HomogeneousLocalization.val_injective
      simp only [val_frac, pow_one]
    | algebraMap c =>
      rw [← genMap_fromZero 𝒜 ψ pY hψ hf one_pos hfP c]
      refine ⟨Proj.awayToSection 𝒜 f (fromZeroRingHom 𝒜 _ (zeroConst 𝒜 c)), ?_⟩
      rw [pullGerm_awayToSection]
      exact congrArg (genMap 𝒜 ψ) (HomogeneousLocalization.val_injective _ rfl)
    | add x y _ _ hx hy =>
      obtain ⟨a, rfl⟩ := hx
      obtain ⟨b, rfl⟩ := hy
      exact ⟨a + b, map_add _ _ _⟩
    | mul x y _ _ hx hy =>
      obtain ⟨a, rfl⟩ := hx
      obtain ⟨b, rfl⟩ := hy
      exact ⟨a * b, map_mul _ _ _⟩

/-- **Homogeneous polynomials in the ratios.** For a homogeneous `G` of degree `d`,
`G(v) / f^d = G(v_0 / f, …, v_n / f)` in `A⁰_𝔭`. -/
theorem frac_aeval (P : Ideal A) [P.IsPrime] {n : ℕ} (v : Fin (n + 1) → A)
    (hv : ∀ i, v i ∈ 𝒜 1) {f : A} (hf : f ∈ 𝒜 1) (hfP : f ∉ P) {d : ℕ}
    {G : MvPolynomial (Fin (n + 1)) k} (hG : G.IsHomogeneous d)
    (hGm : MvPolynomial.aeval v G ∈ 𝒜 d) (hfd : f ^ d ∈ 𝒜 d) (hfdP : f ^ d ∉ P) :
    frac P hGm hfd hfdP = MvPolynomial.eval₂ ((fromZeroRingHom 𝒜 P.primeCompl).comp
      (zeroConst 𝒜)) (fun i => frac P (hv i) hf hfP) G := by
  apply HomogeneousLocalization.val_injective
  change _ = algebraMap (AtPrime 𝒜 P) (Localization P.primeCompl) _
  rw [MvPolynomial.eval₂_comp_left]
  set u : Localization P.primeCompl := Localization.mk 1 ⟨f, hfP⟩
  have hr : (algebraMap (AtPrime 𝒜 P) (Localization P.primeCompl)) ∘ (fun i => frac P (hv i) hf hfP)
      = fun i => algebraMap A (Localization P.primeCompl) (v i) * u := by
    funext i
    simp only [Function.comp_apply, HomogeneousLocalization.algebraMap_apply, val_frac, u,
      ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, mul_one, one_mul]
  have hc : (algebraMap (AtPrime 𝒜 P) (Localization P.primeCompl)).comp
      ((fromZeroRingHom 𝒜 P.primeCompl).comp (zeroConst 𝒜)) =
      (algebraMap A (Localization P.primeCompl)).comp (algebraMap k A) := by
    ext c
    simp only [RingHom.coe_comp, Function.comp_apply, HomogeneousLocalization.algebraMap_apply]
    rw [← Localization.mk_one_eq_algebraMap]
    rfl
  rw [hr, hc, eval₂_mul_of_isHomogeneous _ _ _ hG,
    show (fun i => algebraMap A (Localization P.primeCompl) (v i)) =
      ⇑(algebraMap A (Localization P.primeCompl)) ∘ v from rfl,
    ← MvPolynomial.eval₂_comp_left, val_frac]
  rw [show MvPolynomial.eval₂ (algebraMap k A) v G = MvPolynomial.aeval v G from rfl]
  simp only [u, Localization.mk_pow, ← Localization.mk_one_eq_algebraMap, Localization.mk_mul,
    one_pow, one_mul, mul_one]
  congr 1

/-- **Homogeneous polynomials in the ratios, in `k(Y)`.** -/
theorem genMap_frac_aeval (pY : Y ⟶ Spec (.of k)) (hψ : ψ ≫ structureMap 𝒜 = pY)
    {n : ℕ} (v : Fin (n + 1) → A) (hv : ∀ i, v i ∈ 𝒜 1) {f : A} (hf : f ∈ 𝒜 1)
    (hfP : f ∉ genPrime 𝒜 ψ) {d : ℕ} {G : MvPolynomial (Fin (n + 1)) k}
    (hG : G.IsHomogeneous d) (hGm : MvPolynomial.aeval v G ∈ 𝒜 d) (hfd : f ^ d ∈ 𝒜 d)
    (hfdP : f ^ d ∉ genPrime 𝒜 ψ) :
    letI := pY.stalkAlgebra (genericPoint Y)
    genMap 𝒜 ψ (frac (genPrime 𝒜 ψ) hGm hfd hfdP) =
      MvPolynomial.aeval (fun i => genMap 𝒜 ψ (frac (genPrime 𝒜 ψ) (hv i) hf hfP)) G := by
  let := pY.stalkAlgebra (genericPoint Y)
  rw [frac_aeval 𝒜 _ v hv hf hfP hG hGm hfd hfdP, MvPolynomial.eval₂_comp_left]
  have hc : (genMap 𝒜 ψ).comp ((fromZeroRingHom 𝒜 (genPrime 𝒜 ψ).primeCompl).comp
      (zeroConst 𝒜)) = algebraMap k Y.functionField := by
    ext c
    exact genMap_fromZero 𝒜 ψ pY hψ hf one_pos hfP c
  rw [hc]
  rfl


end DeJongEPBridge.ProjChart
