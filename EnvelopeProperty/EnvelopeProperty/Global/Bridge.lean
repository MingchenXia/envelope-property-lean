/-!
# Bridges between models and projective subvarieties; smooth models

This file implements the point-level part of the blueprint remark `rmk:gl-bridges` and the
definition `def:gl-smooth` of `global.tex` (subsection `subsec:gl-model`) for the formalization of
Fang–Han–Xia, *The envelope property for unibranch projective varieties* (revision `832e086`).

## Rank-1 models generated in degree 1 (`rmk:gl-bridges`)

Let `𝒳 = (K, S, z)` be a model of rank `1` and `w_0, …, w_N ∈ S_1` with `S = k[w_0 T, …, w_N T]`
(`MultiModel.DegOnePres`, a presentation in degree `1`). The presentation
`k[x_0, …, x_N] → S`, `x_i ↦ w_i T` (`DegOnePres.hom`) is graded
(`DegOnePres.hom_homogeneousComponent`), so its kernel `I` (`DegOnePres.ideal`) is a homogeneous
prime ideal, relevant since some `w_i ≠ 0` (`DegOnePres.exists_w_ne_zero`): this is the
`ProjSubvariety` `X = V(I) ⊆ ℙ^N` (`DegOnePres.toProjSubvariety`, the quotient model of the kernel
in the blueprint).

* `DegOnePres.recoord`: the model `(K, S, w)` with the coordinates `w` instead of `z`. The
  coordinates `z ⊆ S_1` and `w` are mutually integral in degree `1`, so by change of model
  (`lem:gl-model-change`, here with `S' = S`) restriction is a homeomorphism
  `(K, S, w)^an ≃ₜ 𝒳^an` (`DegOnePres.recoordHomeomorph`), with the same sections, values, psh
  functions and envelope property (`DegOnePres.sections_recoord`,
  `DegOnePres.secAbs_recoordHomeomorph`, `DegOnePres.isPSH_recoord_iff`,
  `DegOnePres.hasEnvelopeProperty_recoord_iff`).
* `DegOnePres.projHomeomorph : X^an ≃ₜ (K, S, w)^an`: a graded normalized seminorm on
  `k[x_0, …, x_N]` vanishing on `I` is a multigraded seminorm on `S ≅ k[x] / I` normalized for `w`,
  and conversely (`DegOnePres.toProj`, `DegOnePres.ofProj`).
* `DegOnePres.anHomeomorph : X^an ≃ₜ 𝒳^an`, with `|F|_u = |F(w T)|_{u'}` for all `F ∈ k[x]`
  (`DegOnePres.anHomeomorph_val`), mapping `⋆` to `⋆` (`DegOnePres.anHomeomorph_triv`).
* The charts: for `w_i ≠ 0`, the quotient chart algebra `A_{x_i} / I_{(x_i)}` of `X`
  (`ProjBerk.QuotChartAlg`) is `k`-isomorphic to the chart algebra of `(K, S, w)` at `w_i`
  (`DegOnePres.quotChartAlgEquiv`), by `ProjBerk.quotChartEquiv`.

**Not formalized**: "the sections and psh functions are those of `V(I) ⊆ ℙ^N`". The sections
`R_d(𝒳) = {f : f w^β ∈ S_{d+b}, β ∈ Mon(b)}` of `def:gl-sections` may be larger than the image
`S_d` of the forms of degree `d` (they are the sections of `𝒪(d)` on `Proj S`), so the
Fubini–Study families differ; the comparison of psh classes needs that every `f ∈ R_d` has
`f^n` with admissible degree bounded in `n` (e.g. `f T^d` integral over `S`, by the determinant
trick for `d ≥ 0`). This is now `lem:gl-bridge-psh` in the blueprint; for models generated by
their coordinates, `MultiModel.IsAdmissible.pow_of_eq_coordAlg` (`Global/BlowupBridgePSH`) shows
that one admissible degree works for all powers. The homeomorphism and its value formula are the
inputs.

## Rank-2 models (`rmk:gl-bridges`)

The point-level bridge for rank-2 models generated by their coordinates and for blowup models
(`MultiModel.biAnHomeomorph`, `MultiModel.blowupAnHomeomorph`) is in
`EnvelopeProperty.Global.BlowupBridge`. This file imports all modules of lane G3.

## Smooth models (`def:gl-smooth`)

`MultiModel.IsSmooth`: every chart algebra `A_j` (`lem:gl-charts`, chart indices with all
`f^{(c)}_{j_c} ≠ 0`) is a smooth `k`-algebra **and** integrally closed (decision D-M2: normality of
smooth algebras is not in Mathlib v4.33.1; regular implies normal, so this is no restriction).
-/

open scoped NNReal ENNReal Topology

open Topology MvPolynomial

noncomputable section

namespace EnvelopeProperty

open ProjBerk

universe u

namespace MultiModel

variable {k : Type u} [Field k] {K : Type u} [Field K] [Algebra k K]

/-! ### Smooth models -/

/-- A model is **smooth** (`def:gl-smooth`, decision D-M2) if every chart algebra `A_j` (for the
chart indices with all `f^{(c)}_{j_c} ≠ 0`) is a smooth `k`-algebra and integrally closed. -/
def IsSmooth {r : ℕ} (X : MultiModel k K r) : Prop :=
  ∀ j : X.ChartIndex, (∀ c, X.coord c (j c) ≠ 0) →
    Algebra.Smooth k (X.chartAlg j) ∧ IsIntegrallyClosed (X.chartAlg j)

theorem IsSmooth.smooth {r : ℕ} {X : MultiModel k K r} (hX : X.IsSmooth) {j : X.ChartIndex}
    (hj : ∀ c, X.coord c (j c) ≠ 0) : Algebra.Smooth k (X.chartAlg j) :=
  (hX j hj).1

theorem IsSmooth.isIntegrallyClosed {r : ℕ} {X : MultiModel k K r} (hX : X.IsSmooth)
    {j : X.ChartIndex} (hj : ∀ c, X.coord c (j c) ≠ 0) : IsIntegrallyClosed (X.chartAlg j) :=
  (hX j hj).2

/-- A normal model has integrally closed chart algebras, so it is smooth iff its charts are
smooth. -/
theorem isSmooth_iff_of_isNormal {r : ℕ} {X : MultiModel k K r} (hX : X.IsNormal) :
    X.IsSmooth ↔ ∀ j : X.ChartIndex, (∀ c, X.coord c (j c) ≠ 0) → Algebra.Smooth k (X.chartAlg j) :=
  ⟨fun h _ hj => h.smooth hj, fun h j hj => ⟨h j hj, isIntegrallyClosed_chartAlg hj hX⟩⟩

/-! ### Rank-1 models generated in degree 1 -/

/-- A **presentation in degree `1`** of a rank-1 model: elements `w_0, …, w_N ∈ S_1` such that
`S = k[w_0 T, …, w_N T]`. -/
structure DegOnePres (X : MultiModel k K 1) (N : ℕ) where
  /-- The generators `w_i ∈ S_1`. -/
  w : Fin (N + 1) → K
  mem : ∀ i, w i ∈ X.piece (Finsupp.single 0 1)
  adjoin_eq : Algebra.adjoin k (Set.range fun i => monomial (Finsupp.single 0 1) (w i)) = X.S

namespace DegOnePres

variable {X : MultiModel k K 1} {N : ℕ} (P : DegOnePres X N)

/-- The generator `w_i T ∈ S`. -/
def gen (i : Fin (N + 1)) : MvPolynomial (Fin 1) K :=
  monomial (Finsupp.single 0 1) (P.w i)

/-- The presentation `k[x_0, …, x_N] → K[T]`, `x_i ↦ w_i T`. -/
def hom : MvPolynomial (Fin (N + 1)) k →ₐ[k] MvPolynomial (Fin 1) K :=
  aeval P.gen

theorem hom_X (i : Fin (N + 1)) : P.hom (MvPolynomial.X i) = P.gen i :=
  aeval_X _ _

theorem range_hom : P.hom.range = X.S := by
  rw [hom, ← Algebra.adjoin_range_eq_range_aeval]
  exact P.adjoin_eq

theorem hom_mem (F : MvPolynomial (Fin (N + 1)) k) : P.hom F ∈ X.S := by
  rw [← P.range_hom]
  exact ⟨F, rfl⟩

theorem prod_gen_pow (β : Fin (N + 1) →₀ ℕ) :
    (β.prod fun i n => P.gen i ^ n) =
      monomial (Finsupp.single 0 (Finsupp.degree β)) (β.prod fun i n => P.w i ^ n) := by
  induction β using Finsupp.induction with
  | zero => simp [← C_apply]
  | single_add i n β hi hn ih =>
    rw [Finsupp.prod_add_index' (fun _ => pow_zero _) fun _ _ _ => pow_add _ _ _, ih,
      Finsupp.prod_single_index (h := fun i n => P.gen i ^ n) (pow_zero _), gen, monomial_pow,
      monomial_mul, map_add, Finsupp.degree_single,
      Finsupp.prod_add_index' (fun _ => pow_zero _) fun _ _ _ => pow_add _ _ _,
      Finsupp.prod_single_index (h := fun i n => P.w i ^ n) (pow_zero _), Finsupp.smul_single,
      smul_eq_mul, mul_one, Finsupp.single_add]

/-- `F = c x^β ↦ (c w^β) T^{|β|}`. -/
theorem hom_monomial (β : Fin (N + 1) →₀ ℕ) (c : k) :
    P.hom (monomial β c) = monomial (Finsupp.single 0 (Finsupp.degree β))
      (algebraMap k K c * β.prod fun i n => P.w i ^ n) := by
  rw [hom, aeval_monomial, prod_gen_pow, MvPolynomial.algebraMap_apply, C_mul_monomial]

/-- **The presentation is graded**: the image of the homogeneous component of degree `d` of `F` is
the component of degree `d` of the image of `F`. -/
theorem hom_homogeneousComponent (d : ℕ) (F : MvPolynomial (Fin (N + 1)) k) :
    P.hom (homogeneousComponent d F) =
      monomial (Finsupp.single 0 d) ((P.hom F).coeff (Finsupp.single 0 d)) := by
  induction F using MvPolynomial.induction_on' with
  | monomial β c =>
    rw [homogeneousComponent_of_mem (isHomogeneous_monomial c rfl), hom_monomial, coeff_monomial]
    by_cases hd : d = Finsupp.degree β
    · rw [if_pos hd, if_pos (by rw [hd]), hom_monomial, hd]
    · rw [if_neg hd, if_neg fun h => hd (Finsupp.single_injective 0 h).symm, map_zero, map_zero]
  | add F G hF hG => rw [map_add, map_add, hF, hG, map_add, coeff_add, map_add]

/-- The presentation `k[x_0, …, x_N] → S` onto `S`. -/
def homS : MvPolynomial (Fin (N + 1)) k →ₐ[k] X.S :=
  P.hom.codRestrict X.S P.hom_mem

@[simp]
theorem coe_homS (F : MvPolynomial (Fin (N + 1)) k) :
    (P.homS F : MvPolynomial (Fin 1) K) = P.hom F :=
  rfl

theorem homS_surjective : Function.Surjective P.homS := by
  rintro ⟨p, hp⟩
  rw [← P.range_hom] at hp
  obtain ⟨F, rfl⟩ := hp
  exact ⟨F, rfl⟩

omit P in
/-- Every degree `a ∈ ℕ^1` is `single 0 (a 0)`. -/
theorem eq_single (a : Fin 1 →₀ ℕ) : a = Finsupp.single 0 (a 0) := by
  refine Finsupp.ext fun i => ?_
  rw [Fin.fin_one_eq_zero i, Finsupp.single_eq_same]

theorem homS_homogeneousComponent (d : ℕ) (F : MvPolynomial (Fin (N + 1)) k) :
    P.homS (homogeneousComponent d F) = X.homComp (Finsupp.single 0 d) (P.homS F) :=
  Subtype.ext (P.hom_homogeneousComponent d F)

theorem homComp_homS (a : Fin 1 →₀ ℕ) (F : MvPolynomial (Fin (N + 1)) k) :
    X.homComp a (P.homS F) = P.homS (homogeneousComponent (a 0) F) := by
  rw [P.homS_homogeneousComponent, ← eq_single a]

/-- The kernel `I` of the presentation. -/
def ideal : Ideal (MvPolynomial (Fin (N + 1)) k) :=
  RingHom.ker P.homS

theorem mem_ideal_iff {F : MvPolynomial (Fin (N + 1)) k} : F ∈ P.ideal ↔ P.hom F = 0 := by
  rw [ideal, RingHom.mem_ker]
  exact ⟨fun h => congrArg Subtype.val h, fun h => Subtype.ext h⟩

theorem isHomogeneousIdeal_ideal : IsHomogeneousIdeal P.ideal := by
  intro F hF d
  rw [mem_ideal_iff] at hF ⊢
  rw [hom_homogeneousComponent, hF, coeff_zero, map_zero]

instance isPrime_ideal : P.ideal.IsPrime :=
  RingHom.ker_isPrime _

/-- Some `w_i` is nonzero: otherwise `S` would consist of constants, but it contains a nonzero
coordinate of degree `1`. -/
theorem exists_w_ne_zero : ∃ i, P.w i ≠ 0 := by
  by_contra h
  push Not at h
  obtain ⟨j, hj⟩ := X.exists_coord_ne_zero 0
  have hz : X.coordMono ⟨0, j⟩ ∈ P.hom.range := by
    rw [P.range_hom]; exact X.coord_mem 0 j
  obtain ⟨F, hF⟩ := hz
  have hgen : P.gen = 0 := funext fun i => by rw [gen, h i, map_zero]; rfl
  have hhom : P.hom = aeval 0 := by rw [hom, hgen]
  change P.hom F = _ at hF
  rw [hhom, aeval_zero] at hF
  have h1 := congrArg (fun p : MvPolynomial (Fin 1) K => p.coeff (Finsupp.single 0 1)) hF
  simp only [MvPolynomial.algebraMap_apply, coeff_C, coordMono, coeff_monomial] at h1
  rw [if_neg (Finsupp.single_ne_zero.2 one_ne_zero).symm] at h1
  exact hj h1.symm

theorem X_notMem_ideal_iff (i : Fin (N + 1)) :
    (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) k) ∉ P.ideal ↔ P.w i ≠ 0 := by
  rw [mem_ideal_iff, hom_X, gen, Ne, monomial_eq_zero]

/-- **The projective subvariety `V(I) ⊆ ℙ^N`** of a presentation in degree `1`
(`rmk:gl-bridges`). -/
def toProjSubvariety : ProjSubvariety k N where
  ideal := P.ideal
  isHomogeneousIdeal := P.isHomogeneousIdeal_ideal
  isPrime := P.isPrime_ideal
  exists_X_notMem := by
    obtain ⟨i, hi⟩ := P.exists_w_ne_zero
    exact ⟨i, (P.X_notMem_ideal_iff i).2 hi⟩

@[simp]
theorem toProjSubvariety_ideal : P.toProjSubvariety.ideal = P.ideal :=
  rfl

/-! #### The model `(K, S, w)` -/

theorem range_coordMono_eq :
    Set.range (fun i : (Σ _ : Fin 1, Fin (N + 1)) =>
      monomial (Finsupp.single i.1 1) (P.w i.2)) =
      Set.range fun i => monomial (Finsupp.single 0 1) (P.w i) := by
  ext p
  constructor
  · rintro ⟨⟨c, i⟩, rfl⟩
    exact ⟨i, by rw [Fin.fin_one_eq_zero c]⟩
  · rintro ⟨i, rfl⟩
    exact ⟨⟨0, i⟩, rfl⟩

/-- The model `(K, S, w)`: the same ring `S` with the coordinates `w_0, …, w_N`. -/
abbrev recoord : MultiModel k K 1 :=
  X.withCoords (fun _ => N) (fun _ => P.w) (fun c j => by rw [Fin.fin_one_eq_zero c]; exact P.mem j)
    (fun _ => P.exists_w_ne_zero) fun p hp => by
      have hp' : p ∈ Algebra.adjoin k (Set.range (fun i : (Σ _ : Fin 1, Fin (N + 1)) =>
          monomial (Finsupp.single i.1 1) (P.w i.2))) := by
        rw [P.range_coordMono_eq, P.adjoin_eq]; exact hp
      exact isIntegral_algebraMap (x := (⟨p, hp'⟩ : Algebra.adjoin k _))

theorem recoord_S : P.recoord.S = X.S :=
  rfl

theorem recoord_coord (c : Fin 1) (j : Fin (N + 1)) : P.recoord.coord c j = P.w j :=
  rfl

theorem blockAlg_recoord (c : Fin 1) : P.recoord.blockAlg c = X.S := by
  rw [← P.adjoin_eq, Fin.fin_one_eq_zero c]

omit P in
theorem blockAlg_eq_coordAlg (Y : MultiModel k K 1) (c : Fin 1) :
    Y.blockAlg c = Algebra.adjoin k (Set.range fun i : Y.CoordIndex =>
      monomial (Finsupp.single i.1 1) (Y.coord i.1 i.2)) := by
  obtain rfl := Fin.fin_one_eq_zero c
  refine congrArg (Algebra.adjoin k) ?_
  ext p
  constructor
  · rintro ⟨j, rfl⟩
    exact ⟨⟨0, j⟩, rfl⟩
  · rintro ⟨⟨c, j⟩, rfl⟩
    obtain rfl := Fin.fin_one_eq_zero c
    exact ⟨j, rfl⟩

/-- `(K, S, w)` is a change of model of `𝒳` (`lem:gl-model-change` with `S' = S`): the coordinates
`z ⊆ S_1` and `w` are mutually integral in degree `1`. -/
theorem isModelChange : IsModelChange X P.recoord where
  le := le_rfl
  isIntegral p hp := isIntegral_algebraMap (x := (⟨p, hp⟩ : X.S))
  coord_isIntegral c j := by
    rw [blockAlg_eq_coordAlg X c]
    exact X.isIntegral _ (P.recoord.coord_mem c j)
  coord_isIntegral' c j := by
    have hmem : monomial (Finsupp.single c 1) (X.coord c j) ∈ P.recoord.blockAlg c := by
      rw [blockAlg_recoord]; exact X.coord_mem c j
    exact isIntegral_algebraMap (x := (⟨_, hmem⟩ : P.recoord.blockAlg c))

/-- **Change of coordinates** (`lem:gl-model-change`): `(K, S, w)^an ≃ₜ 𝒳^an` (restriction to
`S`, i.e. the identity on seminorms). -/
def recoordHomeomorph : P.recoord.an ≃ₜ X.an :=
  P.isModelChange.restrictHomeomorph (IsModelChange.hasSections_of_eq rfl)

theorem recoordHomeomorph_val (v : P.recoord.an) (p : X.S) :
    (P.recoordHomeomorph v).1.val p = v.1.val p :=
  rfl

/-- **Change of coordinates, sections** (`lem:gl-model-change`): `R_a((K, S, w)) = R_a(𝒳)`. -/
theorem sections_recoord (a : Fin 1 → ℤ) : P.recoord.sections a = X.sections a :=
  P.isModelChange.sections_eq (IsModelChange.hasSections_of_eq rfl) a

/-- Equal values of sections under `(K, S, w)^an ≃ₜ 𝒳^an`. -/
theorem secAbs_recoordHomeomorph (v : P.recoord.an) (a : Fin 1 → ℤ) (f : K) :
    P.recoord.secAbs v.1 a f = X.secAbs (P.recoordHomeomorph v).1 a f :=
  P.isModelChange.secAbs_restrictAn (IsModelChange.hasSections_of_eq rfl) v a f

/-- **Change of coordinates, psh functions** (`lem:gl-model-change`):
`PSH((K, S, w), θ) = PSH(𝒳, θ)` under `(K, S, w)^an ≃ₜ 𝒳^an`. -/
theorem isPSH_recoord_iff {θ : Fin 1 → ℝ} {u : X.an → EReal} :
    P.recoord.IsPSH θ (u ∘ P.recoordHomeomorph) ↔ X.IsPSH θ u :=
  P.isModelChange.isPSH_comp_iff (IsModelChange.hasSections_of_eq rfl)

/-- `EP_{(K, S, w)}(θ) ↔ EP_𝒳(θ)`. -/
theorem hasEnvelopeProperty_recoord_iff {θ : Fin 1 → ℝ} :
    P.recoord.HasEnvelopeProperty θ ↔ X.HasEnvelopeProperty θ :=
  P.isModelChange.hasEnvelopeProperty_iff (IsModelChange.hasSections_of_eq rfl)

/-! #### `(K, S, w)^an` and `V(I)^an` -/

theorem homS_X (i : Fin (N + 1)) : P.homS (MvPolynomial.X i) = P.recoord.coordElem ⟨0, i⟩ :=
  Subtype.ext (P.hom_X i)

/-- The point of `V(I)^an` given by a point of `(K, S, w)^an`: `|F| = |F(w T)|`. -/
def toProj (v : P.recoord.an) : P.toProjSubvariety.an :=
  ⟨⟨Berk.comap P.homS v.1, by
      rw [isGraded_iff]
      intro F d
      rw [Berk.comap_val_apply, Berk.comap_val_apply, P.homS_homogeneousComponent]
      exact v.2.1 _ _, by
      simp only [Berk.comap_val_apply, P.homS_X]
      exact v.2.2 0⟩,
    fun F hF => by
      change v.1.val (P.homS F) = 0
      rw [show P.homS F = 0 from (RingHom.mem_ker).1 hF, map_zero]⟩

theorem toProj_val (v : P.recoord.an) (F : MvPolynomial (Fin (N + 1)) k) :
    (P.toProj v).1.1.val F = v.1.val (P.homS F) :=
  rfl

theorem continuous_toProj : Continuous P.toProj :=
  ((((Berk.continuous_comap P.homS).comp continuous_subtype_val).subtype_mk _).subtype_mk _)

/-- The isomorphism `k[x] / I ≃ S`. -/
def quotEquiv : (MvPolynomial (Fin (N + 1)) k ⧸ P.ideal) ≃ₐ[k] X.S :=
  Ideal.quotientKerAlgEquivOfSurjective P.homS_surjective

theorem quotEquiv_symm_homS (F : MvPolynomial (Fin (N + 1)) k) :
    P.quotEquiv.symm (P.homS F) = Ideal.Quotient.mk P.ideal F :=
  Ideal.quotientKerAlgEquivOfSurjective_symm_apply P.homS_surjective F

/-- The seminorm on `S ≅ k[x] / I` given by a point of `V(I)^an`. -/
def ofProjBerk (u : P.toProjSubvariety.an) : Berk k X.S :=
  Berk.comap P.quotEquiv.symm.toAlgHom (Berk.ofQuot (J := P.ideal) u.1.1 u.2)

theorem ofProjBerk_val (u : P.toProjSubvariety.an) (F : MvPolynomial (Fin (N + 1)) k) :
    (P.ofProjBerk u).val (P.homS F) = u.1.1.val F := by
  rw [ofProjBerk, Berk.comap_val_apply]
  change (Berk.ofQuot (J := P.ideal) u.1.1 u.2).val (P.quotEquiv.symm (P.homS F)) = _
  rw [quotEquiv_symm_homS]
  rfl

/-- The point of `(K, S, w)^an` given by a point of `V(I)^an`. -/
def ofProj (u : P.toProjSubvariety.an) : P.recoord.an :=
  ⟨P.ofProjBerk u, fun p a => by
      obtain ⟨F, rfl⟩ := P.homS_surjective p
      change (P.ofProjBerk u).val (X.homComp a (P.homS F)) ≤ (P.ofProjBerk u).val (P.homS F)
      rw [P.homComp_homS, ofProjBerk_val, ofProjBerk_val]
      exact (isGraded_iff _).1 (u.1.isGraded) F (a 0), fun c => by
      obtain rfl := Fin.fin_one_eq_zero c
      change Finset.univ.sup (fun j : Fin (N + 1) =>
        (P.ofProjBerk u).val (P.recoord.coordElem ⟨0, j⟩)) = 1
      simp_rw [← P.homS_X, ofProjBerk_val]
      exact u.1.sup_val_X⟩

theorem ofProj_val (u : P.toProjSubvariety.an) (F : MvPolynomial (Fin (N + 1)) k) :
    (P.ofProj u).1.val (P.homS F) = u.1.1.val F :=
  P.ofProjBerk_val u F

theorem toProj_ofProj (u : P.toProjSubvariety.an) : P.toProj (P.ofProj u) = u :=
  Subtype.ext (Subtype.ext (Berk.ext_val fun F => by rw [toProj_val, ofProj_val]))

theorem ofProj_toProj (v : P.recoord.an) : P.ofProj (P.toProj v) = v := by
  refine Subtype.ext (Berk.ext_val fun p => ?_)
  obtain ⟨F, rfl⟩ := P.homS_surjective p
  rw [ofProj_val, toProj_val]

/-- **`(K, S, w)^an ≃ₜ V(I)^an`** (`rmk:gl-bridges`). -/
def projHomeomorph : P.recoord.an ≃ₜ P.toProjSubvariety.an :=
  @Continuous.homeoOfEquivCompactToT2 _ _ _ _ _ _
    ⟨P.toProj, P.ofProj, P.ofProj_toProj, P.toProj_ofProj⟩ P.continuous_toProj

/-- **The bridge** (`rmk:gl-bridges`): for a rank-1 model generated in degree `1` by
`w_0, …, w_N`, `V(I)^an ≃ₜ 𝒳^an`, `I` the kernel of `x_i ↦ w_i T`. -/
def anHomeomorph : P.toProjSubvariety.an ≃ₜ X.an :=
  P.projHomeomorph.symm.trans P.recoordHomeomorph

/-- **The value formula of the bridge**: `|F(w T)|_{u'} = |F|_u` for `F ∈ k[x_0, …, x_N]`. -/
theorem anHomeomorph_val (u : P.toProjSubvariety.an) (F : MvPolynomial (Fin (N + 1)) k) :
    (P.anHomeomorph u).1.val (P.homS F) = u.1.1.val F :=
  P.ofProj_val u F

theorem anHomeomorph_symm_val (v : X.an) (F : MvPolynomial (Fin (N + 1)) k) :
    (P.anHomeomorph.symm v).1.1.val F = v.1.val (P.homS F) := by
  have h := P.anHomeomorph_val (P.anHomeomorph.symm v) F
  rw [Homeomorph.apply_symm_apply] at h
  exact h.symm

/-- The bridge maps the trivial point of `V(I)` to `⋆`. -/
theorem anHomeomorph_triv : P.anHomeomorph P.toProjSubvariety.triv = X.triv := by
  classical
  refine Subtype.ext (Berk.ext_val fun p => ?_)
  obtain ⟨F, rfl⟩ := P.homS_surjective p
  rw [anHomeomorph_val]
  by_cases hF : F ∈ P.ideal
  · rw [show P.homS F = 0 from (RingHom.mem_ker).1 hF, map_zero]
    exact trivOn_val_of_mem P.toProjSubvariety.isHomogeneousIdeal
      P.toProjSubvariety.exists_X_notMem hF
  · have hF' : P.homS F ≠ 0 := fun h => hF ((RingHom.mem_ker).2 h)
    rw [X.triv_val_of_ne_zero hF']
    exact P.toProjSubvariety.triv_val_of_notMem hF


/-! #### The charts -/

/-- The chart index `(i)` of `(K, S, w)`. -/
abbrev chartIndex (i : Fin (N + 1)) : P.recoord.ChartIndex :=
  fun _ => i

theorem coord_chartIndex_ne_zero {i : Fin (N + 1)} (hi : P.w i ≠ 0) :
    ∀ c, P.recoord.coord c (P.chartIndex i c) ≠ 0 := fun _ => hi

/-- The dehomogenization `F ↦ F(w) / w_i^{deg F}` of the presentation at `x_i`. -/
def chartHom (i : Fin (N + 1)) : MvPolynomial (Fin (N + 1)) k →ₐ[k] K :=
  (P.recoord.dehom (P.chartIndex i)).comp P.hom

theorem chartDen_chartIndex (i : Fin (N + 1)) (n : ℕ) :
    P.recoord.chartDen (P.chartIndex i) (Finsupp.single 0 n) = P.w i ^ n := by
  rw [chartDen, Fin.prod_univ_one, Finsupp.single_eq_same]

theorem chartHom_X_self {i : Fin (N + 1)} (hi : P.w i ≠ 0) : P.chartHom i (MvPolynomial.X i) = 1 := by
  rw [chartHom, AlgHom.comp_apply, hom_X, gen, dehom_monomial, chartDen_chartIndex, pow_one,
    div_self hi]

/-- The image of a form of degree `n` under the dehomogenization at `x_i`. -/
theorem chartHom_of_isHomogeneous (i : Fin (N + 1)) {n : ℕ} {F : MvPolynomial (Fin (N + 1)) k}
    (hF : F.IsHomogeneous n) :
    P.chartHom i F = (P.hom F).coeff (Finsupp.single 0 n) / P.w i ^ n := by
  have h := P.hom_homogeneousComponent n F
  rw [homogeneousComponent_eq_self hF] at h
  rw [chartHom, AlgHom.comp_apply, h, dehom_monomial, chartDen_chartIndex, coeff_monomial,
    if_pos rfl]

theorem coeff_hom_mem_piece (F : MvPolynomial (Fin (N + 1)) k) (a : Fin 1 →₀ ℕ) :
    (P.hom F).coeff a ∈ X.piece a :=
  X.coeff_mem_piece (P.hom_mem F) a

/-- **The charts of the bridge** (`rmk:gl-bridges`): for `w_i ≠ 0`, the quotient chart algebra
`A_{x_i} / I_{(x_i)}` of `V(I)` is `k`-isomorphic to the chart algebra of `(K, S, w)` at `w_i`,
`F̄ / x̄_i^n ↦ F(w) / w_i^n`. -/
def quotChartAlgEquiv (i : Fin (N + 1)) (hi : P.w i ≠ 0) :
    QuotChartAlg P.toProjSubvariety.ideal (MvPolynomial.X i) 1 ≃ₐ[k]
      P.recoord.chartAlg (P.chartIndex i) :=
  quotChartEquiv P.toProjSubvariety.ideal (MvPolynomial.X i) 1 (P.chartHom i)
    (fun f hf => by
      rw [chartHom, AlgHom.comp_apply, (P.mem_ideal_iff).1 hf, map_zero])
    (by rw [P.chartHom_X_self hi]; exact isUnit_one)
    (isHomogeneous_X k i)
    (fun n f hf h0 => by
      rw [mul_one] at hf
      rw [P.chartHom_of_isHomogeneous i hf, div_eq_zero_iff, or_iff_left (pow_ne_zero _ hi)] at h0
      rw [toProjSubvariety_ideal, mem_ideal_iff, ← homogeneousComponent_eq_self hf,
        hom_homogeneousComponent, h0, map_zero])
    (P.recoord.chartAlg (P.chartIndex i)).val Subtype.val_injective (by
      ext c
      rw [mem_range_quotChartLift _ _ _ (isHomogeneous_X k i), Subalgebra.range_val,
        mem_chartAlg_iff (P.coord_chartIndex_ne_zero hi), P.chartHom_X_self hi]
      simp only [one_pow, mul_one]
      constructor
      · rintro ⟨n, τ, hτ, rfl⟩
        refine ⟨Finsupp.single 0 n, (P.hom τ).coeff (Finsupp.single 0 n),
          P.coeff_hom_mem_piece τ _, ?_⟩
        rw [P.chartHom_of_isHomogeneous i hτ, chartDen_chartIndex]
      · rintro ⟨a, g, hg, rfl⟩
        have hgS : monomial a g ∈ P.hom.range := by rw [P.range_hom]; exact hg
        obtain ⟨F, hF⟩ := hgS
        change P.hom F = monomial a g at hF
        refine ⟨a 0, homogeneousComponent (a 0) F, homogeneousComponent_isHomogeneous _ _, ?_⟩
        rw [P.chartHom_of_isHomogeneous i (homogeneousComponent_isHomogeneous _ _),
          hom_homogeneousComponent, hF, ← eq_single a, coeff_monomial, if_pos rfl,
          coeff_monomial, if_pos rfl, ← chartDen_chartIndex, ← eq_single a])

/-- `(quotChartAlgEquiv (F̄ / x̄_i^n) : K) = F(w) / w_i^n`. -/
theorem coe_quotChartAlgEquiv (i : Fin (N + 1)) (hi : P.w i ≠ 0)
    (b : QuotChartAlg P.toProjSubvariety.ideal (MvPolynomial.X i) 1) :
    (P.quotChartAlgEquiv i hi b : K) = quotChartLift P.toProjSubvariety.ideal (MvPolynomial.X i) 1
      (P.chartHom i) (fun f hf => by rw [chartHom, AlgHom.comp_apply, (P.mem_ideal_iff).1 hf,
        map_zero]) (by rw [P.chartHom_X_self hi]; exact isUnit_one) b :=
  by
    unfold quotChartAlgEquiv
    exact apply_quotChartEquiv (C := K) (A := P.recoord.chartAlg (P.chartIndex i)) (P.chartHom i)
      _ _ (isHomogeneous_X k i) _ (P.recoord.chartAlg (P.chartIndex i)).val Subtype.val_injective _ b

