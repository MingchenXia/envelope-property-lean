import EnvelopeProperty.Global.NativeRankOneCoordinateCover
import EnvelopeProperty.Global.NativeRankOneAnalyticCharts
import ModularCurves.ForMathlib.ProjectiveSpaceHyperplane
import ModularCurves.EllipticCurve.PoleSheaf

/-! # The actual ORIGINAL coordinate hyperplane and genuine invertible native line -/
open scoped Classical
open MvPolynomial AlgebraicGeometry CategoryTheory
open HomogeneousIdeal
noncomputable section
universe u
namespace EnvelopeProperty.MultiModel
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable {k K : Type u} [Field k] [Field K] [Algebra k K]
  (X : MultiModel k K 1)

/-- The actual homogeneous principal ideal of the SAME original coordinate. -/
def nativeRankOneHyperplaneIdeal (j : Fin (X.M 0 + 1)) :
    HomogeneousIdeal X.nativeTotalGrading :=
  ⟨Ideal.span {X.coordElem ⟨0, j⟩}, Ideal.homogeneous_span _ _ fun p hp => by
    rw [Set.mem_singleton_iff] at hp
    subst p
    exact ⟨1, X.nativeRankOneCoordinate_mem j⟩⟩

/-- The actual original coordinate hyperplane is its true native projective quotient. -/
def nativeRankOneHyperplaneInclusion (j : Fin (X.M 0 + 1)) :
    Proj (quotientGrading (X.nativeRankOneHyperplaneIdeal j)) ⟶ X.nativeRankOneScheme :=
  Proj.map (quotientGradingHom (X.nativeRankOneHyperplaneIdeal j))
    (quotientGradingHom_irrelevant_le (X.nativeRankOneHyperplaneIdeal j))

/-- The actual original homogeneous quotient is a true closed immersion. -/
instance nativeRankOneHyperplaneInclusion_isClosedImmersion (j : Fin (X.M 0 + 1)) :
    IsClosedImmersion (X.nativeRankOneHyperplaneInclusion j) :=
  isClosedImmersion_proj_map_quotientGradingHom (X.nativeRankOneHyperplaneIdeal j)

/-- The actual local hyperplane equation is the SAME true homogeneous coordinate ratio. -/
def nativeRankOneHyperplaneLocalEquation (i j : Fin (X.M 0 + 1)) :
    Γ(X.nativeRankOneScheme, X.nativeRankOneCoordinateOpen i) :=
  (X.nativeRankOneHomogeneousSectionsIso i).hom
    (HomogeneousLocalization.Away.mk X.nativeTotalGrading (X.nativeRankOneCoordinate_mem i)
      1 (X.coordElem ⟨0, j⟩) (by simpa using X.nativeRankOneCoordinate_mem j))

private theorem kernel_span_of_equiv_square {A B C D : Type u}
    [CommRing A] [CommRing B] [CommRing C] [CommRing D]
    (e : A ≃+* B) (q : A →+* C) (r : B →+* D) (t : C →+* D)
    (ht : Function.Injective t) (hcomm : r.comp e.toRingHom = t.comp q)
    (F : A) (hker : RingHom.ker q = Ideal.span {F}) :
    RingHom.ker r = Ideal.span {e F} := by
  have hk : RingHom.ker r = Ideal.map e (RingHom.ker q) := by
    ext y
    rw [Ideal.mem_map_of_equiv e y]
    constructor
    · intro hy
      refine ⟨e.symm y, ?_, e.apply_symm_apply y⟩
      rw [RingHom.mem_ker] at hy ⊢
      apply ht
      have h := RingHom.congr_fun hcomm (e.symm y)
      change r (e (e.symm y)) = t (q (e.symm y)) at h
      rw [e.apply_symm_apply, hy] at h
      exact h.symm.trans (map_zero t).symm
    · rintro ⟨x, hx, rfl⟩
      rw [RingHom.mem_ker] at hx ⊢
      have h := RingHom.congr_fun hcomm x
      change r (e x) = t (q x) at h
      rw [hx, map_zero] at h
      exact h
  rw [hk, hker, Ideal.map_span, Set.image_singleton]

private theorem original_hyperplane_away_kernel (i j : Fin (X.M 0 + 1)) :
    RingHom.ker (HomogeneousLocalization.Away.map
      (quotientGradingHom (X.nativeRankOneHyperplaneIdeal j)) (X.coordElem ⟨0, i⟩)) =
    Ideal.span {HomogeneousLocalization.Away.mk X.nativeTotalGrading
      (X.nativeRankOneCoordinate_mem i) 1 (X.coordElem ⟨0, j⟩)
      (by simpa using X.nativeRankOneCoordinate_mem j)} := by
  exact HomogeneousIdeal.ker_away_map_quotientGradingHom
    (X.nativeRankOneHyperplaneIdeal j) (X.nativeRankOneCoordinate_mem j) rfl
    (X.nativeRankOneCoordinate_mem i)

/-- The actual scheme-theoretic ideal is generated by the SAME true original ratio on every coordinate chart. -/
theorem nativeRankOneHyperplaneLocalEquation_span (i j : Fin (X.M 0 + 1)) :
    (X.nativeRankOneHyperplaneInclusion j).ker.ideal
      (⟨X.nativeRankOneCoordinateOpen i, X.nativeRankOneCoordinateOpen_isAffine i⟩ :
        X.nativeRankOneScheme.affineOpens) =
      Ideal.span {X.nativeRankOneHyperplaneLocalEquation i j} := by
  rw [Scheme.Hom.ker_apply]
  let I := X.nativeRankOneHyperplaneIdeal j
  let eA := X.nativeRankOneHomogeneousSectionsIso i
  let q := HomogeneousLocalization.Away.map (quotientGradingHom I) (X.coordElem ⟨0, i⟩)
  let eB := Proj.basicOpenIsoAway (quotientGrading I) (quotientGradingHom I (X.coordElem ⟨0, i⟩))
    (mk_mem_quotientGrading I (X.nativeRankOneCoordinate_mem i)) one_pos
  let t := (Proj.awayToSection (quotientGrading I)
    (quotientGradingHom I (X.coordElem ⟨0, i⟩))).hom
  have ht : Function.Injective t := eB.commRingCatIsoToRingEquiv.injective
  refine kernel_span_of_equiv_square eA.commRingCatIsoToRingEquiv q _ t ht ?_
    (HomogeneousLocalization.Away.mk X.nativeTotalGrading (X.nativeRankOneCoordinate_mem i)
      1 (X.coordElem ⟨0, j⟩) (by simpa using X.nativeRankOneCoordinate_mem j)) ?_
  · apply RingHom.ext
    intro z
    have h := ConcreteCategory.congr_hom
      (Proj.awayToSection_comp_appLE (quotientGradingHom I)
        (quotientGradingHom_irrelevant_le I) (X.nativeRankOneCoordinate_mem i)) z
    exact h
  · exact original_hyperplane_away_kernel X i j

/-- Original nonzero coordinates make the actual local equation a nonzerodivisor, derived in the SAME original chart. -/
theorem nativeRankOneHyperplaneLocalEquation_mem_nonZeroDivisors
    (i j : Fin (X.M 0 + 1)) (hi : X.coord 0 i ≠ 0) (hj : X.coord 0 j ≠ 0) :
    X.nativeRankOneHyperplaneLocalEquation i j ∈
      nonZeroDivisors Γ(X.nativeRankOneScheme, X.nativeRankOneCoordinateOpen i) := by
  let c : X.ChartIndex := fun b => (Subsingleton.elim (0 : Fin 1) b) ▸ i
  have hc : ∀ b, X.coord b (c b) ≠ 0 := by
    intro b
    have hb : b = 0 := Subsingleton.elim _ _
    subst b
    exact hi
  let e := (X.nativeRankOneHomogeneousSectionsIso i).commRingCatIsoToRingEquiv
  let ec := X.nativeRankOneChartEquiv c hc
  let : IsDomain Γ(X.nativeRankOneScheme, X.nativeRankOneCoordinateOpen i) :=
    Function.Injective.isDomain (ec.toRingHom.comp e.symm.toRingHom)
      (ec.injective.comp e.symm.injective)
  apply mem_nonZeroDivisors_of_ne_zero
  let q := HomogeneousLocalization.Away.mk X.nativeTotalGrading
    (X.nativeRankOneCoordinate_mem i) 1 (X.coordElem ⟨0, j⟩)
      (by simpa using X.nativeRankOneCoordinate_mem j)
  have hq : q ≠ 0 := by
    intro hz
    have hv := congrArg (fun z => ((X.nativeRankOneChartDehom c hc z : X.chartAlg c) : K)) hz
    rw [X.nativeRankOneChartDehom_mk c hc] at hv
    simp only [map_zero, ZeroMemClass.coe_zero] at hv
    change X.dehom c (monomial (Finsupp.single 0 1) (X.coord 0 j)) = 0 at hv
    rw [X.dehom_monomial, X.chartDen_single] at hv
    exact (div_ne_zero hj hi) hv
  intro hr
  exact hq (e.injective (hr.trans (map_zero e).symm))

/-- The actual SAME original nonzero-coordinate hyperplane ideal module is genuinely invertible. -/
theorem nativeRankOneHyperplaneIdealModule_isInvertible (j : Fin (X.M 0 + 1))
    (hj : X.coord 0 j ≠ 0) :
    Scheme.Modules.IsInvertible (ModularCurves.idealModule (X.nativeRankOneHyperplaneInclusion j)) := by
  apply ModularCurves.idealModule_isInvertible_of_locallyPrincipal
  intro y
  have hy : y ∈ ⨆ i : Fin (X.M 0 + 1), X.nativeRankOneCoordinateOpen i := by
    rw [X.nativeRankOne_iSup_coordinateOpen]
    trivial
  obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
  have hci : X.coord 0 i ≠ 0 := by
    intro hz
    have he : X.coordElem ⟨0, i⟩ = 0 := Subtype.ext (by simp [hz])
    change X.coordElem ⟨0, i⟩ ∉ y.asHomogeneousIdeal at hi
    exact hi (he ▸ zero_mem y.asHomogeneousIdeal.toIdeal)
  refine ⟨⟨X.nativeRankOneCoordinateOpen i, X.nativeRankOneCoordinateOpen_isAffine i⟩, hi,
    X.nativeRankOneHyperplaneLocalEquation i j, X.nativeRankOneHyperplaneLocalEquation_span i j,
    X.nativeRankOneHyperplaneLocalEquation_mem_nonZeroDivisors i j hci hj⟩

/-- The actual coordinate pole module on the SAME original native scheme. -/
def nativeRankOneCoordinateLine (j : Fin (X.M 0 + 1)) : X.nativeRankOneScheme.Modules :=
  Scheme.Modules.dualObj (ModularCurves.idealModule (X.nativeRankOneHyperplaneInclusion j))

/-- The actual original coordinate pole module is an invertible line, with no supplied Cartier certificate. -/
theorem nativeRankOneCoordinateLine_isInvertible (j : Fin (X.M 0 + 1))
    (hj : X.coord 0 j ≠ 0) : Scheme.Modules.IsInvertible (X.nativeRankOneCoordinateLine j) := by
  exact (X.nativeRankOneHyperplaneIdealModule_isInvertible j hj).dual

end EnvelopeProperty.MultiModel
