import EnvelopeProperty.Projective.Subvariety
import EnvelopeProperty.Algebra.GradedClosureBasic

/-!
# The chart `U_{x_j} ∩ V(I)^an` of a projective model of an affine variety

Part (4) of `lem:wu-proj-chart` (`wu-discharge.tex`, subsection `subsec:wu-compactification`),
for Fang–Han–Xia, *The envelope property for unibranch projective varieties*, Lemma 5.9 /
Corollary 5.26. In the situation of `def:wu-compactification`, `S'' ⊆ A[T]` is a graded
subalgebra generated by `S''_1 = S'_e`, `R_M → S''`, `xᵢ ↦ zᵢ` with `z₀ = T^e`, has kernel `I`, and
`S''_{(z₀)} = S'_{(T)} ≅ A`; then `ι_{x₀}` identifies `U_{x₀} ∩ V(I)^an` with `Y^an = (Spec A)^an`
and maps the trivial valuation of `S''` to `v_triv`.

Here the situation is encoded by explicit hypotheses on a `k`-algebra map
`φ : R_M → A[T]` (the graded ring `S''` being its image `φ.range`):

* `φ(xᵢ)` is homogeneous of `T`-degree `e` for all `i`, and `φ(x_{j₀}) = T^e`, `e ≥ 1`;
* `φ` vanishes exactly on `I`;
* `homLoc φ.range 1 e = A` inside `Frac A`, i.e. `S''_{(T^e)} = A` in the model `homLoc` of
  `Algebra/GradedClosureBasic.lean` (provided for `S'' = S'^{(e)}` by
  `exists_veronese_normalizedRees`, `lem:wu-graded-closure`(5) and `lem:wu-veronese`).

## Main definitions and results

* `ProjBerk.IsReesPresentation k I φ e j₀`: the hypotheses above; `ProjSubvariety.ofRees` builds
  `X = V(ker φ)` and `ProjSubvariety.isReesPresentation_ofRees` the presentation.
* `ProjBerk.affineChartEquiv : A_{x_{j₀}} / I_{(x_{j₀})} ≃ₐ[k] A`, `τ̄ / x̄_{j₀}^N ↦` the
  coefficient of `T^{Ne}` in `φ(τ)` (`ProjBerk.affineChartEquiv_quotChartMk`).
* `ProjSubvariety.affineChart : U_{x_{j₀}} ∩ X^an ≃ₜ (Spec A)^an` with
  `|φ(τ)_{Ne}|_{ι(v)} = |τ|_v / |x_{j₀}|_v^N` (`ProjSubvariety.affineChart_val_coeff`,
  `ProjSubvariety.logAbs_affineChart_coeff`) and `ι(X.triv) = v_triv`
  (`ProjSubvariety.affineChart_triv`, `lem:wu-proj-chart`(4)).
-/

open scoped NNReal ENNReal Topology

open Topology

noncomputable section

namespace EnvelopeProperty

universe u

namespace ProjBerk

variable {k : Type u} [Field k] {M : ℕ} {A : Type*} [CommRing A] [Algebra k A]
  (φ : MvPolynomial (Fin (M + 1)) k →ₐ[k] Polynomial A) {e : ℕ}

theorem isHomog_finset_sum {ι : Type*} (s : Finset ι) (f : ι → Polynomial A) {d : ℕ}
    (h : ∀ i ∈ s, IsHomog d (f i)) : IsHomog d (∑ i ∈ s, f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => exact isHomog_zero d
  | insert i s hi ih =>
    rw [Finset.sum_insert hi]
    exact (h i (Finset.mem_insert_self i s)).add (ih fun j hj => h j (Finset.mem_insert_of_mem hj))

/-- If `φ` maps every coordinate to a homogeneous element of `T`-degree `e`, it maps forms of
degree `N` to homogeneous elements of `T`-degree `N e`. -/
theorem isHomog_map_of_isHomogeneous (hφX : ∀ i, IsHomog e (φ (MvPolynomial.X i))) {N : ℕ}
    {τ : MvPolynomial (Fin (M + 1)) k} (hτ : τ.IsHomogeneous N) : IsHomog (N * e) (φ τ) := by
  classical
  rw [τ.as_sum, map_sum]
  refine isHomog_finset_sum _ _ fun α hα => ?_
  have hdeg : α.degree = N := by
    rw [Finsupp.degree_eq_weight_one]
    exact hτ (MvPolynomial.mem_support_iff.1 hα)
  rw [MvPolynomial.monomial_eq, map_mul, MvPolynomial.algHom_C, ← Algebra.smul_def,
    map_finsuppProd]
  refine IsHomog.smul ?_ _
  have h := isHomog_prod α.support (fun i => φ (MvPolynomial.X i ^ α i)) (fun i => α i * e)
    fun i _ => by rw [map_pow]; exact (hφX i).pow (α i)
  rwa [← Finset.sum_mul, ← Finsupp.degree_apply, hdeg] at h

/-- `T`-homogeneous components commute with `φ`: if `φ(xᵢ)` is homogeneous of `T`-degree `e ≥ 1`
for all `i`, the component of `T`-degree `j e` of `φ(f)` is `φ(f_j)`. -/
theorem homogComp_map (he : 0 < e) (hφX : ∀ i, IsHomog e (φ (MvPolynomial.X i))) (j : ℕ)
    (f : MvPolynomial (Fin (M + 1)) k) :
    homogComp (j * e) (φ f) = φ (MvPolynomial.homogeneousComponent j f) := by
  classical
  conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent f]
  rw [map_sum, map_sum]
  have h : ∀ n ∈ Finset.range (f.totalDegree + 1),
      homogComp (j * e) (φ (MvPolynomial.homogeneousComponent n f)) =
        if n = j then φ (MvPolynomial.homogeneousComponent n f) else 0 := by
    intro n _
    have hn := isHomog_map_of_isHomogeneous φ hφX
      (MvPolynomial.homogeneousComponent_isHomogeneous n f)
    split_ifs with hnj
    · subst hnj
      exact hn.homogComp_self
    · exact hn.homogComp_of_ne fun h => hnj (Nat.eq_of_mul_eq_mul_right he h)
  rw [Finset.sum_congr rfl h, Finset.sum_ite_eq']
  split_ifs with hj
  · rfl
  · rw [MvPolynomial.homogeneousComponent_eq_zero, map_zero]
    simpa using hj

/-- Evaluation at `T = 1`, a `k`-algebra map `A[T] → A`. -/
def evalOne : Polynomial A →ₐ[k] A :=
  (Polynomial.aeval (1 : A)).restrictScalars k

theorem evalOne_monomial (n : ℕ) (a : A) : evalOne (k := k) (Polynomial.monomial n a) = a := by
  simp [evalOne, Polynomial.aeval_monomial]

variable [IsDomain A]

variable (k) in
/-- **Hypotheses of `lem:wu-proj-chart`(4)**: a `k`-algebra map `φ : R_M → A[T]` presenting
`V(I)` as a projective model of `Spec A`, with `U_{x_{j₀}}` corresponding to `Spec A`. Its image
`S'' = φ(R_M)` is generated by the elements `φ(xᵢ)` of `T`-degree `e ≥ 1`, `φ(x_{j₀}) = T^e`,
`φ` vanishes exactly on `I`, and `S''_{(T^e)} = A` in the model `homLoc` of
`Algebra/GradedClosureBasic.lean`. In the situation of `def:wu-compactification`,
`S'' = S'^{(e)}`, `j₀ = 0`, and the last condition is part of `exists_veronese_normalizedRees`. -/
structure IsReesPresentation (I : Ideal (MvPolynomial (Fin (M + 1)) k))
    (φ : MvPolynomial (Fin (M + 1)) k →ₐ[k] Polynomial A) (e : ℕ) (j₀ : Fin (M + 1)) : Prop where
  pos : 0 < e
  isHomog_X : ∀ i, IsHomog e (φ (MvPolynomial.X i))
  map_X : φ (MvPolynomial.X j₀) = Polynomial.monomial e 1
  map_eq_zero_iff : ∀ f, φ f = 0 ↔ f ∈ I
  homLoc_eq : homLoc φ.range 1 e = (IsScalarTower.toAlgHom k A (FractionRing A)).range

namespace IsReesPresentation

variable {I : Ideal (MvPolynomial (Fin (M + 1)) k)} {φ} {j₀ : Fin (M + 1)}
  (hφ : IsReesPresentation k I φ e j₀)
include hφ

theorem X_notMem : (MvPolynomial.X j₀ : MvPolynomial (Fin (M + 1)) k) ∉ I := by
  rw [← hφ.map_eq_zero_iff, hφ.map_X]
  exact (Polynomial.monomial_eq_zero_iff _ _).not.2 one_ne_zero

theorem evalOne_comp_X : (evalOne.comp φ) (MvPolynomial.X j₀) = 1 := by
  rw [AlgHom.comp_apply, hφ.map_X, evalOne_monomial]

theorem isUnit_evalOne_comp_X : IsUnit ((evalOne.comp φ) (MvPolynomial.X j₀)) := by
  rw [hφ.evalOne_comp_X]
  exact isUnit_one

theorem evalOne_comp_eq_zero : ∀ f ∈ I, (evalOne.comp φ) f = 0 := fun f hf => by
  rw [AlgHom.comp_apply, (hφ.map_eq_zero_iff f).2 hf, map_zero]

/-- On a form `τ` of degree `N`, `φ(τ) = c T^{Ne}` with `c = evalOne (φ τ)`. -/
theorem map_eq_monomial {N : ℕ} {τ : MvPolynomial (Fin (M + 1)) k} (hτ : τ.IsHomogeneous N) :
    φ τ = Polynomial.monomial (N * e) ((φ τ).coeff (N * e)) :=
  (isHomog_map_of_isHomogeneous φ hφ.isHomog_X hτ).eq_monomial

theorem evalOne_comp_of_isHomogeneous {N : ℕ} {τ : MvPolynomial (Fin (M + 1)) k}
    (hτ : τ.IsHomogeneous N) : (evalOne.comp φ) τ = (φ τ).coeff (N * e) := by
  rw [AlgHom.comp_apply, hφ.map_eq_monomial hτ, evalOne_monomial, Polynomial.coeff_monomial,
    if_pos rfl]

theorem mem_of_evalOne_comp_eq_zero (N : ℕ) (f : MvPolynomial (Fin (M + 1)) k)
    (hf : f.IsHomogeneous (N * 1)) (h0 : (evalOne.comp φ) f = 0) : f ∈ I := by
  rw [mul_one] at hf
  rw [hφ.evalOne_comp_of_isHomogeneous hf] at h0
  rw [← hφ.map_eq_zero_iff, hφ.map_eq_monomial hf, h0, map_zero]

/-- Every `a ∈ A` is the coefficient of `φ(τ) = a T^{Ne}` for a form `τ` of degree `N`: this is
`S''_{(T^e)} = A`. -/
theorem exists_isHomogeneous_map_eq (a : A) :
    ∃ (N : ℕ) (τ : MvPolynomial (Fin (M + 1)) k), τ.IsHomogeneous N ∧
      φ τ = Polynomial.monomial (N * e) a := by
  have hσ : Polynomial.monomial e (1 : A) ∈ φ.range := ⟨MvPolynomial.X j₀, hφ.map_X⟩
  have ha : algebraMap A (FractionRing A) a ∈ homLoc φ.range 1 e := by
    rw [hφ.homLoc_eq]
    exact ⟨a, rfl⟩
  obtain ⟨N, a', ha', h⟩ := (mem_homLoc_iff one_ne_zero (by simpa using hσ)).1 ha
  rw [map_one, one_pow, div_one] at h
  obtain rfl := IsFractionRing.injective A (FractionRing A) h
  obtain ⟨f, hf⟩ := ha'
  replace hf : φ f = Polynomial.monomial (N * e) a := hf
  refine ⟨N, MvPolynomial.homogeneousComponent N f,
    MvPolynomial.homogeneousComponent_isHomogeneous N f, ?_⟩
  rw [← homogComp_map φ hφ.pos hφ.isHomog_X, hf, homogComp_monomial, if_pos rfl]

end IsReesPresentation

variable {I : Ideal (MvPolynomial (Fin (M + 1)) k)} {φ} {j₀ : Fin (M + 1)}

/-- The isomorphism `A_{x_{j₀}} / I_{(x_{j₀})} ≃ₐ[k] A` of a Rees presentation,
`τ̄ / x̄_{j₀}^N ↦ φ(τ)_{Ne}` (`affineChartEquiv_quotChartMk`): `S''_{(z₀)} ≅ A` in
`lem:wu-proj-chart`(4). -/
def affineChartEquiv (hφ : IsReesPresentation k I φ e j₀) :
    QuotChartAlg I (MvPolynomial.X j₀) 1 ≃ₐ[k] A :=
  AlgEquiv.ofBijective (quotChartLift I (MvPolynomial.X j₀) 1 (evalOne.comp φ)
    hφ.evalOne_comp_eq_zero hφ.isUnit_evalOne_comp_X)
    ⟨quotChartLift_injective _ _ _ (MvPolynomial.isHomogeneous_X k j₀)
      hφ.mem_of_evalOne_comp_eq_zero, fun a => by
      obtain ⟨N, τ, hτ, hτa⟩ := hφ.exists_isHomogeneous_map_eq a
      refine ⟨quotChartMk I (MvPolynomial.X j₀) 1 N τ, ?_⟩
      have h := quotChartLift_quotChartMk_mul_pow (I := I) (d := 1) (evalOne.comp φ)
        hφ.evalOne_comp_eq_zero hφ.isUnit_evalOne_comp_X N τ
      rw [mul_one, MvPolynomial.homogeneousComponent_eq_self hτ, hφ.evalOne_comp_X, one_pow,
        mul_one, AlgHom.comp_apply, hτa, evalOne_monomial] at h
      exact h⟩

/-- `τ̄ / x̄_{j₀}^N ↦ φ(τ)_{Ne}`, the coefficient of `T^{Ne}` in `φ(τ)`, for a form `τ` of
degree `N`. -/
theorem affineChartEquiv_quotChartMk (hφ : IsReesPresentation k I φ e j₀) {N : ℕ}
    {τ : MvPolynomial (Fin (M + 1)) k} (hτ : τ.IsHomogeneous N) :
    affineChartEquiv hφ (quotChartMk I (MvPolynomial.X j₀) 1 N τ) = (φ τ).coeff (N * e) := by
  have h := quotChartLift_quotChartMk_mul_pow (I := I) (d := 1) (evalOne.comp φ)
    hφ.evalOne_comp_eq_zero hφ.isUnit_evalOne_comp_X N τ
  rw [mul_one, MvPolynomial.homogeneousComponent_eq_self hτ, hφ.evalOne_comp_X, one_pow,
    mul_one, hφ.evalOne_comp_of_isHomogeneous hτ] at h
  exact h

end ProjBerk

open ProjBerk

namespace ProjSubvariety

variable {k : Type u} [Field k] {M : ℕ} (X : ProjSubvariety k M) {A : Type*} [CommRing A]
  [Algebra k A] [IsDomain A] {φ : MvPolynomial (Fin (M + 1)) k →ₐ[k] Polynomial A} {e : ℕ}
  {j₀ : Fin (M + 1)}

variable (φ e j₀) in
/-- The projective subvariety `X = V(ker φ) ⊆ ℙᴹ` (`Proj` of `S'' = φ(R_M)`) defined by a
`k`-algebra map `φ : R_M → A[T]` to a domain with `φ(xᵢ)` of `T`-degree `e ≥ 1` and
`φ(x_{j₀}) = T^e`: `ker φ` is a homogeneous prime ideal not containing `x_{j₀}`. -/
def ofRees (he : 0 < e) (hφX : ∀ i, IsHomog e (φ (MvPolynomial.X i)))
    (hφ0 : φ (MvPolynomial.X j₀) = Polynomial.monomial e 1) : ProjSubvariety k M where
  ideal := RingHom.ker φ
  isHomogeneousIdeal f hf d := by
    rw [RingHom.mem_ker, ← homogComp_map φ he hφX, RingHom.mem_ker.1 hf, map_zero]
  isPrime := RingHom.ker_isPrime φ
  exists_X_notMem := ⟨j₀, by
    rw [RingHom.mem_ker, hφ0]
    exact (Polynomial.monomial_eq_zero_iff _ _).not.2 one_ne_zero⟩

theorem ofRees_ideal (he : 0 < e) (hφX : ∀ i, IsHomog e (φ (MvPolynomial.X i)))
    (hφ0 : φ (MvPolynomial.X j₀) = Polynomial.monomial e 1) :
    (ofRees φ e j₀ he hφX hφ0).ideal = RingHom.ker φ :=
  rfl

/-- `φ` is a Rees presentation of `ofRees φ` as soon as `S''_{(T^e)} = A`. -/
theorem isReesPresentation_ofRees (he : 0 < e) (hφX : ∀ i, IsHomog e (φ (MvPolynomial.X i)))
    (hφ0 : φ (MvPolynomial.X j₀) = Polynomial.monomial e 1)
    (hloc : homLoc φ.range 1 e = (IsScalarTower.toAlgHom k A (FractionRing A)).range) :
    IsReesPresentation k (ofRees φ e j₀ he hφX hφ0).ideal φ e j₀ :=
  ⟨he, hφX, hφ0, fun _ => RingHom.mem_ker.symm, hloc⟩

/-- **`lem:wu-proj-chart`(4)**: for a Rees presentation `φ` of `X`, the chart `ι_{x_{j₀}}`
followed by `S''_{(z₀)} ≅ A` (`affineChartEquiv`) identifies `U_{x_{j₀}} ∩ X^an` with
`(Spec A)^an`. -/
def affineChart (hφ : IsReesPresentation k X.ideal φ e j₀) :
    {v : X.an // (v : ProjBerk k M).1.val (MvPolynomial.X j₀) ≠ 0} ≃ₜ Berk k A :=
  (X.chartHomeomorph (MvPolynomial.X j₀) 1 (MvPolynomial.isHomogeneous_X k j₀) one_pos).trans
    (Berk.homeomorphOfAlgEquiv (affineChartEquiv hφ))

/-- `|φ(τ)_{Ne}|_{ι(v)} = |τ|_v / |x_{j₀}|_v^N` for a form `τ` of degree `N`. -/
theorem affineChart_val_coeff (hφ : IsReesPresentation k X.ideal φ e j₀)
    (v : {v : X.an // (v : ProjBerk k M).1.val (MvPolynomial.X j₀) ≠ 0}) {N : ℕ}
    {τ : MvPolynomial (Fin (M + 1)) k} (hτ : τ.IsHomogeneous N) :
    (X.affineChart hφ v).val ((φ τ).coeff (N * e)) =
      (v : ProjBerk k M).1.val τ / (v : ProjBerk k M).1.val (MvPolynomial.X j₀) ^ N := by
  rw [affineChart, Homeomorph.trans_apply, Berk.homeomorphOfAlgEquiv_val_apply,
    ← affineChartEquiv_quotChartMk hφ hτ, AlgEquiv.symm_apply_apply, chartHomeomorph_apply]
  exact chartMap_val_quotChartMk v.1 v.2 (by rwa [mul_one])

/-- `log|φ(τ)_{Ne}| ∘ ι = log|τ| - N log|x_{j₀}|` on `U_{x_{j₀}} ∩ X^an` (with
`lem:wu-proj-chart`(3)). -/
theorem logAbs_affineChart_coeff (hφ : IsReesPresentation k X.ideal φ e j₀)
    (v : {v : X.an // (v : ProjBerk k M).1.val (MvPolynomial.X j₀) ≠ 0}) {N : ℕ}
    {τ : MvPolynomial (Fin (M + 1)) k} (hτ : τ.IsHomogeneous N) :
    Berk.logAbs ((φ τ).coeff (N * e)) (X.affineChart hφ v) =
      logAbs τ (v : ProjBerk k M) - N * logAbs (MvPolynomial.X j₀) (v : ProjBerk k M) := by
  rw [affineChart, Homeomorph.trans_apply, Berk.logAbs, Berk.homeomorphOfAlgEquiv_val_apply,
    ← affineChartEquiv_quotChartMk hφ hτ, AlgEquiv.symm_apply_apply, chartHomeomorph_apply,
    ← Berk.logAbs]
  exact logAbs_chartMap_quotChartMk v.1 v.2 (by rwa [mul_one])

/-- **`lem:wu-proj-chart`(4)**: the identification maps the trivial valuation of `S'' = R_M / I`
to the trivial valuation `v_triv` of `A`. -/
theorem affineChart_triv (hφ : IsReesPresentation k X.ideal φ e j₀) :
    X.affineChart hφ ⟨X.triv, by rw [triv_val_of_notMem X hφ.X_notMem]; exact one_ne_zero⟩ =
      Berk.triv :=
  homeomorphOfAlgEquiv_chartMap_triv (MvPolynomial.isHomogeneous_X k j₀) hφ.X_notMem
    (affineChartEquiv hφ)

end ProjSubvariety

end EnvelopeProperty
