import EnvelopeProperty.Projective.EnvelopeCriterion

/-!
# The ideals `J_m` of an obstacle on `(ℙⁿ)^an`

Let `R = k[x₀, …, xₙ]` and let `R[t]` be the coordinate ring of `S = ℙⁿ × 𝔸¹` (in the model of
`EnvelopeProperty.Projective.Basic`, `(MvPolynomial (Fin (n + 1)) k)[X]`, with `t = X`). For an
integer `d > 0` and an obstacle `φ : (ℙⁿ)^an → ℝ`, Fang–Han–Xia, *The envelope property for
unibranch projective varieties*, §3 (`sec:smooth`) consider the graded sequence of ideals `J_m` on
`S`; on `ℙⁿ` these can be defined directly from the obstacle, without test configurations
(blueprint `def:bj-Jm`, `rmk:bj-test-configurations`):

* `V_m(φ) ⊆ R_{md}[t]` is the set of `g`, homogeneous of `x`-degree `md`, with
  `log|g|_{σ(v)} ≤ m φ(v)` for all `v ∈ (ℙⁿ)^an`, where `σ(v)` is the Gauss extension
  (`ProjBerk.obstacleSpace`);
* `J_m(φ) ⊆ R[t]` is the ideal generated by `V_m(φ)` (`ProjBerk.obstacleIdeal`).

## Main results

* `lem:bj-Jm-basic`:
  - `V_m(φ)` is a `k[t]`-submodule (`ProjBerk.obstacleSpace` is a `k`-submodule, and
    `ProjBerk.map_mul_mem_obstacleSpace`, `ProjBerk.X_mul_mem_obstacleSpace`);
  - `V_m V_r ⊆ V_{m+r}` (`ProjBerk.mul_mem_obstacleSpace`), hence `J_m J_r ⊆ J_{m+r}`
    (`ProjBerk.obstacleIdeal_mul_le`) and `J_m^r ⊆ J_{mr}` (`ProjBerk.obstacleIdeal_pow_le`);
  - the `t`-homogeneous parts of elements of `V_m` lie in `V_m`
    (`ProjBerk.monomial_coeff_mem_obstacleSpace`), so `J_m` is bihomogeneous
    (`ProjBerk.obstacleIdeal_eq_span_monomial`) and `J_q^r` is generated by bihomogeneous elements
    of `x`-degree `qrd` (`ProjBerk.exists_obstacleIdeal_pow_eq_span`);
  - for `φ` bounded below, `J_m ≠ 0` (`ProjBerk.obstacleIdeal_ne_bot`) and
    `m⁻¹ φ_{J_m} ∈ H_ℚ(d)` is a finite-valued rational Fubini–Study function
    (`ProjBerk.isFiniteRatFS_obstacleIdeal`), with `m⁻¹ φ_{J_m} ≤ φ`
    (`ProjBerk.inv_mul_phiIdeal_obstacleIdeal_le`).
* `prop:bj-envelope-Jm` (FHX `prop:ample-envelopes`, BJ addendum envline): for `φ` lsc with
  `φ(v_triv) ≤ 0`, `P_d(φ) = sup_{m ≥ 1} m⁻¹ φ_{J_m(φ)}` pointwise
  (`ProjBerk.envelope_eq_iSup_obstacleIdeal`), and `m⁻¹ φ_{J_m} ≤ (mr)⁻¹ φ_{J_{mr}}`
  (`ProjBerk.inv_mul_phiIdeal_obstacleIdeal_le_mul`).

The Fubini–Study property is a special case of `ProjBerk.isRatFS_inv_mul_phiIdeal`: if an ideal
`I ≠ 0` of `R[t]` is generated by elements whose `t`-coefficients are forms of degree `≤ m d`,
then `m⁻¹ φ_I ∈ H^gf_ℚ(d)`; the generators of lower degree are padded with the monomials `xᵢ^c`,
using `max_i log|xᵢ| = 0` (`ProjBerk.sup_termVal_mul_X_pow`). This is also the form in which the
asymptotic test ideals of FHX §3 enter (blueprint `rmk:bj-pn-ep-assembly`, step (b)).

## Deviations from the blueprint

* `prop:bj-envelope-Jm` assumes `φ` lsc and `φ(v_triv) ≤ 0` instead of `φ` bounded, lsc and
  `φ ≤ 0`: only the value at `v_triv` enters the proof (through `λ_ℓ ≤ M ψ(v_triv) ≤ M φ(v_triv)`),
  and the boundedness is not needed (if `J_m = 0` then `m⁻¹ φ_{J_m} = -∞`).
* `V_m(φ)` is a `k`-submodule of `R[t]`; its stability under `k[t]` is
  `ProjBerk.map_mul_mem_obstacleSpace` (multiplication by the image of `q ∈ k[t]`).
-/

open scoped NNReal ENNReal Topology Polynomial

open Set Topology

noncomputable section

namespace EnvelopeProperty

/-! ### Homogeneity in the `x`-variables -/

section XHomogeneous

variable {σ R : Type*} [CommSemiring R]

/-- An element `g = ∑_ℓ g_ℓ t^ℓ` of `R[x][t]` is **homogeneous of `x`-degree `e`** if every
coefficient `g_ℓ` is a form of degree `e`. -/
def IsXHomogeneous (g : (MvPolynomial σ R)[X]) (e : ℕ) : Prop :=
  ∀ ℓ, (g.coeff ℓ).IsHomogeneous e

namespace IsXHomogeneous

theorem zero (e : ℕ) : IsXHomogeneous (0 : (MvPolynomial σ R)[X]) e := fun ℓ => by
  rw [Polynomial.coeff_zero]
  exact MvPolynomial.isHomogeneous_zero _ _ _

theorem add {g h : (MvPolynomial σ R)[X]} {e : ℕ} (hg : IsXHomogeneous g e)
    (hh : IsXHomogeneous h e) : IsXHomogeneous (g + h) e := fun ℓ => by
  rw [Polynomial.coeff_add]
  exact (hg ℓ).add (hh ℓ)

theorem mul {g h : (MvPolynomial σ R)[X]} {e e' : ℕ} (hg : IsXHomogeneous g e)
    (hh : IsXHomogeneous h e') : IsXHomogeneous (g * h) (e + e') := fun ℓ => by
  rw [Polynomial.coeff_mul]
  exact MvPolynomial.IsHomogeneous.sum _ _ _ fun x _ => (hg x.1).mul (hh x.2)

theorem C_mul_X_pow {s : MvPolynomial σ R} {e : ℕ} (hs : s.IsHomogeneous e) (ℓ : ℕ) :
    IsXHomogeneous (Polynomial.C s * Polynomial.X ^ ℓ) e := fun j => by
  rw [Polynomial.coeff_C_mul_X_pow]
  split_ifs
  · exact hs
  · exact MvPolynomial.isHomogeneous_zero _ _ _

theorem monomial {s : MvPolynomial σ R} {e : ℕ} (hs : s.IsHomogeneous e) (ℓ : ℕ) :
    IsXHomogeneous (Polynomial.monomial ℓ s) e := by
  rw [← Polynomial.C_mul_X_pow_eq_monomial]
  exact C_mul_X_pow hs ℓ

theorem one : IsXHomogeneous (1 : (MvPolynomial σ R)[X]) 0 := by
  simpa using C_mul_X_pow (MvPolynomial.isHomogeneous_one σ R) 0

/-- Elements of `R[t]` coming from `k[t]` have `x`-degree `0`. -/
theorem map_C (q : R[X]) : IsXHomogeneous (q.map (MvPolynomial.C (σ := σ))) 0 := fun ℓ => by
  rw [Polynomial.coeff_map]
  exact MvPolynomial.isHomogeneous_C σ _

theorem pow {g : (MvPolynomial σ R)[X]} {e : ℕ} (hg : IsXHomogeneous g e) :
    ∀ r : ℕ, IsXHomogeneous (g ^ r) (r * e)
  | 0 => by simpa using one
  | r + 1 => by
    rw [pow_succ, add_mul, one_mul]
    exact (pow hg r).mul hg

end IsXHomogeneous

end XHomogeneous

namespace ProjBerk

universe u

variable {k : Type u} [Field k] {n : ℕ}

/-! ### Values at the Gauss extension -/

/-- `log|s t^ℓ|_{σ(v)} = log|s|_v - ℓ`. -/
theorem logAbs_C_mul_X_pow_gaussExt (s : MvPolynomial (Fin (n + 1)) k) (ℓ : ℕ)
    (v : ProjBerk k n) :
    Berk.logAbs (Polynomial.C s * Polynomial.X ^ ℓ) (gaussExt v) = logAbs s v - ℓ := by
  rw [Berk.logAbs_mul, logAbs_C_gaussExt, Berk.logAbs_pow, logAbs_X_gaussExt, mul_neg_one,
    sub_eq_add_neg]

/-- `log|g_ℓ|_v - ℓ ≤ log|g|_{σ(v)}` (the Gauss formula). -/
theorem logAbs_coeff_sub_le_logAbs_gaussExt (F : (MvPolynomial (Fin (n + 1)) k)[X]) (ℓ : ℕ)
    (v : ProjBerk k n) : logAbs (F.coeff ℓ) v - ℓ ≤ Berk.logAbs F (gaussExt v) := by
  have h := Berk.logAbs_coeff_add_le_logAbs_gauss v.1 gaussRadius F ℓ
  rwa [log_gaussRadius, mul_neg_one, ← sub_eq_add_neg] at h

/-- Padding with monomials: `max_i (log|s xᵢ^a| + λ) = log|s| + λ`, since `max_i log|xᵢ| = 0`. -/
theorem sup_termVal_mul_X_pow (s : MvPolynomial (Fin (n + 1)) k) (a : ℕ) (c : ℝ)
    (v : ProjBerk k n) :
    Finset.univ.sup (fun i => termVal (s * MvPolynomial.X i ^ a, c) v) =
      logAbs s v + (c : EReal) := by
  refine le_antisymm (Finset.sup_le fun i _ => ?_) ?_
  · rw [termVal_def, logAbs_mul]
    gcongr
    calc logAbs s v + logAbs (MvPolynomial.X i ^ a) v ≤ logAbs s v + 0 := by
          gcongr
          exact logAbs_le_zero _ v
      _ = logAbs s v := add_zero _
  · obtain ⟨j, hj⟩ := exists_val_X_eq_one v
    refine le_trans (le_of_eq ?_) (Finset.le_sup
      (f := fun i => termVal (s * MvPolynomial.X i ^ a, c) v) (Finset.mem_univ j))
    rw [termVal_def, logAbs_mul, logAbs_def (MvPolynomial.X j ^ a), map_pow, hj, one_pow,
      ENNReal.coe_one, ENNReal.log_one, add_zero]

/-! ### Ideals generated in bounded `x`-degree give Fubini–Study functions -/

/-- A nonzero form `c` homogeneous of degree `≤ D` is homogeneous of degree `totalDegree c ≤ D`;
for `c = 0` this holds trivially. -/
theorem isHomogeneous_totalDegree_of_le {c : MvPolynomial (Fin (n + 1)) k} {e D : ℕ}
    (hc : c.IsHomogeneous e) (he : e ≤ D) :
    c.IsHomogeneous c.totalDegree ∧ c.totalDegree ≤ D := by
  by_cases h0 : c = 0
  · subst h0
    exact ⟨MvPolynomial.isHomogeneous_zero _ _ _, by simp⟩
  · rw [hc.totalDegree h0]
    exact ⟨hc, he⟩

open Classical in
/-- The Fubini–Study data of `m⁻¹ φ_I` for an ideal generated by a finite set `T` whose elements
have `t`-coefficients of degree `≤ m d`: the terms are `(g_ℓ xᵢ^{md - deg g_ℓ}, -ℓ)`. -/
def phiIdealTerms (m d : ℕ) (T : Finset (MvPolynomial (Fin (n + 1)) k)[X]) :
    Finset (MvPolynomial (Fin (n + 1)) k × ℝ) :=
  T.biUnion fun g => g.support.biUnion fun ℓ => Finset.univ.image fun i =>
    (g.coeff ℓ * MvPolynomial.X i ^ (m * d - (g.coeff ℓ).totalDegree), -(ℓ : ℝ))

theorem sup_termVal_phiIdealTerms (m d : ℕ) (T : Finset (MvPolynomial (Fin (n + 1)) k)[X])
    (v : ProjBerk k n) :
    (phiIdealTerms m d T).sup (fun t => termVal t v) =
      phiIdeal (Ideal.span (T : Set (MvPolynomial (Fin (n + 1)) k)[X])) v := by
  classical
  rw [phiIdeal_span_finset, phiIdealTerms, Finset.sup_biUnion]
  refine Finset.sup_congr rfl fun g _ => ?_
  rw [Finset.sup_biUnion, logAbs_gaussExt]
  refine Finset.sup_congr rfl fun ℓ _ => ?_
  rw [Finset.sup_image]
  refine (sup_termVal_mul_X_pow _ _ _ v).trans ?_
  rw [EReal.coe_neg, ← sub_eq_add_neg]
  rfl

/-- **Ideals generated in bounded `x`-degree** (blueprint `lem:bj-Jm-basic`, and the padding
step (b) of `rmk:bj-pn-ep-assembly`): if `I ≠ 0` is generated by a set `S` of elements of `R[t]`
whose `t`-coefficients are forms of degree `≤ m d`, then `m⁻¹ φ_I ∈ H^gf_ℚ(d)`, with integer
weights. Indeed `R[t]` is Noetherian, so `I` is generated by a finite `T ⊆ S`, and
`φ_I = max_{g ∈ T} max_ℓ (log|g_ℓ| - ℓ) = max_{g, ℓ, i} (log|g_ℓ xᵢ^{md - deg g_ℓ}| - ℓ)`. -/
theorem isRatFS_inv_mul_phiIdeal {m d : ℕ} (hm : 0 < m)
    {I : Ideal (MvPolynomial (Fin (n + 1)) k)[X]} {S : Set (MvPolynomial (Fin (n + 1)) k)[X]}
    (hIS : I = Ideal.span S) (hS : ∀ g ∈ S, ∀ ℓ, ∃ e ≤ m * d, (g.coeff ℓ).IsHomogeneous e)
    (hI : I ≠ ⊥) :
    IsRatFS (d : ℚ) fun v => (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal I v := by
  classical
  obtain ⟨T, hTS, hT⟩ := (Submodule.fg_span_iff_fg_span_finset_subset S).1
    (hIS ▸ IsNoetherian.noetherian I)
  have hIT : I = Ideal.span (T : Set (MvPolynomial (Fin (n + 1)) k)[X]) := hIS.trans hT
  have hne : ∃ t ∈ phiIdealTerms m d T, t.1 ≠ 0 := by
    have hT0 : ¬ ∀ g ∈ (T : Set (MvPolynomial (Fin (n + 1)) k)[X]), g = 0 := by
      rw [← Ideal.span_eq_bot, ← hIT]
      exact hI
    push Not at hT0
    obtain ⟨g, hgT, hg0⟩ := hT0
    obtain ⟨ℓ, hℓ⟩ := Polynomial.support_nonempty.2 hg0
    refine ⟨_, Finset.mem_biUnion.2 ⟨g, hgT, Finset.mem_biUnion.2 ⟨ℓ, hℓ,
      Finset.mem_image_of_mem _ (Finset.mem_univ 0)⟩⟩, ?_⟩
    exact mul_ne_zero (Polynomial.mem_support_iff.1 hℓ)
      (pow_ne_zero _ (MvPolynomial.X_ne_zero 0))
  let D : FSData k n (d : ℚ) :=
    { m := m
      m_pos := hm
      deg := m * d
      deg_eq := by push_cast; ring
      terms := phiIdealTerms m d T
      isHomogeneous := by
        intro t ht
        simp only [phiIdealTerms, Finset.mem_biUnion, Finset.mem_image] at ht
        obtain ⟨g, hgT, ℓ, -, i, -, rfl⟩ := ht
        obtain ⟨e, he, hce⟩ := hS g (hTS hgT) ℓ
        obtain ⟨h1, h2⟩ := isHomogeneous_totalDegree_of_le hce he
        have := h1.mul (MvPolynomial.isHomogeneous_X_pow i (m * d - (g.coeff ℓ).totalDegree))
        rwa [Nat.add_sub_cancel' h2] at this
      exists_ne_zero := hne }
  refine ⟨D, ?_, funext fun v => ?_⟩
  · intro t ht
    simp only [D, phiIdealTerms, Finset.mem_biUnion, Finset.mem_image] at ht
    obtain ⟨g, -, ℓ, -, i, -, rfl⟩ := ht
    exact ⟨-(ℓ : ℚ), by push_cast; ring⟩
  · rw [FSData.eval_def]
    change _ = (((m : ℝ)⁻¹ : ℝ) : EReal) * (phiIdealTerms m d T).sup fun t => termVal t v
    rw [sup_termVal_phiIdealTerms, ← hIT]

/-! ### The spaces `V_m(φ)` and the ideals `J_m(φ)` -/

/-- Scalars from `k` do not increase absolute values: `log|a g|_{σ(v)} ≤ log|g|_{σ(v)}`. -/
theorem logAbs_smul_gaussExt_le (a : k) (g : (MvPolynomial (Fin (n + 1)) k)[X])
    (v : ProjBerk k n) : Berk.logAbs (a • g) (gaussExt v) ≤ Berk.logAbs g (gaussExt v) := by
  rw [Algebra.smul_def, Berk.logAbs_mul]
  calc Berk.logAbs (algebraMap k _ a) (gaussExt v) + Berk.logAbs g (gaussExt v)
      ≤ 0 + Berk.logAbs g (gaussExt v) := by
        gcongr
        exact Berk.logAbs_algebraMap_le_zero _ a
    _ = _ := zero_add _

variable (k n) in
/-- **The space `V_m(φ)`** (blueprint `def:bj-Jm`): the elements `g ∈ R[t]` homogeneous of
`x`-degree `m d` with `log|g|_{σ(v)} ≤ m φ(v)` for all `v ∈ (ℙⁿ)^an`. It is a `k`-submodule of
`R[t]`, stable under multiplication by `k[t]` (`map_mul_mem_obstacleSpace`). -/
def obstacleSpace (d : ℕ) (φ : ProjBerk k n → ℝ) (m : ℕ) :
    Submodule k (MvPolynomial (Fin (n + 1)) k)[X] where
  carrier := {g | IsXHomogeneous g (m * d) ∧
    ∀ v, Berk.logAbs g (gaussExt v) ≤ (((m : ℝ) * φ v : ℝ) : EReal)}
  add_mem' := by
    rintro g h ⟨hg, hg'⟩ ⟨hh, hh'⟩
    exact ⟨hg.add hh, fun v => (Berk.logAbs_add_le g h _).trans (max_le (hg' v) (hh' v))⟩
  zero_mem' := ⟨IsXHomogeneous.zero _, fun v => by simp⟩
  smul_mem' := by
    rintro a g ⟨hg, hg'⟩
    refine ⟨fun ℓ => ?_, fun v => (logAbs_smul_gaussExt_le a g v).trans (hg' v)⟩
    rw [Polynomial.coeff_smul, MvPolynomial.smul_eq_C_mul]
    exact (hg ℓ).C_mul a

variable (k n) in
/-- **The ideal `J_m(φ)`** (blueprint `def:bj-Jm`): the ideal of `R[t]` generated by `V_m(φ)`. -/
def obstacleIdeal (d : ℕ) (φ : ProjBerk k n → ℝ) (m : ℕ) :
    Ideal (MvPolynomial (Fin (n + 1)) k)[X] :=
  Ideal.span (obstacleSpace k n d φ m)

variable {d : ℕ} {φ : ProjBerk k n → ℝ} {m r : ℕ} {g h : (MvPolynomial (Fin (n + 1)) k)[X]}

theorem mem_obstacleSpace :
    g ∈ obstacleSpace k n d φ m ↔ IsXHomogeneous g (m * d) ∧
      ∀ v, Berk.logAbs g (gaussExt v) ≤ (((m : ℝ) * φ v : ℝ) : EReal) :=
  Iff.rfl

theorem obstacleSpace_subset_obstacleIdeal :
    (obstacleSpace k n d φ m : Set (MvPolynomial (Fin (n + 1)) k)[X]) ⊆ obstacleIdeal k n d φ m :=
  Ideal.subset_span

theorem mem_obstacleIdeal_of_mem (hg : g ∈ obstacleSpace k n d φ m) :
    g ∈ obstacleIdeal k n d φ m :=
  Ideal.subset_span hg

/-- `V_m(φ)` is stable under multiplication by `k[t]` (blueprint `lem:bj-Jm-basic`). -/
theorem map_mul_mem_obstacleSpace (q : k[X]) (hg : g ∈ obstacleSpace k n d φ m) :
    q.map (MvPolynomial.C (σ := Fin (n + 1))) * g ∈ obstacleSpace k n d φ m := by
  refine ⟨by simpa using (IsXHomogeneous.map_C q).mul hg.1, fun v => ?_⟩
  rw [Berk.logAbs_mul]
  calc Berk.logAbs (q.map MvPolynomial.C) (gaussExt v) + Berk.logAbs g (gaussExt v)
      ≤ 0 + Berk.logAbs g (gaussExt v) := by
        gcongr
        exact logAbs_gaussExt_le_zero v _
    _ = Berk.logAbs g (gaussExt v) := zero_add _
    _ ≤ _ := hg.2 v

theorem X_mul_mem_obstacleSpace (hg : g ∈ obstacleSpace k n d φ m) :
    Polynomial.X * g ∈ obstacleSpace k n d φ m := by
  simpa using map_mul_mem_obstacleSpace Polynomial.X hg

/-- `V_m V_r ⊆ V_{m+r}` (blueprint `lem:bj-Jm-basic`). -/
theorem mul_mem_obstacleSpace (hg : g ∈ obstacleSpace k n d φ m)
    (hh : h ∈ obstacleSpace k n d φ r) : g * h ∈ obstacleSpace k n d φ (m + r) := by
  refine ⟨by rw [add_mul]; exact hg.1.mul hh.1, fun v => ?_⟩
  rw [Berk.logAbs_mul]
  calc Berk.logAbs g (gaussExt v) + Berk.logAbs h (gaussExt v)
      ≤ (((m : ℝ) * φ v : ℝ) : EReal) + (((r : ℝ) * φ v : ℝ) : EReal) :=
        add_le_add (hg.2 v) (hh.2 v)
    _ = ((((m + r : ℕ) : ℝ) * φ v : ℝ) : EReal) := by
        rw [← EReal.coe_add]
        congr 1
        push_cast
        ring

theorem one_mem_obstacleSpace_zero : (1 : (MvPolynomial (Fin (n + 1)) k)[X]) ∈
    obstacleSpace k n d φ 0 :=
  ⟨by simpa using IsXHomogeneous.one, fun v => by simp⟩

/-- `J_0 = R[t]`. -/
@[simp]
theorem obstacleIdeal_zero : obstacleIdeal k n d φ 0 = ⊤ :=
  (Ideal.eq_top_iff_one _).2 (mem_obstacleIdeal_of_mem one_mem_obstacleSpace_zero)

/-- `J_m J_r ⊆ J_{m+r}`: `(J_m)` is a graded sequence of ideals (blueprint `lem:bj-Jm-basic`). -/
theorem obstacleIdeal_mul_le (m r : ℕ) :
    obstacleIdeal k n d φ m * obstacleIdeal k n d φ r ≤ obstacleIdeal k n d φ (m + r) := by
  rw [obstacleIdeal, obstacleIdeal, Ideal.span_mul_span', Ideal.span_le]
  rintro _ ⟨a, ha, b, hb, rfl⟩
  exact mem_obstacleIdeal_of_mem (mul_mem_obstacleSpace ha hb)

/-- `J_m^r ⊆ J_{mr}`. -/
theorem obstacleIdeal_pow_le (m r : ℕ) :
    obstacleIdeal k n d φ m ^ r ≤ obstacleIdeal k n d φ (m * r) := by
  induction r with
  | zero => simp
  | succ r ih =>
    rw [pow_succ (obstacleIdeal k n d φ m) r, mul_add, mul_one]
    exact (Ideal.mul_mono_left ih).trans (obstacleIdeal_mul_le _ _)

/-- The `t`-homogeneous parts of an element of `V_m` lie in `V_m`, by the Gauss formula
(blueprint `lem:bj-Jm-basic`). -/
theorem monomial_coeff_mem_obstacleSpace (hg : g ∈ obstacleSpace k n d φ m) (ℓ : ℕ) :
    Polynomial.monomial ℓ (g.coeff ℓ) ∈ obstacleSpace k n d φ m := by
  refine ⟨IsXHomogeneous.monomial (hg.1 ℓ) ℓ, fun v => ?_⟩
  rw [← Polynomial.C_mul_X_pow_eq_monomial, logAbs_C_mul_X_pow_gaussExt]
  exact (logAbs_coeff_sub_le_logAbs_gaussExt g ℓ v).trans (hg.2 v)

/-- `J_m` is **bihomogeneous**: it is generated by the bihomogeneous elements `s t^ℓ` of `V_m`
(blueprint `lem:bj-Jm-basic`). -/
theorem obstacleIdeal_eq_span_monomial :
    obstacleIdeal k n d φ m = Ideal.span {g | g ∈ obstacleSpace k n d φ m ∧
      ∃ ℓ s, g = Polynomial.monomial ℓ s} := by
  refine le_antisymm (Ideal.span_le.2 fun g hg => ?_) (Ideal.span_mono fun g hg => hg.1)
  rw [SetLike.mem_coe, Polynomial.as_sum_support g]
  exact Ideal.sum_mem _ fun ℓ _ => Ideal.subset_span
    ⟨monomial_coeff_mem_obstacleSpace hg ℓ, ℓ, _, rfl⟩

/-- `J_q^r` is generated by bihomogeneous elements `s t^ℓ` with `s` a form of degree `q r d`
(blueprint `lem:bj-Jm-basic`). -/
theorem exists_obstacleIdeal_pow_eq_span (q : ℕ) : ∀ r : ℕ,
    ∃ S : Set (MvPolynomial (Fin (n + 1)) k)[X], obstacleIdeal k n d φ q ^ r = Ideal.span S ∧
      ∀ g ∈ S, ∃ ℓ s, g = Polynomial.monomial ℓ s ∧ s.IsHomogeneous (r * (q * d))
  | 0 => ⟨{1}, by simp, fun g hg => ⟨0, 1, by simpa using hg, by
      simpa using MvPolynomial.isHomogeneous_one (Fin (n + 1)) k⟩⟩
  | r + 1 => by
    obtain ⟨S, hS, hS'⟩ := exists_obstacleIdeal_pow_eq_span q r
    refine ⟨Set.image2 (· * ·) S
      {g | g ∈ obstacleSpace k n d φ q ∧ ∃ ℓ s, g = Polynomial.monomial ℓ s}, ?_, ?_⟩
    · rw [pow_succ (obstacleIdeal k n d φ q) r, hS, obstacleIdeal_eq_span_monomial,
        Ideal.span_mul_span']
      rfl
    · rintro _ ⟨a, ha, b, ⟨hb, ℓ', s', rfl⟩, rfl⟩
      obtain ⟨ℓ, s, rfl, hs⟩ := hS' a ha
      refine ⟨ℓ + ℓ', s * s', Polynomial.monomial_mul_monomial _ _ _ _, ?_⟩
      have h2 : s'.IsHomogeneous (q * d) := by simpa using hb.1 ℓ'
      rw [add_mul, one_mul]
      exact hs.mul h2

/-! ### Nonvanishing, Fubini–Study property and the bound `m⁻¹ φ_{J_m} ≤ φ` -/

/-- If `m φ ≥ -N` then `xᵢ^{md} t^N ∈ V_m(φ)`. -/
theorem C_X_pow_mul_X_pow_mem_obstacleSpace {N : ℕ} (hN : ∀ v, -(N : ℝ) ≤ m * φ v)
    (i : Fin (n + 1)) :
    Polynomial.C (MvPolynomial.X i ^ (m * d)) * Polynomial.X ^ N ∈ obstacleSpace k n d φ m := by
  refine ⟨IsXHomogeneous.C_mul_X_pow (MvPolynomial.isHomogeneous_X_pow i _) N, fun v => ?_⟩
  rw [logAbs_C_mul_X_pow_gaussExt]
  calc logAbs (MvPolynomial.X i ^ (m * d)) v - (N : EReal) ≤ 0 - (N : EReal) := by
        rw [sub_eq_add_neg, sub_eq_add_neg]
        exact add_le_add_left (logAbs_le_zero _ v) _
    _ = ((-(N : ℝ) : ℝ) : EReal) := by rw [zero_sub, EReal.coe_neg]; rfl
    _ ≤ _ := EReal.coe_le_coe_iff.2 (hN v)

/-- For `φ ≥ C`, the integer `N = ⌈-m C⌉₊` satisfies `m φ ≥ -N`. -/
theorem neg_ceil_le_mul {C : ℝ} (hC : ∀ v, C ≤ φ v) (m : ℕ) (v : ProjBerk k n) :
    -((⌈-((m : ℝ) * C)⌉₊ : ℕ) : ℝ) ≤ m * φ v := by
  have h1 := Nat.le_ceil (-((m : ℝ) * C))
  have h2 : (m : ℝ) * C ≤ m * φ v := mul_le_mul_of_nonneg_left (hC v) (Nat.cast_nonneg m)
  linarith

/-- `J_m ≠ 0` for `φ` bounded below (blueprint `lem:bj-Jm-basic`). -/
theorem obstacleIdeal_ne_bot {C : ℝ} (hC : ∀ v, C ≤ φ v) (m : ℕ) :
    obstacleIdeal k n d φ m ≠ ⊥ := by
  intro h
  have hmem := mem_obstacleIdeal_of_mem
    (C_X_pow_mul_X_pow_mem_obstacleSpace (d := d) (neg_ceil_le_mul hC m) 0)
  rw [h, Ideal.mem_bot] at hmem
  exact mul_ne_zero (Polynomial.C_ne_zero.2 (pow_ne_zero _ (MvPolynomial.X_ne_zero 0)))
    (pow_ne_zero _ Polynomial.X_ne_zero) hmem

/-- `φ_{J_m} > -∞` everywhere for `φ` bounded below: at `v` choose `xⱼ` with `|xⱼ|_v = 1`, then
`log|xⱼ^{md} t^N|_{σ(v)} = -N`. -/
theorem phiIdeal_obstacleIdeal_ne_bot {C : ℝ} (hC : ∀ v, C ≤ φ v) (m : ℕ) (v : ProjBerk k n) :
    phiIdeal (obstacleIdeal k n d φ m) v ≠ ⊥ := by
  obtain ⟨j, hj⟩ := exists_val_X_eq_one v
  refine ne_bot_of_le_ne_bot ?_ (le_phiIdeal _ v (mem_obstacleIdeal_of_mem
    (C_X_pow_mul_X_pow_mem_obstacleSpace (d := d) (neg_ceil_le_mul hC m) j)))
  rw [logAbs_C_mul_X_pow_gaussExt, logAbs_def (MvPolynomial.X j ^ (m * d)), map_pow, hj, one_pow,
    ENNReal.coe_one, ENNReal.log_one, zero_sub]
  rw [Ne, EReal.neg_eq_bot_iff]
  exact EReal.natCast_ne_top _

/-- `φ_{J_m} ≤ m φ`. -/
theorem phiIdeal_obstacleIdeal_le (v : ProjBerk k n) :
    phiIdeal (obstacleIdeal k n d φ m) v ≤ (((m : ℝ) * φ v : ℝ) : EReal) := by
  rw [obstacleIdeal, phiIdeal_span]
  exact iSup₂_le fun g hg => hg.2 v

/-- `m⁻¹ φ_{J_m} ≤ φ` for `m > 0` (blueprint `lem:bj-Jm-basic`). -/
theorem inv_mul_phiIdeal_obstacleIdeal_le (hm : 0 < m) (v : ProjBerk k n) :
    (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (obstacleIdeal k n d φ m) v ≤ (φ v : EReal) := by
  have hm' : (m : ℝ) ≠ 0 := Nat.cast_ne_zero.2 hm.ne'
  calc (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (obstacleIdeal k n d φ m) v
      ≤ (((m : ℝ)⁻¹ : ℝ) : EReal) * (((m : ℝ) * φ v : ℝ) : EReal) :=
        ereal_coe_mul_monotone (inv_nonneg.2 (Nat.cast_nonneg m)) (phiIdeal_obstacleIdeal_le v)
    _ = (φ v : EReal) := by rw [← EReal.coe_mul, inv_mul_cancel_left₀ hm']

/-- `m⁻¹ φ_{J_m} ∈ H^gf_ℚ(d)` as soon as `J_m ≠ 0`, for `m > 0`. -/
theorem isRatFS_obstacleIdeal (hm : 0 < m) (hne : obstacleIdeal k n d φ m ≠ ⊥) :
    IsRatFS (d : ℚ) fun v =>
      (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (obstacleIdeal k n d φ m) v :=
  isRatFS_inv_mul_phiIdeal hm rfl (fun _ hg ℓ => ⟨m * d, le_rfl, hg.1 ℓ⟩) hne

/-- **`m⁻¹ φ_{J_m} ∈ H_ℚ(d)`** (blueprint `lem:bj-Jm-basic`): for `φ` bounded below and `m > 0`,
`m⁻¹ φ_{J_m}` is a finite-valued rational Fubini–Study function for `O(d)` (with integer weights,
`φ_{J_m} = max_{ℓ, λ} (log|s_{ℓλ}| - λ)` for finitely many generators `∑_λ s_{ℓλ} t^λ ∈ V_m`). -/
theorem isFiniteRatFS_obstacleIdeal {C : ℝ} (hC : ∀ v, C ≤ φ v) (hm : 0 < m) :
    IsFiniteRatFS (d : ℚ) fun v =>
      (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (obstacleIdeal k n d φ m) v :=
  ⟨isRatFS_obstacleIdeal hm (obstacleIdeal_ne_bot hC m), fun v =>
    ereal_coe_mul_ne_bot (inv_nonneg.2 (Nat.cast_nonneg m)) (phiIdeal_obstacleIdeal_ne_bot hC m v)⟩

/-! ### Envelopes of obstacles (`prop:bj-envelope-Jm`) -/

/-- **Monotonicity** (blueprint `prop:bj-envelope-Jm`): `m⁻¹ φ_{J_m} ≤ (mr)⁻¹ φ_{J_{mr}}` for
`m, r > 0`, from `J_m^r ⊆ J_{mr}` and `φ_{I^r} = r φ_I`. -/
theorem inv_mul_phiIdeal_obstacleIdeal_le_mul (hm : 0 < m) (hr : 0 < r) (v : ProjBerk k n) :
    (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (obstacleIdeal k n d φ m) v ≤
      ((((m * r : ℕ) : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (obstacleIdeal k n d φ (m * r)) v := by
  have hm' : (m : ℝ) ≠ 0 := Nat.cast_ne_zero.2 hm.ne'
  have hr' : (r : ℝ) ≠ 0 := Nat.cast_ne_zero.2 hr.ne'
  have h1 : (r : EReal) * phiIdeal (obstacleIdeal k n d φ m) v ≤
      phiIdeal (obstacleIdeal k n d φ (m * r)) v := by
    rw [← phiIdeal_pow]
    exact phiIdeal_mono v (obstacleIdeal_pow_le m r)
  calc (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (obstacleIdeal k n d φ m) v
      = ((((m * r : ℕ) : ℝ)⁻¹ : ℝ) : EReal) *
          (((r : ℝ) : EReal) * phiIdeal (obstacleIdeal k n d φ m) v) := by
        rw [ereal_coe_mul_coe_mul]
        congr 2
        push_cast
        field_simp
    _ ≤ _ := ereal_coe_mul_monotone (inv_nonneg.2 (Nat.cast_nonneg _)) h1

/-- `m⁻¹ φ_{J_m} ≤ P_d(φ)` for `m > 0`: it is `-∞` if `J_m = 0`, and otherwise a Fubini–Study
function for `O(d)` below `φ`. -/
theorem inv_mul_phiIdeal_obstacleIdeal_le_envelope (hm : 0 < m) (v : ProjBerk k n) :
    (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (obstacleIdeal k n d φ m) v ≤
      envelope (d : ℝ) (fun w => (φ w : EReal)) v := by
  by_cases hne : obstacleIdeal k n d φ m = ⊥
  · have hpos : (0 : EReal) < (((m : ℝ)⁻¹ : ℝ) : EReal) :=
      EReal.coe_pos.2 (inv_pos.2 (Nat.cast_pos.2 hm))
    rw [hne, phiIdeal_bot, EReal.mul_bot_of_pos hpos]
    exact bot_le
  · have h := (isRatFS_obstacleIdeal hm hne).isPSH
    rw [Rat.cast_natCast] at h
    exact le_envelope h (inv_mul_phiIdeal_obstacleIdeal_le hm) v

/-- A common denominator: finitely many rationals become integers after multiplication by some
`N > 0`. -/
theorem exists_pos_nat_mul_eq_int {α : Type*} (T : Finset α) (f : α → ℝ)
    (hf : ∀ t ∈ T, ∃ q : ℚ, f t = q) : ∃ N : ℕ, 0 < N ∧ ∀ t ∈ T, ∃ z : ℤ, (N : ℝ) * f t = z := by
  classical
  induction T using Finset.induction_on with
  | empty => exact ⟨1, one_pos, by simp⟩
  | insert a T _ ih =>
    obtain ⟨N, hN, hT⟩ := ih fun t ht => hf t (Finset.mem_insert_of_mem ht)
    obtain ⟨q, hq⟩ := hf a (Finset.mem_insert_self a T)
    refine ⟨N * q.den, Nat.mul_pos hN q.den_pos, fun t ht => ?_⟩
    rcases Finset.mem_insert.1 ht with rfl | ht
    · refine ⟨N * q.num, ?_⟩
      have h : (q.den : ℝ) * (q : ℝ) = (q.num : ℝ) := by
        exact_mod_cast congrArg (fun x : ℚ => (x : ℝ)) (Rat.den_mul_eq_num q)
      rw [hq]
      push_cast
      rw [mul_assoc, h]
    · obtain ⟨z, hz⟩ := hT t ht
      exact ⟨z * q.den, by push_cast; rw [← hz]; ring⟩

/-- The key step of `prop:bj-envelope-Jm`: if `ψ = M⁻¹ max_ℓ (log|s_ℓ| + λ_ℓ) ∈ H_ℚ(d)` satisfies
`ψ ≤ φ` and `φ(v_triv) ≤ 0`, then (after clearing denominators of the `λ_ℓ`) `λ_ℓ ≤ 0` for
`s_ℓ ≠ 0`, the `g_ℓ = s_ℓ t^{-λ_ℓ}` lie in `V_M(φ)`, and `ψ ≤ M⁻¹ φ_{J_M}`. -/
theorem exists_le_inv_mul_phiIdeal_obstacleIdeal (hφ0 : φ triv ≤ 0) {ψ : ProjBerk k n → EReal}
    (hψ : IsRatFS (d : ℚ) ψ) (hψφ : ∀ v, ψ v ≤ (φ v : EReal)) :
    ∃ M : ℕ, 0 < M ∧ ∀ v, ψ v ≤
      (((M : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (obstacleIdeal k n d φ M) v := by
  obtain ⟨D, hD, rfl⟩ := hψ
  obtain ⟨N, hN, hNz⟩ := exists_pos_nat_mul_eq_int D.terms (fun t => t.2) hD
  have hdeg : D.deg = D.m * d := by exact_mod_cast D.deg_eq
  have hNr : (0 : ℝ) < N := Nat.cast_pos.2 hN
  refine ⟨D.m * N, Nat.mul_pos D.m_pos hN, fun v => ?_⟩
  -- each term, multiplied by `N`, is bounded by `φ_{J_M}`
  have key : ∀ t ∈ D.terms, ((N : ℝ) : EReal) * termVal t v ≤
      phiIdeal (obstacleIdeal k n d φ (D.m * N)) v := by
    intro t ht
    by_cases ht0 : t.1 = 0
    · rw [termVal_def, ht0, logAbs_zero, EReal.bot_add, EReal.mul_bot_of_pos
        (EReal.coe_pos.2 hNr)]
      exact bot_le
    obtain ⟨z, hz⟩ := hNz t ht
    -- `λ_t ≤ 0`, by evaluation at `v_triv`
    have hlam : t.2 ≤ 0 := by
      have h1 := D.termVal_le_eval_mul triv ht
      rw [termVal_def, logAbs_triv_of_ne_zero ht0, zero_add, ← EReal.coe_mul] at h1
      have h2 : D.eval triv ≤ 0 := (hψφ triv).trans (EReal.coe_le_coe_iff.2 hφ0)
      have h3 : (D.m : ℝ)⁻¹ * t.2 ≤ 0 := EReal.coe_le_coe_iff.1 (h1.trans h2)
      exact nonpos_of_mul_nonpos_right h3 D.inv_m_pos
    have hz0 : z ≤ 0 := by
      have : (z : ℝ) ≤ 0 := hz ▸ mul_nonpos_of_nonneg_of_nonpos hNr.le hlam
      exact_mod_cast this
    have hcast : (((-z).toNat : ℕ) : ℝ) = -((N : ℝ) * t.2) := by
      rw [hz]
      have : (((-z).toNat : ℕ) : ℤ) = -z := Int.toNat_of_nonneg (by omega)
      exact_mod_cast this
    -- `g = s^N t^{-Nλ}` and `log|g|_{σ(w)} = N (log|s|_w + λ)`
    set g := Polynomial.C (t.1 ^ N) * Polynomial.X ^ (-z).toNat with hg_def
    have hlog : ∀ w, Berk.logAbs g (gaussExt w) = ((N : ℝ) : EReal) * termVal t w := by
      intro w
      rw [← termVal_pow, termVal_def, logAbs_C_mul_X_pow_gaussExt, sub_eq_add_neg]
      congr 1
      rw [show (((-z).toNat : ℕ) : EReal) = ((((-z).toNat : ℕ) : ℝ) : EReal) from rfl, hcast,
        EReal.coe_neg, neg_neg]
    have hgV : g ∈ obstacleSpace k n d φ (D.m * N) := by
      refine ⟨IsXHomogeneous.C_mul_X_pow ?_ _, fun w => ?_⟩
      · have := (D.isHomogeneous t ht).pow N
        rwa [hdeg, show D.m * d * N = D.m * N * d by ring] at this
      · rw [hlog w]
        have h1 : termVal t w ≤ ((D.m : ℝ) : EReal) * (φ w : EReal) := by
          have h2 := D.termVal_le_eval_mul w ht
          have h3 : ((D.m : ℝ) : EReal) * ((((D.m : ℝ)⁻¹ : ℝ) : EReal) * termVal t w) =
              termVal t w := by
            rw [ereal_coe_mul_coe_mul, mul_inv_cancel₀ D.m_ne_zero, EReal.coe_one, one_mul]
          rw [← h3]
          exact ereal_coe_mul_monotone (Nat.cast_nonneg _) (h2.trans (hψφ w))
        calc ((N : ℝ) : EReal) * termVal t w
            ≤ ((N : ℝ) : EReal) * (((D.m : ℝ) : EReal) * (φ w : EReal)) :=
              ereal_coe_mul_monotone hNr.le h1
          _ = ((((D.m * N : ℕ) : ℝ) * φ w : ℝ) : EReal) := by
              rw [← EReal.coe_mul, ← EReal.coe_mul]
              congr 1
              push_cast
              ring
    rw [← hlog v]
    exact le_phiIdeal _ v (mem_obstacleIdeal_of_mem hgV)
  have hsup : ((N : ℝ) : EReal) * D.terms.sup (fun t => termVal t v) ≤
      phiIdeal (obstacleIdeal k n d φ (D.m * N)) v := by
    rw [ereal_coe_mul_finset_sup hNr]
    exact Finset.sup_le key
  calc D.eval v = ((((D.m * N : ℕ) : ℝ)⁻¹ : ℝ) : EReal) *
        (((N : ℝ) : EReal) * D.terms.sup (fun t => termVal t v)) := by
        rw [FSData.eval_def, ereal_coe_mul_coe_mul]
        congr 2
        push_cast
        field_simp [D.m_ne_zero]
    _ ≤ _ := ereal_coe_mul_monotone (inv_nonneg.2 (Nat.cast_nonneg _)) hsup

/-- **Envelopes of obstacles** (blueprint `prop:bj-envelope-Jm`; FHX `prop:ample-envelopes`):
for `d > 0` and a lsc obstacle `φ : (ℙⁿ)^an → ℝ` with `φ(v_triv) ≤ 0` (e.g. `φ ≤ 0`),
`P_d(φ) = sup_{m ≥ 1} m⁻¹ φ_{J_m(φ)}` pointwise. By the Fubini–Study envelope lemma
(`lem:bj-fs-envelope`) it suffices to bound every `ψ ∈ H_ℚ(d)` with `ψ ≤ φ`, which is
`exists_le_inv_mul_phiIdeal_obstacleIdeal`. -/
theorem envelope_eq_iSup_obstacleIdeal (hd : 0 < d) (hφ : LowerSemicontinuous φ)
    (hφ0 : φ triv ≤ 0) (v : ProjBerk k n) :
    envelope (d : ℝ) (fun w => (φ w : EReal)) v =
      ⨆ (m : ℕ) (_ : 0 < m), (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (obstacleIdeal k n d φ m) v := by
  refine le_antisymm ?_ (iSup₂_le fun m hm => inv_mul_phiIdeal_obstacleIdeal_le_envelope hm v)
  have hd' : (0 : ℚ) < d := Nat.cast_pos.2 hd
  have e := envelope_coe_eq_iSup_finiteRatFS (k := k) (n := n) hd' hφ v
  rw [Rat.cast_natCast] at e
  rw [e]
  refine iSup₂_le fun ψ hψ => ?_
  obtain ⟨M, hM, hle⟩ := exists_le_inv_mul_phiIdeal_obstacleIdeal hφ0 hψ.1.1 hψ.2
  exact (hle v).trans (le_iSup₂_of_le (f := fun (m : ℕ) (_ : 0 < m) =>
    (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal (obstacleIdeal k n d φ m) v) M hM le_rfl)

end ProjBerk

end EnvelopeProperty
