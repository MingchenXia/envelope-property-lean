import EnvelopeProperty.Projective.SmoothConeGeneration
import EnvelopeProperty.Projective.SmoothConeValuative
import EnvelopeProperty.Projective.SubvarietyJm

/-!
# Asymptotic test ideals of the obstacle ideals `J_m(φ)` on the cone

Let `k` be a perfect field of characteristic `p`, `X = V(I) ⊆ ℙᴹ`, `D : X.ConeTraceData p` the
chart data of the punctured cone over `X × 𝔸¹`, `d > 0` and `φ : X^an → ℝ` bounded below. This
file specializes the results on the asymptotic test ideals `B_m` of the cone
(`ConeTraceData.testSeq`; blueprint `def:sg-test-X`, `lem:sg-test-X`,
`prop:sg-uniform-generation`, `prop:sg-valuative-bound`, chapter `smooth-general.tex`) to the
graded sequence `J_m = J_m(φ) T` of `def:sg-Jm` (`ProjSubvariety.coneObstacleIdeal`), in the form
used by steps (a)–(c) of the proof of `thm:sg-ep-charp` (Fang–Han–Xia, *The envelope property for
unibranch projective varieties*, Theorem 3.1, `thm:smooth-EP`), as the bridges of
`EnvelopeProperty.Projective.TestIdealBridge` and `EnvelopeProperty.Projective.SmoothEPTrace` do
on `ℙⁿ`. Throughout, `φ_𝔟` of an ideal `𝔟 ⊆ T` is `ProjBerk.phiIdeal (𝔟.comap coneMk)`, and
`φ_{J_m}` is `ProjBerk.phiIdeal (X.obstacleIdeal d φ m)` as in `prop:sg-envelope-Jm`
(`ProjSubvariety.envelope_eq_iSup_obstacleIdeal`).

## Main results

* `ProjSubvariety.exists_coneObstacleIdeal_eq_span_monomial`: `J_r(φ) T` is generated by elements
  `t^l s̄`, `s` a form of degree `r d` (the hypothesis of `prop:sg-uniform-generation`).
* `ConeTraceData.isFS_inv_mul_phiIdeal_testSeq_coneObstacleIdeal` (step (a)):
  `u_m = m⁻¹ φ_{B_m} ∈ 𝓗(X, d + c₀/m)` for `m ≥ 1`.
* `ConeTraceData.phiIdeal_obstacleIdeal_le_testSeq` (`φ_{J_m} ≤ φ_{B_m}`, `m ≥ 1`) and
  `ConeTraceData.phiIdeal_testSeq_coneObstacleIdeal_mul_le` (`φ_{B_{ml}} ≤ l φ_{B_m}`) (step (b)).
* `ConeTraceData.exists_phiIdeal_testSeq_coneObstacleIdeal_le` (step (c)): at a divisorial point
  `v` there is `A ≥ 0` such that for every `m` there is `q > 0` with
  `φ_{B_m}(v) ≤ (m/q) φ_{J_q}(v) + A`.
-/

open scoped NNReal ENNReal Topology Polynomial

noncomputable section

namespace EnvelopeProperty

open ProjBerk (phiIdeal)

universe u

namespace ProjSubvariety

variable {k : Type u} [Field k] {M : ℕ} {X : ProjSubvariety k M} {d : ℕ} {φ : X.an → ℝ}

/-- `J_r(φ) T` is generated by elements `t^l s̄`, `s` a form of degree `r d` (`lem:sg-Jm-basic`),
the hypothesis of `prop:sg-uniform-generation`. -/
theorem exists_coneObstacleIdeal_eq_span_monomial (r : ℕ) :
    ∃ S : Set X.ConeRing, X.coneObstacleIdeal d φ r = Ideal.span S ∧
      ∀ f ∈ S, ∃ (l : ℕ) (s : MvPolynomial (Fin (M + 1)) k), s.IsHomogeneous (r * d) ∧
        f = Polynomial.monomial l (X.coordMk s) := by
  obtain ⟨S, hS, hS'⟩ := exists_coneObstacleIdeal_eq_span (X := X) (d := d) (φ := φ) r
  refine ⟨S, hS, fun f hf => ?_⟩
  obtain ⟨l, s, hs, hf', -⟩ := hS' f hf
  exact ⟨l, s, hs, hf'⟩

namespace ConeTraceData

variable {p : ℕ} [hp : Fact p.Prime] [CharP k p] [PerfectRing k p] (D : X.ConeTraceData p)

/-- **Step (a) of `thm:sg-ep-charp`** (`prop:sg-uniform-generation`): for `φ` bounded below and
`m ≥ 1`, `u_m = m⁻¹ φ_{B_m} ∈ 𝓗(X, d + c₀/m)`, `B_m` the asymptotic test ideal of `J_•(φ)`. -/
theorem isFS_inv_mul_phiIdeal_testSeq_coneObstacleIdeal {C : ℝ} (hC : ∀ v, C ≤ φ v) {m : ℕ}
    (hm : 0 < m) :
    X.IsFS ((d : ℚ) + D.c0 / m) fun v => (((m : ℝ)⁻¹ : ℝ) : EReal) *
      phiIdeal ((D.testSeq (X.coneObstacleIdeal d φ) m).comap X.coneMk) v.1 :=
  D.isFS_inv_mul_phiIdeal_testSeq coneObstacleIdeal_mul_le
    (fun q _ => coneObstacleIdeal_ne_bot hC q)
    (fun r _ => exists_coneObstacleIdeal_eq_span_monomial r) hm

/-- `φ_{J_m} ≤ φ_{B_m}` on `X^an` for `m ≥ 1` (`lem:sg-test-X`(3)). -/
theorem phiIdeal_obstacleIdeal_le_testSeq {m : ℕ} (hm : 0 < m) (v : X.an) :
    phiIdeal (X.obstacleIdeal d φ m) v.1 ≤
      phiIdeal ((D.testSeq (X.coneObstacleIdeal d φ) m).comap X.coneMk) v.1 := by
  rw [← phiIdeal_comap_coneObstacleIdeal]
  exact D.phiIdeal_le_testSeq _ hm v.1

/-- `φ_{B_{ml}} ≤ l φ_{B_m}` on `X^an` (`lem:sg-test-X`(3)), for `φ` bounded below. -/
theorem phiIdeal_testSeq_coneObstacleIdeal_mul_le {C : ℝ} (hC : ∀ v, C ≤ φ v) (m l : ℕ)
    (v : X.an) :
    phiIdeal ((D.testSeq (X.coneObstacleIdeal d φ) (m * l)).comap X.coneMk) v.1 ≤
      l * phiIdeal ((D.testSeq (X.coneObstacleIdeal d φ) m).comap X.coneMk) v.1 :=
  D.phiIdeal_testSeq_mul_le coneObstacleIdeal_mul_le (fun q _ => coneObstacleIdeal_ne_bot hC q) m
    l v

/-- **Step (c) of `thm:sg-ep-charp`** (`prop:sg-valuative-bound`): for `φ` bounded below and a
divisorial point `v ∈ X^an` there is `A ≥ 0` such that for every `m` there is `q > 0` with
`φ_{B_m}(v) ≤ (m/q) φ_{J_q}(v) + A`. -/
theorem exists_phiIdeal_testSeq_coneObstacleIdeal_le {C : ℝ} (hC : ∀ v, C ≤ φ v) {v : X.an}
    (hv : X.IsDivisorial v) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ m : ℕ, ∃ q : ℕ, 0 < q ∧
      phiIdeal ((D.testSeq (X.coneObstacleIdeal d φ) m).comap X.coneMk) v.1 ≤
        (((m : ℝ) / q : ℝ) : EReal) * phiIdeal (X.obstacleIdeal d φ q) v.1 + (A : EReal) := by
  obtain ⟨A, hA, h⟩ := D.exists_phiIdeal_testSeq_le hv
  refine ⟨A, hA, fun m => ?_⟩
  obtain ⟨q, hq, hle⟩ := h (X.coneObstacleIdeal d φ) coneObstacleIdeal_mul_le
    (fun q _ => coneObstacleIdeal_ne_bot hC q) m
  refine ⟨q, hq, ?_⟩
  rw [← phiIdeal_comap_coneObstacleIdeal]
  exact hle q hq dvd_rfl

end ConeTraceData

end ProjSubvariety

end EnvelopeProperty
