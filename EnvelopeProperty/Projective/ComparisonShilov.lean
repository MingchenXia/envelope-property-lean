/-!
# Finite Fubini–Study functions and the Shilov boundary lemma on `(ℙⁿ)^an`

This file proves, on the model `ProjBerk k n` of `(ℙⁿ)^an` over an algebraically closed, trivially
valued field `k` (`EnvelopeProperty.Projective.Basic`), the Shilov boundary lemma of
Boucksom–Jonsson, *Global pluripotential theory over a trivially valued field* (BJ22,
Shilov), in the form of the blueprint chapter on BJ22 for `ℙⁿ` (`bj22.tex`, nodes
`lem:bj-finite-fs` and `lem:bj-shilov`), where the finite set `Σ` consists of the divisorial points
attached to Rees valuations of ideals in the polynomial charts `B_j = k[y^{(j)}][t]`
(`thm:bj-rees`, `lem:bj-rees-invariant`, `lem:bj-div-points`). It is the input of the divisorial
comparison theorem (BJ22 Theorem 4.22, `thm:bj-divisorial-comparison`), proved in
`EnvelopeProperty.Projective.Comparison`, used by Fang–Han–Xia, *The envelope property for
unibranch projective varieties*, §3 (Theorem 3.1 for `X = ℙⁿ`).

## Finite Fubini–Study functions (`lem:bj-finite-fs`)

* `ProjBerk.X_mem_radical_span`, `ProjBerk.exists_X_pow_mem_span`: if forms `sᵢ` have no common
  zero on `(ℙⁿ)^an` (some `|sᵢ|_v ≠ 0` at every `v`), then `xⱼ^e ∈ (sᵢ)` for some `e` and all `j`,
  so that a power of `𝔪 = (x₀, …, xₙ)` lies in `(sᵢ)`. If some
  `xⱼ ∉ √(sᵢ)`, a prime `P ⊇ (sᵢ)` with `xⱼ ∉ P` has a homogeneous core `P*` which is a homogeneous
  prime with the same properties, and the trivial semivaluation of `P*` (`ProjBerk.primePoint`,
  `|f| = 0` on `P*`, `1` off `P*`, by graded extension) is a common zero.
* `ProjBerk.X_pow_mem_span_dehomGen`: for the ideal `I` generated by `gᵢ = sᵢ t^{eᵢ}`,
  `t^N ∈ I^{(j)}` in every chart, `I^{(j)}` being generated by the dehomogenizations `gᵢ^{(j)}`
  (`ProjBerk.dehomGen`).
* `ProjBerk.IsFiniteRatFS.exists_coneSup`: every `ψ ∈ H_ℚ(b)` can be written
  `ψ = K⁻¹ (φ_I + Z)`, `K ∈ ℤ_{>0}`, `Z ∈ ℤ`, with `φ_I = max_i log|sᵢ t^{eᵢ}|_{σ(·)}`
  (`ProjBerk.coneSup`, equal to `φ_I = ProjBerk.phiIdeal I`, `ProjBerk.coneSup_eq_phiIdeal`),
  `eᵢ ∈ ℕ` and the forms `sᵢ` of a common degree without common zero.

## The Shilov boundary (`lem:bj-shilov`)

For each chart `j` and each Rees valuation ring `V` of `(I^{(j)}; g^{(j)})` (`Algebra/Rees.lean`)
we build a `BirationalDVR` of `B_j` (`BirationalDVR.ofSubalgebra`, `ProjBerk.reesDVR`); torus
invariance (`addVal_reesValuationRing_eq_inf`) and `ord_V(t) > 0` (`addVal_X_pos_reesValuationRing`,
using `t^N ∈ I^{(j)}`) give the divisorial point `v_V = ProjBerk.reesPoint` of
`lem:bj-div-points`(2). `Σ` consists of `v_triv` and these points.

* `ProjBerk.exists_finset_shilov_core`: if `|F|_{σ(w)} ≤ ‖I‖_{σ(w)}^r` at all `w ∈ Σ`, for
  `F ∈ R[t]` with `t`-coefficients forms of one degree, then this holds at all `v`. At `v_V` the hypothesis
  says `ord_V(F^{(j)}) ≥ r ord_V(I^{(j)})` (`ProjBerk.exists_dvd_of_le_reesPoint`); at an
  arbitrary `v` choose `j` with `|xⱼ|_v = 1` and apply `thm:bj-rees`
  (`valuation_le_sup_pow_of_forall_dvd`) to the seminorm `w` on `B_j` given by the Gauss point of
  radius `e⁻¹` over the chart image of `v` (`ProjBerk.chartGauss`), which satisfies
  `w(G^{(j)}) = |G|_{σ(v)}` (`ProjBerk.chartGauss_val_map`) and `w ≤ 1` on `B_j`.
* `ProjBerk.exists_finset_shilov_coneSup`: the logarithmic single-term form
  `log|σ| + z ≤ r φ_I` (`σ` a form, `z ∈ ℤ`, `r ∈ ℕ`); evaluation at `v_triv ∈ Σ` gives `z ≤ 0`,
  so that `F = σ t^{-z} ∈ R[t]`.
* `ProjBerk.IsFiniteRatFS.exists_finset_le_of_le` (comparison form) and
  **`ProjBerk.IsFiniteRatFS.exists_finset_iSup_sub_eq`** (`lem:bj-shilov`): for `ψ ∈ H_ℚ(b)`
  there is a finite set `Σ ⊆ (ℙⁿ)^div` containing `v_triv` with
  `sup (φ - ψ) = max_Σ (φ - ψ)` for every `φ ∈ H^gf_ℚ(a)` and every `a`.

## Deviations from the blueprint

* `lem:bj-shilov` is proved in comparison form: every `φ ∈ H^gf_ℚ(a)` with `φ ≤ ψ` on `Σ` satisfies
  `φ ≤ ψ`; the supremum form follows by applying this to `φ - q` for rationals
  `q > max_Σ (φ - ψ)`. This avoids proving that `c = max_Σ (φ - ψ)` is rational (the values at
  points of `Σ` being rational). After clearing denominators each term of `φ` gives a single
  inequality `log|σ| + z ≤ r φ_I`, `z ∈ ℤ`; the `t`-exponent `-z` is nonnegative because the
  inequality holds at `v_triv ∈ Σ` (in the blueprint: `c ≥ φ(v_triv) ≥ μ_ℓ / M`).
* The seminorm `w` on `B_j` is the Gauss point of radius `e⁻¹` over `stdChart j v` instead of
  `f ↦ |x_j^c f|_{σ(v)}`; both agree on dehomogenized elements.
* `lem:bj-finite-fs` is split into the three statements above; the normalization of `ψ` subtracts
  the largest (integral) weight instead of normalizing `max λᵢ = 0` with `λᵢ ∈ ℤ_{≤0}`.
* Rees valuation rings of charts with `g_ℓ = 0` are omitted, as in `Algebra/Rees.lean`.
-/

open scoped NNReal ENNReal Topology Polynomial

open MvPolynomial IsDiscreteValuationRing

attribute [local instance] MvPolynomial.gradedAlgebra

noncomputable section

namespace EnvelopeProperty

universe u

/-! ### Discrete valuation rings from subalgebras of the fraction field -/

section OfSubalgebra

variable {k : Type*} [Field k] {B : Type*} [CommRing B] [IsDomain B] [Algebra k B]

/-- A discrete valuation ring `B ⊆ V ⊆ Frac B`, given as a `B`-subalgebra of `FractionRing B` and
essentially of finite type over `k`, as a `BirationalDVR k B`. -/
def BirationalDVR.ofSubalgebra (V : Subalgebra B (FractionRing B)) [IsDiscreteValuationRing V]
    [Algebra.EssFiniteType k V] : BirationalDVR k B where
  ring := V.restrictScalars k
  isDVR := inferInstanceAs (IsDiscreteValuationRing V)
  essFiniteType := inferInstanceAs (Algebra.EssFiniteType k V)
  algebraMap_mem b := V.algebraMap_mem b

theorem BirationalDVR.ord_ofSubalgebra (V : Subalgebra B (FractionRing B))
    [IsDiscreteValuationRing V] [Algebra.EssFiniteType k V] (b : B) :
    (BirationalDVR.ofSubalgebra (k := k) V).ord b = addVal V (algebraMap B V b) :=
  rfl

end OfSubalgebra

/-! ### Powers `q^m`, `m ∈ ℕ ∪ {∞}` -/

section expOrd

variable {q : ℝ≥0}

theorem expOrd_nsmul (r : ℕ) (m : ℕ∞) : expOrd q (r • m) = expOrd q m ^ r := by
  induction r with
  | zero => simp
  | succ r ih => rw [succ_nsmul, expOrd_add, ih, pow_succ]

/-- `m ↦ q^m` is strictly decreasing for `0 < q < 1`. -/
theorem le_of_expOrd_le (hq0 : 0 < q) (hq1 : q < 1) {a b : ℕ∞} (h : expOrd q a ≤ expOrd q b) :
    b ≤ a := by
  induction a using ENat.recTopCoe with
  | top => exact le_top
  | coe a =>
    induction b using ENat.recTopCoe with
    | top =>
      rw [expOrd_top, expOrd_coe] at h
      exact absurd h (not_le.2 (pow_pos hq0 a))
    | coe b =>
      rw [expOrd_coe, expOrd_coe] at h
      exact ENat.natCast_le_natCast.2 ((pow_le_pow_iff_right_of_lt_one₀ hq0 hq1).1 h)

theorem zero_lt_expNeg (c : ℝ) : 0 < expNeg c := by
  rw [← NNReal.coe_pos]
  exact Real.exp_pos _

theorem expNeg_lt_one_of_pos {c : ℝ} (hc : 0 < c) : expNeg c < 1 := by
  rw [← NNReal.coe_lt_coe]
  exact Real.exp_lt_one_iff.2 (neg_neg_of_pos hc)

end expOrd

/-! ### Auxiliary facts on `EReal` -/

/-- `y - a + b = y + (b - a)` in `EReal` for real `a`, `b`. -/
theorem ereal_sub_coe_add_coe (y : EReal) (a b : ℝ) :
    y - (a : EReal) + (b : EReal) = y + ((b - a : ℝ) : EReal) := by
  rw [sub_eq_add_neg, add_assoc, ← EReal.coe_neg, ← EReal.coe_add, neg_add_eq_sub]

/-- `x - p ≤ q ↔ x - q ≤ p` in `EReal` for real `p`, `q`. -/
theorem ereal_sub_coe_le_coe_iff (x : EReal) (p q : ℝ) :
    x - (p : EReal) ≤ (q : EReal) ↔ x + ((-q : ℝ) : EReal) ≤ (p : EReal) := by
  induction x using EReal.rec with
  | bot => simp
  | top => simp
  | coe x =>
    rw [← EReal.coe_sub, ← EReal.coe_add, EReal.coe_le_coe_iff, EReal.coe_le_coe_iff]
    constructor <;> intro h <;> linarith

namespace ProjBerk

variable {k : Type u} [Field k] {n : ℕ}

/-- The chart rings `B_j = k[y₀, …, y_{n-1}][t]` are finitely generated `k`-algebras. -/
theorem finiteType_chartRing : Algebra.FiniteType k (ChartRing k n) :=
  Algebra.FiniteType.trans (S := MvPolynomial (Fin n) k) inferInstance inferInstance

attribute [local instance] finiteType_chartRing

/-! ### Common zeros of forms (`lem:bj-finite-fs`) -/

section CommonZeros

open Classical in
/-- The norm on forms of the trivial semivaluation of a prime `P`: `0` on `P`, `1` off `P`. -/
def primeNorm (P : Ideal (MvPolynomial (Fin (n + 1)) k)) (_d : ℕ)
    (f : MvPolynomial (Fin (n + 1)) k) : ℝ≥0 :=
  if f ∈ P then 0 else 1

theorem isGradedNorm_primeNorm (P : Ideal (MvPolynomial (Fin (n + 1)) k)) [hP : P.IsPrime]
    {j : Fin (n + 1)} (hj : X j ∉ P) : IsGradedNorm (primeNorm P) where
  map_zero d := by simp [primeNorm]
  map_C c hc := by
    have : C c ∉ P := fun h => hP.ne_top (Ideal.eq_top_of_isUnit_mem _ h
      ((isUnit_iff_ne_zero.2 hc).map C))
    simp [primeNorm, this]
  map_mul {d e f g} _ _ := by
    by_cases hf : f ∈ P
    · simp [primeNorm, hf, P.mul_mem_right g hf]
    · by_cases hg : g ∈ P
      · simp [primeNorm, hg, P.mul_mem_left f hg]
      · have : f * g ∉ P := fun h => (hP.mem_or_mem h).elim hf hg
        simp [primeNorm, hf, hg, this]
  map_add_le {d f g} _ _ := by
    by_cases hfg : f + g ∈ P
    · simp [primeNorm, hfg]
    · by_cases hf : f ∈ P
      · have hg : g ∉ P := fun hg => hfg (P.add_mem hf hg)
        simp [primeNorm, hfg, hg]
      · simp [primeNorm, hfg, hf]
  sup_X := by
    refine le_antisymm (Finset.sup_le fun i _ => ?_) ?_
    · unfold primeNorm
      split_ifs <;> simp
    · refine le_trans ?_ (Finset.le_sup (f := fun i => primeNorm P 1 (X i)) (Finset.mem_univ j))
      simp [primeNorm, hj]

/-- The trivial semivaluation of a prime `P ⊆ k[x₀, …, xₙ]` not containing some `xⱼ`, as a point
of `(ℙⁿ)^an` (by graded extension; for `P` homogeneous it is the trivial valuation of the point
`V(P) ⊆ ℙⁿ`). -/
def primePoint (P : Ideal (MvPolynomial (Fin (n + 1)) k)) [P.IsPrime] {j : Fin (n + 1)}
    (hj : X j ∉ P) : ProjBerk k n :=
  ofGradedNorm (isGradedNorm_primeNorm P hj)

theorem primePoint_val_of_mem (P : Ideal (MvPolynomial (Fin (n + 1)) k)) [P.IsPrime]
    {j : Fin (n + 1)} (hj : X j ∉ P) {d : ℕ} {f : MvPolynomial (Fin (n + 1)) k}
    (hf : f.IsHomogeneous d) (h : f ∈ P) : (primePoint P hj).1.val f = 0 := by
  rw [primePoint, ofGradedNorm_val_of_isHomogeneous _ hf]
  simp [primeNorm, h]

/-- **Nullstellensatz for `(ℙⁿ)^an`** (`lem:bj-finite-fs`): if forms `sᵢ` have no common zero on
`(ℙⁿ)^an`, then every `xⱼ` lies in the radical of `(sᵢ)`. -/
theorem X_mem_radical_span {ι : Type*} {s : ι → MvPolynomial (Fin (n + 1)) k}
    (hs : ∀ i, ∃ d, (s i).IsHomogeneous d) (hz : ∀ v : ProjBerk k n, ∃ i, v.1.val (s i) ≠ 0)
    (j : Fin (n + 1)) : X j ∈ (Ideal.span (Set.range s)).radical := by
  by_contra h
  rw [Ideal.radical_eq_sInf, Submodule.mem_sInf] at h
  push Not at h
  obtain ⟨J, ⟨hIJ, hJ⟩, hjJ⟩ := h
  set 𝒜 := homogeneousSubmodule (Fin (n + 1)) k
  have hI : (Ideal.span (Set.range s)).IsHomogeneous 𝒜 := by
    refine Ideal.homogeneous_span _ _ fun x hx => ?_
    obtain ⟨i, rfl⟩ := hx
    obtain ⟨d, hd⟩ := hs i
    exact ⟨d, (mem_homogeneousSubmodule d _).2 hd⟩
  have hp : ((Ideal.homogeneousCore 𝒜 J).toIdeal).IsPrime := hJ.homogeneousCore
  have hIp : Ideal.span (Set.range s) ≤ (Ideal.homogeneousCore 𝒜 J).toIdeal := by
    rw [← hI.toIdeal_homogeneousCore_eq_self]
    exact Ideal.homogeneousCore_mono 𝒜 hIJ
  have hjp : X j ∉ (Ideal.homogeneousCore 𝒜 J).toIdeal := fun h' =>
    hjJ (Ideal.toIdeal_homogeneousCore_le 𝒜 J h')
  obtain ⟨i, hi⟩ := hz (primePoint _ hjp)
  obtain ⟨d, hd⟩ := hs i
  exact hi (primePoint_val_of_mem _ hjp hd (hIp (Ideal.subset_span ⟨i, rfl⟩)))

/-- **`lem:bj-finite-fs`, first claim**: if forms `sᵢ` have no common zero on `(ℙⁿ)^an`, then
`xⱼ^e ∈ (sᵢ)` for some `e` and all `j` (hence `𝔪^{(n+1)e} ⊆ (sᵢ)`). -/
theorem exists_X_pow_mem_span {ι : Type*} {s : ι → MvPolynomial (Fin (n + 1)) k}
    (hs : ∀ i, ∃ d, (s i).IsHomogeneous d) (hz : ∀ v : ProjBerk k n, ∃ i, v.1.val (s i) ≠ 0) :
    ∃ E : ℕ, ∀ j : Fin (n + 1), X j ^ E ∈ Ideal.span (Set.range s) := by
  choose E hE using fun j => (X_mem_radical_span hs hz j : ∃ E : ℕ, _)
  refine ⟨Finset.univ.sup E, fun j => ?_⟩
  rw [← Nat.sub_add_cancel (Finset.le_sup (f := E) (Finset.mem_univ j)), pow_add]
  exact Ideal.mul_mem_left _ _ (hE j)

end CommonZeros

/-! ### The chart seminorm -/

section ChartGauss

theorem mem_chartDomain_of_val_X_eq_one {v : ProjBerk k n} {j : Fin (n + 1)}
    (hv : v.1.val (X j) = 1) : v ∈ chartDomain (X j : MvPolynomial (Fin (n + 1)) k) := by
  simp [chartDomain, hv]

/-- For `v` with `|xⱼ|_v = 1`, the Gauss point of radius `e⁻¹` over the image of `v` in the
standard chart `(𝔸ⁿ)^an`: a multiplicative seminorm on `B_j = k[y][t]` with
`|G^{(j)}| = |G|_{σ(v)}` (`chartGauss_val_map`). -/
def chartGauss (v : ProjBerk k n) (j : Fin (n + 1)) (hv : v.1.val (X j) = 1) :
    Berk k (ChartRing k n) :=
  Berk.gauss (stdChart j ⟨v, mem_chartDomain_of_val_X_eq_one hv⟩) gaussRadius

theorem stdChart_val_dehom_of_eq_one {v : ProjBerk k n} {j : Fin (n + 1)}
    (hv : v.1.val (X j) = 1) {c : ℕ} {τ : MvPolynomial (Fin (n + 1)) k}
    (hτ : τ.IsHomogeneous c) :
    (stdChart j ⟨v, mem_chartDomain_of_val_X_eq_one hv⟩).val (dehom j τ) = v.1.val τ := by
  rw [stdChart_val_dehom j _ hτ]
  simp [hv]

/-- `w(G^{(j)}) = |G|_{σ(v)}` for `G ∈ R[t]` whose `t`-coefficients are forms of one degree. -/
theorem chartGauss_val_map {v : ProjBerk k n} {j : Fin (n + 1)} (hv : v.1.val (X j) = 1)
    {c : ℕ} {G : ConeRing k n} (hG : ∀ ℓ, (G.coeff ℓ).IsHomogeneous c) :
    (chartGauss v j hv).val (G.map (dehom (k := k) j).toRingHom) = (gaussExt v).val G := by
  rw [chartGauss, Berk.gauss_val_eq_sup_of_subset _ _ _ (Polynomial.support_map_subset _ G),
    gaussExt_val_apply]
  refine Finset.sup_congr rfl fun ℓ _ => ?_
  rw [Polynomial.coeff_map, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
    stdChart_val_dehom_of_eq_one hv (hG ℓ)]

/-- The chart seminorm is `≤ 1` on `B_j`. -/
theorem chartGauss_val_le_one {v : ProjBerk k n} {j : Fin (n + 1)} (hv : v.1.val (X j) = 1)
    (F : ChartRing k n) : (chartGauss v j hv).val F ≤ 1 := by
  rw [chartGauss, Berk.gauss_val_le_iff]
  intro ℓ
  obtain ⟨M, τ, hτ, hτF⟩ := exists_dehom_eq j (F.coeff ℓ)
  rw [← hτF, stdChart_val_dehom_of_eq_one hv hτ]
  calc v.1.val τ * gaussRadius ^ ℓ ≤ 1 * 1 ^ ℓ := by
        gcongr
        · exact val_le_one v τ
        · exact gaussRadius_le_one
    _ = 1 := by simp

end ChartGauss

/-! ### Bihomogeneous generators and their dehomogenizations -/

section Generators

variable {ι : Type*} (s : ι → MvPolynomial (Fin (n + 1)) k) (e : ι → ℕ)

/-- The bihomogeneous generators `gᵢ = sᵢ t^{eᵢ}` of an ideal `I ⊆ R[t]`. -/
def coneGen (i : ι) : ConeRing k n :=
  Polynomial.C (s i) * Polynomial.X ^ (e i)

/-- The dehomogenized generators `gᵢ^{(j)} ∈ B_j` of `I^{(j)}`. -/
def dehomGen (j : Fin (n + 1)) (i : ι) : ChartRing k n :=
  (coneGen s e i).map (dehom (k := k) j).toRingHom

theorem dehomGen_eq (j : Fin (n + 1)) (i : ι) :
    dehomGen s e j i = Polynomial.C (dehom j (s i)) * Polynomial.X ^ (e i) := by
  simp [dehomGen, coneGen, Polynomial.map_mul, Polynomial.map_pow]

theorem isHomogeneous_coeff_coneGen {d : ℕ} (hs : ∀ i, (s i).IsHomogeneous d) (i : ι) (ℓ : ℕ) :
    ((coneGen s e i).coeff ℓ).IsHomogeneous d := by
  rw [coneGen, Polynomial.coeff_C_mul_X_pow]
  split_ifs
  · exact hs i
  · exact MvPolynomial.isHomogeneous_zero _ _ _

theorem gaussExt_val_coneGen (v : ProjBerk k n) (i : ι) :
    (gaussExt v).val (coneGen s e i) = v.1.val (s i) * gaussRadius ^ e i :=
  Berk.gauss_val_C_mul_X_pow v.1 gaussRadius (s i) (e i)

/-- **`lem:bj-finite-fs`, `t^N ∈ I^{(j)}`**: if the forms `sᵢ` have no common zero on `(ℙⁿ)^an`,
then `t^N ∈ I^{(j)} = (gᵢ^{(j)})` for `N = max_i eᵢ` in every chart `j`. -/
theorem X_pow_mem_span_dehomGen [Fintype ι] (hs : ∀ i, ∃ d, (s i).IsHomogeneous d)
    (hz : ∀ v : ProjBerk k n, ∃ i, v.1.val (s i) ≠ 0) (j : Fin (n + 1)) :
    ∃ N : ℕ, (Polynomial.X : ChartRing k n) ^ N ∈ Ideal.span (Set.range (dehomGen s e j)) := by
  obtain ⟨E, hE⟩ := X_mem_radical_span hs hz j
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.1 hE
  set N := Finset.univ.sup e
  refine ⟨N, Ideal.mem_span_range_iff_exists_fun.2
    ⟨fun i => Polynomial.C (dehom j (c i)) * Polynomial.X ^ (N - e i), ?_⟩⟩
  have h1 : ∑ i, dehom j (c i) * dehom j (s i) = 1 := by
    simp_rw [← map_mul]
    rw [← map_sum, hc, map_pow, dehom_X_self, one_pow]
  calc ∑ i, Polynomial.C (dehom j (c i)) * Polynomial.X ^ (N - e i) * dehomGen s e j i
      = ∑ i, Polynomial.C (dehom j (c i) * dehom j (s i)) * Polynomial.X ^ N := by
        refine Finset.sum_congr rfl fun i _ => ?_
        have hX : (Polynomial.X : ChartRing k n) ^ (N - e i) * Polynomial.X ^ e i =
            Polynomial.X ^ N := by
          rw [← pow_add, Nat.sub_add_cancel (Finset.le_sup (f := e) (Finset.mem_univ i))]
        rw [dehomGen_eq, Polynomial.C_mul, ← hX]
        ring
    _ = Polynomial.X ^ N := by
        rw [← Finset.sum_mul, ← map_sum, h1, Polynomial.C_1, one_mul]

end Generators

/-! ### Rees valuations of `I^{(j)}` and their divisorial points -/

section Rees

variable [IsAlgClosed k] {ι : Type*} [Fintype ι] (s : ι → MvPolynomial (Fin (n + 1)) k)
  (e : ι → ℕ)

variable (k n) in
/-- The fraction field `k(y, t)` of the chart ring `B_j = k[y][t]`. -/
abbrev ChartFrac : Type u := FractionRing (ChartRing k n)

/-- The normalized charts of the blowup of `I^{(j)}` are Noetherian (finiteness of
normalization). -/
theorem isNoetherianRing_reesNormalChart_dehomGen (j : Fin (n + 1)) (ℓ : ι) :
    IsNoetherianRing (reesNormalChart (ChartFrac k n) (dehomGen s e j) ℓ) :=
  isNoetherianRing_reesNormalChart (ChartFrac k n) (dehomGen s e j) k ℓ

attribute [local instance] isNoetherianRing_reesNormalChart_dehomGen

theorem finite_reesIndex_dehomGen (j : Fin (n + 1)) :
    Finite (ReesIndex (ChartFrac k n) (dehomGen s e j)) :=
  finite_reesIndex

attribute [local instance] finite_reesIndex_dehomGen

/-- The Rees valuation ring `V` of `(I^{(j)}; g^{(j)})` attached to `x`, as a discrete valuation
ring birational to `B_j`, essentially of finite type over `k` (`def:bj-rees`). -/
def reesDVR (j : Fin (n + 1)) (x : ReesIndex (ChartFrac k n) (dehomGen s e j)) :
    BirationalDVR k (ChartRing k n) :=
  haveI := essFiniteType_reesValuationRing k x
  BirationalDVR.ofSubalgebra (reesValuationRing _ _ x)

theorem reesDVR_ord (j : Fin (n + 1)) (x : ReesIndex (ChartFrac k n) (dehomGen s e j))
    (b : ChartRing k n) :
    (reesDVR s e j x).ord b = addVal (reesValuationRing _ _ x) (algebraMap _ _ b) :=
  rfl

/-- `b = ord_V(t)` as a natural number. -/
def reesOrdX (j : Fin (n + 1)) (x : ReesIndex (ChartFrac k n) (dehomGen s e j)) : ℕ :=
  ((reesDVR s e j x).ord Polynomial.X).toNat

/-- The divisorial point `v_V ∈ (ℙⁿ)^an` attached to a Rees valuation ring `V` of `I^{(j)}`
(`lem:bj-div-points`(2)): the graded extension of `|s| = e^{-ord_V(s^{(j)})/b}`,
`b = ord_V(t)`. -/
def reesPoint (j : Fin (n + 1)) (x : ReesIndex (ChartFrac k n) (dehomGen s e j)) :
    ProjBerk k n :=
  chartDivPoint k j (reesDVR s e j x) (reesOrdX s e j x)

variable (j : Fin (n + 1)) (x : ReesIndex (ChartFrac k n) (dehomGen s e j))

theorem coe_reesOrdX : ((reesOrdX s e j x : ℕ) : ℕ∞) = (reesDVR s e j x).ord Polynomial.X :=
  ENat.natCast_toNat ((reesDVR s e j x).ord_eq_top_iff.not.2 Polynomial.X_ne_zero)

/-- `ord_V(t) > 0` (`lem:bj-rees-invariant`), using `t^N ∈ I^{(j)}`. -/
theorem reesOrdX_pos
    (hN : ∃ N : ℕ, (Polynomial.X : ChartRing k n) ^ N ∈ Ideal.span (Set.range (dehomGen s e j))) :
    0 < reesOrdX s e j x := by
  have h := addVal_X_pos_reesValuationRing hN x
  rw [← reesDVR_ord, ← coe_reesOrdX] at h
  exact_mod_cast h

/-- Torus invariance of the Rees valuations (`lem:bj-rees-invariant`):
`ord_V(∑_ℓ f_ℓ t^ℓ) = min_ℓ (ord_V(f_ℓ) + ℓ ord_V(t))`. -/
theorem reesDVR_torus (F : ChartRing k n) :
    (reesDVR s e j x).ord F = F.support.inf fun ℓ =>
      (reesDVR s e j x).ord (Polynomial.C (F.coeff ℓ)) + ((ℓ * reesOrdX s e j x : ℕ) : ℕ∞) := by
  have hg : ∀ i, ∃ (a : MvPolynomial (Fin n) k) (m : ℕ),
      dehomGen s e j i = Polynomial.C a * Polynomial.X ^ m :=
    fun i => ⟨_, _, dehomGen_eq s e j i⟩
  rw [reesDVR_ord, addVal_reesValuationRing_eq_inf k hg x F]
  refine Finset.inf_congr rfl fun ℓ _ => ?_
  rw [← reesDVR_ord, ← reesDVR_ord, ← coe_reesOrdX, Nat.cast_mul, nsmul_eq_mul]

variable {s e j}

/-- The points `v_V` are divisorial (`lem:bj-div-points`(2)). -/
theorem isDivisorial_reesPoint
    (hN : ∃ N : ℕ, (Polynomial.X : ChartRing k n) ^ N ∈ Ideal.span (Set.range (dehomGen s e j))) :
    (reesPoint s e j x).IsDivisorial :=
  isDivisorial_chartDivPoint j _ _ (reesOrdX_pos s e j x hN) (reesDVR_torus s e j x)

/-- `|G|_{σ(v_V)} = e^{-ord_V(G^{(j)})/b}` for `G ∈ R[t]` whose `t`-coefficients are forms of one
degree. -/
theorem gaussExt_reesPoint_val
    (hN : ∃ N : ℕ, (Polynomial.X : ChartRing k n) ^ N ∈ Ideal.span (Set.range (dehomGen s e j)))
    {c : ℕ} {G : ConeRing k n} (hG : ∀ ℓ, (G.coeff ℓ).IsHomogeneous c) :
    (gaussExt (reesPoint s e j x)).val G =
      expOrd (expNeg (reesOrdX s e j x : ℝ)⁻¹)
        ((reesDVR s e j x).ord (G.map (dehom (k := k) j).toRingHom)) := by
  have hb := reesOrdX_pos s e j x hN
  have h := logAbs_gaussExt_chartDivPoint j (reesDVR s e j x) (reesOrdX s e j x) hb
    (reesDVR_torus s e j x) hG
  rw [Berk.logAbs, ← log_expOrd_expNeg (inv_pos.2 (Nat.cast_pos.2 hb))] at h
  exact ENNReal.coe_injective (ENNReal.log_injective h)

/-- At a point `v_V ∈ Σ`, the inequality `|F|_{σ(v_V)} ≤ ‖I‖_{σ(v_V)}^r` says
`ord_V(F^{(j)}) ≥ r ord_V(I^{(j)})`, i.e. `(gᵢ^{(j)})^r ∣ F^{(j)}` in `V` for some `i`. -/
theorem exists_dvd_of_le_reesPoint {d : ℕ} (hs : ∀ i, (s i).IsHomogeneous d) [Nonempty ι]
    (hN : ∃ N : ℕ, (Polynomial.X : ChartRing k n) ^ N ∈ Ideal.span (Set.range (dehomGen s e j)))
    {c : ℕ} {F : ConeRing k n} (hF : ∀ ℓ, (F.coeff ℓ).IsHomogeneous c) {r : ℕ}
    (h : (gaussExt (reesPoint s e j x)).val F ≤
      (Finset.univ.sup fun i => (gaussExt (reesPoint s e j x)).val (coneGen s e i)) ^ r) :
    ∃ i, algebraMap (ChartRing k n) (reesValuationRing (ChartFrac k n) (dehomGen s e j) x)
        (dehomGen s e j i) ^ r ∣
      algebraMap (ChartRing k n) (reesValuationRing (ChartFrac k n) (dehomGen s e j) x)
        (F.map (dehom (k := k) j).toRingHom) := by
  set V := reesDVR s e j x
  set q := expNeg ((reesOrdX s e j x : ℝ)⁻¹)
  have hb := reesOrdX_pos s e j x hN
  have hq0 : 0 < q := zero_lt_expNeg _
  have hq1 : q < 1 := expNeg_lt_one_of_pos (inv_pos.2 (Nat.cast_pos.2 hb))
  have hg : ∀ i, (gaussExt (reesPoint s e j x)).val (coneGen s e i) =
      expOrd q (V.ord (dehomGen s e j i)) := fun i =>
    gaussExt_reesPoint_val x hN (isHomogeneous_coeff_coneGen s e hs i)
  rw [gaussExt_reesPoint_val x hN hF] at h
  simp only [hg] at h
  obtain ⟨i₀, -, hi₀⟩ := Finset.exists_min_image Finset.univ
    (fun i => V.ord (dehomGen s e j i)) Finset.univ_nonempty
  have hsup : (Finset.univ.sup fun i => expOrd q (V.ord (dehomGen s e j i))) =
      expOrd q (V.ord (dehomGen s e j i₀)) :=
    le_antisymm (Finset.sup_le fun i _ => expOrd_antitone hq1.le (hi₀ i (Finset.mem_univ i)))
      (Finset.le_sup (f := fun i => expOrd q (V.ord (dehomGen s e j i))) (Finset.mem_univ i₀))
  rw [hsup, ← expOrd_nsmul] at h
  have hle := le_of_expOrd_le hq0 hq1 h
  refine ⟨i₀, ?_⟩
  rw [← map_pow, ← addVal_le_iff_dvd, map_pow, addVal_pow]
  exact hle

variable (s e) in
/-- **The Shilov boundary, core form** (`lem:bj-shilov`): for forms `sᵢ` of degree `d` without
common zero and `eᵢ ∈ ℕ`, let `I = (sᵢ t^{eᵢ}) ⊆ R[t]`. There is a finite set `Σ` of divisorial
points, containing `v_triv`, such that for every `F ∈ R[t]` whose `t`-coefficients are forms of one
degree and every `r ∈ ℕ`: if `|F|_{σ(w)} ≤ max_i |gᵢ|_{σ(w)}^r` for all `w ∈ Σ`, then
`|F|_{σ(v)} ≤ max_i |gᵢ|_{σ(v)}^r` for all `v`. -/
theorem exists_finset_shilov_core {d : ℕ} (hs : ∀ i, (s i).IsHomogeneous d)
    (hz : ∀ v : ProjBerk k n, ∃ i, v.1.val (s i) ≠ 0) :
    ∃ S : Finset (ProjBerk k n), triv ∈ S ∧ (∀ w ∈ S, w.IsDivisorial) ∧
      ∀ (c : ℕ) (F : ConeRing k n), (∀ ℓ, (F.coeff ℓ).IsHomogeneous c) → ∀ r : ℕ,
        (∀ w ∈ S, (gaussExt w).val F ≤
          (Finset.univ.sup fun i => (gaussExt w).val (coneGen s e i)) ^ r) →
        ∀ v, (gaussExt v).val F ≤
          (Finset.univ.sup fun i => (gaussExt v).val (coneGen s e i)) ^ r := by
  have hN : ∀ j, ∃ N : ℕ,
      (Polynomial.X : ChartRing k n) ^ N ∈ Ideal.span (Set.range (dehomGen s e j)) :=
    X_pow_mem_span_dehomGen s e (fun i => ⟨d, hs i⟩) hz
  have : Nonempty ι := let ⟨i, _⟩ := hz triv; ⟨i⟩
  have hfin : (insert triv (⋃ j, Set.range (reesPoint s e j)) : Set (ProjBerk k n)).Finite :=
    (Set.finite_iUnion fun j => Set.finite_range _).insert _
  have hmem : ∀ j x, reesPoint s e j x ∈ hfin.toFinset := fun j x =>
    hfin.mem_toFinset.2 (Or.inr (Set.mem_iUnion.2 ⟨j, x, rfl⟩))
  refine ⟨hfin.toFinset, hfin.mem_toFinset.2 (Or.inl rfl), fun w hw => ?_,
    fun c F hF r h v => ?_⟩
  · rcases hfin.mem_toFinset.1 hw with rfl | hw
    · exact isDivisorial_triv
    · obtain ⟨j, x, rfl⟩ := Set.mem_iUnion.1 hw
      exact isDivisorial_reesPoint x (hN j)
  · obtain ⟨j, hj⟩ := exists_val_X_eq_one v
    have hwg : ∀ i, (chartGauss v j hj).val (dehomGen s e j i) =
        (gaussExt v).val (coneGen s e i) := fun i =>
      chartGauss_val_map hj (isHomogeneous_coeff_coneGen s e hs i)
    have key := valuation_le_sup_pow_of_forall_dvd (K := ChartFrac k n) (g := dehomGen s e j)
      (chartGauss v j hj).val (chartGauss_val_le_one hj) (by
        obtain ⟨i, hi⟩ := hz v
        refine ⟨i, ?_⟩
        rw [hwg, gaussExt_val_coneGen]
        exact mul_ne_zero hi (pow_ne_zero _ gaussRadius_ne_zero))
      (F := F.map (dehom (k := k) j).toRingHom) (r := r)
      fun x => exists_dvd_of_le_reesPoint x hs (hN j) hF (h _ (hmem j x))
    rw [chartGauss_val_map hj hF] at key
    simpa only [hwg] using key

end Rees

/-! ### The logarithmic form -/

section ConeSup

variable {ι : Type*} [Fintype ι] (s : ι → MvPolynomial (Fin (n + 1)) k) (e : ι → ℕ)

/-- `φ_I(v) = max_i log|gᵢ|_{σ(v)}` for the ideal `I = (gᵢ)`, `gᵢ = sᵢ t^{eᵢ}`
(`ProjBerk.phiIdeal_span_finset`). -/
def coneSup (v : ProjBerk k n) : EReal :=
  Finset.univ.sup fun i => Berk.logAbs (coneGen s e i) (gaussExt v)

/-- `coneSup` is the function `φ_I` of `ProjBerk.phiIdeal` for `I = (gᵢ)`. -/
theorem coneSup_eq_phiIdeal (v : ProjBerk k n) :
    coneSup s e v = phiIdeal (Ideal.span (Set.range (coneGen s e))) v := by
  classical
  have h : (Set.range (coneGen s e) : Set (ConeRing k n)) =
      ((Finset.univ.image (coneGen s e) : Finset (ConeRing k n)) : Set (ConeRing k n)) := by
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
  rw [h, phiIdeal_span_finset, Finset.sup_image]
  rfl

theorem coneSup_le_zero (v : ProjBerk k n) : coneSup s e v ≤ 0 :=
  Finset.sup_le fun _ _ => logAbs_gaussExt_le_zero v _

theorem coneSup_eq_log (v : ProjBerk k n) :
    coneSup s e v = ENNReal.log
      ((Finset.univ.sup fun i => (gaussExt v).val (coneGen s e i) : ℝ≥0) : ℝ≥0∞) :=
  (Finset.apply_sup_eq_sup_comp_of_linearOrder (s := Finset.univ)
    (f := fun i => (gaussExt v).val (coneGen s e i)) (fun t : ℝ≥0 => ENNReal.log (t : ℝ≥0∞))
    (ENNReal.log_monotone.comp ENNReal.coe_mono) (by simp)).symm

theorem logAbs_le_mul_coneSup_iff (F : ConeRing k n) (r : ℕ) (v : ProjBerk k n) :
    Berk.logAbs F (gaussExt v) ≤ ((r : ℝ) : EReal) * coneSup s e v ↔
      (gaussExt v).val F ≤ (Finset.univ.sup fun i => (gaussExt v).val (coneGen s e i)) ^ r := by
  rw [coneSup_eq_log, EReal.coe_natCast, ← ENNReal.log_pow, Berk.logAbs, ENNReal.log_le_log_iff,
    ← ENNReal.coe_pow, ENNReal.coe_le_coe]

/-- **The Shilov boundary, single-term form**: with `Σ` as in `exists_finset_shilov_core`, for a
form `σ`, `z ∈ ℤ` and `r ∈ ℕ`, `log|σ| + z ≤ r φ_I` on `Σ` implies it everywhere. -/
theorem exists_finset_shilov_coneSup [IsAlgClosed k] {d : ℕ} (hs : ∀ i, (s i).IsHomogeneous d)
    (hz : ∀ v : ProjBerk k n, ∃ i, v.1.val (s i) ≠ 0) :
    ∃ S : Finset (ProjBerk k n), triv ∈ S ∧ (∀ w ∈ S, w.IsDivisorial) ∧
      ∀ (c : ℕ) (σ : MvPolynomial (Fin (n + 1)) k), σ.IsHomogeneous c → ∀ (z : ℤ) (r : ℕ),
        (∀ w ∈ S, logAbs σ w + ((z : ℝ) : EReal) ≤ ((r : ℝ) : EReal) * coneSup s e w) →
        ∀ v, logAbs σ v + ((z : ℝ) : EReal) ≤ ((r : ℝ) : EReal) * coneSup s e v := by
  obtain ⟨S, hS, hSdiv, hcore⟩ := exists_finset_shilov_core s e hs hz
  refine ⟨S, hS, hSdiv, fun c σ hσ z r h v => ?_⟩
  by_cases hσ0 : σ = 0
  · rw [hσ0, logAbs_zero, EReal.bot_add]
    exact bot_le
  -- evaluation at `v_triv ∈ Σ` gives `z ≤ 0`
  have hz0 : z ≤ 0 := by
    have h1 := h triv hS
    rw [logAbs_triv_of_ne_zero hσ0, zero_add] at h1
    have h2 : ((r : ℝ) : EReal) * coneSup s e triv ≤ 0 := by
      have := ereal_coe_mul_monotone (Nat.cast_nonneg r) (coneSup_le_zero s e triv)
      simpa only [mul_zero] using this
    have h3 : ((z : ℝ) : EReal) ≤ ((0 : ℝ) : EReal) := h1.trans h2
    exact_mod_cast EReal.coe_le_coe_iff.1 h3
  set a := z.natAbs
  have hza : ((z : ℝ) : EReal) = -((a : ℕ) : EReal) := by
    have h1 : ((a : ℕ) : ℤ) = -z := Int.ofNat_natAbs_of_nonpos hz0
    have h2 : (z : ℝ) = -((a : ℕ) : ℝ) := by
      have := congrArg (fun m : ℤ => (m : ℝ)) h1
      push_cast at this
      linarith
    rw [h2, EReal.coe_neg]
    rfl
  -- `log|σ| + z = log|σ t^{-z}|_{σ(·)}`
  have key : ∀ w, logAbs σ w + ((z : ℝ) : EReal) =
      Berk.logAbs (Polynomial.C σ * Polynomial.X ^ a) (gaussExt w) := fun w => by
    rw [logAbs_C_mul_X_pow_gaussExt, hza, sub_eq_add_neg]
  have hF : ∀ ℓ, ((Polynomial.C σ * Polynomial.X ^ a : ConeRing k n).coeff ℓ).IsHomogeneous c :=
    fun ℓ => by
      rw [Polynomial.coeff_C_mul_X_pow]
      split_ifs
      · exact hσ
      · exact MvPolynomial.isHomogeneous_zero _ _ _
  rw [key, logAbs_le_mul_coneSup_iff]
  refine hcore c _ hF r (fun w hw => ?_) v
  rw [← logAbs_le_mul_coneSup_iff, ← key]
  exact h w hw

end ConeSup

/-! ### Normal form of finite rational Fubini–Study functions (`lem:bj-finite-fs`) -/

/-- **Normal form of a finite rational FS function** (`lem:bj-finite-fs`): after clearing the
denominators of the weights and subtracting the largest one, `ψ ∈ H_ℚ(b)` is `K⁻¹ (φ_I + Z)` with
`K ∈ ℤ_{>0}`, `Z ∈ ℤ` and `φ_I = max_i log|sᵢ t^{eᵢ}|_{σ(·)}` (`coneSup`) for forms `sᵢ` of one
degree, without common zero on `(ℙⁿ)^an` (as `ψ` is finite), and `eᵢ ∈ ℕ`. -/
theorem IsFiniteRatFS.exists_coneSup {b : ℚ} {ψ : ProjBerk k n → EReal}
    (hψ : IsFiniteRatFS b ψ) :
    ∃ (ι : Type u) (_ : Fintype ι) (s : ι → MvPolynomial (Fin (n + 1)) k) (d : ℕ) (e : ι → ℕ)
      (K : ℕ) (Z : ℤ), 0 < K ∧ (∀ i, (s i).IsHomogeneous d) ∧
        (∀ v : ProjBerk k n, ∃ i, v.1.val (s i) ≠ 0) ∧
        ∀ v, ψ v = (((K : ℝ)⁻¹ : ℝ) : EReal) * (coneSup s e v + ((Z : ℝ) : EReal)) := by
  obtain ⟨⟨D, hD, rfl⟩, hfin⟩ := hψ
  obtain ⟨L, hL, hLz⟩ := exists_pos_nat_mul_eq_int D.terms (fun t => t.2) hD
  choose z hz using hLz
  have hne : (Finset.univ : Finset D.terms).Nonempty := by
    obtain ⟨t, ht, -⟩ := D.exists_ne_zero
    exact ⟨⟨t, ht⟩, Finset.mem_univ _⟩
  set zf : D.terms → ℤ := fun i => z i.1 i.2 with hzf
  set Z : ℤ := Finset.univ.sup' hne zf with hZdef
  have hZ : ∀ i, zf i ≤ Z := fun i => Finset.le_sup' zf (Finset.mem_univ i)
  set e : D.terms → ℕ := fun i => (Z - zf i).toNat with he_def
  set s : D.terms → MvPolynomial (Fin (n + 1)) k := fun i => i.1.1 ^ L with hs_def
  have he : ∀ i, ((e i : ℕ) : ℝ) = (Z : ℝ) - (zf i : ℝ) := fun i => by
    have : ((e i : ℕ) : ℤ) = Z - zf i := Int.toNat_of_nonneg (by linarith [hZ i])
    exact_mod_cast this
  -- `L (log|sᵢ| + λᵢ) = log|sᵢ^L t^{eᵢ}|_{σ(·)} + Z`
  have hterm : ∀ (i : D.terms) v, ((L : ℝ) : EReal) * termVal i.1 v =
      Berk.logAbs (coneGen s e i) (gaussExt v) + ((Z : ℝ) : EReal) := fun i v => by
    rw [coneGen, logAbs_C_mul_X_pow_gaussExt, termVal_def, ereal_coe_mul_add (Nat.cast_nonneg L),
      ← EReal.coe_mul, hz i.1 i.2]
    change _ = logAbs (i.1.1 ^ L) v - ((e i : ℝ) : EReal) + ((Z : ℝ) : EReal)
    rw [ereal_sub_coe_add_coe, logAbs_pow, he]
    congr 2
    simp [hzf]
  refine ⟨D.terms, inferInstance, s, D.deg * L, e, L * D.m, Z, Nat.mul_pos hL D.m_pos,
    fun i => (D.isHomogeneous i.1 i.2).pow L, fun v => ?_, fun v => ?_⟩
  · by_contra h
    push Not at h
    apply hfin v
    rw [FSData.eval_def]
    have : (D.terms.sup fun t => termVal t v) = ⊥ := (Finset.sup_eq_bot_iff _ _).2 fun t ht => by
      have h0 : v.1.val t.1 = 0 := pow_eq_zero_iff hL.ne' |>.1 (by
        simpa [hs_def, map_pow] using h ⟨t, ht⟩)
      rw [termVal_def, (logAbs_eq_bot_iff _ _).2 h0, EReal.bot_add]
    rw [this]
    exact EReal.coe_mul_bot_of_pos D.inv_m_pos
  · have hsup : coneSup s e v + ((Z : ℝ) : EReal) =
        ((L : ℝ) : EReal) * D.terms.sup fun t => termVal t v := by
      rw [coneSup, Finset.apply_sup_eq_sup_comp_of_linearOrder (s := Finset.univ)
        (fun x : EReal => x + ((Z : ℝ) : EReal)) (fun _ _ h => add_le_add_left h _)
        (EReal.bot_add _), ereal_coe_mul_finset_sup (by exact_mod_cast hL)]
      rw [← Finset.sup_attach D.terms, ← Finset.univ_eq_attach]
      exact Finset.sup_congr rfl fun i _ => (hterm i v).symm
    rw [hsup, ereal_coe_mul_coe_mul, FSData.eval_def]
    congr 2
    push_cast
    field_simp [D.m_ne_zero]

/-! ### The Shilov boundary lemma (`lem:bj-shilov`) -/

/-- The per-term reduction in real numbers: `m'⁻¹ (x + μ) ≤ K⁻¹ (p + Z)` iff
`K Q x + (K w - m' Q Z) ≤ m' Q p`, where `Q μ = w`. -/
theorem fsTerm_le_iff_real {x μ p : ℝ} {m' K Q : ℕ} (hm' : 0 < m') (hK : 0 < K) (hQ : 0 < Q)
    {w Z : ℤ} (hw : (Q : ℝ) * μ = w) :
    (m' : ℝ)⁻¹ * (x + μ) ≤ (K : ℝ)⁻¹ * (p + Z) ↔
      ((K * Q : ℕ) : ℝ) * x + ((K * w - m' * Q * Z : ℤ) : ℝ) ≤ ((m' * Q : ℕ) : ℝ) * p := by
  have hm'r : (0 : ℝ) < m' := by exact_mod_cast hm'
  have hKr : (0 : ℝ) < K := by exact_mod_cast hK
  have hQr : (0 : ℝ) < Q := by exact_mod_cast hQ
  rw [← div_eq_inv_mul, ← div_eq_inv_mul, div_le_div_iff₀ hm'r hKr]
  push_cast
  rw [← hw]
  constructor
  · intro h
    nlinarith
  · intro h
    have : (Q : ℝ) * ((x + μ) * K) ≤ Q * ((p + Z) * m') := by nlinarith
    exact le_of_mul_le_mul_left this hQr

/-- The per-term reduction in `EReal`, for `x ∈ [-∞, ∞)` and `P` finite. -/
theorem fsTerm_le_iff {x : EReal} (hx : x ≠ ⊤) {P : EReal} (hP : P ≠ ⊥) (hP' : P ≠ ⊤) {μ : ℝ}
    {m' K Q : ℕ} (hm' : 0 < m') (hK : 0 < K) (hQ : 0 < Q) {w Z : ℤ} (hw : (Q : ℝ) * μ = w) :
    (((m' : ℝ)⁻¹ : ℝ) : EReal) * (x + (μ : EReal)) ≤
        (((K : ℝ)⁻¹ : ℝ) : EReal) * (P + ((Z : ℝ) : EReal)) ↔
      ((K * Q : ℕ) : EReal) * x + (((K * w - m' * Q * Z : ℤ) : ℝ) : EReal) ≤
        (((m' * Q : ℕ) : ℝ) : EReal) * P := by
  induction P using EReal.rec with
  | bot => exact absurd rfl hP
  | top => exact absurd rfl hP'
  | coe p =>
  induction x using EReal.rec with
  | bot =>
    have h1 : (((m' : ℝ)⁻¹ : ℝ) : EReal) * (⊥ + (μ : EReal)) = ⊥ := by
      rw [EReal.bot_add]
      exact EReal.coe_mul_bot_of_pos (inv_pos.2 (by exact_mod_cast hm'))
    have h2 : ((K * Q : ℕ) : EReal) * ⊥ = ⊥ := by
      rw [← EReal.coe_natCast]
      exact EReal.coe_mul_bot_of_pos (by positivity)
    rw [h1, h2, EReal.bot_add]
    simp
  | top => exact absurd rfl hx
  | coe x =>
    rw [← EReal.coe_natCast, ← EReal.coe_add, ← EReal.coe_add, ← EReal.coe_mul, ← EReal.coe_mul,
      ← EReal.coe_mul, ← EReal.coe_mul, ← EReal.coe_add, EReal.coe_le_coe_iff,
      EReal.coe_le_coe_iff]
    exact fsTerm_le_iff_real hm' hK hQ hw

variable [IsAlgClosed k]

/-- **The Shilov boundary, comparison form** (`lem:bj-shilov`): for `ψ ∈ H_ℚ(b)` there is a finite
set `Σ ⊆ (ℙⁿ)^div` containing `v_triv` such that every rational, generically finite FS function
`φ` of any class with `φ ≤ ψ` on `Σ` satisfies `φ ≤ ψ` everywhere. -/
theorem IsFiniteRatFS.exists_finset_le_of_le {b : ℚ} {ψ : ProjBerk k n → EReal}
    (hψ : IsFiniteRatFS b ψ) :
    ∃ S : Finset (ProjBerk k n), triv ∈ S ∧ (∀ w ∈ S, w.IsDivisorial) ∧
      ∀ (a : ℚ) (φ : ProjBerk k n → EReal), IsRatFS a φ → (∀ w ∈ S, φ w ≤ ψ w) →
        ∀ v, φ v ≤ ψ v := by
  have hψfin := hψ.2
  obtain ⟨ι, _, s, d, e, K, Z, hK, hs, hz, hψe⟩ := hψ.exists_coneSup
  obtain ⟨S, hS, hSdiv, hB⟩ := exists_finset_shilov_coneSup s e hs hz
  refine ⟨S, hS, hSdiv, fun a φ hφ h v => ?_⟩
  obtain ⟨D', hD', rfl⟩ := hφ
  obtain ⟨Q, hQ, hQz⟩ := exists_pos_nat_mul_eq_int D'.terms (fun t => t.2) hD'
  choose w hw using hQz
  have hPbot : ∀ v, coneSup s e v ≠ ⊥ := fun v h0 => hψfin v (by
    rw [hψe v, h0, EReal.bot_add]
    exact EReal.coe_mul_bot_of_pos (inv_pos.2 (by exact_mod_cast hK)))
  have hPtop : ∀ v, coneSup s e v ≠ ⊤ := fun v =>
    ne_top_of_le_ne_top EReal.zero_ne_top (coneSup_le_zero s e v)
  -- each term `m'⁻¹ (log|σ| + μ)` of `φ` gives a single inequality `log|σ^{KQ}| + z ≤ r φ_I`
  have key : ∀ t (ht : t ∈ D'.terms) v,
      (((D'.m : ℝ)⁻¹ : ℝ) : EReal) * termVal t v ≤ ψ v ↔
        logAbs (t.1 ^ (K * Q)) v + (((K * w t ht - D'.m * Q * Z : ℤ) : ℝ) : EReal) ≤
          (((D'.m * Q : ℕ) : ℝ) : EReal) * coneSup s e v := fun t ht v => by
    rw [hψe v, termVal_def, logAbs_pow]
    exact fsTerm_le_iff (logAbs_ne_top _ _) (hPbot v) (hPtop v) D'.m_pos hK hQ (hw t ht)
  rw [FSData.eval_def, ereal_coe_mul_finset_sup D'.inv_m_pos, Finset.sup_le_iff]
  intro t ht
  rw [key t ht v]
  refine hB _ _ ((D'.isHomogeneous t ht).pow _) _ _ (fun w' hw' => ?_) v
  rw [← key t ht w']
  exact (D'.termVal_le_eval_mul w' ht).trans (h w' hw')

/-- **The Shilov boundary** (`lem:bj-shilov`, BJ22 Shilov): for every `ψ ∈ H_ℚ(b)` there is
a finite set `Σ ⊆ (ℙⁿ)^div` containing `v_triv` such that
`sup_{(ℙⁿ)^an} (φ - ψ) = max_Σ (φ - ψ)` for every `a ∈ ℚ` and every `φ ∈ H^gf_ℚ(a)`. -/
theorem IsFiniteRatFS.exists_finset_iSup_sub_eq {b : ℚ} {ψ : ProjBerk k n → EReal}
    (hψ : IsFiniteRatFS b ψ) :
    ∃ S : Finset (ProjBerk k n), triv ∈ S ∧ (∀ w ∈ S, w.IsDivisorial) ∧
      ∀ (a : ℚ) (φ : ProjBerk k n → EReal), IsRatFS a φ →
        ⨆ v, (φ v - ψ v) = S.sup fun v => φ v - ψ v := by
  obtain ⟨S, hS, hSdiv, hle⟩ := hψ.exists_finset_le_of_le
  refine ⟨S, hS, hSdiv, fun a φ hφ => le_antisymm (iSup_le fun v => ?_)
    (Finset.sup_le fun w _ => le_iSup (fun v => φ v - ψ v) w)⟩
  have hψr : ∀ v, ψ v = (((ψ v).toReal : ℝ) : EReal) := fun v =>
    (EReal.coe_toReal (hψ.isFS.ne_top v) (hψ.2 v)).symm
  refine le_of_forall_gt_imp_ge_of_dense fun c hc => ?_
  obtain ⟨q, hMq, hqc⟩ := EReal.lt_iff_exists_rat_btwn.1 hc
  -- apply the comparison form to `φ - q`
  have h := hle a _ (hφ.add_const (-q)) (fun w hw => by
    have h1 : φ w - ψ w ≤ ((q : ℝ) : EReal) :=
      (Finset.le_sup (f := fun v => φ v - ψ v) hw).trans hMq.le
    rw [hψr w] at h1 ⊢
    rw [ereal_sub_coe_le_coe_iff] at h1
    simpa only [Rat.cast_neg] using h1) v
  have h2 : φ v - ψ v ≤ ((q : ℝ) : EReal) := by
    rw [hψr v] at h ⊢
    rw [ereal_sub_coe_le_coe_iff]
    simpa only [Rat.cast_neg] using h
  exact h2.trans hqc.le

end ProjBerk

