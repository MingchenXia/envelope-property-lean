import EnvelopeProperty.Projective.ComparisonShilov
import EnvelopeProperty.Projective.SubvarietyCone
import EnvelopeProperty.Projective.SubvarietyPSH

/-!
# Gauss points and divisorial points of `X = V(I)`

Let `k` be a field with the trivial absolute value and `X = V(I) ⊆ ℙᴹ` a projective subvariety
(`EnvelopeProperty.ProjSubvariety`), with `R_M = k[x₀, …, x_M]`, `S = R_M / I` and the coordinate
ring `T = S[t]` of the affine cone over `X × 𝔸¹` (`ProjSubvariety.ConeRing`, in
`EnvelopeProperty.Projective.SubvarietyCone` together with the charts of the punctured cone). This
file contains the analytic part of the beginning of the subsection `subsec:sg-comparison` of the
blueprint chapter `smooth-general.tex`: the divisorial comparison theorem of Boucksom–Jonsson,
*Global pluripotential theory over a trivially valued field* (BJ22), Theorem 4.22, on `X`, used in
the proof of Fang–Han–Xia, *The envelope property for unibranch projective varieties*,
Theorem 3.1 (`thm:smooth-EP`).

Following the modelling advice of the plan, the functions `φ_𝔟` live on the ambient ring
`R_M[t] = (MvPolynomial (Fin (M + 1)) k)[X]`: for `v ∈ X^an` the Gauss extension
`σ(v) = ProjBerk.gaussExt v` vanishes on `I[t]` (`gaussExt_val_eq_zero_of_coneMk_eq_zero`), so
`|g|_{σ(v)}` only depends on the image `ḡ = coneMk g ∈ T` (`gaussExt_val_eq_of_coneMk_eq`).

## Main definitions

* `ProjSubvariety.IsDivisorial X v` (**`def:sg-div`**): `log|g|_{σ(v)} = -c ord_{R'}(ḡ)` for all
  `g ∈ R_M[t]`, for some `c ∈ ℚ_{>0}` and some discrete valuation ring `T ⊆ R' ⊆ Frac T` essentially
  of finite type over `k` (`BirationalDVR k X.ConeRing`).
* `ProjSubvariety.chartDivPoint X j V b` (`lem:sg-div-points`(2)): for `xⱼ ∉ I` and a discrete
  valuation ring `B_j ⊆ V ⊆ Frac B_j`, `B_j = A_j[t]`, the point `v_V ∈ X^an` with
  `|s| = e^{-ord_V(s̄ / x̄ⱼ^c)/b}` on forms `s` of degree `c`.

## Main results

* `lem:sg-phi-basic`: (1) the `ℙᴹ` statements `ProjBerk.phiIdeal_le_zero`, `phiIdeal_mono`,
  `phiIdeal_span_finset`, `phiIdeal_mul` apply verbatim; on `X^an` the ideal can be enlarged by
  `I[t]` (`ProjSubvariety.phiIdeal_sup_ker_coneMk`). (2) `ProjSubvariety.phiIdeal_comap_saturation`:
  `φ_{𝔟^sat} = φ_𝔟`. (3) `ProjSubvariety.isFS_inv_mul_phiIdeal`: an ideal generated by elements
  with `t`-coefficients forms of degree `≤ m d`, not all in `I[t]`, gives
  `m⁻¹ φ_𝔟 ∈ 𝓗(X, d)`, with rational (integer) weights.
* **`lem:sg-pl-separate`**: `ProjSubvariety.exists_isFiniteFS_ne`: two distinct points of `X^an`
  are separated by a finite Fubini–Study function `max(log|s|, max_i log|xᵢ^c| - N)`.
* **`lem:sg-div-points`(1)**: `ProjSubvariety.isDivisorial_triv` (`R' = T_{(t)}`, `c = 1`).
* **`lem:sg-div-points`(2)**: `ProjSubvariety.isDivisorial_chartDivPoint`,
  `ProjSubvariety.chartDivPoint_val_X_self` and `ProjSubvariety.logAbs_gaussExt_chartDivPoint`
  (`log|f|_{σ(v_V)} = -ord_V(f / x̄ⱼ^c)/b` for `f` of `x`-degree `c`).

## Deviations from the blueprint

* `lem:sg-pl-separate` is proved in the stronger form that a single finite Fubini–Study function
  (the PL function `f - 0`) separates the two points.
* `lem:sg-phi-basic` is stated for ideals of the ambient ring `R_M[t]` (and for preimages of ideals
  of `T` in (2)), as advised by the plan; (3) also covers generators of `x`-degree `< m d`.
-/
open scoped NNReal ENNReal Topology Polynomial

open IsDiscreteValuationRing

noncomputable section

namespace EnvelopeProperty

open ProjBerk (gaussExt phiIdeal logAbs gaussRadius quotChartMk QuotChartAlg)

universe u

namespace ProjSubvariety

variable {k : Type u} [Field k] {M : ℕ} {X : ProjSubvariety k M}

/-! ### The Gauss extension on `X^an` -/

/-- `σ(v)` vanishes on `I[t]` for `v ∈ X^an`. -/
theorem gaussExt_val_eq_zero_of_coneMk_eq_zero (v : X.an)
    {g : (MvPolynomial (Fin (M + 1)) k)[X]} (hg : X.coneMk g = 0) :
    (gaussExt v.1).val g = 0 := by
  rw [ProjBerk.gaussExt_val_apply]
  refine le_antisymm (Finset.sup_le fun ℓ _ => ?_) zero_le
  rw [v.2 _ (coneMk_eq_zero_iff.1 hg ℓ), zero_mul]

/-- On `X^an`, `|g|_{σ(v)}` only depends on the image `ḡ ∈ T` of `g`. -/
theorem gaussExt_val_eq_of_coneMk_eq (v : X.an) {g g' : (MvPolynomial (Fin (M + 1)) k)[X]}
    (h : X.coneMk g = X.coneMk g') : (gaussExt v.1).val g = (gaussExt v.1).val g' := by
  have key : ∀ g g' : (MvPolynomial (Fin (M + 1)) k)[X], X.coneMk g = X.coneMk g' →
      (gaussExt v.1).val g ≤ (gaussExt v.1).val g' := fun g g' h => by
    have h0 : (gaussExt v.1).val (g - g') = 0 :=
      gaussExt_val_eq_zero_of_coneMk_eq_zero v (by rw [map_sub, h, sub_self])
    calc (gaussExt v.1).val g = (gaussExt v.1).val (g' + (g - g')) := by rw [add_sub_cancel]
      _ ≤ max ((gaussExt v.1).val g') ((gaussExt v.1).val (g - g')) :=
          (gaussExt v.1).val.map_add _ _
      _ = (gaussExt v.1).val g' := by rw [h0, max_eq_left zero_le]
  exact le_antisymm (key g g' h) (key g' g h.symm)

theorem logAbs_gaussExt_eq_of_coneMk_eq (v : X.an) {g g' : (MvPolynomial (Fin (M + 1)) k)[X]}
    (h : X.coneMk g = X.coneMk g') :
    Berk.logAbs g (gaussExt v.1) = Berk.logAbs g' (gaussExt v.1) := by
  rw [Berk.logAbs, Berk.logAbs, gaussExt_val_eq_of_coneMk_eq v h]

/-! ### Functions attached to ideals (`lem:sg-phi-basic`) -/

/-- **`lem:sg-phi-basic`(1) on `X`**: on `X^an`, `φ_𝔟 = φ_{𝔟 + I[t]}`, so `φ_𝔟` only depends on
the image of `𝔟` in `T`. (The other assertions of (1) are `ProjBerk.phiIdeal_le_zero`,
`ProjBerk.phiIdeal_mono`, `ProjBerk.phiIdeal_span_finset` and `ProjBerk.phiIdeal_mul`.) -/
theorem phiIdeal_sup_ker_coneMk (𝔟 : Ideal (MvPolynomial (Fin (M + 1)) k)[X]) (v : X.an) :
    phiIdeal (𝔟 ⊔ RingHom.ker X.coneMk) v.1 = phiIdeal 𝔟 v.1 := by
  refine le_antisymm (iSup₂_le fun f hf => ?_) (ProjBerk.phiIdeal_mono v.1 le_sup_left)
  obtain ⟨b, hb, c, hc, rfl⟩ := Submodule.mem_sup.1 hf
  have h : X.coneMk (b + c) = X.coneMk b := by
    rw [map_add, RingHom.mem_ker.1 hc, add_zero]
  rw [logAbs_gaussExt_eq_of_coneMk_eq v h]
  exact ProjBerk.le_phiIdeal 𝔟 v.1 hb

/-- `φ_{𝔪₊} = 0` on `(ℙᴹ)^an`, as `max_i log|xᵢ| = 0`. -/
theorem phiIdeal_comap_coneIrrelevant (v : ProjBerk k M) :
    phiIdeal (X.coneIrrelevant.comap X.coneMk) v = 0 := by
  refine le_antisymm (ProjBerk.phiIdeal_le_zero _ v) ?_
  obtain ⟨j, hj⟩ := ProjBerk.exists_val_X_eq_one v
  have hmem : (Polynomial.C (MvPolynomial.X j) : (MvPolynomial (Fin (M + 1)) k)[X]) ∈
      X.coneIrrelevant.comap X.coneMk := by
    change X.coneMk _ ∈ X.coneIrrelevant
    rw [coneMk_C]
    exact Ideal.subset_span ⟨j, rfl⟩
  have h1 := ProjBerk.le_phiIdeal _ v hmem
  rw [ProjBerk.logAbs_C_gaussExt, ProjBerk.logAbs_def, hj, ENNReal.coe_one,
    ENNReal.log_one] at h1
  exact h1

/-- **`lem:sg-phi-basic`(2)**: `φ_{𝔟^sat} = φ_𝔟` on `(ℙᴹ)^an` (hence on `X^an`), for an ideal
`𝔟 ⊆ T` pulled back to `R_M[t]`. -/
theorem phiIdeal_comap_saturation (𝔟 : Ideal X.ConeRing) (v : ProjBerk k M) :
    phiIdeal ((X.saturation 𝔟).comap X.coneMk) v = phiIdeal (𝔟.comap X.coneMk) v := by
  refine le_antisymm ?_ (ProjBerk.phiIdeal_mono v (Ideal.comap_mono (le_saturation 𝔟)))
  obtain ⟨r, hr⟩ := exists_pow_mul_saturation_le 𝔟
  have h1 : (X.coneIrrelevant.comap X.coneMk) ^ r * (X.saturation 𝔟).comap X.coneMk ≤
      𝔟.comap X.coneMk := by
    calc (X.coneIrrelevant.comap X.coneMk) ^ r * (X.saturation 𝔟).comap X.coneMk
        ≤ (X.coneIrrelevant ^ r).comap X.coneMk * (X.saturation 𝔟).comap X.coneMk :=
          Ideal.mul_mono_left (Ideal.le_comap_pow X.coneMk r)
      _ ≤ (X.coneIrrelevant ^ r * X.saturation 𝔟).comap X.coneMk := Ideal.le_comap_mul X.coneMk
      _ ≤ 𝔟.comap X.coneMk := Ideal.comap_mono hr
  have h2 := ProjBerk.phiIdeal_mono v h1
  rwa [ProjBerk.phiIdeal_mul, ProjBerk.phiIdeal_pow, phiIdeal_comap_coneIrrelevant, mul_zero,
    zero_add] at h2

/-- At the trivial point, `|g|_{σ(⋆)} ≠ 0` for `ḡ ≠ 0`. -/
theorem gaussExt_triv_val_ne_zero {g : (MvPolynomial (Fin (M + 1)) k)[X]}
    (hg : X.coneMk g ≠ 0) : (gaussExt (X.triv : ProjBerk k M)).val g ≠ 0 := by
  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ, g.coeff ℓ ∉ X.ideal := by
    by_contra h
    push Not at h
    exact hg (coneMk_eq_zero_iff.2 h)
  have hle := Berk.logAbs_coeff_add_le_logAbs_gauss (X.triv : ProjBerk k M).1 gaussRadius g ℓ
  intro h0
  have hbot : Berk.logAbs g (gaussExt (X.triv : ProjBerk k M)) = ⊥ := by
    rw [Berk.logAbs, h0, ENNReal.coe_zero, ENNReal.log_zero]
  change _ ≤ Berk.logAbs g (gaussExt (X.triv : ProjBerk k M)) at hle
  rw [hbot, le_bot_iff, Berk.logAbs, X.triv_val_of_notMem hℓ, ENNReal.coe_one, ENNReal.log_one,
    zero_add, ProjBerk.log_gaussRadius] at hle
  exact absurd hle (by
    rw [← EReal.coe_one, ← EReal.coe_natCast, ← EReal.coe_neg, ← EReal.coe_mul]
    exact EReal.coe_ne_bot _)

/-- **`lem:sg-phi-basic`(3)**: if `𝔟 = (S)` with every `g ∈ S` having `t`-coefficients forms of
degree `≤ m d`, and some `g ∈ S` with `ḡ ≠ 0`, then `m⁻¹ φ_𝔟 ∈ 𝓗(X, d)` on `X^an`, given by
Fubini–Study data with rational (indeed integer) weights. -/
theorem isFS_inv_mul_phiIdeal {m d : ℕ} (hm : 0 < m)
    {𝔟 : Ideal (MvPolynomial (Fin (M + 1)) k)[X]} {S : Set (MvPolynomial (Fin (M + 1)) k)[X]}
    (h𝔟S : 𝔟 = Ideal.span S) (hS : ∀ g ∈ S, ∀ ℓ, ∃ e ≤ m * d, (g.coeff ℓ).IsHomogeneous e)
    (hne : ∃ g ∈ S, X.coneMk g ≠ 0) :
    ∃ D : ProjBerk.FSData k M (d : ℚ), D.IsRational ∧ (∃ t ∈ D.terms, t.1 ∉ X.ideal) ∧
      ∀ v : ProjBerk k M, D.eval v = (((m : ℝ)⁻¹ : ℝ) : EReal) * phiIdeal 𝔟 v := by
  obtain ⟨g, hgS, hg⟩ := hne
  have h𝔟 : 𝔟 ≠ ⊥ := by
    intro h0
    apply hg
    have : g ∈ 𝔟 := h𝔟S ▸ Ideal.subset_span hgS
    rw [h0, Ideal.mem_bot] at this
    rw [this, map_zero]
  obtain ⟨D, hD, hDeq⟩ := ProjBerk.isRatFS_inv_mul_phiIdeal hm h𝔟S hS h𝔟
  refine ⟨D, hD, (X.exists_notMem_iff_eval_triv_ne_bot D).2 ?_, fun v => (congrFun hDeq v).symm⟩
  rw [← congrFun hDeq]
  refine ProjBerk.ereal_coe_mul_ne_bot (by positivity) (ne_bot_of_le_ne_bot ?_
    (ProjBerk.le_phiIdeal 𝔟 _ (h𝔟S ▸ Ideal.subset_span hgS)))
  rw [Ne, Berk.logAbs, ENNReal.log_eq_bot_iff, ENNReal.coe_eq_zero]
  exact gaussExt_triv_val_ne_zero hg

/-! ### PL functions separate points (`lem:sg-pl-separate`) -/

/-- **`lem:sg-pl-separate`** (BJ22 FSdense): two distinct points `v ≠ w` of `X^an` are
separated by a finite Fubini–Study function: if the form `s` of degree `c` has `|s|_v ≠ |s|_w`, then
`f_N = max(log|s|, max_i log|xᵢ^c| - N) ∈ 𝓗_fin(X, c)` equals `max(log|s|, -N)` on `X^an` and
separates `v` and `w` for large `N`. In particular `PL(X)` separates the points of `X^an`. -/
theorem exists_isFiniteFS_ne {v w : X.an} (h : v ≠ w) :
    ∃ (c : ℚ) (f : X.an → ℝ), X.IsFiniteFS c f ∧ f v ≠ f w := by
  classical
  have h' : v.1 ≠ w.1 := fun h'' => h (Subtype.ext h'')
  obtain ⟨d, s, hs, hne⟩ := ProjBerk.exists_isHomogeneous_val_ne h'
  -- the cut-off level `N`
  obtain ⟨N, hN⟩ := exists_nat_gt (max (-Real.log (v.1.1.val s : ℝ)) (-Real.log (w.1.1.val s : ℝ)))
  let D : ProjBerk.FSData k M (d : ℚ) :=
    { m := 1
      m_pos := one_pos
      deg := d
      deg_eq := by push_cast; ring
      terms := insert (s, 0) (Finset.univ.image fun i => (1 * MvPolynomial.X i ^ d, -(N : ℝ)))
      isHomogeneous := by
        intro t ht
        rcases Finset.mem_insert.1 ht with rfl | ht
        · exact hs
        · obtain ⟨i, -, rfl⟩ := Finset.mem_image.1 ht
          rw [one_mul]
          exact MvPolynomial.isHomogeneous_X_pow i d
      exists_ne_zero := ⟨_,
        Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ (Finset.mem_univ 0)),
        by rw [one_mul]; exact pow_ne_zero _ (MvPolynomial.X_ne_zero 0)⟩ }
  have hDr : D.IsRational := by
    intro t ht
    rcases Finset.mem_insert.1 ht with rfl | ht
    · exact ⟨0, by simp⟩
    · obtain ⟨i, -, rfl⟩ := Finset.mem_image.1 ht
      exact ⟨-(N : ℚ), by push_cast; ring⟩
  have hfin : ∀ z ∈ X.an, ∃ t ∈ D.terms, z.1.val t.1 ≠ 0 := by
    intro z _
    obtain ⟨j, hj⟩ := ProjBerk.exists_val_X_eq_one z
    refine ⟨_, Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ (Finset.mem_univ j)), ?_⟩
    simp only [one_mul, map_pow, hj, one_pow]
    exact one_ne_zero
  -- the value `max(log|s|, -N)`
  have heval : ∀ z : ProjBerk k M, D.eval z = max (logAbs s z) ((-(N : ℝ) : ℝ) : EReal) := by
    intro z
    rw [ProjBerk.FSData.eval_def]
    change ((((1 : ℕ) : ℝ)⁻¹ : ℝ) : EReal) * _ = _
    rw [Nat.cast_one, inv_one, EReal.coe_one, one_mul, Finset.sup_insert, Finset.sup_image]
    have := ProjBerk.sup_termVal_mul_X_pow (1 : MvPolynomial (Fin (M + 1)) k) d (-(N : ℝ)) z
    rw [ProjBerk.logAbs_one, zero_add] at this
    rw [show (Finset.univ.sup ((fun t => ProjBerk.termVal t z) ∘ fun i =>
      (1 * MvPolynomial.X i ^ d, -(N : ℝ)))) = _ from this, ProjBerk.termVal_def]
    simp
  have hval : ∀ z : ProjBerk k M, -Real.log (z.1.val s : ℝ) < N → D.eval z =
      if z.1.val s = 0 then ((-(N : ℝ) : ℝ) : EReal)
      else ((Real.log (z.1.val s : ℝ) : ℝ) : EReal) := by
    intro z hz
    rw [heval]
    split_ifs with h0
    · rw [(ProjBerk.logAbs_eq_bot_iff s z).2 h0, max_eq_right bot_le]
    · rw [ProjBerk.logAbs_def, ENNReal.log_of_nnreal h0, max_eq_left]
      exact EReal.coe_le_coe_iff.2 (by linarith)
  refine ⟨d, _, X.isFiniteFS_of_fsData D hDr hfin, fun heq => hne ?_⟩
  have hv := hval v.1 ((le_max_left _ _).trans_lt hN)
  have hw := hval w.1 ((le_max_right _ _).trans_lt hN)
  have heq' : D.eval v.1 = D.eval w.1 := by
    obtain ⟨t, ht, hvt⟩ := hfin v.1 v.2
    obtain ⟨t', ht', hwt⟩ := hfin w.1 w.2
    rw [← EReal.coe_toReal (D.eval_ne_top v.1) (D.eval_ne_bot_of_val_ne_zero ht hvt),
      ← EReal.coe_toReal (D.eval_ne_top w.1) (D.eval_ne_bot_of_val_ne_zero ht' hwt)]
    exact congrArg _ heq
  rw [hv, hw] at heq'
  have hNv : ¬ -Real.log (v.1.1.val s : ℝ) ≥ N := not_le.2 ((le_max_left _ _).trans_lt hN)
  have hNw : ¬ -Real.log (w.1.1.val s : ℝ) ≥ N := not_le.2 ((le_max_right _ _).trans_lt hN)
  split_ifs at heq' with h1 h2 h2
  · rw [h1, h2]
  · exfalso
    have := EReal.coe_injective heq'
    exact hNw (by linarith)
  · exfalso
    have := EReal.coe_injective heq'
    exact hNv (by linarith)
  · have hlog := EReal.coe_injective heq'
    have hpos1 : (0 : ℝ) < v.1.1.val s := by exact_mod_cast pos_iff_ne_zero.2 h1
    have hpos2 : (0 : ℝ) < w.1.1.val s := by exact_mod_cast pos_iff_ne_zero.2 h2
    exact NNReal.coe_injective (Real.log_injOn_pos hpos1 hpos2 hlog)

/-! ### Divisorial points (`def:sg-div`) -/

variable (X) in
/-- **Divisorial points of `X`** (`def:sg-div`): `v ∈ X^an` is divisorial if there are `c ∈ ℚ_{>0}`
and a discrete valuation ring `T ⊆ R' ⊆ Frac T`, essentially of finite type over `k`
(`BirationalDVR k X.ConeRing`), with `log|g|_{σ(v)} = -c ord_{R'}(ḡ)` for all `g ∈ R_M[t]`. -/
def IsDivisorial (v : X.an) : Prop :=
  ∃ (R' : BirationalDVR k X.ConeRing) (c : ℚ), 0 < c ∧
    ∀ g : (MvPolynomial (Fin (M + 1)) k)[X],
      Berk.logAbs g (gaussExt v.1) = -((c : ℝ) : EReal) * (R'.ord (X.coneMk g) : EReal)

/-- Multiplicative criterion for divisorial points. -/
theorem isDivisorial_of_val_eq {v : X.an} (R' : BirationalDVR k X.ConeRing) {c : ℚ} (hc : 0 < c)
    (h : ∀ g, (gaussExt v.1).val g = expOrd (expNeg c) (R'.ord (X.coneMk g))) :
    X.IsDivisorial v :=
  ⟨R', c, hc, fun g => by rw [Berk.logAbs, h, log_expOrd_expNeg (by exact_mod_cast hc)]⟩

/-- `def:sg-div`, the value on ideals: at a point with `log|g|_{σ(v)} = -c ord_{R'}(ḡ)` for all
`g`, `φ_{(G)}(v) = max_{g ∈ G} (-c ord_{R'}(ḡ)) = -c ord_{R'}((G))` for a finite set `G`. -/
theorem phiIdeal_span_finset_of_logAbs_eq {v : X.an} {R' : BirationalDVR k X.ConeRing} {c : ℚ}
    (h : ∀ g, Berk.logAbs g (gaussExt v.1) = -((c : ℝ) : EReal) * (R'.ord (X.coneMk g) : EReal))
    (G : Finset (MvPolynomial (Fin (M + 1)) k)[X]) :
    phiIdeal (Ideal.span (G : Set (MvPolynomial (Fin (M + 1)) k)[X])) v.1 =
      G.sup fun g => -((c : ℝ) : EReal) * (R'.ord (X.coneMk g) : EReal) := by
  rw [ProjBerk.phiIdeal_span_finset]
  exact Finset.sup_congr rfl fun g _ => h g

/-! #### The trivial point is divisorial (`lem:sg-div-points`(1)) -/

/-- `|g|_{σ(⋆)} = e^{-ord_t(ḡ)}`. -/
theorem gaussExt_triv_val (g : (MvPolynomial (Fin (M + 1)) k)[X]) :
    (gaussExt (X.triv : ProjBerk k M)).val g =
      expOrd (expNeg 1) ((X.tAdicDVR).ord (X.coneMk g)) := by
  by_cases hg : X.coneMk g = 0
  · rw [hg, BirationalDVR.ord_zero, expOrd_top]
    exact gaussExt_val_eq_zero_of_coneMk_eq_zero X.triv hg
  rw [tAdicDVR_ord hg, expOrd_coe, ProjBerk.gaussExt_val_apply]
  have hmem : ∀ ℓ, ℓ ∈ (X.coneMk g).support ↔ g.coeff ℓ ∉ X.ideal := fun ℓ => by
    rw [Polynomial.mem_support_iff, coeff_coneMk, Ne, coordMk_eq_zero_iff]
  refine le_antisymm (Finset.sup_le fun ℓ hℓ => ?_) ?_
  · by_cases hI : g.coeff ℓ ∈ X.ideal
    · rw [(X.triv).2 _ hI, zero_mul]
      exact zero_le
    · rw [X.triv_val_of_notMem hI, one_mul]
      exact pow_le_pow_of_le_one zero_le ProjBerk.gaussRadius_le_one
        (Polynomial.natTrailingDegree_le_of_mem_supp ℓ ((hmem ℓ).2 hI))
  · have h0 := Polynomial.natTrailingDegree_mem_support_of_nonzero hg
    have hI := (hmem _).1 h0
    refine le_trans ?_ (Finset.le_sup (f := fun ℓ => (X.triv : ProjBerk k M).1.val (g.coeff ℓ) *
      gaussRadius ^ ℓ) (Polynomial.mem_support_iff.2 fun h => hI (h ▸ X.ideal.zero_mem)))
    rw [X.triv_val_of_notMem hI, one_mul]
    rfl

variable (X) in
/-- **`lem:sg-div-points`(1)**: the trivial point `⋆` is divisorial, with `R' = T_{(t)}` and
`c = 1`. -/
theorem isDivisorial_triv : X.IsDivisorial X.triv :=
  isDivisorial_of_val_eq X.tAdicDVR one_pos fun g => by
    rw [gaussExt_triv_val, Rat.cast_one]


/-! ### The point `v_V` (`lem:sg-div-points`(2)) -/

section ChartPoint

variable {j : Fin (M + 1)} [Fact (MvPolynomial.X j ∉ X.ideal)]


variable (X j) in
/-- The family `N_c(s) = e^{-ord_V(s̄ / x̄ⱼ^c)/b}` on forms (`lem:sg-div-points`(2)). -/
def chartDivNorm (V : BirationalDVR k (X.ChartRing j)) (b : ℕ) (_c : ℕ)
    (s : MvPolynomial (Fin (M + 1)) k) : ℝ≥0 :=
  expOrd (expNeg (b : ℝ)⁻¹) (V.ord (Polynomial.C (X.quotDehom j s)))

theorem isGradedNorm_chartDivNorm (V : BirationalDVR k (X.ChartRing j)) (b : ℕ) :
    ProjBerk.IsGradedNorm (X.chartDivNorm j V b) where
  map_zero d := by simp [chartDivNorm]
  map_C c hc := by
    rw [chartDivNorm, ← MvPolynomial.algebraMap_eq, AlgHom.commutes,
      ← Polynomial.algebraMap_apply, V.ord_algebraMap hc, expOrd_zero]
  map_mul {d e} {f g} _ _ := by
    simp only [chartDivNorm, map_mul, V.ord_mul, expOrd_add]
  map_add_le {d} {f g} _ _ := by
    simp only [chartDivNorm, map_add]
    rw [← (expOrd_antitone (ProjBerk.expNeg_le_one (by positivity))).map_min]
    exact expOrd_antitone (ProjBerk.expNeg_le_one (by positivity)) (V.min_le_ord_add _ _)
  sup_X := by
    refine le_antisymm (Finset.sup_le fun i _ =>
      expOrd_le_one (ProjBerk.expNeg_le_one (by positivity)) _) ?_
    refine le_trans ?_ (Finset.le_sup (f := fun i => X.chartDivNorm j V b 1 (MvPolynomial.X i))
      (Finset.mem_univ j))
    simp [chartDivNorm]

theorem chartDivPoint_mem (V : BirationalDVR k (X.ChartRing j)) (b : ℕ) :
    ProjBerk.ofGradedNorm (isGradedNorm_chartDivNorm V b) ∈ X.an := by
  refine (ProjBerk.mem_zeroLocus_iff X.isHomogeneousIdeal).2 fun D f hf hfI => ?_
  rw [ProjBerk.ofGradedNorm_val_of_isHomogeneous _ hf, chartDivNorm, quotDehom_eq_zero_of_mem hfI,
    Polynomial.C_0, BirationalDVR.ord_zero, expOrd_top]

variable (X j) in
/-- The point `v_V ∈ X^an` attached to a discrete valuation ring `B_j ⊆ V ⊆ Frac B_j` and
`b = ord_V(t)`: the graded extension of `|s| = e^{-ord_V(s̄ / x̄ⱼ^c)/b}` on forms `s` of degree `c`
(`lem:sg-div-points`(2)). -/
def chartDivPoint (V : BirationalDVR k (X.ChartRing j)) (b : ℕ) : X.an :=
  ⟨ProjBerk.ofGradedNorm (isGradedNorm_chartDivNorm V b), chartDivPoint_mem V b⟩

variable (V : BirationalDVR k (X.ChartRing j)) (b : ℕ)

/-- `|s|_{v_V} = e^{-ord_V(s̄ / x̄ⱼ^c)/b}` for a form `s` of degree `c`. -/
theorem chartDivPoint_val_of_isHomogeneous {c : ℕ} {s : MvPolynomial (Fin (M + 1)) k}
    (hs : s.IsHomogeneous c) :
    (X.chartDivPoint j V b : ProjBerk k M).1.val s =
      expOrd (expNeg (b : ℝ)⁻¹) (V.ord (Polynomial.C (X.quotDehom j s))) :=
  ProjBerk.ofGradedNorm_val_of_isHomogeneous _ hs

/-- `|xⱼ|_{v_V} = 1`. -/
theorem chartDivPoint_val_X_self :
    (X.chartDivPoint j V b : ProjBerk k M).1.val (MvPolynomial.X j) = 1 := by
  rw [chartDivPoint_val_of_isHomogeneous V b (MvPolynomial.isHomogeneous_X k j)]
  simp

/-- The terms `ord_V(δⱼ((g_ℓ)_c)) + ℓ b` of the double infimum computing both
`-b log|g|_{σ(v_V)}` and `ord_{R'}(ḡ)`. -/
def chartOrdTerm (g : (MvPolynomial (Fin (M + 1)) k)[X]) (c ℓ : ℕ) : ℕ∞ :=
  V.ord (Polynomial.C (X.quotDehom j (MvPolynomial.homogeneousComponent c (g.coeff ℓ)))) +
    ((ℓ * b : ℕ) : ℕ∞)

theorem gaussExt_chartDivPoint_val (hb : 0 < b) (g : (MvPolynomial (Fin (M + 1)) k)[X]) :
    (gaussExt (X.chartDivPoint j V b : ProjBerk k M)).val g =
      expOrd (expNeg (b : ℝ)⁻¹) (⨅ ℓ, ⨅ c, chartOrdTerm V b g c ℓ) := by
  have hq := ProjBerk.expNeg_le_one (c := (b : ℝ)⁻¹) (by positivity)
  have hv : ∀ s : MvPolynomial (Fin (M + 1)) k, (X.chartDivPoint j V b : ProjBerk k M).1.val s =
      expOrd (expNeg (b : ℝ)⁻¹) (⨅ c, V.ord (Polynomial.C (X.quotDehom j
        (MvPolynomial.homogeneousComponent c s)))) := by
    intro s
    change (ProjBerk.ofGradedNorm (isGradedNorm_chartDivNorm V b)).1.val s = _
    rw [ProjBerk.ofGradedNorm_val_apply, ProjBerk.gradedFun,
      expOrd_iInf_eq_finset_sup hq (Finset.range (s.totalDegree + 1))]
    · rfl
    · intro c hc
      rw [Finset.mem_range, not_lt] at hc
      rw [MvPolynomial.homogeneousComponent_eq_zero c s (by omega)]
      simp
  rw [ProjBerk.gaussExt_val_apply, expOrd_iInf_eq_finset_sup hq g.support]
  · refine Finset.sup_congr rfl fun ℓ _ => ?_
    rw [hv, ProjBerk.gaussRadius_eq_pow hb, ← pow_mul', ← expOrd_coe, ← expOrd_add, ENat.iInf_add]
    rfl
  · intro ℓ hℓ
    simp [chartOrdTerm, Polynomial.notMem_support_iff.1 hℓ]

theorem chartDVR_ord_eq_iInf
    (htorus : ∀ F : X.ChartRing j, V.ord F = F.support.inf fun ℓ =>
      V.ord (Polynomial.C (F.coeff ℓ)) + ((ℓ * b : ℕ) : ℕ∞))
    (g : (MvPolynomial (Fin (M + 1)) k)[X]) :
    (X.chartDVR j V).ord (X.coneMk g) = ⨅ ℓ, ⨅ c, chartOrdTerm V b g c ℓ := by
  rw [iInf_comm, chartDVR_ord, ProjBerk.finset_inf_eq_iInf_of_top]
  · refine iInf_congr fun c => ?_
    rw [htorus, ProjBerk.finset_inf_eq_iInf_of_top]
    · refine iInf_congr fun ℓ => ?_
      rw [chartOrdTerm, coeff_coeff_coneToChartPoly]
    · intro ℓ hℓ
      rw [Polynomial.notMem_support_iff.1 hℓ]
      simp
  · intro c hc
    rw [Polynomial.notMem_support_iff.1 hc]
    simp

/-- `|g|_{σ(v_V)} = e^{-ord_{R'}(ḡ)/b}`. -/
theorem gaussExt_chartDivPoint_val_eq (hb : 0 < b)
    (htorus : ∀ F : X.ChartRing j, V.ord F = F.support.inf fun ℓ =>
      V.ord (Polynomial.C (F.coeff ℓ)) + ((ℓ * b : ℕ) : ℕ∞))
    (g : (MvPolynomial (Fin (M + 1)) k)[X]) :
    (gaussExt (X.chartDivPoint j V b : ProjBerk k M)).val g =
      expOrd (expNeg (b : ℝ)⁻¹) ((X.chartDVR j V).ord (X.coneMk g)) := by
  rw [gaussExt_chartDivPoint_val V b hb, chartDVR_ord_eq_iInf V b htorus]

/-- **`lem:sg-div-points`(2)**: if `B_j ⊆ V ⊆ Frac B_j` is a discrete valuation ring essentially of
finite type over `k` with `b = ord_V(t) > 0` and `ord_V(∑_ℓ f_ℓ t^ℓ) = min_ℓ (ord_V(f_ℓ) + ℓ b)`
for `f_ℓ ∈ A_j`, then `v_V` is divisorial, with `R' = V[x̄ⱼ]_{m_V V[x̄ⱼ]}` and `c = 1/b`. -/
theorem isDivisorial_chartDivPoint (hb : 0 < b)
    (htorus : ∀ F : X.ChartRing j, V.ord F = F.support.inf fun ℓ =>
      V.ord (Polynomial.C (F.coeff ℓ)) + ((ℓ * b : ℕ) : ℕ∞)) :
    X.IsDivisorial (X.chartDivPoint j V b) :=
  isDivisorial_of_val_eq (X.chartDVR j V) (c := (b : ℚ)⁻¹) (by positivity) fun g => by
    rw [gaussExt_chartDivPoint_val_eq V b hb htorus]
    push_cast
    rfl

/-- `log|g|_{σ(v_V)} = -ord_V(g^{(j)})/b` for `g ∈ R_M[t]` homogeneous of degree `d` in `x`,
where `g^{(j)} = δⱼ(g) ∈ B_j` (`lem:sg-div-points`(2)). -/
theorem logAbs_gaussExt_chartDivPoint (hb : 0 < b)
    (htorus : ∀ F : X.ChartRing j, V.ord F = F.support.inf fun ℓ =>
      V.ord (Polynomial.C (F.coeff ℓ)) + ((ℓ * b : ℕ) : ℕ∞))
    {d : ℕ} {g : (MvPolynomial (Fin (M + 1)) k)[X]} (hg : ∀ ℓ, (g.coeff ℓ).IsHomogeneous d) :
    Berk.logAbs g (gaussExt (X.chartDivPoint j V b : ProjBerk k M)) =
      -(((b : ℝ)⁻¹ : ℝ) : EReal) * (V.ord (g.map (X.quotDehom j).toRingHom) : EReal) := by
  have key : (⨅ ℓ, ⨅ c, chartOrdTerm V b g c ℓ) = V.ord (g.map (X.quotDehom j).toRingHom) := by
    rw [htorus, ProjBerk.finset_inf_eq_iInf_of_top]
    · refine iInf_congr fun ℓ => ?_
      rw [show (⨅ c, chartOrdTerm V b g c ℓ) = chartOrdTerm V b g d ℓ from ?_, chartOrdTerm,
        Polynomial.coeff_map, MvPolynomial.homogeneousComponent_eq_self (hg ℓ)]
      · rfl
      refine le_antisymm (iInf_le _ d) (le_iInf fun c => ?_)
      by_cases hc : c = d
      · rw [hc]
      · have htop : chartOrdTerm V b g c ℓ = ⊤ := by
          simp [chartOrdTerm, MvPolynomial.homogeneousComponent_of_mem (hg ℓ), hc]
        rw [htop]
        exact le_top
    · intro ℓ hℓ
      rw [Polynomial.notMem_support_iff.1 hℓ]
      simp
  rw [Berk.logAbs, gaussExt_chartDivPoint_val V b hb, key, log_expOrd_expNeg (by positivity)]

end ChartPoint

end ProjSubvariety

end EnvelopeProperty
