import EnvelopeProperty.Berkovich.Gauss

/-!
# The analytification of projective space over a trivially valued field

Let `k` be a field with the trivial absolute value and `R = k[x₀, …, xₙ]` the homogeneous
coordinate ring of `ℙⁿ`. This file sets up a concrete model of the Berkovich analytification
`(ℙⁿ)^an` used in Fang–Han–Xia, *The envelope property for unibranch projective varieties*, §2
(`sec:preliminaries`), for `X = ℙⁿ`, together with the Gauss extension `σ` and the functions `φ_I`
of §2.1 (`subsec:prelim-berkovich`).

## The model

A point of `(ℙⁿ)^an` is modelled as a point `v ∈ Berk k R = (𝔸ⁿ⁺¹)^an` (a multiplicative
ultrametric seminorm on `R`, trivial on `k`) that is

* *graded* (`EnvelopeProperty.IsGraded`): `|f|_v = max_d |f_d|_v`, the maximum over the
  homogeneous components `f_d` of `f`; and
* *normalized*: `max_i |xᵢ|_v = 1`.

Justification. A point `(ξ, |·|)` of `(ℙⁿ)^an`, with `ξ` in the chart
`xⱼ ≠ 0`, gives `|f| := |f/xⱼ^d|(ξ) / max_i |xᵢ/xⱼ|(ξ)^d` on forms of degree `d`, extended to `R`
by the maximum over homogeneous components; this is independent of `j`, multiplicative by the
graded form of Gauss's lemma (minimal dominant components multiply to a dominant component),
graded and normalized. Conversely the kernel of a graded normalized seminorm is a homogeneous
prime not containing all `xᵢ`, i.e. a point `ξ ∈ ℙⁿ`, and ratios of forms of equal degree give a
real valuation of `κ(ξ)` trivial on `k`. These constructions are inverse to each other, and the
topology induced from `Berk k R` (the coarsest one making all `v ↦ |f|_v` continuous) agrees with
the Berkovich topology. In this model `log|s|(v)` for a form `s` of degree `d` is the value
`log|s/xⱼ^d|` in the trivialisation at the centre of `v` given by an `xⱼ` with `|xⱼ|_v = 1`.

The affine chart construction and its inverse are in `EnvelopeProperty.Projective.Charts`.
`EnvelopeProperty.Projective.Support` constructs the homogeneous prime support in Mathlib's
projective spectrum, `EnvelopeProperty.Projective.NativeComparison` the degree-zero stalk and the
residue field, and `EnvelopeProperty.Projective.NativeBridge` identifies this point model with the
points of the analytification of the scheme. Comparisons of analytic structure sheaves and of
coherent ideals are not treated there.

## Main definitions

* `EnvelopeProperty.IsGraded v`: `v` is graded.
* `EnvelopeProperty.ProjBerk k n`: the model of `(ℙⁿ)^an`, with the subspace topology; it is
  compact (`ProjBerk.instCompactSpace`: a closed subset of the polydisc `|xᵢ| ≤ 1`) and Hausdorff.
* `ProjBerk.triv`: the trivial valuation `v_triv` (`|f| = 1` for `f ≠ 0`).
* `ProjBerk.logAbs s v = log|s|_v ∈ [-∞, 0]`.
* `ProjBerk.gaussExt v = σ(v)`: the Gauss extension of FHX §2.1 to `S = X × 𝔸¹`, modelled as the
  Gauss point of radius `e⁻¹` on `R[t]`, so that
  `log|∑_λ s_λ t^λ|_{σ(v)} = max_λ (log|s_λ|_v - λ)` (`ProjBerk.logAbs_gaussExt`), i.e.
  `σ(v)(∑ s_λ t^λ) = min_λ (v(s_λ) + λ)` additively.
* `ProjBerk.phiIdeal I v = φ_I(v) = sup_{g ∈ I} log|g|_{σ(v)}` for an ideal `I ⊆ R[t]`.
  For `I` homogeneous in the `x`-variables this is FHX's `φ_I(v) = -σ(v)(I)`: at the centre some
  `xⱼ` has `|xⱼ|_v = 1`, the local generators are `gₐ/xⱼ^{dₐ}` with the same absolute values as
  homogeneous generators `gₐ`, and the supremum over the ideal is the maximum over generators
  (`ProjBerk.phiIdeal_span_finset`), all elements of `R[t]` having absolute value `≤ 1`.

## Main results

* `ProjBerk.val_le_one`: `|f|_v ≤ 1` for all `f ∈ R`; `ProjBerk.gaussExt_val_le_one`.
* `ProjBerk.phiIdeal_le_zero`, `ProjBerk.phiIdeal_mono`, `ProjBerk.phiIdeal_top`,
  `ProjBerk.phiIdeal_bot`, `ProjBerk.phiIdeal_mul` (`φ_{IJ} = φ_I + φ_J`), `ProjBerk.phiIdeal_pow`
  (`φ_{I^m} = m φ_I`), `ProjBerk.phiIdeal_span` and `ProjBerk.phiIdeal_span_finset` (the formula
  for an ideal generated by a set), `ProjBerk.continuous_phiIdeal`.
-/

open scoped NNReal ENNReal Topology Polynomial

open Set Topology

noncomputable section

namespace EnvelopeProperty

universe u

/-! ### Graded seminorms -/

section Graded

variable {k : Type*} [Field k] {σ : Type*}

/-- A point `v` of `(𝔸^σ)^an = Berk k k[σ]` is **graded** if `|f|_v = max_d |f_d|_v` for every
polynomial `f`, the maximum being over the homogeneous components `f_d` of `f` (which vanish for
`d > deg f`). -/
def IsGraded (v : Berk k (MvPolynomial σ k)) : Prop :=
  ∀ f : MvPolynomial σ k, v.val f =
    (Finset.range (f.totalDegree + 1)).sup fun d => v.val (MvPolynomial.homogeneousComponent d f)

/-- The ultrametric inequality gives `|f| ≤ max_d |f_d|` for free: being graded means
`|f_d| ≤ |f|` for all `d`. -/
theorem isGraded_iff (v : Berk k (MvPolynomial σ k)) :
    IsGraded v ↔ ∀ f d, v.val (MvPolynomial.homogeneousComponent d f) ≤ v.val f := by
  constructor
  · intro h f d
    by_cases hd : d ≤ f.totalDegree
    · rw [h f]
      exact Finset.le_sup (f := fun d => v.val (MvPolynomial.homogeneousComponent d f))
        (Finset.mem_range.2 (Nat.lt_succ_of_le hd))
    · rw [MvPolynomial.homogeneousComponent_eq_zero d f (not_le.1 hd), map_zero]
      exact zero_le
  · intro h f
    refine le_antisymm ?_ (Finset.sup_le fun d _ => h f d)
    conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent f]
    exact v.val.map_sum_le fun d hd =>
      Finset.le_sup (f := fun d => v.val (MvPolynomial.homogeneousComponent d f)) hd

theorem isClosed_setOf_isGraded : IsClosed {v : Berk k (MvPolynomial σ k) | IsGraded v} := by
  have e : {v : Berk k (MvPolynomial σ k) | IsGraded v} =
      ⋂ f : MvPolynomial σ k, {v | v.val f = (Finset.range (f.totalDegree + 1)).sup
        fun d => v.val (MvPolynomial.homogeneousComponent d f)} := by
    ext v
    simp [IsGraded]
  rw [e]
  exact isClosed_iInter fun f => isClosed_eq (Berk.continuous_val_apply f)
    (Continuous.finset_sup_apply fun d _ => Berk.continuous_val_apply _)

/-- The trivial valuation is graded: a nonzero polynomial has a nonzero homogeneous component. -/
theorem isGraded_triv : IsGraded (Berk.triv : Berk k (MvPolynomial σ k)) := by
  classical
  rw [isGraded_iff]
  intro f d
  by_cases hf : f = 0
  · simp [hf]
  · rw [Berk.triv_val_of_ne_zero hf]
    by_cases hd : MvPolynomial.homogeneousComponent d f = 0
    · rw [hd, map_zero]; exact zero_le
    · rw [Berk.triv_val_of_ne_zero hd]

end Graded

/-! ### The model of `(ℙⁿ)^an` -/

variable (k : Type u) [Field k] (n : ℕ)

/-- The **analytification of projective space** `(ℙⁿ)^an` over the trivially valued field `k`,
modelled as the graded points `v` of `Berk k k[x₀, …, xₙ]` normalized by `max_i |xᵢ|_v = 1`
(see the module docstring for the identification with semivaluations on `ℙⁿ`). -/
def ProjBerk : Type u :=
  {v : Berk k (MvPolynomial (Fin (n + 1)) k) //
    IsGraded v ∧ Finset.univ.sup (fun i => v.val (MvPolynomial.X i)) = 1}

namespace ProjBerk

variable {k n}

/-- The topology of `(ℙⁿ)^an`: the subspace topology from `Berk k k[x₀, …, xₙ]`. -/
instance : TopologicalSpace (ProjBerk k n) := instTopologicalSpaceSubtype

theorem isEmbedding_val :
    IsEmbedding (Subtype.val : ProjBerk k n → Berk k (MvPolynomial (Fin (n + 1)) k)) :=
  IsEmbedding.subtypeVal

@[fun_prop]
theorem continuous_val :
    Continuous (Subtype.val : ProjBerk k n → Berk k (MvPolynomial (Fin (n + 1)) k)) :=
  continuous_subtype_val

@[ext]
theorem ext {v w : ProjBerk k n} (h : v.1 = w.1) : v = w := Subtype.ext h

theorem isGraded (v : ProjBerk k n) : IsGraded v.1 := v.2.1

/-- The normalization `max_i |xᵢ|_v = 1`. -/
theorem sup_val_X (v : ProjBerk k n) :
    Finset.univ.sup (fun i => v.1.val (MvPolynomial.X i)) = 1 :=
  v.2.2

theorem val_X_le_one (v : ProjBerk k n) (i : Fin (n + 1)) : v.1.val (MvPolynomial.X i) ≤ 1 :=
  (Finset.le_sup (f := fun i => v.1.val (MvPolynomial.X i)) (Finset.mem_univ i)).trans
    (sup_val_X v).le

/-- Some coordinate has `|xⱼ|_v = 1`: the centre of `v` lies in the chart `xⱼ ≠ 0`. -/
theorem exists_val_X_eq_one (v : ProjBerk k n) : ∃ j, v.1.val (MvPolynomial.X j) = 1 := by
  obtain ⟨j, -, hj⟩ := Finset.exists_mem_eq_sup Finset.univ Finset.univ_nonempty
    fun i => v.1.val (MvPolynomial.X i)
  exact ⟨j, hj ▸ sup_val_X v⟩

/-- Every polynomial has absolute value `≤ 1` at a point of `(ℙⁿ)^an`. -/
theorem val_le_one (v : ProjBerk k n) (f : MvPolynomial (Fin (n + 1)) k) : v.1.val f ≤ 1 := by
  have h := Berk.abs_aeval_le_pow (k := k) (MvPolynomial.X : Fin (n + 1) → _) v.1 le_rfl
    (val_X_le_one v) f
  rwa [MvPolynomial.aeval_X_left_apply, one_pow] at h

variable (k n) in
/-- The underlying set of `(ℙⁿ)^an` in `Berk k k[x₀, …, xₙ]`. -/
def carrier : Set (Berk k (MvPolynomial (Fin (n + 1)) k)) :=
  {v | IsGraded v ∧ Finset.univ.sup (fun i => v.val (MvPolynomial.X i)) = 1}

theorem range_val :
    range (Subtype.val : ProjBerk k n → Berk k (MvPolynomial (Fin (n + 1)) k)) =
      carrier k n :=
  Subtype.range_coe

theorem isClosed_carrier : IsClosed (carrier k n) :=
  isClosed_setOf_isGraded.inter (isClosed_eq
    (Continuous.finset_sup_apply fun _ _ => Berk.continuous_val_apply _) continuous_const)

/-- `(ℙⁿ)^an` is a closed subset of the closed unit polydisc `|xᵢ| ≤ 1` of `(𝔸ⁿ⁺¹)^an`, hence
compact. -/
theorem isCompact_carrier : IsCompact (carrier k n) :=
  Berk.isCompact_of_isClosed_of_forall_abs_le (MvPolynomial.adjoin_range_X (R := k))
    isClosed_carrier 1 (by
      rintro v hv _ ⟨i, rfl⟩
      exact (Finset.le_sup (f := fun i => v.val (MvPolynomial.X i)) (Finset.mem_univ i)).trans
        hv.2.le)

theorem isClosedEmbedding_val :
    IsClosedEmbedding (Subtype.val : ProjBerk k n → Berk k (MvPolynomial (Fin (n + 1)) k)) :=
  ⟨isEmbedding_val, by rw [range_val]; exact isClosed_carrier⟩

/-- `(ℙⁿ)^an` is compact. -/
instance instCompactSpace : CompactSpace (ProjBerk k n) :=
  isCompact_iff_compactSpace.1 isCompact_carrier

/-- `(ℙⁿ)^an` is Hausdorff. -/
instance instT2Space : T2Space (ProjBerk k n) :=
  inferInstanceAs (T2Space {v : Berk k (MvPolynomial (Fin (n + 1)) k) //
    IsGraded v ∧ Finset.univ.sup (fun i => v.val (MvPolynomial.X i)) = 1})

/-- A map into `(ℙⁿ)^an` is continuous iff all `|f|` are continuous along it. -/
theorem continuous_iff {Y : Type*} [TopologicalSpace Y] {g : Y → ProjBerk k n} :
    Continuous g ↔ ∀ f : MvPolynomial (Fin (n + 1)) k, Continuous fun y => (g y).1.val f := by
  refine ⟨fun h f => (Berk.continuous_val_apply f).comp (continuous_val.comp h), fun h => ?_⟩
  exact isEmbedding_val.continuous_iff.2 (Berk.continuous_iff.2 h)

/-! ### The trivial valuation -/

/-- The **trivial valuation** `v_triv ∈ (ℙⁿ)^an`: `|f| = 1` for every `f ≠ 0`. -/
def triv : ProjBerk k n :=
  ⟨Berk.triv, isGraded_triv, by
    refine le_antisymm (Finset.sup_le fun i _ => ?_) ?_
    · rw [Berk.triv_val_of_ne_zero (MvPolynomial.X_ne_zero i)]
    · refine le_trans ?_ (Finset.le_sup (f := fun i => (Berk.triv :
        Berk k (MvPolynomial (Fin (n + 1)) k)).val (MvPolynomial.X i)) (Finset.mem_univ 0))
      rw [Berk.triv_val_of_ne_zero (MvPolynomial.X_ne_zero _)]⟩

@[simp]
theorem triv_val : (triv : ProjBerk k n).1 = Berk.triv := rfl

theorem triv_val_of_ne_zero {f : MvPolynomial (Fin (n + 1)) k} (hf : f ≠ 0) :
    (triv : ProjBerk k n).1.val f = 1 :=
  Berk.triv_val_of_ne_zero hf

/-! ### The functions `log|s|` -/

/-- The function `log|s| : (ℙⁿ)^an → [-∞, 0]` attached to `s ∈ k[x₀, …, xₙ]`; for a form `s` of
degree `d` this is FHX's `log|s|(v) = -v(s)`, computed in the trivialisation `xⱼ^d` at the centre
of `v`, where `|xⱼ|_v = 1`. -/
def logAbs (s : MvPolynomial (Fin (n + 1)) k) (v : ProjBerk k n) : EReal :=
  Berk.logAbs s v.1

theorem logAbs_def (s : MvPolynomial (Fin (n + 1)) k) (v : ProjBerk k n) :
    logAbs s v = ENNReal.log (v.1.val s : ℝ≥0∞) := rfl

@[fun_prop]
theorem continuous_logAbs (s : MvPolynomial (Fin (n + 1)) k) :
    Continuous (logAbs s : ProjBerk k n → EReal) :=
  (Berk.continuous_logAbs s).comp continuous_val

theorem logAbs_le_zero (s : MvPolynomial (Fin (n + 1)) k) (v : ProjBerk k n) :
    logAbs s v ≤ 0 := by
  rw [logAbs_def, ENNReal.log_le_zero_iff]
  exact_mod_cast val_le_one v s

theorem logAbs_ne_top (s : MvPolynomial (Fin (n + 1)) k) (v : ProjBerk k n) : logAbs s v ≠ ⊤ :=
  Berk.logAbs_ne_top s v.1

theorem logAbs_mul (s s' : MvPolynomial (Fin (n + 1)) k) (v : ProjBerk k n) :
    logAbs (s * s') v = logAbs s v + logAbs s' v :=
  Berk.logAbs_mul s s' v.1

theorem logAbs_pow (s : MvPolynomial (Fin (n + 1)) k) (m : ℕ) (v : ProjBerk k n) :
    logAbs (s ^ m) v = m * logAbs s v :=
  Berk.logAbs_pow s m v.1

theorem logAbs_eq_bot_iff (s : MvPolynomial (Fin (n + 1)) k) (v : ProjBerk k n) :
    logAbs s v = ⊥ ↔ v.1.val s = 0 :=
  Berk.logAbs_eq_bot_iff s v.1

@[simp]
theorem logAbs_zero (v : ProjBerk k n) : logAbs 0 v = ⊥ := Berk.logAbs_zero v.1

@[simp]
theorem logAbs_one (v : ProjBerk k n) : logAbs 1 v = 0 := Berk.logAbs_one v.1

theorem logAbs_triv_of_ne_zero {s : MvPolynomial (Fin (n + 1)) k} (hs : s ≠ 0) :
    logAbs s (triv : ProjBerk k n) = 0 :=
  Berk.logAbs_triv_of_ne_zero hs

/-- The normalization in logarithmic form: `max_i log|xᵢ|_v = 0`. -/
theorem sup_logAbs_X (v : ProjBerk k n) :
    Finset.univ.sup (fun i => logAbs (MvPolynomial.X i) v) = 0 := by
  have h := Finset.apply_sup_eq_sup_comp_of_linearOrder (s := Finset.univ)
    (f := fun i => v.1.val (MvPolynomial.X i)) (fun t : ℝ≥0 => ENNReal.log (t : ℝ≥0∞))
    (ENNReal.log_monotone.comp ENNReal.coe_mono) (by simp)
  simp only [sup_val_X, ENNReal.coe_one, ENNReal.log_one] at h
  exact h.symm

/-! ### The Gauss extension -/

/-- The radius `e⁻¹` of the Gauss extension: `|t|_{σ(v)} = e⁻¹`, i.e. `σ(v)(t) = 1`. -/
def gaussRadius : ℝ≥0 := ⟨Real.exp (-1), (Real.exp_pos _).le⟩

theorem gaussRadius_ne_zero : gaussRadius ≠ 0 := by
  rw [← NNReal.coe_ne_zero]
  exact (Real.exp_pos _).ne'

theorem gaussRadius_le_one : gaussRadius ≤ 1 := by
  rw [← NNReal.coe_le_coe]
  exact Real.exp_le_one_iff.2 (by norm_num)

theorem log_gaussRadius : ENNReal.log (gaussRadius : ℝ≥0∞) = -1 := by
  rw [ENNReal.log_of_nnreal gaussRadius_ne_zero]
  change ((Real.log (Real.exp (-1)) : ℝ) : EReal) = -1
  rw [Real.log_exp]
  rfl

/-- The **Gauss extension** `σ(v)` of `v ∈ (ℙⁿ)^an` to `S = ℙⁿ × 𝔸¹` (FHX §2.1), modelled on
the coordinate ring `R[t]`: the Gauss point of radius `e⁻¹` over `v`,
`|∑_λ s_λ t^λ|_{σ(v)} = max_λ |s_λ|_v e^{-λ}`. -/
def gaussExt (v : ProjBerk k n) : Berk k (MvPolynomial (Fin (n + 1)) k)[X] :=
  Berk.gauss v.1 gaussRadius

@[fun_prop]
theorem continuous_gaussExt : Continuous (gaussExt : ProjBerk k n → _) :=
  (Berk.continuous_gauss gaussRadius).comp continuous_val

theorem gaussExt_val_apply (v : ProjBerk k n) (F : (MvPolynomial (Fin (n + 1)) k)[X]) :
    (gaussExt v).val F = F.support.sup fun ℓ => v.1.val (F.coeff ℓ) * gaussRadius ^ ℓ :=
  rfl

@[simp]
theorem gaussExt_val_C (v : ProjBerk k n) (s : MvPolynomial (Fin (n + 1)) k) :
    (gaussExt v).val (Polynomial.C s) = v.1.val s :=
  Berk.gauss_val_C v.1 gaussRadius s

/-- The Gauss extension restricts to `v` on functions from `ℙⁿ`. -/
@[simp]
theorem proj_gaussExt (v : ProjBerk k n) : Berk.proj (gaussExt v) = v.1 :=
  Berk.proj_gauss v.1 gaussRadius

@[simp]
theorem gaussExt_val_X (v : ProjBerk k n) : (gaussExt v).val Polynomial.X = gaussRadius :=
  Berk.gauss_val_X v.1 gaussRadius

/-- `log|t|_{σ(v)} = -1`, i.e. `σ(v)(t) = 1`. -/
@[simp]
theorem logAbs_X_gaussExt (v : ProjBerk k n) :
    Berk.logAbs (Polynomial.X : (MvPolynomial (Fin (n + 1)) k)[X]) (gaussExt v) = -1 := by
  rw [gaussExt, Berk.logAbs_X_gauss, log_gaussRadius]

@[simp]
theorem logAbs_C_gaussExt (s : MvPolynomial (Fin (n + 1)) k) (v : ProjBerk k n) :
    Berk.logAbs (Polynomial.C s) (gaussExt v) = logAbs s v := by
  rw [Berk.logAbs, gaussExt_val_C]
  rfl

/-- The defining formula of the Gauss extension:
`log|∑_λ s_λ t^λ|_{σ(v)} = max_λ (log|s_λ|_v - λ)`. -/
theorem logAbs_gaussExt (F : (MvPolynomial (Fin (n + 1)) k)[X]) (v : ProjBerk k n) :
    Berk.logAbs F (gaussExt v) = F.support.sup fun ℓ => logAbs (F.coeff ℓ) v - ℓ := by
  rw [gaussExt, Berk.logAbs_gauss, log_gaussRadius]
  refine Finset.sup_congr rfl fun ℓ _ => ?_
  rw [sub_eq_add_neg, mul_neg_one]
  rfl

/-- Every element of `R[t]` has absolute value `≤ 1` at a Gauss extension. -/
theorem gaussExt_val_le_one (v : ProjBerk k n) (F : (MvPolynomial (Fin (n + 1)) k)[X]) :
    (gaussExt v).val F ≤ 1 := by
  rw [gaussExt, Berk.gauss_val_le_iff]
  intro ℓ
  calc v.1.val (F.coeff ℓ) * gaussRadius ^ ℓ ≤ 1 * 1 ^ ℓ := by
        gcongr
        · exact val_le_one v _
        · exact gaussRadius_le_one
    _ = 1 := by simp

theorem logAbs_gaussExt_le_zero (v : ProjBerk k n) (F : (MvPolynomial (Fin (n + 1)) k)[X]) :
    Berk.logAbs F (gaussExt v) ≤ 0 := by
  rw [Berk.logAbs, ENNReal.log_le_zero_iff]
  exact_mod_cast gaussExt_val_le_one v F

/-! ### The functions `φ_I` -/

/-- The multiplicative form `‖I‖_{σ(v)} = sup_{g ∈ I} |g|_{σ(v)} ∈ [0, 1]` of `exp φ_I(v)`. -/
def phiNorm (I : Ideal (MvPolynomial (Fin (n + 1)) k)[X]) (v : ProjBerk k n) : ℝ≥0∞ :=
  ⨆ g ∈ I, ((gaussExt v).val g : ℝ≥0∞)

/-- The function `φ_I(v) = -σ(v)(I) = sup_{g ∈ I} log|g|_{σ(v)}` attached to an ideal `I` of
`R[t]` (FHX §2.1). For `I` homogeneous in the `x`-variables, the supremum over `I` equals the
maximum over (local) generators at the centre of `v`; see `phiIdeal_span_finset`. The value `-∞`
is allowed. -/
def phiIdeal (I : Ideal (MvPolynomial (Fin (n + 1)) k)[X]) (v : ProjBerk k n) : EReal :=
  ⨆ g ∈ I, Berk.logAbs g (gaussExt v)

variable (I J : Ideal (MvPolynomial (Fin (n + 1)) k)[X]) (v : ProjBerk k n)

theorem phiIdeal_eq_log_phiNorm : phiIdeal I v = ENNReal.log (phiNorm I v) := by
  simp only [phiIdeal, phiNorm, Berk.logAbs, ← ENNReal.logOrderIso_apply, OrderIso.map_iSup]

theorem le_phiNorm {g : (MvPolynomial (Fin (n + 1)) k)[X]} (hg : g ∈ I) :
    ((gaussExt v).val g : ℝ≥0∞) ≤ phiNorm I v :=
  le_iSup₂_of_le (f := fun g (_ : g ∈ I) => ((gaussExt v).val g : ℝ≥0∞)) g hg le_rfl

theorem le_phiIdeal {g : (MvPolynomial (Fin (n + 1)) k)[X]} (hg : g ∈ I) :
    Berk.logAbs g (gaussExt v) ≤ phiIdeal I v :=
  le_iSup₂_of_le (f := fun g (_ : g ∈ I) => Berk.logAbs g (gaussExt v)) g hg le_rfl

theorem phiNorm_le_one : phiNorm I v ≤ 1 :=
  iSup₂_le fun g _ => by exact_mod_cast gaussExt_val_le_one v g

/-- `φ_I ≤ 0`. -/
theorem phiIdeal_le_zero : phiIdeal I v ≤ 0 :=
  iSup₂_le fun g _ => logAbs_gaussExt_le_zero v g

/-- `φ_I` is monotone in `I`. -/
theorem phiIdeal_mono {I J : Ideal (MvPolynomial (Fin (n + 1)) k)[X]} (h : I ≤ J) :
    phiIdeal I v ≤ phiIdeal J v :=
  iSup₂_le fun _ hg => le_phiIdeal J v (h hg)

theorem phiNorm_mono {I J : Ideal (MvPolynomial (Fin (n + 1)) k)[X]} (h : I ≤ J) :
    phiNorm I v ≤ phiNorm J v :=
  iSup₂_le fun _ hg => le_phiNorm J v (h hg)

@[simp]
theorem phiNorm_top : phiNorm ⊤ v = 1 :=
  le_antisymm (phiNorm_le_one _ v) (by
    simpa using le_phiNorm (⊤ : Ideal (MvPolynomial (Fin (n + 1)) k)[X]) v Submodule.mem_top
      (g := 1))

/-- `φ_{R[t]} = 0`. -/
@[simp]
theorem phiIdeal_top : phiIdeal ⊤ v = 0 := by
  rw [phiIdeal_eq_log_phiNorm, phiNorm_top, ENNReal.log_one]

@[simp]
theorem phiNorm_bot : phiNorm ⊥ v = 0 := by
  simp [phiNorm, Submodule.mem_bot]

/-- `φ_{(0)} = -∞`. -/
@[simp]
theorem phiIdeal_bot : phiIdeal ⊥ v = ⊥ := by
  rw [phiIdeal_eq_log_phiNorm, phiNorm_bot, ENNReal.log_zero]

/-- An ideal-generation bound: if all generators in `S` satisfy `|g|_{σ(v)} ≤ M`, so does every
element of the ideal they generate (the coefficients have absolute value `≤ 1`). -/
theorem val_le_of_mem_span {S : Set (MvPolynomial (Fin (n + 1)) k)[X]} {M : ℝ≥0∞}
    (hS : ∀ g ∈ S, ((gaussExt v).val g : ℝ≥0∞) ≤ M) {h : (MvPolynomial (Fin (n + 1)) k)[X]}
    (hh : h ∈ Ideal.span S) : ((gaussExt v).val h : ℝ≥0∞) ≤ M := by
  induction hh using Submodule.span_induction with
  | mem g hg => exact hS g hg
  | zero => simp
  | add x y _ _ hx hy =>
    calc ((gaussExt v).val (x + y) : ℝ≥0∞) ≤
          max ((gaussExt v).val x : ℝ≥0∞) ((gaussExt v).val y) := by
          rw [← ENNReal.coe_max]
          exact ENNReal.coe_le_coe.2 ((gaussExt v).val.map_add x y)
      _ ≤ M := max_le hx hy
  | smul c x _ hx =>
    rw [smul_eq_mul, map_mul, ENNReal.coe_mul]
    calc ((gaussExt v).val c : ℝ≥0∞) * (gaussExt v).val x ≤ 1 * M := by
          gcongr
          exact_mod_cast gaussExt_val_le_one v c
      _ = M := one_mul M

/-- `‖(S)‖_{σ(v)} = sup_{g ∈ S} |g|_{σ(v)}`. -/
theorem phiNorm_span (S : Set (MvPolynomial (Fin (n + 1)) k)[X]) :
    phiNorm (Ideal.span S) v = ⨆ g ∈ S, ((gaussExt v).val g : ℝ≥0∞) := by
  refine le_antisymm (iSup₂_le fun h hh => val_le_of_mem_span v (fun g hg => ?_) hh)
    (iSup₂_le fun g hg => le_phiNorm _ v (Ideal.subset_span hg))
  exact le_iSup₂_of_le (f := fun g (_ : g ∈ S) => ((gaussExt v).val g : ℝ≥0∞)) g hg le_rfl

/-- The formula for `φ_I` when `I` is generated by a set `S`: `φ_{(S)} = sup_{g ∈ S} log|g|_{σ}`. -/
theorem phiIdeal_span (S : Set (MvPolynomial (Fin (n + 1)) k)[X]) :
    phiIdeal (Ideal.span S) v = ⨆ g ∈ S, Berk.logAbs g (gaussExt v) := by
  rw [phiIdeal_eq_log_phiNorm, phiNorm_span]
  simp only [Berk.logAbs, ← ENNReal.logOrderIso_apply, OrderIso.map_iSup]

/-- The formula for `φ_I` when `I` is generated by a finite set `S` of generators:
`φ_I = max_{g ∈ S} log|g|_{σ}`. -/
theorem phiIdeal_span_finset (S : Finset (MvPolynomial (Fin (n + 1)) k)[X]) :
    phiIdeal (Ideal.span (S : Set (MvPolynomial (Fin (n + 1)) k)[X])) v =
      S.sup fun g => Berk.logAbs g (gaussExt v) := by
  rw [phiIdeal_span, Finset.sup_eq_iSup]
  rfl

/-- `φ_I` is continuous: `R[t]` is Noetherian, so `I` is finitely generated and `φ_I` is a finite
maximum of the continuous functions `log|g|_{σ(·)}`. -/
@[fun_prop]
theorem continuous_phiIdeal : Continuous (phiIdeal (k := k) (n := n) I) := by
  obtain ⟨S, hS⟩ := (IsNoetherian.noetherian I : I.FG)
  have e : phiIdeal I = fun v => S.sup fun g => Berk.logAbs g (gaussExt v) := by
    funext v
    rw [← hS]
    exact phiIdeal_span_finset v S
  rw [e]
  exact Continuous.finset_sup_apply fun g _ => (Berk.continuous_logAbs g).comp continuous_gaussExt

/-- `‖IJ‖ = ‖I‖ ‖J‖`. -/
theorem phiNorm_mul : phiNorm (I * J) v = phiNorm I v * phiNorm J v := by
  refine le_antisymm ?_ ?_
  · refine iSup₂_le fun h hh => ?_
    refine Submodule.mul_induction_on hh (fun a ha b hb => ?_) (fun x y hx hy => ?_)
    · rw [map_mul, ENNReal.coe_mul]
      exact mul_le_mul' (le_phiNorm I v ha) (le_phiNorm J v hb)
    · calc ((gaussExt v).val (x + y) : ℝ≥0∞) ≤
            max ((gaussExt v).val x : ℝ≥0∞) ((gaussExt v).val y) := by
            rw [← ENNReal.coe_max]
            exact ENNReal.coe_le_coe.2 ((gaussExt v).val.map_add x y)
        _ ≤ _ := max_le hx hy
  · simp only [phiNorm, ENNReal.iSup_mul, ENNReal.mul_iSup]
    refine iSup₂_le fun b hb => iSup₂_le fun a ha => ?_
    rw [← ENNReal.coe_mul, ← map_mul]
    exact le_phiNorm _ v (Ideal.mul_mem_mul ha hb)

/-- `φ_{IJ} = φ_I + φ_J`. -/
theorem phiIdeal_mul : phiIdeal (I * J) v = phiIdeal I v + phiIdeal J v := by
  rw [phiIdeal_eq_log_phiNorm, phiIdeal_eq_log_phiNorm, phiIdeal_eq_log_phiNorm, phiNorm_mul,
    ENNReal.log_mul_add]

theorem phiNorm_pow (m : ℕ) : phiNorm (I ^ m) v = phiNorm I v ^ m := by
  induction m with
  | zero => simp
  | succ m ih => rw [pow_succ I m, phiNorm_mul, ih, pow_succ]

/-- `φ_{I^m} = m φ_I`. -/
theorem phiIdeal_pow (m : ℕ) : phiIdeal (I ^ m) v = m * phiIdeal I v := by
  rw [phiIdeal_eq_log_phiNorm, phiIdeal_eq_log_phiNorm, phiNorm_pow, ENNReal.log_pow]

end ProjBerk

end EnvelopeProperty
