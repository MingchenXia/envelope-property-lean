import EnvelopeProperty.Berkovich.Blowup
import EnvelopeProperty.Local.ProjectionStep

/-!
# Weakly psh functions

Fang–Han–Xia, *The envelope property for unibranch projective varieties*, Definition 5.6
(`def:weakly-psh`): a function `u` on an open subset `U ⊆ Y^an` is **weakly psh** if there is a
proper birational morphism `μ : Y' → Y` such that `u ∘ μ^an` is locally psh on `(μ^an)⁻¹(U)`;
weakly psh functions are upper semicontinuous, `μ^an` being proper and surjective.

## The definition in Lean

For an affine `Y = Spec A` (`A` a domain), the definition below uses the blowup along the ideal
generated by a finite set `s` containing a nonzero element. Its original affine charts are
`Spec A[s/g]` for nonzero `g ∈ s` (`EnvelopeProperty.blowupChart`), and `IsWeaklyPSHOn U u` asks
that `u ∘ μ^an` be locally psh on the preimage of `U` in every such chart. The exact equivalence
with an arbitrary actual proper birational native witness is proved by
`isWeaklyPSHOn_iff_properBirational_nativeWitness` in `Local/ProperBirationalWeaklyPSH.lean`.
The proof constructs genuine finite Rees domination and retains the whole original scalar,
chart and native function maps; it requires no external Chow hypothesis. Classical curve
potential theory remains a separate input.

## Main results

* Convex PL and locally psh functions pull back along `comap φ` (`IsConvexPLOn.comp_comap`,
  `IsLocallyPSHOn.comp_comap`); convex PL functions are continuous (`IsConvexPLOn.continuousAt`)
  and locally psh functions are upper semicontinuous (`IsLocallyPSHOn.upperSemicontinuousOn`).
* Regularizable functions pull back to decreasing limits of convex PL functions on all of
  `(Spec C)^an` along any `φ : A →ₐ[k] C` (`IsRegularizable.isDecrConvexPLLimitOn_comap`).
* **Upper semicontinuity** (`IsWeaklyPSHOn.upperSemicontinuousOn`,
  `IsWeaklyPSHOn.upperSemicontinuous`), from the properness and surjectivity of the closed
  subcharts (`isCompact_closedChart`, `exists_comap_chartMap_eq_of_le_one`).
* Locally psh and regularizable functions are weakly psh (`IsLocallyPSHOn.isWeaklyPSHOn`,
  `IsRegularizable.isWeaklyPSHOn`), and weak plurisubharmonicity is preserved by adding, or taking
  the maximum with, a regularizable function (`IsWeaklyPSHOn.add_isRegularizable`,
  `IsWeaklyPSHOn.max_isRegularizable`; FHX Lemma 5.11(3),(4)).
* `isPshClass_isWeaklyPSHOn_univ`: weakly psh functions on `Y^an` form an `IsPshClass`, the class
  of functions used in the projection step (`rmk:projection-step-conditional`).
-/

open scoped NNReal ENNReal Topology

open Topology

noncomputable section

namespace EnvelopeProperty

open Berk

/-! ### Convex PL and locally psh functions: continuity and pullbacks -/

section general

variable {k : Type*} [Field k] {A : Type*} [CommRing A] [Algebra k A]
  {C : Type*} [CommRing C] [Algebra k C] {U V : Set (Berk k A)} {u v : Berk k A → EReal}

/-- A convex PL function is real valued on its domain. -/
theorem IsConvexPLOn.ne_top (h : IsConvexPLOn U u) {y : Berk k A} (hy : y ∈ U) : u y ≠ ⊤ := by
  obtain ⟨W, -, hyW, -, n, f, s, hs, -, hu⟩ := h y hy
  rw [hu y hyW]
  exact EReal.coe_ne_top _

/-- A convex PL function is continuous at every point of its domain. -/
theorem IsConvexPLOn.continuousAt (h : IsConvexPLOn U u) {x : Berk k A} (hx : x ∈ U) :
    ContinuousAt u x := by
  obtain ⟨W, hW, hxW, -, n, f, s, hs, hf, hu⟩ := h x hx
  have hlog : ∀ i, ContinuousAt (fun y : Berk k A => Real.log (y.val (f i) : ℝ)) x := fun i =>
    (NNReal.continuous_coe.comp (continuous_abs (f i))).continuousAt.log
      (NNReal.coe_ne_zero.2 (hf x hxW i))
  have htrop : ∀ p ∈ s, ContinuousAt (fun y => tropAffine f p y) x := fun p _ =>
    (tendsto_finsetSum Finset.univ fun i _ => continuousAt_const.mul (hlog i)).add
      continuousAt_const
  have hcont : ContinuousAt (fun y => ((s.sup' hs fun p => tropAffine f p y : ℝ) : EReal)) x :=
    continuous_coe_real_ereal.continuousAt.comp (ContinuousAt.finset_sup'_apply hs htrop)
  exact hcont.congr (Filter.eventuallyEq_of_mem (hW.mem_nhds hxW) fun y hy => (hu y hy).symm)

/-- **Pullback of convex PL functions** along the map induced by a `k`-algebra map
`φ : A → C`: a local presentation `max (∑ aᵢ log|fᵢ| + b)` pulls back to the presentation with
the functions `φ(fᵢ)`. -/
theorem IsConvexPLOn.comp_comap (φ : A →ₐ[k] C) (h : IsConvexPLOn U u) :
    IsConvexPLOn (comap φ ⁻¹' U) fun y => u (comap φ y) := by
  intro y hy
  obtain ⟨W, hW, hyW, hWU, n, f, s, hs, hf, hu⟩ := h (comap φ y) hy
  exact ⟨comap φ ⁻¹' W, hW.preimage (continuous_comap φ), hyW, Set.preimage_mono hWU, n,
    fun i => φ (f i), s, hs, fun z hz i => hf _ hz i, fun z hz => hu _ hz⟩

theorem IsDecrConvexPLLimitOn.comp_comap (φ : A →ₐ[k] C) (h : IsDecrConvexPLLimitOn U u) :
    IsDecrConvexPLLimitOn (comap φ ⁻¹' U) fun y => u (comap φ y) := by
  obtain ⟨w, hw, hanti, hu⟩ := h
  exact ⟨fun j y => w j (comap φ y), fun j => (hw j).comp_comap φ, fun y hy => hanti _ hy,
    fun y hy => hu _ hy⟩

/-- **Pullback of locally psh functions** along the map induced by a `k`-algebra map. -/
theorem IsLocallyPSHOn.comp_comap (φ : A →ₐ[k] C) (h : IsLocallyPSHOn U u) :
    IsLocallyPSHOn (comap φ ⁻¹' U) fun y => u (comap φ y) := by
  intro y hy
  obtain ⟨W, hW, hyW, hWU, hu⟩ := h (comap φ y) hy
  exact ⟨comap φ ⁻¹' W, hW.preimage (continuous_comap φ), hyW, Set.preimage_mono hWU,
    hu.comp_comap φ⟩

/-- Restriction of a decreasing limit of convex PL functions to an open subset. -/
theorem IsDecrConvexPLLimitOn.mono (h : IsDecrConvexPLLimitOn U u) (hV : IsOpen V)
    (hVU : V ⊆ U) : IsDecrConvexPLLimitOn V u := by
  obtain ⟨w, hw, hanti, hu⟩ := h
  exact ⟨w, fun j => (hw j).mono hV hVU, fun y hy => hanti y (hVU hy), fun y hy => hu y (hVU hy)⟩

/-- A decreasing limit of convex PL functions on `U` is locally psh on every open `V ⊆ U`. -/
theorem IsDecrConvexPLLimitOn.isLocallyPSHOn (h : IsDecrConvexPLLimitOn U u) (hV : IsOpen V)
    (hVU : V ⊆ U) : IsLocallyPSHOn V u := fun _ hx => ⟨V, hV, hx, subset_rfl, h.mono hV hVU⟩

/-- The sum of two decreasing limits of convex PL functions is one. -/
theorem IsDecrConvexPLLimitOn.add (hu : IsDecrConvexPLLimitOn U u)
    (hv : IsDecrConvexPLLimitOn U v) : IsDecrConvexPLLimitOn U fun y => u y + v y := by
  obtain ⟨a, ha, haa, hau⟩ := hu
  obtain ⟨b, hb, hbb, hbv⟩ := hv
  refine ⟨fun j y => a j y + b j y, fun j => (ha j).add (hb j),
    fun y hy _ _ hij => add_le_add (haa y hy hij) (hbb y hy hij), fun y hy => ?_⟩
  show u y + v y = ⨅ j, (a j y + b j y)
  rw [hau y hy, hbv y hy, iInf_add_of_antitone (haa y hy) (hbb y hy) ((ha 0).ne_top hy)
    ((hb 0).ne_top hy)]

/-- The maximum of two decreasing limits of convex PL functions is one. -/
theorem IsDecrConvexPLLimitOn.max (hu : IsDecrConvexPLLimitOn U u)
    (hv : IsDecrConvexPLLimitOn U v) : IsDecrConvexPLLimitOn U fun y => max (u y) (v y) := by
  obtain ⟨a, ha, haa, hau⟩ := hu
  obtain ⟨b, hb, hbb, hbv⟩ := hv
  refine ⟨fun j y => Max.max (a j y) (b j y), fun j => (ha j).max (hb j),
    fun y hy _ _ hij => max_le_max (haa y hy hij) (hbb y hy hij), fun y hy => ?_⟩
  show Max.max (u y) (v y) = ⨅ j, Max.max (a j y) (b j y)
  rw [hau y hy, hbv y hy, iInf_max_of_antitone (haa y hy) (hbb y hy)]

/-- Adding a decreasing limit of convex PL functions preserves local plurisubharmonicity. -/
theorem IsLocallyPSHOn.add (hu : IsLocallyPSHOn U u) (hv : IsDecrConvexPLLimitOn V v)
    (hUV : U ⊆ V) : IsLocallyPSHOn U fun y => u y + v y := by
  intro x hx
  obtain ⟨W, hW, hxW, hWU, hu'⟩ := hu x hx
  exact ⟨W, hW, hxW, hWU, hu'.add (hv.mono hW (hWU.trans hUV))⟩

/-- The maximum with a decreasing limit of convex PL functions preserves local
plurisubharmonicity. -/
theorem IsLocallyPSHOn.max (hu : IsLocallyPSHOn U u) (hv : IsDecrConvexPLLimitOn V v)
    (hUV : U ⊆ V) : IsLocallyPSHOn U fun y => max (u y) (v y) := by
  intro x hx
  obtain ⟨W, hW, hxW, hWU, hu'⟩ := hu x hx
  exact ⟨W, hW, hxW, hWU, hu'.max (hv.mono hW (hWU.trans hUV))⟩

/-- A set on which some function is locally psh is open. -/
theorem IsLocallyPSHOn.isOpen (h : IsLocallyPSHOn U u) : IsOpen U := by
  rw [isOpen_iff_forall_mem_open]
  intro x hx
  obtain ⟨W, hW, hxW, hWU, -⟩ := h x hx
  exact ⟨W, hWU, hW, hxW⟩

/-- **Locally psh functions are upper semicontinuous**: near each point they are infima of
continuous (convex PL) functions. -/
theorem IsLocallyPSHOn.upperSemicontinuousOn (h : IsLocallyPSHOn U u) :
    UpperSemicontinuousOn u U := by
  intro x hx c hc
  obtain ⟨W, hW, hxW, -, w, hw, -, hu⟩ := h x hx
  change u x < c at hc
  rw [hu x hxW] at hc
  obtain ⟨j, hj⟩ := iInf_lt_iff.1 hc
  have hev : ∀ᶠ y in 𝓝 x, w j y < c :=
    ((hw j).continuousAt hxW).eventually (gt_mem_nhds hj)
  refine Filter.Eventually.filter_mono nhdsWithin_le_nhds ?_
  filter_upwards [hev, hW.mem_nhds hxW] with y hy hyW
  rw [hu y hyW]
  exact (iInf_le _ j).trans_lt hy

/-- **Regularizable functions pull back to decreasing limits of convex PL functions** on all of
`(Spec C)^an`, along any `k`-algebra map `φ : A → C`: if `gⱼ ↓ v` with `gⱼ ∈ FS(Y)`, then
`gⱼ ∘ φ^an ↓ v ∘ φ^an`, and `gⱼ ∘ φ^an` is convex PL (FS functions are convex PL and convex PL
functions pull back). -/
theorem IsRegularizable.isDecrConvexPLLimitOn_comap (hv : IsRegularizable v) (φ : A →ₐ[k] C) :
    IsDecrConvexPLLimitOn Set.univ fun y => v (comap φ y) := by
  obtain ⟨-, g, hanti, hv⟩ := hv
  refine ⟨fun j y => (g j).eval (comap φ y), fun j => ?_, fun y _ => hanti _,
    fun y _ => hv _⟩
  simpa using (g j).isConvexPLOn_univ.comp_comap φ

/-- Regularizable functions are decreasing limits of convex PL functions on `Y^an`. -/
theorem IsRegularizable.isDecrConvexPLLimitOn (hv : IsRegularizable v) :
    IsDecrConvexPLLimitOn Set.univ v :=
  hv.isDecrConvexPLLimitOn_comap (AlgHom.id k A)

/-- Regularizable functions are locally psh on every open set. -/
theorem IsRegularizable.isLocallyPSHOn (hv : IsRegularizable v) (hU : IsOpen U) :
    IsLocallyPSHOn U v :=
  hv.isDecrConvexPLLimitOn.isLocallyPSHOn hU (Set.subset_univ U)

end general

/-! ### Weakly psh functions -/

section weaklyPSH

variable {k : Type*} [Field k] {A : Type*} [CommRing A] [IsDomain A] [Algebra k A]
  {U : Set (Berk k A)} {u v : Berk k A → EReal}

/-- **Weakly psh functions** (FHX Definition 5.6, `def:weakly-psh`), with blowups as witnesses:
for some finite `s ⊆ A` containing a nonzero element, `u ∘ μ^an` is locally psh on the preimage
of `U` in every chart `Spec A[s/g]^an`, `g ∈ s \ {0}`, of the blowup `μ : Y' → Y` along the ideal
generated by `s`. -/
def IsWeaklyPSHOn (U : Set (Berk k A)) (u : Berk k A → EReal) : Prop :=
  ∃ s : Finset A, (∃ g ∈ s, g ≠ 0) ∧ ∀ g ∈ s, g ≠ 0 →
    IsLocallyPSHOn (comap (chartMap k s g) ⁻¹' U) fun y => u (comap (chartMap k s g) y)

omit [IsDomain A] in
/-- If `f` is upper semicontinuous on an open set `V` and `F ⊆ V` is closed, then
`F ∩ {f ≥ c}` is closed. -/
theorem isClosed_inter_setOf_le_of_upperSemicontinuousOn {X : Type*} [TopologicalSpace X]
    {f : X → EReal} {V F : Set X} (hV : IsOpen V) (hf : UpperSemicontinuousOn f V)
    (hF : IsClosed F) (hFV : F ⊆ V) (c : EReal) : IsClosed (F ∩ {y | c ≤ f y}) := by
  rw [← isOpen_compl_iff, isOpen_iff_mem_nhds]
  intro z hz
  by_cases hzF : z ∈ F
  · have hlt : f z < c := not_le.1 fun h => hz ⟨hzF, h⟩
    have hev : ∀ᶠ y in 𝓝[V] z, f y < c := hf z (hFV hzF) c hlt
    rw [nhdsWithin_eq_nhds.2 (hV.mem_nhds (hFV hzF))] at hev
    filter_upwards [hev] with y hy hy'
    exact not_le.2 hy hy'.2
  · filter_upwards [hF.isOpen_compl.mem_nhds hzF] with y hy hy'
    exact hy hy'.1

/-- **Weakly psh functions are upper semicontinuous** (FHX Definition 5.6). Let `x ∈ U`,
`c > u x`, and `K ⊆ U` a compact neighbourhood of `x`. In each chart, the points of the closed
subchart over `K` where `u ∘ μ^an ≥ c` form a compact set (`isCompact_closedChart`; `u ∘ μ^an` is
upper semicontinuous on the preimage of `U`), whose image in `Y^an` is closed and misses `x`.
Off these finitely many images, every point of `K` comes from a closed subchart
(`exists_comap_chartMap_eq_of_le_one`), so `u < c` there. -/
theorem IsWeaklyPSHOn.upperSemicontinuousOn [Algebra.FiniteType k A] (hu : IsWeaklyPSHOn U u)
    (hU : IsOpen U) : UpperSemicontinuousOn u U := by
  classical
  obtain ⟨s, hs, hloc⟩ := hu
  intro x hx c hc
  change u x < c at hc
  obtain ⟨K, hKx, hKU, hK⟩ := local_compact_nhds (hU.mem_nhds hx)
  -- the compact sets `C_g` of points of the closed subcharts over `K` where `u ∘ μ^an ≥ c`
  let F : ∀ g : A, Set (Berk k (blowupChart s g)) := fun g =>
    {y | comap (chartMap k s g) y ∈ K ∧ ∀ h (hh : h ∈ s), y.val (chartFrac s g hh) ≤ 1}
  let D : A → Set (Berk k A) := fun g =>
    (comap (chartMap k s g) '' (F g ∩ {y | c ≤ u (comap (chartMap k s g) y)}))ᶜ
  have hD : ∀ g ∈ s.filter (· ≠ 0), D g ∈ 𝓝 x := by
    intro g hg
    obtain ⟨hg, hg0⟩ := Finset.mem_filter.1 hg
    have hFc : IsCompact (F g) := isCompact_closedChart s g hK
    have hFV : F g ⊆ comap (chartMap k s g) ⁻¹' U := fun y hy => hKU hy.1
    have hcl : IsClosed (F g ∩ {y | c ≤ u (comap (chartMap k s g) y)}) :=
      isClosed_inter_setOf_le_of_upperSemicontinuousOn ((hloc g hg hg0).isOpen)
        (hloc g hg hg0).upperSemicontinuousOn hFc.isClosed hFV c
    refine (((hFc.of_isClosed_subset hcl Set.inter_subset_left).image
      (continuous_comap _)).isClosed.isOpen_compl).mem_nhds ?_
    rintro ⟨y, hy, hyx⟩
    have h2 : c ≤ u (comap (chartMap k s g) y) := hy.2
    rw [hyx] at h2
    exact (not_le.2 hc) h2
  have hN : K ∩ ⋂ g ∈ s.filter (· ≠ 0), D g ∈ 𝓝 x :=
    Filter.inter_mem hKx ((Filter.biInter_finset_mem _).2 hD)
  refine Filter.Eventually.filter_mono nhdsWithin_le_nhds ?_
  filter_upwards [hN] with x' hx'
  obtain ⟨g, hg, hg0, y, hyx, hy1⟩ := exists_comap_chartMap_eq_of_le_one hs x'
  by_contra hle
  have hmem : x' ∈ comap (chartMap k s g) '' (F g ∩ {y | c ≤ u (comap (chartMap k s g) y)}) :=
    ⟨y, ⟨⟨by rw [hyx]; exact hx'.1, hy1⟩, show c ≤ u (comap (chartMap k s g) y) by
      rw [hyx]; exact not_lt.1 hle⟩, hyx⟩
  exact Set.mem_iInter₂.1 hx'.2 g (Finset.mem_filter.2 ⟨hg, hg0⟩) hmem

/-- **Weakly psh functions on `Y^an` are upper semicontinuous.** -/
theorem IsWeaklyPSHOn.upperSemicontinuous [Algebra.FiniteType k A]
    (hu : IsWeaklyPSHOn Set.univ u) : UpperSemicontinuous u :=
  upperSemicontinuousOn_univ_iff.1 (hu.upperSemicontinuousOn isOpen_univ)

/-- **Locally psh functions are weakly psh** (witness: the blowup along the unit ideal, `s = {1}`,
whose only chart is `Spec A`). -/
theorem IsLocallyPSHOn.isWeaklyPSHOn (hu : IsLocallyPSHOn U u) : IsWeaklyPSHOn U u :=
  ⟨{1}, ⟨1, Finset.mem_singleton_self 1, one_ne_zero⟩, fun _ _ _ => hu.comp_comap _⟩

/-- **Regularizable functions are weakly psh** on every open set. -/
theorem IsRegularizable.isWeaklyPSHOn (hu : IsRegularizable u) (hU : IsOpen U) :
    IsWeaklyPSHOn U u :=
  (hu.isLocallyPSHOn hU).isWeaklyPSHOn

/-- **Adding a regularizable function** preserves weak plurisubharmonicity, with the same witness
(FHX Lemma 5.11(3)): regularizable functions pull back to decreasing limits of convex PL functions
on each chart. -/
theorem IsWeaklyPSHOn.add_isRegularizable (hu : IsWeaklyPSHOn U u) (hv : IsRegularizable v) :
    IsWeaklyPSHOn U fun x => u x + v x := by
  obtain ⟨s, hs, hloc⟩ := hu
  exact ⟨s, hs, fun g hg hg0 => (hloc g hg hg0).add
    (hv.isDecrConvexPLLimitOn_comap (chartMap k s g)) (Set.subset_univ _)⟩

/-- **The maximum with a regularizable function** preserves weak plurisubharmonicity, with the
same witness (FHX Lemma 5.11(4)). -/
theorem IsWeaklyPSHOn.max_isRegularizable (hu : IsWeaklyPSHOn U u) (hv : IsRegularizable v) :
    IsWeaklyPSHOn U fun x => max (u x) (v x) := by
  obtain ⟨s, hs, hloc⟩ := hu
  exact ⟨s, hs, fun g hg hg0 => (hloc g hg hg0).max
    (hv.isDecrConvexPLLimitOn_comap (chartMap k s g)) (Set.subset_univ _)⟩

/-- **Weakly psh functions on `Y^an` form an `IsPshClass`**: they are upper semicontinuous, and
stable under adding, and taking the maximum with, regularizable functions. This discharges the
class hypothesis of the projection step (`rmk:projection-step-conditional`) for weakly psh
functions. -/
theorem isPshClass_isWeaklyPSHOn_univ [Algebra.FiniteType k A] :
    IsPshClass (IsWeaklyPSHOn (Set.univ : Set (Berk k A))) where
  usc _ hu := hu.upperSemicontinuous
  add_reg _ _ hu hv := hu.add_isRegularizable hv
  max_reg _ _ hu hv := hu.max_isRegularizable hv

end weaklyPSH

end EnvelopeProperty
