/-!
# The normal compactification attached to a Fubini–Study function

Let `k` be an algebraically closed field with the trivial absolute value and `Y = Spec A` a normal
affine variety over `k`. This file attaches to an affine Fubini–Study function `h ∈ FS(Y)`
(`FSData`, FHX Definition 5.7(1)) a normal projective compactification `P ⊇ Y` on which `h` is,
up to the chart, a finite Fubini–Study function of class `O(1)` near the boundary. This is
the compactification of Fang–Han–Xia, *The envelope property for unibranch projective varieties*,
Lemma 5.9 (`lem:boundary-presentation`), built from Wu, Proposition 3.17(2), with the
normalization realized as a graded integral closure. Blueprint: `wu-discharge.tex`, subsection
`subsec:wu-compactification`, nodes `lem:wu-fs-normal-form`, `def:wu-compactification`,
`lem:wu-boundary-presentation` and part (4) of `lem:wu-proj-chart` for this compactification.

## The construction (`def:wu-compactification`)

1. Normal form (`lem:wu-fs-normal-form`): `N h = max{λ₀, log|y₁| + λ₁, …, log|y_m| + λ_m}` with
   `N ∈ ℕ_{>0}`, `λ_l ∈ ℚ` and generators `y_l` of `A`.
2. `S = k[T, y₁T, …, y_mT] ⊆ A[T]`, `S'` its integral closure in `A[T]` (`normalizedRees`,
   `lem:wu-graded-closure`), `e ≥ 1` with `S'^{(e)}` generated by `S'_e` (`lem:wu-veronese`),
   `S'' = S'^{(e)}`.
3. A `k`-basis `z₀ = T^e, z₁, …, z_M` of `S''_1 = S'_e`, the surjection `φ : R_M → S''`,
   `xᵢ ↦ zᵢ`, `I = ker φ`, `P = V(I) ⊆ ℙᴹ`, linear forms `ρ_l` with `φ(ρ_l) = (y_l T)^e`, and
   `ψ = max{log|x₀|, log|ρ_l| + e(λ_l - λ₀)}` on `P^an`.

## Main definitions

* `FSData.NormalForm h`, `FSData.nonempty_normalForm` (`lem:wu-fs-normal-form`).
* `FSData.Compactification h` (`def:wu-compactification`): the choices of the construction (a
  normal form, `e`, the basis `zᵢ`); `FSData.nonempty_compactification`: they exist.
* `Compactification.φ`, `Compactification.proj` (`P`), `Compactification.bdry` (`x₀` and the
  `ρ_l`), `Compactification.fsData`, `Compactification.ψ`, and the chart
  `Compactification.chart : U_{x₀} ∩ P^an ≃ₜ Y^an`.

## Main results

* `Compactification.range_φ`: `φ(R_M) = S'^{(e)}`; `Compactification.isIntegrallyClosed_range_φ`,
  `Compactification.isIntegrallyClosed_quotient`: `P` is normal (`R_M / I ≅ S''` is integrally
  closed); `Compactification.exists_algebraMap_eq_of_C_mem_range`: `S''_0 = k`.
* `Compactification.isReesPresentation`, `Compactification.chart_triv`: `lem:wu-proj-chart`(4)
  for `P` (a `ProjBerk.IsReesPresentation` with `x₀ ↦ T^e`).
* `Compactification.exists_val_bdry_ne_zero`, `Compactification.isFiniteFS_ψ`
  (`lem:wu-boundary-presentation`, first part): `x₀, ρ₁, …, ρ_m` have no common zero on `P^an`,
  so `ψ` is a finite Fubini–Study function of class `O(1)`.
* `Compactification.eval_chart`, `Compactification.ψ_eq` (`lem:wu-boundary-presentation`,
  second part): `h = (ψ - log|x₀|) / (e N) + λ₀ / N` on `U_{x₀} ∩ P^an = Y^an`.
* `FSData.exists_boundaryPresentation`: everything bundled in one existence statement.

## Implementation notes

* The normal form records the pairs `(y_l, λ_l)` as a `Finset (A × ℚ)`; the index set of the
  generators is the corresponding subtype.
* `x₀` and the `ρ_l` are indexed together by `Option` (`none ↦ x₀`), matching the indexing of
  the generators `T, y_l T` of `S` by `reesGen`.
* The finiteness of `ψ` follows the blueprint: for `b = zᵢ`, `b^n ∈ J = (T, y_l T) S'`
  (`exists_pow_eq_sum_reesGen`), `J^{(m+1)(e-1)+1} ⊆ (T^e, (y_l T)^e)`
  (`Ideal.sum_pow_mem_span_pow`), the coefficients are replaced by their components of degree divisible by `e` (so that they lie
  in `S''`) and lifted along `φ`; a point of `P^an` where `x₀` and all `ρ_l` vanish would then
  have `|xᵢ| = 0` for all `i`.
-/

open scoped NNReal ENNReal Topology Polynomial

noncomputable section

namespace EnvelopeProperty

open Berk

/-! ### The normal form of Fubini–Study functions (`lem:wu-fs-normal-form`) -/

section NormalForm

variable {k : Type*} [Field k] {A : Type*} [CommRing A] [Algebra k A]

/-- A positive rational `a` whose denominator divides `N > 0` has `N a ∈ ℕ_{≥ 1}`. -/
theorem exists_nat_eq_mul_of_den_dvd {a : ℚ} (ha : 0 < a) {N : ℕ} (hN0 : 0 < N)
    (hN : a.den ∣ N) : ∃ n : ℕ, 1 ≤ n ∧ (n : ℚ) = N * a := by
  obtain ⟨K, rfl⟩ := hN
  have hnum : 0 < a.num := Rat.num_pos.2 ha
  have hK : 0 < K := Nat.pos_of_mul_pos_left hN0
  have hcast : ((a.num.toNat : ℕ) : ℚ) = (a.num : ℚ) := by
    exact_mod_cast Int.toNat_of_nonneg hnum.le
  refine ⟨K * a.num.toNat, Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero hK.ne' (by omega)), ?_⟩
  push_cast
  rw [hcast, ← Rat.den_mul_eq_num]
  ring

namespace FSData

variable (h : FSData k A)

/-- A **normal form** of `h ∈ FS(Y)` (`lem:wu-fs-normal-form`): an integer `N > 0`, a constant
`λ₀ ∈ ℚ` and a finite family of pairs `(y_l, λ_l) ∈ A × ℚ` such that the `y_l` generate the
`k`-algebra `A` and `N h = max{λ₀, log|y₁| + λ₁, …, log|y_m| + λ_m}`. Existence:
`FSData.nonempty_normalForm`. -/
structure NormalForm where
  /-- The integer `N > 0`. -/
  N : ℕ
  N_pos : 0 < N
  /-- The pairs `(y_l, λ_l)`. -/
  terms : Finset (A × ℚ)
  /-- The constant `λ₀`. -/
  const : ℚ
  /-- The `y_l` generate the `k`-algebra `A`. -/
  adjoin_eq_top : Algebra.adjoin k (Prod.fst '' (terms : Set (A × ℚ))) = ⊤
  /-- `N h = max{λ₀, max_l (log|y_l| + λ_l)}`. -/
  eval_eq : ∀ x, ((N : ℝ) : EReal) * h.eval x =
    max ((const : ℝ) : EReal) (terms.sup fun p => logAbs p.1 x + ((p.2 : ℝ) : EReal))

/-- There is `N > 0` with `N aᵢ ∈ ℕ_{≥ 1}` for all the coefficients `aᵢ` of `h`. -/
theorem exists_nat_mul_coeff_eq :
    ∃ N : ℕ, 0 < N ∧ ∀ t ∈ h.terms, ∃ n : ℕ, 1 ≤ n ∧ (n : ℚ) = N * t.2.1 := by
  have hN : 0 < ∏ t ∈ h.terms, t.2.1.den := Finset.prod_pos fun t _ => t.2.1.den_pos
  exact ⟨_, hN, fun t ht => exists_nat_eq_mul_of_den_dvd (h.pos t ht) hN
    (Finset.dvd_prod_of_mem (fun t : A × ℚ × ℚ => t.2.1.den) ht)⟩

/-- **Normal form of Fubini–Study functions** (`lem:wu-fs-normal-form`). Every `h ∈ FS(Y)`,
`h = max{a₁ log|f₁| + b₁, …, b₀}`, has a normal form `N h = max{λ₀, log|y_l| + λ_l}`: choose
`N > 0` with `N aᵢ ∈ ℕ_{≥ 1}` and `M ≥ |N bᵢ|`; then
`N h = max{log|fᵢ^{N aᵢ}| + N bᵢ, log|fᵢ| - M, N b₀}`, since `log|fᵢ| - M ≤ N h`. -/
theorem nonempty_normalForm : Nonempty h.NormalForm := by
  classical
  obtain ⟨N, hN, hn⟩ := h.exists_nat_mul_coeff_eq
  choose! n hn1 hn using hn
  set Mc : ℚ := |N * h.const| + ∑ t ∈ h.terms, |N * t.2.2| with hMc
  have hsum : 0 ≤ ∑ t ∈ h.terms, |(N : ℚ) * t.2.2| :=
    Finset.sum_nonneg fun t _ => abs_nonneg _
  have hM0 : -Mc ≤ N * h.const := by
    have := neg_abs_le ((N : ℚ) * h.const)
    linarith
  have hMt : ∀ t ∈ h.terms, -Mc ≤ N * t.2.2 := fun t ht => by
    have h1 := neg_abs_le ((N : ℚ) * t.2.2)
    have h2 : |(N : ℚ) * t.2.2| ≤ ∑ t ∈ h.terms, |(N : ℚ) * t.2.2| :=
      Finset.single_le_sum (f := fun t : A × ℚ × ℚ => |(N : ℚ) * t.2.2|)
        (fun t _ => abs_nonneg _) ht
    have h3 := abs_nonneg ((N : ℚ) * h.const)
    linarith
  set P : Finset (A × ℚ) := h.terms.image (fun t => (t.1 ^ n t, N * t.2.2)) ∪
    h.terms.image (fun t => (t.1, -Mc)) with hP
  refine ⟨⟨N, hN, P, N * h.const, ?_, fun x => ?_⟩⟩
  · rw [eq_top_iff, ← h.gen]
    refine Algebra.adjoin_mono ?_
    rintro _ ⟨t, ht, rfl⟩
    refine ⟨(t.1, -Mc), ?_, rfl⟩
    simp only [hP, Finset.coe_union, Finset.coe_image, Set.mem_union, Set.mem_image]
    exact Or.inr ⟨t, ht, rfl⟩
  · have hNr : (0 : ℝ) ≤ N := Nat.cast_nonneg N
    have key : ∀ t ∈ h.terms, ((N : ℝ) : EReal) * fsTerm t x =
        logAbs (t.1 ^ n t) x + (((N * t.2.2 : ℚ) : ℝ) : EReal) := fun t ht => by
      have hnr : ((n t : ℕ) : ℝ) = (N : ℝ) * (t.2.1 : ℝ) := by exact_mod_cast hn t ht
      rw [fsTerm_def, ProjBerk.ereal_coe_mul_add hNr, ProjBerk.ereal_coe_mul_coe_mul, ← hnr,
        logAbs_pow, EReal.coe_natCast, ← EReal.coe_mul]
      push_cast
      rfl
    have hlhs : ((N : ℝ) : EReal) * h.eval x = max (((N * h.const : ℚ) : ℝ) : EReal)
        (h.terms.sup fun t => logAbs (t.1 ^ n t) x + (((N * t.2.2 : ℚ) : ℝ) : EReal)) := by
      rw [eval_def, ProjBerk.ereal_coe_mul_max hNr,
        FSData.coe_mul_sup _ _ (by exact_mod_cast hN : (0 : ℝ) < N), ← EReal.coe_mul]
      congr 1
      · push_cast; rfl
      · exact Finset.sup_congr rfl key
    rw [hlhs, Finset.sup_union, Finset.sup_image, Finset.sup_image]
    simp only [Function.comp_def]
    have hS2 : (h.terms.sup fun t => logAbs t.1 x + (((-Mc : ℚ) : ℝ) : EReal)) ≤
        max (((N * h.const : ℚ) : ℝ) : EReal)
          (h.terms.sup fun t => logAbs (t.1 ^ n t) x + (((N * t.2.2 : ℚ) : ℝ) : EReal)) := by
      refine Finset.sup_le fun t ht => ?_
      by_cases hL : logAbs t.1 x ≤ 0
      · refine le_trans ?_ (le_max_left _ _)
        calc logAbs t.1 x + (((-Mc : ℚ) : ℝ) : EReal) ≤ 0 + (((-Mc : ℚ) : ℝ) : EReal) :=
              add_le_add_left hL _
          _ ≤ (((N * h.const : ℚ) : ℝ) : EReal) := by
              rw [zero_add]; exact_mod_cast hM0
      · push Not at hL
        refine le_trans ?_ (le_trans (Finset.le_sup (f := fun t => logAbs (t.1 ^ n t) x +
          (((N * t.2.2 : ℚ) : ℝ) : EReal)) ht) (le_max_right _ _))
        have hne : logAbs t.1 x ≠ ⊥ := ne_bot_of_gt hL
        obtain ⟨r, hr⟩ : ∃ r : ℝ, logAbs t.1 x = r :=
          ⟨_, (EReal.coe_toReal (logAbs_ne_top _ _) hne).symm⟩
        have hr0 : 0 < r := by rw [hr] at hL; exact_mod_cast hL
        have hn1' : (1 : ℝ) ≤ n t := by exact_mod_cast hn1 t ht
        have hMt' : ((-Mc : ℚ) : ℝ) ≤ ((N * t.2.2 : ℚ) : ℝ) := by exact_mod_cast hMt t ht
        rw [logAbs_pow, hr, ← EReal.coe_natCast, ← EReal.coe_mul, ← EReal.coe_add,
          ← EReal.coe_add, EReal.coe_le_coe_iff]
        nlinarith
    rw [← max_assoc, max_eq_left hS2]

end FSData

end NormalForm

/-! ### Generalities -/

/-- A finite supremum over `Option ι` splits off the value at `none`. -/
theorem finset_univ_sup_option {ι α : Type*} [Fintype ι] [CompleteLattice α]
    (F : Option ι → α) : Finset.univ.sup F = F none ⊔ Finset.univ.sup fun i => F (some i) := by
  rw [Finset.sup_univ_eq_iSup, Finset.sup_univ_eq_iSup, iSup_option]

/-- A nonzero vector `v` of a finite dimensional vector space is the first vector `b 0` of a basis
`b` indexed by `Fin (M + 1)`. -/
theorem exists_basis_fin_zero_eq {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] {v : V} (hv : v ≠ 0) :
    ∃ (M : ℕ) (b : Module.Basis (Fin (M + 1)) K V), b 0 = v := by
  classical
  have hs : LinearIndepOn K id ({v} : Set V) := (linearIndepOn_singleton_iff K).2 hv
  set b := Module.Basis.extend hs
  have : Finite (hs.extend (Set.subset_univ _)) := Module.Finite.finite_basis b
  let a0 : hs.extend (Set.subset_univ _) := ⟨v, Module.Basis.subset_extend hs rfl⟩
  have : Fintype {x : hs.extend (Set.subset_univ _) // x ≠ a0} := Fintype.ofFinite _
  let eM := Fintype.equivFin {x : hs.extend (Set.subset_univ _) // x ≠ a0}
  let g : Fin (Fintype.card {x : hs.extend (Set.subset_univ _) // x ≠ a0} + 1) ≃
      hs.extend (Set.subset_univ _) :=
    (finSuccEquiv _).trans ((Equiv.optionCongr eM.symm).trans (Equiv.optionSubtypeNe a0))
  refine ⟨_, b.reindex g.symm, ?_⟩
  have hg : g 0 = a0 := by
    simp only [g, Equiv.trans_apply, finSuccEquiv_zero, Equiv.optionCongr_apply,
      Option.map_none]
    rfl
  rw [Module.Basis.reindex_apply, Equiv.symm_symm, Module.Basis.coe_extend, hg]

/-! ### The compactification (`def:wu-compactification`) -/

section Compactification

variable {k : Type*} [Field k] {A : Type*} [CommRing A] [Algebra k A]

namespace FSData

/-- **The compactification attached to a Fubini–Study function** (`def:wu-compactification`):
the choices made in its construction. For `h ∈ FS(Y)` these are

* a normal form `N h = max{λ₀, log|y₁| + λ₁, …, log|y_m| + λ_m}`
  (`lem:wu-fs-normal-form`, the parent structure `FSData.NormalForm`);
* `e ≥ 1` such that the Veronese subalgebra `S'' = S'^{(e)}` of the normalized Rees algebra
  `S' ⊆ A[T]` of `(y_l)` (`normalizedRees`, `lem:wu-graded-closure`) is generated by
  `S''_1 = S'_e` (`lem:wu-veronese`);
* a `k`-basis `z₀ = T^e, z₁, …, z_M` of `S'_e`.

The resulting objects are defined from these choices below: the presentation
`φ : R_M = k[x₀, …, x_M] → S'' ⊆ A[T]`, `xᵢ ↦ zᵢ` (`Compactification.φ`), the
projective
variety `P = V(ker φ) ⊆ ℙᴹ` (`Compactification.proj`), the linear forms `ρ_l` with
`φ(ρ_l) = (y_l T)^e` (`Compactification.bdry`) and the boundary function
`ψ = max{log|x₀|, log|ρ_l| + e(λ_l - λ₀)}` on `P^an` (`Compactification.ψ`).
Existence: `FSData.nonempty_compactification`. -/
structure Compactification (h : FSData k A) extends h.NormalForm where
  /-- The Veronese degree `e ≥ 1`. -/
  e : ℕ
  e_pos : 0 < e
  /-- `S'' = S'^{(e)}` is generated by `S'_e` (`lem:wu-veronese`). -/
  veronese_eq : veronese (normalizedRees k fun p : terms => p.1.1) e =
    Algebra.adjoin k (gradedPiece (normalizedRees k fun p : terms => p.1.1) e : Set A[X])
  /-- The number `M + 1` of basis vectors of `S'_e`. -/
  M : ℕ
  /-- The basis `z₀, …, z_M` of `S''_1 = S'_e`. -/
  basis : Module.Basis (Fin (M + 1)) k
    (gradedPiece (normalizedRees k fun p : terms => p.1.1) e)
  /-- `z₀ = T^e`. -/
  basis_zero : (basis 0 : A[X]) = Polynomial.X ^ e

namespace Compactification

variable {h : FSData k A} (C : h.Compactification)

/-! #### The normalized Rees algebra and the presentation `φ` -/

/-- The generators `y_l` of `A` of the normal form. -/
abbrev y : C.terms → A := fun p => p.1.1

/-- The normalized Rees algebra `S' ⊆ A[T]` of the generators `y_l` (`lem:wu-graded-closure`). -/
abbrev rees : Subalgebra k A[X] := normalizedRees k C.y

theorem adjoin_range_y : Algebra.adjoin k (Set.range C.y) = ⊤ := by
  rw [← C.adjoin_eq_top]
  congr 1
  ext a
  exact ⟨fun ⟨p, hp⟩ => ⟨p.1, p.2, hp⟩, fun ⟨p, hp, hpa⟩ => ⟨⟨p, hp⟩, hpa⟩⟩

/-- The basis vector `zᵢ ∈ S''_1 = S'_e ⊆ A[T]`. -/
def z (i : Fin (C.M + 1)) : A[X] := C.basis i

theorem z_mem (i : Fin (C.M + 1)) : C.z i ∈ gradedPiece C.rees C.e := (C.basis i).2

theorem isHomog_z (i : Fin (C.M + 1)) : IsHomog C.e (C.z i) := (C.z_mem i).2

theorem z_zero : C.z 0 = Polynomial.monomial C.e 1 := by
  rw [z, C.basis_zero, Polynomial.X_pow_eq_monomial]

/-- The `zᵢ` span `S'_e`. -/
theorem span_range_z : Submodule.span k (Set.range C.z) = gradedPiece C.rees C.e := by
  have h1 : Set.range C.z = (gradedPiece C.rees C.e).subtype '' Set.range C.basis := by
    rw [← Set.range_comp]; rfl
  rw [h1, Submodule.span_image, C.basis.span_eq, Submodule.map_subtype_top]

/-- The `zᵢ` are linearly independent. -/
theorem linearIndependent_z : LinearIndependent k C.z := by
  have h := C.basis.linearIndependent.map' (gradedPiece C.rees C.e).subtype
    (Submodule.ker_subtype _)
  exact h

/-- The presentation `φ : R_M = k[x₀, …, x_M] → A[T]`, `xᵢ ↦ zᵢ`, of `S''`
(`def:wu-compactification`). -/
def φ : MvPolynomial (Fin (C.M + 1)) k →ₐ[k] A[X] := MvPolynomial.aeval C.z

@[simp]
theorem φ_X (i : Fin (C.M + 1)) : C.φ (MvPolynomial.X i) = C.z i :=
  MvPolynomial.aeval_X _ _

theorem isHomog_φ_X (i : Fin (C.M + 1)) : IsHomog C.e (C.φ (MvPolynomial.X i)) := by
  rw [φ_X]; exact C.isHomog_z i

theorem φ_X_zero : C.φ (MvPolynomial.X 0) = Polynomial.monomial C.e 1 := by
  rw [φ_X, z_zero]

/-- The image of `φ` is `S'' = S'^{(e)}`. -/
theorem range_φ : C.φ.range = veronese C.rees C.e := by
  rw [φ, MvPolynomial.aeval_range, C.veronese_eq, ← C.span_range_z, Algebra.adjoin_span]

/-- `(y_l T)^e` (and `T^e`) lies in `S''_1 = S'_e`. -/
theorem reesGen_pow_mem (o : Option C.terms) :
    reesGen C.y o ^ C.e ∈ gradedPiece C.rees C.e := by
  refine ⟨Subalgebra.pow_mem _ (gradedRees_le_normalizedRees (reesGen_mem_gradedRees o)) _, ?_⟩
  simpa using (isHomog_reesGen C.y o).pow C.e

/-- The linear forms `ρ_l ∈ R_M` with `φ(ρ_l) = (y_l T)^e` (`def:wu-compactification`), together
with `x₀` (`φ(x₀) = T^e`), indexed by `Option` (`none ↦ x₀`, `some l ↦ ρ_l`). -/
def bdry : Option C.terms → MvPolynomial (Fin (C.M + 1)) k
  | none => MvPolynomial.X 0
  | some p => ∑ i, C.basis.repr ⟨_, C.reesGen_pow_mem (some p)⟩ i • MvPolynomial.X i

/-- `φ(x₀) = T^e` and `φ(ρ_l) = (y_l T)^e`. -/
theorem φ_bdry (o : Option C.terms) : C.φ (C.bdry o) = reesGen C.y o ^ C.e := by
  cases o with
  | none => rw [bdry, φ_X_zero, reesGen_none, Polynomial.X_pow_eq_monomial]
  | some p =>
    rw [bdry, map_sum]
    simp only [map_smul, φ_X]
    have h := congrArg Subtype.val (C.basis.sum_repr ⟨_, C.reesGen_pow_mem (some p)⟩)
    rw [Submodule.coe_sum] at h
    simpa only [Submodule.coe_smul, z] using h

theorem isHomogeneous_bdry (o : Option C.terms) : (C.bdry o).IsHomogeneous 1 := by
  cases o with
  | none => exact MvPolynomial.isHomogeneous_X k 0
  | some p =>
    refine MvPolynomial.IsHomogeneous.sum _ _ _ fun i _ => ?_
    rw [MvPolynomial.smul_eq_C_mul]
    exact (MvPolynomial.isHomogeneous_X k i).C_mul _

/-! #### The boundary function `ψ` -/

/-- The constants `0` (for `x₀`) and `e(λ_l - λ₀)` (for `ρ_l`) of `ψ`. -/
def bdryConst : Option C.terms → ℚ
  | none => 0
  | some p => C.e * (p.1.2 - C.const)

open Classical in
/-- The Fubini–Study data of `ψ = max{log|x₀|, log|ρ_l| + e(λ_l - λ₀)}` on `ℙᴹ`
(`def:wu-compactification`): `m = 1`, forms of degree `1`. -/
def fsData : ProjBerk.FSData k C.M 1 where
  m := 1
  m_pos := one_pos
  deg := 1
  deg_eq := by norm_num
  terms := Finset.univ.image fun o => (C.bdry o, ((C.bdryConst o : ℚ) : ℝ))
  isHomogeneous t ht := by
    obtain ⟨o, -, rfl⟩ := Finset.mem_image.1 ht
    exact C.isHomogeneous_bdry o
  exists_ne_zero := ⟨_, Finset.mem_image_of_mem _ (Finset.mem_univ none), MvPolynomial.X_ne_zero 0⟩

theorem isRational_fsData : C.fsData.IsRational := by
  classical
  intro t ht
  obtain ⟨o, -, rfl⟩ := Finset.mem_image.1 ht
  exact ⟨_, rfl⟩

/-! #### The projective variety `P` and its affine chart -/

variable [IsDomain A]

/-- The projective variety `P = V(I) ⊆ ℙᴹ`, `I = ker φ`, i.e. `Proj S''`
(`def:wu-compactification`). -/
def proj : ProjSubvariety k C.M :=
  ProjSubvariety.ofRees C.φ C.e 0 C.e_pos C.isHomog_φ_X C.φ_X_zero

theorem proj_ideal : C.proj.ideal = RingHom.ker C.φ := rfl

/-- `S''_{(T^e)} = S'_{(T)} = A` (`lem:wu-graded-closure`(5), `lem:wu-veronese`). -/
theorem homLoc_range_φ :
    homLoc C.φ.range 1 C.e = (IsScalarTower.toAlgHom k A (FractionRing A)).range := by
  rw [C.range_φ, homLoc_veronese]
  refine homLoc_one_eq_range fun a => ?_
  obtain ⟨N, hN⟩ := Filter.eventually_atTop.1
    (eventually_monomial_mem_gradedRees C.adjoin_range_y a)
  exact ⟨N, gradedRees_le_normalizedRees (hN _ (Nat.le_mul_of_pos_right N C.e_pos))⟩

/-- **`lem:wu-proj-chart`(4) for the compactification**: `φ` is a Rees presentation of `P`, with
`U_{x₀}` corresponding to `Y = Spec A`. -/
theorem isReesPresentation : ProjBerk.IsReesPresentation k C.proj.ideal C.φ C.e 0 :=
  ProjSubvariety.isReesPresentation_ofRees _ _ _ C.homLoc_range_φ

/-- The identification `ι_{x₀} : U_{x₀} ∩ P^an ≃ₜ Y^an` (`lem:wu-proj-chart`(4)). -/
def chart : {v : C.proj.an // (v : ProjBerk k C.M).1.val (MvPolynomial.X 0) ≠ 0} ≃ₜ Berk k A :=
  C.proj.affineChart C.isReesPresentation

/-- `ι_{x₀}` maps the trivial valuation of `P` to `v_triv` (`lem:wu-proj-chart`(4)). -/
theorem chart_triv :
    C.chart ⟨C.proj.triv, by
      rw [ProjSubvariety.triv_val_of_notMem _ C.isReesPresentation.X_notMem]
      exact one_ne_zero⟩ = Berk.triv :=
  C.proj.affineChart_triv C.isReesPresentation

/-! #### Normality of `S''` -/

/-- `S'' = φ(R_M)` is an integrally closed domain (`lem:wu-graded-closure`(3),
`lem:wu-veronese`). -/
theorem isIntegrallyClosed_range_φ [IsIntegrallyClosed A] : IsIntegrallyClosed C.φ.range := by
  have := isIntegrallyClosed_normalizedRees (k := k) (y := C.y)
  have := isIntegrallyClosed_veronese C.rees C.e
  exact IsIntegrallyClosed.of_equiv (Subalgebra.equivOfEq _ _ C.range_φ.symm).toRingEquiv

/-- The homogeneous coordinate ring `R_M / I ≅ S''` of `P` is integrally closed: `P` is a normal
projective variety. -/
theorem isIntegrallyClosed_quotient [IsIntegrallyClosed A] :
    IsIntegrallyClosed (MvPolynomial (Fin (C.M + 1)) k ⧸ C.proj.ideal) := by
  have := C.isIntegrallyClosed_range_φ
  exact IsIntegrallyClosed.of_equiv (Ideal.quotientKerEquivRange C.φ).symm.toRingEquiv

/-- `S''_0 = k` (`lem:wu-graded-closure`(4)). -/
theorem exists_algebraMap_eq_of_C_mem_range [IsAlgClosed k] {a : A}
    (ha : Polynomial.C a ∈ C.φ.range) : ∃ c : k, algebraMap k A c = a := by
  rw [C.range_φ] at ha
  exact exists_algebraMap_eq_of_C_mem_normalizedRees (C_mem_veronese.1 ha)

/-! #### The boundary forms have no common zero on `P^an` -/

/-- **Key step of `lem:wu-boundary-presentation`.** Every coordinate `xᵢ` has a power
`xᵢ^D ≡ ∑_l c_l ρ_l + c₀ x₀ (mod I)`: for `b = zᵢ ∈ S''_1`, some power `b^n` lies in the ideal
`J` of `S'` generated by `T, y_l T` (`lem:wu-graded-closure`(6)), and
`J^{(m+1)(e-1)+1} ⊆ J' = (T^e, (y_l T)^e)`; the coefficients are made homogeneous of degree
divisible by `e` and lifted along `φ : R_M ↠ S''`. -/
theorem exists_pow_sub_sum_mem_ideal [IsAlgClosed k] (i : Fin (C.M + 1)) :
    ∃ D : ℕ, 0 < D ∧ ∃ c : Option C.terms → MvPolynomial (Fin (C.M + 1)) k,
      MvPolynomial.X i ^ D - ∑ o, c o * C.bdry o ∈ C.proj.ideal := by
  classical
  obtain ⟨n, hn, c', hc', hbn⟩ := exists_pow_eq_sum_reesGen (C.z_mem i) C.e_pos
  -- computations in the ring `S'`
  let g : Option C.terms → C.rees := fun o =>
    ⟨reesGen C.y o, gradedRees_le_normalizedRees (reesGen_mem_gradedRees o)⟩
  let s : Option C.terms → C.rees := fun o => g o * ⟨c' o, (hc' o).1⟩
  have hsum : ((∑ o, s o : C.rees) : A[X]) = C.z i ^ n := by
    rw [hbn]
    push_cast
    rfl
  have hle : Ideal.span ((fun o => s o ^ (C.e - 1 + 1)) ''
      ((Finset.univ : Finset (Option C.terms)) : Set (Option C.terms))) ≤
      Ideal.span (Set.range fun o => g o ^ C.e) := by
    rw [Ideal.span_le]
    rintro _ ⟨o, -, rfl⟩
    change (g o * _) ^ (C.e - 1 + 1) ∈ _
    rw [Nat.sub_add_cancel C.e_pos, mul_pow]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨o, rfl⟩)
  obtain ⟨d, hd⟩ := Ideal.mem_span_range_iff_exists_fun.1
    (hle (Ideal.sum_pow_mem_span_pow (Finset.univ : Finset (Option C.terms)) s (C.e - 1)))
  set Q := (Finset.univ : Finset (Option C.terms)).card * (C.e - 1) + 1
  have h1 : C.z i ^ (n * Q) = ∑ o, (d o : A[X]) * reesGen C.y o ^ C.e := by
    rw [pow_mul, ← hsum, ← SubmonoidClass.coe_pow, ← hd]
    push_cast
    rfl
  -- homogeneous components of degree divisible by `e`
  set D := n * Q
  have hD : 0 < D := Nat.mul_pos hn (Nat.succ_pos _)
  have hgo : ∀ o, IsHomog C.e (reesGen C.y o ^ C.e) := fun o => by
    simpa using (isHomog_reesGen C.y o).pow C.e
  have h2 : C.z i ^ D = ∑ o, homogComp ((D - 1) * C.e) (d o : A[X]) * reesGen C.y o ^ C.e := by
    rw [← ((C.isHomog_z i).pow D).homogComp_self, h1, map_sum]
    refine Finset.sum_congr rfl fun o _ => ?_
    rw [show D * C.e = (D - 1) * C.e + C.e by
      rw [← Nat.succ_mul, Nat.succ_eq_add_one, Nat.sub_add_cancel hD],
      homogComp_mul_of_isHomog (hgo o)]
  -- lifting the coefficients along `φ`
  have h3 : ∀ o, ∃ c, C.φ c = homogComp ((D - 1) * C.e) (d o : A[X]) := fun o => by
    have : homogComp ((D - 1) * C.e) (d o : A[X]) ∈ C.φ.range := by
      rw [C.range_φ, homogComp_apply, monomial_mem_veronese (dvd_mul_left _ _), ← homogComp_apply]
      exact isGraded_normalizedRees _ (d o).2 _
    exact this
  choose c hc using h3
  refine ⟨D, hD, c, ?_⟩
  rw [proj_ideal, RingHom.mem_ker, map_sub, map_pow, φ_X, map_sum, h2, sub_eq_zero]
  refine Finset.sum_congr rfl fun o _ => ?_
  rw [map_mul, hc, φ_bdry]

/-- **`lem:wu-boundary-presentation`, finiteness.** At every point of `P^an`, `x₀` or some `ρ_l`
does not vanish. -/
theorem exists_val_bdry_ne_zero [IsAlgClosed k] {v : ProjBerk k C.M} (hv : v ∈ C.proj.an) :
    ∃ o, v.1.val (C.bdry o) ≠ 0 := by
  by_contra! hcon
  have hX : ∀ i, v.1.val (MvPolynomial.X i) = 0 := fun i => by
    obtain ⟨D, hD, c, hc⟩ := C.exists_pow_sub_sum_mem_ideal i
    have h0 : v.1.val (MvPolynomial.X i ^ D - ∑ o, c o * C.bdry o) = 0 := hv _ hc
    have h1 : v.1.val (∑ o, c o * C.bdry o) = 0 := by
      refine le_antisymm (Valuation.map_sum_le _ fun o _ => ?_) zero_le
      rw [Valuation.map_mul, hcon o, mul_zero]
    have h2 : v.1.val (MvPolynomial.X i ^ D) ≤ 0 := by
      calc v.1.val (MvPolynomial.X i ^ D)
          = v.1.val ((MvPolynomial.X i ^ D - ∑ o, c o * C.bdry o) + ∑ o, c o * C.bdry o) := by
            rw [sub_add_cancel]
        _ ≤ max _ _ := Valuation.map_add _ _ _
        _ = 0 := by rw [h0, h1, max_self]
    rw [Valuation.map_pow] at h2
    exact (pow_eq_zero_iff hD.ne').1 (le_antisymm h2 zero_le)
  have h1 : Finset.univ.sup (fun i => v.1.val (MvPolynomial.X i)) ≤ 0 :=
    Finset.sup_le fun i _ => (hX i).le
  rw [ProjBerk.sup_val_X v] at h1
  exact absurd h1 (not_le.2 one_pos)

theorem exists_mem_terms_val_ne_zero [IsAlgClosed k] {v : ProjBerk k C.M} (hv : v ∈ C.proj.an) :
    ∃ t ∈ C.fsData.terms, v.1.val t.1 ≠ 0 := by
  classical
  obtain ⟨o, ho⟩ := C.exists_val_bdry_ne_zero hv
  exact ⟨_, Finset.mem_image_of_mem _ (Finset.mem_univ o), ho⟩

/-- The boundary function `ψ = max{log|x₀|, log|ρ_l| + e(λ_l - λ₀)}` on `P^an`
(`def:wu-compactification`), real valued by `lem:wu-boundary-presentation`. -/
def ψ (v : C.proj.an) : ℝ := (C.fsData.eval v.1).toReal

theorem coe_ψ [IsAlgClosed k] (v : C.proj.an) : (C.ψ v : EReal) = C.fsData.eval v.1 := by
  obtain ⟨t, ht, hv⟩ := C.exists_mem_terms_val_ne_zero v.2
  exact EReal.coe_toReal (C.fsData.eval_ne_top v.1) (C.fsData.eval_ne_bot_of_val_ne_zero ht hv)

/-- **`lem:wu-boundary-presentation`, first part.** `ψ` is a finite Fubini–Study function of class
`O(1)` on `P^an`. -/
theorem isFiniteFS_ψ [IsAlgClosed k] : C.proj.IsFiniteFS 1 C.ψ :=
  C.proj.isFiniteFS_of_fsData C.fsData C.isRational_fsData fun _ hv =>
    C.exists_mem_terms_val_ne_zero hv

/-! #### The boundary presentation of `h` -/

/-- `log|x₀| = L` on `U_{x₀}`, `L = log |x₀|_v ∈ ℝ`. -/
theorem logAbs_X_zero_chart
    (v : {v : C.proj.an // (v : ProjBerk k C.M).1.val (MvPolynomial.X 0) ≠ 0}) :
    ProjBerk.logAbs (MvPolynomial.X 0) v.1.1 =
      ((Real.log ((v.1 : ProjBerk k C.M).1.val (MvPolynomial.X 0) : ℝ) : ℝ) : EReal) := by
  rw [ProjBerk.logAbs_def, ENNReal.log_of_nnreal v.2]

/-- `log|ρ_l| = e log|y_l| ∘ ι_{x₀} + log|x₀|` on `U_{x₀}` (`lem:wu-proj-chart`(3),(4)). -/
theorem logAbs_bdry_some_chart
    (v : {v : C.proj.an // (v : ProjBerk k C.M).1.val (MvPolynomial.X 0) ≠ 0}) (p : C.terms) :
    ProjBerk.logAbs (C.bdry (some p)) v.1.1 = ((C.e : ℝ) : EReal) * logAbs (C.y p) (C.chart v) +
      ((Real.log ((v.1 : ProjBerk k C.M).1.val (MvPolynomial.X 0) : ℝ) : ℝ) : EReal) := by
  have h1 := C.proj.affineChart_val_coeff C.isReesPresentation v (C.isHomogeneous_bdry (some p))
  rw [C.φ_bdry, reesGen_some, mul_pow, ← Polynomial.C_pow, Polynomial.coeff_C_mul_X_pow,
    if_pos (one_mul _), pow_one] at h1
  have h2 : (v.1 : ProjBerk k C.M).1.val (C.bdry (some p)) =
      (C.chart v).val (C.y p ^ C.e) * (v.1 : ProjBerk k C.M).1.val (MvPolynomial.X 0) :=
    ((eq_div_iff v.2).1 h1).symm
  rw [ProjBerk.logAbs_def, h2, ENNReal.coe_mul, ENNReal.log_mul_add, ENNReal.log_of_nnreal v.2,
    ← Berk.logAbs_def, Berk.logAbs_pow, EReal.coe_natCast]

/-- The boundary presentation, in `EReal`: on `U_{x₀}`,
`ψ = e (N h ∘ ι_{x₀}) + log|x₀| - e λ₀`. -/
theorem fsData_eval_chart
    (v : {v : C.proj.an // (v : ProjBerk k C.M).1.val (MvPolynomial.X 0) ≠ 0}) :
    C.fsData.eval v.1.1 = ((C.e : ℝ) : EReal) * (((C.N : ℝ) : EReal) * h.eval (C.chart v)) +
      ((Real.log ((v.1 : ProjBerk k C.M).1.val (MvPolynomial.X 0) : ℝ) - C.e * C.const : ℝ) :
        EReal) := by
  classical
  set L := Real.log ((v.1 : ProjBerk k C.M).1.val (MvPolynomial.X 0) : ℝ)
  have he : (0 : ℝ) < C.e := by exact_mod_cast C.e_pos
  rw [C.eval_eq, ProjBerk.ereal_coe_mul_max he.le, ProjBerk.ereal_coe_mul_finset_sup he,
    ← max_add_add_right, FSData.sup_add_coe, ← Finset.sup_attach, ← Finset.univ_eq_attach,
    ProjBerk.FSData.eval_def]
  have hm : (((C.fsData.m : ℝ)⁻¹ : ℝ) : EReal) = 1 := by
    simp [fsData]
  rw [hm, one_mul]
  change ((Finset.univ.image fun o => (C.bdry o, ((C.bdryConst o : ℚ) : ℝ))).sup
    fun t => ProjBerk.termVal t v.1.1) = _
  rw [Finset.sup_image, finset_univ_sup_option]
  simp only [Function.comp_apply, ProjBerk.termVal_def]
  congr 1
  · rw [show C.bdry none = MvPolynomial.X 0 from rfl, C.logAbs_X_zero_chart v,
      show C.bdryConst none = 0 from rfl, ← EReal.coe_mul, ← EReal.coe_add, ← EReal.coe_add]
    congr 1
    push_cast
    ring
  · refine Finset.sup_congr rfl fun p _ => ?_
    rw [C.logAbs_bdry_some_chart v p, ProjBerk.ereal_coe_mul_add he.le, add_assoc, add_assoc,
      show C.bdryConst (some p) = C.e * (p.1.2 - C.const) from rfl, ← EReal.coe_mul,
      ← EReal.coe_add, ← EReal.coe_add]
    congr 2
    push_cast
    ring

/-- **Boundary presentation** (`lem:wu-boundary-presentation`, second part): on
`U_{x₀} ∩ P^an = Y^an`, `ψ = e N h - e λ₀ + log|x₀|`. -/
theorem ψ_eq [IsAlgClosed k]
    (v : {v : C.proj.an // (v : ProjBerk k C.M).1.val (MvPolynomial.X 0) ≠ 0}) :
    C.ψ v.1 = C.e * C.N * h.evalReal (C.chart v) - C.e * C.const +
      Real.log ((v.1 : ProjBerk k C.M).1.val (MvPolynomial.X 0) : ℝ) := by
  have h1 := C.fsData_eval_chart v
  rw [← C.coe_ψ, ← h.coe_evalReal, ← EReal.coe_mul, ← EReal.coe_mul, ← EReal.coe_add] at h1
  rw [EReal.coe_injective h1]
  ring

/-- **Boundary presentation** (`lem:wu-boundary-presentation`): on `U_{x₀} ∩ P^an = Y^an`,
`h = (ψ - log|x₀|) / (e N) + λ₀ / N`. -/
theorem eval_chart [IsAlgClosed k]
    (v : {v : C.proj.an // (v : ProjBerk k C.M).1.val (MvPolynomial.X 0) ≠ 0}) :
    h.eval (C.chart v) = (((C.ψ v.1 -
      Real.log ((v.1 : ProjBerk k C.M).1.val (MvPolynomial.X 0) : ℝ)) / (C.e * C.N) +
        C.const / C.N : ℝ) : EReal) := by
  have he : (C.e : ℝ) ≠ 0 := by exact_mod_cast C.e_pos.ne'
  have hN : (C.N : ℝ) ≠ 0 := by exact_mod_cast C.N_pos.ne'
  rw [← h.coe_evalReal, C.ψ_eq v]
  congr 1
  field_simp
  ring

end Compactification

/-- **Existence of the compactification** (`def:wu-compactification`): every `h ∈ FS(Y)`, `Y`
normal affine over an algebraically closed field, admits the data of
`FSData.Compactification`: a normal form (`lem:wu-fs-normal-form`), the Veronese degree of
`lem:wu-veronese` for the normalized Rees algebra (`lem:wu-graded-closure`), and a basis
`T^e = z₀, z₁, …, z_M` of `S'_e`. -/
theorem nonempty_compactification [IsAlgClosed k] [IsDomain A] [IsIntegrallyClosed A]
    (h : FSData k A) : Nonempty h.Compactification := by
  obtain ⟨nf⟩ := h.nonempty_normalForm
  have hy : Algebra.adjoin k (Set.range fun p : nf.terms => p.1.1) = ⊤ := by
    rw [← nf.adjoin_eq_top]
    congr 1
    ext a
    exact ⟨fun ⟨p, hp⟩ => ⟨p.1, p.2, hp⟩, fun ⟨p, hp, hpa⟩ => ⟨⟨p, hp⟩, hpa⟩⟩
  obtain ⟨e, he, -, hgen, hfd, hrees, -, -, -⟩ := exists_veronese_normalizedRees hy
  have hX : (⟨Polynomial.X ^ e, hrees none⟩ :
      gradedPiece (normalizedRees k fun p : nf.terms => p.1.1) e) ≠ 0 := by
    intro h0
    exact pow_ne_zero e Polynomial.X_ne_zero (congrArg Subtype.val h0)
  obtain ⟨M, b, hb⟩ := exists_basis_fin_zero_eq (K := k) hX
  exact ⟨{ nf with
    e := e
    e_pos := he
    veronese_eq := hgen
    M := M
    basis := b
    basis_zero := by rw [hb] }⟩

/-- **`def:wu-compactification` and `lem:wu-boundary-presentation`, bundled.** For `h ∈ FS(Y)`,
`Y = Spec A` normal over an algebraically closed field, there are a normal projective variety
`P ⊆ ℙᴹ` (`R_M / I` integrally closed), a Rees presentation `φ : R_M → A[T]` of `P` with
`x₀ ↦ T^e` (so `U_{x₀} ∩ P^an ≃ₜ Y^an`, `lem:wu-proj-chart`(4)), integers `e, N > 0`, `λ₀ ∈ ℚ`
and a finite Fubini–Study function `ψ` of class `O(1)` on `P^an` with
`h = (ψ - log|x₀|) / (e N) + λ₀ / N` on `U_{x₀} ∩ P^an = Y^an`. -/
theorem exists_boundaryPresentation [IsAlgClosed k] [IsDomain A] [IsIntegrallyClosed A]
    (h : FSData k A) :
    ∃ (M e N : ℕ) (c₀ : ℚ) (P : ProjSubvariety k M)
      (φ : MvPolynomial (Fin (M + 1)) k →ₐ[k] A[X])
      (hφ : ProjBerk.IsReesPresentation k P.ideal φ e 0) (ψ : P.an → ℝ),
      0 < N ∧ IsIntegrallyClosed (MvPolynomial (Fin (M + 1)) k ⧸ P.ideal) ∧
      P.IsFiniteFS 1 ψ ∧
      ∀ v, h.eval (P.affineChart hφ v) = (((ψ v.1 -
        Real.log ((v.1 : ProjBerk k M).1.val (MvPolynomial.X 0) : ℝ)) / (e * N) +
          c₀ / N : ℝ) : EReal) := by
  obtain ⟨C⟩ := h.nonempty_compactification
  exact ⟨C.M, C.e, C.N, C.const, C.proj, C.φ, C.isReesPresentation, C.ψ, C.N_pos,
    C.isIntegrallyClosed_quotient, C.isFiniteFS_ψ, C.eval_chart⟩

end FSData

end Compactification

end EnvelopeProperty
