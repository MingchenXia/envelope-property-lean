import EnvelopeProperty.Local.ProjectionPackage
import EnvelopeProperty.Local.ProjectionWeakly
import EnvelopeProperty.Local.GluingCover

/-!
# Local regularization on normal affine varieties

Fang–Han–Xia, *The envelope property for unibranch projective varieties*, Theorem 5.25
(`thm:normal-local-regularization`) for weakly psh functions: on a normal affine variety
`Y = Spec A` over a countable algebraically closed field `k`, a weakly psh function `u` of
logarithmic growth which is regularizable on principal opens covering `Y \ Z`, for a closed
`Z = V(S) ⊊ Y`, is regularizable.

It is conditional on the imported FHX Lemma 5.11(5),(6) (`WuRegularization k`), on FHX
Proposition 5.22 (`NonflatNorms k`, through Proposition 5.24,
`IsRegularizable.of_projection_weaklyPSH`) and on the algebraic geometry of FHX Lemma 5.23 and of
the proof of Theorem 5.25 (`ProjectionPackage k`).

## Proof

Let `G` be the set of `g ∈ A` such that `u` is regularizable on `Y_g`, and `I` the radical of the
ideal generated by `G`, so that `W = V(I)` is the complement of the union `Σ` of the `Y_g`, `g ∈ G`.

* If `I = A`, the `Y_g`, `g ∈ G`, cover `Y`: every `x ∈ Y^an` has `|g|_x ≠ 0` for some `g ∈ G`
  (otherwise `G` lies in the support of `x`). Regularizability is local (FHX Proposition 5.20(2),
  `IsRegularizable.of_cover_principal`) and `u` is upper semicontinuous, so `u` is regularizable.
* `I ≠ 0`: if `f ∈ S`, `f ≠ 0`, then `f` lies in every prime `P ⊇ G`; otherwise the trivial
  valuation of the residue field at `P` (`Berk.exists_supp_eq`) has `|f| ≠ 0`, and the covering
  hypothesis gives `g ∈ G` with `g ∉ P`.
* Otherwise, `ProjectionPackage` gives a principal open `D(h)` meeting `W` and a projection
  `π : D(h) → S₁` to which the projection step (FHX Proposition 5.24) applies, with `Z = W ∩ D(h)`
  generated by the image of a finite generating set of `I`: `u|_{D(h)}` is weakly psh
  (`IsWeaklyPSHOn.comp_awayComap`), of logarithmic growth (`HasLogGrowth.comp_comap`) and
  regularizable on the principal opens `D(h)_g = D(hg)`, `g ∈ G`, which cover `D(h) \ W`
  (`IsRegularizable.comp_awayComap_algebraMap`). So `h ∈ G ⊆ I`, contradicting `D(h) ∩ W ≠ ∅`.

## Main results

* `IsWeaklyPSHOn.comp_awayComap`: weakly psh functions restrict to principal opens; the chart
  `A[s/g]` of the blowup of `Y` maps to the chart `A_h[s/g]` of the blowup of `Y_h`
  (`chartAwayMap`).
* `IsRegularizable.comp_awayComap_algebraMap`: regularizability on `Y_g` gives regularizability
  on the principal open `(Y_h)_g` of `Y_h`.
* `IsRegularizable.of_isWeaklyPSHOn`: FHX Theorem 5.25 for weakly psh functions.
-/

open scoped NNReal ENNReal Topology

noncomputable section

namespace EnvelopeProperty

open Berk

universe u v

/-! ### Points with a prescribed support -/

section supp

variable {k : Type*} [Field k] {A : Type*} [CommRing A] [Algebra k A]

/-- Every prime `P` of `A` is the support of a point of `(Spec A)^an`: the trivial valuation of
the residue field at `P`, pulled back along `A → A/P`. -/
theorem Berk.exists_supp_eq (P : Ideal A) [P.IsPrime] : ∃ x : Berk k A, x.val.supp = P := by
  refine ⟨comap (Ideal.Quotient.mkₐ k P) triv, Ideal.ext fun a => ?_⟩
  rw [Valuation.mem_supp_iff, comap_val_apply, Ideal.Quotient.mkₐ_eq_mk]
  by_cases ha : a ∈ P
  · simp [Ideal.Quotient.eq_zero_iff_mem.2 ha, ha]
  · rw [triv_val_of_ne_zero (fun h => ha (Ideal.Quotient.eq_zero_iff_mem.1 h))]
    simp [ha]

end supp

/-! ### Weakly psh functions restrict to principal opens -/

section away

variable {k : Type*} [Field k] {A : Type*} [CommRing A] [IsDomain A] [Algebra k A] {h : A}

/-- `A → A_h` is injective for `h ≠ 0`. -/
theorem algebraMap_away_injective (hh : h ≠ 0) :
    Function.Injective (algebraMap A (Localization.Away h)) :=
  IsLocalization.injective (Localization.Away h) (powers_le_nonZeroDivisors_of_noZeroDivisors hh)

/-- The embedding `A ↪ A_h` for `h ≠ 0`. -/
def awayEmb (hh : h ≠ 0) : A ↪ Localization.Away h :=
  ⟨algebraMap A (Localization.Away h), algebraMap_away_injective hh⟩

@[simp]
theorem awayEmb_apply (hh : h ≠ 0) (a : A) :
    awayEmb hh a = algebraMap A (Localization.Away h) a := rfl

variable (hh : h ≠ 0) [IsDomain (Localization.Away h)]
include hh

/-- The map `Frac A → Frac A_h` induced by `A → A_h`. -/
abbrev fracAway : FractionRing A →+* FractionRing (Localization.Away h) :=
  IsFractionRing.map (j := algebraMap A (Localization.Away h)) (algebraMap_away_injective hh)

theorem fracAway_algebraMap (a : A) :
    fracAway hh (algebraMap A (FractionRing A) a) =
      algebraMap (Localization.Away h) (FractionRing (Localization.Away h))
        (algebraMap A (Localization.Away h) a) :=
  IsLocalization.map_eq _ _

/-- `Frac A → Frac A_h` maps the chart `A[s/g]` into the chart `A_h[s/g]`. -/
theorem fracAway_mem_blowupChart (s : Finset A) (g : A) {z : FractionRing A}
    (hz : z ∈ blowupChart s g) :
    fracAway hh z ∈ blowupChart (s.map (awayEmb hh)) (algebraMap A (Localization.Away h) g) := by
  induction hz using Algebra.adjoin_induction with
  | mem z hz =>
    obtain ⟨a, ha, rfl⟩ := hz
    rw [map_div₀, fracAway_algebraMap, fracAway_algebraMap]
    exact Algebra.subset_adjoin ⟨awayEmb hh a, Finset.mem_map_of_mem _ ha, rfl⟩
  | algebraMap a =>
    rw [fracAway_algebraMap]
    exact Subalgebra.algebraMap_mem _ (algebraMap A (Localization.Away h) a)
  | add z w _ _ hz hw => rw [map_add]; exact Subalgebra.add_mem _ hz hw
  | mul z w _ _ hz hw => rw [map_mul]; exact Subalgebra.mul_mem _ hz hw

variable (k) in
/-- The map of charts `A[s/g] → A_h[s/g]` over `A → A_h`: the chart of the blowup of `Y_h` along
`s` maps to the chart of the blowup of `Y` along `s`. -/
def chartAwayMap (s : Finset A) (g : A) :
    blowupChart s g →ₐ[k]
      blowupChart (s.map (awayEmb hh)) (algebraMap A (Localization.Away h) g) where
  toRingHom := ((fracAway hh).comp (blowupChart s g).val.toRingHom).codRestrict _
    fun z => fracAway_mem_blowupChart hh s g z.2
  commutes' c := by
    refine Subtype.ext ?_
    change fracAway hh ((algebraMap k (blowupChart s g) c : FractionRing A)) =
      ((algebraMap k (blowupChart (s.map (awayEmb hh)) (algebraMap A (Localization.Away h) g))
        c : FractionRing (Localization.Away h)))
    rw [Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap,
      IsScalarTower.algebraMap_apply k A (FractionRing A), fracAway_algebraMap,
      IsScalarTower.algebraMap_apply k (Localization.Away h) (FractionRing (Localization.Away h)),
      ← IsScalarTower.algebraMap_apply k A (Localization.Away h)]

theorem chartAwayMap_chartMap (s : Finset A) (g : A) (a : A) :
    chartAwayMap k hh s g (chartMap k s g a) =
      chartMap k (s.map (awayEmb hh)) (algebraMap A (Localization.Away h) g)
        (algebraMap A (Localization.Away h) a) :=
  Subtype.ext (fracAway_algebraMap hh a)

/-- The square `ι ∘ μ_h = μ ∘ (chart map)` on analytifications, `ι : Y_h → Y` the inclusion. -/
theorem awayComap_comap_chartMap (s : Finset A) (g : A)
    (y : Berk k (blowupChart (s.map (awayEmb hh)) (algebraMap A (Localization.Away h) g))) :
    awayComap h (comap (chartMap k (s.map (awayEmb hh)) (algebraMap A (Localization.Away h) g))
      y) = comap (chartMap k s g) (comap (chartAwayMap k hh s g) y) :=
  ext_val fun a => by
    simp only [awayComap_val_apply, comap_val_apply, chartAwayMap_chartMap]

/-- **Weakly psh functions restrict to principal opens**: if `s` is a blowup witness for `u` on
`Y`, its image in `A_h` is one for `u|_{Y_h}`, the charts of the blowup of `Y_h` mapping to those
of `Y` (`chartAwayMap`). -/
theorem IsWeaklyPSHOn.comp_awayComap {u : Berk k A → EReal} (hu : IsWeaklyPSHOn Set.univ u) :
    IsWeaklyPSHOn Set.univ fun y : Berk k (Localization.Away h) => u (awayComap h y) := by
  obtain ⟨s, ⟨g₀, hg₀, hg₀0⟩, hloc⟩ := hu
  refine ⟨s.map (awayEmb hh), ⟨awayEmb hh g₀, Finset.mem_map_of_mem _ hg₀,
    (map_ne_zero_iff _ (algebraMap_away_injective hh)).2 hg₀0⟩, ?_⟩
  intro g' hg' hg'0
  obtain ⟨g, hg, rfl⟩ := Finset.mem_map.1 hg'
  have hg0 : g ≠ 0 := fun h0 => hg'0 (by simp [h0])
  have := (hloc g hg hg0).comp_comap (chartAwayMap k hh s g)
  simp only [Set.preimage_univ] at this ⊢
  exact (congrArg (IsLocallyPSHOn Set.univ)
    (funext fun y => congrArg u (awayComap_comap_chartMap hh s g y))).mpr this

end away

/-! ### Regularizability on principal opens of a principal open -/

section awayAway

variable {k : Type*} [Field k] {A : Type*} [CommRing A] [IsDomain A] [Algebra k A]
  [Algebra.FiniteType k A]

omit [IsDomain A] [Algebra.FiniteType k A] in
/-- The map `A_g → B_{f g}` induced by `f : A → B` extends `f`. -/
theorem awayMapₐ_algebraMap {B : Type*} [CommRing B] [Algebra k B] (f : A →ₐ[k] B) (g a : A) :
    Localization.awayMapₐ f g (algebraMap A (Localization.Away g) a) =
      algebraMap B (Localization.Away (f g)) (f a) := by
  simp [IsLocalization.Away.map]

/-- If `u` is regularizable on `Y_g`, then `u|_{Y_h}` is regularizable on the principal open
`(Y_h)_g = Y_{hg}` of `Y_h`: the map `(Y_h)_g → Y` factors through `Y_g` via `A_g → (A_h)_g`, and
the pullback is finite at the trivial valuation (FHX Lemma 5.11(4)). -/
theorem IsRegularizable.comp_awayComap_algebraMap {h g : A} (hh : h ≠ 0) (hg : g ≠ 0)
    {u : Berk k A → EReal}
    (hu : IsRegularizable fun y : Berk k (Localization.Away g) => u (awayComap g y)) :
    IsRegularizable fun y : Berk k (Localization.Away (algebraMap A (Localization.Away h) g)) =>
      u (awayComap h (awayComap (algebraMap A (Localization.Away h) g) y)) := by
  have := isDomain_localizationAway hh
  have := isDomain_localizationAway hg
  have hg' : algebraMap A (Localization.Away h) g ≠ 0 :=
    (map_ne_zero_iff _ (algebraMap_away_injective hh)).2 hg
  have := isDomain_localizationAway hg'
  let ψ : Localization.Away g →ₐ[k] Localization.Away (algebraMap A (Localization.Away h) g) :=
    Localization.awayMapₐ (IsScalarTower.toAlgHom k A (Localization.Away h)) g
  have key : ∀ y, awayComap g (comap ψ y) =
      awayComap h (awayComap (algebraMap A (Localization.Away h) g) y) := fun y =>
    ext_val fun a => by
      simp only [awayComap_val_apply, comap_val_apply]
      congr 1
      exact awayMapₐ_algebraMap _ g a
  have htriv := hu.triv_ne_bot
  rw [awayComap_triv] at htriv
  refine (hu.comp_comap ψ ⟨triv, ?_⟩).congr fun y => ?_
  · rw [key, awayComap_triv, awayComap_triv]
    exact htriv
  · exact congrArg u (key y)

end awayAway

/-! ### Theorem 5.25 -/

section main

variable {k : Type u} [Field k] [IsAlgClosed k] [Countable k] [WuRegularization.{u, v} k]
  [NonflatNorms.{u, v, u} k] [ProjectionPackage.{u, v} k]
  {A : Type v} [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A]
  [IsIntegrallyClosed A]

/-- **Local regularization on normal affine varieties** (FHX Theorem 5.25,
`thm:normal-local-regularization`), for weakly psh functions, conditional on FHX Lemma
5.11(5),(6) (`WuRegularization k`), Proposition 5.22 (`NonflatNorms k`) and the algebraic geometry
of Lemma 5.23 and of the proof of Theorem 5.25 (`ProjectionPackage k`).

Let `Y = Spec A` be a normal affine variety and `Z = V(S) ⊊ Y` (`hS`). If `u` is weakly psh (with
a blowup witness), of logarithmic growth, and regularizable on principal opens covering
`Y^an \ Z^an`, then `u` is regularizable. -/
theorem IsRegularizable.of_isWeaklyPSHOn (S : Finset A) (hS : ∃ f ∈ S, f ≠ 0)
    {u : Berk k A → EReal} (hu : IsWeaklyPSHOn Set.univ u) (hlog : HasLogGrowth u)
    (hcover : ∀ x : Berk k A, (∃ f ∈ S, x.val f ≠ 0) →
      ∃ g : A, g ≠ 0 ∧ x.val g ≠ 0 ∧ IsRegularizable fun y => u (awayComap g y)) :
    IsRegularizable u := by
  classical
  -- `G`: the `g` with `u` regularizable on `Y_g`; `W = V(I)` is the complement of their union
  set G : Set A := {g | IsRegularizable fun y : Berk k (Localization.Away g) => u (awayComap g y)}
    with hG
  set I : Ideal A := (Ideal.span G).radical with hI
  have hGI : ∀ g ∈ G, g ∈ I := fun g hg => Ideal.le_radical (Ideal.subset_span hg)
  -- points of `Y^an` off `W^an` lie in some `Y_g^an`, `g ∈ G`
  have hcovI : ∀ x : Berk k A, ¬ I ≤ x.val.supp →
      ∃ g : A, g ≠ 0 ∧ x.val g ≠ 0 ∧ IsRegularizable fun y => u (awayComap g y) := by
    intro x hx
    by_contra hcon
    push Not at hcon
    refine hx ((Ideal.IsPrime.radical_le_iff inferInstance).2 (Ideal.span_le.2 fun g hg => ?_))
    rw [SetLike.mem_coe, Valuation.mem_supp_iff]
    by_contra hxg
    have hg0 : g ≠ 0 := by
      rintro rfl
      exact hxg (map_zero _)
    exact hcon g hg0 hxg hg
  by_cases htop : I = ⊤
  · -- `Σ = Y`: regularizability is local
    refine IsRegularizable.of_cover_principal hu.upperSemicontinuous hlog fun x => hcovI x ?_
    rw [htop, top_le_iff]
    exact Ideal.IsPrime.ne_top inferInstance
  exfalso
  -- `W ≠ Y`
  have hbot : I ≠ ⊥ := by
    obtain ⟨f, hfS, hf0⟩ := hS
    refine fun hbot => hf0 ?_
    have hfI : f ∈ I := by
      rw [hI, Ideal.radical_eq_sInf, Submodule.mem_sInf]
      rintro P ⟨hGP, hP⟩
      by_contra hfP
      obtain ⟨x, hx⟩ := Berk.exists_supp_eq (k := k) P
      have hxf : x.val f ≠ 0 := by
        rwa [Ne, ← Valuation.mem_supp_iff, hx]
      obtain ⟨g, -, hxg, hg⟩ := hcover x ⟨f, hfS, hxf⟩
      exact hxg ((Valuation.mem_supp_iff _ _).1 (hx ▸ hGP (Ideal.subset_span hg)))
    rwa [hbot, Ideal.mem_bot] at hfI
  -- the algebraic-geometry package
  obtain ⟨D⟩ := ProjectionPackage.nonempty (k := k) (Ideal.radical_isRadical _) hbot htop
  obtain ⟨P₀, hP₀, hIP₀, hhP₀⟩ := D.exists_prime
  have hh : D.h ≠ 0 := fun h0 => hhP₀ (h0 ▸ P₀.zero_mem)
  have := isDomain_localizationAway hh
  have := isIntegrallyClosed_localizationAway hh
  set Ah := Localization.Away D.h
  -- a finite generating set of `I A_h`
  have : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
  obtain ⟨T, hT⟩ := (IsNoetherian.noetherian I : I.FG)
  set S' : Finset Ah := T.map (awayEmb hh)
  have hS'span : Ideal.span (S' : Set Ah) = I.map (algebraMap A Ah) := by
    rw [← hT, Ideal.map_span, Finset.coe_map]
    rfl
  have hS' : ∃ f ∈ S', f ≠ 0 := by
    by_contra hcon
    push Not at hcon
    refine hbot ?_
    rw [← hT, Ideal.span_eq_bot]
    intro t ht
    exact algebraMap_away_injective hh
      ((hcon _ (Finset.mem_map_of_mem _ ht)).trans (map_zero _).symm)
  have hsupp : ∀ y : Berk k Ah, (∀ f ∈ S', y.val f = 0) → I.map (algebraMap A Ah) ≤ y.val.supp :=
    fun y hy => hS'span ▸ Ideal.span_le.2 fun f hf => (Valuation.mem_supp_iff _ _).2 (hy f hf)
  -- `u` is regularizable on `D(h)`
  have hreg : IsRegularizable fun y : Berk k Ah => u (awayComap D.h y) := by
    refine IsRegularizable.of_projection_weaklyPSH (B := Localization.Away D.h₀)
      ⟨D.h₀, D.h₀_ne_zero, ⟨AlgEquiv.refl⟩⟩ D.φ D.injective D.finite D.genericallyEtale S' hS'
      (by rw [hS'span]; exact D.closedImmersion) D.add_eq_one ?_ ?_ (hu.comp_awayComap hh)
      (hlog.comp_comap _) ?_
    · -- `f₂ = 0` on `Z^an`
      intro y hy
      rw [← Valuation.mem_supp_iff]
      exact (Ideal.IsPrime.radical_le_iff inferInstance).2 (hsupp y hy) D.f₂_mem
    · -- `f₁ = 0` on `π⁻¹(π(Z^an)) \ Z^an`
      intro y y' hy hyy' hy'
      rw [← Valuation.mem_supp_iff]
      refine D.f₁_mem _ _ inferInstance inferInstance (hsupp y hy) (fun hle => ?_) ?_
      · obtain ⟨f, hf, hy'f⟩ := hy'
        exact hy'f ((Valuation.mem_supp_iff _ _).1 (hle (hS'span ▸ Ideal.subset_span hf)))
      · rw [← supp_comap, ← supp_comap, hyy']
    · -- the cover of `D(h) \ Z`
      rintro x ⟨f, hf, hxf⟩
      have hx : ¬ I ≤ (awayComap D.h x).val.supp := by
        intro hle
        refine hxf ((Valuation.mem_supp_iff _ _).1 ?_)
        have hle' : I.map (algebraMap A Ah) ≤ x.val.supp := by
          rw [Ideal.map_le_iff_le_comap]
          rw [awayComap_eq, supp_comap] at hle
          exact hle
        exact hle' (hS'span ▸ Ideal.subset_span hf)
      obtain ⟨g, hg0, hxg, hg⟩ := hcovI _ hx
      have hxg' : x.val (algebraMap A Ah g) ≠ 0 := hxg
      refine ⟨algebraMap A Ah g, fun h0 => hxg' (h0 ▸ map_zero _), hxg', ?_⟩
      exact IsRegularizable.comp_awayComap_algebraMap hh hg0 hg
  -- so `D(h) ⊆ Σ`, contradicting `D(h) ∩ W ≠ ∅`
  exact hhP₀ (hIP₀ (hGI _ hreg))

end main

end EnvelopeProperty
