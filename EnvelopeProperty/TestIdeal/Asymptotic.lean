import EnvelopeProperty.TestIdeal.Basic

/-!
# Asymptotic test ideals of graded sequences

Let `K` be a perfect field of characteristic `p` and `R = K[x_i : i ∈ σ]`, `σ` finite. A graded
sequence of ideals is `J : ℕ → Ideal R` with `J m * J r ≤ J (m + r)`; we assume `J q ≠ 0` for
`q > 0`. Following Mustaţă (*The non-nef locus in positive characteristic*, §3) and FHX Section 3
(eq. `eq:smooth-test-inclusions`), the asymptotic test ideal is
`B_m = τ(J_•^m) = ⋃_{q > 0} τ(J_q^{m/q})`.

* `testIdeal_le_testIdeal_of_dvd`: `τ(J_q^{m/q}) ≤ τ(J_{q'}^{m/q'})` whenever `q ∣ q'`
  (from `J_q^k ≤ J_{kq}` and `τ((I^k)^c) = τ(I^{kc})`);
* `exists_asymptoticTestIdeal_eq`: there is `q₀ > 0` with `B_m = τ(J_q^{m/q})` for every
  `q` divisible by `q₀` (Noetherianity);
* `le_asymptoticTestIdeal`: `J_m ≤ B_m`;
* `asymptoticTestIdeal_mul_le`: subadditivity `B_{m l} ≤ B_m ^ l`
  (from `τ(I^{l c}) ≤ τ(I^c)^l`, `testIdeal_nsmul_le`);
* `isHomogeneous_asymptoticTestIdeal` and `HasWeightedGeneratorsLE.asymptoticTestIdeal`: if
  every `J_q` is generated by `w`-homogeneous polynomials of degree `≤ q D`, then `B_m` is
  generated by `w`-homogeneous polynomials of degree `≤ m D` (the polynomial-ring form of the
  uniform generation FHX Lemma 3.2, `lem:smooth-uniform-twist`, for `ℙⁿ`, where
  `K_{ℙⁿ} + (n+1) H = 0`).
-/

open MvPolynomial

noncomputable section

namespace EnvelopeProperty

attribute [local instance] MvPolynomial.weightedGradedAlgebra

variable {σ K : Type*} [Field K] (p : ℕ) [hp : Fact p.Prime] [CharP K p] [PerfectRing K p]
variable [Finite σ]

/-- The asymptotic test ideal `B_m = τ(J_•^m) = ⨆_{q > 0} τ(J_q^{m/q})` of a sequence of ideals.
For a graded sequence of nonzero ideals it equals `τ(J_q^{m/q})` for all sufficiently divisible
`q` (`exists_asymptoticTestIdeal_eq`). -/
def asymptoticTestIdeal (J : ℕ → Ideal (MvPolynomial σ K)) (m : ℕ) : Ideal (MvPolynomial σ K) :=
  ⨆ (q : ℕ) (_ : 0 < q), testIdeal p (J q) ((m : ℚ) / q)

omit [Finite σ] in
/-- In a graded sequence, `J_q^k ≤ J_{kq}` for `k > 0`. -/
theorem graded_pow_le {J : ℕ → Ideal (MvPolynomial σ K)}
    (hJ : ∀ m r, J m * J r ≤ J (m + r)) (q : ℕ) {k : ℕ} (hk : 0 < k) : J q ^ k ≤ J (k * q) := by
  induction k, hk using Nat.le_induction with
  | base => simp
  | succ k _ ih =>
    rw [pow_succ, add_mul, one_mul]
    exact le_trans (Ideal.mul_mono_left ih) (hJ _ _)

theorem testIdeal_le_asymptoticTestIdeal (J : ℕ → Ideal (MvPolynomial σ K)) (m : ℕ) {q : ℕ}
    (hq : 0 < q) : testIdeal p (J q) ((m : ℚ) / q) ≤ asymptoticTestIdeal p J m :=
  le_iSup₂ (f := fun (q : ℕ) (_ : 0 < q) => testIdeal p (J q) ((m : ℚ) / q)) q hq

variable {J : ℕ → Ideal (MvPolynomial σ K)}

/-- `τ(J_q^{m/q}) ≤ τ(J_{q'}^{m/q'})` whenever `q ∣ q'`. -/
theorem testIdeal_le_testIdeal_of_dvd (hJ : ∀ m r, J m * J r ≤ J (m + r))
    (hne : ∀ q, 0 < q → J q ≠ ⊥) (m : ℕ) {q q' : ℕ} (hq : 0 < q) (hq' : 0 < q') (hdvd : q ∣ q') :
    testIdeal p (J q) ((m : ℚ) / q) ≤ testIdeal p (J q') ((m : ℚ) / q') := by
  obtain ⟨k, rfl⟩ := hdvd
  have hk : 0 < k := Nat.pos_of_mul_pos_left hq'
  have hc : (0 : ℚ) ≤ (m : ℚ) / (q * k : ℕ) := by positivity
  have h1 : (m : ℚ) / q = (k : ℚ) * ((m : ℚ) / (q * k : ℕ)) := by
    push_cast
    field_simp
  rw [h1, ← testIdeal_pow p (hne q hq) hc k]
  refine testIdeal_mono p (le_trans (graded_pow_le hJ q hk) ?_) _
  rw [mul_comm]

/-- Stabilization: there is `q₀ > 0` such that `B_m = τ(J_q^{m/q})` for every `q > 0` divisible
by `q₀`. -/
theorem exists_asymptoticTestIdeal_eq (hJ : ∀ m r, J m * J r ≤ J (m + r))
    (hne : ∀ q, 0 < q → J q ≠ ⊥) (m : ℕ) :
    ∃ q₀, 0 < q₀ ∧ ∀ q, 0 < q → q₀ ∣ q →
      asymptoticTestIdeal p J m = testIdeal p (J q) ((m : ℚ) / q) := by
  set F : ℕ → Ideal (MvPolynomial σ K) := fun q => testIdeal p (J q) ((m : ℚ) / q)
  obtain ⟨_, ⟨q₀, hq₀, rfl⟩, hmax⟩ := set_has_maximal_iff_noetherian.2
    (inferInstance : IsNoetherianRing (MvPolynomial σ K)) {I | ∃ q, 0 < q ∧ F q = I}
    ⟨F 1, 1, one_pos, rfl⟩
  have hle : ∀ q, 0 < q → F q ≤ F q₀ := by
    intro q hq
    have hqq : 0 < q * q₀ := Nat.mul_pos hq hq₀
    have h1 : F q ≤ F (q * q₀) :=
      testIdeal_le_testIdeal_of_dvd p hJ hne m hq hqq (dvd_mul_right q q₀)
    have h2 : F q₀ ≤ F (q * q₀) :=
      testIdeal_le_testIdeal_of_dvd p hJ hne m hq₀ hqq (dvd_mul_left q₀ q)
    have h3 : F q₀ = F (q * q₀) := by
      by_contra hne'
      exact hmax _ ⟨q * q₀, hqq, rfl⟩ (lt_of_le_of_ne h2 hne')
    rw [h3]
    exact h1
  have hB : asymptoticTestIdeal p J m = F q₀ :=
    le_antisymm (iSup₂_le hle) (testIdeal_le_asymptoticTestIdeal p J m hq₀)
  refine ⟨q₀, hq₀, fun q hq hdvd => le_antisymm ?_ ?_⟩
  · rw [hB]
    exact testIdeal_le_testIdeal_of_dvd p hJ hne m hq₀ hq hdvd
  · exact testIdeal_le_asymptoticTestIdeal p J m hq

/-- `J_m ≤ B_m` for `m > 0`. -/
theorem le_asymptoticTestIdeal {m : ℕ} (hm : 0 < m) : J m ≤ asymptoticTestIdeal p J m := by
  refine le_trans ?_ (testIdeal_le_asymptoticTestIdeal p J m hm)
  rw [div_self (Nat.cast_ne_zero.2 hm.ne')]
  exact le_testIdeal_one p (J m)

/-- Subadditivity of asymptotic test ideals: `B_{m l} ≤ B_m ^ l`. -/
theorem asymptoticTestIdeal_mul_le (hJ : ∀ m r, J m * J r ≤ J (m + r))
    (hne : ∀ q, 0 < q → J q ≠ ⊥) (m l : ℕ) :
    asymptoticTestIdeal p J (m * l) ≤ asymptoticTestIdeal p J m ^ l := by
  obtain ⟨q₁, hq₁, h₁⟩ := exists_asymptoticTestIdeal_eq p hJ hne (m * l)
  obtain ⟨q₂, hq₂, h₂⟩ := exists_asymptoticTestIdeal_eq p hJ hne m
  have hq : 0 < q₁ * q₂ := Nat.mul_pos hq₁ hq₂
  rw [h₁ _ hq (dvd_mul_right _ _), h₂ _ hq (dvd_mul_left _ _)]
  have h : ((m * l : ℕ) : ℚ) / (q₁ * q₂ : ℕ) = (l : ℚ) * ((m : ℚ) / (q₁ * q₂ : ℕ)) := by
    push_cast
    ring
  rw [h]
  exact testIdeal_nsmul_le p (hne _ hq) (by positivity) l

/-- Asymptotic test ideals of a sequence of `w`-homogeneous ideals are `w`-homogeneous. -/
theorem isHomogeneous_asymptoticTestIdeal {w : σ → ℕ}
    (hJ : ∀ q, (J q).IsHomogeneous (weightedHomogeneousSubmodule K w)) (m : ℕ) :
    (asymptoticTestIdeal p J m).IsHomogeneous (weightedHomogeneousSubmodule K w) :=
  Ideal.IsHomogeneous.iSup fun q => Ideal.IsHomogeneous.iSup fun _ =>
    isHomogeneous_testIdeal p (hJ q) _

/-- If every `J_q` (`q > 0`) is generated by `w`-homogeneous polynomials of degree `≤ q D`, then
`B_m` is generated by `w`-homogeneous polynomials of degree `≤ m D`. -/
theorem HasWeightedGeneratorsLE.asymptoticTestIdeal (hJ : ∀ m r, J m * J r ≤ J (m + r))
    (hne : ∀ q, 0 < q → J q ≠ ⊥) {w : σ → ℕ} {D : ℕ}
    (hgen : ∀ q, 0 < q → HasWeightedGeneratorsLE w (q * D) (J q)) (m : ℕ) :
    HasWeightedGeneratorsLE w (m * D) (asymptoticTestIdeal p J m) := by
  obtain ⟨q₀, hq₀, h₀⟩ := exists_asymptoticTestIdeal_eq p hJ hne m
  rw [h₀ q₀ hq₀ dvd_rfl]
  have h := (hgen q₀ hq₀).testIdeal p (c := (m : ℚ) / q₀) (by positivity)
  have hq : (q₀ : ℚ) ≠ 0 := Nat.cast_ne_zero.2 hq₀.ne'
  have h1 : (m : ℚ) / q₀ * ((q₀ * D : ℕ) : ℚ) = ((m * D : ℕ) : ℚ) := by
    push_cast
    field_simp
  rwa [h1, Nat.floor_natCast] at h

end EnvelopeProperty
