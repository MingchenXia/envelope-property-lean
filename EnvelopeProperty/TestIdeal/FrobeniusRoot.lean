import Mathlib

/-!
# Frobenius powers and Frobenius roots of ideals in polynomial rings

Let `K` be a perfect field of characteristic `p`, `σ` a finite type, `R = K[x_i : i ∈ σ]` and
`q = p ^ e`. This file develops the elementary Frobenius algebra of `R` used for test ideals in
Fang–Han–Xia, *The envelope property for unibranch projective varieties*, Section 3
(`sec:smooth`, eq. `eq:test-def` and the Frobenius trace `Φ_e` of `lem:divisorial-trace-estimate`,
for the trivialization `dx` of `ω_R`), following Blickle–Mustaţă–Smith, *Discreteness and
rationality of F-thresholds*, §2.

* `EnvelopeProperty.frobPow q I`: the Frobenius power `I^[q] = (f^q : f ∈ I)` (any commutative
  semiring).
* `EnvelopeProperty.rootCoeff p e a f`: the coefficient `f_a` of `x^a` in the decomposition
  `f = ∑_{a ∈ box} (f_a)^q x^a`. Concretely `coeff c f_a = (coeff (q • c + a) f)^{1/q}`.
  The decomposition is `sum_rootCoeff`, uniqueness is `rootCoeff_sum_box`, and semilinearity
  `rootCoeff (g^q * f) a = g * rootCoeff f a` (for `a ∈ box`) is `rootCoeff_pow_mul`.
* `EnvelopeProperty.box p e`: the exponents `a` with `a i < q` for all `i`.
* `EnvelopeProperty.frobTrace p e`: the Frobenius trace `Φ_e f = f_{(q-1,…,q-1)}`, with
  `rootCoeff_eq_frobTrace : f_a = Φ_e (x^{q-1-a} f)` and `frobTrace_frobTrace : Φ_{e'} ∘ Φ_e =
  Φ_{e+e'}`.
* `EnvelopeProperty.frobRoot p e I`: the Frobenius root `I^[1/q]`, *defined* as the set
  `Φ_e '' I` (which is an ideal). It is the left adjoint of `frobPow (p ^ e)`
  (`gc_frobRoot_frobPow`): `I^[1/q] ≤ J ↔ I ≤ J^[q]`, so `I^[1/q]` is the smallest ideal `J` with
  `I ≤ J^[q]`. Further properties: `frobRoot_eq_span` (generated by the `f_a`, `f ∈ I`),
  `frobRoot_frobPow`, `frobRoot_mul_frobPow`, `frobRoot_sup`, `frobRoot_frobRoot`,
  `frobRoot_mul_le` and `frobRoot_span_singleton_eq_top` (for `0 ≠ g` with `deg g < q`).
-/

open MvPolynomial

noncomputable section

namespace EnvelopeProperty

/-! ### Frobenius powers -/

section FrobPow

variable {R : Type*} [CommSemiring R]

/-- The Frobenius power `I^[q]` of an ideal: the ideal generated by the `q`-th powers of the
elements of `I`. -/
def frobPow (q : ℕ) (I : Ideal R) : Ideal R :=
  Ideal.span ((· ^ q) '' (I : Set R))

theorem pow_mem_frobPow {q : ℕ} {I : Ideal R} {f : R} (hf : f ∈ I) : f ^ q ∈ frobPow q I :=
  Ideal.subset_span ⟨f, hf, rfl⟩

theorem frobPow_le_iff {q : ℕ} {I J : Ideal R} : frobPow q I ≤ J ↔ ∀ f ∈ I, f ^ q ∈ J := by
  rw [frobPow, Ideal.span_le, Set.image_subset_iff]
  rfl

theorem frobPow_mono (q : ℕ) : Monotone (frobPow (R := R) q) := fun _ _ h =>
  Ideal.span_mono (Set.image_mono h)

theorem frobPow_le_pow (q : ℕ) (I : Ideal R) : frobPow q I ≤ I ^ q :=
  frobPow_le_iff.2 fun _ hf => Ideal.pow_mem_pow hf q

theorem frobPow_le {q : ℕ} (hq : q ≠ 0) (I : Ideal R) : frobPow q I ≤ I :=
  frobPow_le_iff.2 fun f hf => by
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_lt (Nat.pos_of_ne_zero hq)
    rw [zero_add, pow_succ]
    exact I.mul_mem_left _ hf

@[simp]
theorem frobPow_one (I : Ideal R) : frobPow 1 I = I :=
  le_antisymm (frobPow_le one_ne_zero I) fun f hf => by simpa using pow_mem_frobPow (q := 1) hf

@[simp]
theorem frobPow_top (q : ℕ) : frobPow q (⊤ : Ideal R) = ⊤ :=
  (Ideal.eq_top_iff_one _).2 <| by
    simpa using pow_mem_frobPow (q := q) (Submodule.mem_top (x := (1 : R)))

theorem frobPow_bot {q : ℕ} (hq : q ≠ 0) : frobPow q (⊥ : Ideal R) = ⊥ :=
  le_bot_iff.1 <| frobPow_le_iff.2 fun f hf => by
    rw [Ideal.mem_bot] at hf ⊢
    rw [hf, zero_pow hq]

variable (p : ℕ) [Fact p.Prime] [CharP R p]

/-- In characteristic `p`, the `p ^ e`-th power of an element of `span S` lies in the span of the
`p ^ e`-th powers of the elements of `S`. -/
theorem pow_mem_span_image_pow {S : Set R} {f : R} (hf : f ∈ Ideal.span S) (e : ℕ) :
    f ^ p ^ e ∈ Ideal.span ((· ^ p ^ e) '' S) := by
  induction hf using Submodule.span_induction with
  | mem x hx => exact Ideal.subset_span ⟨x, hx, rfl⟩
  | zero =>
    rw [zero_pow (pow_ne_zero _ (Fact.out : p.Prime).ne_zero)]
    exact zero_mem _
  | add x y _ _ hx hy =>
    rw [add_pow_char_pow]
    exact add_mem hx hy
  | smul a x _ hx =>
    rw [smul_eq_mul, mul_pow]
    exact Ideal.mul_mem_left _ _ hx

theorem frobPow_span (e : ℕ) (S : Set R) :
    frobPow (p ^ e) (Ideal.span S) = Ideal.span ((· ^ p ^ e) '' S) :=
  le_antisymm (frobPow_le_iff.2 fun _ hf => pow_mem_span_image_pow p hf e)
    (Ideal.span_mono (Set.image_mono Ideal.subset_span))

/-- `(I^[p^e'])^[p^e] = I^[p^(e' + e)]`. -/
theorem frobPow_frobPow (e e' : ℕ) (I : Ideal R) :
    frobPow (p ^ e) (frobPow (p ^ e') I) = frobPow (p ^ (e' + e)) I := by
  rw [show frobPow (p ^ e') I = Ideal.span ((· ^ p ^ e') '' (I : Set R)) from rfl, frobPow_span,
    Set.image_image]
  simp_rw [← pow_mul, ← pow_add]
  rfl

theorem frobPow_mul (e : ℕ) (I J : Ideal R) :
    frobPow (p ^ e) (I * J) = frobPow (p ^ e) I * frobPow (p ^ e) J := by
  apply le_antisymm
  · rw [frobPow_le_iff]
    intro f hf
    refine Submodule.mul_induction_on hf ?_ ?_
    · intro a ha b hb
      rw [mul_pow]
      exact Ideal.mul_mem_mul (pow_mem_frobPow ha) (pow_mem_frobPow hb)
    · intro x y hx hy
      rw [add_pow_char_pow]
      exact add_mem hx hy
  · rw [frobPow, frobPow, Ideal.span_mul_span', Ideal.span_le]
    rintro _ ⟨_, ⟨a, ha, rfl⟩, _, ⟨b, hb, rfl⟩, rfl⟩
    simp only
    rw [← mul_pow]
    exact pow_mem_frobPow (Ideal.mul_mem_mul ha hb)

theorem frobPow_sup (e : ℕ) (I J : Ideal R) :
    frobPow (p ^ e) (I ⊔ J) = frobPow (p ^ e) I ⊔ frobPow (p ^ e) J := by
  rw [← Ideal.span_eq I, ← Ideal.span_eq J, ← Ideal.span_union, frobPow_span, frobPow_span,
    frobPow_span, Set.image_union, Ideal.span_union]

end FrobPow

/-! ### The decomposition `f = ∑ (f_a)^q x^a` -/

section RootCoeff

variable {σ K : Type*} [Field K] (p : ℕ) [hp : Fact p.Prime] [CharP K p] [PerfectRing K p]

theorem rootCoeff_index_injective {q : ℕ} (hq : q ≠ 0) (a : σ →₀ ℕ) :
    Function.Injective (fun c : σ →₀ ℕ => q • c + a) := by
  intro c d h
  ext i
  have := DFunLike.congr_fun h i
  simp only [Finsupp.coe_add, Finsupp.coe_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul] at this
  exact Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hq) (by omega)

theorem frobExp_ne_zero (e : ℕ) : p ^ e ≠ 0 := pow_ne_zero e hp.out.ne_zero

/-- `rootCoeff p e a f` is the polynomial `f_a` with
`coeff c f_a = (coeff (p^e • c + a) f)^{1/p^e}`;
for `a` in the box `{a | ∀ i, a i < p ^ e}` these are the unique polynomials with
`f = ∑_a (f_a)^(p^e) x^a` (`sum_rootCoeff`, `rootCoeff_sum_box`). -/
def rootCoeff (e : ℕ) (a : σ →₀ ℕ) : MvPolynomial σ K →+ MvPolynomial σ K :=
  AddMonoidAlgebra.coeffAddEquiv.symm.toAddMonoidHom.comp <|
    (Finsupp.mapRange.addMonoidHom (iterateFrobeniusEquiv K p e).symm.toAddMonoidHom).comp <|
      (Finsupp.comapDomain.addMonoidHom
        (rootCoeff_index_injective (frobExp_ne_zero p e) a)).comp
          AddMonoidAlgebra.coeffAddEquiv.toAddMonoidHom

theorem coeff_rootCoeff (e : ℕ) (a : σ →₀ ℕ) (f : MvPolynomial σ K) (c : σ →₀ ℕ) :
    coeff c (rootCoeff p e a f) =
      (iterateFrobeniusEquiv K p e).symm (coeff (p ^ e • c + a) f) :=
  rfl

theorem iterateFrobeniusEquiv_symm_pow (e : ℕ) (x : K) :
    (iterateFrobeniusEquiv K p e).symm x ^ p ^ e = x := by
  rw [← iterateFrobeniusEquiv_def, RingEquiv.apply_symm_apply]

theorem iterateFrobeniusEquiv_symm_pow_mul (e : ℕ) (x y : K) :
    (iterateFrobeniusEquiv K p e).symm (x ^ p ^ e * y) =
      x * (iterateFrobeniusEquiv K p e).symm y := by
  rw [map_mul, ← iterateFrobeniusEquiv_def, RingEquiv.symm_apply_apply]

theorem rootCoeff_monomial_smul_add (e : ℕ) (a c : σ →₀ ℕ) (s : K) :
    rootCoeff p e a (monomial (p ^ e • c + a) s) =
      monomial c ((iterateFrobeniusEquiv K p e).symm s) := by
  classical
  ext d
  rw [coeff_rootCoeff, coeff_monomial, coeff_monomial]
  by_cases h : c = d
  · subst h
    simp
  · rw [if_neg ((rootCoeff_index_injective (frobExp_ne_zero p e) a).ne h), if_neg h,
      map_zero]

theorem rootCoeff_monomial_of_ne (e : ℕ) (a b : σ →₀ ℕ) (s : K)
    (h : ∀ c : σ →₀ ℕ, p ^ e • c + a ≠ b) : rootCoeff p e a (monomial b s) = 0 := by
  classical
  ext d
  rw [coeff_rootCoeff, coeff_monomial, if_neg (h d).symm, map_zero, coeff_zero]

/-- Arithmetic behind `rootCoeff_pow_mul`: if `q c + a = q u + b` with `a < q`, then `u ≤ c` and
`b = q (c - u) + a`. -/
private theorem nat_mul_add_eq_aux {q a b c u : ℕ} (ha : a < q)
    (h : q * c + a = q * u + b) : u ≤ c ∧ b = q * (c - u) + a := by
  have huc : u ≤ c := by
    by_contra h'
    push Not at h'
    nlinarith
  refine ⟨huc, ?_⟩
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le huc
  simp only [mul_add, Nat.add_sub_cancel_left] at h ⊢
  omega

/-- Semilinearity of the coefficients: `(g^q f)_a = g f_a` for `a` in the box. -/
theorem rootCoeff_pow_mul (e : ℕ) {a : σ →₀ ℕ} (ha : ∀ i, a i < p ^ e)
    (g f : MvPolynomial σ K) : rootCoeff p e a (g ^ p ^ e * f) = g * rootCoeff p e a f := by
  induction f using MvPolynomial.induction_on' with
  | monomial b s =>
    induction g using MvPolynomial.induction_on' with
    | monomial u r =>
      rw [monomial_pow, monomial_mul]
      by_cases hb : ∃ c, p ^ e • c + a = b
      · obtain ⟨c, rfl⟩ := hb
        rw [show p ^ e • u + (p ^ e • c + a) = p ^ e • (u + c) + a by rw [smul_add, add_assoc],
          rootCoeff_monomial_smul_add, rootCoeff_monomial_smul_add, monomial_mul,
          iterateFrobeniusEquiv_symm_pow_mul]
      · push Not at hb
        rw [rootCoeff_monomial_of_ne p e a b s hb, mul_zero, rootCoeff_monomial_of_ne]
        intro c hc
        apply hb (c - u)
        ext i
        have := DFunLike.congr_fun hc i
        simp only [Finsupp.coe_add, Finsupp.coe_smul, Pi.add_apply, Pi.smul_apply,
          smul_eq_mul] at this
        simp only [Finsupp.coe_add, Finsupp.coe_smul, Finsupp.coe_tsub, Pi.add_apply,
          Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
        exact (nat_mul_add_eq_aux (ha i) this).2.symm
    | add g₁ g₂ h₁ h₂ => rw [add_pow_char_pow, add_mul, map_add, h₁, h₂, add_mul]
  | add f₁ f₂ h₁ h₂ => rw [mul_add, map_add, h₁, h₂, map_add, mul_add]

end RootCoeff

/-! ### The box, the decomposition and its uniqueness -/

section Box

variable {σ K : Type*} [Field K] (p : ℕ) [hp : Fact p.Prime] [CharP K p] [PerfectRing K p]
variable [Finite σ]

/-- The exponent `(p^e - 1, …, p^e - 1)`. -/
def topExp (e : ℕ) : σ →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm fun _ => p ^ e - 1

omit hp in
@[simp]
theorem topExp_apply (e : ℕ) (i : σ) : topExp (σ := σ) p e i = p ^ e - 1 := by
  simp [topExp]

/-- The box `{a : σ →₀ ℕ | ∀ i, a i < p ^ e}` of exponents of the basis monomials of `R` over
`R^(p^e)`. -/
def box (e : ℕ) : Finset (σ →₀ ℕ) := by
  classical exact Finset.Iic (topExp p e)

theorem mem_box {e : ℕ} {a : σ →₀ ℕ} : a ∈ box p e ↔ ∀ i, a i < p ^ e := by
  classical
  have hq : 0 < p ^ e := Nat.pos_of_ne_zero (frobExp_ne_zero p e)
  simp only [box, Finset.mem_Iic, Finsupp.le_def, topExp_apply]
  exact forall_congr' fun i => by omega

theorem topExp_mem_box (e : ℕ) : topExp (σ := σ) p e ∈ box p e := by
  have hq : 0 < p ^ e := Nat.pos_of_ne_zero (frobExp_ne_zero p e)
  exact (mem_box p).2 fun i => by simp only [topExp_apply]; omega

/-- Every exponent is uniquely `q • c + a` with `a` in the box. -/
theorem exists_smul_add_mem_box (e : ℕ) (b : σ →₀ ℕ) :
    ∃ c a, a ∈ box p e ∧ p ^ e • c + a = b := by
  have hq : 0 < p ^ e := Nat.pos_of_ne_zero (frobExp_ne_zero p e)
  refine ⟨Finsupp.mapRange (· / p ^ e) (Nat.zero_div _) b,
    Finsupp.mapRange (· % p ^ e) (Nat.zero_mod _) b, (mem_box p).2 fun i => ?_, ?_⟩
  · simpa using Nat.mod_lt _ hq
  · ext i
    simp [Nat.div_add_mod]

theorem eq_of_smul_add_eq {e : ℕ} {a a' c c' : σ →₀ ℕ} (ha : a ∈ box p e) (ha' : a' ∈ box p e)
    (h : p ^ e • c + a = p ^ e • c' + a') : a = a' := by
  rw [mem_box] at ha ha'
  ext i
  have := DFunLike.congr_fun h i
  simp only [Finsupp.coe_add, Finsupp.coe_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul] at this
  have h1 := congrArg (· % p ^ e) this
  simp only [Nat.mul_add_mod, Nat.mod_eq_of_lt (ha i), Nat.mod_eq_of_lt (ha' i)] at h1
  exact h1

/-- The decomposition `f = ∑_{a ∈ box} (f_a)^q x^a` (`R` is free over `R^q` on the monomials of
the box). -/
theorem sum_rootCoeff (e : ℕ) (f : MvPolynomial σ K) :
    ∑ a ∈ box p e, rootCoeff p e a f ^ p ^ e * monomial a 1 = f := by
  induction f using MvPolynomial.induction_on' with
  | monomial b s =>
    obtain ⟨c₀, a₀, ha₀, rfl⟩ := exists_smul_add_mem_box p e b
    rw [Finset.sum_eq_single a₀]
    · rw [rootCoeff_monomial_smul_add, monomial_pow, iterateFrobeniusEquiv_symm_pow,
        monomial_mul, mul_one]
    · intro a ha hne
      rw [rootCoeff_monomial_of_ne, zero_pow (frobExp_ne_zero p e), zero_mul]
      intro c hc
      exact hne (eq_of_smul_add_eq p ha ha₀ hc)
    · intro h
      exact absurd ha₀ h
  | add f g hf hg =>
    simp only [map_add, add_pow_char_pow, add_mul, Finset.sum_add_distrib, hf, hg]

omit [Finite σ] in
theorem rootCoeff_monomial_one_self (e : ℕ) (a : σ →₀ ℕ) :
    rootCoeff p e a (monomial a (1 : K)) = 1 := by
  have := rootCoeff_monomial_smul_add (K := K) p e a 0 1
  rw [smul_zero, zero_add] at this
  rw [this, map_one (iterateFrobeniusEquiv K p e).symm, ← C_apply, C_1]

theorem rootCoeff_monomial_one_of_ne {e : ℕ} {a b : σ →₀ ℕ} (ha : a ∈ box p e)
    (hb : b ∈ box p e) (hab : a ≠ b) : rootCoeff p e a (monomial b (1 : K)) = 0 :=
  rootCoeff_monomial_of_ne p e a b 1 fun c hc =>
    hab (eq_of_smul_add_eq p ha hb (c := c) (c' := 0) (by rw [smul_zero, zero_add, hc]))

/-- Uniqueness of the decomposition: the coefficient of `x^a` in `∑_b (g_b)^q x^b` is `g_a`. -/
theorem rootCoeff_sum_box {e : ℕ} {a : σ →₀ ℕ} (ha : a ∈ box p e)
    (g : (σ →₀ ℕ) → MvPolynomial σ K) :
    rootCoeff p e a (∑ b ∈ box p e, g b ^ p ^ e * monomial b 1) = g a := by
  rw [map_sum, Finset.sum_eq_single a]
  · rw [rootCoeff_pow_mul p e ((mem_box p).1 ha), rootCoeff_monomial_one_self, mul_one]
  · intro b hb hne
    rw [rootCoeff_pow_mul p e ((mem_box p).1 ha),
      rootCoeff_monomial_one_of_ne p ha hb (Ne.symm hne), mul_zero]
  · intro h
    exact absurd ha h

/-- Uniqueness of the decomposition, in the form: any decomposition has the `rootCoeff`s as
coefficients. -/
theorem eq_rootCoeff_of_sum_eq {e : ℕ} {f : MvPolynomial σ K}
    {g : (σ →₀ ℕ) → MvPolynomial σ K} (hf : ∑ b ∈ box p e, g b ^ p ^ e * monomial b 1 = f)
    {a : σ →₀ ℕ} (ha : a ∈ box p e) : g a = rootCoeff p e a f := by
  rw [← hf, rootCoeff_sum_box p ha]

end Box

/-! ### The Frobenius trace -/

section Trace

variable {σ K : Type*} [Field K] (p : ℕ) [hp : Fact p.Prime] [CharP K p] [PerfectRing K p]
variable [Finite σ]

/-- The Frobenius trace `Φ_e f = f_{(q-1, …, q-1)}`: the map `F^e_* R → R` corresponding to the
Grothendieck trace `Tr^e : F^e_* ω_R → ω_R` under the trivialization `dx` of `ω_R`
(FHX eq. `eq:test-def`, `lem:divisorial-trace-estimate`). -/
def frobTrace (e : ℕ) : MvPolynomial σ K →+ MvPolynomial σ K :=
  rootCoeff p e (topExp p e)

theorem coeff_frobTrace (e : ℕ) (f : MvPolynomial σ K) (c : σ →₀ ℕ) :
    coeff c (frobTrace p e f) =
      (iterateFrobeniusEquiv K p e).symm (coeff (p ^ e • c + topExp p e) f) :=
  rfl

/-- `Φ_e (g^q f) = g Φ_e f`. -/
theorem frobTrace_pow_mul (e : ℕ) (g f : MvPolynomial σ K) :
    frobTrace p e (g ^ p ^ e * f) = g * frobTrace p e f :=
  rootCoeff_pow_mul p e ((mem_box p).1 (topExp_mem_box p e)) g f

theorem frobTrace_monomial_topExp (e : ℕ) :
    frobTrace p e (monomial (topExp (σ := σ) p e) (1 : K)) = 1 :=
  rootCoeff_monomial_one_self p e _

/-- `f_a = Φ_e (x^{q - 1 - a} f)`. -/
theorem rootCoeff_eq_frobTrace {e : ℕ} {a : σ →₀ ℕ} (ha : a ∈ box p e) (f : MvPolynomial σ K) :
    rootCoeff p e a f = frobTrace p e (monomial (topExp p e - a) 1 * f) := by
  rw [mem_box] at ha
  have hq : 0 < p ^ e := Nat.pos_of_ne_zero (frobExp_ne_zero p e)
  induction f using MvPolynomial.induction_on' with
  | monomial b s =>
    rw [monomial_mul, one_mul, frobTrace]
    by_cases hb : ∃ c, p ^ e • c + a = b
    · obtain ⟨c, rfl⟩ := hb
      rw [show topExp p e - a + (p ^ e • c + a) = p ^ e • c + topExp p e by
          ext i
          simp only [Finsupp.coe_add, Finsupp.coe_smul, Finsupp.coe_tsub, Pi.add_apply,
            Pi.smul_apply, Pi.sub_apply, smul_eq_mul, topExp_apply]
          have := ha i
          omega,
        rootCoeff_monomial_smul_add, rootCoeff_monomial_smul_add]
    · push Not at hb
      rw [rootCoeff_monomial_of_ne p e a b s hb, rootCoeff_monomial_of_ne]
      intro c hc
      apply hb c
      ext i
      have := DFunLike.congr_fun hc i
      simp only [Finsupp.coe_add, Finsupp.coe_smul, Finsupp.coe_tsub, Pi.add_apply,
        Pi.smul_apply, Pi.sub_apply, smul_eq_mul, topExp_apply] at this ⊢
      have := ha i
      omega
  | add f₁ f₂ h₁ h₂ => rw [map_add, h₁, h₂, mul_add, map_add]

@[simp]
theorem frobTrace_zero (f : MvPolynomial σ K) : frobTrace p 0 f = f := by
  have h0 : topExp (σ := σ) p 0 = 0 := by
    ext i
    simp
  ext c
  rw [coeff_frobTrace, h0]
  simp

/-- `Φ_{e'} ∘ Φ_e = Φ_{e + e'}`. -/
theorem frobTrace_frobTrace (e e' : ℕ) (f : MvPolynomial σ K) :
    frobTrace p e' (frobTrace p e f) = frobTrace p (e + e') f := by
  have hq : 0 < p ^ e := Nat.pos_of_ne_zero (frobExp_ne_zero p e)
  have hq' : 0 < p ^ e' := Nat.pos_of_ne_zero (frobExp_ne_zero p e')
  ext c
  rw [coeff_frobTrace, coeff_frobTrace, coeff_frobTrace, ← iterateFrobeniusEquiv_symm_add_apply,
    add_comm e' e]
  congr 2
  ext i
  simp only [Finsupp.coe_add, Finsupp.coe_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
    topExp_apply, pow_add]
  obtain ⟨u, hu⟩ := Nat.exists_eq_add_of_lt hq
  obtain ⟨v, hv⟩ := Nat.exists_eq_add_of_lt hq'
  rw [hu, hv]
  simp only [zero_add, Nat.add_sub_cancel]
  ring_nf
  omega

end Trace

/-! ### Frobenius roots -/

section Root

variable {σ K : Type*} [Field K] (p : ℕ) [hp : Fact p.Prime] [CharP K p] [PerfectRing K p]
variable [Finite σ]

/-- The Frobenius root `I^[1/p^e]`, defined as the image `Φ_e '' I` of `I` under the Frobenius
trace (an ideal by `frobTrace_pow_mul`). By `frobRoot_le_iff` it is the smallest ideal `J` with
`I ≤ J^[p^e]`, and by `frobRoot_eq_span` it is generated by the coefficients `f_a`, `f ∈ I`. -/
def frobRoot (e : ℕ) (I : Ideal (MvPolynomial σ K)) : Ideal (MvPolynomial σ K) where
  carrier := frobTrace p e '' I
  add_mem' := by
    rintro _ _ ⟨f, hf, rfl⟩ ⟨g, hg, rfl⟩
    exact ⟨f + g, I.add_mem hf hg, map_add _ _ _⟩
  zero_mem' := ⟨0, I.zero_mem, map_zero _⟩
  smul_mem' := by
    rintro c _ ⟨f, hf, rfl⟩
    exact ⟨c ^ p ^ e * f, I.mul_mem_left _ hf, frobTrace_pow_mul p e c f⟩

theorem coe_frobRoot (e : ℕ) (I : Ideal (MvPolynomial σ K)) :
    (frobRoot p e I : Set (MvPolynomial σ K)) = frobTrace p e '' I :=
  rfl

theorem mem_frobRoot {e : ℕ} {I : Ideal (MvPolynomial σ K)} {f : MvPolynomial σ K} :
    f ∈ frobRoot p e I ↔ ∃ g ∈ I, frobTrace p e g = f :=
  Iff.rfl

theorem frobTrace_mem_frobRoot {e : ℕ} {I : Ideal (MvPolynomial σ K)} {f : MvPolynomial σ K}
    (hf : f ∈ I) : frobTrace p e f ∈ frobRoot p e I :=
  ⟨f, hf, rfl⟩

theorem rootCoeff_mem_frobRoot {e : ℕ} {I : Ideal (MvPolynomial σ K)} {f : MvPolynomial σ K}
    (hf : f ∈ I) {a : σ →₀ ℕ} (ha : a ∈ box p e) : rootCoeff p e a f ∈ frobRoot p e I := by
  rw [rootCoeff_eq_frobTrace p ha]
  exact frobTrace_mem_frobRoot p (I.mul_mem_left _ hf)

/-- `Φ_e` maps `J^[q]` into `J`. -/
theorem frobTrace_mem_of_mem_frobPow {e : ℕ} {J : Ideal (MvPolynomial σ K)}
    {f : MvPolynomial σ K} (hf : f ∈ frobPow (p ^ e) J) : frobTrace p e f ∈ J := by
  suffices h : ∀ r, frobTrace p e (r * f) ∈ J by simpa using h 1
  induction hf using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨g, hg, rfl⟩ := hx
    intro r
    rw [mul_comm, frobTrace_pow_mul]
    exact J.mul_mem_right _ hg
  | zero => intro r; rw [mul_zero, map_zero]; exact J.zero_mem
  | add x y _ _ hx hy => intro r; rw [mul_add, map_add]; exact J.add_mem (hx r) (hy r)
  | smul a x _ hx => intro r; rw [smul_eq_mul, ← mul_assoc]; exact hx (r * a)

/-- The adjunction `I^[1/q] ≤ J ↔ I ≤ J^[q]`. -/
theorem frobRoot_le_iff {e : ℕ} {I J : Ideal (MvPolynomial σ K)} :
    frobRoot p e I ≤ J ↔ I ≤ frobPow (p ^ e) J := by
  constructor
  · intro h f hf
    rw [← sum_rootCoeff p e f]
    refine Ideal.sum_mem _ fun a ha => Ideal.mul_mem_right _ _ (pow_mem_frobPow ?_)
    exact h (rootCoeff_mem_frobRoot p hf ha)
  · rintro h _ ⟨f, hf, rfl⟩
    exact frobTrace_mem_of_mem_frobPow p (h hf)

/-- Frobenius roots are left adjoint to Frobenius powers. -/
theorem gc_frobRoot_frobPow (e : ℕ) :
    GaloisConnection (frobRoot (σ := σ) (K := K) p e) (frobPow (p ^ e)) :=
  fun _ _ => frobRoot_le_iff p

theorem frobRoot_mono (e : ℕ) : Monotone (frobRoot (σ := σ) (K := K) p e) :=
  (gc_frobRoot_frobPow p e).monotone_l

theorem le_frobPow_frobRoot (e : ℕ) (I : Ideal (MvPolynomial σ K)) :
    I ≤ frobPow (p ^ e) (frobRoot p e I) :=
  (gc_frobRoot_frobPow p e).le_u_l I

/-- `I^[1/q]` is the smallest ideal `J` with `I ≤ J^[q]`. -/
theorem isLeast_frobRoot (e : ℕ) (I : Ideal (MvPolynomial σ K)) :
    IsLeast {J | I ≤ frobPow (p ^ e) J} (frobRoot p e I) :=
  ⟨le_frobPow_frobRoot p e I, fun _ hJ => (frobRoot_le_iff p).2 hJ⟩

/-- `I^[1/q]` is generated by the coefficients `f_a` of the elements `f ∈ I`. -/
theorem frobRoot_eq_span (e : ℕ) (I : Ideal (MvPolynomial σ K)) :
    frobRoot p e I = Ideal.span {g | ∃ f ∈ I, ∃ a ∈ box p e, rootCoeff p e a f = g} := by
  apply le_antisymm
  · rw [frobRoot_le_iff]
    intro f hf
    rw [← sum_rootCoeff p e f]
    exact Ideal.sum_mem _ fun a ha =>
      Ideal.mul_mem_right _ _ (pow_mem_frobPow (Ideal.subset_span ⟨f, hf, a, ha, rfl⟩))
  · rw [Ideal.span_le]
    rintro _ ⟨f, hf, a, ha, rfl⟩
    exact rootCoeff_mem_frobRoot p hf ha

/-- The root of an ideal given by generators is generated by the coefficients of the generators. -/
theorem frobRoot_span (e : ℕ) (S : Set (MvPolynomial σ K)) :
    frobRoot p e (Ideal.span S) =
      Ideal.span {g | ∃ f ∈ S, ∃ a ∈ box p e, rootCoeff p e a f = g} := by
  apply le_antisymm
  · rw [frobRoot_le_iff, Ideal.span_le]
    intro f hf
    rw [SetLike.mem_coe, ← sum_rootCoeff p e f]
    exact Ideal.sum_mem _ fun a ha =>
      Ideal.mul_mem_right _ _ (pow_mem_frobPow (Ideal.subset_span ⟨f, hf, a, ha, rfl⟩))
  · rw [Ideal.span_le]
    rintro _ ⟨f, hf, a, ha, rfl⟩
    exact rootCoeff_mem_frobRoot p (Ideal.subset_span hf) ha

@[simp]
theorem frobRoot_zero (I : Ideal (MvPolynomial σ K)) : frobRoot p 0 I = I := by
  ext f
  simp [mem_frobRoot]

@[simp]
theorem frobRoot_bot (e : ℕ) : frobRoot p e (⊥ : Ideal (MvPolynomial σ K)) = ⊥ :=
  (gc_frobRoot_frobPow p e).l_bot

/-- `(J^[q])^[1/q] = J`. -/
@[simp]
theorem frobRoot_frobPow (e : ℕ) (J : Ideal (MvPolynomial σ K)) :
    frobRoot p e (frobPow (p ^ e) J) = J := by
  refine le_antisymm ((gc_frobRoot_frobPow p e).l_u_le J) fun g hg => ?_
  refine ⟨g ^ p ^ e * monomial (topExp p e) 1, Ideal.mul_mem_right _ _ (pow_mem_frobPow hg), ?_⟩
  rw [frobTrace_pow_mul, frobTrace_monomial_topExp, mul_one]

@[simp]
theorem frobRoot_top (e : ℕ) : frobRoot p e (⊤ : Ideal (MvPolynomial σ K)) = ⊤ := by
  simpa using frobRoot_frobPow (K := K) (σ := σ) p e ⊤

theorem frobRoot_sup (e : ℕ) (I J : Ideal (MvPolynomial σ K)) :
    frobRoot p e (I ⊔ J) = frobRoot p e I ⊔ frobRoot p e J :=
  (gc_frobRoot_frobPow p e).l_sup

theorem frobRoot_iSup (e : ℕ) {ι : Sort*} (I : ι → Ideal (MvPolynomial σ K)) :
    frobRoot p e (⨆ i, I i) = ⨆ i, frobRoot p e (I i) :=
  (gc_frobRoot_frobPow p e).l_iSup

/-- `(I J^[q])^[1/q] = I^[1/q] J`. -/
theorem frobRoot_mul_frobPow (e : ℕ) (I J : Ideal (MvPolynomial σ K)) :
    frobRoot p e (I * frobPow (p ^ e) J) = frobRoot p e I * J := by
  apply le_antisymm
  · rw [frobRoot_le_iff, frobPow_mul]
    exact Ideal.mul_mono_left (le_frobPow_frobRoot p e I)
  · rw [Ideal.mul_le]
    rintro _ ⟨f, hf, rfl⟩ g hg
    refine ⟨g ^ p ^ e * f, ?_, ?_⟩
    · rw [mul_comm (g ^ p ^ e) f]
      exact Ideal.mul_mem_mul hf (pow_mem_frobPow hg)
    · rw [frobTrace_pow_mul, mul_comm]

/-- `(I J)^[1/q] ≤ I^[1/q] J^[1/q]`. -/
theorem frobRoot_mul_le (e : ℕ) (I J : Ideal (MvPolynomial σ K)) :
    frobRoot p e (I * J) ≤ frobRoot p e I * frobRoot p e J := by
  rw [frobRoot_le_iff, frobPow_mul]
  exact Ideal.mul_mono (le_frobPow_frobRoot p e I) (le_frobPow_frobRoot p e J)

/-- `(I^[1/q])^[1/q'] = I^[1/(q q')]`. -/
theorem frobRoot_frobRoot (e e' : ℕ) (I : Ideal (MvPolynomial σ K)) :
    frobRoot p e' (frobRoot p e I) = frobRoot p (e + e') I := by
  ext f
  simp only [mem_frobRoot]
  constructor
  · rintro ⟨_, ⟨g, hg, rfl⟩, rfl⟩
    exact ⟨g, hg, (frobTrace_frobTrace p e e' g).symm⟩
  · rintro ⟨g, hg, rfl⟩
    exact ⟨frobTrace p e g, ⟨g, hg, rfl⟩, frobTrace_frobTrace p e e' g⟩

/-- If `0 ≠ g` has total degree `< q`, then `(g)^[1/q] = R`. -/
theorem frobRoot_span_singleton_eq_top {e : ℕ} {g : MvPolynomial σ K} (hg : g ≠ 0)
    (hdeg : g.totalDegree < p ^ e) : frobRoot p e (Ideal.span {g}) = ⊤ := by
  obtain ⟨b, hb⟩ := ne_zero_iff.1 hg
  have hbs : b ∈ g.support := mem_support_iff.2 hb
  have hbdeg : (b.sum fun _ e => e) ≤ g.totalDegree := le_totalDegree hbs
  have hbox : b ∈ box p e := by
    refine (mem_box p).2 fun i => lt_of_le_of_lt (le_trans ?_ hbdeg) hdeg
    by_cases hi : i ∈ b.support
    · exact Finset.single_le_sum (f := fun j => b j) (fun _ _ => Nat.zero_le _) hi
    · rw [Finsupp.notMem_support_iff.1 hi]
      exact Nat.zero_le _
  have hC : rootCoeff p e b g = C ((iterateFrobeniusEquiv K p e).symm (coeff b g)) := by
    classical
    ext c
    rw [coeff_rootCoeff, coeff_C]
    split_ifs with hc
    · subst hc
      simp
    · rw [coeff_eq_zero_of_totalDegree_lt, map_zero]
      refine lt_of_lt_of_le hdeg ?_
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.1 (Ne.symm hc)
      have h1 : p ^ e ≤ (p ^ e • c + b) i := by
        simp only [Finsupp.coe_add, Finsupp.coe_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
        have : 1 ≤ c i := Nat.one_le_iff_ne_zero.2 (by simpa using hi)
        nlinarith
      refine le_trans h1 ?_
      exact Finset.single_le_sum (f := fun j => (p ^ e • c + b) j) (fun _ _ => Nat.zero_le _)
        (Finsupp.mem_support_iff.2 (by omega))
  refine Ideal.eq_top_of_isUnit_mem _ (rootCoeff_mem_frobRoot p (Ideal.mem_span_singleton_self g)
    hbox) ?_
  rw [hC]
  exact (IsUnit.mk0 _ (by simpa using hb)).map C

end Root

end EnvelopeProperty
