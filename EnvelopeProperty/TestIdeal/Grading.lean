import EnvelopeProperty.TestIdeal.FrobeniusRoot

/-!
# Frobenius roots of weighted homogeneous ideals

Let `w : σ → ℕ` be a weight on the variables of `R = K[x_i : i ∈ σ]` (for `S = ℙⁿ × 𝔸¹` one takes
`w = 1` on `x_0, …, x_n` and `w = 0` on `t`, so that the `w`-degree is the `x`-degree). If `f` is
`w`-homogeneous of degree `d`, the coefficient `f_a` of `x^a` in `f = ∑ (f_a)^q x^a` is
`w`-homogeneous of degree `(d - w(a)) / q` (`isWeightedHomogeneous_rootCoeff`). Consequently:

* `HasWeightedGeneratorsLE.frobRoot`: if `I` is generated by `w`-homogeneous polynomials of degree
  `≤ D`, then `I^[1/q]` is generated by `w`-homogeneous polynomials of degree `≤ ⌊D / q⌋`;
* `isHomogeneous_frobRoot`: Frobenius roots of `w`-homogeneous ideals are `w`-homogeneous.

This degree bound is what makes the uniform generation statement FHX Lemma 3.2
(`lem:smooth-uniform-twist`) elementary for `X = ℙⁿ`. We also record that the predicate
`HasWeightedGeneratorsLE` is stable under products and powers (with additive degree bounds), and
that it is equivalent, without a degree bound, to `Ideal.IsHomogeneous` for the weighted grading
`MvPolynomial.weightedGradedAlgebra`.
-/

open MvPolynomial
open scoped Pointwise

noncomputable section

namespace EnvelopeProperty

attribute [local instance] MvPolynomial.weightedGradedAlgebra

variable {σ K : Type*} [Field K]

/-- `I` is generated by `w`-homogeneous polynomials of `w`-degree at most `D`. -/
def HasWeightedGeneratorsLE (w : σ → ℕ) (D : ℕ) (I : Ideal (MvPolynomial σ K)) : Prop :=
  ∃ T : Set (MvPolynomial σ K), I = Ideal.span T ∧ ∀ g ∈ T, ∃ d ≤ D, IsWeightedHomogeneous w g d

namespace HasWeightedGeneratorsLE

variable {w : σ → ℕ}

theorem mono {D D' : ℕ} {I : Ideal (MvPolynomial σ K)} (h : HasWeightedGeneratorsLE w D I)
    (hD : D ≤ D') : HasWeightedGeneratorsLE w D' I := by
  obtain ⟨T, rfl, hT⟩ := h
  exact ⟨T, rfl, fun g hg => (hT g hg).imp fun d hd => ⟨hd.1.trans hD, hd.2⟩⟩

theorem span {D : ℕ} {S : Set (MvPolynomial σ K)}
    (hS : ∀ g ∈ S, ∃ d ≤ D, IsWeightedHomogeneous w g d) :
    HasWeightedGeneratorsLE w D (Ideal.span S) :=
  ⟨S, rfl, hS⟩

theorem top : HasWeightedGeneratorsLE w 0 (⊤ : Ideal (MvPolynomial σ K)) :=
  ⟨{1}, Ideal.span_singleton_one.symm, fun g hg => ⟨0, le_rfl, by
    rw [Set.mem_singleton_iff.1 hg]
    exact isWeightedHomogeneous_one K w⟩⟩

theorem mul {D₁ D₂ : ℕ} {I J : Ideal (MvPolynomial σ K)} (hI : HasWeightedGeneratorsLE w D₁ I)
    (hJ : HasWeightedGeneratorsLE w D₂ J) : HasWeightedGeneratorsLE w (D₁ + D₂) (I * J) := by
  obtain ⟨T₁, rfl, h₁⟩ := hI
  obtain ⟨T₂, rfl, h₂⟩ := hJ
  refine ⟨T₁ * T₂, Ideal.span_mul_span' T₁ T₂, ?_⟩
  rintro _ ⟨a, ha, b, hb, rfl⟩
  obtain ⟨d₁, hd₁, ha'⟩ := h₁ a ha
  obtain ⟨d₂, hd₂, hb'⟩ := h₂ b hb
  exact ⟨d₁ + d₂, add_le_add hd₁ hd₂, ha'.mul hb'⟩

theorem pow {D : ℕ} {I : Ideal (MvPolynomial σ K)} (hI : HasWeightedGeneratorsLE w D I) :
    ∀ n : ℕ, HasWeightedGeneratorsLE w (n * D) (I ^ n)
  | 0 => by
    rw [pow_zero, zero_mul, Ideal.one_eq_top]
    exact top
  | n + 1 => by
    rw [pow_succ, add_mul, one_mul]
    exact (pow hI n).mul hI

theorem isHomogeneous {D : ℕ} {I : Ideal (MvPolynomial σ K)}
    (h : HasWeightedGeneratorsLE w D I) : I.IsHomogeneous (weightedHomogeneousSubmodule K w) := by
  obtain ⟨T, rfl, hT⟩ := h
  refine Ideal.homogeneous_span _ _ fun g hg => ?_
  obtain ⟨d, -, hd⟩ := hT g hg
  exact ⟨d, (mem_weightedHomogeneousSubmodule K w d g).2 hd⟩

end HasWeightedGeneratorsLE

/-- A `w`-homogeneous ideal is generated by `w`-homogeneous polynomials. -/
theorem exists_span_of_isHomogeneous {w : σ → ℕ} {I : Ideal (MvPolynomial σ K)}
    (hI : I.IsHomogeneous (weightedHomogeneousSubmodule K w)) :
    ∃ T : Set (MvPolynomial σ K), I = Ideal.span T ∧ ∀ g ∈ T, ∃ d, IsWeightedHomogeneous w g d := by
  obtain ⟨S, hS⟩ := (Ideal.IsHomogeneous.iff_exists _ I).1 hI
  refine ⟨Subtype.val '' S, hS, ?_⟩
  rintro _ ⟨⟨g, ⟨d, hd⟩⟩, -, rfl⟩
  exact ⟨d, (mem_weightedHomogeneousSubmodule K w d g).1 hd⟩

variable (p : ℕ) [hp : Fact p.Prime] [CharP K p] [PerfectRing K p]

/-- If `f` is `w`-homogeneous of degree `d`, then `f_a` is `w`-homogeneous of degree
`(d - w(a)) / p^e`. -/
theorem isWeightedHomogeneous_rootCoeff {w : σ → ℕ} {f : MvPolynomial σ K} {d : ℕ}
    (hf : IsWeightedHomogeneous w f d) (e : ℕ) (a : σ →₀ ℕ) :
    IsWeightedHomogeneous w (rootCoeff p e a f) ((d - Finsupp.weight w a) / p ^ e) := by
  intro c hc
  rw [coeff_rootCoeff] at hc
  have hc' : coeff (p ^ e • c + a) f ≠ 0 := fun h => hc (by rw [h, map_zero])
  have := hf hc'
  rw [map_add, map_nsmul, smul_eq_mul] at this
  rw [← this, Nat.add_sub_cancel, Nat.mul_div_cancel_left _
    (Nat.pos_of_ne_zero (frobExp_ne_zero p e))]

variable [Finite σ]

/-- If `I` is generated by `w`-homogeneous polynomials of degree `≤ D`, then `I^[1/p^e]` is
generated by `w`-homogeneous polynomials of degree `≤ D / p^e` (floor). -/
theorem HasWeightedGeneratorsLE.frobRoot {w : σ → ℕ} {D : ℕ} {I : Ideal (MvPolynomial σ K)}
    (hI : HasWeightedGeneratorsLE w D I) (e : ℕ) :
    HasWeightedGeneratorsLE w (D / p ^ e) (frobRoot p e I) := by
  obtain ⟨S, rfl, hS⟩ := hI
  rw [frobRoot_span]
  refine HasWeightedGeneratorsLE.span ?_
  rintro _ ⟨f, hf, a, -, rfl⟩
  obtain ⟨d, hd, hfd⟩ := hS f hf
  exact ⟨_, Nat.div_le_div_right ((Nat.sub_le _ _).trans hd),
    isWeightedHomogeneous_rootCoeff p hfd e a⟩

/-- Frobenius roots of `w`-homogeneous ideals are `w`-homogeneous. -/
theorem isHomogeneous_frobRoot {w : σ → ℕ} {I : Ideal (MvPolynomial σ K)}
    (hI : I.IsHomogeneous (weightedHomogeneousSubmodule K w)) (e : ℕ) :
    (frobRoot p e I).IsHomogeneous (weightedHomogeneousSubmodule K w) := by
  obtain ⟨S, rfl, hS⟩ := exists_span_of_isHomogeneous hI
  rw [frobRoot_span]
  refine Ideal.homogeneous_span _ _ ?_
  rintro _ ⟨f, hf, a, -, rfl⟩
  obtain ⟨d, hfd⟩ := hS f hf
  exact ⟨_, (mem_weightedHomogeneousSubmodule K w _ _).2
    (isWeightedHomogeneous_rootCoeff p hfd e a)⟩

end EnvelopeProperty
