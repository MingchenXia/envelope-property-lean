import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.BlowupExistenceOriginModel
import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.BlowupFlatCoordinates

set_option autoImplicit false
set_option linter.unusedSectionVars false

/-!
# The ideal of the origin in `ℂᵈ`, and its pullbacks

Preparation for `AnalyticGeometry.BlowupExistenceOriginUniversal`, which proves that the model blowup of
`AnalyticGeometry.BlowupExistenceOriginModel` satisfies the universal property of
`Pluripotential.BlowupSequences.IsBlowupAlong`.  Collected here:

* `zero_eq_complexCoordinatePlane`, `isClosedSubmanifold_zero`, `interior_zero_eq_empty`: the
  origin is a nowhere dense closed complex submanifold of `ℂᵈ` when `d ≥ 1`;
* `coordFun_mem_vanishingIdeal`, `exists_eq_sum_coordFun`: the ideal `𝓘_0` is generated at the
  origin by the `d` coordinate functions (Hadamard, via
  `AnalyticGeometry.CoordinatePlaneDivision.exists_eq_sum_coord_mul`), and is the unit ideal elsewhere;
* `mem_pullback_vanishingIdeal_zero_iff`: therefore the pullback `g* 𝓘_0` along a holomorphic
  `g : Z → ℂᵈ` is generated by the `d` components of `g`.
-/

open Set Filter
open scoped Topology Manifold ContDiff

namespace ComplexGeometry.AnalyticGeometry.BlowupExistenceOriginIdeal

open Pluripotential Pluripotential.HolomorphicIdealSheaves Pluripotential.BlowupSequences

noncomputable section

variable {d : ℕ}

/-! ### The origin as a submanifold -/

theorem zero_eq_complexCoordinatePlane :
    ({0} : Set (ComplexModel d)) = complexCoordinatePlane d 0 := by
  ext z
  constructor
  · rintro rfl
    intro i _
    simp
  · intro h
    show z = 0
    ext i
    exact h i (Nat.zero_le _)

/-- The identity, as a local biholomorphism at the origin. -/
def idEquivAt : LocalHolomorphicEquivAt (n := d) (0 : ComplexModel d) where
  source := univ
  target := univ
  isOpen_source := isOpen_univ
  isOpen_target := isOpen_univ
  center_mem_source := mem_univ _
  toFun := id
  invFun := id
  toFun_holomorphic := differentiable_id.differentiableOn
  invFun_holomorphic := differentiable_id.differentiableOn
  mapsTo_toFun := mapsTo_univ _ _
  mapsTo_invFun := mapsTo_univ _ _
  left_inv := fun _ _ => rfl
  right_inv := fun _ _ => rfl

theorem regularAtDim_zero : RegularAtDim (n := d) ({0} : Set (ComplexModel d)) 0 0 := by
  refine ⟨Nat.zero_le _, rfl, idEquivAt, subset_univ _, rfl, ?_⟩
  intro y _ _
  rw [zero_eq_complexCoordinatePlane (d := d)]
  exact Iff.rfl

theorem isClosedSubmanifold_zero :
    IsClosedSubmanifold d ({0} : Set (ComplexModel d)) :=
  ⟨isClosed_singleton, fun x hx => by rw [mem_singleton_iff.mp hx]; exact ⟨0, regularAtDim_zero⟩⟩

theorem nontrivial_complexModel (hd : 0 < d) : Nontrivial (ComplexModel d) := by
  refine ⟨0, EuclideanSpace.single ⟨0, hd⟩ (1 : ℂ), fun h => ?_⟩
  have := congrArg (fun z : ComplexModel d => z ⟨0, hd⟩) h
  simp at this

theorem interior_zero_eq_empty (hd : 0 < d) :
    interior ({0} : Set (ComplexModel d)) = ∅ := by
  have := nontrivial_complexModel hd
  have h := (dense_compl_singleton (0 : ComplexModel d)).interior_compl
  rwa [compl_compl] at h

/-! ### The ideal of the origin -/

/-- The `i`-th coordinate function on `ℂᵈ`. -/
def coordFun (i : Fin d) : ComplexModel d → ℂ := fun z => z i

theorem holomorphicAt_coordFun (i : Fin d) (q : ComplexModel d) :
    HolomorphicAt d (coordFun i) q :=
  Eventually.of_forall fun _ =>
    (EuclideanSpace.proj i : ComplexModel d →L[ℂ] ℂ).differentiableAt.mdifferentiableAt

theorem coordFun_mem_vanishingIdeal (i : Fin d) (q : ComplexModel d) :
    (vanishingIdeal (n := d) ({0} : Set (ComplexModel d))).mem q (coordFun i) := by
  refine ⟨holomorphicAt_coordFun i q, Eventually.of_forall fun y hy => ?_⟩
  rw [mem_singleton_iff.mp hy]
  simp [coordFun]

/-- **Hadamard's lemma at the origin.**  A germ vanishing at `0` is a holomorphic combination
of the coordinate functions. -/
theorem exists_eq_sum_coordFun {a : ComplexModel d → ℂ}
    (ha : (vanishingIdeal (n := d) ({0} : Set (ComplexModel d))).mem 0 a) :
    ∃ H : Fin d → ComplexModel d → ℂ, (∀ i, HolomorphicAt d (H i) 0) ∧
      a =ᶠ[𝓝 0] fun z => ∑ i, coordFun i z * H i z := by
  have hq : (0 : ComplexModel d) ∈ complexCoordinatePlane d 0 := by
    rw [← zero_eq_complexCoordinatePlane]; rfl
  have hFd : ∀ᶠ u in 𝓝 (0 : ComplexModel d), DifferentiableAt ℂ a u := by
    filter_upwards [ha.1] with u hu
    exact mdifferentiableAt_iff_differentiableAt.mp hu
  have hFvan : ∀ᶠ u in 𝓝 (0 : ComplexModel d), u ∈ complexCoordinatePlane d 0 → a u = 0 := by
    filter_upwards [ha.2] with u hu hplane
    exact hu (by rw [zero_eq_complexCoordinatePlane]; exact hplane)
  obtain ⟨H, -, hHd, hHeq⟩ :=
    CoordinatePlaneDivision.exists_eq_sum_coord_mul (n := d) d 0 (by omega) hq hFd hFvan
  exact ⟨H, fun i => (hHd i).mono fun u hu => hu.mdifferentiableAt, hHeq⟩

/-! ### Pullbacks -/

variable {m : ℕ} {Z : Type*} [TopologicalSpace Z] [ChartedSpace (ComplexModel m) Z]
  [IsComplexManifold m Z]

/-- The `i`-th component of a map into `ℂᵈ`. -/
def compFun (g : Z → ComplexModel d) (i : Fin d) : Z → ℂ := fun y => g y i

theorem holomorphicAt_compFun {g : Z → ComplexModel d}
    (hg : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel d) ∞ g) (i : Fin d) (z : Z) :
    HolomorphicAt m (compFun g i) z :=
  (holomorphicAt_coordFun i (g z)).comp_contMDiff (Eventually.of_forall fun y => hg y)

/-- Each component of `g` lies in the pullback ideal `g* 𝓘_0`. -/
theorem compFun_mem_pullback {g : Z → ComplexModel d}
    (hg : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel d) ∞ g) (i : Fin d) (z : Z) :
    (GermIdeal.pullback (m := m) g
      (vanishingIdeal (n := d) ({0} : Set (ComplexModel d)))).mem z (compFun g i) :=
  isInSpanAt_of_eq_mul
    (S := fun s => ∃ a, (vanishingIdeal (n := d) ({0} : Set (ComplexModel d))).mem (g z) a ∧
      s = a ∘ g)
    (s := compFun g i) (a := fun _ => 1)
    ⟨coordFun i, coordFun_mem_vanishingIdeal i (g z), rfl⟩
    (holomorphicAt_compFun hg i z) (holomorphicAt_const 1)
    (Eventually.of_forall fun _ => (one_mul _).symm)

/-- Over a point of the centre, every element of the pullback ideal is a holomorphic
combination of the components of `g`. -/
theorem exists_eq_sum_compFun_of_mem_pullback {g : Z → ComplexModel d}
    (hg : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel d) ∞ g) {z : Z} (hz : g z = 0)
    {f : Z → ℂ}
    (hf : (GermIdeal.pullback (m := m) g
      (vanishingIdeal (n := d) ({0} : Set (ComplexModel d)))).mem z f) :
    ∃ c : Fin d → Z → ℂ, (∀ i, HolomorphicAt m (c i) z) ∧
      f =ᶠ[𝓝 z] fun y => ∑ i, compFun g i y * c i y := by
  classical
  obtain ⟨-, N, s, a, hs, ha, hsum⟩ := hf
  -- each generator `s t = b t ∘ g` is a combination of the components of `g`
  have hgen : ∀ t : Fin N, ∃ H : Fin d → Z → ℂ, (∀ i, HolomorphicAt m (H i) z) ∧
      s t =ᶠ[𝓝 z] fun y => ∑ i, compFun g i y * H i y := by
    intro t
    obtain ⟨a', hb, hsb⟩ := hs t
    rw [hz] at hb
    obtain ⟨H, hH, hHeq⟩ := exists_eq_sum_coordFun hb
    have hH' : ∀ i, HolomorphicAt d (H i) (g z) := fun i => by rw [hz]; exact hH i
    refine ⟨fun i => fun y => H i (g y), fun i =>
      (hH' i).comp_contMDiff (Eventually.of_forall fun y => hg y), ?_⟩
    have hgz : ContinuousAt g z := (hg z).continuousAt
    have hHeq' : ∀ᶠ u in 𝓝 (g z), a' u = ∑ i, coordFun i u * H i u := by
      rw [hz]; exact hHeq
    filter_upwards [hgz.eventually hHeq'] with y hy
    rw [hsb]
    exact hy
  choose H hH hHeq using hgen
  refine ⟨fun i => fun y => ∑ t, a t y * H t i y,
    fun i => HolomorphicAt.sum _ fun t _ => (ha t).mul (hH t i), ?_⟩
  have hall : ∀ᶠ y in 𝓝 z, ∀ t, s t y = ∑ i, compFun g i y * H t i y :=
    eventually_all.mpr fun t => hHeq t
  filter_upwards [hsum, hall] with y hy hy'
  rw [hy]
  calc ∑ t, a t y * s t y
      = ∑ t, ∑ i, a t y * (compFun g i y * H t i y) := by
        refine Finset.sum_congr rfl fun t _ => ?_
        rw [hy' t, Finset.mul_sum]
    _ = ∑ i, compFun g i y * ∑ t, a t y * H t i y := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun t _ => by ring

/-! ### Smoothness of maps into `ℂᵈ` given coordinatewise -/

theorem contMDiffAt_toLp {φ : Fin d → Z → ℂ} {z : Z}
    (hφ : ∀ i, ContMDiffAt 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ℂ) ∞ (φ i) z) :
    ContMDiffAt 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel d) ∞
      (fun y => (WithLp.toLp 2 fun i => φ i y : ComplexModel d)) z := by
  have h : ContMDiffAt 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, Fin d → ℂ) ∞ (fun y i => φ i y) z :=
    contMDiffAt_pi_space.2 hφ
  have hL := ((PiLp.continuousLinearEquiv 2 ℂ (fun _ : Fin d => ℂ)).symm.toContinuousLinearMap
    |>.contMDiff (n := ∞)) (fun i => φ i z)
  exact hL.comp z h

/-- A holomorphic germ is `C^∞` at the point. -/
theorem HolomorphicAt.contMDiffAt {f : Z → ℂ} {z : Z} (hf : HolomorphicAt m f z) :
    ContMDiffAt 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ℂ) ∞ f z :=
  contMDiffAt_of_eventually_mdifferentiableAt hf

end

end ComplexGeometry.AnalyticGeometry.BlowupExistenceOriginIdeal
