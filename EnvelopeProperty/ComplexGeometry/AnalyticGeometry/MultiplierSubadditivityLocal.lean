import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.MultiplierSubadditivityColumns
import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.MultiplierIdealBergmanNadelIdeal
import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.MultiplierIdeals

set_option autoImplicit false

/-!
# Subadditivity of multiplier ideals on `ℂᵈ` (Demailly--Ein--Lazarsfeld)

Source: Demailly--Ein--Lazarsfeld, *A subadditivity property of multiplier ideals*, Michigan
Math. J. **48** (2000), Theorem 2.6 (local form), cited by the regularization construction as the subadditivity
(,
the positive current):

  `𝓘(φ₁ + φ₂)_x ⊆ 𝓘(φ₁)_x · 𝓘(φ₂)_x`.

`inGermSpan_mul_of_multiplierIntegrableAt` proves it for `P₁, P₂` plurisubharmonic near `x ∈ ℂ^d`:
a germ `f` with `|f|² e^{-(P₁+P₂)}` integrable near `x` is, near `x`, a holomorphic combination of
products `a b` with `|a|² e^{-P₁}` and `|b|² e^{-P₂}` integrable near `x`.

## The proof (step 5 of our route to the DEL00 subadditivity theorem)

DEL prove `𝓗(B × B, e^{-P₁ ⊕ P₂}) = 𝓗(B, e^{-P₁}) ⊗̂ 𝓗(B, e^{-P₂})` (Hilbert tensor product) and
then use Nadel's ideal identity. This module replaces the Hilbert tensor product by Taylor
coefficients and Krull's intersection theorem, both already in the tree:

1. Ohsawa--Takegoshi from the diagonal gives `G` holomorphic on `B × B` with `G(y, y) = f(y)` and
   `∫∫ |G(a,b)|² e^{-P₁(a)} e^{-P₂(b)} < ∞` (`MultiplierSubadditivityTools.exists_productExtension`).
2. Let `J ⊆ 𝒪_{ℂ^{2d}, (x,x)}` be the ideal generated by the products `a(z) b(w)`. For every `K`, the
   matrix of torus coefficients `C_{αβ}` of `G` at `(x,x)`, `α, β ∈ [0,K)^d`, has every column in
   the space `A` of coefficient vectors of germs of `𝓘(P₁)_x` and every row in the space `B` for
   `𝓘(P₂)_x` (`MultiplierSubadditivityColumns`; `TorusCoefficientsProduct.torusCoeff_join`). So
   `C = ∑ₖ aₖ bₖᵀ` with `aₖ ∈ A`, `bₖ ∈ B` (`exists_sum_mul_of_cols_rows`), and
   `h = ∑ₖ aₖ(z) bₖ(w) ∈ J` has the same coefficients as `G` in `[0,K)^{2d}`
   (`torusCoeff_join_mul`). Krull's intersection theorem in `𝒪_{ℂ^{2d},(x,x)}`
   (`germKrullIntersection`) gives `G ∈ J`.
3. Restricting to the diagonal, `f(y) = G(y, y)` lies in the germ span of the products `a b`.

The dimension is written `d = d' + 1` (the torus coefficients are stated on `ℂ^{m+1}`).
-/

open Set Filter MeasureTheory Metric Complex
open scoped Topology Real ENNReal

namespace ComplexGeometry.AnalyticGeometry.MultiplierSubadditivityLocal

noncomputable section

open Pluripotential BergmanSubadditivity MultiplierSubadditivityTools MultiplierSubadditivityColumns
  TorusCoefficientsProduct MultiplierIdealBergmanNadelIdeal MultiplierIdealBergmanNadelVanishing

variable {d' : ℕ}

/-- `exists_productExtension` for any Borel structure on `ℂ^d`. -/
theorem exists_productExtension' {d : ℕ} [i : MeasurableSpace (ComplexModel d)]
    [hi : BorelSpace (ComplexModel d)] {R : ℝ} (hR : 0 < R) :
    ∃ C : ℝ, 0 < C ∧
      ∀ B : Set (ComplexModel d), IsOpen B → Convex ℝ B → (∀ z ∈ B, ‖z‖ < R) →
      ∀ P₁ P₂ : ComplexModel d → EReal, PlurisubharmonicOn P₁ B → PlurisubharmonicOn P₂ B →
      ∀ f : ComplexModel d → ℂ, DifferentiableOn ℂ f B →
      ∃ G : ComplexModel d × ComplexModel d → ℂ, DifferentiableOn ℂ G (B ×ˢ B) ∧
        (∀ y ∈ B, G (y, y) = f y) ∧
        (∫⁻ p in B ×ˢ B, ENNReal.ofReal (‖G p‖ ^ 2) *
            (multiplierWeight 1 (P₁ p.1) * multiplierWeight 1 (P₂ p.2))
              ∂(volume.prod volume)) ≤
          ENNReal.ofReal C * ∫⁻ y in B, multiplierDensity (fun y => P₁ y + P₂ y) 1 f y := by
  obtain rfl : i = borel _ := hi.measurable_eq
  exact exists_productExtension d R hR

/-! ### Polydiscs on `ℂ^{d+d}` -/

theorem fstCLM_mem_openPolydisc {x : ComplexModel (d' + 1)} {r : ℝ}
    {z : ComplexModel (d' + 1 + (d' + 1))}
    (hz : z ∈ openPolydisc (m := d' + 1 + d') (join x x) r) :
    fstCLM (d' + 1) z ∈ openPolydisc x r := fun i => by
  have h := hz (Fin.castAdd (d' + 1) i)
  rw [join_castAdd] at h
  simpa [fstCLM_apply] using h

theorem sndCLM_mem_openPolydisc {x : ComplexModel (d' + 1)} {r : ℝ}
    {z : ComplexModel (d' + 1 + (d' + 1))}
    (hz : z ∈ openPolydisc (m := d' + 1 + d') (join x x) r) :
    sndCLM (d' + 1) z ∈ openPolydisc x r := fun i => by
  have h := hz (Fin.natAdd (d' + 1) i)
  rw [join_natAdd] at h
  simpa [sndCLM_apply] using h

/-! ### The coefficient space of a multiplier ideal -/

section BoxSubspace

variable [MeasurableSpace (ComplexModel (d' + 1))] [BorelSpace (ComplexModel (d' + 1))]

/-- The box coefficients in `[0, K)^{d'+1}` (on the torus of radius `s`) of the functions
holomorphic on the polydisc `Δ(x, s')` whose germ at `x` is `L²` for `e^{-P}`: a subspace. -/
def boxSubspace (P : ComplexModel (d' + 1) → EReal) (x : ComplexModel (d' + 1))
    (hP : QuasiPlurisubharmonicAt P x) {s s' : ℝ} (hs : 0 ≤ s) (hss' : s < s') (K : ℕ) :
    Submodule ℂ ((Fin (d' + 1) → Fin K) → ℂ) where
  carrier := boxCoeffs x s K ''
    {q | MultiplierIntegrableAt P 1 q x volume ∧ DifferentiableOn ℂ q (openPolydisc x s')}
  add_mem' := by
    rintro _ _ ⟨q₁, hq₁, rfl⟩ ⟨q₂, hq₂, rfl⟩
    exact ⟨q₁ + q₂, ⟨multiplierIntegrableAt_add hP hq₁.1 hq₂.1, hq₁.2.add hq₂.2⟩,
      funext fun α => torusCoeff_add (continuousOnTorus_of_differentiableOn hs hss' hq₁.2)
        (continuousOnTorus_of_differentiableOn hs hss' hq₂.2) _⟩
  zero_mem' :=
    ⟨fun _ => 0, ⟨multiplierIntegrableAt_zero P one_pos x volume, differentiableOn_const 0⟩,
      funext fun α => torusCoeff_zero x s _⟩
  smul_mem' := by
    rintro c _ ⟨q, hq, rfl⟩
    exact ⟨fun z => c * q z,
      ⟨multiplierIntegrableAt_holomorphic_mul hP hq.1 analyticAt_const,
        (differentiableOn_const c).mul hq.2⟩,
      funext fun α => torusCoeff_const_mul c q _⟩

theorem mem_boxSubspace {P : ComplexModel (d' + 1) → EReal} {x : ComplexModel (d' + 1)}
    {hP : QuasiPlurisubharmonicAt P x} {s s' : ℝ} {hs : 0 ≤ s} {hss' : s < s'} {K : ℕ}
    {q : ComplexModel (d' + 1) → ℂ} (hq : MultiplierIntegrableAt P 1 q x volume)
    (hqd : DifferentiableOn ℂ q (openPolydisc x s')) :
    boxCoeffs x s K q ∈ boxSubspace P x hP hs hss' K :=
  ⟨q, ⟨hq, hqd⟩, rfl⟩

end BoxSubspace

/-! ### The local subadditivity theorem -/

/-- **Subadditivity of multiplier ideals on `ℂ^d`** (Demailly--Ein--Lazarsfeld 2000, Thm 2.6).
For `P₁, P₂` plurisubharmonic near `x`, a germ `f` at `x` with `|f|² e^{-(P₁+P₂)}` integrable near
`x` is, near `x`, a holomorphic combination of products `a b` of germs with `|a|² e^{-P₁}` and
`|b|² e^{-P₂}` integrable near `x`: `𝓘(P₁ + P₂)_x ⊆ 𝓘(P₁)_x · 𝓘(P₂)_x`. -/
theorem inGermSpan_mul_of_multiplierIntegrableAt [MeasurableSpace (ComplexModel (d' + 1))]
    [BorelSpace (ComplexModel (d' + 1))] {Ω : Set (ComplexModel (d' + 1))} (hΩ : IsOpen Ω)
    {P₁ P₂ : ComplexModel (d' + 1) → EReal} (hP₁ : PlurisubharmonicOn P₁ Ω)
    (hP₂ : PlurisubharmonicOn P₂ Ω) {x : ComplexModel (d' + 1)} (hx : x ∈ Ω)
    {f : ComplexModel (d' + 1) → ℂ}
    (hf : MultiplierIntegrableAt (fun y => P₁ y + P₂ y) 1 f x volume) :
    InGermSpan {g | ∃ a b, MultiplierIntegrableAt P₁ 1 a x volume ∧
      MultiplierIntegrableAt P₂ 1 b x volume ∧ g = fun z => a z * b z} x f := by
  obtain ⟨-, U, hU, hxU, hfU, hfL2⟩ := hf
  -- the ball `B = B(x, r)`, with `B̄ ⊆ U ∩ Ω`
  obtain ⟨r₀, hr₀, hr₀sub⟩ := Metric.isOpen_iff.mp (hU.inter hΩ) x ⟨hxU, hx⟩
  set r : ℝ := r₀ / 2 with hrdef
  have hr : 0 < r := by positivity
  have hrsub : closedBall x r ⊆ U ∩ Ω := (closedBall_subset_ball (by linarith)).trans hr₀sub
  have hrΩ : closedBall x r ⊆ Ω := hrsub.trans inter_subset_right
  set B : Set (ComplexModel (d' + 1)) := ball x r with hBdef
  have hBU : B ⊆ U := ball_subset_closedBall.trans (hrsub.trans inter_subset_left)
  have hBΩ : B ⊆ Ω := ball_subset_closedBall.trans hrΩ
  -- step 1: the extension from the diagonal
  obtain ⟨C, -, hext⟩ := exists_productExtension' (d := d' + 1) (R := ‖x‖ + r + 1)
    (by positivity)
  obtain ⟨G, hGd, hGdiag, hGint⟩ := hext B isOpen_ball (convex_ball x r)
    (fun z hz => by
      have h1 : ‖z - x‖ < r := by rw [← dist_eq_norm]; exact hz
      have h2 : ‖z‖ ≤ ‖z - x‖ + ‖x‖ := by
        calc ‖z‖ = ‖(z - x) + x‖ := by rw [sub_add_cancel]
          _ ≤ ‖z - x‖ + ‖x‖ := norm_add_le _ _
      linarith)
    P₁ P₂ (hP₁.mono hBΩ) (hP₂.mono hBΩ) f (hfU.mono hBU)
  have hint : ∫⁻ p, ENNReal.ofReal (‖G p‖ ^ 2) *
      (multiplierWeight 1 (P₁ p.1) * multiplierWeight 1 (P₂ p.2))
        ∂((volume.restrict B).prod (volume.restrict B)) ≠ ⊤ := by
    rw [Measure.prod_restrict]
    refine ne_top_of_le_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ?_) hGint
    exact ne_top_of_le_ne_top hfL2.2.ne (lintegral_mono_set hBU)
  -- radii: the polydisc `Δ(x, s')` lies in `B(x, r/2)`
  set s' : ℝ := r / (2 * (d' + 1)) with hs'def
  set s : ℝ := s' / 2 with hsdef
  have hs'pos : 0 < s' := by positivity
  have hspos : 0 < s := by positivity
  have hss' : s < s' := by rw [hsdef]; linarith
  have hpolyhalf : openPolydisc x s' ⊆ ball x (r / 2) := fun z hz => by
    have h := norm_sub_lt_of_mem_openPolydisc (m := d') hz
    rw [mem_ball, dist_eq_norm]
    calc ‖z - x‖ < ((d' : ℝ) + 1) * s' := h
      _ = r / 2 := by rw [hs'def]; field_simp
  have hpolyB : openPolydisc x s' ⊆ B :=
    hpolyhalf.trans (ball_subset_ball (by linarith))
  have hQ : ∀ z : ComplexModel (d' + 1), (∀ i, ‖z i - x i‖ ≤ s) → z ∈ ball x (r / 2) :=
    fun z hz => hpolyhalf fun i => (hz i).trans_lt hss'
  -- step 2: columns and rows
  have hcol := fun β => multiplierIntegrableAt_torusCoeff_column hP₁ hP₂ hr hrΩ hspos.le hQ hGd
    hint β
  have hrow := fun α => multiplierIntegrableAt_torusCoeff_row hP₁ hP₂ hr hrΩ hspos.le hQ hGd
    hint α
  have hP₁q : QuasiPlurisubharmonicAt P₁ x := (hP₁ x hx).quasiPlurisubharmonicAt
  have hP₂q : QuasiPlurisubharmonicAt P₂ x := (hP₂ x hx).quasiPlurisubharmonicAt
  have htorusB : ∀ θ, torusPoint x s θ ∈ B := fun θ =>
    hpolyB (torusPoint_mem_openPolydisc hspos.le hss' θ)
  have hGtorus : Continuous fun p : (Fin (d' + 1) → ℝ) × (Fin (d' + 1) → ℝ) =>
      G (torusPoint x s p.1, torusPoint x s p.2) :=
    hGd.continuousOn.comp_continuous
      (((continuous_torusPoint x s).comp continuous_fst).prodMk
        ((continuous_torusPoint x s).comp continuous_snd))
      fun p => ⟨htorusB p.1, htorusB p.2⟩
  -- the ideal `J` on `ℂ^{2d}`
  set p : ComplexModel (d' + 1 + (d' + 1)) := join x x with hpdef
  set S₂ : Set (ComplexModel (d' + 1 + (d' + 1)) → ℂ) :=
    {h | ∃ a b, MultiplierIntegrableAt P₁ 1 a x volume ∧ MultiplierIntegrableAt P₂ 1 b x volume ∧
      h = fun z => a (fstCLM (d' + 1) z) * b (sndCLM (d' + 1) z)} with hS₂def
  have hdiffAt : ∀ {P : ComplexModel (d' + 1) → EReal} {a : ComplexModel (d' + 1) → ℂ},
      MultiplierIntegrableAt P 1 a x volume → ∀ᶠ y in 𝓝 x, DifferentiableAt ℂ a y := by
    intro P a ha
    obtain ⟨-, Ua, hUa, hxUa, hda, -⟩ := ha
    exact Filter.eventually_of_mem (hUa.mem_nhds hxUa) fun y hy =>
      hda.differentiableAt (hUa.mem_nhds hy)
  have hfstT : Tendsto (fstCLM (d' + 1)) (𝓝 p) (𝓝 x) := by
    have h := (fstCLM (d' + 1)).continuous.tendsto p
    rwa [hpdef, fstCLM_join] at h
  have hsndT : Tendsto (sndCLM (d' + 1)) (𝓝 p) (𝓝 x) := by
    have h := (sndCLM (d' + 1)).continuous.tendsto p
    rwa [hpdef, sndCLM_join] at h
  have hS : ∀ h ∈ S₂, ∀ᶠ z in 𝓝 p, DifferentiableAt ℂ h z := by
    rintro _ ⟨a, b, ha, hb, rfl⟩
    filter_upwards [hfstT.eventually (hdiffAt ha), hsndT.eventually (hdiffAt hb)] with z hza hzb
    exact (hza.comp z (fstCLM (d' + 1)).differentiableAt).mul
      (hzb.comp z (sndCLM (d' + 1)).differentiableAt)
  set G₂ : ComplexModel (d' + 1 + (d' + 1)) → ℂ :=
    fun z => G (fstCLM (d' + 1) z, sndCLM (d' + 1) z) with hG₂def
  have hpolyfs : ∀ z ∈ openPolydisc (m := d' + 1 + d') p s',
      (fstCLM (d' + 1) z, sndCLM (d' + 1) z) ∈ B ×ˢ B := fun z hz =>
    ⟨hpolyB (fstCLM_mem_openPolydisc hz), hpolyB (sndCLM_mem_openPolydisc hz)⟩
  have hfsd : Differentiable ℂ fun z : ComplexModel (d' + 1 + (d' + 1)) =>
      (fstCLM (d' + 1) z, sndCLM (d' + 1) z) :=
    (fstCLM (d' + 1)).differentiable.prodMk (sndCLM (d' + 1)).differentiable
  have hG₂d : DifferentiableOn ℂ G₂ (openPolydisc (m := d' + 1 + d') p s') :=
    hGd.comp hfsd.differentiableOn hpolyfs
  -- Krull
  have hJG : InGermSpan S₂ p G₂ := by
    refine germKrullIntersection (d' + 1 + d') p (InGermSpan S₂ p)
      (isHolomorphicGermIdeal_inGermSpan hS) s s' hspos hss' G₂ hG₂d fun K => ?_
    classical
    set cast : (Fin (d' + 1) → Fin K) → Fin (d' + 1) → ℤ := fun α i => ((α i : ℕ) : ℤ)
      with hcast
    set F : (Fin (d' + 1) → ℤ) → ComplexModel (d' + 1) → ℂ :=
      fun β a => torusCoeff x s β (fun b => G (a, b)) with hFdef
    set E : (Fin (d' + 1) → ℤ) → ComplexModel (d' + 1) → ℂ :=
      fun α b => torusCoeff x s α (fun a => G (a, b)) with hEdef
    set Cm : (Fin (d' + 1) → Fin K) → (Fin (d' + 1) → Fin K) → ℂ :=
      fun α β => torusCoeff x s (cast α) (F (cast β)) with hCmdef
    have hcolC : ∀ β, (fun α => Cm α β) ∈ boxSubspace P₁ x hP₁q hspos.le hss' K := fun β =>
      mem_boxSubspace (hcol (cast β)).1 ((hcol (cast β)).2.mono hpolyB)
    have hrowC : ∀ α, Cm α ∈ boxSubspace P₂ x hP₂q hspos.le hss' K := by
      intro α
      have heq : Cm α = boxCoeffs x s K (E (cast α)) := by
        funext β
        exact torusCoeff_swap x s (cast α) (cast β) (fun a b => G (a, b)) hGtorus
      rw [heq]
      exact mem_boxSubspace (hrow (cast α)).1 ((hrow (cast α)).2.mono hpolyB)
    obtain ⟨R, u, v, hu, hv, huv⟩ := exists_sum_mul_of_cols_rows _ _ Cm hcolC hrowC
    have hu' : ∀ k, ∃ q, (MultiplierIntegrableAt P₁ 1 q x volume ∧
        DifferentiableOn ℂ q (openPolydisc x s')) ∧ boxCoeffs x s K q = u k := fun k => hu k
    have hv' : ∀ k, ∃ q, (MultiplierIntegrableAt P₂ 1 q x volume ∧
        DifferentiableOn ℂ q (openPolydisc x s')) ∧ boxCoeffs x s K q = v k := fun k => hv k
    choose a ha hau using hu'
    choose b hb hbv using hv'
    have hprodd : ∀ k, DifferentiableOn ℂ
        (fun z => a k (fstCLM (d' + 1) z) * b k (sndCLM (d' + 1) z))
        (openPolydisc (m := d' + 1 + d') p s') := fun k =>
      ((ha k).2.comp (fstCLM (d' + 1)).differentiable.differentiableOn
          fun z hz => fstCLM_mem_openPolydisc hz).mul
        ((hb k).2.comp (sndCLM (d' + 1)).differentiable.differentiableOn
          fun z hz => sndCLM_mem_openPolydisc hz)
    refine ⟨fun z => ∑ k, a k (fstCLM (d' + 1) z) * b k (sndCLM (d' + 1) z),
      ⟨R, fun k z => a k (fstCLM (d' + 1) z) * b k (sndCLM (d' + 1) z), fun _ _ => 1,
        fun k => ⟨a k, b k, (ha k).1, (hb k).1, rfl⟩,
        fun _ => Eventually.of_forall fun _ => differentiableAt_const _,
        Eventually.of_forall fun z => by simp⟩, ?_, ?_⟩
    · exact DifferentiableOn.fun_sum fun k _ => hprodd k
    · intro γ hγ
      set γL : Fin (d' + 1) → Fin K := fun i => ⟨γ (Fin.castAdd (d' + 1) i), hγ _⟩ with hγL
      set γR : Fin (d' + 1) → Fin K := fun i => ⟨γ (Fin.natAdd (d' + 1) i), hγ _⟩ with hγR
      have hidx : (fun i => (γ i : ℤ)) =
          Fin.append (m := d' + 1) (n := d' + 1) (cast γL) (cast γR) := by
        funext k
        refine Fin.addCases (m := d' + 1) (n := d' + 1) (fun i => ?_) (fun i => ?_) k
        · rw [Fin.append_left]
        · rw [Fin.append_right]
      rw [hidx]
      have hcontk : ∀ k, ContinuousOnTorus (m := d' + 1 + d') p s
          (fun z => a k (fstCLM (d' + 1) z) * b k (sndCLM (d' + 1) z)) := fun k =>
        continuousOnTorus_of_differentiableOn hspos.le hss' (hprodd k)
      calc torusCoeff (m := d' + 1 + d') p s
            (Fin.append (m := d' + 1) (n := d' + 1) (cast γL) (cast γR)) G₂
          = Cm γL γR := torusCoeff_join x s (cast γL) (cast γR) (fun a b => G (a, b)) hGtorus
        _ = ∑ k, u k γL * v k γR := huv γL γR
        _ = ∑ k, torusCoeff (m := d' + 1 + d') p s
              (Fin.append (m := d' + 1) (n := d' + 1) (cast γL) (cast γR))
              (fun z => a k (fstCLM (d' + 1) z) * b k (sndCLM (d' + 1) z)) := by
            refine Finset.sum_congr rfl fun k _ => ?_
            rw [← hau k, ← hbv k]
            exact (torusCoeff_join_mul x s (cast γL) (cast γR) (a k) (b k)
              (continuousOnTorus_of_differentiableOn hspos.le hss' (ha k).2)
              (continuousOnTorus_of_differentiableOn hspos.le hss' (hb k).2)).symm
        _ = torusCoeff (m := d' + 1 + d') p s
              (Fin.append (m := d' + 1) (n := d' + 1) (cast γL) (cast γR))
              (fun z => ∑ k, a k (fstCLM (d' + 1) z) * b k (sndCLM (d' + 1) z)) :=
            (torusCoeff_finset_sum _ _ (fun k _ => hcontk k) _).symm
  -- step 3: restriction to the diagonal
  obtain ⟨N, sv, A, hsv, hA, hev⟩ := hJG
  choose aa bb haa hbb hsveq using hsv
  have hdiagc : Continuous fun y : ComplexModel (d' + 1) => join y y :=
    (joinCLE (d' + 1)).continuous.comp (continuous_id.prodMk continuous_id)
  have hdiagT : Tendsto (fun y : ComplexModel (d' + 1) => join y y) (𝓝 x) (𝓝 p) :=
    hdiagc.tendsto x
  have hdiagd : Differentiable ℂ fun y : ComplexModel (d' + 1) => join y y :=
    (joinCLE (d' + 1)).differentiable.comp (differentiable_id.prodMk differentiable_id)
  refine ⟨N, fun i y => aa i y * bb i y, fun i y => A i (join y y),
    fun i => ⟨aa i, bb i, haa i, hbb i, rfl⟩, fun i => ?_, ?_⟩
  · filter_upwards [hdiagT.eventually (hA i)] with y hy
    exact DifferentiableAt.comp (g := A i) (f := fun y => join y y) y hy (hdiagd y)
  · filter_upwards [hdiagT.eventually hev, isOpen_ball.mem_nhds (mem_ball_self hr)] with y hy hyB
    rw [← hGdiag y hyB]
    have h1 : G₂ (join y y) = G (y, y) := by simp [hG₂def]
    rw [← h1, hy]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hsveq i]
    simp

end

end ComplexGeometry.AnalyticGeometry.MultiplierSubadditivityLocal
