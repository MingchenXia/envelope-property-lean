import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.IdealWeightComparison
import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.ChartPartition
import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.MeteredDivisorWeightBounds

set_option autoImplicit false
set_option linter.unusedSectionVars false

/-!
# Every coherent ideal on a compact complex manifold has a weight

For local generators `g_i` of a coherent ideal `𝔞`, write
`ψ_𝔞 = log ∑ |g_i|²`.

`AnalyticGeometry/IdealWeightComparison` develops the whole `O(1)` calculus of ideal
weights — monotonicity, well-definedness, pullback — but every statement in it
takes a *function* `φ` with `HasAnalyticSingularitiesOfType φ c 𝔞` as a
hypothesis. For the ideals the regularization construction attaches to currents (`𝔅_M`, `𝔅_m`, `𝔍`) such
a `φ` is the potential itself. For `𝓘_V` and `𝓘_W` — the vanishing ideals of the
centre and its strict transform, which Step 5 uses through the IV H and
"`ψ_{𝓘_W}` is bounded on `Λ`" — there is no current, and nothing in the project
produced a `φ` at all. This module does.

The construction is the same partition-of-unity device as in
`AnalyticGeometry/DivisorMetric`, but the comparison is two-sided rather than an exact
factorization, because a coherent ideal need not be invertible:

  `U = ∑_a χ_a ∑_i |g_{a,i}|²`, `ψ_𝔞 = log U`.

Near `x`, pick `a₀` with `χ_{a₀}(x) > 0` and let `g = g_{a₀}` be its generators.

* **above**: every `g_{a,j}` with `x ∈ tsupport χ_a` lies in `𝔞` at `x`, hence in
  the span of `g`, so `∑_j |g_{a,j}|² ≤ B_a ∑_i |g_i|²` near `x`
  (`IdealWeightComparison.exists_nhds_generatorNormSq_le_of_forall_isInSpanAt`,
  finite Cauchy–Schwarz). Summing with `χ_a ≤ 1` gives `U ≤ c₂ ∑_i |g_i|²`.
* **below**: a single term suffices — `χ_{a₀}` is continuous and positive at `x`,
  so `U ≥ χ_{a₀} ∑_i |g_i|² ≥ c₁ ∑_i |g_i|²` near `x`.

Hence `log U = log ∑_i |g_i|² + R` with `|R| ≤ max |log c₁|, |log c₂|`, which is
`HasAnalyticSingularitiesOfType (log U) 1 𝔞`. No smoothness of `U` is needed:
the remainder of an analytic-singularity presentation only has to be bounded.

**What this weight is not**. `HasAnalyticSingularitiesOfType` says only
`ψ = log ∑ |g_i|² + O(1)` locally; it does not say `ψ` is quasi-psh, or even upper
semicontinuous, and the construction here does not make it so — the partition of
unity enters through continuity alone, and the remainder is merely bounded. Every
consumer of `ψ_𝔞` in the regularization construction Steps 4–5 uses only the `O(1)` calculus, so that is
enough here. The first argument that needs `θ + ddᶜ ψ_𝔞` as a current, or a Lelong
number of `ψ_𝔞`, will have to redo the glue with a psh-preserving one (a maximum
over the pieces rather than a convex combination). The divisor side does not have
this defect: `AnalyticGeometry/DivisorMetric` produces a chart-smooth remainder and an
honest curvature form.

Everything here is sorry-free.
-/

open Set Filter
open scoped Topology Manifold ContDiff

namespace ComplexGeometry.AnalyticGeometry.CoherentIdealWeight

open Pluripotential Pluripotential.HolomorphicIdealSheaves Pluripotential.GlobalAnalyticSingularities
  ChartPartition
open ComplexGeometry.AnalyticGeometry.IdealWeightComparison

noncomputable section

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]

variable (n M) in
/-- A finite open cover by sets on which `𝔞` is generated by a finite holomorphic
family, with a subordinate partition of unity. -/
structure IdealPartition (𝔞 : GermIdeal n M) where
  card : ℕ
  dom : Fin card → Set M
  isOpen_dom : ∀ a, IsOpen (dom a)
  arity : Fin card → ℕ
  gen : (a : Fin card) → Fin (arity a) → M → ℂ
  gen_mdifferentiableOn : ∀ a i,
    MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) (gen a i) (dom a)
  gen_spec : ∀ a, ∀ y ∈ dom a, ∀ f,
    𝔞.mem y f ↔ IsInSpanAt (n := n) (· ∈ range (gen a)) y f
  part : Fin card → M → ℝ
  part_continuousAt : ∀ a x, ContinuousAt (part a) x
  part_nonneg : ∀ a y, 0 ≤ part a y
  part_tsupport : ∀ a, tsupport (part a) ⊆ dom a
  part_sum : ∀ y, ∑ a, part a y = 1

theorem exists_idealPartition [CompactSpace M] {𝔞 : GermIdeal n M} (h𝔞 : 𝔞.IsCoherent) :
    Nonempty (IdealPartition n M 𝔞) := by
  classical
  choose S hS hmem N s hsd hspec using h𝔞
  obtain ⟨m, χ, idx, hχsm, hχnn, hχsupp, -, hχsum⟩ :=
    exists_chartSmooth_partitionOfUnity (n := n) (fun x : M => ⟨S x, hS x⟩)
      fun x => ⟨x, hmem x⟩
  refine ⟨⟨m, fun a => S (idx a), fun a => hS _, fun a => N (idx a), fun a => s (idx a),
    fun a => hsd _, fun a => hspec _, χ, fun a x => ?_, hχnn, hχsupp, hχsum⟩⟩
  have := MeteredDivisorWeightBounds.continuousAt_of_chartContDiffOn (n := n)
    (h := χ a) isOpen_univ (fun e => by simpa using hχsm a e) (mem_univ x)
  exact this

namespace IdealPartition

variable {𝔞 : GermIdeal n M} (P : IdealPartition n M 𝔞)

/-- `∑_i |g_{a,i}|²`, extended by zero off the `a`-th domain. -/
def genNormSq (a : Fin P.card) : M → ℝ :=
  (P.dom a).indicator (generatorNormSq (P.gen a))

theorem genNormSq_nonneg (a : Fin P.card) (y : M) : 0 ≤ P.genNormSq a y :=
  Set.indicator_nonneg (fun _ _ => generatorNormSq_nonneg _ _) y

/-- **The ideal weight base** `U = ∑_a χ_a ∑_i |g_{a,i}|²`. -/
def weight (y : M) : ℝ := ∑ a, P.part a y * P.genNormSq a y

theorem weight_nonneg (y : M) : 0 ≤ P.weight y :=
  Finset.sum_nonneg fun a _ => mul_nonneg (P.part_nonneg a y) (P.genNormSq_nonneg a y)

/-- **`ψ_𝔞 = log U`**, with the convention `log 0 = -∞`. -/
def weightLog : M → EReal := fun y => ENNReal.log (ENNReal.ofReal (P.weight y))

theorem part_le_one (a : Fin P.card) (y : M) : P.part a y ≤ 1 := by
  rw [← P.part_sum y]
  exact Finset.single_le_sum (fun b _ => P.part_nonneg b y) (Finset.mem_univ a)

theorem part_eq_zero_of_notMem_tsupport {a : Fin P.card} {y : M}
    (hy : y ∉ tsupport (P.part a)) : P.part a y = 0 :=
  image_eq_zero_of_notMem_tsupport hy

/-- The cover of an `IdealPartition` witnesses coherence. -/
theorem isCoherent (Q : IdealPartition n M 𝔞) : 𝔞.IsCoherent := by
  classical
  intro x
  obtain ⟨a₀, -, ha₀⟩ : ∃ a₀ ∈ Finset.univ, 0 < Q.part a₀ x := by
    by_contra hcon
    push Not at hcon
    have hle : ∑ a, Q.part a x ≤ 0 := Finset.sum_nonpos fun a ha => hcon a ha
    rw [Q.part_sum x] at hle
    linarith
  exact ⟨Q.dom a₀, Q.isOpen_dom a₀, Q.part_tsupport a₀ (subset_tsupport _ ha₀.ne'),
    Q.arity a₀, Q.gen a₀, Q.gen_mdifferentiableOn a₀, Q.gen_spec a₀⟩

/-- **The two-sided local comparison** `c₁ ∑|g_i|² ≤ U ≤ c₂ ∑|g_i|²` for the
generators `g` of one partition piece through `x`. -/
theorem exists_local_bounds (x : M) :
    ∃ (V : Set M) (a₀ : Fin P.card), IsOpen V ∧ x ∈ V ∧ V ⊆ P.dom a₀ ∧
      ∃ c₁ c₂ : ℝ, 0 < c₁ ∧ 0 < c₂ ∧ ∀ y ∈ V,
        c₁ * generatorNormSq (P.gen a₀) y ≤ P.weight y ∧
          P.weight y ≤ c₂ * generatorNormSq (P.gen a₀) y := by
  classical
  obtain ⟨a₀, -, ha₀⟩ : ∃ a₀ ∈ Finset.univ, 0 < P.part a₀ x := by
    by_contra hcon
    push Not at hcon
    have hle : ∑ a, P.part a x ≤ 0 := Finset.sum_nonpos fun a ha => hcon a ha
    rw [P.part_sum x] at hle
    linarith
  have hx₀ : x ∈ P.dom a₀ := P.part_tsupport a₀ (subset_tsupport _ ha₀.ne')
  -- every generator of a piece through `x` lies in the span of the `a₀`-generators
  have hmemgen : ∀ (a : Fin P.card), x ∈ P.dom a → ∀ j,
      IsInSpanAt (n := n) (· ∈ range (P.gen a₀)) x (P.gen a j) := by
    intro a hxa j
    refine (P.gen_spec a₀ x hx₀ _).mp ((P.gen_spec a x hxa _).mpr ?_)
    refine isInSpanAt_of_eq_mul ⟨j, rfl⟩ ?_ (holomorphicAt_const 1)
      (Eventually.of_forall fun _ => by simp)
    filter_upwards [(P.isOpen_dom a).mem_nhds hxa] with z hz
    exact (P.gen_mdifferentiableOn a j z hz).mdifferentiableAt ((P.isOpen_dom a).mem_nhds hz)
  -- each summand of `U` is locally dominated by `∑|g_i|²`
  have key : ∀ a : Fin P.card, ∃ B : ℝ, 0 < B ∧ ∀ᶠ y in 𝓝 x,
      P.part a y * P.genNormSq a y ≤ B * generatorNormSq (P.gen a₀) y := by
    intro a
    by_cases hxa : x ∈ tsupport (P.part a)
    · obtain ⟨B, hB, hBy⟩ := exists_nhds_generatorNormSq_le_of_forall_isInSpanAt
        (hmemgen a (P.part_tsupport a hxa))
      refine ⟨B, hB, ?_⟩
      filter_upwards [hBy, (P.isOpen_dom a).mem_nhds (P.part_tsupport a hxa)] with y hy hyd
      have h1 : P.genNormSq a y = generatorNormSq (P.gen a) y :=
        Set.indicator_of_mem hyd _
      rw [h1]
      calc P.part a y * generatorNormSq (P.gen a) y
          ≤ 1 * generatorNormSq (P.gen a) y :=
            mul_le_mul_of_nonneg_right (P.part_le_one a y) (generatorNormSq_nonneg _ _)
        _ = generatorNormSq (P.gen a) y := one_mul _
        _ ≤ B * generatorNormSq (P.gen a₀) y := hy
    · refine ⟨1, one_pos, ?_⟩
      filter_upwards [(isClosed_tsupport (P.part a)).isOpen_compl.mem_nhds hxa] with y hy
      rw [P.part_eq_zero_of_notMem_tsupport hy, zero_mul]
      exact mul_nonneg zero_le_one (generatorNormSq_nonneg _ _)
  choose B hB hBy using key
  have hall : ∀ᶠ y in 𝓝 x,
      ∀ a, P.part a y * P.genNormSq a y ≤ B a * generatorNormSq (P.gen a₀) y :=
    eventually_all.mpr hBy
  have hlow : ∀ᶠ y in 𝓝 x, P.part a₀ x / 2 < P.part a₀ y :=
    (P.part_continuousAt a₀ x).eventually (eventually_gt_nhds (by linarith))
  obtain ⟨V, hVsub, hV, hxV⟩ := mem_nhds_iff.mp
    (hall.and (hlow.and ((P.isOpen_dom a₀).mem_nhds hx₀)))
  refine ⟨V, a₀, hV, hxV, fun y hy => (hVsub hy).2.2, P.part a₀ x / 2,
    (∑ a, B a) + 1, by linarith, ?_, fun y hy => ⟨?_, ?_⟩⟩
  · have : (0 : ℝ) ≤ ∑ a, B a := Finset.sum_nonneg fun a _ => (hB a).le
    linarith
  · -- lower bound: the single `a₀` term already suffices
    have hyd : y ∈ P.dom a₀ := (hVsub hy).2.2
    have h1 : P.genNormSq a₀ y = generatorNormSq (P.gen a₀) y :=
      Set.indicator_of_mem hyd _
    have hterm : P.part a₀ y * P.genNormSq a₀ y ≤ P.weight y :=
      Finset.single_le_sum
        (f := fun a => P.part a y * P.genNormSq a y)
        (fun a _ => mul_nonneg (P.part_nonneg a y) (P.genNormSq_nonneg a y))
        (Finset.mem_univ a₀)
    have h2 : P.part a₀ x / 2 * generatorNormSq (P.gen a₀) y
        ≤ P.part a₀ y * generatorNormSq (P.gen a₀) y :=
      mul_le_mul_of_nonneg_right (le_of_lt (hVsub hy).2.1) (generatorNormSq_nonneg _ _)
    rw [h1] at hterm
    linarith
  · -- upper bound: sum the per-index dominations
    have hsum : P.weight y ≤ ∑ a, B a * generatorNormSq (P.gen a₀) y :=
      Finset.sum_le_sum fun a _ => (hVsub hy).1 a
    have hG : (0 : ℝ) ≤ generatorNormSq (P.gen a₀) y := generatorNormSq_nonneg _ _
    calc P.weight y ≤ ∑ a, B a * generatorNormSq (P.gen a₀) y := hsum
      _ = (∑ a, B a) * generatorNormSq (P.gen a₀) y := by rw [Finset.sum_mul]
      _ ≤ ((∑ a, B a) + 1) * generatorNormSq (P.gen a₀) y := by nlinarith

theorem generatorLog_eq_log_generatorNormSq {N : ℕ} (g : Fin N → M → ℂ) (y : M) :
    generatorLog g y = ENNReal.log (ENNReal.ofReal (generatorNormSq g y)) :=
  generatorLog_eq_log_sum g y

/-- **Every coherent ideal on a compact complex manifold has a weight**
(the regularization construction, the qpsh): `ψ_𝔞 = log ∑_i |g_i|² + O(1)` locally, with coefficient `1`. -/
theorem hasAnalyticSingularitiesOfType_weightLog :
    HasAnalyticSingularitiesOfType P.weightLog 1 𝔞 := by
  refine ⟨one_pos, P.isCoherent, fun x => ?_⟩
  obtain ⟨V, a₀, hV, hxV, hVdom, c₁, c₂, hc₁, hc₂, hbounds⟩ := P.exists_local_bounds x
  refine ⟨V, hV, hxV, P.arity a₀, P.gen a₀,
    fun i => (P.gen_mdifferentiableOn a₀ i).mono hVdom,
    fun y hy => P.gen_spec a₀ y (hVdom hy),
    fun y => Real.log (P.weight y) - Real.log (generatorNormSq (P.gen a₀) y),
    max |Real.log c₁| |Real.log c₂|, fun y hy => ?_, fun y hy => ?_⟩
  · -- the remainder is bounded
    rcases eq_or_lt_of_le (generatorNormSq_nonneg (P.gen a₀) y) with hG | hG
    · have hw : P.weight y = 0 :=
        le_antisymm (by simpa [← hG] using (hbounds y hy).2) (P.weight_nonneg y)
      have hR : Real.log (P.weight y) - Real.log (generatorNormSq (P.gen a₀) y) = 0 := by
        rw [hw, ← hG]; simp
      show |Real.log (P.weight y) - Real.log (generatorNormSq (P.gen a₀) y)| ≤ _
      rw [hR, abs_zero]
      exact le_trans (abs_nonneg _) (le_max_left _ _)
    · have hwpos : 0 < P.weight y :=
        lt_of_lt_of_le (mul_pos hc₁ hG) (hbounds y hy).1
      have hupper : Real.log (P.weight y) ≤ Real.log c₂ + Real.log (generatorNormSq (P.gen a₀) y) := by
        have := (hbounds y hy).2
        calc Real.log (P.weight y)
            ≤ Real.log (c₂ * generatorNormSq (P.gen a₀) y) :=
              Real.log_le_log hwpos this
          _ = Real.log c₂ + Real.log (generatorNormSq (P.gen a₀) y) :=
              Real.log_mul hc₂.ne' hG.ne'
      have hlower : Real.log c₁ + Real.log (generatorNormSq (P.gen a₀) y) ≤ Real.log (P.weight y) := by
        have := (hbounds y hy).1
        calc Real.log c₁ + Real.log (generatorNormSq (P.gen a₀) y)
            = Real.log (c₁ * generatorNormSq (P.gen a₀) y) :=
              (Real.log_mul hc₁.ne' hG.ne').symm
          _ ≤ Real.log (P.weight y) := Real.log_le_log (mul_pos hc₁ hG) this
      have h1 : |Real.log c₁| ≤ max |Real.log c₁| |Real.log c₂| := le_max_left _ _
      have h2 : |Real.log c₂| ≤ max |Real.log c₁| |Real.log c₂| := le_max_right _ _
      rw [abs_le]
      constructor
      · have := neg_abs_le (Real.log c₁)
        linarith
      · have := le_abs_self (Real.log c₂)
        linarith
  · -- the presentation identity
    rcases eq_or_lt_of_le (generatorNormSq_nonneg (P.gen a₀) y) with hG | hG
    · have hw : P.weight y = 0 :=
        le_antisymm (by simpa [← hG] using (hbounds y hy).2) (P.weight_nonneg y)
      have hbot : generatorLog (P.gen a₀) y = ⊥ := by
        rw [generatorLog_eq_log_generatorNormSq, ← hG]
        simp
      show P.weightLog y = _
      rw [weightLog, hw, hbot]
      simp
    · have hwpos : 0 < P.weight y :=
        lt_of_lt_of_le (mul_pos hc₁ hG) (hbounds y hy).1
      have h1 : (((1 : ℚ) : ℝ) : EReal) = 1 := by norm_num
      show P.weightLog y = _
      rw [weightLog, ENNReal.log_ofReal_of_pos hwpos,
        generatorLog_eq_log_generatorNormSq, ENNReal.log_ofReal_of_pos hG, h1, one_mul,
        ← EReal.coe_add]
      congr 1
      ring

end IdealPartition

/-- **The weight of a coherent ideal** (the regularization construction, the qpsh). On a compact complex
manifold every coherent ideal `𝔞` carries a function `ψ_𝔞` with
`HasAnalyticSingularitiesOfType ψ_𝔞 1 𝔞`, so the whole `O(1)` calculus of
`AnalyticGeometry/IdealWeightComparison` applies to it. In particular this supplies the
weights `ψ_{𝓘_V}` and `ψ_{𝓘_W}` of Step 5, for which no current is available. -/
theorem exists_hasAnalyticSingularitiesOfType_of_isCoherent [CompactSpace M]
    {𝔞 : GermIdeal n M} (h𝔞 : 𝔞.IsCoherent) :
    ∃ φ : M → EReal, HasAnalyticSingularitiesOfType φ 1 𝔞 := by
  obtain ⟨P⟩ := exists_idealPartition h𝔞
  exact ⟨P.weightLog, P.hasAnalyticSingularitiesOfType_weightLog⟩

end

end ComplexGeometry.AnalyticGeometry.CoherentIdealWeight
