import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.PointPoleExtension
import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.WeightedL2ExtensionLimit
import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.QuantitativeRegularizationSmoothWeightLimit

set_option autoImplicit false

/-!
# Hörmander's extension with a point pole, for a smooth weight, uniformly in the pole

Nadel's proof that the multiplier ideal `𝓘(cΨ)_y` is generated by the global `L²` holomorphic
functions (Demailly, *Analytic methods in algebraic geometry*, Prop. 5.7) takes a germ `f` of
`𝓘(cΨ)_y`, a cut-off `θ` around `y`, and solves `∂̄ u = ∂̄(θ f)` with the weight
`cΨ + q log |z - y|²`. `G = θ f - u` is then a global `L²` holomorphic function and `f - G` is
small at `y` (pole order `q`), which `AnalyticGeometry.MultiplierIdealBergmanNadelVanishing` turns into
vanishing torus coefficients.

This module does the regular case. `PointPole.exists_poleExtension_delta` gives, for a smooth
psh weight `ϕ` bounded below and each regularisation `δ > 0` of the pole, a solution with a
bound independent of `δ`; letting `δ → 0`:

* `exists_limit_of_weighted_poleBounds` — the generic limit step (Montel, Fatou, monotone
  convergence): holomorphic `G_i` with `∫ |G_i|² w_i ≤ A₁` and, for every parameter `t`,
  eventually `∫ |a - G_i|² w_i P_t ≤ A₂`, for increasing weights `w_i`, have a holomorphic limit
  `G` with the same two bounds for the weight `⨆ w_i`. It is used once here (`δ → 0`) and twice
  more for a singular weight (smoothing, then truncation).
* `exists_poleExtension_smooth` — for a smooth psh `ϕ` bounded below on a bounded convex `D`, a
  holomorphic `G` on `K ⋐ D` with `∫_K |G|² e^{-ϕ} ≤ A₁` and
  `∫_K |θ f - G|² e^{-ϕ} (|z - y|² + η²)^{-q} ≤ A₂` for EVERY `η > 0`, where `A₁, A₂` depend on
  `ϕ` only through an upper bound `S` of `∫_{supp θ} |f|² e^{-ϕ}`.

The extension argument in Nadel coherence.
-/

open Set Filter MeasureTheory Complex Metric
open scoped Topology ContDiff ENNReal

namespace ComplexGeometry.AnalyticGeometry.MultiplierIdealBergmanNadelExtension

noncomputable section

open Pluripotential Hormander PointPole

/-! ### The generic limit step -/

section Limit

variable {N : ℕ}

/-- **Limits of weighted solutions with a pole bound.**  Holomorphic `G_i` on an open `K` with
`∫_K |G_i|² w_i ≤ A₁` and, for every parameter `t`, eventually `∫_K |a - G_i|² w_i P_t ≤ A₂`,
for weights `w_i` increasing in `i` and locally bounded below, have a holomorphic limit `G` on
`K` with `∫_K |G|² ⨆ w_i ≤ A₁` and `∫_K |a - G|² (⨆ w_i) P_t ≤ A₂` for every `t`. -/
theorem exists_limit_of_weighted_poleBounds {K : Set (ComplexModel N)} (hKo : IsOpen K)
    {w : ℕ → ComplexModel N → ℝ≥0∞} (hwm : ∀ x ∈ K, Monotone fun i => w i x)
    (hwmeas : ∀ i, AEMeasurable (w i) (volume.restrict K))
    (hlow : ∀ x ∈ K, ∃ r > 0, ∃ δ : ℝ, 0 < δ ∧ ∀ y ∈ ball x r, ENNReal.ofReal δ ≤ w 0 y)
    {T : Type*} {P : T → ComplexModel N → ℝ≥0∞}
    (hPmeas : ∀ t, AEMeasurable (P t) (volume.restrict K))
    {a : ComplexModel N → ℂ} (ha : ContinuousOn a K)
    {G : ℕ → ComplexModel N → ℂ} (hG : ∀ i, DifferentiableOn ℂ (G i) K)
    {A₁ A₂ : ℝ≥0∞} (hA₁ : A₁ ≠ ⊤)
    (h1 : ∀ i, ∫⁻ x in K, ENNReal.ofReal (‖G i x‖ ^ 2) * w i x ≤ A₁)
    (h2 : ∀ t, ∀ᶠ i in atTop,
      ∫⁻ x in K, ENNReal.ofReal (‖a x - G i x‖ ^ 2) * w i x * P t x ≤ A₂) :
    ∃ G' : ComplexModel N → ℂ, DifferentiableOn ℂ G' K ∧
      ∫⁻ x in K, ENNReal.ofReal (‖G' x‖ ^ 2) * ⨆ i, w i x ≤ A₁ ∧
      ∀ t, ∫⁻ x in K, ENNReal.ofReal (‖a x - G' x‖ ^ 2) * (⨆ i, w i x) * P t x ≤ A₂ := by
  have hUK : (⋃ _ : ℕ, K) = K := iUnion_const K
  obtain ⟨ψ, G', hψ, hG', hconv, -, hbound⟩ :=
    exists_subseq_differentiableOn_extension_of_weighted_bounds (ι := fun e : Empty => e.elim)
      (g := fun e : Empty => e.elim) (U := fun _ => K) (fun _ => hKo) monotone_const
      (by rw [hUK]; exact hwm) (by rw [hUK]; exact hwmeas) (by rw [hUK]; exact hlow) hG
      (fun _ e => e.elim) hA₁ h1
  rw [hUK] at hG' hconv hbound
  refine ⟨G', hG', hbound, fun t => ?_⟩
  have hpt : ∀ x ∈ K, Tendsto (fun i => G (ψ i) x) atTop (𝓝 (G' x)) := fun x hx =>
    hconv.tendsto_at hx
  have hcont : ∀ i, ContinuousOn (fun x => ENNReal.ofReal (‖a x - G i x‖ ^ 2)) K := fun i =>
    ENNReal.continuous_ofReal.comp_continuousOn ((ha.sub (hG i).continuousOn).norm.pow 2)
  -- Fatou at a fixed weight `w i₀`
  have hfatou : ∀ i₀, ∫⁻ x in K, ENNReal.ofReal (‖a x - G' x‖ ^ 2) * w i₀ x * P t x ≤ A₂ := by
    intro i₀
    set f : ℕ → ComplexModel N → ℝ≥0∞ := fun k x =>
      ENNReal.ofReal (‖a x - G (ψ (k + i₀)) x‖ ^ 2) * w i₀ x * P t x with hf
    have hle_idx : ∀ k, i₀ ≤ ψ (k + i₀) := fun k => (Nat.le_add_left i₀ k).trans (hψ.id_le _)
    have hmeas : ∀ k, AEMeasurable (f k) (volume.restrict K) := fun k =>
      (((hcont _).aemeasurable hKo.measurableSet).mul (hwmeas i₀)).mul (hPmeas t)
    have hpoint : ∀ x ∈ K, ENNReal.ofReal (‖a x - G' x‖ ^ 2) * w i₀ x * P t x ≤
        liminf (fun k => f k x) atTop := by
      intro x hx
      by_cases h0 : a x - G' x = 0
      · simp [h0]
      · have h1' : Tendsto (fun k => G (ψ (k + i₀)) x) atTop (𝓝 (G' x)) :=
          (hpt x hx).comp (tendsto_add_atTop_nat i₀)
        have h2' : Tendsto (fun k => ENNReal.ofReal (‖a x - G (ψ (k + i₀)) x‖ ^ 2)) atTop
            (𝓝 (ENNReal.ofReal (‖a x - G' x‖ ^ 2))) :=
          ENNReal.tendsto_ofReal (((tendsto_const_nhds.sub h1').norm).pow 2)
        have ht : Tendsto (fun k => f k x) atTop
            (𝓝 (ENNReal.ofReal (‖a x - G' x‖ ^ 2) * w i₀ x * P t x)) := by
          simp only [hf, mul_assoc]
          exact ENNReal.Tendsto.mul_const h2' (Or.inl (by
            simpa [ENNReal.ofReal_eq_zero, not_le] using h0))
        exact ht.liminf_eq.ge
    have hev : ∀ᶠ k in atTop, ∫⁻ x in K, f k x ≤ A₂ := by
      have hT : Tendsto (fun k => ψ (k + i₀)) atTop atTop :=
        hψ.tendsto_atTop.comp (tendsto_add_atTop_nat i₀)
      filter_upwards [hT.eventually (h2 t)] with k hk
      refine le_trans (setLIntegral_mono' hKo.measurableSet fun x hx => ?_) hk
      exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hwm x hx (hle_idx k)) zero_le)
        zero_le
    calc ∫⁻ x in K, ENNReal.ofReal (‖a x - G' x‖ ^ 2) * w i₀ x * P t x
        ≤ ∫⁻ x in K, liminf (fun k => f k x) atTop :=
          setLIntegral_mono' hKo.measurableSet hpoint
      _ ≤ liminf (fun k => ∫⁻ x in K, f k x) atTop := lintegral_liminf_le' hmeas
      _ ≤ A₂ := liminf_le_of_frequently_le' hev.frequently
  -- monotone convergence in the weight
  have hmono : ∀ᵐ x ∂(volume.restrict K), Monotone fun i =>
      ENNReal.ofReal (‖a x - G' x‖ ^ 2) * w i x * P t x := by
    refine ae_restrict_of_forall_mem hKo.measurableSet fun x hx i j hij => ?_
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hwm x hx hij) zero_le) zero_le
  have hcont' : ContinuousOn (fun x => ENNReal.ofReal (‖a x - G' x‖ ^ 2)) K :=
    ENNReal.continuous_ofReal.comp_continuousOn ((ha.sub hG'.continuousOn).norm.pow 2)
  have hmeas' : ∀ i, AEMeasurable (fun x => ENNReal.ofReal (‖a x - G' x‖ ^ 2) * w i x * P t x)
      (volume.restrict K) := fun i =>
    ((hcont'.aemeasurable hKo.measurableSet).mul (hwmeas i)).mul (hPmeas t)
  calc ∫⁻ x in K, ENNReal.ofReal (‖a x - G' x‖ ^ 2) * (⨆ i, w i x) * P t x
      = ∫⁻ x in K, ⨆ i, ENNReal.ofReal (‖a x - G' x‖ ^ 2) * w i x * P t x := by
        refine lintegral_congr fun x => ?_
        rw [ENNReal.mul_iSup, ENNReal.iSup_mul]
    _ = ⨆ i, ∫⁻ x in K, ENNReal.ofReal (‖a x - G' x‖ ^ 2) * w i x * P t x :=
        lintegral_iSup' hmeas' hmono
    _ ≤ A₂ := iSup_le hfatou

end Limit

/-! ### The regular case: a smooth weight, `δ → 0` -/

section Smooth

variable {d : ℕ}

/-- `e^{-ϕ} (|z - y|² + η²)^{-q} ≤ e^{R²} e^{-Φ_δ}` for `δ ≤ η` and `‖z‖ ≤ R`. -/
theorem exp_neg_mul_pole_le {ϕ : ComplexModel d → ℝ} {y z : ComplexModel d} {q : ℕ} {δ η R : ℝ}
    (hδ : 0 < δ) (hδη : δ ≤ η) (hz : ‖z‖ ≤ R) :
    Real.exp (-ϕ z) * ((‖z - y‖ ^ 2 + η ^ 2) ^ q)⁻¹ ≤
      Real.exp (R ^ 2) * Real.exp (-poleWeight q ϕ y δ z) := by
  rw [exp_neg_poleWeight ϕ y hδ z]
  have h1 : ((‖z - y‖ ^ 2 + η ^ 2) ^ q)⁻¹ ≤ ((‖z - y‖ ^ 2 + δ ^ 2) ^ q)⁻¹ := by
    refine inv_anti₀ (by positivity) (pow_le_pow_left₀ (by positivity) ?_ q)
    have : δ ^ 2 ≤ η ^ 2 := pow_le_pow_left₀ hδ.le hδη 2
    linarith
  have h2 : 1 ≤ Real.exp (R ^ 2) * Real.exp (-‖z‖ ^ 2) := by
    rw [← Real.exp_add, Real.one_le_exp_iff]
    have : ‖z‖ ^ 2 ≤ R ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hz 2
    linarith
  have h3 : 0 ≤ Real.exp (-ϕ z) * ((‖z - y‖ ^ 2 + δ ^ 2) ^ q)⁻¹ := by positivity
  calc Real.exp (-ϕ z) * ((‖z - y‖ ^ 2 + η ^ 2) ^ q)⁻¹
      ≤ Real.exp (-ϕ z) * ((‖z - y‖ ^ 2 + δ ^ 2) ^ q)⁻¹ :=
        mul_le_mul_of_nonneg_left h1 (Real.exp_pos _).le
    _ ≤ Real.exp (-ϕ z) * ((‖z - y‖ ^ 2 + δ ^ 2) ^ q)⁻¹ *
          (Real.exp (R ^ 2) * Real.exp (-‖z‖ ^ 2)) := le_mul_of_one_le_right h3 h2
    _ = _ := by ring

/-- **Hörmander's extension with a point pole, regular weight.**  For a smooth psh `ϕ` bounded
below on a bounded convex open `D`, a cut-off `θ` (`0 ≤ θ ≤ 1`, `θ = 1` on `B(y, r)`) and `f`
holomorphic near `supp θ ⊆ D`, there is `G` holomorphic on `K ⋐ D` with
`∫_K |G|² e^{-ϕ} ≤ A₁` and `∫_K |θ f - G|² e^{-ϕ} (|z - y|² + η²)^{-q} ≤ A₂` for every `η > 0`;
`A₁`, `A₂` depend on `ϕ` only through an upper bound `S` of `∫_{supp θ} |f|² e^{-ϕ}`. -/
theorem exists_poleExtension_smooth (hH : HormanderL2Estimate d)
    {D : Set (ComplexModel d)} (hDo : IsOpen D) (hDc : Convex ℝ D)
    (hDb : Bornology.IsBounded D) {ϕ : ComplexModel d → ℝ} (hϕ : ContDiffOn ℝ ∞ ϕ D)
    (hϕL : ∀ z ∈ D, ∀ ξ, 0 ≤ leviForm ϕ z ξ) {Bϕ : ℝ} (hBϕ : ∀ z ∈ D, -Bϕ ≤ ϕ z)
    (y : ComplexModel d) {r : ℝ} (hr : 0 < r) {θ : ComplexModel d → ℝ} (hθ : ContDiff ℝ ∞ θ)
    (hθcs : HasCompactSupport θ) (hθ1 : ∀ z ∈ ball y r, θ z = 1)
    (hθ01 : ∀ z, 0 ≤ θ z ∧ θ z ≤ 1)
    {W : Set (ComplexModel d)} (hW : IsOpen W) (hts : tsupport θ ⊆ W) (htsD : tsupport θ ⊆ D)
    {f : ComplexModel d → ℂ} (hf : DifferentiableOn ℂ f W)
    {Mθ : ℝ} (hMθ : ∀ z, ‖fderiv ℝ θ z‖ ≤ Mθ)
    {K Kc : Set (ComplexModel d)} (hKo : IsOpen K) (hKKc : K ⊆ Kc) (hKc : IsCompact Kc)
    (hKcD : Kc ⊆ D) (q : ℕ) {S : ℝ}
    (hS : ∫ z in tsupport θ, ‖f z‖ ^ 2 * Real.exp (-ϕ z) ≤ S)
    {R : ℝ} (hR : ∀ z ∈ K, ‖z‖ ≤ R ∧ ‖z - y‖ ≤ R) :
    ∃ G : ComplexModel d → ℂ, DifferentiableOn ℂ G K ∧
      ∫⁻ z in K, ENNReal.ofReal (‖G z‖ ^ 2) * ENNReal.ofReal (Real.exp (-ϕ z)) ≤
        ENNReal.ofReal (2 * S + 2 * ((R ^ 2 + 1) ^ q * Real.exp (R ^ 2) *
          (2 * (Mθ ^ 2 * ((r ^ 2) ^ q)⁻¹) * S))) ∧
      ∀ η : ℝ, 0 < η → ∫⁻ z in K, ENNReal.ofReal (‖cutProd θ f z - G z‖ ^ 2) *
          ENNReal.ofReal (Real.exp (-ϕ z)) * ENNReal.ofReal (((‖z - y‖ ^ 2 + η ^ 2) ^ q)⁻¹) ≤
        ENNReal.ofReal (Real.exp (R ^ 2) * (2 * (Mθ ^ 2 * ((r ^ 2) ^ q)⁻¹) * S)) := by
  set B : ℝ := 2 * (Mθ ^ 2 * ((r ^ 2) ^ q)⁻¹) * S with hB
  have hKD : K ⊆ D := hKKc.trans hKcD
  -- the solutions for `δ_n = 1/(n+1)`
  have hsol : ∀ n : ℕ, ∃ G : ComplexModel d → ℂ, DifferentiableOn ℂ G K ∧
      ∫⁻ z in K, ENNReal.ofReal (‖cutProd θ f z - G z‖ ^ 2 *
          Real.exp (-poleWeight q ϕ y (1 / ((n : ℝ) + 1)) z)) ≤ ENNReal.ofReal B := by
    intro n
    obtain ⟨G, hG, hGb⟩ := exists_poleExtension_delta (p := q) hH hDo hDc hDb
      (δ := 1 / ((n : ℝ) + 1)) (by positivity) hr hϕ hϕL hBϕ y hθ hθcs hθ1 hW hts htsD hf hMθ
      hKo hKKc hKc hKcD
    refine ⟨G, hG, hGb.trans (ENNReal.ofReal_le_ofReal ?_)⟩
    rw [hB]
    exact mul_le_mul_of_nonneg_left hS (by positivity)
  choose G hG hGb using hsol
  have hδ1 : ∀ n : ℕ, 1 / ((n : ℝ) + 1) ≤ 1 := fun n => by
    rw [div_le_one (by positivity)]; linarith [(n.cast_nonneg : (0 : ℝ) ≤ n)]
  have hϕc : ContinuousOn ϕ D := hϕ.continuousOn
  have hcut : Continuous (cutProd θ f) :=
    (contDiff_cutProd hW hθ hf hts).continuous
  have hpolec : ∀ η : ℝ, 0 < η → Continuous fun z : ComplexModel d =>
      ENNReal.ofReal (((‖z - y‖ ^ 2 + η ^ 2) ^ q)⁻¹) := fun η hη =>
    ENNReal.continuous_ofReal.comp (Continuous.inv₀ (by fun_prop) fun z => by positivity)
  -- the integral of `|θ f|² e^{-ϕ}` over `K`
  have hθf : ∫⁻ z in K, ENNReal.ofReal (‖cutProd θ f z‖ ^ 2) * ENNReal.ofReal (Real.exp (-ϕ z)) ≤
      ENNReal.ofReal S := by
    have hint : IntegrableOn (fun z => ‖f z‖ ^ 2 * Real.exp (-ϕ z)) (tsupport θ) :=
      ContinuousOn.integrableOn_compact hθcs
        (((hf.continuousOn.mono hts).norm.pow 2).mul ((hϕc.mono htsD).neg.rexp))
    calc ∫⁻ z in K, ENNReal.ofReal (‖cutProd θ f z‖ ^ 2) * ENNReal.ofReal (Real.exp (-ϕ z))
        ≤ ∫⁻ z, (tsupport θ).indicator
            (fun z => ENNReal.ofReal (‖f z‖ ^ 2 * Real.exp (-ϕ z))) z := by
          refine (setLIntegral_le_lintegral K _).trans (lintegral_mono fun z => ?_)
          by_cases hz : z ∈ tsupport θ
          · rw [indicator_of_mem hz, ← ENNReal.ofReal_mul (sq_nonneg _)]
            refine ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right ?_ (Real.exp_pos _).le)
            refine pow_le_pow_left₀ (norm_nonneg _) ?_ 2
            rw [cutProd, norm_mul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_nonneg (hθ01 z).1]
            exact mul_le_of_le_one_left (norm_nonneg _) (hθ01 z).2
          · have hθz : θ z = 0 := image_eq_zero_of_notMem_tsupport hz
            simp [cutProd, hθz]
      _ = ∫⁻ z in tsupport θ, ENNReal.ofReal (‖f z‖ ^ 2 * Real.exp (-ϕ z)) :=
          lintegral_indicator (isClosed_tsupport θ).measurableSet _
      _ = ENNReal.ofReal (∫ z in tsupport θ, ‖f z‖ ^ 2 * Real.exp (-ϕ z)) :=
          (ofReal_integral_eq_lintegral_ofReal hint
            (Eventually.of_forall fun z => by positivity)).symm
      _ ≤ ENNReal.ofReal S := ENNReal.ofReal_le_ofReal hS
  have hS0 : 0 ≤ S := (setIntegral_nonneg (isClosed_tsupport θ).measurableSet
    fun z _ => by positivity).trans hS
  have hB0 : 0 ≤ B := by rw [hB]; positivity
  have hL2 : ∀ n, ∫⁻ z in K, ENNReal.ofReal (‖G n z‖ ^ 2) * ENNReal.ofReal (Real.exp (-ϕ z)) ≤
      ENNReal.ofReal (2 * S + 2 * ((R ^ 2 + 1) ^ q * Real.exp (R ^ 2) * B)) := by
    intro n
    have hpt : ∀ z ∈ K, ENNReal.ofReal (‖G n z‖ ^ 2) * ENNReal.ofReal (Real.exp (-ϕ z)) ≤
        2 * (ENNReal.ofReal (‖cutProd θ f z‖ ^ 2) * ENNReal.ofReal (Real.exp (-ϕ z))) +
          ENNReal.ofReal (2 * ((R ^ 2 + 1) ^ q * Real.exp (R ^ 2))) *
            ENNReal.ofReal (‖cutProd θ f z - G n z‖ ^ 2 *
              Real.exp (-poleWeight q ϕ y (1 / ((n : ℝ) + 1)) z)) := by
      intro z hz
      obtain ⟨hzR, hzyR⟩ := hR z hz
      have hδ : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
      have hw : Real.exp (-ϕ z) ≤ (R ^ 2 + 1) ^ q * Real.exp (R ^ 2) *
          Real.exp (-poleWeight q ϕ y (1 / ((n : ℝ) + 1)) z) := by
        rw [exp_neg_poleWeight ϕ y hδ z]
        have hden : (‖z - y‖ ^ 2 + (1 / ((n : ℝ) + 1)) ^ 2) ^ q ≤ (R ^ 2 + 1) ^ q := by
          refine pow_le_pow_left₀ (by positivity) ?_ q
          have a1 : ‖z - y‖ ^ 2 ≤ R ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hzyR 2
          have a2 : (1 / ((n : ℝ) + 1)) ^ 2 ≤ 1 := by
            have := hδ1 n
            nlinarith
          linarith
        have hz2 : Real.exp (-‖z‖ ^ 2) * Real.exp (R ^ 2) ≥ 1 := by
          rw [← Real.exp_add, ge_iff_le, Real.one_le_exp_iff]
          have : ‖z‖ ^ 2 ≤ R ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hzR 2
          linarith
        have hpos : 0 < (‖z - y‖ ^ 2 + (1 / ((n : ℝ) + 1)) ^ 2) ^ q := by positivity
        have key : 1 ≤ (R ^ 2 + 1) ^ q * ((‖z - y‖ ^ 2 + (1 / ((n : ℝ) + 1)) ^ 2) ^ q)⁻¹ := by
          rw [← div_eq_mul_inv, one_le_div hpos]; exact hden
        calc Real.exp (-ϕ z) ≤ Real.exp (-ϕ z) *
              ((R ^ 2 + 1) ^ q * ((‖z - y‖ ^ 2 + (1 / ((n : ℝ) + 1)) ^ 2) ^ q)⁻¹) *
              (Real.exp (-‖z‖ ^ 2) * Real.exp (R ^ 2)) := by
              have h0 : 0 ≤ Real.exp (-ϕ z) := (Real.exp_pos _).le
              nlinarith [mul_le_mul key hz2 zero_le_one (by positivity)]
          _ = _ := by ring
      have hnorm : ‖G n z‖ ^ 2 ≤ 2 * ‖cutProd θ f z‖ ^ 2 + 2 * ‖cutProd θ f z - G n z‖ ^ 2 := by
        have h := norm_sub_le (cutProd θ f z) (cutProd θ f z - G n z)
        rw [sub_sub_cancel] at h
        have h2 : ‖G n z‖ ^ 2 ≤ (‖cutProd θ f z‖ + ‖cutProd θ f z - G n z‖) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg _) h 2
        nlinarith [sq_nonneg (‖cutProd θ f z‖ - ‖cutProd θ f z - G n z‖)]
      rw [← ENNReal.ofReal_mul (sq_nonneg _), ← ENNReal.ofReal_mul (sq_nonneg _),
        ← ENNReal.ofReal_mul (by positivity), show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp,
        ← ENNReal.ofReal_mul (by norm_num), ← ENNReal.ofReal_add (by positivity)
          (by positivity)]
      refine ENNReal.ofReal_le_ofReal ?_
      have he : 0 ≤ Real.exp (-ϕ z) := (Real.exp_pos _).le
      have hq : 0 ≤ ‖cutProd θ f z - G n z‖ ^ 2 := sq_nonneg _
      calc ‖G n z‖ ^ 2 * Real.exp (-ϕ z)
          ≤ (2 * ‖cutProd θ f z‖ ^ 2 + 2 * ‖cutProd θ f z - G n z‖ ^ 2) * Real.exp (-ϕ z) :=
            mul_le_mul_of_nonneg_right hnorm he
        _ = 2 * (‖cutProd θ f z‖ ^ 2 * Real.exp (-ϕ z)) +
              2 * (‖cutProd θ f z - G n z‖ ^ 2 * Real.exp (-ϕ z)) := by ring
        _ ≤ 2 * (‖cutProd θ f z‖ ^ 2 * Real.exp (-ϕ z)) +
              2 * (‖cutProd θ f z - G n z‖ ^ 2 * ((R ^ 2 + 1) ^ q * Real.exp (R ^ 2) *
                Real.exp (-poleWeight q ϕ y (1 / ((n : ℝ) + 1)) z))) := by
            gcongr
        _ = _ := by ring
    have hmeas1 : AEMeasurable (fun z => 2 * (ENNReal.ofReal (‖cutProd θ f z‖ ^ 2) *
        ENNReal.ofReal (Real.exp (-ϕ z)))) (volume.restrict K) :=
      (((ENNReal.continuous_ofReal.comp ((hcut.norm).pow 2)).aemeasurable).mul
        ((ENNReal.continuous_ofReal.comp_continuousOn
          ((hϕc.mono hKD).neg.rexp)).aemeasurable hKo.measurableSet)).const_mul _
    calc ∫⁻ z in K, ENNReal.ofReal (‖G n z‖ ^ 2) * ENNReal.ofReal (Real.exp (-ϕ z))
        ≤ ∫⁻ z in K, (2 * (ENNReal.ofReal (‖cutProd θ f z‖ ^ 2) *
            ENNReal.ofReal (Real.exp (-ϕ z))) +
            ENNReal.ofReal (2 * ((R ^ 2 + 1) ^ q * Real.exp (R ^ 2))) *
              ENNReal.ofReal (‖cutProd θ f z - G n z‖ ^ 2 *
                Real.exp (-poleWeight q ϕ y (1 / ((n : ℝ) + 1)) z))) :=
          setLIntegral_mono' hKo.measurableSet hpt
      _ = 2 * (∫⁻ z in K, ENNReal.ofReal (‖cutProd θ f z‖ ^ 2) *
            ENNReal.ofReal (Real.exp (-ϕ z))) +
          ENNReal.ofReal (2 * ((R ^ 2 + 1) ^ q * Real.exp (R ^ 2))) *
            ∫⁻ z in K, ENNReal.ofReal (‖cutProd θ f z - G n z‖ ^ 2 *
              Real.exp (-poleWeight q ϕ y (1 / ((n : ℝ) + 1)) z)) := by
          rw [lintegral_add_left' hmeas1, lintegral_const_mul' (2 : ℝ≥0∞) _ (by simp),
            lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
      _ ≤ 2 * ENNReal.ofReal S +
          ENNReal.ofReal (2 * ((R ^ 2 + 1) ^ q * Real.exp (R ^ 2))) * ENNReal.ofReal B :=
          add_le_add (mul_le_mul_of_nonneg_left hθf zero_le)
            (mul_le_mul_of_nonneg_left (hGb n) zero_le)
      _ = ENNReal.ofReal (2 * S + 2 * ((R ^ 2 + 1) ^ q * Real.exp (R ^ 2) * B)) := by
          rw [show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp, ← ENNReal.ofReal_mul (by norm_num),
            ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_add (by positivity)
              (by positivity)]
          ring_nf
  have hpole : ∀ t : {η : ℝ // 0 < η}, ∀ᶠ n in atTop, ∫⁻ z in K,
      ENNReal.ofReal (‖cutProd θ f z - G n z‖ ^ 2) * ENNReal.ofReal (Real.exp (-ϕ z)) *
        ENNReal.ofReal (((‖z - y‖ ^ 2 + t.1 ^ 2) ^ q)⁻¹) ≤
      ENNReal.ofReal (Real.exp (R ^ 2) * B) := by
    intro t
    obtain ⟨η, hη⟩ := t
    obtain ⟨n₀, hn₀⟩ := exists_nat_one_div_lt hη
    filter_upwards [eventually_ge_atTop n₀] with n hn
    have hδη : 1 / ((n : ℝ) + 1) ≤ η := by
      refine le_trans ?_ hn₀.le
      gcongr
    calc ∫⁻ z in K, ENNReal.ofReal (‖cutProd θ f z - G n z‖ ^ 2) *
          ENNReal.ofReal (Real.exp (-ϕ z)) * ENNReal.ofReal (((‖z - y‖ ^ 2 + η ^ 2) ^ q)⁻¹)
        ≤ ∫⁻ z in K, ENNReal.ofReal (Real.exp (R ^ 2)) *
            ENNReal.ofReal (‖cutProd θ f z - G n z‖ ^ 2 *
              Real.exp (-poleWeight q ϕ y (1 / ((n : ℝ) + 1)) z)) := by
          refine setLIntegral_mono' hKo.measurableSet fun z hz => ?_
          rw [← ENNReal.ofReal_mul (sq_nonneg _), ← ENNReal.ofReal_mul (by positivity),
            ← ENNReal.ofReal_mul (by positivity)]
          refine ENNReal.ofReal_le_ofReal ?_
          have := exp_neg_mul_pole_le (ϕ := ϕ) (y := y) (q := q) (by positivity) hδη (hR z hz).1
          have hq : 0 ≤ ‖cutProd θ f z - G n z‖ ^ 2 := sq_nonneg _
          calc ‖cutProd θ f z - G n z‖ ^ 2 * Real.exp (-ϕ z) * ((‖z - y‖ ^ 2 + η ^ 2) ^ q)⁻¹
              = ‖cutProd θ f z - G n z‖ ^ 2 *
                  (Real.exp (-ϕ z) * ((‖z - y‖ ^ 2 + η ^ 2) ^ q)⁻¹) := by ring
            _ ≤ ‖cutProd θ f z - G n z‖ ^ 2 * (Real.exp (R ^ 2) *
                  Real.exp (-poleWeight q ϕ y (1 / ((n : ℝ) + 1)) z)) :=
                mul_le_mul_of_nonneg_left this hq
            _ = _ := by ring
      _ = ENNReal.ofReal (Real.exp (R ^ 2)) * ∫⁻ z in K,
            ENNReal.ofReal (‖cutProd θ f z - G n z‖ ^ 2 *
              Real.exp (-poleWeight q ϕ y (1 / ((n : ℝ) + 1)) z)) :=
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
      _ ≤ ENNReal.ofReal (Real.exp (R ^ 2)) * ENNReal.ofReal B := by gcongr; exact hGb n
      _ = ENNReal.ofReal (Real.exp (R ^ 2) * B) := (ENNReal.ofReal_mul (by positivity)).symm

  -- the limit
  obtain ⟨G', hG', h1, h2⟩ := exists_limit_of_weighted_poleBounds hKo
    (w := fun _ z => ENNReal.ofReal (Real.exp (-ϕ z))) (fun _ _ => monotone_const)
    (fun _ => (ENNReal.continuous_ofReal.comp_continuousOn
      ((hϕc.mono hKD).neg.rexp)).aemeasurable hKo.measurableSet)
    (fun x hx => by
      have hcont : ContinuousAt ϕ x := hϕc.continuousAt (hDo.mem_nhds (hKD hx))
      obtain ⟨r₁, hr₁, hball⟩ := Metric.continuousAt_iff.mp hcont 1 one_pos
      refine ⟨r₁, hr₁, Real.exp (-(ϕ x + 1)), Real.exp_pos _, fun z hz => ?_⟩
      refine ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr ?_)
      have := hball hz
      rw [Real.dist_eq, abs_lt] at this
      linarith)
    (T := {η : ℝ // 0 < η})
    (P := fun t z => ENNReal.ofReal (((‖z - y‖ ^ 2 + t.1 ^ 2) ^ q)⁻¹))
    (fun t => (hpolec t.1 t.2).aemeasurable) hcut.continuousOn hG
    (A₁ := ENNReal.ofReal (2 * S + 2 * ((R ^ 2 + 1) ^ q * Real.exp (R ^ 2) * B)))
    (A₂ := ENNReal.ofReal (Real.exp (R ^ 2) * B)) ENNReal.ofReal_ne_top
    hL2 hpole
  refine ⟨G', hG', ?_, fun η hη => ?_⟩
  · simpa only [iSup_const] using h1
  · simpa only [iSup_const] using h2 ⟨η, hη⟩

end Smooth

/-! ### The singular weight: smoothing, then truncation -/

section Singular

variable {d : ℕ}

open Pluripotential.MongeAmpere QuantitativeRegularizationTruncationLimit
  QuantitativeRegularizationSmoothWeightLimit

/-- **Hörmander's extension with a point pole, for a plurisubharmonic weight `cΨ`** (possibly
`-∞` somewhere).  With the data of `exists_poleExtension_smooth` and `Ψ` psh on a neighbourhood
`Ω` of the closure of the bounded convex open `L`, there is `G` holomorphic on `K ⋐ L` with
`∫_K |G|² e^{-cΨ} ≤ A₁` and `∫_K |θ f - G|² e^{-cΨ} (|z - y|² + η²)^{-q} ≤ A₂` for every `η > 0`,
where `A₁, A₂` are explicit in an upper bound `S` of `∫_{supp θ} |f|² e^{-cΨ}`.  Two applications
of `exists_limit_of_weighted_poleBounds`: the mollified truncations `max(Ψ, -k) * ρ_ε` (smooth),
then the truncations. -/
theorem exists_poleExtension_psh (hH : HormanderL2Estimate d)
    {Ω : TopologicalSpace.Opens (ComplexModel d)} {Ψ : ComplexModel d → EReal}
    (hΨ : PlurisubharmonicOn Ψ Ω) {c : ℝ} (hc : 0 < c)
    {L : Set (ComplexModel d)} (hLo : IsOpen L) (hLc : Convex ℝ L)
    (hLb : Bornology.IsBounded L) (hLΩ : closure L ⊆ Ω)
    (y : ComplexModel d) {r : ℝ} (hr : 0 < r) {θ : ComplexModel d → ℝ} (hθ : ContDiff ℝ ∞ θ)
    (hθcs : HasCompactSupport θ) (hθ1 : ∀ z ∈ ball y r, θ z = 1)
    (hθ01 : ∀ z, 0 ≤ θ z ∧ θ z ≤ 1)
    {W : Set (ComplexModel d)} (hW : IsOpen W) (hts : tsupport θ ⊆ W) (htsL : tsupport θ ⊆ L)
    {f : ComplexModel d → ℂ} (hf : DifferentiableOn ℂ f W)
    {Mθ : ℝ} (hMθ : ∀ z, ‖fderiv ℝ θ z‖ ≤ Mθ)
    {K Kc : Set (ComplexModel d)} (hKo : IsOpen K) (hKKc : K ⊆ Kc) (hKc : IsCompact Kc)
    (hKcL : Kc ⊆ L) (q : ℕ) {S : ℝ} (hS0 : 0 ≤ S)
    (hS : ∫⁻ z in tsupport θ, ENNReal.ofReal (‖f z‖ ^ 2) * multiplierWeight c (Ψ z) ≤
      ENNReal.ofReal S)
    {R : ℝ} (hR : ∀ z ∈ K, ‖z‖ ≤ R ∧ ‖z - y‖ ≤ R) :
    ∃ G : ComplexModel d → ℂ, DifferentiableOn ℂ G K ∧
      ∫⁻ z in K, ENNReal.ofReal (‖G z‖ ^ 2) * multiplierWeight c (Ψ z) ≤
        ENNReal.ofReal (2 * S + 2 * ((R ^ 2 + 1) ^ q * Real.exp (R ^ 2) *
          (2 * (Mθ ^ 2 * ((r ^ 2) ^ q)⁻¹) * S))) ∧
      ∀ η : ℝ, 0 < η → ∫⁻ z in K, ENNReal.ofReal (‖cutProd θ f z - G z‖ ^ 2) *
          multiplierWeight c (Ψ z) * ENNReal.ofReal (((‖z - y‖ ^ 2 + η ^ 2) ^ q)⁻¹) ≤
        ENNReal.ofReal (Real.exp (R ^ 2) * (2 * (Mθ ^ 2 * ((r ^ 2) ^ q)⁻¹) * S)) := by
  set A₁ : ℝ := 2 * S + 2 * ((R ^ 2 + 1) ^ q * Real.exp (R ^ 2) *
    (2 * (Mθ ^ 2 * ((r ^ 2) ^ q)⁻¹) * S)) with hA₁
  set A₂ : ℝ := Real.exp (R ^ 2) * (2 * (Mθ ^ 2 * ((r ^ 2) ^ q)⁻¹) * S) with hA₂
  have hLΩ' : L ⊆ Ω := subset_closure.trans hLΩ
  have hKL : K ⊆ L := hKKc.trans hKcL
  have hKΩ : K ⊆ Ω := hKL.trans hLΩ'
  let A : TopologicalSpace.Opens (ComplexModel d) := ⟨L, hLo⟩
  have hA : RelativelyCompactIn A Ω := ⟨hLb.isCompact_closure, hLΩ⟩
  have hpolec : ∀ η : ℝ, 0 < η → Continuous fun z : ComplexModel d =>
      ENNReal.ofReal (((‖z - y‖ ^ 2 + η ^ 2) ^ q)⁻¹) := fun η hη =>
    ENNReal.continuous_ofReal.comp (Continuous.inv₀ (by fun_prop) fun z => by positivity)
  have hcut : Continuous (cutProd θ f) := (contDiff_cutProd hW hθ hf hts).continuous
  -- one truncation level
  have hlevel : ∀ k : ℕ, ∃ G : ComplexModel d → ℂ, DifferentiableOn ℂ G K ∧
      ∫⁻ z in K, ENNReal.ofReal (‖G z‖ ^ 2) * truncationWeight c Ψ k z ≤ ENNReal.ofReal A₁ ∧
      ∀ t : {η : ℝ // 0 < η}, ∫⁻ z in K, ENNReal.ofReal (‖cutProd θ f z - G z‖ ^ 2) *
          truncationWeight c Ψ k z * ENNReal.ofReal (((‖z - y‖ ^ 2 + t.1 ^ 2) ^ q)⁻¹) ≤
        ENNReal.ofReal A₂ := by
    intro k
    obtain ⟨fs, hfs⟩ := HolomorphicPullback.exists_decreasingMollifierApproximation
      (truncationReal_isLocallyBoundedPshOn hΨ k) hA
    have hge : ∀ j, ∀ z ∈ L, truncationReal Ψ k z ≤ fs j z := fun j z hz =>
      (hfs.2.1 z hz).le_of_tendsto (hfs.2.2 z hz) j
    have hΨle : ∀ z ∈ L, Ψ z ≤ ((fs 0 z : ℝ) : EReal) ∧ ∀ j, Ψ z ≤ ((fs j z : ℝ) : EReal) := by
      intro z hz
      have h0 : Ψ z ≤ (truncationReal Ψ k z : EReal) := by
        rw [coe_truncationReal hΨ k (hLΩ' hz)]
        exact le_max_left _ _
      exact ⟨h0.trans (EReal.coe_le_coe_iff.mpr (hge 0 z hz)),
        fun j => h0.trans (EReal.coe_le_coe_iff.mpr (hge j z hz))⟩
    have hlow : ∀ z ∈ L, -(k : ℝ) ≤ truncationReal Ψ k z := fun z hz => by
      have h := truncation_lower_bound Ψ k z
      rw [← coe_truncationReal hΨ k (hLΩ' hz)] at h
      exact EReal.coe_le_coe_iff.mp h
    have hsmooth : ∀ j, ∃ G : ComplexModel d → ℂ, DifferentiableOn ℂ G K ∧
        ∫⁻ z in K, ENNReal.ofReal (‖G z‖ ^ 2) * ENNReal.ofReal (Real.exp (-(c * fs j z))) ≤
          ENNReal.ofReal A₁ ∧
        ∀ η : ℝ, 0 < η → ∫⁻ z in K, ENNReal.ofReal (‖cutProd θ f z - G z‖ ^ 2) *
            ENNReal.ofReal (Real.exp (-(c * fs j z))) *
              ENNReal.ofReal (((‖z - y‖ ^ 2 + η ^ 2) ^ q)⁻¹) ≤ ENNReal.ofReal A₂ := by
      intro j
      have hϕ : ContDiffOn ℝ ∞ (fun z => c * fs j z) L := contDiffOn_const.mul (hfs.1 j).1
      have hϕL : ∀ z ∈ L, ∀ ξ, 0 ≤ leviForm (fun z => c * fs j z) z ξ := by
        intro z hz ξ
        have h0 := leviForm_nonneg_of_contDiffOn_plurisubharmonicOn (U := A) (hfs.1 j).1
          (hfs.1 j).2.1 hz ξ
        have h2 : ContDiffAt ℝ 2 (fs j) z :=
          (((hfs.1 j).1 z hz).contDiffAt (hLo.mem_nhds hz)).of_le
            (WithTop.coe_le_coe.mpr le_top)
        have h3 := leviForm_smul h2 c ξ
        change 0 ≤ leviForm (c • fs j) z ξ
        rw [h3]
        exact mul_nonneg hc.le h0
      have hBϕ : ∀ z ∈ L, -(c * k) ≤ c * fs j z := fun z hz => by
        have := (hlow z hz).trans (hge j z hz)
        nlinarith
      have hSj : ∫ z in tsupport θ, ‖f z‖ ^ 2 * Real.exp (-(c * fs j z)) ≤ S := by
        have hcont : ContinuousOn (fun z => ‖f z‖ ^ 2 * Real.exp (-(c * fs j z))) (tsupport θ) :=
          ((hf.continuousOn.mono hts).norm.pow 2).mul
            ((continuousOn_const.mul (((hfs.1 j).1.continuousOn).mono htsL)).neg.rexp)
        rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall fun z => by positivity)
          (hcont.aestronglyMeasurable (isClosed_tsupport θ).measurableSet)]
        refine ENNReal.toReal_le_of_le_ofReal hS0 (le_trans ?_ hS)
        refine setLIntegral_mono' (isClosed_tsupport θ).measurableSet fun z hz => ?_
        rw [ENNReal.ofReal_mul (sq_nonneg _), ← multiplierWeight_coe]
        exact mul_le_mul_of_nonneg_left
          (multiplierWeight_antitone hc.le ((hΨle z (htsL hz)).2 j)) zero_le
      exact exists_poleExtension_smooth hH hLo hLc hLb hϕ hϕL hBϕ y hr hθ hθcs hθ1 hθ01 hW hts
        htsL hf hMθ hKo hKKc hKc hKcL q hSj hR
    choose G hG h1 h2 using hsmooth
    obtain ⟨G', hG', h1', h2'⟩ := exists_limit_of_weighted_poleBounds hKo
      (w := fun j z => multiplierWeight c ((fs j z : ℝ) : EReal))
      (fun x hx => smoothWeight_monotone hfs hc.le (hKL hx))
      (fun j => aemeasurable_smoothWeight hfs j hKo.measurableSet hKL)
      (fun x hx => exists_lower_bound_smoothWeight_zero hfs hc.le (hKL hx))
      (T := {η : ℝ // 0 < η})
      (P := fun t z => ENNReal.ofReal (((‖z - y‖ ^ 2 + t.1 ^ 2) ^ q)⁻¹))
      (fun t => (hpolec t.1 t.2).aemeasurable) hcut.continuousOn hG ENNReal.ofReal_ne_top
      (fun j => by simpa only [multiplierWeight_coe] using h1 j)
      (fun t => Eventually.of_forall fun j => by
        simpa only [multiplierWeight_coe] using h2 j t.1 t.2)
    have hsup : ∀ z ∈ K, (⨆ j, multiplierWeight c ((fs j z : ℝ) : EReal)) =
        truncationWeight c Ψ k z := fun z hz =>
      (iSup_smoothWeight hfs hc.le (hKL hz)).symm
    refine ⟨G', hG', (setLIntegral_congr_fun hKo.measurableSet fun z hz => ?_).trans_le h1',
      fun t => (setLIntegral_congr_fun hKo.measurableSet fun z hz => ?_).trans_le (h2' t)⟩
    · rw [hsup z hz]
    · rw [hsup z hz]
  choose G hG h1 h2 using hlevel
  obtain ⟨G', hG', h1', h2'⟩ := exists_limit_of_weighted_poleBounds hKo
    (w := fun k z => truncationWeight c Ψ k z)
    (fun x hx => truncationWeight_monotone hΨ hc.le (hKΩ hx))
    (fun k => aemeasurable_truncationWeight hΨ k hKo hKΩ)
    (fun x hx => exists_lower_bound_truncationWeight_zero hΨ hc.le (hKΩ hx))
    (T := {η : ℝ // 0 < η})
    (P := fun t z => ENNReal.ofReal (((‖z - y‖ ^ 2 + t.1 ^ 2) ^ q)⁻¹))
    (fun t => (hpolec t.1 t.2).aemeasurable) hcut.continuousOn hG ENNReal.ofReal_ne_top h1
    (fun t => Eventually.of_forall fun k => h2 k t)
  have hsup : ∀ z ∈ K, (⨆ k, truncationWeight c Ψ k z) = multiplierWeight c (Ψ z) :=
    fun z hz => (iSup_truncationWeight hΨ hc (hKΩ hz)).symm
  refine ⟨G', hG', (setLIntegral_congr_fun hKo.measurableSet fun z hz => ?_).trans_le h1',
    fun η hη => (setLIntegral_congr_fun hKo.measurableSet fun z hz => ?_).trans_le
      (h2' ⟨η, hη⟩)⟩
  · rw [hsup z hz]
  · rw [hsup z hz]

end Singular

end

end ComplexGeometry.AnalyticGeometry.MultiplierIdealBergmanNadelExtension
