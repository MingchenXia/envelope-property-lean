import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.MultiplierIdealBergmanNadelIdeal
import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.MultiplierIdealBergmanNadelGeneration
import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.DemaillyApproximation

set_option autoImplicit false

/-!
# Nadel's coherence theorem in `ℂⁿ`: the multiplier ideal is locally finitely generated

For `Ψ` plurisubharmonic on an open `Ω ⊆ ℂ^{m+1}` and `c > 0`, every point `z ∈ Ω` has a ball
`B(z, r)` and finitely many holomorphic `g_1, …, g_N` on it, each `L²` for `e^{-cΨ}` near every
point of the ball, such that at every `y ∈ B(z, r)` every germ which is `L²` for `e^{-cΨ}` near
`y` is a combination `∑ a_l g_l` with holomorphic germs `a_l` (`exists_local_generators`). The
converse inclusion is the elementary closure of `𝓘(cΨ)_y` under sums and holomorphic
multiples. This is Nadel's coherence theorem (Demailly, *Analytic methods in algebraic
geometry*, Prop. 5.7) without Oka's theorem:

* Nadel's identity (`MultiplierIdealBergmanNadelIdeal.inGermSpan_bergmanSpace`): every such
  germ at `y` is in the ideal generated by the weighted Bergman space of `B(z, 2R)`;
* uniform generation (`MultiplierIdealBergmanNadelGeneration.exists_uniform_span_generators`,
  Baire): the unit ball of that Bergman space is generated on `B(z, r)` by finitely many of its
  members.

-/

open Set Filter MeasureTheory Metric
open scoped Topology ENNReal

namespace ComplexGeometry.AnalyticGeometry.MultiplierIdealBergmanNadelCoherence

noncomputable section

open Pluripotential BergmanGenerators MultiplierIdealBergmanNadelIdeal
  MultiplierIdealBergmanNadelGeneration

variable {m : ℕ}

/-- A member of the weighted Bergman space of `ball z (2R)` has a nonzero multiple in the unit
ball. -/
theorem exists_smul_mem_bergmanUnitBall {z : ComplexModel (m + 1)} {R : ℝ}
    {w : ComplexModel (m + 1) → ℝ≥0∞} {G : ComplexModel (m + 1) → ℂ}
    (hG : G ∈ bergmanSpace (ball z (2 * R)) w) :
    ∃ μ : ℂ, μ ≠ 0 ∧ (fun x => μ * G x) ∈ bergmanUnitBall z R w := by
  set I : ℝ≥0∞ := ∫⁻ x in ball z (2 * R), ENNReal.ofReal (‖G x‖ ^ 2) * w x with hI
  have hItop : I ≠ ⊤ := hG.2
  set t : ℝ := 1 / (I.toReal + 1) with ht
  have htpos : 0 < t := by positivity
  refine ⟨(Real.sqrt t : ℂ), by exact_mod_cast (Real.sqrt_pos.mpr htpos).ne',
    hG.1.const_mul _, ?_⟩
  have hpt : ∀ x, ENNReal.ofReal (‖(Real.sqrt t : ℂ) * G x‖ ^ 2) * w x =
      ENNReal.ofReal t * (ENNReal.ofReal (‖G x‖ ^ 2) * w x) := fun x => by
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (Real.sqrt_nonneg _), mul_pow,
      Real.sq_sqrt htpos.le, ENNReal.ofReal_mul htpos.le, mul_assoc]
  simp_rw [hpt]
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, ← hI,
    ← ENNReal.ofReal_toReal hItop, ← ENNReal.ofReal_mul htpos.le, ENNReal.ofReal_le_one]
  rw [ht, one_div, inv_mul_le_iff₀ (by positivity)]
  linarith

/-- **Nadel's coherence theorem in a chart.**  For `Ψ` psh on an open `Ω ⊆ ℂ^{m+1}` and `c > 0`,
every `z ∈ Ω` has a ball `B(z, r) ⊆ Ω` and finitely many `g_l` holomorphic on it, each in
`𝓘(cΨ)` at every point of the ball, which generate `𝓘(cΨ)_y` at every `y ∈ B(z, r)`. -/
theorem exists_local_generators {Ω : TopologicalSpace.Opens (ComplexModel (m + 1))}
    {Ψ : ComplexModel (m + 1) → EReal} (hΨ : PlurisubharmonicOn Ψ Ω) {c : ℝ} (hc : 0 < c)
    {z : ComplexModel (m + 1)} (hz : z ∈ Ω) :
    ∃ r > 0, ∃ (N : ℕ) (g : Fin N → ComplexModel (m + 1) → ℂ),
      ball z r ⊆ Ω ∧ (∀ l, DifferentiableOn ℂ (g l) (ball z r)) ∧
      (∀ l, ∀ y ∈ ball z r, MultiplierIntegrableAt Ψ c (g l) y volume) ∧
      ∀ y ∈ ball z r, ∀ f : ComplexModel (m + 1) → ℂ,
        MultiplierIntegrableAt Ψ c f y volume → InGermSpan (range g) y f := by
  classical
  obtain ⟨R₀, hR₀, hR₀Ω⟩ := Metric.isOpen_iff.mp Ω.isOpen z hz
  set R : ℝ := R₀ / 4 with hRdef
  have hR : 0 < R := by positivity
  have hLΩ : closure (ball z (3 * R)) ⊆ Ω := by
    rw [closure_ball z (by positivity)]
    exact (closedBall_subset_ball (by rw [hRdef]; linarith)).trans hR₀Ω
  have hKL : closure (ball z (2 * R)) ⊆ ball z (3 * R) := by
    rw [closure_ball z (by positivity)]
    exact closedBall_subset_ball (by linarith)
  have h2RΩ : ball z (2 * R) ⊆ Ω :=
    (ball_subset_ball (by linarith)).trans (subset_closure.trans hLΩ)
  set w : ComplexModel (m + 1) → ℝ≥0∞ := fun x => multiplierWeight c (Ψ x) with hwdef
  have hw : AEMeasurable w (volume.restrict (ball z (2 * R))) :=
    DemaillyApproximation.aemeasurable_multiplierWeight_restrict isOpen_ball
      (hΨ.upperSemicontinuousOn.mono h2RΩ) hc.ne'
  have hcb : closedBall z (2 * R) ⊆ (Ω : Set (ComplexModel (m + 1))) := by
    rw [← closure_ball z (by positivity)]
    exact (closure_mono (ball_subset_ball (by linarith))).trans hLΩ
  obtain ⟨Cu, -, hCu⟩ := hΨ.exists_nonnegative_compact_upper_bound
    (isCompact_closedBall z (2 * R)) hcb
  have hlow : ∀ y ∈ ball z (2 * R), ENNReal.ofReal (Real.exp (-(c * Cu))) ≤ w y := by
    intro y hy
    rw [hwdef, ← multiplierWeight_coe]
    exact multiplierWeight_antitone hc.le (hCu y (ball_subset_closedBall hy))
  obtain ⟨N, g, r₀, Cg, hr₀, hgX, hspan⟩ :=
    exists_uniform_span_generators hR hw (Real.exp_pos _) hlow
  set r : ℝ := min r₀ R with hrdef
  have hr : 0 < r := lt_min hr₀ hR
  have hrr₀ : ball z r ⊆ ball z r₀ := ball_subset_ball (min_le_left _ _)
  have hr2R : ball z r ⊆ ball z (2 * R) :=
    ball_subset_ball ((min_le_right _ _).trans (by linarith))
  have hgint : ∀ l, ∀ y ∈ ball z (2 * R), MultiplierIntegrableAt Ψ c (g l) y volume := by
    intro l y hy
    refine ⟨hc, ball z (2 * R), isOpen_ball, hy, (hgX l).1, ?_, ?_⟩
    · exact ((ENNReal.continuous_ofReal.comp_continuousOn
        (((hgX l).1.continuousOn).norm.pow 2)).aemeasurable isOpen_ball.measurableSet).mul hw
    · exact (hgX l).2.trans_lt ENNReal.one_lt_top
  refine ⟨r, hr, N, g, hr2R.trans h2RΩ, fun l => (hgX l).1.mono hr2R,
    fun l y hy => hgint l y (hr2R hy), fun y hy f hf => ?_⟩
  -- Nadel's identity at `y`
  obtain ⟨-, U, hU, hyU, hfU, hfL2⟩ := hf
  obtain ⟨ρ, hρ, hρU⟩ := Metric.isOpen_iff.mp hU y hyU
  have hint : ∫⁻ x in ball y ρ, ENNReal.ofReal (‖f x‖ ^ 2) * multiplierWeight c (Ψ x) ≠ ⊤ :=
    ne_top_of_le_ne_top hfL2.2.ne (lintegral_mono_set hρU)
  obtain ⟨N', s, a, hs, ha, he⟩ := inGermSpan_bergmanSpace hΨ hc isOpen_ball (convex_ball _ _)
    isBounded_ball hLΩ isOpen_ball hKL (hr2R hy) hρ (hfU.mono hρU) hint
  -- each generator of the Bergman ideal is a combination of the `g_l` on `ball z r₀`
  have hcomb : ∀ i, ∃ (μ : ℂ) (b : Fin N → ComplexModel (m + 1) → ℂ), μ ≠ 0 ∧
      (∀ l, DifferentiableOn ℂ (b l) (ball z r₀)) ∧
      ∀ x ∈ ball z r₀, μ * s i x = ∑ l, b l x * g l x := by
    intro i
    obtain ⟨μ, hμ, hμX⟩ := exists_smul_mem_bergmanUnitBall (hs i)
    obtain ⟨b, hb, -, hbe⟩ := hspan _ hμX
    exact ⟨μ, b, hμ, hb, hbe⟩
  choose μ b hμ hb hbe using hcomb
  refine ⟨N, g, fun l x => ∑ i, a i x * (μ i)⁻¹ * b i l x, fun l => ⟨l, rfl⟩, fun l => ?_, ?_⟩
  · have hbnhds : ∀ i, ∀ᶠ x in 𝓝 y, DifferentiableAt ℂ (b i l) x := fun i =>
      Filter.eventually_of_mem (isOpen_ball.mem_nhds (hrr₀ hy)) fun x hx =>
        (hb i l).differentiableAt (isOpen_ball.mem_nhds hx)
    filter_upwards [eventually_all.mpr ha, eventually_all.mpr hbnhds] with x hxa hxb
    exact DifferentiableAt.fun_sum fun i _ => ((hxa i).mul_const _).mul (hxb i)
  · filter_upwards [he, isOpen_ball.mem_nhds (hrr₀ hy)] with x hx hxr
    rw [hx]
    have hsx : ∀ i, s i x = (μ i)⁻¹ * ∑ l, b i l x * g l x := fun i => by
      rw [← hbe i x hxr, ← mul_assoc, inv_mul_cancel₀ (hμ i), one_mul]
    simp_rw [hsx, Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun l _ => Finset.sum_congr rfl fun i _ => ?_
    ring

end

end ComplexGeometry.AnalyticGeometry.MultiplierIdealBergmanNadelCoherence
