variable {n : ℕ}

/-! ### Principal monomial ideals at a point -/

section Principal

variable {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]

open Classical in
/-- **A principal monomial ideal at `z`**: in centred flat coordinates `Φ` at `z` in which every member `E_i` through
`z` is the hyperplane `{Φ_{σ i} = 0}` (`σ` injective on these members), the stalk `𝔞_z` is generated by
`∏_{z ∈ E_i} Φ_{σ i}^{a_i}`. -/
def IsPrincipalAt (𝔞 : GermIdeal n M) (E : List (Set M)) (z : M) (a : Fin E.length → ℕ) : Prop :=
  ∃ (Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) z z)) (σ : Fin E.length → Fin n),
    Φ.source ⊆ (chartAt (ComplexModel n) z).target ∧ Φ.toFun (chartAt (ComplexModel n) z z) = 0 ∧
    Set.InjOn σ {i | z ∈ E.get i} ∧
    (∀ i, z ∈ E.get i → ∀ {y : M}, y ∈ (chartAt (ComplexModel n) z).source →
      chartAt (ComplexModel n) z y ∈ Φ.source → (y ∈ E.get i ↔ Φ.toFun (chartAt (ComplexModel n) z y) (σ i) = 0)) ∧
    ∀ g, 𝔞.mem z g ↔
      IsInSpanAt (n := n) (· = fun y => ∏ i ∈ Finset.univ.filter (fun i => z ∈ E.get i), flatCoord Φ (σ i) y ^ a i) z g

/-- Exponent data on `Fin E.length`, extended by `0` to `ℕ`. -/
def extExp (E : List (Set M)) (a : Fin E.length → ℕ) (i : ℕ) : ℕ :=
  if h : i < E.length then a ⟨i, h⟩ else 0

variable {𝔞 : GermIdeal n M} {E : List (Set M)} {z : M} {a : Fin E.length → ℕ}

open Classical in
/-- From the stalk at `z` to a neighbourhood of `z` (coherence). -/
theorem IsPrincipalAt.eventually (h𝔞 : 𝔞.IsCoherent) (h : IsPrincipalAt 𝔞 E z a) :
    ∃ (Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) z z)) (σ : Fin E.length → Fin n),
      Φ.source ⊆ (chartAt (ComplexModel n) z).target ∧
      Set.InjOn σ (Finset.univ.filter fun i => z ∈ E.get i) ∧
      (∀ i ∈ Finset.univ.filter (fun i => z ∈ E.get i), ∀ {y : M}, y ∈ (chartAt (ComplexModel n) z).source →
        chartAt (ComplexModel n) z y ∈ Φ.source → (y ∈ E.get i ↔ Φ.toFun (chartAt (ComplexModel n) z y) (σ i) = 0)) ∧
      ∀ᶠ y in 𝓝 z, ∀ g, 𝔞.mem y g ↔
        IsInSpanAt (n := n) (· = fun y => ∏ i ∈ Finset.univ.filter (fun i => z ∈ E.get i),
          flatCoord Φ (σ i) y ^ a i) y g := by
  obtain ⟨Φ, σ, hΦsrc, -, hσ, hA, hgen⟩ := h
  refine ⟨Φ, σ, hΦsrc, fun i hi j hj hij => hσ (by simpa using hi) (by simpa using hj) hij,
    fun i hi => hA i (Finset.mem_filter.mp hi).2, ?_⟩
  exact eventually_isInSpanAt_iff_of_isCoherent h𝔞
    (holomorphicAt_flatMonomial (σ := σ) a (mem_flatDomain_self Φ)) hgen

open Classical in
/-- **A principal monomial ideal is nonzero** at `z`. -/
theorem IsPrincipalAt.isNonzeroAt (h𝔞 : 𝔞.IsCoherent) (h : IsPrincipalAt 𝔞 E z a) : IsNonzeroAt 𝔞 z := by
  obtain ⟨Φ, σ, hΦsrc, hσ, hA, hgen⟩ := h.eventually h𝔞
  exact (eventually_isNonzeroAt_of_principal hΦsrc a hgen).self_of_nhds

open Classical in
/-- **A principal monomial ideal is monomial** at `z`. -/
theorem IsPrincipalAt.monomialPart_le (hn : 0 < n) (hE : IsSNCDivisor n E) (h𝔞 : 𝔞.IsCoherent)
    (h : IsPrincipalAt 𝔞 E z a) (g : M → ℂ) (hg : (monomialPart n 𝔞 E).mem z g) : 𝔞.mem z g := by
  obtain ⟨Φ, σ, hΦsrc, hσ, hA, hgen⟩ := h.eventually h𝔞
  exact (eventually_monomialPart_le_of_principal hΦsrc hσ hA a hgen hn hE h𝔞 (fun i => by simp)).self_of_nhds g hg

open Classical in
/-- **The invariant of a principal monomial ideal** at `z` is that of its exponents. -/
theorem IsPrincipalAt.gamma_eq (h𝔞 : 𝔞.IsCoherent) (h : IsPrincipalAt 𝔞 E z a) (d : ℕ) :
    gamma n 𝔞 E d z = inv n (memberIdx E z) (extExp E a) d := by
  obtain ⟨Φ, σ, hΦsrc, hσ, hA, hgen⟩ := h.eventually h𝔞
  exact gamma_eq_of_principal hΦsrc hσ hA a hgen
    (fun _ _ hg => RelativePrincipalizationSpan.GermIdeal.IsCoherent.holomorphicAt_mem h𝔞 hg) (fun i => by simp) d

open Classical in
/-- **A monomial ideal is principal at every point**, generated by `∏_{x ∈ E_i} u_{σ i}^{e_i(x)}` in simple normal
crossings coordinates (`MonomialCase.exists_snc_chart`), `e_i = divExp 𝔞 E_i`: every germ of `𝔞 ⊆ 𝓜(𝔞)` is a multiple
of the monomial (`MonomialPart.exists_eq_mul_prod_of_forall`), and the monomial lies in `𝓜(𝔞) ⊆ 𝔞`. -/
theorem isPrincipalAt_of_monomial (hn : 0 < n) (hE : IsSNCDivisor n E) (h𝔞 : 𝔞.IsCoherent)
    (hmono : (monomialPart n 𝔞 E).Le 𝔞) (x : M) :
    IsPrincipalAt 𝔞 E x (fun i => divExp n 𝔞 (E.get i) x) := by
  obtain ⟨Φ, σ, hΦsrc, hΦx, hσ, hA⟩ := exists_snc_chart hn hE x
  set T : Finset (Fin E.length) := Finset.univ.filter fun i => x ∈ E.get i with hT_def
  set e : Fin E.length → ℕ := fun i => divExp n 𝔞 (E.get i) x
  have hx : x ∈ flatDomain Φ := mem_flatDomain_self Φ
  refine ⟨Φ, σ, hΦsrc, hΦx, fun i hi j hj hij =>
    hσ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩) (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj⟩) hij, hA,
    fun g => ?_⟩
  -- the monomial lies in `𝓜(𝔞)_x`
  have hmM : (monomialPart n 𝔞 E).mem x (fun z => ∏ i ∈ T, flatCoord Φ (σ i) z ^ e i) := by
    refine ⟨holomorphicAt_finset_prod T fun i _ =>
      CompanionReduction.holomorphicAt_pow_of (holomorphicAt_flatCoord Φ (σ i) hx) (e i), fun i hxi => ?_⟩
    have hi : i ∈ T := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hxi⟩
    exact flatMonomial_mem_idealPow_vanishingIdeal (fun i hi => hA i (Finset.mem_filter.mp hi).2) e hi
  constructor
  · intro hg
    have hgM := le_monomialPart hn hE h𝔞 x g hg
    have hdiv : ∀ i ∈ T, ∃ c, HolomorphicAt n c x ∧ g =ᶠ[𝓝 x] fun z => c z * flatMap Φ z (σ i) ^ e i := by
      intro i hi
      have hxi : x ∈ E.get i := (Finset.mem_filter.mp hi).2
      exact exists_eq_mul_pow_of_mem_idealPow
        (fun g hg => (vanishingIdeal_mem_iff_flatCoord Φ (hA i hxi) hx g).mp hg) (hgM.2 i hxi)
    obtain ⟨c, hc, hgc⟩ := exists_eq_mul_prod_of_forall hΦsrc (A := fun i => E.get i) e hx T
      (fun i hi _ hy1 hy2 => hA i (Finset.mem_filter.mp hi).2 hy1 hy2)
      (fun i _ y hy => (isClosedSubmanifold_get hn hE i).2 y hy) hσ hgM.1 hdiv
    exact isInSpanAt_eq_iff.mpr ⟨hgM.1, c, hc, hgc⟩
  · intro hg
    have hm𝔞 := hmono x _ hmM
    exact GermIdealTotalTransform.mem_of_isInSpanAt_mem h𝔞 (IsInSpanAt.mono (fun t ht => by rw [ht]; exact hm𝔞) hg)

end Principal

/-! ### Off the centre -/

section OffCentre

variable {X : Type u} [TopologicalSpace X] [ChartedSpace (ComplexModel n) X] [IsComplexManifold n X]
  {Y : Type u} [TopologicalSpace Y] [ChartedSpace (ComplexModel n) Y] [IsComplexManifold n Y]
  {C : Set X} {π : Y → X}

/-- **A flat chart at `π z` read through `π`, off the centre**: the blowup is a local biholomorphism at `z`
(`BlowupIsomorphismOff`), so `Φ ∘ e_{π z} ∘ π` are coordinates at `z`, centred if `Φ` is; their domain lies off
`π⁻¹ C` and over the domain of `Φ`. -/
theorem exists_chart_comp (hπ : IsBlowupAlong n C π) {z : Y} (hz : π z ∉ C)
    (Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) (π z) (π z)))
    (hΦ0 : Φ.toFun (chartAt (ComplexModel n) (π z) (π z)) = 0) :
    ∃ Θ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) z z),
      Θ.source ⊆ (chartAt (ComplexModel n) z).target ∧ Θ.toFun (chartAt (ComplexModel n) z z) = 0 ∧
      ∀ {y : Y}, y ∈ (chartAt (ComplexModel n) z).source → chartAt (ComplexModel n) z y ∈ Θ.source →
        π y ∉ C ∧ π y ∈ flatDomain Φ ∧
          Θ.toFun (chartAt (ComplexModel n) z y) = Φ.toFun (chartAt (ComplexModel n) (π z) (π y)) := by
  set I := 𝓘(ℂ, ComplexModel n) with hI
  have hrange : range I = univ := by simp [hI]
  set e := chartAt (ComplexModel n) z with he
  set O : Set Y := π ⁻¹' Cᶜ with hOdef
  have hO : IsOpen O := hπ.1.1.isOpen_compl.preimage hπ.contMDiff.continuous
  set F : ComplexModel n → ComplexModel n := fun u => chartAt (ComplexModel n) (π z) (π (e.symm u)) with hF
  set N : Set (ComplexModel n) := e.target ∩ e.symm ⁻¹' (O ∩ π ⁻¹' (chartAt (ComplexModel n) (π z)).source) with hN
  have hNo : IsOpen N :=
    e.continuousOn_symm.isOpen_inter_preimage e.open_target
      (hO.inter (hπ.contMDiff.continuous.isOpen_preimage _ (chartAt (ComplexModel n) (π z)).open_source))
  have hzN : e z ∈ N := ⟨e.map_source (mem_chart_source _ z), by
    rw [Set.mem_preimage, e.left_inv (mem_chart_source _ z)]
    exact ⟨hz, mem_chart_source _ (π z)⟩⟩
  have hFN : DifferentiableOn ℂ F N := by
    have h := (contMDiffOn_iff.mp (hπ.contMDiff.contMDiffOn (s := univ))).2 z (π z)
    refine (h.differentiableOn (by simp)).mono ?_
    intro u hu
    exact ⟨⟨mem_univ _, hu.1⟩, mem_univ _, hu.2.2, mem_univ _⟩
  have hmd : MDifferentiableAt I I π z := (hπ.contMDiff z).mdifferentiableAt (by simp)
  have hderiv : mfderiv I I π z = fderiv ℂ F (e z) := by
    rw [hmd.mfderiv, hrange, fderivWithin_univ]
    rfl
  have hzE : z ∉ exceptionalLocus n π := fun h =>
    hz (BlowupIsomorphismOff.exceptionalLocus_subset_preimage hπ h)
  have hinj : Function.Injective (fderiv ℂ F (e z)) := by
    have := hzE
    simp only [exceptionalLocus, mem_ofPred_eq, not_not] at this
    rw [hderiv] at this
    exact this.1
  obtain ⟨Ψ, hΨN, hΨF, -⟩ := exists_localHolomorphicEquivAt hNo hzN hFN hinj
  have hFz : F (e z) = chartAt (ComplexModel n) (π z) (π z) := by
    simp only [hF, e.left_inv (mem_chart_source _ z)]
  refine ⟨RegularAtDimTransport.LocalHolomorphicEquivAt.comp Ψ Φ (hΨF ▸ hFz), ?_, ?_, ?_⟩
  · intro u hu
    exact (hΨN hu.1).1
  · change Φ.toFun (Ψ.toFun (e z)) = 0
    rw [hΨF, hFz]
    exact hΦ0
  · intro y hy hyΘ
    change e y ∈ Ψ.source ∩ Ψ.toFun ⁻¹' Φ.source at hyΘ
    have hyN := (hΨN hyΘ.1).2
    rw [Set.mem_preimage, e.left_inv hy] at hyN
    have hFy : F (e y) = chartAt (ComplexModel n) (π z) (π y) := by simp only [hF, e.left_inv hy]
    have hyΦ : chartAt (ComplexModel n) (π z) (π y) ∈ Φ.source := by
      have := hyΘ.2
      rwa [Set.mem_preimage, hΨF, hFy] at this
    refine ⟨hyN.1, ⟨hyN.2, hyΦ⟩, ?_⟩
    change Φ.toFun (Ψ.toFun (e y)) = _
    rw [hΨF, hFy]

/-- **Off the centre the transformed ideal is the pullback** (`N = M`): at `z` with `π z ∉ C` the ideal of the
centre pulls back to the unit ideal, so the colon by its `d`-th power changes nothing. -/
theorem geoTransform_mem_iff_pullback (hπ : IsBlowupAlong n C π) (𝔪 : MarkedIdeal n X) (hN : 𝔪.N = univ)
    (h𝔞 : 𝔪.ideal.IsCoherent) {z : Y} (hz : π z ∉ C) (g : Y → ℂ) :
    (𝔪.geoTransform C π).ideal.mem z g ↔ (GermIdeal.pullback (m := n) π 𝔪.ideal).mem z g := by
  have hN' : geoStrictTransform π C 𝔪.N = univ := by rw [hN]; exact geoStrictTransform_univ hπ
  constructor
  · intro hg
    have h1 := one_mem_idealPow (n := n)
      (one_mem_pullback_vanishingIdeal (n := n) (π := π) hz hπ.1.1) 𝔪.d
    obtain ⟨-, K, s, c, hs, hc, hsum⟩ := hg.2 _ h1
    refine GermIdealTotalTransform.mem_of_isInSpanAt_mem
      (GermIdealPullbackCalculus.isCoherent_pullback hπ.contMDiff h𝔞) ⟨hg.1, K, s, c, hs, hc, ?_⟩
    filter_upwards [hsum] with y hy
    have := hy (by rw [hN']; exact mem_univ y)
    simpa using this
  · intro hg
    have hgh : HolomorphicAt n g z := (RelativePrincipalizationSpan.GermIdeal.mem_pullback_iff.mp hg).1
    refine ⟨hgh, fun h hh => ⟨(holomorphicAt_of_mem_idealPow hh).mul hgh, ?_⟩⟩
    exact ⟨1, fun _ => g, fun _ => h, fun _ => hg, fun _ => holomorphicAt_of_mem_idealPow hh,
      Eventually.of_forall fun y _ => by simp⟩

/-- Spans of one function only depend on its germ. -/
theorem isInSpanAt_eq_congr {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
    [IsComplexManifold n M] {f f' : M → ℂ} {x : M} (hff : f =ᶠ[𝓝 x] f') (g : M → ℂ) :
    IsInSpanAt (n := n) (· = f) x g ↔ IsInSpanAt (n := n) (· = f') x g := by
  rw [isInSpanAt_eq_iff, isInSpanAt_eq_iff]
  constructor <;> rintro ⟨hg, c, hc, hgc⟩ <;> refine ⟨hg, c, hc, ?_⟩ <;>
    filter_upwards [hgc, hff] with y h1 h2 <;> rw [h1, h2]

/-- The members of the transformed divisor through a point off `π⁻¹ C` are the strict transforms of the members through
its image, and near it they are the preimages. -/
theorem mem_get_geoTransform_iff_of_notMem (hπ : IsBlowupAlong n C π) (𝔪 : MarkedIdeal n X)
    (hE : IsSNCDivisor n 𝔪.E) {y : Y} (hy : π y ∉ C) (i : Fin (𝔪.geoTransform C π).E.length) :
    y ∈ (𝔪.geoTransform C π).E.get i ↔ ∃ h : i.1 < 𝔪.E.length, π y ∈ 𝔪.E.get ⟨i.1, h⟩ := by
  have hget : (𝔪.geoTransform C π).E.get i =
      if h : i.1 < 𝔪.E.length then geoStrictTransform π C (𝔪.E.get ⟨i.1, h⟩) else π ⁻¹' C :=
    get_map_append_singleton 𝔪.E (geoStrictTransform π C) (π ⁻¹' C) i
  rw [hget]
  by_cases h : i.1 < 𝔪.E.length
  · rw [dif_pos h, mem_geoStrictTransform_iff_of_notMem hπ.contMDiff.continuous (hE.1 _ (List.get_mem _ _)) hy]
    exact ⟨fun h' => ⟨h, h'⟩, fun ⟨_, h'⟩ => h'⟩
  · rw [dif_neg h]
    exact ⟨fun h' => absurd h' hy, fun ⟨h', _⟩ => absurd h' h⟩

/-- The indices of `E` inside those of the transformed divisor. -/
def castE (𝔪 : MarkedIdeal n X) (C : Set X) (π : Y → X) : Fin 𝔪.E.length ↪ Fin (𝔪.geoTransform C π).E.length where
  toFun i := ⟨i.1, by rw [length_E_geoTransform]; omega⟩
  inj' i j h := Fin.ext (by simpa using congrArg Fin.val h)

open Classical in
/-- **Off the centre the transform of a principal monomial ideal is principal monomial**, with the same exponents
(`N = M`): the chart of `exists_chart_comp` carries the generator `∏ Φ_{σ i}^{a_i}` at `π z` to `∏ Θ_{σ i}^{a_i}` at
`z`, and the transformed ideal is the pullback there. -/
theorem isPrincipalAt_geoTransform_of_notMem (hn : 0 < n) (hπ : IsBlowupAlong n C π) (𝔪 : MarkedIdeal n X)
    (hN : 𝔪.N = univ) (hE : IsSNCDivisor n 𝔪.E) (h𝔞 : 𝔪.ideal.IsCoherent) {z : Y} (hz : π z ∉ C)
    {a : Fin 𝔪.E.length → ℕ} (hP : IsPrincipalAt 𝔪.ideal 𝔪.E (π z) a) :
    IsPrincipalAt (𝔪.geoTransform C π).ideal (𝔪.geoTransform C π).E z
      (fun i => if h : i.1 < 𝔪.E.length then a ⟨i.1, h⟩ else 0) := by
  obtain ⟨Φ, σ, hΦsrc, hΦ0, hσ, hA, hgen⟩ := hP
  obtain ⟨Θ, hΘt, hΘ0, hΘ⟩ := exists_chart_comp hπ hz Φ hΦ0
  set E' := (𝔪.geoTransform C π).E with hE'
  set σ' : Fin E'.length → Fin n := fun i => if h : i.1 < 𝔪.E.length then σ ⟨i.1, h⟩ else ⟨0, hn⟩ with hσ'
  set a' : Fin E'.length → ℕ := fun i => if h : i.1 < 𝔪.E.length then a ⟨i.1, h⟩ else 0 with ha'
  have hmem := mem_get_geoTransform_iff_of_notMem hπ 𝔪 hE (y := z) hz
  refine ⟨Θ, σ', hΘt, hΘ0, fun i hi j hj hij => ?_, fun i hi y hy hyΘ => ?_, fun g => ?_⟩
  · obtain ⟨hil, hi'⟩ := (hmem i).mp hi
    obtain ⟨hjl, hj'⟩ := (hmem j).mp hj
    simp only [hσ', dif_pos hil, dif_pos hjl] at hij
    exact Fin.ext (by simpa using congrArg Fin.val (hσ hi' hj' hij))
  · obtain ⟨hil, hi'⟩ := (hmem i).mp hi
    obtain ⟨hyC, hyD, hyeq⟩ := hΘ hy hyΘ
    rw [mem_get_geoTransform_iff_of_notMem hπ 𝔪 hE hyC i, hyeq]
    simp only [hσ', dif_pos hil]
    rw [← hA _ hi' hyD.1 hyD.2]
    exact ⟨fun ⟨_, h⟩ => h, fun h => ⟨hil, h⟩⟩
  · have hm : HolomorphicAt n (fun x => ∏ i ∈ Finset.univ.filter (fun i => π z ∈ 𝔪.E.get i),
        flatCoord Φ (σ i) x ^ a i) (π z) :=
      holomorphicAt_flatMonomial (T := Finset.univ.filter (fun i => π z ∈ 𝔪.E.get i)) (σ := σ) a
        (mem_flatDomain_self Φ)
    rw [geoTransform_mem_iff_pullback hπ 𝔪 hN h𝔞 hz, pullback_mem_iff_of_generator hπ.contMDiff hm hgen]
    refine isInSpanAt_eq_congr ?_ g
    have hT' : (Finset.univ.filter fun i : Fin E'.length => z ∈ E'.get i) =
        (Finset.univ.filter fun i : Fin 𝔪.E.length => π z ∈ 𝔪.E.get i).map (castE 𝔪 C π) := by
      ext i
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_map]
      rw [hmem i]
      constructor
      · rintro ⟨hil, hi'⟩
        exact ⟨⟨i.1, hil⟩, hi', Fin.ext rfl⟩
      · rintro ⟨j, hj, rfl⟩
        exact ⟨j.2, hj⟩
    filter_upwards [(isOpen_flatDomain Θ).mem_nhds (mem_flatDomain_self Θ)] with y hy
    obtain ⟨-, -, hyeq⟩ := hΘ hy.1 hy.2
    rw [hT', Finset.prod_map]
    refine Finset.prod_congr rfl fun i _ => ?_
    have hil : (castE 𝔪 C π i).1 < 𝔪.E.length := i.2
    simp only [flatCoord, hσ', ha', dif_pos hil]
    rw [hyeq]
    rfl

open Classical in
/-- **Off the centre the transform of a monomial ideal is principal monomial** (`N = M`), with the exponents
`e_{E_i}(π z)` of `π z` on the strict transforms of the members through `π z` (`isPrincipalAt_of_monomial` at `π z`,
then `isPrincipalAt_geoTransform_of_notMem`). -/
theorem isPrincipalAt_geoTransform_of_notMem_of_monomial (hn : 0 < n) (hπ : IsBlowupAlong n C π) (𝔪 : MarkedIdeal n X)
    (hN : 𝔪.N = univ) (hE : IsSNCDivisor n 𝔪.E) (h𝔞 : 𝔪.ideal.IsCoherent)
    (hmono : (monomialPart n 𝔪.ideal 𝔪.E).Le 𝔪.ideal) {z : Y} (hz : π z ∉ C) :
    IsPrincipalAt (𝔪.geoTransform C π).ideal (𝔪.geoTransform C π).E z
      (fun i => if h : i.1 < 𝔪.E.length then divExp n 𝔪.ideal (𝔪.E.get ⟨i.1, h⟩) (π z) else 0) :=
  isPrincipalAt_geoTransform_of_notMem hn hπ 𝔪 hN hE h𝔞 hz (isPrincipalAt_of_monomial hn hE h𝔞 hmono (π z))

/-- **Off the centre the invariant does not change** (the monomial case (2), second half). -/
theorem gamma_geoTransform_eq_of_notMem (hn : 0 < n) (hπ : IsBlowupAlong n C π) (𝔪 : MarkedIdeal n X)
    (hN : 𝔪.N = univ) (hE : IsSNCDivisor n 𝔪.E) (h𝔞 : 𝔪.ideal.IsCoherent)
    (h𝔞' : (𝔪.geoTransform C π).ideal.IsCoherent)
    (hmono : (monomialPart n 𝔪.ideal 𝔪.E).Le 𝔪.ideal) {z : Y} (hz : π z ∉ C) (d : ℕ) :
    gamma n (𝔪.geoTransform C π).ideal (𝔪.geoTransform C π).E d z = gamma n 𝔪.ideal 𝔪.E d (π z) := by
  rw [(isPrincipalAt_geoTransform_of_notMem_of_monomial hn hπ 𝔪 hN hE h𝔞 hmono hz).gamma_eq h𝔞' d, gamma]
  have hidx : memberIdx (𝔪.geoTransform C π).E z = memberIdx 𝔪.E (π z) := by
    ext i
    rw [mem_memberIdx, mem_memberIdx]
    constructor
    · rintro ⟨hi, hzi⟩
      obtain ⟨hil, h⟩ := (mem_get_geoTransform_iff_of_notMem hπ 𝔪 hE hz ⟨i, hi⟩).mp hzi
      exact ⟨hil, h⟩
    · rintro ⟨hil, h⟩
      refine ⟨by rw [length_E_geoTransform]; omega, ?_⟩
      exact (mem_get_geoTransform_iff_of_notMem hπ 𝔪 hE hz _).mpr ⟨hil, h⟩
  rw [hidx]
  refine inv_congr fun i hi => ?_
  obtain ⟨hil, -⟩ := (mem_memberIdx 𝔪.E).mp hi
  have hil' : i < (𝔪.geoTransform C π).E.length := by rw [length_E_geoTransform]; omega
  simp only [extExp, expData, dif_pos hil', dif_pos hil]

end OffCentre

/-! ### The maximum locus near one of its points -/

section MaxLocus

variable {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
  {𝔪 : MarkedIdeal n M}

/-- The maximum locus of the invariant on the cosupport of a monomial marked ideal (`N = M`). -/
abbrev maxLocusγ (𝔪 : MarkedIdeal n M) : Set M :=
  ResolutionDriver.maxLocus (gamma n 𝔪.ideal 𝔪.E 𝔪.d) 𝔪.cosupp

/-- **The maximum locus is a level set**: if `x` lies on it, a point lies on it iff it has the invariant of `x`. -/
theorem mem_maxLocusγ_iff (hn : 0 < n) (hN : 𝔪.N = univ) (hE : IsSNCDivisor n 𝔪.E) (h𝔞 : 𝔪.ideal.IsCoherent)
    (hmono : (monomialPart n 𝔪.ideal 𝔪.E).Le 𝔪.ideal) {x : M} (hx : x ∈ maxLocusγ 𝔪) (y : M) :
    y ∈ maxLocusγ 𝔪 ↔ gamma n 𝔪.ideal 𝔪.E 𝔪.d y = gamma n 𝔪.ideal 𝔪.E 𝔪.d x := by
  have hcs : 𝔪.cosupp = cosupport n univ 𝔪.ideal 𝔪.d := by
    change cosupport n 𝔪.N 𝔪.ideal 𝔪.d = _
    rw [hN]
  have hmax : ∀ y, gamma n 𝔪.ideal 𝔪.E 𝔪.d y ≤ gamma n 𝔪.ideal 𝔪.E 𝔪.d x := by
    intro y
    by_cases hy : y ∈ 𝔪.cosupp
    · exact hx.2 y hy
    · rw [(gamma_eq_bot_iff_of_monomial hn hE h𝔞 hmono 𝔪.d y).mpr (hcs ▸ hy)]
      exact bot_le
  constructor
  · intro hy
    exact le_antisymm (hmax y) (hy.2 x hx.1)
  · intro hy
    refine ⟨?_, fun y' _ => hy ▸ hmax y'⟩
    rw [hcs]
    by_contra hyc
    have h1 := (gamma_eq_bot_iff_of_monomial hn hE h𝔞 hmono 𝔪.d y).mpr hyc
    have h2 := (gamma_eq_bot_iff_of_monomial hn hE h𝔞 hmono 𝔪.d x).not.mpr (not_not.mpr (hcs ▸ hx.1))
    exact h2 (hy ▸ h1)

/-- **Near one of its points, the maximum locus is the intersection of the members of the top set.** -/
theorem eventually_mem_maxLocusγ_iff (hn : 0 < n) (hN : 𝔪.N = univ) (hE : IsSNCDivisor n 𝔪.E)
    (h𝔞 : 𝔪.ideal.IsCoherent) (h0 : ∀ y, IsNonzeroAt 𝔪.ideal y) (hmono : (monomialPart n 𝔪.ideal 𝔪.E).Le 𝔪.ideal)
    {x : M} (hx : x ∈ maxLocusγ 𝔪) {v : Val} (hv : gamma n 𝔪.ideal 𝔪.E 𝔪.d x = v) :
    ∀ᶠ y in 𝓝 x, y ∈ maxLocusγ 𝔪 ↔ y ∈ memberInter 𝔪.E (topIdx 𝔪.E v) := by
  filter_upwards [eventually_gamma_eq_iff_mem_memberInter hn hE h𝔞 h0 hv] with y hy
  rw [mem_maxLocusγ_iff hn hN hE h𝔞 hmono hx, hv, hy]

open Classical in
/-- **The members containing the maximum locus near one of its points are exactly those of the top set** (they are
distinct coordinate hyperplanes: moving along the coordinate of a member outside the top set stays in the
intersection of the top members and leaves that member). -/
theorem filter_eventually_subset_eq_topIdx (hn : 0 < n) (hN : 𝔪.N = univ) (hE : IsSNCDivisor n 𝔪.E)
    (h𝔞 : 𝔪.ideal.IsCoherent) (h0 : ∀ y, IsNonzeroAt 𝔪.ideal y) (hmono : (monomialPart n 𝔪.ideal 𝔪.E).Le 𝔪.ideal)
    {x : M} (hx : x ∈ maxLocusγ 𝔪) {v : Val} (hv : gamma n 𝔪.ideal 𝔪.E 𝔪.d x = v) :
    Finset.univ.filter (fun i => x ∈ 𝔪.E.get i ∧ ∀ᶠ y in 𝓝 x, y ∈ maxLocusγ 𝔪 → y ∈ 𝔪.E.get i) =
      topIdx 𝔪.E v := by
  have hloc := eventually_mem_maxLocusγ_iff hn hN hE h𝔞 h0 hmono hx hv
  obtain ⟨hI, -⟩ := top_of_gamma_eq hv
  have htopx : ∀ j ∈ topIdx 𝔪.E v, x ∈ 𝔪.E.get j := fun j hj =>
    mem_memberInter_of_gamma_eq hn hE h𝔞 h0 hv j hj
  ext i
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨hxi, hCi⟩
    by_contra hi
    obtain ⟨Φ, σ, hΦsrc, hΦx, hσ, hA⟩ := exists_snc_chart hn hE x
    have hxD : x ∈ flatDomain Φ := mem_flatDomain_self Φ
    obtain ⟨y, ⟨hyD, hyne, hyeq⟩, hyC, hyloc⟩ :=
      ((frequently_flatMap_ne_zero hΦsrc hxD {σ i}).and_eventually (hCi.and hloc)).exists
    have hyI : y ∈ memberInter 𝔪.E (topIdx 𝔪.E v) := by
      intro j hj
      have hxj := htopx j hj
      have hji : σ j ≠ σ i := by
        intro h
        have := hσ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hxj⟩)
          (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hxi⟩) h
        exact hi (this ▸ hj)
      refine (hA j hxj hyD.1 hyD.2).mpr ?_
      have := hyeq (σ j) (by simpa using hji)
      rw [show Φ.toFun (chartAt (ComplexModel n) x y) (σ j) = flatMap Φ y (σ j) from rfl, this]
      exact congrFun (congrArg (fun w : ComplexModel n => (w : Fin n → ℂ)) hΦx) (σ j)
    have hyi := hyC (hyloc.mpr hyI)
    exact hyne (σ i) (Finset.mem_singleton_self _) ((hA i hxi hyD.1 hyD.2).mp hyi)
  · intro hi
    refine ⟨htopx i hi, ?_⟩
    filter_upwards [hloc] with y hy hyC
    exact (hy.mp hyC) i hi

/-- The exponent sum over the members of the top set, two ways. -/
theorem sum_topIdx_eq {x : M} {v : Val} {d : ℕ} (hv : gamma n 𝔪.ideal 𝔪.E d x = v) :
    ∑ i ∈ topIdx 𝔪.E v, divExp n 𝔪.ideal (𝔪.E.get i) x = ∑ i ∈ topSet v, expData n 𝔪.ideal 𝔪.E x i := by
  obtain ⟨hI, -⟩ := top_of_gamma_eq hv
  have hlt : ∀ i ∈ topSet v, i < 𝔪.E.length := fun i hi =>
    ((mem_memberIdx 𝔪.E).mp ((mem_feasible.mp hI).1 hi)).1
  have hmap : (topIdx 𝔪.E v).map Fin.valEmbedding = topSet v := by
    ext i
    simp only [topIdx, Finset.mem_map, Finset.mem_filter, Finset.mem_univ, true_and, Fin.valEmbedding_apply]
    exact ⟨fun ⟨j, hj, hji⟩ => hji ▸ hj, fun hi => ⟨⟨i, hlt i hi⟩, hi, rfl⟩⟩
  rw [← hmap, Finset.sum_map]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp only [Fin.valEmbedding_apply, expData, dif_pos i.2, Fin.eta]

end MaxLocus

/-! ### Over the centre -/

section OverCentre

variable {X : Type u} [TopologicalSpace X] [ChartedSpace (ComplexModel n) X] [IsComplexManifold n X]
  {Y : Type u} [TopologicalSpace Y] [ChartedSpace (ComplexModel n) Y] [IsComplexManifold n Y]
  {π : Y → X}

open Classical in
/-- **Over the centre the transform is principal monomial** (the monomial blowup, `N = M`, at the blowup of the
maximum locus): at `z` over `x = π z` the transformed ideal is generated by a monomial in centred coordinates adapted to
`E'`, with the exponents of `x` on the strict transforms and `∑_I a - d` on the exceptional member (`I` the top set of
`γ(x)`).  `MonomialBlowup.exists_snc_chart_geoTransform_of_flat`, fed with the monomial generator at `x`
(`isPrincipalAt_of_monomial`) and with `e = ∑_I a` (`filter_eventually_subset_eq_topIdx`). -/
theorem isPrincipalAt_geoTransform_of_mem (hn : 0 < n) (𝔪 : MarkedIdeal n X) (hN : 𝔪.N = univ)
    (hE : IsSNCDivisor n 𝔪.E) (h𝔞 : 𝔪.ideal.IsCoherent) (h0 : ∀ y, IsNonzeroAt 𝔪.ideal y)
    (hmono : (monomialPart n 𝔪.ideal 𝔪.E).Le 𝔪.ideal) (hπ : IsBlowupAlong n (maxLocusγ 𝔪) π) {z : Y}
    (hz : π z ∈ maxLocusγ 𝔪) {v : Val} (hv : gamma n 𝔪.ideal 𝔪.E 𝔪.d (π z) = v) :
    ∃ a' : Fin (𝔪.geoTransform (maxLocusγ 𝔪) π).E.length → ℕ,
      IsPrincipalAt (𝔪.geoTransform (maxLocusγ 𝔪) π).ideal (𝔪.geoTransform (maxLocusγ 𝔪) π).E z a' ∧
      (∀ i (hi : i.1 < 𝔪.E.length), a' i = divExp n 𝔪.ideal (𝔪.E.get ⟨i.1, hi⟩) (π z)) ∧
      ∀ i, ¬ i.1 < 𝔪.E.length → a' i + 𝔪.d = ∑ i ∈ topSet v, expData n 𝔪.ideal 𝔪.E (π z) i := by
  obtain ⟨hC, -⟩ := isAdmissibleCentre_maxLocus_gamma hn 𝔪 hN hE h𝔞 h0 hmono
  obtain ⟨Φ, σ, hΦsrc, hΦx, hσ, hA, hgen⟩ := isPrincipalAt_of_monomial hn hE h𝔞 hmono (π z)
  have hfilter := filter_eventually_subset_eq_topIdx hn hN hE h𝔞 h0 hmono hz hv
  have hsum := sum_topIdx_eq (𝔪 := 𝔪) hv
  obtain ⟨hI, -⟩ := top_of_gamma_eq hv
  have hdI := (mem_feasible.mp hI).2
  have hd : 𝔪.d ≤ ∑ i ∈ Finset.univ.filter (fun i => π z ∈ 𝔪.E.get i ∧
      ∀ᶠ y in 𝓝 (π z), y ∈ maxLocusγ 𝔪 → y ∈ 𝔪.E.get i), divExp n 𝔪.ideal (𝔪.E.get i) (π z) := by
    rw [hfilter, hsum]
    exact hdI
  obtain ⟨Θ, σ', a', hΘt, hΘ0, hσ', hA', ha', hlast, hgen'⟩ :=
    MonomialBlowup.exists_snc_chart_geoTransform_of_flat hπ 𝔪 hN h𝔞 hE hC.2.2 hz
      (T := Finset.univ.filter fun i => π z ∈ 𝔪.E.get i) (by simp)
      (fun i hi => hA i (Finset.mem_filter.mp hi).2) _ hgen hd
  refine ⟨a', ⟨Θ, σ', hΘt, hΘ0, hσ', hA', hgen'⟩, ha', fun i hi => ?_⟩
  rw [hlast i hi, ← hsum, ← hfilter]
  rw [hfilter, hsum] at hd ⊢
  omega

open Classical in
/-- **The invariant drops over the centre** (the monomial case (2)): at every point `z` over the maximum locus,
`γ'(z) < γ(π z)`.  The data at `z` arise from those at `x = π z` by deleting members (among them a member `E_{j₀}` of
the top set whose strict transform misses `z`, `BoundaryCount.card_filter_mem_geoStrictTransform_lt`) and adding the
exceptional member with exponent `∑_I a - d` (`isPrincipalAt_geoTransform_of_mem`); then
`MonomialInvariant.inv_lt_of_blowup`. -/
theorem gamma_geoTransform_lt_of_mem (hn : 0 < n) (𝔪 : MarkedIdeal n X) (hN : 𝔪.N = univ)
    (hE : IsSNCDivisor n 𝔪.E) (h𝔞 : 𝔪.ideal.IsCoherent) (h0 : ∀ y, IsNonzeroAt 𝔪.ideal y)
    (hmono : (monomialPart n 𝔪.ideal 𝔪.E).Le 𝔪.ideal) (hπ : IsBlowupAlong n (maxLocusγ 𝔪) π)
    (h𝔞' : (𝔪.geoTransform (maxLocusγ 𝔪) π).ideal.IsCoherent) {z : Y} (hz : π z ∈ maxLocusγ 𝔪) :
    gamma n (𝔪.geoTransform (maxLocusγ 𝔪) π).ideal (𝔪.geoTransform (maxLocusγ 𝔪) π).E 𝔪.d z <
      gamma n 𝔪.ideal 𝔪.E 𝔪.d (π z) := by
  have hcs : 𝔪.cosupp = cosupport n univ 𝔪.ideal 𝔪.d := by
    change cosupport n 𝔪.N 𝔪.ideal 𝔪.d = _
    rw [hN]
  have hne : gamma n 𝔪.ideal 𝔪.E 𝔪.d (π z) ≠ ⊥ := fun h =>
    (gamma_eq_bot_iff_of_monomial hn hE h𝔞 hmono 𝔪.d (π z)).mp h (hcs ▸ hz.1)
  obtain ⟨v, hv⟩ := WithBot.ne_bot_iff_exists.mp hne
  have hv' : gamma n 𝔪.ideal 𝔪.E 𝔪.d (π z) = v := hv.symm
  obtain ⟨a', hP, ha', hlast⟩ := isPrincipalAt_geoTransform_of_mem hn 𝔪 hN hE h𝔞 h0 hmono hπ hz hv'
  rw [hP.gamma_eq h𝔞' 𝔪.d]
  obtain ⟨hI, htop⟩ := top_of_gamma_eq hv'
  obtain ⟨hC, -⟩ := isAdmissibleCentre_maxLocus_gamma hn 𝔪 hN hE h𝔞 h0 hmono
  have hloc := eventually_mem_maxLocusγ_iff hn hN hE h𝔞 h0 hmono hz hv'
  have hcard := card_filter_mem_geoStrictTransform_lt hπ hE hC.2.2 (topIdx 𝔪.E v) hz
    (hloc.mono fun y hy hyI => hy.mpr hyI)
  obtain ⟨j₀, hj₀, hzj₀⟩ : ∃ j₀ ∈ topIdx 𝔪.E v, z ∉ geoStrictTransform π (maxLocusγ 𝔪) (𝔪.E.get j₀) := by
    by_contra h
    push Not at h
    rw [Finset.filter_true_of_mem h] at hcard
    exact lt_irrefl _ hcard
  have hj₀' : (j₀ : ℕ) ∈ topSet v := (Finset.mem_filter.mp hj₀).2
  have hlen : (𝔪.geoTransform (maxLocusγ 𝔪) π).E.length = 𝔪.E.length + 1 := length_E_geoTransform _ _ _
  change inv n _ _ 𝔪.d < inv n (memberIdx 𝔪.E (π z)) (expData n 𝔪.ideal 𝔪.E (π z)) 𝔪.d
  refine inv_lt_of_blowup (card_memberIdx_le 𝔪.E hE (π z)) hI htop (m := 𝔪.E.length) hj₀' ?_ ?_ ?_
  · intro i hi
    obtain ⟨hi', hzi⟩ := (mem_memberIdx _).mp hi
    have hget : (𝔪.geoTransform (maxLocusγ 𝔪) π).E.get ⟨i, hi'⟩ =
        if h : i < 𝔪.E.length then geoStrictTransform π (maxLocusγ 𝔪) (𝔪.E.get ⟨i, h⟩) else π ⁻¹' maxLocusγ 𝔪 :=
      get_map_append_singleton 𝔪.E (geoStrictTransform π (maxLocusγ 𝔪)) (π ⁻¹' maxLocusγ 𝔪) ⟨i, hi'⟩
    by_cases hil : i < 𝔪.E.length
    · rw [hget, dif_pos hil] at hzi
      have hxi : π z ∈ 𝔪.E.get ⟨i, hil⟩ :=
        geoStrictTransform_subset_preimage hπ.contMDiff.continuous (hE.1 _ (List.get_mem _ _)) hzi
      refine Finset.mem_insert_of_mem (Finset.mem_erase.mpr ⟨fun h => hzj₀ ?_, (mem_memberIdx _).mpr ⟨hil, hxi⟩⟩)
      have : (⟨i, hil⟩ : Fin 𝔪.E.length) = j₀ := Fin.ext h
      rw [← this]
      exact hzi
    · have : i = 𝔪.E.length := by omega
      rw [this]
      exact Finset.mem_insert_self _ _
  · intro i hi
    obtain ⟨hil, -⟩ := (mem_memberIdx _).mp hi
    have hil' : i < (𝔪.geoTransform (maxLocusγ 𝔪) π).E.length := by omega
    simp only [extExp, dif_pos hil', expData, dif_pos hil]
    exact ha' ⟨i, hil'⟩ hil
  · have hl : 𝔪.E.length < (𝔪.geoTransform (maxLocusγ 𝔪) π).E.length := by omega
    simp only [extExp, dif_pos hl]
    exact hlast ⟨𝔪.E.length, hl⟩ (lt_irrefl _)

/-- **One step of the monomial case** (the monomial case (2), `N = M`): blowing up the maximum locus of `γ` on the
cosupport of a well-formed monomial marked ideal `(X, X, E, 𝔞, d)` whose ideal is nonzero at every point, the transform
is again monomial and nonzero at every point; `γ'(z) < γ(π z)` over the centre and `γ'(z) = γ(π z)` off it; hence
`γ'` is below the maximum of `γ` at every point of the new cosupport. -/
theorem monomial_step (hn : 0 < n) (𝔪 : MarkedIdeal n X) (h𝔪 : 𝔪.IsWellFormed) (hN : 𝔪.N = univ)
    (h0 : ∀ y, IsNonzeroAt 𝔪.ideal y) (hmono : (monomialPart n 𝔪.ideal 𝔪.E).Le 𝔪.ideal)
    (hπ : IsBlowupAlong n (maxLocusγ 𝔪) π) :
    (𝔪.geoTransform (maxLocusγ 𝔪) π).IsWellFormed ∧ (𝔪.geoTransform (maxLocusγ 𝔪) π).N = univ ∧
      (∀ z, IsNonzeroAt (𝔪.geoTransform (maxLocusγ 𝔪) π).ideal z) ∧
      (monomialPart n (𝔪.geoTransform (maxLocusγ 𝔪) π).ideal (𝔪.geoTransform (maxLocusγ 𝔪) π).E).Le
        (𝔪.geoTransform (maxLocusγ 𝔪) π).ideal ∧
      (∀ z, π z ∈ maxLocusγ 𝔪 →
        gamma n (𝔪.geoTransform (maxLocusγ 𝔪) π).ideal (𝔪.geoTransform (maxLocusγ 𝔪) π).E 𝔪.d z <
          gamma n 𝔪.ideal 𝔪.E 𝔪.d (π z)) ∧
      (∀ z, π z ∉ maxLocusγ 𝔪 →
        gamma n (𝔪.geoTransform (maxLocusγ 𝔪) π).ideal (𝔪.geoTransform (maxLocusγ 𝔪) π).E 𝔪.d z =
          gamma n 𝔪.ideal 𝔪.E 𝔪.d (π z)) ∧
      ∀ x₀ ∈ maxLocusγ 𝔪, ∀ z ∈ (𝔪.geoTransform (maxLocusγ 𝔪) π).cosupp,
        gamma n (𝔪.geoTransform (maxLocusγ 𝔪) π).ideal (𝔪.geoTransform (maxLocusγ 𝔪) π).E 𝔪.d z <
          gamma n 𝔪.ideal 𝔪.E 𝔪.d x₀ := by
  have hE := h𝔪.isSNCDivisor
  have h𝔞 := h𝔪.isCoherent
  obtain ⟨hC, -⟩ := isAdmissibleCentre_maxLocus_gamma hn 𝔪 hN hE h𝔞 h0 hmono
  have hwf' := GeoTransformWellFormed.isWellFormed_geoTransform_of_isAdmissibleCentre h𝔪 hC hπ
  have h𝔞' := hwf'.isCoherent
  have hE' := hwf'.isSNCDivisor
  -- principal at every point
  have hP : ∀ z, ∃ a',
      IsPrincipalAt (𝔪.geoTransform (maxLocusγ 𝔪) π).ideal (𝔪.geoTransform (maxLocusγ 𝔪) π).E z a' := by
    intro z
    by_cases hz : π z ∈ maxLocusγ 𝔪
    · have hcs : 𝔪.cosupp = cosupport n univ 𝔪.ideal 𝔪.d := by
        change cosupport n 𝔪.N 𝔪.ideal 𝔪.d = _
        rw [hN]
      have hne : gamma n 𝔪.ideal 𝔪.E 𝔪.d (π z) ≠ ⊥ := fun h =>
        (gamma_eq_bot_iff_of_monomial hn hE h𝔞 hmono 𝔪.d (π z)).mp h (hcs ▸ hz.1)
      obtain ⟨v, hv⟩ := WithBot.ne_bot_iff_exists.mp hne
      obtain ⟨a', h, -⟩ := isPrincipalAt_geoTransform_of_mem hn 𝔪 hN hE h𝔞 h0 hmono hπ hz hv.symm
      exact ⟨a', h⟩
    · exact ⟨_, isPrincipalAt_geoTransform_of_notMem_of_monomial hn hπ 𝔪 hN hE h𝔞 hmono hz⟩
  have hlt := fun z (hz : π z ∈ maxLocusγ 𝔪) =>
    gamma_geoTransform_lt_of_mem hn 𝔪 hN hE h𝔞 h0 hmono hπ h𝔞' hz
  have heq := fun z (hz : π z ∉ maxLocusγ 𝔪) =>
    gamma_geoTransform_eq_of_notMem hn hπ 𝔪 hN hE h𝔞 h𝔞' hmono hz 𝔪.d
  refine ⟨hwf', geoTransform_N_eq_univ hN hπ, fun z => ?_, fun z g hg => ?_, hlt, heq, fun x₀ hx₀ z hz => ?_⟩
  · obtain ⟨a', h⟩ := hP z
    exact h.isNonzeroAt h𝔞'
  · obtain ⟨a', h⟩ := hP z
    exact h.monomialPart_le hn hE' h𝔞' g hg
  · by_cases hzC : π z ∈ maxLocusγ 𝔪
    · rw [← (mem_maxLocusγ_iff hn hN hE h𝔞 hmono hx₀ (π z)).mp hzC]
      exact hlt z hzC
    · rw [heq z hzC]
      have hcos : π z ∈ 𝔪.cosupp :=
        (TransformOffCentre.mem_cosupp_geoTransform_iff 𝔪 h𝔪.isClosedSubmanifold_N.1
          (fun _ _ hg => RelativePrincipalizationSpan.GermIdeal.IsCoherent.holomorphicAt_mem h𝔞 hg) hπ hzC).mp hz
      refine lt_of_le_of_ne (hx₀.2 _ hcos) fun h => hzC ?_
      exact (mem_maxLocusγ_iff hn hN hE h𝔞 hmono hx₀ (π z)).mpr h

end OverCentre

/-! ### The monomial case: iterating the blowup of the maximum locus -/

section Tower

variable {X : CMfd.{u} n}

/-- **The invariant along towers**: `γ` of the transform at the last stage of a tower. -/
def towerInv (𝔪 : MarkedIdeal n X) {Y : CMfd.{u} n} (T : BlowupTower X Y) : Y → WithBot Val :=
  gamma n (geoTransformAlong 𝔪 T).ideal (geoTransformAlong 𝔪 T).E (geoTransformAlong 𝔪 T).d

/-- **Along canonical segments of `γ` the marked ideal stays well formed, with `N = M`, monomial and nonzero at
every point** (induction on the tower, `monomial_step`). -/
theorem invariants_canonicalSegment (hn : 0 < n) (𝔪 : MarkedIdeal n X) (h𝔪 : 𝔪.IsWellFormed) (hN : 𝔪.N = univ)
    (h0 : ∀ y, IsNonzeroAt 𝔪.ideal y) (hmono : (monomialPart n 𝔪.ideal 𝔪.E).Le 𝔪.ideal) :
    ∀ {Y : CMfd.{u} n} (T : BlowupTower X Y),
      ResolutionDriver.IsCanonicalSegment 𝔪 (fun {Y} T => towerInv 𝔪 (Y := Y) T) T → IsGeoTestTower 𝔪 T →
      (geoTransformAlong 𝔪 T).IsWellFormed ∧ (geoTransformAlong 𝔪 T).N = univ ∧
        (∀ y, IsNonzeroAt (geoTransformAlong 𝔪 T).ideal y) ∧
        (monomialPart n (geoTransformAlong 𝔪 T).ideal (geoTransformAlong 𝔪 T).E).Le (geoTransformAlong 𝔪 T).ideal
  | _, .refl, _, _ => ⟨h𝔪, hN, h0, hmono⟩
  | _, .step T C π hπ, hseg, hT => by
      obtain ⟨hsegT, -, hCeq⟩ := hseg
      obtain ⟨hwf, hNT, h0T, hmonoT⟩ := invariants_canonicalSegment hn 𝔪 h𝔪 hN h0 hmono T hsegT hT.1
      subst hCeq
      obtain ⟨hwf', hN', h0', hmono', -⟩ := monomial_step hn (geoTransformAlong 𝔪 T) hwf hNT h0T hmonoT hπ
      exact ⟨hwf', hN', h0', hmono'⟩

/-- **Resolution of monomial marked ideals** (the monomial case (3), `N = M`): over a compact base, for a
well-formed marked ideal `(X, X, E, 𝔞, d)` with `d ≥ 1` whose ideal is monomial (`𝓜(𝔞) ⊆ 𝔞`) and nonzero at every
point, iterating the blowup of the maximum locus of the invariant `γ` reaches an empty cosupport: some canonical
segment of `γ` is a resolution.  `ResolutionDriver.exists_isGeoResolution_of_wellFounded_invariant`, with closed
cosupports (coherence), upper semicontinuity and admissible maximum loci (`MonomialCase`), the strict drop
(`monomial_step`) and well-founded values (`MonomialInvariant.wellFoundedLT_val`). -/
theorem exists_isGeoResolution_of_monomial [CompactSpace X] (hn : 0 < n) (𝔪 : MarkedIdeal n X)
    (h𝔪 : 𝔪.IsWellFormed) (hN : 𝔪.N = univ) (h0 : ∀ y, IsNonzeroAt 𝔪.ideal y)
    (hmono : (monomialPart n 𝔪.ideal 𝔪.E).Le 𝔪.ideal) (hd : 1 ≤ 𝔪.d) :
    ∃ (Y : CMfd.{u} n) (T : BlowupTower X Y),
      ResolutionDriver.IsCanonicalSegment 𝔪 (fun {Y} T => towerInv 𝔪 (Y := Y) T) T ∧ IsGeoResolution 𝔪 T := by
  have := wellFoundedLT_val
  refine ResolutionDriver.exists_isGeoResolution_of_wellFounded_invariant 𝔪 (fun {Y} T => towerInv 𝔪 (Y := Y) T)
    ?_ ?_ ?_ ?_
  · intro Y T hseg hT
    obtain ⟨hwf, hNT, -, -⟩ := invariants_canonicalSegment hn 𝔪 h𝔪 hN h0 hmono T hseg hT
    change IsClosed (cosupport n (geoTransformAlong 𝔪 T).N _ _)
    rw [hNT]
    exact OrderTaylor.isClosed_cosupport hwf.isCoherent _
  · intro Y T hseg hT
    obtain ⟨hwf, -, h0T, -⟩ := invariants_canonicalSegment hn 𝔪 h𝔪 hN h0 hmono T hseg hT
    exact isInvUSCOn_gamma hn hwf.isSNCDivisor hwf.isCoherent h0T _ _
  · intro Y T hseg hT _
    obtain ⟨hwf, hNT, h0T, hmonoT⟩ := invariants_canonicalSegment hn 𝔪 h𝔪 hN h0 hmono T hseg hT
    obtain ⟨hC, hint⟩ := isAdmissibleCentre_maxLocus_gamma hn (geoTransformAlong 𝔪 T) hNT hwf.isSNCDivisor
      hwf.isCoherent h0T hmonoT
    exact ⟨hC, hint (by rw [d_geoTransformAlong]; exact hd)⟩
  · intro Y T hseg hT x₀ hx₀ Z π hπ z hz
    obtain ⟨hwf, hNT, h0T, hmonoT⟩ := invariants_canonicalSegment hn 𝔪 h𝔪 hN h0 hmono T hseg hT
    obtain ⟨-, -, -, -, -, -, hlt⟩ := monomial_step hn (geoTransformAlong 𝔪 T) hwf hNT h0T hmonoT hπ
    exact hlt x₀ hx₀ z hz

end Tower

end

end ComplexGeometry.AnalyticGeometry.MonomialResolution
