  ComplexGeometry.AnalyticGeometry.DivisorExponent ComplexGeometry.AnalyticGeometry.MemberPullback
  ComplexGeometry.AnalyticGeometry.MonomialPart ComplexGeometry.AnalyticGeometry.NormalCrossings
  ComplexGeometry.AnalyticGeometry.MonomialInvariant ComplexGeometry.AnalyticGeometry.BoundaryCount
  ComplexGeometry.AnalyticGeometry.MonomialCase ComplexGeometry.AnalyticGeometry.BlowupStrictSubmanifold
  ComplexGeometry.AnalyticGeometry.BlowupSNCTransform ComplexGeometry.AnalyticGeometry.InvertibleIdealQuotient
  ComplexGeometry.AnalyticGeometry.RestrictedIdealQuotient ComplexGeometry.AnalyticGeometry.RestrictedIdealExtension
  ComplexGeometry.AnalyticGeometry.MarkedIdeals ComplexGeometry.AnalyticGeometry.MarkedIdeals.MarkedIdeal
