import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.BlowupStrictIdeal

set_option autoImplicit false
set_option linter.unusedSectionVars false

/-!
# The controlled transform of a single function along a blowup

Source: Wlodarczyk 2005 (`wlodarczyk05-hironaka`), §2.2 (controlled transforms) and Lemma `le:Gi`
(for a tangent direction `u`, the controlled transform `u' = y^{-1} σ^* u`, where `y` is a local
equation of the exceptional divisor; `V(u')` is the strict transform of `V(u)`); Bierstone--Milman
2008 (`bierstone-milman08-functoriality`), §3.  Blueprint function transform,
giraud strict (chapter `blowup-calculus.tex`).

Let `π : Y → X` be the blowup along `C` with exceptional divisor `D`.  A *local equation* of `D` on
an open `U` is a holomorphic `h` on `U`, vanishing identically on no open subset, which generates
`𝒪_Y(-D)` at every point of `U` (`IsLocalEquation`; they exist around every point,
`exists_isLocalEquation`).  Then `𝒪_Y(-μD)` is generated by `h^μ` on `U` (`idealPow_mem_iff`) and:

* `exists_eq_pow_mul` -- for `u ∈ 𝓘_C^μ` at `π z`: `u ∘ π = h^μ · u'` near `z`, with `u'`
  holomorphic (the controlled transform `u' = h^{-μ} π^* u` of `u`);
* `eventuallyEq_of_pow_mul` -- `u'` is unique as a germ;
* `mem_controlledTransform_of_eq_pow_mul` -- `u ∈ 𝔞 ⟹ u' ∈ σ^c(𝔞, μ)`;
* `mem_controlledTransform_iff` -- for coherent `𝔞 ⊆ 𝓘_C^μ`, the stalk of `σ^c(𝔞, μ)` at `z` is
  generated by the controlled transforms of the germs of `𝔞` at `π z`;
* `vanishingIdeal_geoStrictTransform_mem_iff` -- **the geometric half of Giraud's lemma**: if
  `𝓘_N = (u)` at `π z` for a closed submanifold `N ⊇ C`, then `𝓘_{N'} = (u')` at `z`, where
  `N' = closure (π⁻¹(N \ C))` and `u ∘ π = h · u'`; and `mem_iff_eq_zero_of_span` reads this
  pointwise (`z ∈ N' ↔ u' z = 0`).

Everything here is sorry-free, and outside the import closure of the two Hironaka statements.
-/

open Set Filter
open scoped Topology Manifold ContDiff

universe u

namespace ComplexGeometry.AnalyticGeometry.BlowupFunctionTransform

open Pluripotential Pluripotential.HolomorphicIdealSheaves Pluripotential.BlowupSequences
  BlowupStrictSubmanifold BlowupExceptionalDivisor BlowupControlledTransform BlowupStrictIdeal
  IdealWeightPowers IdealWeightProducts IdealWeightComparison InvertibleIdealQuotient
  RelativePrincipalizationSpan GermIdealPullbackCalculus GermIdealTotalTransform
  VanishingIdealCoherent

noncomputable section

variable {n : ℕ}

/-! ### Germ algebra -/

section Algebra

variable {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M]

/-- Powers of a function holomorphic at a point are holomorphic there. Duplicate of
`BlowupDerivativeIdeal.holomorphicAt_pow` (the same statement, proved earlier), kept per the no-delete rule. -/
theorem holomorphicAt_pow {f : M → ℂ} {x : M} (hf : HolomorphicAt n f x) :
    ∀ μ : ℕ, HolomorphicAt n (fun y => f y ^ μ) x
  | 0 => by simpa using holomorphicAt_const (n := n) (x := x) (1 : ℂ)
  | μ + 1 => by simpa [pow_succ] using (holomorphicAt_pow hf μ).mul hf

/-- The span of the one-member family `f` is the span of `f`. -/
theorem isInSpanAt_range_const_iff {f : M → ℂ} {x : M} {g : M → ℂ} :
    IsInSpanAt (n := n) (· ∈ range fun _ : Fin 1 => f) x g ↔ IsInSpanAt (n := n) (· = f) x g :=
  ⟨fun h => h.mono fun _ ⟨_, hs⟩ => hs.symm, fun h => h.mono fun _ hs => ⟨0, hs.symm⟩⟩

/-- Members of an ideal power are holomorphic. -/
theorem holomorphicAt_of_mem_idealPow {𝔞 : GermIdeal n M} {x : M} {g : M → ℂ} :
    ∀ {μ : ℕ}, (idealPow 𝔞 μ).mem x g → HolomorphicAt n g x
  | 0, h => h
  | _ + 1, h => (InvertibleIdealQuotient.mem_mul_iff.mp h).holomorphicAt

/-- `𝓘_N ⊆ 𝓘_C` for `C ⊆ N`. -/
theorem vanishingIdeal_le_of_subset {C N : Set M} (hCN : C ⊆ N) :
    (vanishingIdeal (n := n) N).Le (vanishingIdeal (n := n) C) := fun _ _ hg =>
  ⟨hg.1, hg.2.mono fun _ hy hyC => hy (hCN hyC)⟩

/-- **A principal vanishing ideal, read pointwise**: if `𝓘_A = (v)` at `y` (`A` closed, `v`
holomorphic at `y`), then `y ∈ A ↔ v y = 0`. -/
theorem mem_iff_eq_zero_of_span {A : Set M} (hA : IsClosed A) {y : M} {v : M → ℂ}
    (hv : HolomorphicAt n v y)
    (hspan : ∀ g, (vanishingIdeal (n := n) A).mem y g ↔ IsInSpanAt (n := n) (· = v) y g) :
    y ∈ A ↔ v y = 0 := by
  constructor
  · intro hyA
    have hvmem := (hspan v).mpr (isInSpanAt_of_eq_mul rfl hv (holomorphicAt_const 1)
      (Eventually.of_forall fun _ => by simp))
    exact hvmem.2.self_of_nhds hyA
  · intro hv0
    by_contra hyA
    have h1 : (vanishingIdeal (n := n) A).mem y (fun _ => 1) := by
      refine ⟨holomorphicAt_const 1, ?_⟩
      filter_upwards [hA.isOpen_compl.mem_nhds hyA] with y' hy' hy'A
      exact absurd hy'A hy'
    obtain ⟨-, a, -, haeq⟩ := isInSpanAt_eq_iff.mp ((hspan _).mp h1)
    have := haeq.self_of_nhds
    simp only [hv0, mul_zero] at this
    exact one_ne_zero this

end Algebra

/-! ### Local equations of the exceptional divisor -/

section LocalEquation

variable {X : Type u} [TopologicalSpace X] [ChartedSpace (ComplexModel n) X]
  [IsComplexManifold n X] {Y : Type u} [TopologicalSpace Y] [ChartedSpace (ComplexModel n) Y]
  [IsComplexManifold n Y] {C : Set X} {π : Y → X}

/-- **A local equation of the exceptional divisor** on the open set `U`: holomorphic on `U`,
vanishing identically on no nonempty open subset of `U`, and generating `𝒪_Y(-D)` at each point of
`U`. -/
structure IsLocalEquation (hπ : IsBlowupAlong n C π) (U : Set Y) (h : Y → ℂ) : Prop where
  isOpen : IsOpen U
  mdifferentiableOn : MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) h U
  nonvanishing : ∀ W : Set Y, IsOpen W → W ⊆ U → W.Nonempty → ∃ y ∈ W, h y ≠ 0
  generates : ∀ y ∈ U, ∀ g,
    (exceptionalDivisor hπ).ideal.mem y g ↔ IsInSpanAt (n := n) (· = h) y g

/-- Local equations exist around every point (`𝒪_Y(-D)` is invertible). -/
theorem exists_isLocalEquation (hπ : IsBlowupAlong n C π) (z : Y) :
    ∃ U h, z ∈ U ∧ IsLocalEquation hπ U h := by
  obtain ⟨U, hU, hzU, h, hh, hnon, hgen⟩ := (exceptionalDivisor hπ).isInvertible z
  exact ⟨U, h, hzU, ⟨hU, hh, hnon, hgen⟩⟩

variable {hπ : IsBlowupAlong n C π} {U : Set Y} {h : Y → ℂ}

theorem IsLocalEquation.holomorphicAt (hh : IsLocalEquation hπ U h) {z : Y} (hz : z ∈ U) :
    HolomorphicAt n h z :=
  holomorphicAt_of_mdifferentiableOn hh.isOpen hh.mdifferentiableOn hz

theorem IsLocalEquation.nonvanishing_pow (hh : IsLocalEquation hπ U h) (μ : ℕ) :
    ∀ W : Set Y, IsOpen W → W ⊆ U → W.Nonempty → ∃ y ∈ W, h y ^ μ ≠ 0 := fun W hW hWU hne => by
  obtain ⟨y, hyW, hy⟩ := hh.nonvanishing W hW hWU hne
  exact ⟨y, hyW, pow_ne_zero μ hy⟩

/-- **`𝒪_Y(-μD)` is generated by `h^μ` on `U`.** -/
theorem IsLocalEquation.idealPow_mem_iff (hh : IsLocalEquation hπ U h) :
    ∀ (μ : ℕ), ∀ y ∈ U, ∀ g : Y → ℂ, (idealPow (exceptionalDivisor hπ).ideal μ).mem y g ↔
      IsInSpanAt (n := n) (· = fun y => h y ^ μ) y g
  | 0, y, _, g => by
    have h1 : (fun y => h y ^ 0) = fun _ => (1 : ℂ) := funext fun _ => pow_zero _
    rw [h1, idealPow_zero, mem_unitIdeal_iff, isInSpanAt_range_const_iff]
    rfl
  | μ + 1, y, hy, g => by
    have hpowdiff : ∀ i : Fin 1, MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ)
        ((fun _ : Fin 1 => fun y => h y ^ μ) i) U := fun _ y' hy' =>
      (holomorphicAt_pow (hh.holomorphicAt hy') μ).mdifferentiableAt.mdifferentiableWithinAt
    have hdiff : ∀ i : Fin 1, MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ)
        ((fun _ : Fin 1 => h) i) U := fun _ => hh.mdifferentiableOn
    rw [idealPow_succ, mem_mul_iff_isInSpanAt_mulFamily hh.isOpen hpowdiff hdiff
      (fun y' hy' k => by rw [isInSpanAt_range_const_iff]; exact hh.idealPow_mem_iff μ y' hy' k)
      (fun y' hy' k => by rw [isInSpanAt_range_const_iff]; exact hh.generates y' hy' k) hy g]
    have hfam : ∀ q, mulFamily (fun _ : Fin 1 => fun y => h y ^ μ) (fun _ : Fin 1 => h) q =
        fun y => h y ^ (μ + 1) := fun q => funext fun y => by simp [mulFamily, pow_succ]
    constructor
    · exact fun hg => hg.mono fun s ⟨q, hq⟩ => by rw [← hq, hfam q]
    · exact fun hg => hg.mono fun s hs => ⟨0, by rw [hfam 0, hs]⟩

/-- `h^μ` is a member of `𝒪_Y(-μD)` on `U`. -/
theorem IsLocalEquation.pow_mem (hh : IsLocalEquation hπ U h) (μ : ℕ) {z : Y} (hz : z ∈ U) :
    (idealPow (exceptionalDivisor hπ).ideal μ).mem z (fun y => h y ^ μ) :=
  (hh.idealPow_mem_iff μ z hz _).mpr (isInSpanAt_of_eq_mul rfl
    (holomorphicAt_pow (hh.holomorphicAt hz) μ) (holomorphicAt_const 1)
    (Eventually.of_forall fun _ => by simp))

/-! ### The controlled transform of a function -/

/-- **The controlled transform of a function**: for `u ∈ 𝓘_C^μ` at `π z`, `u ∘ π = h^μ · u'` near
`z` with `u'` holomorphic at `z` (Wlodarczyk's `u' = y^{-μ} σ^* u`). -/
theorem exists_eq_pow_mul (hh : IsLocalEquation hπ U h) {z : Y} (hz : z ∈ U) {μ : ℕ}
    {u : X → ℂ} (hu : (idealPow (vanishingIdeal (n := n) C) μ).mem (π z) u) :
    ∃ u' : Y → ℂ, HolomorphicAt n u' z ∧ (u ∘ π) =ᶠ[𝓝 z] fun y => h y ^ μ * u' y := by
  have hπat : ∀ᶠ y' in 𝓝 z, ContMDiffAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ π y' :=
    Eventually.of_forall fun y' => hπ.contMDiff y'
  have huhol : HolomorphicAt n (u ∘ π) z :=
    (holomorphicAt_of_mem_idealPow hu).comp_contMDiff hπat
  have hpb : (GermIdeal.pullback (m := n) π (idealPow (vanishingIdeal (n := n) C) μ)).mem z
      (u ∘ π) :=
    GermIdeal.mem_pullback_iff.mpr (isInSpanAt_of_eq_mul ⟨u, hu, rfl⟩ huhol
      (holomorphicAt_const 1) (Eventually.of_forall fun _ => by simp))
  rw [pullback_idealPow_vanishingIdeal hπ μ, hh.idealPow_mem_iff μ z hz] at hpb
  obtain ⟨-, a, ha, haeq⟩ := isInSpanAt_eq_iff.mp hpb
  exact ⟨a, ha, haeq.trans (Eventually.of_forall fun y => mul_comm _ _)⟩

/-- **Uniqueness of the controlled transform of a function** (as a germ). -/
theorem eventuallyEq_of_pow_mul (hh : IsLocalEquation hπ U h) {z : Y} (hz : z ∈ U) {μ : ℕ}
    {v w : Y → ℂ} (hv : HolomorphicAt n v z) (hw : HolomorphicAt n w z)
    (heq : (fun y => h y ^ μ * v y) =ᶠ[𝓝 z] fun y => h y ^ μ * w y) : v =ᶠ[𝓝 z] w :=
  eventuallyEq_of_mul_eventuallyEq hh.isOpen (hh.nonvanishing_pow μ) hz hv hw heq

/-- **`u ∈ 𝔞 ⟹ u' ∈ σ^c(𝔞, μ)`.** -/
theorem mem_controlledTransform_of_eq_pow_mul (hh : IsLocalEquation hπ U h) {z : Y} (hz : z ∈ U)
    {𝔞 : GermIdeal n X} {μ : ℕ} {u : X → ℂ} (hu : 𝔞.mem (π z) u) {u' : Y → ℂ}
    (hu' : HolomorphicAt n u' z) (heq : (u ∘ π) =ᶠ[𝓝 z] fun y => h y ^ μ * u' y) :
    (controlledTransform hπ 𝔞 μ).mem z u' := by
  refine mem_colon_iff.mpr ⟨hu', fun l hl => ?_⟩
  obtain ⟨hlhol, c, hc, hceq⟩ := isInSpanAt_eq_iff.mp ((hh.idealPow_mem_iff μ z hz l).mp hl)
  refine GermIdeal.mem_pullback_iff.mpr (isInSpanAt_of_eq_mul ⟨u, hu, rfl⟩ (hlhol.mul hu') hc ?_)
  filter_upwards [hceq, heq] with y h1 h2
  show l y * u' y = c y * u (π y)
  rw [h1, show u (π y) = (u ∘ π) y from rfl, h2]
  ring

/-- **The controlled transform is generated by controlled transforms of functions**: for a coherent
`𝔞 ⊆ 𝓘_C^μ`, a germ lies in `σ^c(𝔞, μ)` at `z` iff it is a combination of germs `v` with
`u ∘ π = h^μ v` for some `u ∈ 𝔞` at `π z`. -/
theorem mem_controlledTransform_iff (hh : IsLocalEquation hπ U h) {z : Y} (hz : z ∈ U)
    {𝔞 : GermIdeal n X} (h𝔞 : 𝔞.IsCoherent) {μ : ℕ}
    (hle : 𝔞.Le (idealPow (vanishingIdeal (n := n) C) μ)) (g : Y → ℂ) :
    (controlledTransform hπ 𝔞 μ).mem z g ↔
      IsInSpanAt (n := n) (fun v => HolomorphicAt n v z ∧ ∃ u, 𝔞.mem (π z) u ∧
        (u ∘ π) =ᶠ[𝓝 z] fun y => h y ^ μ * v y) z g := by
  constructor
  · intro hg
    obtain ⟨hgh, hall⟩ := mem_colon_iff.mp hg
    have hpb := GermIdeal.mem_pullback_iff.mp (hall _ (hh.pow_mem μ hz))
    obtain ⟨-, K, s, a, hs, ha, hsum⟩ := hpb
    choose u hu hsu using hs
    have hv : ∀ i, ∃ v : Y → ℂ, HolomorphicAt n v z ∧
        (u i ∘ π) =ᶠ[𝓝 z] fun y => h y ^ μ * v y := fun i =>
      exists_eq_pow_mul hh hz (hle _ _ (hu i))
    choose v hvhol hveq using hv
    have hsumhol : HolomorphicAt n (fun y => ∑ i, a i y * v i y) z :=
      HolomorphicAt.sum _ fun i _ => (ha i).mul (hvhol i)
    have hcancel : g =ᶠ[𝓝 z] fun y => ∑ i, a i y * v i y := by
      refine eventuallyEq_of_pow_mul hh hz (μ := μ) hgh hsumhol ?_
      filter_upwards [hsum, eventually_all.mpr hveq] with y h1 h2
      rw [h1, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [hsu i, h2 i]
      ring
    exact ⟨hgh, K, v, a, fun i => ⟨hvhol i, u i, hu i, hveq i⟩, ha, hcancel⟩
  · intro hg
    refine mem_of_isInSpanAt_mem (isCoherent_controlledTransform hπ h𝔞 hle) (hg.mono ?_)
    rintro v ⟨hvh, w, hw, hweq⟩
    exact mem_controlledTransform_of_eq_pow_mul hh hz hw hvh hweq

/-! ### The geometric half of Giraud's lemma -/

/-- **`V(u')` is the strict transform of `V(u)`**: if the ideal of a closed submanifold `N ⊇ C` is
generated by `u` at `π z` and `u ∘ π = h · u'` near `z`, then the ideal of the strict transform
`N' = closure (π⁻¹(N \ C))` is generated by `u'` at `z`. -/
theorem vanishingIdeal_geoStrictTransform_mem_iff (hh : IsLocalEquation hπ U h) {z : Y}
    (hz : z ∈ U) {N : Set X} (hN : IsClosedSubmanifold n N) (hCN : C ⊆ N) {u : X → ℂ}
    (hu : HolomorphicAt n u (π z))
    (hgen : ∀ g, (vanishingIdeal (n := n) N).mem (π z) g ↔ IsInSpanAt (n := n) (· = u) (π z) g)
    {u' : Y → ℂ} (hu' : HolomorphicAt n u' z) (heq : (u ∘ π) =ᶠ[𝓝 z] fun y => h y * u' y)
    (g : Y → ℂ) :
    (vanishingIdeal (n := n) (geoStrictTransform π C N)).mem z g ↔
      IsInSpanAt (n := n) (· = u') z g := by
  have hle : (vanishingIdeal (n := n) N).Le (idealPow (vanishingIdeal (n := n) C) 1) := by
    show (vanishingIdeal (n := n) N).Le ((idealPow (vanishingIdeal (n := n) C) 0).mul _)
    rw [idealPow_zero, unitIdeal_mul (isCoherent_vanishingIdeal hπ.1)]
    exact vanishingIdeal_le_of_subset hCN
  have heq1 : (u ∘ π) =ᶠ[𝓝 z] fun y => h y ^ 1 * u' y := by
    simpa only [pow_one] using heq
  have hπat : ∀ᶠ y' in 𝓝 z, ContMDiffAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ π y' :=
    Eventually.of_forall fun y' => hπ.contMDiff y'
  rw [← controlledTransform_vanishingIdeal hπ hN hCN,
    mem_controlledTransform_iff hh hz (isCoherent_vanishingIdeal hN) hle g]
  constructor
  · refine fun hg => IsInSpanAt.trans ?_ hg
    rintro v ⟨hvh, w, hw, hweq⟩
    obtain ⟨-, c, hc, hceq⟩ := isInSpanAt_eq_iff.mp ((hgen w).mp hw)
    have hcπ : HolomorphicAt n (c ∘ π) z := hc.comp_contMDiff hπat
    have hv : v =ᶠ[𝓝 z] fun y => (c ∘ π) y * u' y := by
      refine eventuallyEq_of_pow_mul hh hz (μ := 1) hvh (hcπ.mul hu') ?_
      filter_upwards [hweq, hπ.contMDiff.continuous.continuousAt.eventually hceq, heq] with
        y h1 h2 h3
      rw [← h1]
      show w (π y) = h y ^ 1 * ((c ∘ π) y * u' y)
      rw [h2, show u (π y) = (u ∘ π) y from rfl, h3]
      simp only [Function.comp_apply, pow_one]
      ring
    exact isInSpanAt_of_eq_mul rfl hvh hcπ hv
  · refine fun hg => hg.mono ?_
    rintro v rfl
    refine ⟨hu', u, (hgen u).mpr (isInSpanAt_of_eq_mul rfl hu (holomorphicAt_const 1)
      (Eventually.of_forall fun _ => by simp)), heq1⟩

/-- **Pointwise**: under the hypotheses of `vanishingIdeal_geoStrictTransform_mem_iff`,
`z ∈ N' ↔ u' z = 0`. -/
theorem mem_geoStrictTransform_iff_eq_zero (hh : IsLocalEquation hπ U h) {z : Y}
    (hz : z ∈ U) {N : Set X} (hN : IsClosedSubmanifold n N) (hCN : C ⊆ N) {u : X → ℂ}
    (hu : HolomorphicAt n u (π z))
    (hgen : ∀ g, (vanishingIdeal (n := n) N).mem (π z) g ↔ IsInSpanAt (n := n) (· = u) (π z) g)
    {u' : Y → ℂ} (hu' : HolomorphicAt n u' z) (heq : (u ∘ π) =ᶠ[𝓝 z] fun y => h y * u' y) :
    z ∈ geoStrictTransform π C N ↔ u' z = 0 :=
  mem_iff_eq_zero_of_span isClosed_closure hu'
    (vanishingIdeal_geoStrictTransform_mem_iff hh hz hN hCN hu hgen hu' heq)

end LocalEquation

end

end ComplexGeometry.AnalyticGeometry.BlowupFunctionTransform
