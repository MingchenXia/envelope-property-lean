import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.BoxCoeffsIdeal
import EnvelopeProperty.ComplexGeometry.AnalyticGeometry.HiepSliceLemma

set_option autoImplicit false

/-!
# Vanishing of torus coefficients from a polynomial sup bound or a pole integral

Nadel's proof that `𝓘(φ)_y` is generated by the global `L²` sections (Demailly, *Analytic
methods in algebraic geometry*, Prop. 5.7; the regularization, Step 4, cites it as
DEL00 Prop. 1.2) solves `∂̄` with a weight carrying a logarithmic pole `q log |z - y|²` at the
point `y`, and concludes that the difference `u` between the germ and the global section is
small at `y`: `∫ |u|² |z - y|^{-2q} < ∞` near `y`. To feed Krull's intersection theorem in the
form `AnalyticGeometry.GermKrullIntersection` this smallness has to be expressed through the torus
coefficients of `u` at a FIXED radius. This module does that, in two steps.

* `torusCoeff_eq_zero_of_norm_le_pow`: if `‖u‖ ≤ C r^N` on every small polydisc `Δ(p, r)`, then
  every torus coefficient `torusCoeff p s α u` with `|α| < N` vanishes, at every radius `s` of
  holomorphy. Induction on the dimension through
  `BoxCoeffsIdeal.torusCoeff_snoc_eq_mul_torusCoeff`; the circle coefficients in the last
  variable do not depend on the radius (`lastCoeff_eq_iteratedDeriv`, Cauchy's formula for
  derivatives), so they can be estimated on the circle of radius `r` (`norm_lastCoeff_le`).
* `norm_sq_le_of_lintegral_pole`: the mean-value inequality turns a uniform bound on
  `∫_{B(y,ρ)} |u|² (|z - y|² + η²)^{-q}` (all `η > 0`) into `|u(z)|² ≤ C r^{2(q - d)}` on
  `Δ(y, r)`.

`torusCoeff_eq_zero_of_lintegral_pole` combines them: pole order `q ≥ d + N` kills the torus
coefficients of total degree `< N`. This supplies the local vanishing input for
Nadel coherence, used in clause (i) of Demailly's 1992 approximation theorem.
-/

open Set Filter MeasureTheory Complex Metric
open scoped Real Topology Nat ENNReal

namespace ComplexGeometry.AnalyticGeometry.MultiplierIdealBergmanNadelVanishing

noncomputable section

section CircleCoeff

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

omit [NormedAddCommGroup E] [NormedSpace ℂ E] in
/-- **Cauchy's formula for the circle coefficients**: `lastCoeff h ρ k w` is the `k`-th Taylor
coefficient of `h (w, ·)` at `0`, whatever the radius `ρ` of holomorphy. -/
theorem lastCoeff_eq_iteratedDeriv {h : E × ℂ → ℂ} {w : E} {ρ R : ℝ} (hρ : 0 < ρ) (hρR : ρ < R)
    (hh : DifferentiableOn ℂ (fun ζ => h (w, ζ)) (ball 0 R)) (k : ℕ) :
    lastCoeff h ρ k w = (k ! : ℂ)⁻¹ * iteratedDeriv k (fun ζ => h (w, ζ)) 0 := by
  have hcl : closedBall (0 : ℂ) ρ ⊆ ball 0 R := closedBall_subset_ball hρR
  have := Complex.circleIntegral_one_div_sub_center_pow_smul_of_differentiable_on_off_countable
    (c := 0) hρ k countable_empty (hh.mono hcl).continuousOn
    (fun z hz => hh.differentiableAt (isOpen_ball.mem_nhds (ball_subset_ball hρR.le hz.1)))
  simp only [sub_zero, smul_eq_mul] at this
  unfold lastCoeff
  have hint : (∮ ζ in C(0, ρ), h (w, ζ) / ζ ^ (k + 1)) =
      ∮ ζ in C(0, ρ), 1 / ζ ^ (k + 1) * h (w, ζ) := by
    congr 1
    funext ζ
    ring
  rw [hint, this]
  have : (k ! : ℂ) ≠ 0 := by exact_mod_cast k.factorial_ne_zero
  field_simp

omit [NormedAddCommGroup E] [NormedSpace ℂ E] in
/-- The circle coefficients do not depend on the radius. -/
theorem lastCoeff_radius_eq {h : E × ℂ → ℂ} {w : E} {ρ₁ ρ₂ R : ℝ} (h₁ : 0 < ρ₁) (h₂ : 0 < ρ₂)
    (h₁R : ρ₁ < R) (h₂R : ρ₂ < R) (hh : DifferentiableOn ℂ (fun ζ => h (w, ζ)) (ball 0 R))
    (k : ℕ) : lastCoeff h ρ₁ k w = lastCoeff h ρ₂ k w := by
  rw [lastCoeff_eq_iteratedDeriv h₁ h₁R hh, lastCoeff_eq_iteratedDeriv h₂ h₂R hh]

omit [NormedAddCommGroup E] [NormedSpace ℂ E] in
/-- **Cauchy's estimate** on the circle of radius `ρ`. -/
theorem norm_lastCoeff_le {h : E × ℂ → ℂ} {w : E} {ρ B : ℝ} (hρ : 0 < ρ)
    (hB : ∀ ζ ∈ sphere (0 : ℂ) ρ, ‖h (w, ζ)‖ ≤ B) (k : ℕ) :
    ‖lastCoeff h ρ k w‖ ≤ B / ρ ^ k := by
  have := circleIntegral.norm_two_pi_i_inv_smul_integral_le_of_norm_le_const
    (f := fun ζ => h (w, ζ) / ζ ^ (k + 1)) (c := 0) (C := B / ρ ^ (k + 1)) hρ.le
    (fun ζ hζ => by
      have hn : ‖ζ‖ = ρ := by simpa using hζ
      rw [norm_div, norm_pow, hn]
      gcongr
      exact hB ζ hζ)
  rw [smul_eq_mul] at this
  calc ‖lastCoeff h ρ k w‖ ≤ ρ * (B / ρ ^ (k + 1)) := this
    _ = B / ρ ^ k := by field_simp; ring

end CircleCoeff

/-- A number dominated by `K r^n` for all small `r > 0`, with `n ≥ 1`, is `0`. -/
theorem eq_zero_of_norm_le_pow {a : ℂ} {K r₁ : ℝ} (hr₁ : 0 < r₁) {n : ℕ} (hn : 1 ≤ n)
    (h : ∀ r, 0 < r → r < r₁ → ‖a‖ ≤ K * r ^ n) : a = 0 := by
  have hlim : Tendsto (fun r : ℝ => K * r ^ n) (𝓝[>] 0) (𝓝 0) := by
    have : Tendsto (fun r : ℝ => K * r ^ n) (𝓝 0) (𝓝 (K * 0 ^ n)) :=
      ((continuous_pow n).const_mul K).tendsto 0 |>.congr fun _ => rfl
    rw [zero_pow (by omega), mul_zero] at this
    exact this.mono_left nhdsWithin_le_nhds
  have hev : ∀ᶠ r in 𝓝[>] (0 : ℝ), ‖a‖ ≤ K * r ^ n := by
    filter_upwards [Ioo_mem_nhdsGT hr₁] with r hr
    exact h r hr.1 hr.2
  have : ‖a‖ ≤ 0 := ge_of_tendsto hlim hev
  exact norm_le_zero_iff.mp this

section Polydisc

variable {m : ℕ}

/-- The estimate of the circle coefficients in the last variable by the sup of `e` on a small
polydisc. -/
theorem norm_lastCoeff_snocPoint_le {p : EuclideanSpace ℂ (Fin (m + 1))} {s s' : ℝ} (hs : 0 < s)
    (hss' : s < s') {e : EuclideanSpace ℂ (Fin (m + 1)) → ℂ}
    (he : DifferentiableOn ℂ e (openPolydisc p s')) {N : ℕ} {C r₀ : ℝ}
    (hbound : ∀ r, 0 < r → r < r₀ → ∀ z ∈ openPolydisc p r, ‖e z‖ ≤ C * r ^ N) (k : ℕ)
    {r : ℝ} (hr : 0 < r) (hr₀ : 2 * r < r₀) (hrs : r < s') {w : Fin m → ℂ} (hw : ‖w‖ < r) :
    ‖lastCoeff (fun x => e (snocPoint p x)) s k w‖ ≤ C * 2 ^ N * r ^ N / r ^ k := by
  have hws : w ∈ ball (0 : Fin m → ℂ) s' := by
    rw [mem_ball_zero_iff]; exact hw.trans hrs
  have hh : DifferentiableOn ℂ (fun ζ => (fun x => e (snocPoint p x)) (w, ζ)) (ball 0 s') :=
    (differentiableOn_comp_snocPoint he).comp ((differentiableOn_const w).prodMk differentiableOn_id)
      fun ζ hζ => ⟨hws, hζ⟩
  rw [lastCoeff_radius_eq hs hr hss' hrs hh k]
  refine norm_lastCoeff_le (B := C * 2 ^ N * r ^ N) hr (fun ζ hζ => ?_) k
  · have hmem : snocPoint p (w, ζ) ∈ openPolydisc p (2 * r) := by
      refine snocPoint_mem_openPolydisc ⟨?_, ?_⟩
      · rw [mem_ball_zero_iff]; linarith
      · rw [mem_ball_zero_iff]
        have : ‖ζ‖ = r := by simpa using hζ
        linarith
    have := hbound (2 * r) (by positivity) hr₀ _ hmem
    rwa [mul_pow, ← mul_assoc] at this

/-- **Polynomial smallness kills the low torus coefficients.**  If `e` is holomorphic on the
polydisc `Δ(p, s')` and `‖e‖ ≤ C r^N` on every polydisc `Δ(p, r)` with `r < r₀`, then the torus
coefficients of `e` of total degree `< N` vanish at every radius `0 < s < s'`. -/
theorem torusCoeff_eq_zero_of_norm_le_pow : ∀ {m : ℕ} {p : EuclideanSpace ℂ (Fin (m + 1))}
    {s s' : ℝ}, 0 < s → s < s' → ∀ {e : EuclideanSpace ℂ (Fin (m + 1)) → ℂ},
    DifferentiableOn ℂ e (openPolydisc p s') → ∀ {N : ℕ} {C r₀ : ℝ}, 0 < r₀ →
    (∀ r, 0 < r → r < r₀ → ∀ z ∈ openPolydisc p r, ‖e z‖ ≤ C * r ^ N) →
    ∀ α : Fin (m + 1) → ℕ, ∑ i, α i < N → torusCoeff p s (fun i => (α i : ℤ)) e = 0 := by
  intro m
  induction m with
  | zero =>
    intro p s s' hs hss' e he N C r₀ hr₀ hbound α hα
    have hαs : α = Fin.snoc (α := fun _ => ℕ) (Fin.init α) (α (Fin.last 0)) :=
      (Fin.snoc_init_self α).symm
    have hk : α (Fin.last 0) < N := by simpa using hα
    rw [hαs, torusCoeff_snoc_eq p hs, setIntegral_Icc_fin_zero]
    simp only [Finset.univ_eq_empty, Finset.sum_empty, neg_zero, zero_mul, exp_zero, mul_one]
    set w : Fin 0 → ℂ := fun i => (s : ℂ) * exp (((0 : Fin 0 → ℝ) i : ℂ) * I)
    have hzero : lastCoeff (fun x => e (snocPoint p x)) s (α (Fin.last 0)) w = 0 := by
      refine eq_zero_of_norm_le_pow (r₁ := min (r₀ / 2) s') (lt_min (by positivity) (hs.trans hss'))
        (n := N - α (Fin.last 0)) (by omega) (K := C * 2 ^ N) fun r hr hrr => ?_
      have hr₀' : 2 * r < r₀ := by have := min_le_left (r₀ / 2) s'; linarith
      have hrs : r < s' := hrr.trans_le (min_le_right _ _)
      have hw : ‖w‖ < r := by rw [Subsingleton.elim w 0, norm_zero]; exact hr
      refine (norm_lastCoeff_snocPoint_le hs hss' he hbound _ hr hr₀' hrs hw).trans
        (le_of_eq ?_)
      rw [mul_div_assoc, pow_sub₀ _ hr.ne' hk.le, div_eq_mul_inv]
    rw [hzero, mul_zero]
  | succ m ih =>
    intro p s s' hs hss' e he N C r₀ hr₀ hbound α hα
    have hαs : α = Fin.snoc (α := fun _ => ℕ) (Fin.init α) (α (Fin.last (m + 1))) :=
      (Fin.snoc_init_self α).symm
    set k := α (Fin.last (m + 1)) with hkdef
    set β : Fin (m + 1) → ℕ := Fin.init α with hβdef
    have hsum : ∑ i, α i = ∑ i, β i + k := by
      rw [Fin.sum_univ_castSucc]
      rfl
    rw [hαs, torusCoeff_snoc_eq_mul_torusCoeff hs hss' he]
    have hk : k < N := by omega
    have hβ : ∑ i, β i < N - k := by omega
    have hIH := ih (p := initPoint p) hs hss' (differentiableOn_lastCoeff_sub hs hss' he k)
      (N := N - k) (C := C * 2 ^ N) (r₀ := min (r₀ / 2) s') (lt_min (by positivity) (hs.trans hss'))
      (fun r hr hrr z hz => ?_) β hβ
    · rw [hIH, mul_zero]
    · have hr₀' : 2 * r < r₀ := by have := min_le_left (r₀ / 2) s'; linarith
      have hrs : r < s' := hrr.trans_le (min_le_right _ _)
      have hw : ‖(fun j => z j - initPoint p j)‖ < r := by
        rw [pi_norm_lt_iff hr]
        exact hz
      refine (norm_lastCoeff_snocPoint_le hs hss' he hbound k hr hr₀' hrs hw).trans
        (le_of_eq ?_)
      rw [mul_div_assoc, pow_sub₀ _ hr.ne' hk.le, div_eq_mul_inv]

end Polydisc

section Pole

variable {m : ℕ}

theorem finrank_real_euclidean (m : ℕ) :
    Module.finrank ℝ (EuclideanSpace ℂ (Fin (m + 1))) = 2 * (m + 1) := by
  rw [← Module.finrank_mul_finrank ℝ ℂ (EuclideanSpace ℂ (Fin (m + 1))),
    Complex.finrank_real_complex, finrank_euclideanSpace_fin]

/-- A polydisc of radius `r` lies in the Euclidean ball of radius `(m + 1) r`. -/
theorem norm_sub_lt_of_mem_openPolydisc {p z : EuclideanSpace ℂ (Fin (m + 1))} {r : ℝ}
    (hz : z ∈ openPolydisc p r) : ‖z - p‖ < (m + 1) * r := by
  have hr : 0 < r := (norm_nonneg _).trans_lt (hz 0)
  have hsq : ‖z - p‖ ^ 2 < ((m + 1) * r) ^ 2 := by
    rw [EuclideanSpace.norm_sq_eq]
    calc ∑ i, ‖(z - p) i‖ ^ 2 < ∑ _i : Fin (m + 1), r ^ 2 := by
          refine Finset.sum_lt_sum_of_nonempty Finset.univ_nonempty fun i _ => ?_
          have h := hz i
          rw [PiLp.sub_apply]
          exact pow_lt_pow_left₀ h (norm_nonneg _) two_ne_zero
      _ = (m + 1) * r ^ 2 := by simp
      _ ≤ ((m + 1) * r) ^ 2 := by
          rw [mul_pow]
          gcongr
          nlinarith
  exact lt_of_pow_lt_pow_left₀ 2 (by positivity) hsq

/-- **The mean-value inequality against a pole.**  If `∫_{B(y,ρ)} |u|² (|z - y|² + η²)^{-q} ≤ A`
for every `η > 0`, then `|u(z)|² r^{2(m+1)} ≤ C r^{2q}` on every polydisc `Δ(y, r)` with
`(m + 3) r < ρ`. -/
theorem exists_norm_sq_mul_le_of_lintegral_pole {u : EuclideanSpace ℂ (Fin (m + 1)) → ℂ}
    {y : EuclideanSpace ℂ (Fin (m + 1))} {ρ : ℝ} (hu : DifferentiableOn ℂ u (ball y ρ)) {q : ℕ}
    {A : ℝ≥0∞} (hA : A ≠ ⊤)
    (hint : ∀ η : ℝ, 0 < η → ∫⁻ z in ball y ρ, ENNReal.ofReal (‖u z‖ ^ 2) *
      ENNReal.ofReal (((‖z - y‖ ^ 2 + η ^ 2) ^ q)⁻¹) ≤ A) :
    ∃ C : ℝ, ∀ r : ℝ, 0 < r → (m + 3) * r < ρ → ∀ z ∈ openPolydisc y r,
      ‖u z‖ ^ 2 * r ^ (2 * (m + 1)) ≤ C * r ^ (2 * q) := by
  set V1 : ℝ≥0∞ := volume (ball (0 : EuclideanSpace ℂ (Fin (m + 1))) 1) with hV1
  have hV1ne : V1 ≠ 0 := (measure_ball_pos volume _ one_pos).ne'
  have hV1top : V1 ≠ ⊤ := measure_ball_lt_top.ne
  have hV1pos : 0 < V1.toReal := ENNReal.toReal_pos hV1ne hV1top
  set K : ℝ := (((m : ℝ) + 2) ^ 2 + 1) ^ q with hK
  refine ⟨K * A.toReal / V1.toReal, fun r hr hrρ z hz => ?_⟩
  have hzy : ‖z - y‖ < (m + 1) * r := norm_sub_lt_of_mem_openPolydisc hz
  have hball : ball z r ⊆ ball y ρ := fun w hw => by
    rw [mem_ball, dist_eq_norm] at hw ⊢
    calc ‖w - y‖ ≤ ‖w - z‖ + ‖z - y‖ := norm_sub_le_norm_sub_add_norm_sub w z y
      _ < r + (m + 1) * r := add_lt_add hw hzy
      _ ≤ ρ := by nlinarith
  have hcl : closedBall z r ⊆ ball y ρ := fun w hw => by
    rw [mem_closedBall, dist_eq_norm] at hw
    rw [mem_ball, dist_eq_norm]
    calc ‖w - y‖ ≤ ‖w - z‖ + ‖z - y‖ := norm_sub_le_norm_sub_add_norm_sub w z y
      _ < r + (m + 1) * r := add_lt_add_of_le_of_lt hw hzy
      _ ≤ ρ := by nlinarith
  have hmv := lintegral_ball_normSq_ge isOpen_ball hu hr hcl
  -- the pole factor is at least `(K r^{2q})⁻¹` on `ball z r`
  have hpt : ∀ w ∈ ball z r, ENNReal.ofReal (‖u w‖ ^ 2) ≤
      ENNReal.ofReal (K * r ^ (2 * q)) * (ENNReal.ofReal (‖u w‖ ^ 2) *
        ENNReal.ofReal (((‖w - y‖ ^ 2 + r ^ 2) ^ q)⁻¹)) := by
    intro w hw
    have hwy : ‖w - y‖ < (m + 2) * r := by
      rw [mem_ball, dist_eq_norm] at hw
      calc ‖w - y‖ ≤ ‖w - z‖ + ‖z - y‖ := norm_sub_le_norm_sub_add_norm_sub w z y
        _ < r + (m + 1) * r := add_lt_add hw hzy
        _ = (m + 2) * r := by ring
    have hbase : ‖w - y‖ ^ 2 + r ^ 2 ≤ ((m + 2) ^ 2 + 1) * r ^ 2 := by
      have : ‖w - y‖ ^ 2 ≤ ((m + 2) * r) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) hwy.le 2
      nlinarith
    have hpos : 0 < ‖w - y‖ ^ 2 + r ^ 2 := by positivity
    have hle : (‖w - y‖ ^ 2 + r ^ 2) ^ q ≤ K * r ^ (2 * q) := by
      rw [hK, pow_mul, ← mul_pow]
      exact pow_le_pow_left₀ hpos.le hbase q
    have hone : 1 ≤ K * r ^ (2 * q) * ((‖w - y‖ ^ 2 + r ^ 2) ^ q)⁻¹ := by
      rw [← div_eq_mul_inv, one_le_div (by positivity)]
      exact hle
    calc ENNReal.ofReal (‖u w‖ ^ 2) = ENNReal.ofReal (‖u w‖ ^ 2) * 1 := (mul_one _).symm
      _ ≤ ENNReal.ofReal (‖u w‖ ^ 2) *
          ENNReal.ofReal (K * r ^ (2 * q) * ((‖w - y‖ ^ 2 + r ^ 2) ^ q)⁻¹) := by
          gcongr
          rw [← ENNReal.ofReal_one]
          exact ENNReal.ofReal_le_ofReal hone
      _ = _ := by
          rw [ENNReal.ofReal_mul (by positivity)]
          ring
  have hupper : ∫⁻ w in ball z r, ENNReal.ofReal (‖u w‖ ^ 2) ≤
      ENNReal.ofReal (K * r ^ (2 * q)) * A := by
    calc ∫⁻ w in ball z r, ENNReal.ofReal (‖u w‖ ^ 2)
        ≤ ∫⁻ w in ball z r, ENNReal.ofReal (K * r ^ (2 * q)) * (ENNReal.ofReal (‖u w‖ ^ 2) *
          ENNReal.ofReal (((‖w - y‖ ^ 2 + r ^ 2) ^ q)⁻¹)) :=
          setLIntegral_mono' measurableSet_ball hpt
      _ = ENNReal.ofReal (K * r ^ (2 * q)) * ∫⁻ w in ball z r, ENNReal.ofReal (‖u w‖ ^ 2) *
          ENNReal.ofReal (((‖w - y‖ ^ 2 + r ^ 2) ^ q)⁻¹) :=
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
      _ ≤ ENNReal.ofReal (K * r ^ (2 * q)) * ∫⁻ w in ball y ρ, ENNReal.ofReal (‖u w‖ ^ 2) *
          ENNReal.ofReal (((‖w - y‖ ^ 2 + r ^ 2) ^ q)⁻¹) := by
          gcongr
      _ ≤ ENNReal.ofReal (K * r ^ (2 * q)) * A := by
          gcongr
          exact hint r hr
  have hvol : volume (ball z r) = ENNReal.ofReal (r ^ (2 * (m + 1))) * V1 := by
    rw [Measure.addHaar_ball _ _ hr.le, finrank_real_euclidean]
  have hchain : ENNReal.ofReal (r ^ (2 * (m + 1))) * V1 * ENNReal.ofReal (‖u z‖ ^ 2) ≤
      ENNReal.ofReal (K * r ^ (2 * q)) * A := by
    rw [← hvol]
    exact hmv.trans hupper
  have hreal := ENNReal.toReal_mono (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hA) hchain
  rw [ENNReal.toReal_mul, ENNReal.toReal_mul, ENNReal.toReal_mul, ENNReal.toReal_ofReal
    (by positivity), ENNReal.toReal_ofReal (by positivity), ENNReal.toReal_ofReal
    (by positivity)] at hreal
  rw [div_mul_eq_mul_div, le_div_iff₀ hV1pos]
  nlinarith [hreal]

/-- **Pole integrability kills the low torus coefficients.**  If `u` is holomorphic on the
polydisc `Δ(y, s')` and on `B(y, ρ)`, and `∫_{B(y,ρ)} |u|² (|z - y|² + η²)^{-q}` is bounded
uniformly in `η > 0` with `q ≥ N + (m + 1)`, then the torus coefficients of `u` of total degree
`< N` vanish at every radius `0 < s < s'`. -/
theorem torusCoeff_eq_zero_of_lintegral_pole {y : EuclideanSpace ℂ (Fin (m + 1))} {s s' ρ : ℝ}
    (hs : 0 < s) (hss' : s < s') (hρ : 0 < ρ) {u : EuclideanSpace ℂ (Fin (m + 1)) → ℂ}
    (hu : DifferentiableOn ℂ u (openPolydisc y s')) (hu' : DifferentiableOn ℂ u (ball y ρ))
    {q N : ℕ} (hqN : N + (m + 1) ≤ q) {A : ℝ≥0∞} (hA : A ≠ ⊤)
    (hint : ∀ η : ℝ, 0 < η → ∫⁻ z in ball y ρ, ENNReal.ofReal (‖u z‖ ^ 2) *
      ENNReal.ofReal (((‖z - y‖ ^ 2 + η ^ 2) ^ q)⁻¹) ≤ A)
    (α : Fin (m + 1) → ℕ) (hα : ∑ i, α i < N) : torusCoeff y s (fun i => (α i : ℤ)) u = 0 := by
  obtain ⟨C, hC⟩ := exists_norm_sq_mul_le_of_lintegral_pole hu' hA hint
  set C' : ℝ := max C 0 with hC'
  refine torusCoeff_eq_zero_of_norm_le_pow hs hss' hu (N := N) (C := Real.sqrt C')
    (r₀ := min 1 (ρ / (m + 3))) (lt_min one_pos (by positivity)) (fun r hr hrr z hz => ?_) α hα
  have hr1 : r < 1 := hrr.trans_le (min_le_left _ _)
  have hrρ : (m + 3) * r < ρ := by
    have := hrr.trans_le (min_le_right _ _)
    rw [lt_div_iff₀ (by positivity)] at this
    linarith
  have h := hC r hr hrρ z hz
  set t : ℝ := r ^ (q - (m + 1)) with ht
  have hsplit : r ^ (2 * q) = r ^ (2 * (m + 1)) * t ^ 2 := by
    rw [ht, ← pow_mul, ← pow_add]
    congr 1
    omega
  have hpos : 0 < r ^ (2 * (m + 1)) := by positivity
  have hsq : ‖u z‖ ^ 2 ≤ (Real.sqrt C' * t) ^ 2 := by
    rw [mul_pow, Real.sq_sqrt (le_max_right _ _)]
    rw [hsplit, ← mul_assoc, mul_comm C (r ^ (2 * (m + 1))), mul_assoc] at h
    have h' : ‖u z‖ ^ 2 ≤ C * t ^ 2 := le_of_mul_le_mul_right (by linarith) hpos
    exact h'.trans (by gcongr; exact le_max_left _ _)
  have hut : ‖u z‖ ≤ Real.sqrt C' * t :=
    (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).mp hsq
  refine hut.trans ?_
  gcongr
  exact pow_le_pow_of_le_one hr.le hr1.le (by omega)

end Pole

