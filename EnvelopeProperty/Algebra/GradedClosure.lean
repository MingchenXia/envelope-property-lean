import EnvelopeProperty.Algebra.Veronese

/-!
# The normalized Rees algebra of a set of generators

Let `k` be a field, `A` a finitely generated `k`-algebra which is a domain, and `y_1, …, y_m`
generators of `A`. Put

* `S = k[T, y_1 T, …, y_m T] ⊆ A[T]` (`EnvelopeProperty.gradedRees k y`), generated by the
  elements `EnvelopeProperty.reesGen y : Option ι → A[T]` (`none ↦ T`, `some i ↦ y_i T`);
* `S'` the integral closure of `S` in `A[T]` (`EnvelopeProperty.normalizedRees k y`).

This is `lem:wu-graded-closure` of the blueprint chapter `wu-discharge.tex` (subsection
`subsec:wu-compactification`), the algebraic input of the normal compactification attached to a
Fubini–Study function (Fang–Han–Xia, *The envelope property for unibranch projective varieties*,
Lemma 5.9 `lem:boundary-presentation`; Wu, Proposition 3.17(2)); it is shared with the general
normal projective varieties of FHX Corollary 5.26. `Proj S'` is the normalization of the closure
of `Spec A` in `ℙ^m` under the embedding by `(y_1, …, y_m)`.

## Main results (`lem:wu-graded-closure`)

1. `EnvelopeProperty.isGraded_normalizedRees`: `S'` is a graded subalgebra of `A[T]` (`k`
   infinite; torus action and Vandermonde).
2. `EnvelopeProperty.finite_normalizedRees`, `EnvelopeProperty.fg_normalizedRees`,
   `EnvelopeProperty.finiteDimensional_gradedPiece_normalizedRees`: `S'` is a finite `S`-module,
   a finitely generated `k`-algebra, and every `S'_d` is finite dimensional (finiteness of
   normalization, `thm:bj-normalization-finite`, `EnvelopeProperty.finite_integralClosure`).
3. `EnvelopeProperty.isIntegrallyClosed_normalizedRees`: `S'` is an integrally closed domain if
   `A` is.
4. `EnvelopeProperty.exists_algebraMap_eq_of_C_mem_normalizedRees`: `S'_0 = k` (`k`
   algebraically closed).
5. `EnvelopeProperty.homLoc_normalizedRees_one_one`, `EnvelopeProperty.homLocNormalizedReesEquiv`:
   `S'_{(T)} ≅ A` via `b T^d / T^d ↦ b`; concretely every `a ∈ A` has `a T^n ∈ S` for all large
   `n` (`EnvelopeProperty.eventually_monomial_mem_gradedRees`).
6. `EnvelopeProperty.exists_pow_eq_sum_reesGen`: every `b ∈ S'_d`, `d > 0`, has a power
   `b^n = ∑_l g_l c_l` in the ideal of `S'` generated by `g = (T, y_1 T, …, y_m T)`, with
   `c_l ∈ S'_{nd - 1}`.

`EnvelopeProperty.normalizedRees_spec` bundles (1)–(6), and
`EnvelopeProperty.exists_veronese_normalizedRees` combines them with `lem:wu-veronese` for the
data of `def:wu-compactification`.

## Implementation notes

* Graded rings are modelled concretely as `k`-subalgebras of `A[T] = Polynomial A`, see
  `EnvelopeProperty.Algebra.GradedClosureBasic`.
* (3) The blueprint shows that `z ∈ Frac S'` integral over `S'` lies in `A[T, T⁻¹]` and then that
  its negative components vanish. Since `A[T]` is itself integrally closed (Mathlib), it suffices
  that `S'` is integrally closed in `A[T]`
  (`IsIntegrallyClosed.of_isIntegrallyClosed_of_isIntegrallyClosedIn`).
* (2) We embed `A[T]` into `Frac A[T]`, which is a fraction field of `S` because `T^n p ∈ S` for
  large `n` (`EnvelopeProperty.isFractionRing_of_gradedRees_le`).
* Hypotheses are kept minimal per part: (1) and the homogeneous refinement in (6) need `k`
  infinite; the finiteness in (2) needs `k` perfect and `A` a domain; (4) and the finite
  dimensionality in (2) need `k` algebraically closed; (3) needs only that `A` is a normal domain
  (no generation hypothesis); (2) and (5) use that `y` generates `A`.
-/

open Polynomial

noncomputable section

namespace EnvelopeProperty

variable {k : Type*} [Field k] {A : Type*} [CommRing A] [Algebra k A] {ι : Type*}

/-! ### Definitions -/

/-- The generators `g_0 = T`, `g_i = y_i T` of the Rees algebra `S = k[T, y_1 T, …, y_m T]`,
indexed by `Option ι` (`none ↦ T`). -/
def reesGen (y : ι → A) : Option ι → A[X]
  | none => X
  | some i => C (y i) * X

@[simp]
theorem reesGen_none (y : ι → A) : reesGen y none = X :=
  rfl

@[simp]
theorem reesGen_some (y : ι → A) (i : ι) : reesGen y (some i) = C (y i) * X :=
  rfl

theorem isHomog_reesGen (y : ι → A) (o : Option ι) : IsHomog 1 (reesGen y o) := by
  cases o with
  | none => exact ⟨1, by rw [reesGen_none, monomial_one_one_eq_X]⟩
  | some i => exact ⟨y i, by rw [reesGen_some, ← pow_one X, C_mul_X_pow_eq_monomial]⟩

variable (k) in
/-- The graded subalgebra `S = k[T, y_1 T, …, y_m T]` of `A[T]` (`lem:wu-graded-closure`). -/
def gradedRees (y : ι → A) : Subalgebra k A[X] :=
  Algebra.adjoin k (Set.range (reesGen y))

variable (k) in
/-- The *normalized Rees algebra* `S'`: the integral closure of `S = k[T, y_1 T, …, y_m T]` in
`A[T]` (`lem:wu-graded-closure`). -/
def normalizedRees (y : ι → A) : Subalgebra k A[X] :=
  (integralClosure (gradedRees k y) A[X]).restrictScalars k

variable {y : ι → A}

theorem mem_normalizedRees {p : A[X]} : p ∈ normalizedRees k y ↔ IsIntegral (gradedRees k y) p :=
  Iff.rfl

theorem reesGen_mem_gradedRees (o : Option ι) : reesGen y o ∈ gradedRees k y :=
  Algebra.subset_adjoin (Set.mem_range_self o)

theorem X_mem_gradedRees : (X : A[X]) ∈ gradedRees k y :=
  reesGen_mem_gradedRees (y := y) none

theorem C_mul_X_mem_gradedRees (i : ι) : C (y i) * X ∈ gradedRees k y :=
  reesGen_mem_gradedRees (y := y) (some i)

theorem gradedRees_le_normalizedRees : gradedRees k y ≤ normalizedRees k y :=
  fun p hp => isIntegral_algebraMap (R := gradedRees k y) (x := ⟨p, hp⟩)

theorem X_mem_normalizedRees : (X : A[X]) ∈ normalizedRees k y :=
  gradedRees_le_normalizedRees X_mem_gradedRees

/-- `S` is a finitely generated `k`-algebra. -/
theorem fg_gradedRees [Finite ι] : (gradedRees k y).FG :=
  Subalgebra.fg_def.2 ⟨_, Set.finite_range _, rfl⟩

/-- `S` is graded. -/
theorem isGraded_gradedRees : IsTGraded (gradedRees k y) :=
  isGraded_adjoin fun _ ⟨o, ho⟩ => ⟨1, ho ▸ isHomog_reesGen y o⟩

/-- `S_0 = k`: the constant term of an element of `S` lies in `k`. -/
theorem exists_algebraMap_eq_coeff_zero_of_mem_gradedRees {p : A[X]} (hp : p ∈ gradedRees k y) :
    ∃ c : k, algebraMap k A c = p.coeff 0 :=
  exists_algebraMap_eq_coeff_zero (s := Set.range (reesGen y))
    (fun _ ⟨o, ho⟩ => ho ▸ (isHomog_reesGen y o).coeff_of_ne zero_ne_one) hp

/-! ### (5) Every element of `A` is a degree zero fraction -/

/-- If `y` generates `A`, then for every `a ∈ A` we have `a T^n ∈ S` for all large `n`. -/
theorem eventually_monomial_mem_gradedRees (hy : Algebra.adjoin k (Set.range y) = ⊤) (a : A) :
    ∀ᶠ n in Filter.atTop, monomial n a ∈ gradedRees k y := by
  have ha : a ∈ Algebra.adjoin k (Set.range y) := hy ▸ Algebra.mem_top
  induction ha using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    filter_upwards [Filter.eventually_ge_atTop 1] with n hn
    have : monomial n (y i) = C (y i) * X * X ^ (n - 1) := by
      rw [mul_assoc, ← pow_succ', Nat.sub_add_cancel hn, C_mul_X_pow_eq_monomial]
    rw [this]
    exact Subalgebra.mul_mem _ (C_mul_X_mem_gradedRees i)
      (Subalgebra.pow_mem _ X_mem_gradedRees _)
  | algebraMap c =>
    refine Filter.Eventually.of_forall fun n => ?_
    rw [← C_mul_X_pow_eq_monomial, ← Polynomial.algebraMap_apply]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ c)
      (Subalgebra.pow_mem _ X_mem_gradedRees _)
  | add x z _ _ hx hz =>
    filter_upwards [hx, hz] with n hxn hzn
    rw [map_add]
    exact Subalgebra.add_mem _ hxn hzn
  | mul x z _ _ hx hz =>
    obtain ⟨N, hN⟩ := Filter.eventually_atTop.1 hx
    obtain ⟨M, hM⟩ := Filter.eventually_atTop.1 hz
    refine Filter.eventually_atTop.2 ⟨N + M, fun n hn => ?_⟩
    have : monomial n (x * z) = monomial N x * monomial (n - N) z := by
      rw [monomial_mul_monomial, Nat.add_sub_cancel' (by omega)]
    rw [this]
    exact Subalgebra.mul_mem _ (hN N le_rfl) (hM _ (by omega))

/-- If `y` generates `A`, then for every `p ∈ A[T]` we have `T^n p ∈ S` for all large `n`. -/
theorem eventually_X_pow_mul_mem_gradedRees (hy : Algebra.adjoin k (Set.range y) = ⊤)
    (p : A[X]) : ∀ᶠ n in Filter.atTop, X ^ n * p ∈ gradedRees k y := by
  have h : ∀ j ∈ Finset.range (p.natDegree + 1),
      ∀ᶠ n in Filter.atTop, monomial (n + j) (p.coeff j) ∈ gradedRees k y := fun j _ =>
    (Filter.tendsto_add_atTop_nat j).eventually (eventually_monomial_mem_gradedRees hy _)
  filter_upwards [(Filter.eventually_all_finset _).2 h] with n hn
  rw [as_sum_range p, Finset.mul_sum]
  refine Subalgebra.sum_mem _ fun j hj => ?_
  rw [← C_mul_X_pow_eq_monomial, ← mul_assoc, mul_comm (X ^ n), mul_assoc, ← pow_add,
    C_mul_X_pow_eq_monomial]
  exact hn j hj

theorem exists_monomial_mem_gradedRees (hy : Algebra.adjoin k (Set.range y) = ⊤) (a : A) :
    ∃ n, monomial n a ∈ gradedRees k y :=
  (eventually_monomial_mem_gradedRees hy a).exists

/-- **`lem:wu-graded-closure`(5).** `S'_{(T)} = A`: the degree zero part of `S'[T⁻¹]` is all of
`A ⊆ Frac A`. -/
theorem homLoc_normalizedRees_one_one [IsDomain A] (hy : Algebra.adjoin k (Set.range y) = ⊤) :
    homLoc (normalizedRees k y) 1 1 = (IsScalarTower.toAlgHom k A (FractionRing A)).range :=
  homLoc_one_eq_range fun a => by
    obtain ⟨n, hn⟩ := exists_monomial_mem_gradedRees hy a
    exact ⟨n, gradedRees_le_normalizedRees (by rw [mul_one]; exact hn)⟩

/-- **`lem:wu-graded-closure`(5).** The isomorphism `S'_{(T)} ≅ A`, `b T^d / T^d ↦ b`. -/
def homLocNormalizedReesEquiv [IsDomain A] (hy : Algebra.adjoin k (Set.range y) = ⊤) :
    homLoc (normalizedRees k y) 1 1 ≃ₐ[k] A :=
  homLocOneEquiv (homLoc_normalizedRees_one_one hy)

/-- The isomorphism `S'_{(T)} ≅ A` is inverse to the inclusion `A ⊆ Frac A`. -/
theorem algebraMap_homLocNormalizedReesEquiv [IsDomain A]
    (hy : Algebra.adjoin k (Set.range y) = ⊤) (x : homLoc (normalizedRees k y) 1 1) :
    algebraMap A (FractionRing A) (homLocNormalizedReesEquiv hy x) = x :=
  algebraMap_homLocOneEquiv _ x

/-- The isomorphism `S'_{(T)} ≅ A` maps `b T^n / T^n` to `b`. -/
theorem homLocNormalizedReesEquiv_div [IsDomain A] (hy : Algebra.adjoin k (Set.range y) = ⊤)
    {n : ℕ} {b : A} (hb : monomial (n * 1) b ∈ normalizedRees k y) :
    homLocNormalizedReesEquiv hy ⟨_, div_mem_homLoc (s := (1 : A)) hb⟩ = b :=
  homLocOneEquiv_div _ hb

/-! ### (1) Gradedness -/

/-- The torus automorphisms `T ↦ λ T` preserve `S`. -/
theorem torusAut_mem_gradedRees (c : kˣ) {p : A[X]} (hp : p ∈ gradedRees k y) :
    torusAut A c p ∈ gradedRees k y := by
  induction hp using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨o, rfl⟩ := hx
    have : torusAut A c (reesGen y o) = algebraMap k A[X] (c : k) * reesGen y o := by
      obtain ⟨a, ha⟩ := isHomog_reesGen y o
      rw [ha, ← C_mul_X_pow_eq_monomial, torusAut_C_mul_X_pow, pow_one,
        Polynomial.algebraMap_apply]
    rw [this]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) (reesGen_mem_gradedRees o)
  | algebraMap c' =>
    rw [IsScalarTower.algebraMap_apply k A A[X], AlgEquiv.commutes,
      ← IsScalarTower.algebraMap_apply]
    exact Subalgebra.algebraMap_mem _ c'
  | add x z _ _ hx hz => rw [map_add]; exact Subalgebra.add_mem _ hx hz
  | mul x z _ _ hx hz => rw [map_mul]; exact Subalgebra.mul_mem _ hx hz

/-- The torus automorphisms `T ↦ λ T` preserve `S'`. -/
theorem torusAut_mem_normalizedRees (c : kˣ) {p : A[X]} (hp : p ∈ normalizedRees k y) :
    torusAut A c p ∈ normalizedRees k y := by
  set S := gradedRees k y
  let ψ : A[X] →+* A[X] := (torusAut A c : A[X] ≃ₐ[A] A[X]).toRingEquiv.toRingHom
  let φ : S →+* S := RingHom.codRestrict (ψ.comp (algebraMap S A[X])) S
    fun x => torusAut_mem_gradedRees c x.2
  exact IsIntegral.map_of_comp_eq φ ψ (RingHom.ext fun _ => rfl) (mem_normalizedRees.1 hp)

/-- **`lem:wu-graded-closure`(1).** The normalized Rees algebra `S'` is a graded subalgebra of
`A[T]`, if `k` is infinite. -/
theorem isGraded_normalizedRees [Infinite k] : IsTGraded (normalizedRees k y) :=
  isGraded_of_torus fun c _ hp => torusAut_mem_normalizedRees c hp

/-! ### (2) Finiteness -/

/-- Every subalgebra `S ⊆ B ⊆ A[T]` has fraction field `Frac A[T]`, if `y` generates `A`. -/
theorem isFractionRing_of_gradedRees_le [IsDomain A] (hy : Algebra.adjoin k (Set.range y) = ⊤)
    {B : Subalgebra k A[X]} (hB : gradedRees k y ≤ B) : IsFractionRing B (FractionRing A[X]) := by
  have : FaithfulSMul B (FractionRing A[X]) := (faithfulSMul_iff_algebraMap_injective _ _).2
    ((IsFractionRing.injective A[X] (FractionRing A[X])).comp Subtype.val_injective)
  refine IsFractionRing.of_field _ _ fun z => ?_
  obtain ⟨p, q, hq, rfl⟩ := IsFractionRing.div_surjective (A := A[X]) z
  obtain ⟨n, hpn, hqn⟩ := ((eventually_X_pow_mul_mem_gradedRees hy p).and
    (eventually_X_pow_mul_mem_gradedRees hy q)).exists
  refine ⟨⟨_, hB hpn⟩, ⟨_, hB hqn⟩, ?_⟩
  have hX : algebraMap A[X] (FractionRing A[X]) (X ^ n) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 (pow_ne_zero n X_ne_zero)
  change _ = algebraMap A[X] (FractionRing A[X]) (X ^ n * p) /
    algebraMap A[X] (FractionRing A[X]) (X ^ n * q)
  rw [map_mul, map_mul, mul_div_mul_left _ _ hX]

/-- **`lem:wu-graded-closure`(2), finiteness.** `S'` is a finite `S`-module. -/
theorem finite_normalizedRees [Finite ι] [PerfectField k] [IsDomain A]
    (hy : Algebra.adjoin k (Set.range y) = ⊤) :
    Module.Finite (gradedRees k y) (integralClosure (gradedRees k y) A[X]) := by
  set S := gradedRees k y
  have : IsFractionRing S (FractionRing A[X]) := isFractionRing_of_gradedRees_le hy le_rfl
  have : Algebra.FiniteType k S := (Subalgebra.fg_iff_finiteType S).1 fg_gradedRees
  have : Module.Finite S (integralClosure S (FractionRing A[X])) :=
    finite_integralClosure k S (FractionRing A[X])
  have : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing k S
  have : IsNoetherian S (integralClosure S (FractionRing A[X])) :=
    isNoetherian_of_isNoetherianRing_of_finite S (integralClosure S (FractionRing A[X]))
  let f := (IsScalarTower.toAlgHom S A[X] (FractionRing A[X])).mapIntegralClosure
  exact Module.Finite.of_injective f.toLinearMap fun x z h =>
    Subtype.ext (IsFractionRing.injective A[X] (FractionRing A[X]) (congrArg Subtype.val h))

/-- **`lem:wu-graded-closure`(2).** `S'` is a finitely generated `k`-algebra. -/
theorem fg_normalizedRees [Finite ι] [PerfectField k] [IsDomain A]
    (hy : Algebra.adjoin k (Set.range y) = ⊤) : (normalizedRees k y).FG := by
  set S := gradedRees k y
  have : Algebra.FiniteType k S := (Subalgebra.fg_iff_finiteType S).1 fg_gradedRees
  have : Module.Finite S (integralClosure S A[X]) := finite_normalizedRees hy
  have : Algebra.FiniteType k (integralClosure S A[X]) :=
    Algebra.FiniteType.trans (S := S) inferInstance inferInstance
  exact (Subalgebra.fg_iff_finiteType _).2 this

/-! ### (4) Degree zero -/

/-- An element of a domain integral over an algebraically closed field lies in that field. -/
theorem exists_algebraMap_eq_of_isIntegral [IsAlgClosed k] [IsDomain A] {a : A}
    (ha : IsIntegral k a) : ∃ c : k, algebraMap k A c = a := by
  have hdeg : (minpoly k a).degree = 1 :=
    IsAlgClosed.degree_eq_one_of_irreducible k (minpoly.irreducible ha)
  have hq : (minpoly k a).leadingCoeff = 1 := minpoly.monic ha
  have h : aeval a (minpoly k a) = 0 := minpoly.aeval k a
  rw [eq_X_add_C_of_degree_eq_one hdeg, hq, C_1, one_mul, aeval_add, aeval_X, aeval_C,
    add_eq_zero_iff_eq_neg] at h
  exact ⟨-(minpoly k a).coeff 0, (map_neg _ _).trans h.symm⟩

/-- **`lem:wu-graded-closure`(4).** `S'_0 = k`, if `k` is algebraically closed and `A` a domain. -/
theorem exists_algebraMap_eq_of_C_mem_normalizedRees [IsAlgClosed k] [IsDomain A] {a : A}
    (ha : C a ∈ normalizedRees k y) : ∃ c : k, algebraMap k A c = a := by
  obtain ⟨n, s, hn, hs, heq⟩ := exists_homog_integral_eq isGraded_gradedRees
    (⟨a, (monomial_zero_left (a := a)).symm⟩ : IsHomog 0 (C a)) (mem_normalizedRees.1 ha)
  have hc : ∀ i, ∃ c : k, algebraMap k A c = (s i).coeff 0 := fun i =>
    exists_algebraMap_eq_coeff_zero_of_mem_gradedRees (hs i).1
  choose c hc using hc
  have hsC : ∀ i, s i = C (algebraMap k A (c i)) := fun i => by
    have h := (hs i).2
    rw [mul_zero] at h
    rw [h.eq_monomial, monomial_zero_left, hc i]
  apply exists_algebraMap_eq_of_isIntegral
  refine ⟨X ^ n + ∑ i ∈ Finset.range n, C (c i) * X ^ i, monic_X_pow_add ?_, ?_⟩
  · refine lt_of_le_of_lt (degree_sum_le _ _) ((Finset.sup_lt_iff (WithBot.bot_lt_coe n)).2 ?_)
    intro i hi
    exact lt_of_le_of_lt (degree_C_mul_X_pow_le i (c i))
      (WithBot.coe_lt_coe.2 (Finset.mem_range.1 hi))
  · have h0 := congrArg (fun p : A[X] => p.coeff 0) heq
    simp only [hsC, ← C_pow, ← C_mul, ← C_add, ← map_sum (C : A →+* A[X]), coeff_C_zero,
      coeff_zero] at h0
    rw [eval₂_add, eval₂_X_pow, eval₂_finsetSum]
    simpa only [eval₂_mul, eval₂_C, eval₂_X_pow] using h0

/-- **`lem:wu-graded-closure`(4)**, in terms of constant terms: every `p ∈ S'` has `p(0) ∈ k`. -/
theorem exists_algebraMap_eq_coeff_zero_of_mem_normalizedRees [IsAlgClosed k] [IsDomain A]
    {p : A[X]} (hp : p ∈ normalizedRees k y) : ∃ c : k, algebraMap k A c = p.coeff 0 :=
  exists_algebraMap_eq_of_C_mem_normalizedRees (by
    rw [← monomial_zero_left]; exact isGraded_normalizedRees p hp 0)

/-- **`lem:wu-graded-closure`(2), graded pieces.** Every `S'_d` is finite dimensional over `k`. -/
theorem finiteDimensional_gradedPiece_normalizedRees [Finite ι] [IsAlgClosed k] [IsDomain A]
    (hy : Algebra.adjoin k (Set.range y) = ⊤) (d : ℕ) :
    FiniteDimensional k (gradedPiece (normalizedRees k y) d) := by
  obtain ⟨r, b, e, he, hb, heq⟩ := exists_homog_generators isGraded_normalizedRees
    (fg_normalizedRees hy) fun a ha => exists_algebraMap_eq_of_C_mem_normalizedRees ha
  rw [← heq]
  exact finiteDimensional_gradedPiece_adjoin hb he d

/-! ### (3) Integral closedness -/

/-- `S'` is integrally closed in `A[T]`. -/
theorem isIntegrallyClosedIn_normalizedRees :
    IsIntegrallyClosedIn (normalizedRees k y) A[X] := by
  refine isIntegrallyClosedIn_iff.2 ⟨Subtype.val_injective, fun {x} hx => ?_⟩
  have hx' : x ∈ integralClosure (integralClosure (gradedRees k y) A[X]) A[X] := hx
  rw [integralClosure_idem, Algebra.mem_bot] at hx'
  obtain ⟨z, rfl⟩ := hx'
  exact ⟨z, rfl⟩

/-- **`lem:wu-graded-closure`(3).** If `A` is an integrally closed domain, `S'` is an integrally
closed domain. -/
theorem isIntegrallyClosed_normalizedRees [IsDomain A] [IsIntegrallyClosed A] :
    IsIntegrallyClosed (normalizedRees k y) :=
  have := isIntegrallyClosedIn_normalizedRees (k := k) (y := y)
  IsIntegrallyClosed.of_isIntegrallyClosed_of_isIntegrallyClosedIn _ A[X]

/-! ### (6) Powers in the ideal generated by `T, y_i T` -/

/-- Every element of `S` is a constant plus an element of the ideal of `S` generated by the
`g_l`. -/
theorem exists_eq_algebraMap_add_sum_reesGen [Fintype ι] {s : A[X]} (hs : s ∈ gradedRees k y) :
    ∃ (c : k) (f : Option ι → A[X]), (∀ o, f o ∈ gradedRees k y) ∧
      s = algebraMap k A[X] c + ∑ o, reesGen y o * f o := by
  classical
  induction hs using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨o, rfl⟩ := hx
    refine ⟨0, fun o' => if o' = o then 1 else 0, fun o' => ?_, ?_⟩
    · beta_reduce
      split_ifs
      · exact Subalgebra.one_mem _
      · exact Subalgebra.zero_mem _
    · simp only [map_zero, zero_add, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
        Finset.mem_univ, if_true]
  | algebraMap c => exact ⟨c, 0, fun _ => Subalgebra.zero_mem _, by simp⟩
  | add x z _ _ hx hz =>
    obtain ⟨c, f, hf, rfl⟩ := hx
    obtain ⟨c', f', hf', rfl⟩ := hz
    refine ⟨c + c', f + f', fun o => Subalgebra.add_mem _ (hf o) (hf' o), ?_⟩
    simp only [map_add, Pi.add_apply, mul_add, Finset.sum_add_distrib]
    ring
  | mul x z hx' hz' hx hz =>
    obtain ⟨c, f, hf, rfl⟩ := hx
    obtain ⟨c', f', hf', hz''⟩ := hz
    refine ⟨c * c', fun o => algebraMap k A[X] c * f' o + f o * z, fun o =>
      Subalgebra.add_mem _ (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ c) (hf' o))
        (Subalgebra.mul_mem _ (hf o) hz'), ?_⟩
    calc (algebraMap k A[X] c + ∑ o, reesGen y o * f o) * z
        = algebraMap k A[X] c * (algebraMap k A[X] c' + ∑ o, reesGen y o * f' o) +
            (∑ o, reesGen y o * f o) * z := by rw [add_mul, ← hz'']
      _ = algebraMap k A[X] (c * c') +
            ∑ o, reesGen y o * (algebraMap k A[X] c * f' o + f o * z) := by
        rw [map_mul, mul_add, Finset.mul_sum, Finset.sum_mul, add_assoc,
          ← Finset.sum_add_distrib]
        congr 1
        exact Finset.sum_congr rfl fun o _ => by ring

/-- A homogeneous element of `S` of positive degree `j` lies in the ideal of `S` generated by the
`g_l`, with coefficients in `S_{j-1}`. -/
theorem exists_eq_sum_reesGen_of_isHomog [Fintype ι] {s : A[X]} (hs : s ∈ gradedRees k y) {j : ℕ}
    (hsj : IsHomog j s) (hj : 0 < j) :
    ∃ f : Option ι → A[X], (∀ o, f o ∈ gradedPiece (gradedRees k y) (j - 1)) ∧
      s = ∑ o, reesGen y o * f o := by
  obtain ⟨c, f, hf, hsf⟩ := exists_eq_algebraMap_add_sum_reesGen hs
  refine ⟨fun o => homogComp (j - 1) (f o), fun o => isGraded_gradedRees.homogComp_mem (hf o) _,
    ?_⟩
  rw [← hsj.homogComp_self, hsf, map_add, homogComp_algebraMap, if_neg hj.ne', zero_add, map_sum]
  refine Finset.sum_congr rfl fun o _ => ?_
  rw [mul_comm, show j = j - 1 + 1 by omega, homogComp_mul_of_isHomog (isHomog_reesGen y o),
    Nat.add_sub_cancel, mul_comm]

/-- **`lem:wu-graded-closure`(6).** Every homogeneous `b ∈ S'_d` of positive degree has a power
`b^n` (`n > 0`) in the ideal of `S'` generated by `g = (T, y_1 T, …, y_m T)`:
`b^n = ∑_l g_l c_l` with `c_l ∈ S'_{nd-1}`. -/
theorem exists_pow_eq_sum_reesGen [Fintype ι] [Infinite k] [Nontrivial A] {b : A[X]} {d : ℕ}
    (hb : b ∈ gradedPiece (normalizedRees k y) d) (hd : 0 < d) :
    ∃ n, 0 < n ∧ ∃ c : Option ι → A[X], (∀ o, c o ∈ gradedPiece (normalizedRees k y) (n * d - 1)) ∧
      b ^ n = ∑ o, reesGen y o * c o := by
  obtain ⟨n, s, hn, hs, heq⟩ := exists_homog_integral_eq isGraded_gradedRees hb.2
    (mem_normalizedRees.1 hb.1)
  -- each `s_i`, `i < n`, lies in the ideal generated by the `g_l`
  have hf : ∀ i ∈ Finset.range n, ∃ f : Option ι → A[X], (∀ o, f o ∈ gradedRees k y) ∧
      s i = ∑ o, reesGen y o * f o := fun i hi => by
    have hi : i < n := Finset.mem_range.1 hi
    obtain ⟨f, hf, hsf⟩ := exists_eq_sum_reesGen_of_isHomog (hs i).1 (hs i).2
      (Nat.mul_pos (by omega) hd)
    exact ⟨f, fun o => (hf o).1, hsf⟩
  choose! f hfS hsf using hf
  set c : Option ι → A[X] := fun o => -∑ i ∈ Finset.range n, f i o * b ^ i
  have hcS : ∀ o, c o ∈ normalizedRees k y := fun o =>
    Subalgebra.neg_mem _ (Subalgebra.sum_mem _ fun i hi => Subalgebra.mul_mem _
      (gradedRees_le_normalizedRees (hfS i hi o)) (Subalgebra.pow_mem _ hb.1 _))
  have hbn : b ^ n = ∑ o, reesGen y o * c o := by
    rw [eq_neg_of_add_eq_zero_left heq, Finset.sum_congr rfl fun i hi => by rw [hsf i hi]]
    simp only [c, Finset.sum_mul, mul_neg, Finset.sum_neg_distrib, Finset.mul_sum]
    rw [Finset.sum_comm]
    exact congrArg Neg.neg (Finset.sum_congr rfl fun o _ =>
      Finset.sum_congr rfl fun i _ => by ring)
  obtain ⟨m, hm⟩ : ∃ m, n * d = m + 1 := ⟨n * d - 1, by have := Nat.mul_pos hn hd; omega⟩
  refine ⟨n, hn, fun o => homogComp (n * d - 1) (c o), fun o =>
    isGraded_normalizedRees.homogComp_mem (hcS o) _, ?_⟩
  rw [← (hb.2.pow n).homogComp_self, hbn, map_sum, hm, Nat.add_sub_cancel]
  refine Finset.sum_congr rfl fun o _ => ?_
  rw [mul_comm (reesGen y o), homogComp_mul_of_isHomog (isHomog_reesGen y o), mul_comm]

/-! ### Summary -/

/-- **`lem:wu-graded-closure`** (normalized Rees algebra). Let `k` be algebraically closed, `A` a
normal domain over `k` generated by `y_1, …, y_m`, `S = k[T, y_1 T, …, y_m T] ⊆ A[T]` and `S'` the
integral closure of `S` in `A[T]`. Then (1) `S'` is graded; (2) `S'` is a finitely generated
`k`-algebra with finite dimensional graded pieces; (3) `S'` is an integrally closed domain;
(4) `S'_0 = k`; (5) `S'_{(T)} = A`; (6) every `b ∈ S'_d`, `d > 0`, has a power in the ideal of `S'`
generated by `T, y_1 T, …, y_m T`. -/
theorem normalizedRees_spec [Fintype ι] [IsAlgClosed k] [IsDomain A] [IsIntegrallyClosed A]
    (hy : Algebra.adjoin k (Set.range y) = ⊤) :
    IsTGraded (normalizedRees k y) ∧
      ((normalizedRees k y).FG ∧ ∀ d, FiniteDimensional k (gradedPiece (normalizedRees k y) d)) ∧
      IsIntegrallyClosed (normalizedRees k y) ∧
      (∀ a : A, C a ∈ normalizedRees k y → ∃ c : k, algebraMap k A c = a) ∧
      homLoc (normalizedRees k y) 1 1 = (IsScalarTower.toAlgHom k A (FractionRing A)).range ∧
      (∀ (b : A[X]) (d : ℕ), b ∈ gradedPiece (normalizedRees k y) d → 0 < d →
        ∃ n, 0 < n ∧ ∃ c : Option ι → A[X],
          (∀ o, c o ∈ gradedPiece (normalizedRees k y) (n * d - 1)) ∧
          b ^ n = ∑ o, reesGen y o * c o) :=
  ⟨isGraded_normalizedRees, ⟨fg_normalizedRees hy, finiteDimensional_gradedPiece_normalizedRees hy⟩,
    isIntegrallyClosed_normalizedRees, fun _ ha => exists_algebraMap_eq_of_C_mem_normalizedRees ha,
    homLoc_normalizedRees_one_one hy, fun _ _ hb hd => exists_pow_eq_sum_reesGen hb hd⟩

/-- **Data of `def:wu-compactification`.** Combining `lem:wu-graded-closure` and `lem:wu-veronese`
for `B = S'`: there is `e ≥ 1` such that `S'' = S'^{(e)}` is an integrally closed domain generated
by the finite dimensional space `S''_1 = S'_e`, which contains `T^e` and the `(y_i T)^e`, with
`S'_{ne} = (S'_e)^n` for `n ≥ 1`, `S''_0 = k` and `S''_{(T^e)} = S'_{(T)} = A`. -/
theorem exists_veronese_normalizedRees [Finite ι] [IsAlgClosed k] [IsDomain A]
    [IsIntegrallyClosed A]
    (hy : Algebra.adjoin k (Set.range y) = ⊤) :
    ∃ e, 0 < e ∧
      (∀ n, 0 < n →
        gradedPiece (normalizedRees k y) (n * e) = gradedPiece (normalizedRees k y) e ^ n) ∧
      veronese (normalizedRees k y) e =
        Algebra.adjoin k (gradedPiece (normalizedRees k y) e : Set A[X]) ∧
      FiniteDimensional k (gradedPiece (normalizedRees k y) e) ∧
      (∀ o, reesGen y o ^ e ∈ gradedPiece (normalizedRees k y) e) ∧
      IsIntegrallyClosed (veronese (normalizedRees k y) e) ∧
      (∀ a : A, C a ∈ veronese (normalizedRees k y) e → ∃ c : k, algebraMap k A c = a) ∧
      homLoc (veronese (normalizedRees k y) e) 1 e =
        (IsScalarTower.toAlgHom k A (FractionRing A)).range := by
  obtain ⟨e, he, hpow, hgen⟩ := exists_veronese_generated isGraded_normalizedRees
    (fg_normalizedRees hy) fun a ha => exists_algebraMap_eq_of_C_mem_normalizedRees ha
  have := isIntegrallyClosed_normalizedRees (k := k) (y := y)
  refine ⟨e, he, hpow, hgen, finiteDimensional_gradedPiece_normalizedRees hy e, fun o => ?_,
    isIntegrallyClosed_veronese _ e, fun a ha =>
      exists_algebraMap_eq_of_C_mem_normalizedRees (C_mem_veronese.1 ha), ?_⟩
  · refine ⟨Subalgebra.pow_mem _ (gradedRees_le_normalizedRees (reesGen_mem_gradedRees o)) e, ?_⟩
    simpa using (isHomog_reesGen y o).pow e
  · rw [homLoc_veronese]
    refine homLoc_one_eq_range fun a => ?_
    obtain ⟨N, hN⟩ := Filter.eventually_atTop.1 (eventually_monomial_mem_gradedRees hy a)
    exact ⟨N, gradedRees_le_normalizedRees (hN _ (Nat.le_mul_of_pos_right N he))⟩

end EnvelopeProperty
