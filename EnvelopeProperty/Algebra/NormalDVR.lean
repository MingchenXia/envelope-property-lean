import Mathlib

/-!
# Associated primes of principal ideals in normal Noetherian domains

Let `E` be a Noetherian integrally closed domain and `0 ≠ h ∈ E`. We show that every associated
prime `P` of `E ⧸ hE` has `E_P` a discrete valuation ring and is a minimal prime of `hE`, so
that the associated primes of `E ⧸ hE` are exactly the (finitely many) minimal primes of `hE`,
which are also those of `h ^ r E` for `r ≠ 0`. Consequently divisibility by `h` can be tested at
these primes: `f ∈ hE` if and only if `h ∣ f` in `E_P` for every minimal prime `P` of `hE`
(in valuation terms, `ord_{E_P} f ≥ ord_{E_P} h`, see `IsDiscreteValuationRing.addVal_le_iff_dvd`).

This is `lem:bj-dvr-minimal` of the blueprint (`bj22.tex`), used with
`thm:bj-normalization-finite` to define the Rees valuations (`def:bj-rees`) and to prove that
they detect integral closure (`thm:bj-rees`).

## Proof

Let `P = (hE : b)` with `b ∉ hE` (`P` is the annihilator of the class of `b`). In the local ring
`R = E_P` we have `b ∉ hR` and `m b ⊆ hR` for the maximal ideal `m = PR`. With `z = b / h`
in the fraction field, `z m ⊆ R`. If `z m ⊆ m` then `z` is integral over `R` by the determinant
trick, hence `z ∈ R` and `b ∈ hR`, a contradiction. So `z m = R`, whence `m` is principal and
`R` is a discrete valuation ring (`maximalIdeal_isPrincipal_of_exists_mul_eq`, following the
proof of `maximalIdeal_isPrincipal_of_isDedekindDomain` in Mathlib). Since `R` has dimension one,
`P` is minimal over `hE`. Conversely minimal primes of the annihilator `hE` of `E ⧸ hE` are
associated (Mathlib). Finally, if `f ∉ hE`, the class of `f` has an associated prime
`P ⊇ (hE : f)`; if `s f ∈ hE` with `s ∉ P` then `s ∈ (hE : f) ⊆ P`, a contradiction.

## Main results

* `EnvelopeProperty.isDiscreteValuationRing_localization_of_mem_minimalPrimes`
* `EnvelopeProperty.associatedPrimes_eq_minimalPrimes`
* `EnvelopeProperty.minimalPrimes_span_singleton_pow`
* `EnvelopeProperty.mem_span_singleton_iff_forall_minimalPrimes`
* `EnvelopeProperty.mem_span_singleton_iff_forall_minimalPrimes_dvd`
-/

open IsLocalRing

namespace EnvelopeProperty

/-- Let `R` be a Noetherian local integrally closed domain, and let `a ≠ 0`, `b ∉ aR` with
`m b ⊆ aR` for the maximal ideal `m`. Then `m` is principal (generated by `a / b`). -/
theorem maximalIdeal_isPrincipal_of_exists_mul_eq {R : Type*} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] [IsDomain R] [IsIntegrallyClosed R] {a b : R} (ha : a ≠ 0)
    (hb : b ∉ Ideal.span {a}) (hab : ∀ m ∈ maximalIdeal R, ∃ k : R, k * a = b * m) :
    (maximalIdeal R).IsPrincipal := by
  have ha₁ : a ∈ maximalIdeal R := by
    by_contra hna
    apply hb
    rw [Ideal.span_singleton_eq_top.mpr (notMem_maximalIdeal.mp hna)]
    trivial
  have hb₄ : b ≠ 0 := by rintro rfl; exact hb (zero_mem _)
  let K := FractionRing R
  let x : K := algebraMap R K b / algebraMap R K a
  let M := Submodule.map (Algebra.linearMap R K) (maximalIdeal R)
  have ha₃ : algebraMap R K a ≠ 0 := IsFractionRing.to_map_eq_zero_iff.not.mpr ha
  by_cases hx : ∀ y ∈ M, x * y ∈ M
  · -- `x • m ⊆ m`: then `x` is integral, so `b ∈ aR`.
    have := isIntegral_of_smul_mem_submodule M ?_ ?_ x hx
    · obtain ⟨y, e⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral this
      refine (hb (Ideal.mem_span_singleton'.mpr ⟨y, ?_⟩)).elim
      apply IsFractionRing.injective R K
      rw [map_mul, e, div_mul_cancel₀ _ ha₃]
    · rw [Submodule.ne_bot_iff]; refine ⟨_, ⟨a, ha₁, rfl⟩, ?_⟩
      exact (IsFractionRing.to_map_eq_zero_iff (K := K)).not.mpr ha
    · apply Submodule.FG.map; exact IsNoetherian.noetherian _
  · -- otherwise `x • m = R`, so `a = b y` for some `y ∈ m`, and `m = yR`.
    have :
        (M.map (DistribSMul.toLinearMap R K x)).comap (Algebra.linearMap R K) = ⊤ := by
      contrapose! hx with h
      rintro m' ⟨m, hm, rfl : algebraMap R K m = m'⟩
      obtain ⟨k, hk⟩ := hab m hm
      have hk' : x * algebraMap R K m = algebraMap R K k := by
        rw [← mul_div_right_comm, ← map_mul, ← hk, map_mul, mul_div_cancel_right₀ _ ha₃]
      exact ⟨k, le_maximalIdeal h ⟨_, ⟨_, hm, rfl⟩, hk'⟩, hk'.symm⟩
    obtain ⟨y, hy₁, hy₂⟩ : ∃ y ∈ maximalIdeal R, b * y = a := by
      rw [Ideal.eq_top_iff_one, Submodule.mem_comap] at this
      obtain ⟨_, ⟨y, hy, rfl⟩, hy' : x * algebraMap R K y = algebraMap R K 1⟩ := this
      rw [map_one, ← mul_div_right_comm, div_eq_one_iff_eq ha₃, ← map_mul] at hy'
      exact ⟨y, hy, IsFractionRing.injective R K hy'⟩
    refine ⟨⟨y, ?_⟩⟩
    apply le_antisymm
    · intro m hm; obtain ⟨k, hk⟩ := hab m hm; rw [← hy₂, mul_comm, mul_assoc] at hk
      rw [← mul_left_cancel₀ hb₄ hk, mul_comm]; exact Ideal.mem_span_singleton'.mpr ⟨_, rfl⟩
    · rwa [Submodule.span_le, Set.singleton_subset_iff]

/-- Under the hypotheses of `maximalIdeal_isPrincipal_of_exists_mul_eq`, `R` is a discrete
valuation ring. -/
theorem isDiscreteValuationRing_of_exists_mul_eq {R : Type*} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] [IsDomain R] [IsIntegrallyClosed R] {a b : R} (ha : a ≠ 0)
    (hb : b ∉ Ideal.span {a}) (hab : ∀ m ∈ maximalIdeal R, ∃ k : R, k * a = b * m) :
    IsDiscreteValuationRing R := by
  have hR : ¬IsField R := by
    intro hF
    let _ := hF.toField
    exact hb (by rw [Ideal.span_singleton_eq_top.mpr (isUnit_iff_ne_zero.mpr ha)]; trivial)
  exact ((IsDiscreteValuationRing.TFAE R hR).out 0 4).mpr
    (maximalIdeal_isPrincipal_of_exists_mul_eq ha hb hab)

/-- An associated prime of `E ⧸ hE` (`E` Noetherian) is a colon ideal `(hE : b)`. -/
theorem exists_mem_iff_mul_mem_of_isAssociatedPrime {E : Type*} [CommRing E] [IsNoetherianRing E]
    {h : E} {P : Ideal E} (hP : IsAssociatedPrime P (E ⧸ Ideal.span {h})) :
    ∃ b : E, ∀ r : E, r ∈ P ↔ r * b ∈ Ideal.span {h} := by
  obtain ⟨-, x, hx⟩ := isAssociatedPrime_iff.mp hP
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
  refine ⟨b, fun r => ?_⟩
  rw [hx, Submodule.mem_colon_singleton, Submodule.mem_bot, Algebra.smul_def,
    Ideal.Quotient.algebraMap_eq, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]

/-- `h ∣ f` in `E_P` if and only if `s f ∈ hE` for some `s ∉ P`. -/
theorem algebraMap_dvd_algebraMap_atPrime_iff {E : Type*} [CommRing E] (P : Ideal E) [P.IsPrime]
    (h f : E) :
    algebraMap E (Localization.AtPrime P) h ∣ algebraMap E (Localization.AtPrime P) f ↔
      ∃ s ∉ P, s * f ∈ Ideal.span {h} := by
  rw [← Ideal.mem_span_singleton, ← Set.image_singleton, ← Ideal.map_span,
    ← IsLocalization.mk'_one (M := P.primeCompl), IsLocalization.mk'_mem_map_algebraMap_iff]
  simp only [Ideal.mem_primeCompl_iff]

/-- The minimal primes of `h ^ r E` are those of `hE` for `r ≠ 0`. -/
theorem minimalPrimes_span_singleton_pow {E : Type*} [CommRing E] (h : E) {r : ℕ} (hr : r ≠ 0) :
    (Ideal.span {h ^ r}).minimalPrimes = (Ideal.span {h}).minimalPrimes := by
  rw [← Ideal.span_singleton_pow, ← Ideal.radical_minimalPrimes, Ideal.radical_pow _ hr,
    Ideal.radical_minimalPrimes]

section Normal

variable {E : Type*} [CommRing E] [IsDomain E] [IsNoetherianRing E] [IsIntegrallyClosed E]

/-- If `P` is an associated prime of `E ⧸ hE` with `E` a Noetherian integrally closed domain and
`h ≠ 0`, then `E_P` is a discrete valuation ring. -/
theorem isDiscreteValuationRing_localization_of_isAssociatedPrime {h : E} (hh : h ≠ 0)
    {P : Ideal E} [P.IsPrime] (hP : IsAssociatedPrime P (E ⧸ Ideal.span {h})) :
    IsDiscreteValuationRing (Localization.AtPrime P) := by
  obtain ⟨b, hb⟩ := exists_mem_iff_mul_mem_of_isAssociatedPrime hP
  let R := Localization.AtPrime P
  have : IsIntegrallyClosed R :=
    isIntegrallyClosed_of_isLocalization R P.primeCompl P.primeCompl_le_nonZeroDivisors
  have hinj : Function.Injective (algebraMap E R) :=
    IsLocalization.injective R P.primeCompl_le_nonZeroDivisors
  have hspan : Ideal.span {algebraMap E R h} = (Ideal.span {h}).map (algebraMap E R) := by
    rw [Ideal.map_span, Set.image_singleton]
  refine isDiscreteValuationRing_of_exists_mul_eq (a := algebraMap E R h) (b := algebraMap E R b)
    ((map_ne_zero_iff _ hinj).mpr hh) ?_ ?_
  · rw [hspan, ← IsLocalization.mk'_one (M := P.primeCompl),
      IsLocalization.mk'_mem_map_algebraMap_iff]
    rintro ⟨s, hs, hsb⟩
    exact hs ((hb s).mpr hsb)
  · intro m hm
    obtain ⟨⟨r, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl m
    have hr : r ∈ P := by
      rwa [IsLocalization.AtPrime.mk'_mem_maximal_iff (S := R) (I := P)] at hm
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp ((hb r).mp hr)
    refine ⟨IsLocalization.mk' R c s, ?_⟩
    rw [mul_comm, IsLocalization.mul_mk'_eq_mk'_of_mul, IsLocalization.mul_mk'_eq_mk'_of_mul,
      mul_comm h, hc, mul_comm]

/-- Every associated prime of `E ⧸ hE` is a minimal prime of `hE` (`E` Noetherian integrally
closed domain, `h ≠ 0`). -/
theorem mem_minimalPrimes_of_isAssociatedPrime {h : E} (hh : h ≠ 0) {P : Ideal E}
    (hP : IsAssociatedPrime P (E ⧸ Ideal.span {h})) : P ∈ (Ideal.span {h}).minimalPrimes := by
  have := hP.isPrime
  have := isDiscreteValuationRing_localization_of_isAssociatedPrime hh hP
  let R := Localization.AtPrime P
  have hle : Ideal.span {h} ≤ P := by
    have := hP.annihilator_le
    rwa [Submodule.annihilator_top, Ideal.annihilator_quotient] at this
  refine ⟨⟨hP.isPrime, hle⟩, fun Q ⟨hQ, hhQ⟩ hQP => ?_⟩
  -- A prime `hE ⊆ Q ⊆ P` gives a nonzero prime of the discrete valuation ring `E_P`.
  have hdisj : Disjoint (P.primeCompl : Set E) Q := by
    rw [Ideal.primeCompl, Submonoid.coe_set_mk, Subsemigroup.coe_set_mk,
      Set.disjoint_compl_left_iff_subset]
    exact hQP
  have hQR : (Q.map (algebraMap E R)).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint P.primeCompl R Q hQ hdisj
  have hinj : Function.Injective (algebraMap E R) :=
    IsLocalization.injective R P.primeCompl_le_nonZeroDivisors
  have hQ0 : Q.map (algebraMap E R) ≠ ⊥ := by
    intro h0
    have : algebraMap E R h ∈ Q.map (algebraMap E R) :=
      Ideal.mem_map_of_mem _ (hhQ (Ideal.mem_span_singleton_self h))
    rw [h0, Ideal.mem_bot, map_eq_zero_iff _ hinj] at this
    exact hh this
  have hmax : Q.map (algebraMap E R) = maximalIdeal R :=
    IsLocalRing.eq_maximalIdeal (hQR.isMaximal hQ0)
  have := IsLocalization.under_map_of_isPrime_disjoint P.primeCompl R hQ hdisj
  rw [hmax, IsLocalization.AtPrime.under_maximalIdeal R P] at this
  exact this.le

/-- The associated primes of `E ⧸ hE` are exactly the minimal primes of `hE` (`E` Noetherian
integrally closed domain, `h ≠ 0`). They form a finite set
(`Ideal.finite_minimalPrimes_of_isNoetherianRing`). -/
theorem associatedPrimes_eq_minimalPrimes {h : E} (hh : h ≠ 0) :
    associatedPrimes E (E ⧸ Ideal.span {h}) = (Ideal.span {h}).minimalPrimes := by
  refine subset_antisymm (fun P hP => mem_minimalPrimes_of_isAssociatedPrime hh hP) ?_
  have := Module.associatedPrimes.minimalPrimes_annihilator_subset_associatedPrimes E
    (E ⧸ Ideal.span {h})
  rwa [Ideal.annihilator_quotient] at this

/-- **`lem:bj-dvr-minimal`, DVR part.** If `P` is a minimal prime of `hE`, where `E` is a
Noetherian integrally closed domain and `h ≠ 0`, then `E_P` is a discrete valuation ring. -/
theorem isDiscreteValuationRing_localization_of_mem_minimalPrimes {h : E} (hh : h ≠ 0)
    {P : Ideal E} [P.IsPrime] (hP : P ∈ (Ideal.span {h}).minimalPrimes) :
    IsDiscreteValuationRing (Localization.AtPrime P) := by
  rw [← associatedPrimes_eq_minimalPrimes hh] at hP
  exact isDiscreteValuationRing_localization_of_isAssociatedPrime hh hP

/-- **`lem:bj-dvr-minimal`, divisibility criterion.** For `E` a Noetherian integrally closed
domain and `h ≠ 0`: `f ∈ hE` if and only if for every minimal prime `P` of `hE` there is
`s ∉ P` with `s f ∈ hE`. -/
theorem mem_span_singleton_iff_forall_minimalPrimes {h : E} (hh : h ≠ 0) (f : E) :
    f ∈ Ideal.span {h} ↔
      ∀ P ∈ (Ideal.span {h}).minimalPrimes, ∃ s ∉ P, s * f ∈ Ideal.span {h} := by
  refine ⟨fun hf P hP => ⟨1, hP.1.1.ne_top ∘ (Ideal.eq_top_iff_one P).mpr, by simpa using hf⟩,
    fun H => ?_⟩
  by_contra hf
  have hx : (Ideal.Quotient.mk (Ideal.span {h}) f) ≠ 0 := by
    rwa [Ne, Ideal.Quotient.eq_zero_iff_mem]
  obtain ⟨P, hP, hle⟩ := exists_le_isAssociatedPrime_of_isNoetherianRing E _ hx
  obtain ⟨s, hs, hsf⟩ := H P (mem_minimalPrimes_of_isAssociatedPrime hh hP)
  apply hs
  apply hle
  rw [Submodule.mem_colon_singleton, Submodule.mem_bot, Algebra.smul_def,
    Ideal.Quotient.algebraMap_eq, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
  exact hsf

/-- **`lem:bj-dvr-minimal`, divisibility criterion in the local rings.** For `E` a Noetherian
integrally closed domain and `h ≠ 0`: `f ∈ hE` if and only if `h ∣ f` in the discrete valuation
ring `E_P` for every minimal prime `P` of `hE`. -/
theorem mem_span_singleton_iff_forall_minimalPrimes_dvd {h : E} (hh : h ≠ 0) (f : E) :
    f ∈ Ideal.span {h} ↔
      ∀ (P : Ideal E) [P.IsPrime], P ∈ (Ideal.span {h}).minimalPrimes →
        algebraMap E (Localization.AtPrime P) h ∣ algebraMap E (Localization.AtPrime P) f := by
  rw [mem_span_singleton_iff_forall_minimalPrimes hh]
  refine ⟨fun H P _ hP => (algebraMap_dvd_algebraMap_atPrime_iff P h f).mpr (H P hP), fun H P hP => ?_⟩
  have := hP.1.1
  exact (algebraMap_dvd_algebraMap_atPrime_iff P h f).mp (H P hP)

end Normal

end EnvelopeProperty
