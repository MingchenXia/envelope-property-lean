import EnvelopeProperty.Vanishing.RelativeNadelVanishingOfTrace
import EnvelopeProperty.Vanishing.RelativeNadelCoverTraceProduced

/-!
# Relative ample Nadel vanishing in characteristic zero

Let `k` be a field of characteristic zero and `R` a finite-type `k`-algebra. Let `X` be an
integral scheme, smooth of relative dimension `n` over `k` and projective over `Spec R`, let `I` be
an ideal that is nonzero at the generic point, `c ≥ 0` rational, and `A, B` invertible with
`I ⊗ B` generated by finitely many global sections. If `A^d ≅ C ⊗ B^t` with `d > 0`, `dc = t` and
`C` ample over `Spec R` (that is, `A - cB` is ample over `R`), then
`H^{q+1}(X, (ω_{X/k} ⊗ A) ⊗ 𝒥(c · I)) = 0` for all `q`, where `𝒥` is the multiplier ideal defined
by all divisorial valuations. This is Nadel vanishing (Lazarsfeld, *Positivity in Algebraic
Geometry II*, Theorem 9.4.8) relative to the affine base `Spec R`; the statement is the proposition
`Char0.RelativeAmpleNadelVanishingInput k` (`Char0/AmpleNadelInput.lean`, blueprint
`def:c0n-relative-ample-nadel-input`).

## Proof

The relative assembly
`Vanishing.RelativeNadelAssembly.relativeAmpleNadelVanishingInput_of_coverTrace`
(`Vanishing/RelativeNadelVanishingOfTrace.lean`, blueprint
`thm:kn-relative-ample-nadel-of-cover-trace`) derives the statement from
`CoverCanonicalTraceInput k`, the existence of a trace `T : p_* ω_{Y'/k} ⟶ ω_{Y/k}` with
`η ≫ p_*(dp) ≫ T = deg p • 𝟙` on every normalized adapted Kummer cover `p : Y' → Y` of a smooth
integral `k`-scheme: principalization, the covering trick, relative Kodaira vanishing on the
cover, the trace retraction, and the projective comparison of global twists. The trace input is
`Vanishing.RelativeNadelAssembly.coverCanonicalTraceInput`
(`Vanishing/RelativeNadelCoverTraceProduced.lean`), the canonical trace of the adapted cover in
characteristic zero (Euler's lemma on the mixed Kummer charts). Neither algebraic closedness of
`k` nor properness of `X` over `k` is used.

## Main result

* `Char0.relativeAmpleNadelVanishingInput k`: `Char0.RelativeAmpleNadelVanishingInput k` for every
  field `k` of characteristic zero (blueprint `thm:kn-relative-ample-nadel-vanishing`).
-/

namespace EnvelopeProperty.Char0

universe u

/-- **Relative ample Nadel vanishing in characteristic zero** (Lazarsfeld II, Theorem 9.4.8,
relative to a finite-type affine base; blueprint `thm:kn-relative-ample-nadel-vanishing`): for
every field `k` of characteristic zero, `RelativeAmpleNadelVanishingInput k` holds. -/
theorem relativeAmpleNadelVanishingInput (k : Type u) [Field k] [CharZero k] :
    RelativeAmpleNadelVanishingInput k :=
  Vanishing.RelativeNadelAssembly.relativeAmpleNadelVanishingInput_of_coverTrace
    (Vanishing.RelativeNadelAssembly.coverCanonicalTraceInput k)

end EnvelopeProperty.Char0
