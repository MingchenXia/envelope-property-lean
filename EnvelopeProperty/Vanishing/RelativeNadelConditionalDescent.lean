import EnvelopeProperty.Vanishing.RelativeNadelCoverTraceInput
import EnvelopeProperty.Vanishing.NadelBoundedCanonicalDescentCore
import EnvelopeProperty.Vanishing.RelativeNadelCoverNumeratorProduced
import EnvelopeProperty.Vanishing.RelativeKodairaCharacteristicZero
import EnvelopeProperty.AlgGeom.AffinePushforwardCohomology
import ModularCurves.ForMathlib.FiniteAffineOpenCover

/-! # Relative Kawamata–Viehweg vanishing on the principalization, from the cover trace

Let `k` be a field of characteristic zero, `R` a finite-type `k`-algebra, and
`X` smooth integral of dimension `n` over `k`, with a morphism `π : X → Spec R`
over `k`. Let `μ : Y → X` be the Hironaka principalization of an ideal `I`
(`NadelRelativePrincipalization.sequence`), so that `I·𝒪_Y = 𝒪(-E)` with `E` an
SNC divisor, and let `Q_q = ω_Y ⊗ 𝒪(-⌊qE⌋)` (`RoundedCanonicalModule.absolute`).
If `M` is invertible, `I ⊗ B` is finitely generated by global sections, and
`M^d ≅ C ⊗ B^t` with `C` ample over `R` and `dq = t`, then
`H^{r+1}(Y, Q_q ⊗ μ^*M) = 0` for all `r`, provided the canonical trace exists on
every normalized adapted cover (`CoverCanonicalTraceInput k`).

This is Kawamata–Viehweg vanishing for `μ^*M - qE` by the covering trick
(Esnault–Viehweg, *Lectures on vanishing theorems*, cyclic covers §3 and
Kawamata–Viehweg vanishing 5.12):

1. `RelativeNadelCoverNumeratorProduced.exists_original_numerator_cover` perturbs
   `q` to `1/N` along exceptional weights without changing `⌊qE⌋`, chooses
   SNC Bertini sections and builds the finite adapted Kummer cover
   `πc : Y' → Y`, smooth of dimension `n` over `k`, on which the rounded cover
   line `P` is ample over `R`;
2. relative Kodaira vanishing (`RelativeKodairaCharacteristicZero.kodaira_tensorObj`)
   kills `H^{r+1}(Y', ω_{Y'} ⊗ P)`, and finite pushforward preserves it
   (`AffinePushforwardCohomology.subsingleton_H_iff_pushforward`);
3. the canonical trace `T` with `unit ≫ πc_*(dπc) ≫ T = deg • 𝟙` makes
   `ω_Y ⊗ μ^*M ⊗ 𝒪(-⌊E/N⌋)` a retract of `πc_*(ω_{Y'} ⊗ P)`
   (`NadelBoundedCanonicalDescentCore`), so its cohomology vanishes too.

This mirrors the projective-over-`k` file
`NadelOriginalBlowupNumeratorConditionalDescent`. Neither properness over `k`
nor an algebraically closed `k` is used: the cover is produced over the affine
base `R`, `Y` is quasi-compact because `μ` is proper and `X` is of finite type
over `k`, and separatedness comes from `X → Spec k`.
-/
noncomputable section
namespace EnvelopeProperty.Vanishing.RelativeNadelAssembly
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Scheme.Modules TopologicalSpace
open CategoryTheory.MonoidalCategory
open CanonicalGeometry Char0 NadelAuxiliaryMulticover NadelGlobalNormalization
open NadelGlobalAdaptedRoots NadelBoundedCanonicalProjectionFormula
universe u
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
attribute [local instance] Scheme.Modules.monoidalCategory Scheme.Modules.symmetricCategory

/- The bounded retraction and the ideal/line tensor rearrangement are private in their
production modules; they are opened here under local names, exactly as in the
projective-over-`k` assembly `NadelOriginalBlowupNumeratorConditionalDescent`. -/
run_cmd
  for (short, mod, original) in [
      (`relativeBoundedTwistedRetraction,
        `EnvelopeProperty.Vanishing.NadelBoundedCanonicalDescentCore,
        `EnvelopeProperty.Vanishing.NadelBoundedCanonicalDescentCore.wholeRoundedCanonicalTwistedPullback_retract_of_trace_degree),
      (`relativeTensorIdealLineIso,
        `EnvelopeProperty.Vanishing.NadelBoundedCanonicalProjectionFormula,
        `EnvelopeProperty.Vanishing.NadelBoundedCanonicalProjectionFormula.tensorIdealLineIso)] do
    let name := Lean.mkPrivateNameCore mod original
    unless (← Lean.getEnv).contains name do
      throwError "missing bounded canonical descent helper {name}"
    Lean.Elab.Command.modifyScope fun scope =>
      { scope with openDecls := Lean.OpenDecl.explicit short name :: scope.openDecls }

variable {k : Type u} [Field k] [CharZero k] {X : Scheme.{u}} [IsIntegral X]
    (f : X ⟶ Spec (.of k)) [FiniteType f] [IsSeparated f]
    (n : ℕ) [SmoothOfRelativeDimension n f]
    (I : X.IdealSheafData) (hI : I.stalkIdeal (genericPoint X) ≠ ⊥)

local notation "S" => NadelRelativePrincipalization.sequence f n I hI
local notation "Y" => Scheme.BlowUpSequence.last (NadelRelativePrincipalization.sequence f n I hI)
local notation "μ" =>
  Scheme.BlowUpSequence.composite (NadelRelativePrincipalization.sequence f n I hI)
local notation "g" =>
  Scheme.BlowUpSequence.composite (NadelRelativePrincipalization.sequence f n I hI) ≫ f
local notation "J₀" => Scheme.IdealSheafData.comap I
  (Scheme.BlowUpSequence.composite (NadelRelativePrincipalization.sequence f n I hI))
local notation "hJ₀" => NadelRelativePrincipalization.totalTransform_isIdealOfSncDivisor f n I hI

private instance relativeLastIntegral : IsIntegral Y :=
  NadelRelativePrincipalization.last_isIntegral f n I hI

/-- **Relative Kawamata–Viehweg vanishing on the principalization, from the cover
trace.** On the relative principalization `μ : Y → X` of `I`, with
`Q_q = ω_Y ⊗ 𝒪(-⌊q E⌋)`, the module `Q_q ⊗ μ^*M` has no cohomology in positive
degrees whenever `M^d ≅ C ⊗ B^t` with `C` ample over the finite-type affine base
`Spec R`, `dq = t`, and `I ⊗ B` finitely globally generated. The only input
beyond proved results is the canonical trace on adapted covers. -/
theorem relativeSourceVanishing_of_coverTrace
    {R : Type u} [CommRing R] [Algebra k R] [Algebra.FiniteType k R]
    (hT : CoverCanonicalTraceInput k) (π : X ⟶ Spec (.of R))
    (hπ : π ≫ Spec.map (CommRingCat.ofHom (algebraMap k R)) = f)
    (M : X.Modules) (hM : IsInvertible M) (B : X.Modules) (hB : IsInvertible B)
    (C : X.Modules) (hC : SchemeLineAmpleness.IsAmple π C)
    (G : (I.toModules ⊗ B).GeneratingSections) (hG : G.IsFiniteType)
    (q : ℚ) (hq : 0 ≤ q) (d t : ℕ) (hd : 0 < d) (hdt : (d : ℚ) * q = (t : ℚ))
    (e₀ : bundleTensorPower M d ≅ C ⊗ bundleTensorPower B t) (r : ℕ) :
    Subsingleton (CategoryTheory.Sheaf.H
      (Scheme.Modules.tensorObj (RoundedCanonicalModule.absolute g n J₀ hJ₀ q)
        ((Scheme.Modules.pullback μ).obj M)).sheaf (r + 1)) := by
  obtain ⟨hsmooth, _hnonempty, w, N, a, hK, _hw, _hN, _hbound, _hdiv,
      _ha, _had, _hden, hround, F, b, _hF, hD, _hKF,
      L, hL, σ, hAux, hRows, hfinite, hsmoothCover, hAmp⟩ :=
    RelativeNadelCoverNumeratorProduced.exists_original_numerator_cover
      f n I hI π hπ M hM B hB C hC G hG q hq d t hd hdt e₀ 0
  let : SmoothOfRelativeDimension n g := hsmooth
  let : Smooth g := SmoothOfRelativeDimension.smooth n g
  let : IsProper μ := NadelRelativePrincipalization.composite_isProper f n I hI
  let q' : ℚ := 1 / (N : ℚ)
  let K := J₀ ^ a * RelativeNadelCoverWeightedExceptional.weightedIdeal f n I hI w
  let πc := normalizedToOriginal (OriginalData.data F n L (fun _ => q'.den) σ)
  let : IsFinite πc := hfinite
  let : SmoothOfRelativeDimension n (πc ≫ g) := hsmoothCover
  -- The canonical trace on the produced cover.
  obtain ⟨T, hTdeg⟩ := hT g n F q' L hL hD σ hAux hRows
  let MY := (Scheme.Modules.pullback μ).obj M
  let A := Scheme.Modules.tensorObj MY (RoundedCanonicalModule.idealModule K hK q')
  have hA : IsInvertible A :=
    (hM.pullback μ).tensorObj (RoundedCanonicalModule.idealModule_isInvertible g K hK q')
  have hfield : IsUnit (q'.den : k) :=
    isUnit_iff_ne_zero.mpr (Nat.cast_ne_zero.mpr q'.den_ne_zero)
  let residual : F.ι → ℕ := fun i => fractionalRootWeight q' (b i)
  have hresidual : ∀ i, residual i < q'.den := fun i => fractionalRootWeight_lt q' (b i)
  -- The trace retraction of the bounded twisted unit.
  obtain ⟨ret, hret⟩ := relativeBoundedTwistedRetraction
    F n L (fun _ => q'.den) σ hL hD g hAux hRows
    (fun _ => q'.den_pos) (fun _ => hfield) A hA residual hresidual T hTdeg
  -- Relative Kodaira vanishing on the cover, for the rounded cover line ample over `R`.
  let P := originalRoundedCoverLine F n L q' σ hL MY K hK b
  have hP : IsInvertible P := hAmp.isInvertible
  let Q := Scheme.Modules.tensorObj (canonicalLineSheaf (πc ≫ g) n) P
  let : Q.IsQuasicoherent :=
    ((canonicalLineSheaf_isInvertible (πc ≫ g) n).tensorObj hP).isQuasicoherent
  have hVan : Subsingleton (CategoryTheory.Sheaf.H Q.sheaf (r + 1)) :=
    RelativeKodairaCharacteristicZero.kodaira_tensorObj (πc ≫ g) (πc ≫ (μ ≫ π))
      (by simp only [Category.assoc, hπ]) n P hAmp r
  -- Finite pushforward to `Y`, which is quasi-compact and separated.
  let : QuasiCompact g := quasiCompact_comp μ f
  let : CompactSpace Y := (quasiCompact_iff_compactSpace g).mp inferInstance
  let : (Y).IsSeparated := ⟨by rw [← terminal.comp_from g]; infer_instance⟩
  obtain ⟨ι, hι, U, hU, hUa⟩ := (Y).exists_finite_affine_openCover
  let : Finite ι := hι
  let : Fintype ι := Fintype.ofFinite ι
  let : LinearOrder ι := LinearOrder.lift' (Fintype.equivFin ι) (Fintype.equivFin ι).injective
  have hQ : Subsingleton (CategoryTheory.Sheaf.H ((pushforward πc).obj Q).sheaf (r + 1)) :=
    (AffinePushforwardCohomology.subsingleton_H_iff_pushforward πc g Q U hU hUa r).mp hVan
  have hbase : Subsingleton (CategoryTheory.Sheaf.H (canonicalLineSheaf g n ⊗ A).sheaf (r + 1)) :=
    AffinePushforwardCohomology.subsingleton_H_of_retract
      (wholeRoundedCanonicalTwistedPullback F n L (fun _ => q'.den) σ hL g hD hAux hRows
        (fun _ => q'.den_pos) (fun _ => hfield) A hA residual hresidual)
      ret hret (r + 1) hQ
  -- Back to the original rounding `⌊qE⌋` through `⌊K/N⌋ = ⌊qE⌋`.
  let EK : Scheme.Modules.tensorObj (RoundedCanonicalModule.absolute g n K hK q') MY ≅
      canonicalLineSheaf g n ⊗ A :=
    (ModularCurves.monoidalTensorObjIso (RoundedCanonicalModule.absolute g n K hK q') MY).symm ≪≫
      relativeTensorIdealLineIso (canonicalLineSheaf g n)
        (RoundedCanonicalModule.idealModule K hK q') MY ≪≫
      (ModularCurves.monoidalTensorObjIso (canonicalLineSheaf g n) A).symm
  let EJ : Scheme.Modules.tensorObj (RoundedCanonicalModule.absolute g n J₀ hJ₀ q) MY ≅
      Scheme.Modules.tensorObj (RoundedCanonicalModule.absolute g n K hK q') MY :=
    eqToIso (congrArg
      (fun H : (Y).IdealSheafData => Scheme.Modules.tensorObj
        (Scheme.Modules.tensorObj (canonicalLineSheaf g n) H.toModules) MY) hround.symm)
  let E := EJ ≪≫ EK
  exact AffinePushforwardCohomology.subsingleton_H_of_retract
    E.hom E.inv E.hom_inv_id (r + 1) hbase

end EnvelopeProperty.Vanishing.RelativeNadelAssembly
