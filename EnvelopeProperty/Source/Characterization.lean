import EnvelopeProperty.Source.MainTheorem
import EnvelopeProperty.Global.ConductorDescent

/-! # FHX Corollary 1.1 for projective varieties

Fang–Han–Xia, *The envelope property for unibranch projective varieties* (FHX), Corollary 1.1
(`cor:intro-characterization`): *for an integral projective variety `X` over `k` the following are
equivalent: (1) `X` is unibranch; (2) `EP_X(θ)` holds for every `θ ∈ N¹(X)_ℝ`; (3) `EP_X(ω)` holds
for some ample class `ω`.* Blueprint: `cor:var-characterization`.

The implications (2) ⇒ (1) and (3) ⇒ (1) assume nothing. The theorem
`Variety.isUnibranch_tfae_hasEnvelopeProperty_of_forall_countable` assumes, for (1) ⇒ (2),
`LocalPositivity` and `SmoothEnvelopeCharZero` at the countable algebraically closed subfields of
`k`; `EnvelopeProperty/MainTheorem.lean` supplies both and states the equivalence without
hypotheses (`Variety.isUnibranch_tfae_hasEnvelopeProperty`).

Here `X` is an integral scheme with a projective morphism `p : X ⟶ Spec k`, `k` algebraically
closed, "unibranch" is `Variety.IsUnibranch X` (FHX §1.1: every local ring `𝒪_{X,x}` has one
branch; here in the equivalent form "the normalization is bijective",
`Variety.isUnibranch_iff_isUnibranchLocalRing_stalk`, which is item (1′) below),
`EP_X` is `Variety.HasEnvelopeProperty p` (BJ22 psh functions on `X^an`), and "ample" means
`ω ∈ Amp(X) = NativeRealNumericalClasses.ampleCone p`, the convex cone of `N¹(X)_ℝ` generated by
the classes of ample invertible sheaves (BJ22's `Amp(X)`).

## Main results

* `Variety.isUnibranch_of_hasEnvelopeProperty` (`thm:var-unibranch-of-ep`; BJ22 Theorem 5.12):
  (3) ⇒ (1) with **no** hypothesis. An ample `ω` has a
  presentation with positive coordinates `ωm` (`Variety.exists_positive_presentation`); `EP_X(ω)`
  is `EP_𝒫(ωm)` on its model (`Variety.hasEnvelopeProperty_iff_presentation`), which forces `𝒫`
  to be unibranch (`MultiModel.isUnibranch_of_exists_hasEnvelopeProperty`, via the conductor),
  hence `X` (`Variety.isUnibranch_iff_presentation`).
* `Variety.isUnibranch_of_forall_hasEnvelopeProperty`: (2) ⇒ (1), with no hypothesis.
* `Variety.isUnibranch_tfae_hasEnvelopeProperty_of_forall_countable` (`cor:var-characterization`): (1), the
  stalk-wise forms (1′) all local rings are unibranch and (1″) all local rings are geometrically
  unibranch (`Variety.isUnibranch_tfae`), (2) and (3) are equivalent. The hypotheses `hLP`, `h₀` of
  FHX Theorem A (`Variety.hasEnvelopeProperty_of_isUnibranch_of_forall_countable`) enter only
  through (1) ⇒ (2).
* `Variety.isUnibranch_tfae_hasEnvelopeProperty_of_charP`: the same in characteristic `ℓ > 0`,
  without `h₀`.
-/

open AlgebraicGeometry CategoryTheory

noncomputable section

universe u

namespace EnvelopeProperty.Variety

open NativeRealNumericalClasses

variable {k : Type u} [Field k] [IsAlgClosed k]

/-- **FHX Corollary 1.1, (3) ⇒ (1)** (`thm:var-unibranch-of-ep`; BJ22 Theorem 5.12), with **no**
hypothesis: if `EP_X(ω)` holds for some ample class
`ω ∈ Amp(X)`, then `X` is unibranch. -/
theorem isUnibranch_of_hasEnvelopeProperty {X : Scheme.{u}} [IsIntegral X]
    (p : X ⟶ Spec (.of k)) [IsProjective p] {ω : Space p} (hω : ω ∈ ampleCone p)
    (h : HasEnvelopeProperty p ω) : IsUnibranch X := by
  obtain ⟨r, d, q, hp, _, ωm, hpos, rfl⟩ := exists_positive_presentation p ω hω
  let := p.stalkAlgebra (genericPoint X)
  exact (isUnibranch_iff_presentation q p hp).mpr
    (MultiModel.isUnibranch_of_exists_hasEnvelopeProperty
      ⟨ωm, hpos, (hasEnvelopeProperty_iff_presentation d q p hp ωm).mp h⟩)

omit [IsAlgClosed k] in
/-- Every projective scheme has an ample class: `[A]` for an ample invertible sheaf `A`. -/
theorem exists_mem_ampleCone {X : Scheme.{u}} (p : X ⟶ Spec (.of k)) [IsProjective p] :
    ∃ ω : Space p, ω ∈ ampleCone p := by
  obtain ⟨A, hA⟩ := exists_geometric_ample_line p
  exact ⟨_, ampleLineClass_mem_ampleCone p A hA⟩

/-- **FHX Corollary 1.1, (2) ⇒ (1)**, with no hypothesis: if `EP_X(θ)` holds for every
`θ ∈ N¹(X)_ℝ`, then `X` is unibranch. -/
theorem isUnibranch_of_forall_hasEnvelopeProperty {X : Scheme.{u}} [IsIntegral X]
    (p : X ⟶ Spec (.of k)) [IsProjective p] (h : ∀ θ : Space p, HasEnvelopeProperty p θ) :
    IsUnibranch X := by
  obtain ⟨ω, hω⟩ := exists_mem_ampleCone p
  exact isUnibranch_of_hasEnvelopeProperty p hω (h ω)

/-- **FHX Corollary 1.1, with unibranchness from above**: if unibranchness of `X` implies
`EP_X(θ)` for every class (`hmain`, the conclusion of FHX Theorem A), then (1) `X` is
unibranch, (1′) all local rings of `X` are unibranch, (1″) all local rings are geometrically
unibranch, (2) `EP_X(θ)` for every `θ ∈ N¹(X)_ℝ`, (3) `EP_X(ω)` for some ample `ω` are
equivalent. -/
theorem isUnibranch_tfae_hasEnvelopeProperty_of_imp {X : Scheme.{u}} [IsIntegral X]
    (p : X ⟶ Spec (.of k)) [IsProjective p]
    (hmain : IsUnibranch X → ∀ θ : Space p, HasEnvelopeProperty p θ) :
    List.TFAE [IsUnibranch X,
      ∀ x : X, IsUnibranchLocalRing (X.presheaf.stalk x),
      IsGeometricallyUnibranchScheme X,
      ∀ θ : Space p, HasEnvelopeProperty p θ,
      ∃ ω ∈ ampleCone p, HasEnvelopeProperty p ω] := by
  have : IsProper p := (ProjectiveFactorizationRingIso.of_isProjective p).isProper
  have hloc := isUnibranch_tfae p
  tfae_have 1 ↔ 2 := hloc.out 0 1
  tfae_have 1 ↔ 3 := hloc.out 0 2
  tfae_have 1 → 4 := hmain
  tfae_have 4 → 5 := fun h => by
    obtain ⟨ω, hω⟩ := exists_mem_ampleCone p
    exact ⟨ω, hω, h ω⟩
  tfae_have 5 → 1 := fun ⟨_, hω, h⟩ => isUnibranch_of_hasEnvelopeProperty p hω h
  tfae_finish

/-- **FHX Corollary 1.1** (`cor:var-characterization`; FHX `cor:intro-characterization`): let
`X` be an integral projective variety over an algebraically closed field `k`. Assume, at every
countable algebraically closed subfield `k₀` of `k`, FHX Lemma 5.5 (`hLP`) and, in
characteristic `0`, FHX Theorem 3.1 (`h₀`), as in FHX Theorem A. The following are
equivalent:
1. `X` is unibranch, in the form "its normalization is bijective";
1′. every local ring `𝒪_{X,x}` is unibranch (FHX §1.1's definition of unibranch);
1″. every local ring `𝒪_{X,x}` is geometrically unibranch;
2. `EP_X(θ)` holds for every `θ ∈ N¹(X)_ℝ`;
3. `EP_X(ω)` holds for some ample class `ω ∈ Amp(X)`.

The hypotheses enter only through (1) ⇒ (2); (2) ⇒ (1) and (3) ⇒ (1) are
`isUnibranch_of_forall_hasEnvelopeProperty` and `isUnibranch_of_hasEnvelopeProperty`, which
assume nothing. -/
theorem isUnibranch_tfae_hasEnvelopeProperty_of_forall_countable
    (hLP : ∀ (k₀ : Type u) [Field k₀] [Algebra k₀ k] [IsAlgClosed k₀] [Countable k₀],
      LocalPositivity k₀)
    (h₀ : ∀ (k₀ : Type u) [Field k₀] [Algebra k₀ k] [IsAlgClosed k₀] [Countable k₀]
      [CharZero k₀], SmoothEnvelopeCharZero k₀)
    (X : Scheme.{u}) [IsIntegral X] (p : X ⟶ Spec (.of k)) [IsProjective p] :
    List.TFAE [IsUnibranch X,
      ∀ x : X, IsUnibranchLocalRing (X.presheaf.stalk x),
      IsGeometricallyUnibranchScheme X,
      ∀ θ : Space p, HasEnvelopeProperty p θ,
      ∃ ω ∈ ampleCone p, HasEnvelopeProperty p ω] :=
  isUnibranch_tfae_hasEnvelopeProperty_of_imp p fun hX θ =>
    hasEnvelopeProperty_of_isUnibranch_of_forall_countable hLP h₀ p hX θ

/-- **FHX Corollary 1.1 in characteristic `ℓ > 0`** (`cor:var-characterization`): the
equivalences of `isUnibranch_tfae_hasEnvelopeProperty_of_forall_countable` under FHX Lemma 5.5 (`hLP`) alone. -/
theorem isUnibranch_tfae_hasEnvelopeProperty_of_charP (ℓ : ℕ) [Fact ℓ.Prime] [CharP k ℓ]
    (hLP : ∀ (k₀ : Type u) [Field k₀] [Algebra k₀ k] [IsAlgClosed k₀] [Countable k₀],
      LocalPositivity k₀)
    (X : Scheme.{u}) [IsIntegral X] (p : X ⟶ Spec (.of k)) [IsProjective p] :
    List.TFAE [IsUnibranch X,
      ∀ x : X, IsUnibranchLocalRing (X.presheaf.stalk x),
      IsGeometricallyUnibranchScheme X,
      ∀ θ : Space p, HasEnvelopeProperty p θ,
      ∃ ω ∈ ampleCone p, HasEnvelopeProperty p ω] :=
  isUnibranch_tfae_hasEnvelopeProperty_of_imp p fun hX θ =>
    hasEnvelopeProperty_of_isUnibranch_of_charP ℓ hLP p hX θ

end EnvelopeProperty.Variety
