import EnvelopeProperty.Berkovich.AffineLine
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem

/-!
# Genuine affine-line equations and their actual height bound

An explicit nonzero parameter-coordinate coefficient produces a real quotient
algebra isomorphism between the polynomial algebra modulo transverse affine
linear equations and the one-variable polynomial algebra. Both inverse identities
are on entire polynomials, so the whole substitution kernel is precisely this
original equation ideal. With finitely many coordinates, an actual generator list
has at most card σ−1 entries. Its full ideal image in every Noetherian target
satisfies the genuine Krull height bound at all actual minimal primes.

No component-dominance, affine dimension/coheight, geometric-integrality,
normalization, smoothness of a normalized curve or finite-flatness certificate
is assumed or derived by this precursor. No valuation or infinite-field
hypothesis is used; its field coefficient ring has arbitrary characteristic.
-/

open scoped Classical Polynomial
noncomputable section
namespace EnvelopeProperty.AffineLine
variable {F σ : Type*} [Field F] (a b : σ → F) (j : σ)

/-- An actual polynomial representing the line parameter when b_j is nonzero. -/
def parameterPolynomial : MvPolynomial σ F :=
  MvPolynomial.C (b j)⁻¹ * (MvPolynomial.X j - MvPolynomial.C (a j))

/-- The original affine linear relation defining a genuine line. -/
def lineRelation (i : σ) : MvPolynomial σ F :=
  MvPolynomial.X i - MvPolynomial.C (a i) - MvPolynomial.C (b i) * parameterPolynomial a b j

/-- The actual ideal generated by all transverse line equations. -/
def lineIdeal : Ideal (MvPolynomial σ F) :=
  Ideal.span (lineRelation a b j '' {i : σ | i ≠ j})

theorem subst_parameterPolynomial (hb : b j ≠ 0) :
    subst a b (parameterPolynomial a b j) = Polynomial.X := by
  simp only [parameterPolynomial, map_mul, map_sub, subst, MvPolynomial.aeval_C,
    MvPolynomial.aeval_X, Polynomial.algebraMap_eq, add_sub_cancel_left]
  rw [← mul_assoc, ← Polynomial.C_mul, inv_mul_cancel₀ hb, map_one, one_mul]

theorem subst_lineRelation (hb : b j ≠ 0) (i : σ) : subst a b (lineRelation a b j i) = 0 := by
  simp only [lineRelation, map_sub, map_mul, subst_parameterPolynomial a b j hb]
  simp only [subst, MvPolynomial.aeval_X, MvPolynomial.aeval_C, Polynomial.algebraMap_eq]
  ring

theorem lineRelation_self (hb : b j ≠ 0) : lineRelation a b j j = 0 := by
  simp only [lineRelation, parameterPolynomial, ← mul_assoc, ← MvPolynomial.C_mul,
    mul_inv_cancel₀ hb, map_one, one_mul, sub_self]

theorem lineRelation_mem (hb : b j ≠ 0) (i : σ) : lineRelation a b j i ∈ lineIdeal a b j := by
  classical
  by_cases hi : i = j
  · rw [hi, lineRelation_self a b j hb]
    exact Ideal.zero_mem _
  · exact Ideal.subset_span ⟨i, hi, rfl⟩

theorem lineIdeal_le_ker_subst (hb : b j ≠ 0) :
    lineIdeal a b j ≤ RingHom.ker (subst a b).toRingHom := by
  apply Ideal.span_le.mpr
  rintro _ ⟨i, _hi, rfl⟩
  exact subst_lineRelation a b j hb i

/-- The true line map on the entire actual quotient algebra. -/
def lineQuotientHom (hb : b j ≠ 0) : (MvPolynomial σ F ⧸ lineIdeal a b j) →ₐ[F] F[X] :=
  Ideal.Quotient.liftₐ (lineIdeal a b j) (subst a b) (lineIdeal_le_ker_subst a b j hb)

theorem lineQuotientHom_mk (hb : b j ≠ 0) (f : MvPolynomial σ F) :
    lineQuotientHom a b j hb (Ideal.Quotient.mk (lineIdeal a b j) f) = subst a b f := rfl

/-- The genuine polynomial parameter inverse on the full quotient. -/
def lineQuotientInv : F[X] →ₐ[F] (MvPolynomial σ F ⧸ lineIdeal a b j) :=
  Polynomial.aeval (Ideal.Quotient.mk (lineIdeal a b j) (parameterPolynomial a b j))

theorem lineQuotientHom_comp_inv (hb : b j ≠ 0) :
    (lineQuotientHom a b j hb).comp (lineQuotientInv a b j) = AlgHom.id F F[X] := by
  apply Polynomial.algHom_ext
  simp only [AlgHom.comp_apply, lineQuotientInv, Polynomial.aeval_X,
    lineQuotientHom_mk, subst_parameterPolynomial a b j hb, AlgHom.id_apply]

theorem lineQuotientInv_comp_hom (hb : b j ≠ 0) :
    (lineQuotientInv a b j).comp (lineQuotientHom a b j hb) =
      AlgHom.id F (MvPolynomial σ F ⧸ lineIdeal a b j) := by
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  intro i
  have he := Ideal.Quotient.eq_zero_iff_mem.mpr (lineRelation_mem a b j hb i)
  change Ideal.Quotient.mk (lineIdeal a b j)
    (MvPolynomial.X i - MvPolynomial.C (a i) -
      MvPolynomial.C (b i) * parameterPolynomial a b j) = 0 at he
  simp only [map_sub, map_mul] at he
  change lineQuotientInv a b j (subst a b (MvPolynomial.X i)) =
    Ideal.Quotient.mk (lineIdeal a b j) (MvPolynomial.X i)
  simp only [subst, MvPolynomial.aeval_X, lineQuotientInv, map_add, map_mul,
    Polynomial.aeval_C, Polynomial.aeval_X]
  have hc (c : F) : algebraMap F (MvPolynomial σ F ⧸ lineIdeal a b j) c =
      Ideal.Quotient.mk (lineIdeal a b j) (MvPolynomial.C c) :=
    ((Ideal.Quotient.mkₐ F (lineIdeal a b j)).commutes c).symm
  rw [hc, hc]
  simpa only [add_comm] using (sub_eq_iff_eq_add.mp (sub_eq_zero.mp he)).symm

/-- The entire line coordinate algebra quotient is genuinely the one-variable polynomial algebra. -/
def lineQuotientEquiv (hb : b j ≠ 0) :
    (MvPolynomial σ F ⧸ lineIdeal a b j) ≃ₐ[F] F[X] :=
  AlgEquiv.ofAlgHom (lineQuotientHom a b j hb) (lineQuotientInv a b j)
    (lineQuotientHom_comp_inv a b j hb) (lineQuotientInv_comp_hom a b j hb)

/-- Every original polynomial maps by the real substitution under the quotient equivalence. -/
theorem lineQuotientEquiv_mk (hb : b j ≠ 0) (f : MvPolynomial σ F) :
    lineQuotientEquiv a b j hb (Ideal.Quotient.mk (lineIdeal a b j) f) = subst a b f := rfl

/-- The whole line kernel is exactly the span of the original transverse affine equations. -/
theorem ker_subst_eq_lineIdeal (hb : b j ≠ 0) :
    RingHom.ker (subst a b).toRingHom = lineIdeal a b j := by
  ext f
  change subst a b f = 0 ↔ f ∈ lineIdeal a b j
  rw [← lineQuotientEquiv_mk a b j hb f,
    map_eq_zero_iff _ (lineQuotientEquiv a b j hb).injective,
    Ideal.Quotient.eq_zero_iff_mem]

section FiniteCoordinates
variable [Fintype σ]

/-- The actual finite transverse equation list omits the selected parameter coordinate. -/
def lineGenerators : Finset (MvPolynomial σ F) := by
  classical
  exact (Finset.univ.erase j).image (lineRelation a b j)

/-- This genuine finite list spans the entire original line equation ideal. -/
theorem lineIdeal_eq_span_generators :
    lineIdeal a b j = Ideal.span (lineGenerators a b j : Set (MvPolynomial σ F)) := by
  classical
  unfold lineIdeal
  apply congrArg Ideal.span
  ext f
  simp [lineGenerators]

/-- The original line ideal is genuinely finitely generated. -/
theorem lineIdeal_fg : (lineIdeal a b j).FG :=
  ⟨lineGenerators a b j, (lineIdeal_eq_span_generators a b j).symm⟩

/-- There are at most card σ−1 actual transverse equations. -/
theorem lineGenerators_card_le : (lineGenerators a b j).card ≤ Fintype.card σ - 1 := by
  classical
  change ((Finset.univ.erase j).image (lineRelation a b j)).card ≤ _
  trans (Finset.univ.erase j).card
  · exact Finset.card_image_le
  · simp

/-- An entire original ideal image is generated by the actual images of these transverse equations. -/
theorem map_lineIdeal_eq_span_generators {B : Type*} [CommRing B]
    (φ : MvPolynomial σ F →+* B) :
    (lineIdeal a b j).map φ = Ideal.span ((lineGenerators a b j).image φ : Set B) := by
  classical
  rw [lineIdeal_eq_span_generators, Ideal.map_span]
  congr 1
  exact Finset.coe_image.symm

/-- Real Krull height bounds every actual minimal prime of the transverse-equation image. -/
theorem height_map_lineIdeal_le {B : Type*} [CommRing B] [IsNoetherianRing B]
    (φ : MvPolynomial σ F →+* B) (P : Ideal B)
    (hP : P ∈ ((lineIdeal a b j).map φ).minimalPrimes) :
    P.height ≤ (Fintype.card σ - 1 : ℕ) := by
  classical
  rw [map_lineIdeal_eq_span_generators a b j φ] at hP
  have ht := Ideal.height_le_card_of_mem_minimalPrimes_span_finset hP
  have hc : ((lineGenerators a b j).image φ).card ≤ Fintype.card σ - 1 :=
    Finset.card_image_le.trans (lineGenerators_card_le a b j)
  exact ht.trans (by exact_mod_cast hc)

end FiniteCoordinates

end EnvelopeProperty.AffineLine
