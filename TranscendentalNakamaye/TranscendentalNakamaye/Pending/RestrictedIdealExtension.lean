import TranscendentalNakamaye.Pending.IdealWeightPowers
import TranscendentalNakamaye.Pending.RestrictedIdealWeight
import TranscendentalNakamaye.Pending.VanishingIdealCoherent

set_option autoImplicit false

/-!
# The ambient extension of a restricted ideal (`𝔣̃_B`)

Source: Copy-4, Step 1 of `prop:principalization`
(`transcendental-nakamaye-copy4-20260911`, `source/main-Nulllocus.tex:1810-1823`):

> Let `𝔣̃_B ⊆ 𝒪_{Y_1}` be the inverse image of `𝔣_B` under the surjection
> `𝒪_{Y_1} → 𝒪_{W_1}`.  This is a coherent ideal containing `𝓘_{W_1}`, with
> `Res_{W_1} 𝔣̃_B = 𝔣_B`, and it is not contained in `𝓘_{W_1}` because `𝔣_B ≠ 0`.

That sentence is what makes the third application of `lem:relative-principalization`
legal: relative principalization takes an ideal on the *ambient* manifold, whereas
`𝔣_B` is an ideal of `𝒪_{W_1}`.  This module supplies the construction and all four
properties, for an arbitrary subset `W`.

`GermIdeal.restrictOn W 𝔞` is the preimage of `Res_W 𝔞` under `𝒪_M → 𝒪_W`: the
holomorphic germs that agree **on `W`, near the point** with a germ of `𝔞`.  The
substance is

* `restrictOn_eq_sum_vanishingIdeal`: it is `𝔞 + 𝓘_W` — the remainder
  `g - ∑ aᵢ sᵢ` of the restricted span relation is holomorphic and vanishes on `W`,
  which is exactly a germ of `𝓘_W`; and
* `isCoherent_restrictOn`: hence coherent, by concatenating the two generating
  families, `𝓘_W` being coherent for a closed submanifold
  (`Pending/VanishingIdealCoherent`).

The remaining three properties are immediate from that description, and the last one
is stated in the manuscript's own form: `Res_W 𝔞 ≠ 0` — one germ of `𝔞` not vanishing
at one point of `W` — already forces `𝔣̃ ⊄ 𝓘_W`.

`GermIdeal.sum` (the ideal generated by `𝔞 ∪ 𝔟`) is introduced here because
`FirstPass/HolomorphicIdealSheaves` has products and pullbacks but no sums; it is
modelled on `GermIdeal.mul` and its coherence proof on
`IdealWeightPowers.isCoherent_mul`.

Everything here is sorry-free.
-/

open Set Filter
open scoped Topology Manifold ContDiff

namespace TranscendentalNakamaye.Pending.RestrictedIdealExtension

noncomputable section

open FirstPass FirstPass.HolomorphicIdealSheaves
open TranscendentalNakamaye.Pending.IdealWeightComparison
open TranscendentalNakamaye.Pending.IdealWeightPowers
open TranscendentalNakamaye.Pending.RelativePrincipalizationSpan
open TranscendentalNakamaye.Pending.RestrictedIdealWeight

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]

/-! ### Sums of ideal sheaves -/

/-- The sum ideal `𝔞 + 𝔟`: the ideal generated by the union of the two stalks. -/
def sumIdeal (𝔞 𝔟 : GermIdeal n M) : GermIdeal n M where
  mem x := IsInSpanAt (n := n) (fun s => 𝔞.mem x s ∨ 𝔟.mem x s) x

theorem le_sumIdeal_left {𝔞 𝔟 : GermIdeal n M} (h𝔞 : 𝔞.IsCoherent) :
    𝔞.Le (sumIdeal 𝔞 𝔟) := by
  intro x g hg
  exact isInSpanAt_of_eq_mul (S := fun s => 𝔞.mem x s ∨ 𝔟.mem x s) (Or.inl hg)
    (GermIdeal.IsCoherent.holomorphicAt_mem h𝔞 hg) (holomorphicAt_const 1)
    (Eventually.of_forall fun y => (one_mul _).symm)

theorem le_sumIdeal_right {𝔞 𝔟 : GermIdeal n M} (h𝔟 : 𝔟.IsCoherent) :
    𝔟.Le (sumIdeal 𝔞 𝔟) := by
  intro x g hg
  exact isInSpanAt_of_eq_mul (S := fun s => 𝔞.mem x s ∨ 𝔟.mem x s) (Or.inr hg)
    (GermIdeal.IsCoherent.holomorphicAt_mem h𝔟 hg) (holomorphicAt_const 1)
    (Eventually.of_forall fun y => (one_mul _).symm)

/-- The concatenation of two generating families; this is mathlib's `Fin.append`,
named here only so that the three `range` lemmas below read well. -/
def sumFamily {N P : ℕ} (g : Fin N → M → ℂ) (h : Fin P → M → ℂ) :
    Fin (N + P) → M → ℂ := Fin.append g h

omit [TopologicalSpace M] in
theorem mem_range_sumFamily {N P : ℕ} {g : Fin N → M → ℂ} {h : Fin P → M → ℂ}
    {s : M → ℂ} (hs : s ∈ range (sumFamily g h)) :
    s ∈ range g ∨ s ∈ range h := by
  obtain ⟨i, rfl⟩ := hs
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i
  · exact Or.inl ⟨j, by simp [sumFamily]⟩
  · exact Or.inr ⟨j, by simp [sumFamily]⟩

omit [TopologicalSpace M] in
theorem range_left_subset_sumFamily {N P : ℕ} {g : Fin N → M → ℂ} {h : Fin P → M → ℂ}
    {s : M → ℂ} (hs : s ∈ range g) : s ∈ range (sumFamily g h) := by
  obtain ⟨j, rfl⟩ := hs
  exact ⟨Fin.castAdd P j, by simp [sumFamily]⟩

omit [TopologicalSpace M] in
theorem range_right_subset_sumFamily {N P : ℕ} {g : Fin N → M → ℂ} {h : Fin P → M → ℂ}
    {s : M → ℂ} (hs : s ∈ range h) : s ∈ range (sumFamily g h) := by
  obtain ⟨j, rfl⟩ := hs
  exact ⟨Fin.natAdd N j, by simp [sumFamily]⟩

/-- **Coherence is stable under sums.** -/
theorem isCoherent_sumIdeal {𝔞 𝔟 : GermIdeal n M} (h𝔞 : 𝔞.IsCoherent)
    (h𝔟 : 𝔟.IsCoherent) : (sumIdeal 𝔞 𝔟).IsCoherent := by
  intro x
  obtain ⟨U, hU, hxU, N, g, hgdiff, hgiff⟩ := h𝔞 x
  obtain ⟨U', hU', hxU', P, h, hhdiff, hhiff⟩ := h𝔟 x
  refine ⟨U ∩ U', hU.inter hU', ⟨hxU, hxU'⟩, N + P, sumFamily g h, ?_, ?_⟩
  · intro k
    refine Fin.addCases (fun j z hz => ?_) (fun j z hz => ?_) k
    · simpa [sumFamily] using (hgdiff j z hz.1).mono inter_subset_left
    · simpa [sumFamily] using (hhdiff j z hz.2).mono inter_subset_right
  · intro z hz v
    constructor
    · intro hv
      have hv' : IsInSpanAt (n := n) (fun t => 𝔞.mem z t ∨ 𝔟.mem z t) z v := hv
      refine IsInSpanAt.trans ?_ hv'
      rintro s (hs | hs)
      · exact IsInSpanAt.mono (fun _ => range_left_subset_sumFamily)
          ((hgiff z hz.1 s).mp hs)
      · exact IsInSpanAt.mono (fun _ => range_right_subset_sumFamily)
          ((hhiff z hz.2 s).mp hs)
    · intro hv
      show IsInSpanAt (n := n) (fun t => 𝔞.mem z t ∨ 𝔟.mem z t) z v
      refine IsInSpanAt.mono ?_ hv
      intro s hs
      rcases mem_range_sumFamily hs with hs' | hs'
      · obtain ⟨j, rfl⟩ := hs'
        exact Or.inl (mem_of_isPresentation hU hz.1 hgdiff hgiff j)
      · obtain ⟨j, rfl⟩ := hs'
        exact Or.inr (mem_of_isPresentation hU' hz.2 hhdiff hhiff j)

/-! ### The ambient extension of a restricted ideal -/

variable (n) in
/-- **`𝔣̃`**: the preimage of `Res_W 𝔞` under the surjection `𝒪_M → 𝒪_W`, i.e. the
holomorphic germs agreeing on `W`, near the point, with a germ of `𝔞`. -/
def restrictOn (W : Set M) (𝔞 : GermIdeal n M) : GermIdeal n M where
  mem x g := HolomorphicAt n g x ∧ IsInSpanOnAt (n := n) W (𝔞.mem x) x g

variable {W : Set M} {𝔞 : GermIdeal n M}

/-- `𝓘_W ⊆ 𝔣̃`: a germ vanishing on `W` restricts to `0`, the empty combination. -/
theorem vanishingIdeal_le_restrictOn : (vanishingIdeal (n := n) W).Le (restrictOn n W 𝔞) := by
  intro x g hg
  refine ⟨hg.1, 0, Fin.elim0, Fin.elim0, fun i => i.elim0, fun i => i.elim0, ?_⟩
  filter_upwards [hg.2] with y hy hyW
  simpa using hy hyW

/-- `𝔞 ⊆ 𝔣̃`. -/
theorem le_restrictOn (h𝔞 : 𝔞.IsCoherent) : 𝔞.Le (restrictOn n W 𝔞) := by
  intro x g hg
  refine ⟨GermIdeal.IsCoherent.holomorphicAt_mem h𝔞 hg, IsInSpanAt.restrict ?_⟩
  exact isInSpanAt_of_eq_mul (S := 𝔞.mem x) hg
    (GermIdeal.IsCoherent.holomorphicAt_mem h𝔞 hg) (holomorphicAt_const 1)
    (Eventually.of_forall fun y => (one_mul _).symm)

/-- **`𝔣̃ = 𝔞 + 𝓘_W`.**  The nontrivial inclusion is `⊆`: the remainder
`g - ∑ aᵢ sᵢ` of a restricted span relation is holomorphic and vanishes on `W` near
the point, hence is a germ of `𝓘_W`. -/
theorem restrictOn_eq_sum_vanishingIdeal (h𝔞 : 𝔞.IsCoherent) :
    restrictOn n W 𝔞 = sumIdeal 𝔞 (vanishingIdeal (n := n) W) := by
  ext x g
  constructor
  · rintro ⟨hghol, N, s, a, hs, ha, hsum⟩
    have hshol : ∀ i, HolomorphicAt n (s i) x := fun i =>
      GermIdeal.IsCoherent.holomorphicAt_mem h𝔞 (hs i)
    set v : M → ℂ := fun y => ∑ i, a i y * s i y with hvdef
    have hvhol : HolomorphicAt n v x :=
      HolomorphicAt.sum Finset.univ fun i _ => (ha i).mul (hshol i)
    have hsubhol : HolomorphicAt n (fun y => g y - v y) x := by
      refine HolomorphicAt.congr
        (HolomorphicAt.add hghol ((holomorphicAt_const (-1 : ℂ)).mul hvhol)) ?_
      filter_upwards with y
      ring
    have hvspan : IsInSpanAt (n := n)
        (fun t => 𝔞.mem x t ∨ (vanishingIdeal (n := n) W).mem x t) x v :=
      ⟨hvhol, N, s, a, fun i => Or.inl (hs i), ha, Eventually.of_forall fun _ => rfl⟩
    have hrmem : (vanishingIdeal (n := n) W).mem x (fun y => g y - v y) := by
      refine ⟨hsubhol, ?_⟩
      filter_upwards [hsum] with y hy hyW
      simp [hvdef, hy hyW]
    have hrspan : IsInSpanAt (n := n)
        (fun t => 𝔞.mem x t ∨ (vanishingIdeal (n := n) W).mem x t) x (fun y => g y - v y) :=
      isInSpanAt_of_eq_mul (Or.inr hrmem) hsubhol (holomorphicAt_const 1)
        (Eventually.of_forall fun y => (one_mul _).symm)
    obtain ⟨-, K, t, b, ht, hb, hts⟩ := IsInSpanAt.add hrspan hvspan
    refine ⟨hghol, K, t, b, ht, hb, ?_⟩
    filter_upwards [hts] with y hy
    simpa using hy
  · intro hg
    have hg' : IsInSpanAt (n := n)
        (fun t => 𝔞.mem x t ∨ (vanishingIdeal (n := n) W).mem x t) x g := hg
    refine ⟨hg'.holomorphicAt, ?_⟩
    refine IsInSpanOnAt.trans ?_ (IsInSpanAt.restrict hg')
    rintro s (hs | hs)
    · exact IsInSpanAt.restrict (isInSpanAt_of_eq_mul (S := 𝔞.mem x) hs
        (GermIdeal.IsCoherent.holomorphicAt_mem h𝔞 hs) (holomorphicAt_const 1)
        (Eventually.of_forall fun y => (one_mul _).symm))
    · refine ⟨0, Fin.elim0, Fin.elim0, fun i => i.elim0, fun i => i.elim0, ?_⟩
      filter_upwards [hs.2] with y hy hyW
      simpa using hy hyW

/-- **`𝔣̃` is coherent** whenever `𝔞` is and `W` is a closed submanifold. -/
theorem isCoherent_restrictOn (h𝔞 : 𝔞.IsCoherent)
    (hW : (vanishingIdeal (n := n) W).IsCoherent) :
    (restrictOn n W 𝔞).IsCoherent := by
  rw [restrictOn_eq_sum_vanishingIdeal h𝔞]
  exact isCoherent_sumIdeal h𝔞 hW

/-- **`𝔣̃` is coherent for a closed submanifold `W`** — the form Step 1 uses, with
`𝓘_W` coherent by `VanishingIdealCoherent.isCoherent_vanishingIdeal` (Hadamard in
flattening coordinates). -/
theorem isCoherent_restrictOn_of_isClosedSubmanifold [IsComplexManifold n M]
    (h𝔞 : 𝔞.IsCoherent) (hW : FirstPass.BlowupSequences.IsClosedSubmanifold n W) :
    (restrictOn n W 𝔞).IsCoherent :=
  isCoherent_restrictOn h𝔞 (VanishingIdealCoherent.isCoherent_vanishingIdeal hW)

/-! ### `Res_W 𝔣̃ = Res_W 𝔞`, and `𝔣̃ ⊄ 𝓘_W` -/

/-- Every germ of `𝔣̃` restricts on `W` into `𝔞`: this is `Res_W 𝔣̃ ⊆ Res_W 𝔞`, and it
is the definition. -/
theorem restrictLe_restrictOn : RestrictLe W (restrictOn n W 𝔞) 𝔞 :=
  fun _ _ _ hg => hg.2

/-- The converse inclusion `Res_W 𝔞 ⊆ Res_W 𝔣̃`. -/
theorem restrictLe_self_restrictOn (h𝔞 : 𝔞.IsCoherent) :
    RestrictLe W 𝔞 (restrictOn n W 𝔞) :=
  fun x _ g hg => IsInSpanAt.restrict (isInSpanAt_of_eq_mul (S := (restrictOn n W 𝔞).mem x)
    (le_restrictOn h𝔞 x g hg) (GermIdeal.IsCoherent.holomorphicAt_mem h𝔞 hg)
    (holomorphicAt_const 1) (Eventually.of_forall fun _ => (one_mul _).symm))

/-- **`𝔣̃ ⊄ 𝓘_W` because `Res_W 𝔞 ≠ 0`.**  One germ of `𝔞` that does not vanish at one
point of `W` suffices — this is exactly the manuscript's reason. -/
theorem not_le_vanishingIdeal_restrictOn (h𝔞 : 𝔞.IsCoherent) {x : M} (hxW : x ∈ W)
    {g : M → ℂ} (hg : 𝔞.mem x g) (hgx : g x ≠ 0) :
    ¬ (restrictOn n W 𝔞).Le (vanishingIdeal (n := n) W) := by
  intro hle
  exact hgx (((hle x g (le_restrictOn h𝔞 x g hg)).2).self_of_nhds hxW)

/-- The same conclusion from the hypothesis `𝔞 ⊄ 𝓘_W`, which is the form
`exists_relativePrincipalization` takes. -/
theorem not_le_vanishingIdeal_restrictOn_of_not_le (h𝔞 : 𝔞.IsCoherent)
    (h : ¬ 𝔞.Le (vanishingIdeal (n := n) W)) :
    ¬ (restrictOn n W 𝔞).Le (vanishingIdeal (n := n) W) :=
  fun hle => h fun x g hg => hle x g (le_restrictOn h𝔞 x g hg)

/-! ### `𝔣̃` is an ideal: the closure properties its use requires -/

/-- Membership in `𝔣̃` depends only on the germ **along `W`**. -/
theorem restrictOn_congr {x : M} {g g' : M → ℂ} (hg : (restrictOn n W 𝔞).mem x g)
    (hg'hol : HolomorphicAt n g' x) (hgg' : ∀ᶠ y in 𝓝 x, y ∈ W → g' y = g y) :
    (restrictOn n W 𝔞).mem x g' :=
  ⟨hg'hol, IsInSpanOnAt.congr_right hg.2 hgg'⟩

/-- `𝔣̃` is closed under multiplication by a holomorphic germ. -/
theorem restrictOn_mul_left {x : M} {c g : M → ℂ} (hc : HolomorphicAt n c x)
    (hg : (restrictOn n W 𝔞).mem x g) :
    (restrictOn n W 𝔞).mem x (fun y => c y * g y) :=
  ⟨hc.mul hg.1, IsInSpanOnAt.mul_left hc hg.2⟩

/-- `𝔣̃` is closed under holomorphic combinations of its own germs. -/
theorem restrictOn_of_isInSpanAt {x : M} {g : M → ℂ}
    (hg : IsInSpanAt (n := n) ((restrictOn n W 𝔞).mem x) x g) :
    (restrictOn n W 𝔞).mem x g :=
  ⟨hg.holomorphicAt, IsInSpanOnAt.trans (fun _ hs => hs.2) (IsInSpanAt.restrict hg)⟩

/-- Off `W` — more precisely, on an open set missing `W` — `𝔣̃` is everything. -/
theorem restrictOn_eq_top_of_disjoint {x : M} {U : Set M} (hU : IsOpen U) (hxU : x ∈ U)
    (hUW : U ∩ W = ∅) {g : M → ℂ} (hg : HolomorphicAt n g x) :
    (restrictOn n W 𝔞).mem x g := by
  refine ⟨hg, 0, Fin.elim0, Fin.elim0, fun i => i.elim0, fun i => i.elim0, ?_⟩
  filter_upwards [hU.mem_nhds hxU] with y hy hyW
  have : y ∈ U ∩ W := ⟨hy, hyW⟩
  rw [hUW] at this
  exact absurd this (Set.notMem_empty y)

end

end TranscendentalNakamaye.Pending.RestrictedIdealExtension


