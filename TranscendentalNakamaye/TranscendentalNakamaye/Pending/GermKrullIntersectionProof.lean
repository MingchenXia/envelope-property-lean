import TranscendentalNakamaye.Pending.HolomorphicGermNoetherian
import TranscendentalNakamaye.Pending.GermIdealSliceClosure
import Mathlib.RingTheory.Filtration
import Mathlib.RingTheory.Ideal.Quotient.Noetherian

set_option autoImplicit false

/-!
# Krull's intersection theorem for ideals of holomorphic germs

This module proves the interface `GermKrullIntersection m` of `Pending.GermIdealSliceClosure`.

Let `J` be an ideal of holomorphic germs at `p ∈ ℂ^{m+1}` and let `f` be holomorphic on a
polydisc around `p`.  Translating `p` to `0`, `J` becomes an ideal `I` of the ring
`𝒪 = HolGerm ℂ^{m+1}`, which is a Noetherian local ring (`isNoetherianRing_holGerm_euclidean`).
For every `K` some `h ∈ J` has the same torus coefficients as `f` on the box `[0,K)^{m+1}`,
so `f - h` lies in the ideal generated by the `(z_i - p_i)^K` (the box lemma
`BoxCoeffsIdealProperty`), hence in `𝔪^K`.  In the Noetherian local ring `𝒪/I` Krull's
theorem `⋂_K 𝔪^K = 0` then puts `f` in `I`.
-/

open Filter Topology

namespace TranscendentalNakamaye.Pending

noncomputable section

variable {m : ℕ}

/-- The box lemma: vanishing torus coefficients on `[0,K)^{m+1}` put a holomorphic function in
the ideal generated by the `(z_i - p_i)^K`, as a germ at `p`. -/
def BoxCoeffsIdealProperty (m : ℕ) : Prop :=
  ∀ (p : EuclideanSpace ℂ (Fin (m + 1))) (s s' : ℝ), 0 < s → s < s' →
    ∀ e : EuclideanSpace ℂ (Fin (m + 1)) → ℂ, DifferentiableOn ℂ e (openPolydisc p s') →
    ∀ K : ℕ, (∀ α : Fin (m + 1) → ℕ, (∀ i, α i < K) →
      torusCoeff p s (fun i => (α i : ℤ)) e = 0) →
    ∃ Q : Fin (m + 1) → EuclideanSpace ℂ (Fin (m + 1)) → ℂ,
      (∀ i, ∀ᶠ z in 𝓝 p, DifferentiableAt ℂ (Q i) z) ∧
      e =ᶠ[𝓝 p] fun z => ∑ i, (z i - p i) ^ K * Q i z

section Translate

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℂ V]

theorem eventually_differentiableAt_sub_const {f : V → ℂ} {p : V}
    (hf : ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ f z) :
    ∀ᶠ x in 𝓝 p, DifferentiableAt ℂ (fun x => f (x - p)) x := by
  have ht : Tendsto (fun x : V => x - p) (𝓝 p) (𝓝 0) := by
    simpa using (continuous_id.sub continuous_const).tendsto p (f := fun x : V => x - p)
  filter_upwards [ht.eventually hf] with x hx
  exact hx.comp x (differentiableAt_id.sub_const p)

theorem eventually_differentiableAt_add_const {f : V → ℂ} {p : V}
    (hf : ∀ᶠ z in 𝓝 p, DifferentiableAt ℂ f z) :
    ∀ᶠ x in 𝓝 0, DifferentiableAt ℂ (fun x => f (x + p)) x := by
  have ht : Tendsto (fun x : V => x + p) (𝓝 0) (𝓝 p) := by
    simpa using (continuous_id.add continuous_const).tendsto 0 (f := fun x : V => x + p)
  filter_upwards [ht.eventually hf] with x hx
  exact hx.comp x (differentiableAt_id.add_const p)

omit [NormedSpace ℂ V] in
theorem eventuallyEq_sub_const {f g : V → ℂ} {p : V} (h : f =ᶠ[𝓝 0] g) :
    (fun x => f (x - p)) =ᶠ[𝓝 p] fun x => g (x - p) := by
  have ht : Tendsto (fun x : V => x - p) (𝓝 p) (𝓝 0) := by
    simpa using (continuous_id.sub continuous_const).tendsto p (f := fun x : V => x - p)
  exact ht.eventually h

omit [NormedSpace ℂ V] in
theorem eventuallyEq_add_const {f g : V → ℂ} {p : V} (h : f =ᶠ[𝓝 p] g) :
    (fun x => f (x + p)) =ᶠ[𝓝 0] fun x => g (x + p) := by
  have ht : Tendsto (fun x : V => x + p) (𝓝 0) (𝓝 p) := by
    simpa using (continuous_id.add continuous_const).tendsto 0 (f := fun x : V => x + p)
  exact ht.eventually h

end Translate

/-- The ideal of `HolGerm ℂ^{m+1}` obtained by translating an ideal of germs at `p` to `0`. -/
def translatedGermIdeal (p : EuclideanSpace ℂ (Fin (m + 1)))
    {J : (EuclideanSpace ℂ (Fin (m + 1)) → ℂ) → Prop} (hJ : IsHolomorphicGermIdeal p J) :
    Ideal (HolGerm (EuclideanSpace ℂ (Fin (m + 1)))) where
  carrier := {g | ∃ f hf, g = HolGerm.mk f hf ∧ J fun x => f (x - p)}
  zero_mem' := ⟨0, eventually_differentiableAt_zero, HolGerm.mk_zero.symm, hJ.zero_mem⟩
  add_mem' := by
    rintro _ _ ⟨f₁, hf₁, rfl, hJ₁⟩ ⟨f₂, hf₂, rfl, hJ₂⟩
    exact ⟨_, eventually_differentiableAt_add hf₁ hf₂, (HolGerm.mk_add f₁ f₂ hf₁ hf₂).symm,
      hJ.add_mem hJ₁ hJ₂⟩
  smul_mem' := by
    rintro c _ ⟨f, hf, rfl, hJf⟩
    obtain ⟨a, ha, rfl⟩ := HolGerm.exists_eq_mk c
    exact ⟨_, eventually_differentiableAt_mul ha hf, (HolGerm.mk_mul a f ha hf).symm,
      hJ.mul_mem (eventually_differentiableAt_sub_const ha) hJf⟩

theorem mk_mem_translatedGermIdeal_iff {p : EuclideanSpace ℂ (Fin (m + 1))}
    {J : (EuclideanSpace ℂ (Fin (m + 1)) → ℂ) → Prop} (hJ : IsHolomorphicGermIdeal p J)
    {f : EuclideanSpace ℂ (Fin (m + 1)) → ℂ} (hf : ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ f z) :
    HolGerm.mk f hf ∈ translatedGermIdeal p hJ ↔ J fun x => f (x - p) := by
  constructor
  · rintro ⟨f', hf', hEq, hJf'⟩
    exact hJ.congr hJf' (eventuallyEq_sub_const (HolGerm.mk_eq_mk_iff.mp hEq))
  · exact fun h => ⟨f, hf, rfl, h⟩

/-- **Krull's intersection theorem for ideals of holomorphic germs**, from the box lemma. -/
theorem germKrullIntersection_of_boxCoeffsIdeal (hbox : BoxCoeffsIdealProperty m) :
    GermKrullIntersection m := by
  intro p J hJ s s' hs hss' f hf hK
  set R := HolGerm (EuclideanSpace ℂ (Fin (m + 1)))
  set I := translatedGermIdeal p hJ
  have hfp : ∀ᶠ z in 𝓝 p, DifferentiableAt ℂ f z :=
    Filter.eventually_of_mem ((isOpen_openPolydisc p s').mem_nhds
      (fun i => by simpa using hs.trans hss'))
      fun z hz => hf.differentiableAt ((isOpen_openPolydisc p s').mem_nhds hz)
  set F : R := HolGerm.mk (fun x => f (x + p)) (eventually_differentiableAt_add_const hfp)
  suffices hF : F ∈ I by
    have := (mk_mem_translatedGermIdeal_iff hJ _).mp hF
    simpa using this
  have : IsNoetherianRing R := isNoetherianRing_holGerm_euclidean (m + 1)
  by_cases hItop : I = ⊤
  · rw [hItop]; exact Submodule.mem_top
  have : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hItop
  have : IsLocalRing (R ⧸ I) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  set 𝔪 := IsLocalRing.maximalIdeal R
  set 𝔫 := IsLocalRing.maximalIdeal (R ⧸ I)
  have hmap : 𝔪.map (Ideal.Quotient.mk I) ≤ 𝔫 := by
    refine IsLocalRing.le_maximalIdeal fun htop => hItop ?_
    have h1 := Ideal.comap_map_of_surjective' (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective 𝔪
    rw [htop, Ideal.comap_top, Ideal.mk_ker] at h1
    have hI𝔪 : I ≤ 𝔪 := IsLocalRing.le_maximalIdeal hItop
    have : 𝔪 = ⊤ := by rw [h1, sup_eq_left.mpr hI𝔪]
    exact absurd this (IsLocalRing.maximalIdeal.isMaximal R).ne_top
  have hpow : ∀ K : ℕ, Ideal.Quotient.mk I F ∈ 𝔫 ^ K := by
    intro K
    obtain ⟨h, hJh, hhol, hcoeff⟩ := hK K
    have he : DifferentiableOn ℂ (f - h) (openPolydisc p s') := hf.sub hhol
    have hzero : ∀ α : Fin (m + 1) → ℕ, (∀ i, α i < K) →
        torusCoeff p s (fun i => (α i : ℤ)) (f - h) = 0 := by
      intro α hα
      rw [torusCoeff_sub (continuousOnTorus_of_differentiableOn hs.le hss' hf)
        (continuousOnTorus_of_differentiableOn hs.le hss' hhol), hcoeff α hα, sub_self]
    obtain ⟨Q, hQ, hEq⟩ := hbox p s s' hs hss' (f - h) he K hzero
    have hhp : ∀ᶠ z in 𝓝 p, DifferentiableAt ℂ h z :=
      Filter.eventually_of_mem ((isOpen_openPolydisc p s').mem_nhds
        (fun i => by simpa using hs.trans hss'))
        fun z hz => hhol.differentiableAt ((isOpen_openPolydisc p s').mem_nhds hz)
    set H : R := HolGerm.mk (fun x => h (x + p)) (eventually_differentiableAt_add_const hhp)
    have hHI : H ∈ I := by
      rw [mk_mem_translatedGermIdeal_iff]
      simpa using hJh
    have hcoord : ∀ i : Fin (m + 1), ∀ᶠ z in 𝓝 (0 : EuclideanSpace ℂ (Fin (m + 1))),
        DifferentiableAt ℂ (fun z : EuclideanSpace ℂ (Fin (m + 1)) => z i) z :=
      fun i => Eventually.of_forall fun _ =>
        (EuclideanSpace.proj (𝕜 := ℂ) i).differentiableAt
    have hterm : ∀ i, ∀ᶠ z in 𝓝 (0 : EuclideanSpace ℂ (Fin (m + 1))),
        DifferentiableAt ℂ (fun z : EuclideanSpace ℂ (Fin (m + 1)) =>
          (z i) ^ K * Q i (z + p)) z := fun i =>
      eventually_differentiableAt_mul (eventually_differentiableAt_pow (hcoord i) K)
        (eventually_differentiableAt_add_const (hQ i))
    have hdiff : F - H = ∑ i, HolGerm.mk (fun z => z i) (hcoord i) ^ K *
        HolGerm.mk (fun z => Q i (z + p)) (eventually_differentiableAt_add_const (hQ i)) := by
      have e1 : ∀ i, HolGerm.mk (fun z => z i) (hcoord i) ^ K *
          HolGerm.mk (fun z => Q i (z + p)) (eventually_differentiableAt_add_const (hQ i)) =
          HolGerm.mk _ (hterm i) := by
        intro i
        rw [← HolGerm.mk_pow, ← HolGerm.mk_mul]
      simp_rw [e1]
      rw [← HolGerm.mk_sum, ← HolGerm.mk_sub, HolGerm.mk_eq_mk_iff]
      filter_upwards [eventuallyEq_add_const hEq] with z hz
      simpa using hz
    have hmemPow : F - H ∈ 𝔪 ^ K := by
      rw [hdiff]
      refine Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow ?_ K)
      rw [HolGerm.mem_maximalIdeal_iff, HolGerm.eval_mk]
      simp
    have hq : Ideal.Quotient.mk I F = Ideal.Quotient.mk I (F - H) := by
      rw [map_sub, Ideal.Quotient.eq_zero_iff_mem.mpr hHI, sub_zero]
    rw [hq]
    refine Ideal.pow_right_mono hmap K ?_
    rw [← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hmemPow
  have hbot :=
    Ideal.iInf_pow_eq_bot_of_isLocalRing 𝔫 (IsLocalRing.maximalIdeal.isMaximal _).ne_top
  have h0 : Ideal.Quotient.mk I F = 0 := by
    have : Ideal.Quotient.mk I F ∈ ⨅ K : ℕ, 𝔫 ^ K := Submodule.mem_iInf _ |>.mpr hpow
    rw [hbot] at this
    exact this
  exact Ideal.Quotient.eq_zero_iff_mem.mp h0

end

end TranscendentalNakamaye.Pending
