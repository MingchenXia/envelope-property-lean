import TranscendentalNakamaye.Pending.MultiplierIdealBergmanNadelExtension
import TranscendentalNakamaye.Pending.MultiplierIdealBergmanNadelVanishing
import TranscendentalNakamaye.Pending.StrongOpennessFromOhsawaTakegoshi
import TranscendentalNakamaye.Pending.HormanderL2Theorem

set_option autoImplicit false

/-!
# Nadel's ideal identity: `𝓘(cΨ)_y` is generated by the global `L²` holomorphic functions

Let `Ψ` be plurisubharmonic near the closure of a bounded convex open `L ⊆ ℂ^{m+1}`, `c > 0`,
`K` open with `closure K ⊆ L`, and `H = {G holomorphic on K : ∫_K |G|² e^{-cΨ} < ∞}`
(`bergmanSpace`).  Then for every `y ∈ K`, every germ `f` at `y` with `|f|² e^{-cΨ}` integrable
near `y` lies in the ideal of holomorphic germs at `y` generated by `H`
(`inGermSpan_bergmanSpace`).  This is Nadel's theorem in the form of Demailly, *Analytic
methods in algebraic geometry*, Prop. 5.7 (and DEL00 Prop. 1.2, which Copy-4's
`lem:regularization` Step 4 cites); the converse inclusion is immediate.

Proof (Demailly's): for every `n`, Hörmander's estimate with the weight
`cΨ + q log |z - y|²`, `q = (m+1)(n+1)`, gives `G_n ∈ H` with `f - G_n` of pole order `q` at `y`
(`MultiplierIdealBergmanNadelExtension.exists_poleExtension_psh`); its torus coefficients of
total degree `< (m+1) n`, in particular those in the box `[0, n)^{m+1}`, vanish
(`MultiplierIdealBergmanNadelVanishing.torusCoeff_eq_zero_of_lintegral_pole`).  Krull's
intersection theorem in the Noetherian local ring of germs (`germKrullIntersection`) then puts
`f` in the ideal generated by `H`.

Step P3 of the Nadel coherence route of programme `TN.3.3.DEMPROVE` (clause (i) of Demailly
1992).
-/

open Set Filter MeasureTheory Complex Metric
open scoped Topology ContDiff ENNReal

namespace TranscendentalNakamaye.Pending.MultiplierIdealBergmanNadelIdeal

noncomputable section

open FirstPass Hormander PointPole MultiplierIdealBergmanNadelExtension
  MultiplierIdealBergmanNadelVanishing

variable {m : ℕ}

/-- The weighted Bergman space of `K`: holomorphic functions on `K` with finite weighted
`L²` norm. -/
def bergmanSpace {d : ℕ} (K : Set (ComplexModel d)) (w : ComplexModel d → ℝ≥0∞) :
    Set (ComplexModel d → ℂ) :=
  {G | DifferentiableOn ℂ G K ∧ ∫⁻ z in K, ENNReal.ofReal (‖G z‖ ^ 2) * w z ≠ ⊤}

/-- `h` lies, as a germ at `y`, in the ideal generated by the germs of the members of `S`. -/
def InGermSpan {d : ℕ} (S : Set (ComplexModel d → ℂ)) (y : ComplexModel d)
    (h : ComplexModel d → ℂ) : Prop :=
  ∃ (N : ℕ) (s a : Fin N → ComplexModel d → ℂ), (∀ i, s i ∈ S) ∧
    (∀ i, ∀ᶠ z in 𝓝 y, DifferentiableAt ℂ (a i) z) ∧
    h =ᶠ[𝓝 y] fun z => ∑ i, a i z * s i z

/-- The germ span of a family of functions holomorphic near `y` is an ideal of holomorphic
germs. -/
theorem isHolomorphicGermIdeal_inGermSpan {S : Set (EuclideanSpace ℂ (Fin (m + 1)) → ℂ)}
    {y : EuclideanSpace ℂ (Fin (m + 1))}
    (hS : ∀ s ∈ S, ∀ᶠ z in 𝓝 y, DifferentiableAt ℂ s z) :
    IsHolomorphicGermIdeal y (InGermSpan S y) where
  zero_mem := ⟨0, Fin.elim0, Fin.elim0, fun i => i.elim0, fun i => i.elim0,
    Eventually.of_forall fun z => by simp⟩
  add_mem := by
    rintro h₁ h₂ ⟨N₁, s₁, a₁, hs₁, ha₁, he₁⟩ ⟨N₂, s₂, a₂, hs₂, ha₂, he₂⟩
    refine ⟨N₁ + N₂, Fin.append s₁ s₂, Fin.append a₁ a₂, fun i => ?_, fun i => ?_, ?_⟩
    · refine Fin.addCases (fun j => ?_) (fun j => ?_) i
      · rw [Fin.append_left]; exact hs₁ j
      · rw [Fin.append_right]; exact hs₂ j
    · refine Fin.addCases (fun j => ?_) (fun j => ?_) i
      · rw [Fin.append_left]; exact ha₁ j
      · rw [Fin.append_right]; exact ha₂ j
    · filter_upwards [he₁, he₂] with z hz₁ hz₂
      rw [Fin.sum_univ_add]
      simp only [Fin.append_left, Fin.append_right, Pi.add_apply, hz₁, hz₂]
  mul_mem := by
    rintro a' h ha' ⟨N, s, a, hs, ha, he⟩
    refine ⟨N, s, fun i z => a' z * a i z, hs, fun i => ?_, ?_⟩
    · filter_upwards [ha', ha i] with z hz₁ hz₂
      exact hz₁.mul hz₂
    · filter_upwards [he] with z hz
      rw [hz, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      ring
  holomorphic := by
    rintro h ⟨N, s, a, hs, ha, he⟩
    have hall : ∀ᶠ z in 𝓝 y, (h z = ∑ i, a i z * s i z) ∧
        (∀ i, DifferentiableAt ℂ (a i) z) ∧ ∀ i, DifferentiableAt ℂ (s i) z :=
      he.and ((eventually_all.mpr ha).and (eventually_all.mpr fun i => hS (s i) (hs i)))
    obtain ⟨V, hV, hVo, hyV⟩ := _root_.eventually_nhds_iff.mp (eventually_eventually_nhds.mpr hall)
    refine ⟨V, hVo, hyV, fun z hz => ?_⟩
    have hz' := hV z hz
    have hdiff : DifferentiableAt ℂ (fun z => ∑ i, a i z * s i z) z :=
      DifferentiableAt.fun_sum fun i _ => (hz'.self_of_nhds.2.1 i).mul (hz'.self_of_nhds.2.2 i)
    have heq : h =ᶠ[𝓝 z] fun z => ∑ i, a i z * s i z := hz'.mono fun w hw => hw.1
    exact (hdiff.congr_of_eventuallyEq heq).differentiableWithinAt
  congr := by
    rintro h h' ⟨N, s, a, hs, ha, he⟩ hh'
    exact ⟨N, s, a, hs, ha, hh'.trans he⟩

/-- A member of `S` holomorphic near `y` lies in its germ span. -/
theorem inGermSpan_of_mem {d : ℕ} {S : Set (ComplexModel d → ℂ)} {y : ComplexModel d}
    {s : ComplexModel d → ℂ} (hs : s ∈ S) : InGermSpan S y s :=
  ⟨1, fun _ => s, fun _ _ => 1, fun _ => hs, fun _ => Eventually.of_forall fun _ =>
    differentiableAt_const _, Eventually.of_forall fun z => by simp⟩

/-- A smooth cut-off `0 ≤ θ ≤ 1`, equal to `1` on `ball y r`, supported in `ball y ρ`, with a
gradient bound. -/
theorem exists_cutoff {d : ℕ} (y : ComplexModel d) {r ρ : ℝ} (hr : 0 < r) (hrρ : r < ρ) :
    ∃ (θ : ComplexModel d → ℝ) (Mθ : ℝ), ContDiff ℝ ∞ θ ∧ HasCompactSupport θ ∧
      (∀ z ∈ ball y r, θ z = 1) ∧ (∀ z, 0 ≤ θ z ∧ θ z ≤ 1) ∧
      tsupport θ ⊆ ball y ρ ∧ ∀ z, ‖fderiv ℝ θ z‖ ≤ Mθ := by
  have hmid : r < (r + ρ) / 2 := by linarith
  let f : ContDiffBump y := ⟨r, (r + ρ) / 2, hr, hmid⟩
  have htsupp : tsupport (f : ComplexModel d → ℝ) = closedBall y ((r + ρ) / 2) := f.tsupport_eq
  have hcs : HasCompactSupport (f : ComplexModel d → ℝ) := by
    rw [HasCompactSupport, htsupp]
    exact isCompact_closedBall _ _
  have hcd : ContDiff ℝ ∞ (f : ComplexModel d → ℝ) := f.contDiff
  obtain ⟨M, hM⟩ := (hcs.fderiv ℝ).exists_bound_of_continuous
    (hcd.continuous_fderiv (by simp))
  refine ⟨f, M, hcd, hcs, fun z hz => f.one_of_mem_closedBall (ball_subset_closedBall hz),
    fun z => ⟨f.nonneg, f.le_one⟩, ?_, hM⟩
  rw [htsupp]
  intro z hz
  have : dist z y ≤ (r + ρ) / 2 := by simpa [mem_closedBall] using hz
  exact mem_ball.mpr (lt_of_le_of_lt this (by linarith))

/-- **Nadel's ideal identity** (Demailly, *Analytic methods*, Prop. 5.7): a germ at `y ∈ K`
which is `L²` for `e^{-cΨ}` near `y` lies in the ideal generated by the weighted Bergman space
of `K`. -/
theorem inGermSpan_bergmanSpace {Ω : TopologicalSpace.Opens (EuclideanSpace ℂ (Fin (m + 1)))}
    {Ψ : EuclideanSpace ℂ (Fin (m + 1)) → EReal} (hΨ : PlurisubharmonicOn Ψ Ω) {c : ℝ}
    (hc : 0 < c) {L : Set (EuclideanSpace ℂ (Fin (m + 1)))} (hLo : IsOpen L) (hLc : Convex ℝ L)
    (hLb : Bornology.IsBounded L) (hLΩ : closure L ⊆ Ω)
    {K : Set (EuclideanSpace ℂ (Fin (m + 1)))} (hKo : IsOpen K) (hKL : closure K ⊆ L)
    {y : EuclideanSpace ℂ (Fin (m + 1))} (hyK : y ∈ K)
    {f : EuclideanSpace ℂ (Fin (m + 1)) → ℂ} {ρ : ℝ} (hρ : 0 < ρ)
    (hf : DifferentiableOn ℂ f (ball y ρ))
    (hint : ∫⁻ z in ball y ρ, ENNReal.ofReal (‖f z‖ ^ 2) * multiplierWeight c (Ψ z) ≠ ⊤) :
    InGermSpan (bergmanSpace K fun z => multiplierWeight c (Ψ z)) y f := by
  set H := bergmanSpace K fun z => multiplierWeight c (Ψ z) with hHdef
  have hLΩ' : L ⊆ Ω := subset_closure.trans hLΩ
  have hKb : Bornology.IsBounded K := hLb.subset (subset_closure.trans hKL)
  have hKc : IsCompact (closure K) := hKb.isCompact_closure
  -- radii: `ball y ρ₁ ⊆ K ∩ ball y ρ`, cut-off equal to `1` on `ball y r`
  obtain ⟨ρ₀, hρ₀, hρ₀K⟩ := Metric.isOpen_iff.mp hKo y hyK
  set ρ₁ : ℝ := min ρ₀ ρ / 2 with hρ₁
  have hρ₁pos : 0 < ρ₁ := by positivity
  have hρ₁K : ball y ρ₁ ⊆ K := (ball_subset_ball (by
    rw [hρ₁]; linarith [min_le_left ρ₀ ρ])).trans hρ₀K
  have hρ₁ρ : ρ₁ < ρ := by rw [hρ₁]; linarith [min_le_right ρ₀ ρ]
  set r : ℝ := ρ₁ / 2 with hr
  have hrpos : 0 < r := by positivity
  have hrρ₁ : r < ρ₁ := by rw [hr]; linarith
  obtain ⟨θ, Mθ, hθ, hθcs, hθ1, hθ01, hts, hMθ⟩ := exists_cutoff y hrpos hrρ₁
  have htsρ : tsupport θ ⊆ ball y ρ := hts.trans (ball_subset_ball hρ₁ρ.le)
  have htsL : tsupport θ ⊆ L := hts.trans (hρ₁K.trans (subset_closure.trans hKL))
  -- the bound `S`
  set S : ℝ := (∫⁻ z in tsupport θ, ENNReal.ofReal (‖f z‖ ^ 2) * multiplierWeight c (Ψ z)).toReal
    with hSdef
  have hSfin : ∫⁻ z in tsupport θ, ENNReal.ofReal (‖f z‖ ^ 2) * multiplierWeight c (Ψ z) ≠ ⊤ :=
    ne_top_of_le_ne_top hint (lintegral_mono_set htsρ)
  have hS : ∫⁻ z in tsupport θ, ENNReal.ofReal (‖f z‖ ^ 2) * multiplierWeight c (Ψ z) ≤
      ENNReal.ofReal S := (ENNReal.ofReal_toReal hSfin).ge
  -- a radius bound for `K`
  obtain ⟨R₀, hR₀⟩ := (Metric.isBounded_iff_subset_closedBall (0 : EuclideanSpace ℂ (Fin (m + 1)))).mp
    hKb
  set R : ℝ := |R₀| + ‖y‖ + |R₀| with hRdef
  have hR : ∀ z ∈ K, ‖z‖ ≤ R ∧ ‖z - y‖ ≤ R := fun z hz => by
    have h := hR₀ hz
    rw [mem_closedBall, dist_zero_right] at h
    have h1 : ‖z‖ ≤ |R₀| := h.trans (le_abs_self R₀)
    refine ⟨by linarith [norm_nonneg y, abs_nonneg R₀], ?_⟩
    calc ‖z - y‖ ≤ ‖z‖ + ‖y‖ := norm_sub_le z y
      _ ≤ R := by linarith [abs_nonneg R₀]
  -- `e^{-cΨ}` is bounded below on `ball y r`
  have hcb : closedBall y r ⊆ (Ω : Set (EuclideanSpace ℂ (Fin (m + 1)))) :=
    (closedBall_subset_ball hrρ₁).trans (hρ₁K.trans (subset_closure.trans (hKL.trans hLΩ')))
  obtain ⟨Cu, -, hCu⟩ := hΨ.exists_nonnegative_compact_upper_bound (isCompact_closedBall y r) hcb
  set δ₀ : ℝ≥0∞ := ENNReal.ofReal (Real.exp (-(c * Cu))) with hδ₀
  have hδ₀pos : δ₀ ≠ 0 := by rw [hδ₀]; exact (ENNReal.ofReal_pos.mpr (Real.exp_pos _)).ne'
  have hlowΨ : ∀ z ∈ ball y r, δ₀ ≤ multiplierWeight c (Ψ z) := fun z hz => by
    rw [hδ₀, ← multiplierWeight_coe]
    exact multiplierWeight_antitone hc.le (hCu z (ball_subset_closedBall hz))
  -- the polydisc
  set s' : ℝ := r / (m + 1) with hs'
  set s : ℝ := s' / 2 with hsdef
  have hs'pos : 0 < s' := by positivity
  have hspos : 0 < s := by positivity
  have hss' : s < s' := by rw [hsdef]; linarith
  have hpoly : openPolydisc y s' ⊆ ball y r := fun z hz => by
    have := norm_sub_lt_of_mem_openPolydisc hz
    rw [mem_ball, dist_eq_norm]
    calc ‖z - y‖ < (m + 1) * s' := this
      _ = r := by rw [hs']; field_simp
  have hfpoly : DifferentiableOn ℂ f (openPolydisc y s') :=
    hf.mono (hpoly.trans ((ball_subset_ball hrρ₁.le).trans (ball_subset_ball hρ₁ρ.le)))
  -- Krull
  have hHdiff : ∀ G ∈ H, ∀ᶠ z in 𝓝 y, DifferentiableAt ℂ G z := fun G hG =>
    Filter.eventually_of_mem (hKo.mem_nhds hyK) fun z hz => hG.1.differentiableAt (hKo.mem_nhds hz)
  refine germKrullIntersection m y (InGermSpan H y) (isHolomorphicGermIdeal_inGermSpan hHdiff)
    s s' hspos hss' f hfpoly fun n => ?_
  -- the `n`-th extension
  obtain ⟨G, hG, hG1, hG2⟩ := exists_poleExtension_psh (hormanderL2Estimate (m + 1)) hΨ hc hLo
    hLc hLb hLΩ y hrpos hθ hθcs hθ1 hθ01 isOpen_ball htsρ htsL hf hMθ hKo subset_closure hKc
    hKL ((m + 1) * n + (m + 1)) (ENNReal.toReal_nonneg) hS hR
  have hGH : G ∈ H := ⟨hG, ne_top_of_le_ne_top ENNReal.ofReal_ne_top hG1⟩
  have hGpoly : DifferentiableOn ℂ G (openPolydisc y s') :=
    hG.mono (hpoly.trans ((ball_subset_ball hrρ₁.le).trans hρ₁K))
  refine ⟨G, inGermSpan_of_mem hGH, hGpoly, fun α hα => ?_⟩
  -- the pole bound for `f - G` on `ball y r`
  set A' : ℝ≥0∞ := δ₀⁻¹ * ENNReal.ofReal (Real.exp (R ^ 2) *
    (2 * (Mθ ^ 2 * ((r ^ 2) ^ ((m + 1) * n + (m + 1)))⁻¹) * S)) with hA'
  have hA'top : A' ≠ ⊤ := ENNReal.mul_ne_top (ENNReal.inv_ne_top.mpr hδ₀pos) ENNReal.ofReal_ne_top
  have hpole : ∀ η : ℝ, 0 < η → ∫⁻ z in ball y r, ENNReal.ofReal (‖(f - G) z‖ ^ 2) *
      ENNReal.ofReal (((‖z - y‖ ^ 2 + η ^ 2) ^ ((m + 1) * n + (m + 1)))⁻¹) ≤ A' := by
    intro η hη
    have hbr : ball y r ⊆ K := (ball_subset_ball hrρ₁.le).trans hρ₁K
    have hδ₀top : δ₀ ≠ ⊤ := ENNReal.ofReal_ne_top
    calc ∫⁻ z in ball y r, ENNReal.ofReal (‖(f - G) z‖ ^ 2) *
          ENNReal.ofReal (((‖z - y‖ ^ 2 + η ^ 2) ^ ((m + 1) * n + (m + 1)))⁻¹)
        ≤ ∫⁻ z in ball y r, δ₀⁻¹ * (ENNReal.ofReal (‖cutProd θ f z - G z‖ ^ 2) *
            multiplierWeight c (Ψ z) *
            ENNReal.ofReal (((‖z - y‖ ^ 2 + η ^ 2) ^ ((m + 1) * n + (m + 1)))⁻¹)) := by
          refine setLIntegral_mono' measurableSet_ball fun z hz => ?_
          have heq : (f - G) z = cutProd θ f z - G z := by
            simp [cutProd, hθ1 z hz]
          rw [heq]
          set X := ENNReal.ofReal (‖cutProd θ f z - G z‖ ^ 2)
          set P := ENNReal.ofReal (((‖z - y‖ ^ 2 + η ^ 2) ^ ((m + 1) * n + (m + 1)))⁻¹)
          calc X * P = δ₀⁻¹ * (δ₀ * (X * P)) := by
                rw [← mul_assoc, ENNReal.inv_mul_cancel hδ₀pos hδ₀top, one_mul]
            _ ≤ δ₀⁻¹ * (multiplierWeight c (Ψ z) * (X * P)) := by
                gcongr
                exact hlowΨ z hz
            _ = δ₀⁻¹ * (X * multiplierWeight c (Ψ z) * P) := by ring
      _ = δ₀⁻¹ * ∫⁻ z in ball y r, ENNReal.ofReal (‖cutProd θ f z - G z‖ ^ 2) *
            multiplierWeight c (Ψ z) *
            ENNReal.ofReal (((‖z - y‖ ^ 2 + η ^ 2) ^ ((m + 1) * n + (m + 1)))⁻¹) :=
          lintegral_const_mul' _ _ (ENNReal.inv_ne_top.mpr hδ₀pos)
      _ ≤ δ₀⁻¹ * ∫⁻ z in K, ENNReal.ofReal (‖cutProd θ f z - G z‖ ^ 2) *
            multiplierWeight c (Ψ z) *
            ENNReal.ofReal (((‖z - y‖ ^ 2 + η ^ 2) ^ ((m + 1) * n + (m + 1)))⁻¹) := by
          gcongr
      _ ≤ A' := by
          rw [hA']
          gcongr
          exact hG2 η hη
  have hzero := torusCoeff_eq_zero_of_lintegral_pole hspos hss' hrpos (hfpoly.sub hGpoly)
    ((hf.mono ((ball_subset_ball hrρ₁.le).trans (ball_subset_ball hρ₁ρ.le))).sub
      (hG.mono ((ball_subset_ball hrρ₁.le).trans hρ₁K)))
    (q := (m + 1) * n + (m + 1)) (N := (m + 1) * n) le_rfl hA'top hpole
  have hαsum : ∑ i, α i < (m + 1) * n := by
    have hn : 1 ≤ n := by have := hα 0; omega
    have hle : ∑ i, α i ≤ ∑ _i : Fin (m + 1), (n - 1) :=
      Finset.sum_le_sum fun i _ => Nat.le_sub_one_of_lt (hα i)
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul] at hle
    have : (m + 1) * (n - 1) < (m + 1) * n := Nat.mul_lt_mul_of_pos_left (by omega) (by omega)
    omega
  have h := hzero (fun i => α i) hαsum
  rw [torusCoeff_sub (continuousOnTorus_of_differentiableOn hspos.le hss' hfpoly)
    (continuousOnTorus_of_differentiableOn hspos.le hss' hGpoly)] at h
  exact sub_eq_zero.mp h

end

end TranscendentalNakamaye.Pending.MultiplierIdealBergmanNadelIdeal
