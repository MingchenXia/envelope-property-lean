import TranscendentalNakamaye.Pending.DemaillyAnalyticType

set_option autoImplicit false

/-!
# Strong analytic singularities across an overlapping pair of charts

An ordinary maximum of two smooth-logarithmic presentations need not retain a
smooth remainder: the maximum of their smooth remainders can fail to be
smooth.  Thus a finite collar recursion based on ordinary maxima cannot obtain
CT22 strong analytic singularities merely from a cover by overlapping cores.

There is nevertheless a genuine overlap replacement.  Given two presentations
with the same positive coefficient, concatenate their holomorphic generator
families and use the smooth remainder of either branch.  The resulting *single
logarithmic weight* has a smooth remainder and is locally of the same
singularity type as the ordinary maximum.  It requires no disjointness or
later-core separation.  A subsequent globalization still has to prove that
this replacement is theta-PSH with the required curvature; that issue is not
hidden in this local singularity theorem.
-/

open Filter
open scoped Topology ContDiff

namespace TranscendentalNakamaye.Pending.StrongAnalyticOverlapGluing

open DemaillyAnalyticType

noncomputable section

/-- The one logarithmic weight obtained by combining two overlapping generator
families.  Its pole ideal is generated by the union of both families. -/
def smoothLogSum {E : Type*} {p q : ℕ} (c : ℝ)
    (f : Fin p → E → ℂ) (g : Fin q → E → ℂ) (b : E → ℝ) : E → EReal :=
  fun y => (c : EReal) * generatorLog (Fin.append f g) y + (b y : EReal)

/-- Adding an empty generator family does not change the logarithmic norm. -/
theorem generatorLog_append_empty
    {E : Type*} {p : ℕ} (f : Fin p → E → ℂ) (y : E) :
    generatorLog (Fin.append f (fun i : Fin 0 => i.elim0)) y = generatorLog f y := by
  rw [DemaillyAnalyticType.generatorLog_append_eq_log_add, generatorLog_eq_log_sum]
  simp [generatorNormSq]

/-- Consequently a log-sum with an empty second family is the original
generator logarithm with its specified real remainder. -/
theorem smoothLogSum_append_empty
    {E : Type*} {p : ℕ} (c : ℝ) (f : Fin p → E → ℂ) (b : E → ℝ) (y : E) :
    smoothLogSum c f (fun i : Fin 0 => i.elim0) b y =
      (c : EReal) * generatorLog f y + (b y : EReal) := by
  rw [smoothLogSum, generatorLog_append_empty]

/-- Concatenating two holomorphic generator families and retaining a smooth
remainder gives a strong smooth-logarithmic presentation of `smoothLogSum`. -/
theorem smoothLogSum_smoothLogarithmicTypeAt
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [NormedSpace ℝ E]
    {p q : ℕ} {c : ℝ} {f : Fin p → E → ℂ} {g : Fin q → E → ℂ}
    {x : E} {b : E → ℝ} (hc : 0 < c)
    (hf : HolomorphicGeneratorsAt f x) (hg : HolomorphicGeneratorsAt g x)
    (hb : ∀ᶠ y in 𝓝 x, ContDiffAt ℝ ∞ b y) :
    SmoothLogarithmicTypeAt (smoothLogSum c f g b) c (Fin.append f g) x := by
  refine ⟨hc, HolomorphicGeneratorsAt.append hf hg, b, hb, ?_⟩
  exact Eventually.of_forall fun _ => rfl

/-- **Overlap replacement for the strong CT22 convention.**  From two strong
logarithmic presentations with a common coefficient, construct a single
strong presentation whose potential has the same local singularity type as
their ordinary maximum.  No core-separation hypothesis occurs. -/
theorem exists_smoothLogSum_sameSingularityTypeAt_max
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [NormedSpace ℝ E]
    {p q : ℕ} {c : ℝ} {f : Fin p → E → ℂ} {g : Fin q → E → ℂ}
    {u v : E → EReal} {x : E}
    (hu : SmoothLogarithmicTypeAt u c f x)
    (hv : SmoothLogarithmicTypeAt v c g x) :
    ∃ b : E → ℝ,
      SmoothLogarithmicTypeAt (smoothLogSum c f g b) c (Fin.append f g) x ∧
      SameSingularityTypeAt (fun y => max (u y) (v y)) (smoothLogSum c f g b) x := by
  obtain ⟨hc, hf, b, hb, hub⟩ := hu
  obtain ⟨-, hg, d, hd, hvd⟩ := hv
  let hsum : SmoothLogarithmicTypeAt (smoothLogSum c f g b)
      c (Fin.append f g) x :=
    smoothLogSum_smoothLogarithmicTypeAt hc hf hg hb
  refine ⟨b, hsum, ?_⟩
  have hmax : LogarithmicTypeAt (fun y => max (u y) (v y)) c
      (Fin.append f g) x :=
    LogarithmicTypeAt.max_of_generators
      ⟨hc, hf, b, boundedRealGermAt_of_continuousAt
        hb.self_of_nhds.continuousAt, hub⟩
      ⟨hc, hg, d, boundedRealGermAt_of_continuousAt
        hd.self_of_nhds.continuousAt, hvd⟩
  exact hmax.sameSingularityTypeAt.trans
    hsum.logarithmicTypeAt.sameSingularityTypeAt.symm

end

end TranscendentalNakamaye.Pending.StrongAnalyticOverlapGluing
