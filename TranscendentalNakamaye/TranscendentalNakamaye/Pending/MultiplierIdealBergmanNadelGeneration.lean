import TranscendentalNakamaye.Pending.BergmanGenerators

set_option autoImplicit false

/-!
# Finitely many Bergman sections generate the whole Bergman space on one ball

Let `X` be the unit ball of the weighted Bergman space of `ball z (2R) ⊆ ℂⁿ`, the weight being
bounded below by a positive constant (`BergmanGenerators.bergmanUnitBall`).  Some finitely many
`g_1, …, g_N ∈ X` and one radius `r > 0` work for all of `X` at once: every `f ∈ X` is
`∑ a_l g_l` on `ball z r` with `a_l` holomorphic and bounded there, with one bound
(`exists_uniform_span_generators`).

This is the generation counterpart of `BergmanGenerators.exists_uniform_generators` (which gives
the pointwise domination `|f|² ≤ K ∑ |g_l|²`), and is proved the same way: the germs of `X` at
`z` generate a finitely generated ideal of the Noetherian ring of germs, so each `f ∈ X` is a
combination of finitely many fixed `g_l` on its own ball (`exists_finite_germ_span_generators`);
the Baire category theorem in the complete space of restrictions of `X` to `closedBall z R`,
applied to the closed sets of `f` that are combinations on `ball z (R/(j+1))` with coefficients
bounded by `j + 1` (closed by Montel's theorem for the coefficient tuples,
`exists_subseq_tendsto_tuple`), and the convexity of `X` give the uniform statement.

With Nadel's ideal identity (`MultiplierIdealBergmanNadelIdeal.inGermSpan_bergmanSpace`) this
makes the multiplier ideal sheaf locally finitely generated by `g_1, …, g_N` on `ball z r`:
step B2 of programme `TN.3.3.DEMPROVE` (Demailly, *Analytic methods*, Prop. 5.7; the strong
Noetherian property is replaced by Baire).
-/

open Set Filter MeasureTheory Metric
open scoped ENNReal Topology

namespace TranscendentalNakamaye.Pending.MultiplierIdealBergmanNadelGeneration

noncomputable section

open FirstPass BergmanGenerators

variable {n : ℕ}

/-! ### Germ generators with coefficients -/

/-- **Finitely many germ generators, with the coefficients.**  For any set `S` of functions
holomorphic near `z`, finitely many members of `S` generate: every member of `S` is
`∑ a_l g_l` on some ball around `z`, with `a_l` holomorphic there. -/
theorem exists_finite_germ_span_generators (S : Set (ComplexModel n → ℂ)) (z : ComplexModel n)
    (hS : ∀ f ∈ S, ∀ᶠ w in 𝓝 z, DifferentiableAt ℂ f w) :
    ∃ (N : ℕ) (g : Fin N → ComplexModel n → ℂ), (∀ l, g l ∈ S) ∧
      ∀ f ∈ S, ∃ r > 0, ∃ a : Fin N → ComplexModel n → ℂ,
        (∀ l, DifferentiableOn ℂ (a l) (ball z r)) ∧
        ∀ y ∈ ball z r, f y = ∑ l, a l y * g l y := by
  classical
  have := isNoetherianRing_holGerm_euclidean n
  let G : S → HolGerm (ComplexModel n) := fun f =>
    HolGerm.mk (fun w => (f : ComplexModel n → ℂ) (w + z))
      (eventually_differentiableAt_translate (hS f f.2))
  have hfg : (Ideal.span (range G)).FG := IsNoetherian.noetherian _
  obtain ⟨s, hsT, hspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset (range G)).mp hfg
  let N := s.card
  let v : Fin N → HolGerm (ComplexModel n) := fun i => (s.equivFin.symm i : _)
  have hv : ∀ i, ∃ f : S, G f = v i := fun i => hsT (s.equivFin.symm i).2
  choose p hp using hv
  refine ⟨N, fun l => (p l : ComplexModel n → ℂ), fun l => (p l).2, fun f hf => ?_⟩
  have hrange : (s : Set (HolGerm (ComplexModel n))) = range v := by
    ext x
    constructor
    · intro hx
      exact ⟨s.equivFin ⟨x, hx⟩, by simp [v]⟩
    · rintro ⟨i, rfl⟩
      exact (s.equivFin.symm i).2
  have hmem : G ⟨f, hf⟩ ∈ Ideal.span (range v) := by
    rw [← hrange]
    change G ⟨f, hf⟩ ∈ Submodule.span _ _
    rw [← hspan]
    exact Submodule.subset_span ⟨⟨f, hf⟩, rfl⟩
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
  have ha : ∀ l, ∃ (a : ComplexModel n → ℂ) (ha : ∀ᶠ w in 𝓝 0, DifferentiableAt ℂ a w),
      c l = HolGerm.mk a ha := fun l => HolGerm.exists_eq_mk (c l)
  choose a had hac using ha
  let q : Fin N → ComplexModel n → ℂ := fun l w => (p l : ComplexModel n → ℂ) (w + z)
  have hq : ∀ l, ∀ᶠ w in 𝓝 0, DifferentiableAt ℂ (q l) w := fun l =>
    eventually_differentiableAt_translate (hS _ (p l).2)
  have hprod : ∀ l, ∀ᶠ w in 𝓝 (0 : ComplexModel n),
      DifferentiableAt ℂ (fun w => a l w * q l w) w := fun l =>
    eventually_differentiableAt_mul (had l) (hq l)
  have hgerm : (fun w => ∑ l, a l w * q l w) =ᶠ[𝓝 0] fun w => f (w + z) := by
    have h1 := HolGerm.mk_sum Finset.univ (fun l w => a l w * q l w) hprod
    have h2 : HolGerm.mk (fun w => ∑ l, a l w * q l w)
        (eventually_differentiableAt_sum Finset.univ hprod) = G ⟨f, hf⟩ := by
      rw [h1, ← hc]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [hac l, ← hp l]
      rfl
    exact HolGerm.mk_eq_mk_iff.mp h2
  have hall : ∀ᶠ w in 𝓝 (0 : ComplexModel n),
      (∑ l, a l w * q l w = f (w + z)) ∧ ∀ l, DifferentiableAt ℂ (a l) w :=
    hgerm.and (eventually_all.mpr had)
  obtain ⟨r, hr, hball⟩ := Metric.eventually_nhds_iff_ball.mp hall
  refine ⟨r, hr, fun l y => a l (y - z), fun l y hy => ?_, fun y hy => ?_⟩
  · have hw : y - z ∈ ball (0 : ComplexModel n) r := by
      simpa [mem_ball, dist_eq_norm] using hy
    exact (((hball _ hw).2 l).comp y (differentiableAt_id.sub_const z)).differentiableWithinAt
  · have hw : y - z ∈ ball (0 : ComplexModel n) r := by
      simpa [mem_ball, dist_eq_norm] using hy
    have heq := (hball _ hw).1
    simp only [q, sub_add_cancel] at heq
    exact heq.symm

/-! ### Montel for finitely many bounded sequences -/

/-- **Montel's theorem for a uniformly bounded sequence** of holomorphic functions on an open
set: a pointwise convergent subsequence with a holomorphic limit obeying the same bound. -/
theorem exists_subseq_tendsto_of_bounded {U : Set (ComplexModel n)} (hU : IsOpen U)
    {F : ℕ → ComplexModel n → ℂ} (hF : ∀ i, DifferentiableOn ℂ (F i) U) {M : ℝ}
    (hM : ∀ i, ∀ y ∈ U, ‖F i y‖ ≤ M) :
    ∃ (ψ : ℕ → ℕ) (G : ComplexModel n → ℂ), StrictMono ψ ∧ DifferentiableOn ℂ G U ∧
      (∀ y ∈ U, ‖G y‖ ≤ M) ∧ ∀ y ∈ U, Tendsto (fun i => F (ψ i) y) atTop (𝓝 (G y)) := by
  obtain ⟨ψ, G, hψ, hG, hconv⟩ := exists_subseq_tendstoLocallyUniformlyOn_of_eventually_bounded
    hU F fun x hx => by
      obtain ⟨r, hr, hrU⟩ := Metric.isOpen_iff.mp hU x hx
      exact ⟨r, hr, M, Eventually.of_forall fun i => ⟨(hF i).mono hrU, fun y hy => hM i y (hrU hy)⟩⟩
  have hpt : ∀ y ∈ U, Tendsto (fun i => F (ψ i) y) atTop (𝓝 (G y)) := fun y hy =>
    hconv.tendsto_at hy
  exact ⟨ψ, G, hψ, hG, fun y hy => le_of_tendsto' ((hpt y hy).norm) fun i => hM _ y hy, hpt⟩

/-- **Montel's theorem for a tuple** of uniformly bounded sequences: one subsequence along which
all of them converge. -/
theorem exists_subseq_tendsto_tuple {U : Set (ComplexModel n)} (hU : IsOpen U) {M : ℝ} :
    ∀ (N : ℕ) (F : Fin N → ℕ → ComplexModel n → ℂ),
      (∀ l i, DifferentiableOn ℂ (F l i) U) → (∀ l i, ∀ y ∈ U, ‖F l i y‖ ≤ M) →
      ∃ (ψ : ℕ → ℕ) (G : Fin N → ComplexModel n → ℂ), StrictMono ψ ∧
        (∀ l, DifferentiableOn ℂ (G l) U) ∧ (∀ l, ∀ y ∈ U, ‖G l y‖ ≤ M) ∧
        ∀ l, ∀ y ∈ U, Tendsto (fun i => F l (ψ i) y) atTop (𝓝 (G l y))
  | 0, _, _, _ => ⟨id, fun l => l.elim0, strictMono_id, fun l => l.elim0, fun l => l.elim0,
      fun l => l.elim0⟩
  | N + 1, F, hF, hM => by
    obtain ⟨ψ₁, G₁, hψ₁, hG₁, hGM₁, hconv₁⟩ :=
      exists_subseq_tendsto_tuple hU N (fun l => F l.castSucc) (fun l => hF l.castSucc)
        (fun l => hM l.castSucc)
    obtain ⟨ψ₂, G₂, hψ₂, hG₂, hGM₂, hconv₂⟩ := exists_subseq_tendsto_of_bounded hU
      (F := fun i => F (Fin.last N) (ψ₁ i)) (fun i => hF _ _) (fun i => hM _ _)
    refine ⟨ψ₁ ∘ ψ₂, Fin.snoc G₁ G₂, hψ₁.comp hψ₂, fun l => ?_, fun l => ?_, fun l => ?_⟩
    · refine Fin.lastCases ?_ (fun j => ?_) l
      · simpa using hG₂
      · simpa using hG₁ j
    · refine Fin.lastCases ?_ (fun j => ?_) l
      · simpa using hGM₂
      · simpa using hGM₁ j
    · refine Fin.lastCases ?_ (fun j => ?_) l
      · simpa using hconv₂
      · intro y hy
        simp only [Fin.snoc_castSucc, Function.comp_apply]
        exact (hconv₁ j y hy).comp hψ₂.tendsto_atTop


/-! ### The uniform statement (Baire) -/

section Bergman

variable [MeasurableSpace (ComplexModel n)] [BorelSpace (ComplexModel n)]
  {z : ComplexModel n} {R : ℝ} {w : ComplexModel n → ℝ≥0∞}

/-- **Uniform generation by finitely many Bergman sections** (Baire category).  Finitely many
elements `g_l` of the weighted Bergman unit ball of `ball z (2R)` and one radius `r > 0`: every
element of the unit ball is `∑ a_l g_l` on `ball z r`, with `a_l` holomorphic and bounded by one
constant `C` there. -/
theorem exists_uniform_span_generators (hR : 0 < R)
    (hw : AEMeasurable w (volume.restrict (ball z (2 * R)))) {δ : ℝ} (hδ : 0 < δ)
    (hlow : ∀ y ∈ ball z (2 * R), ENNReal.ofReal δ ≤ w y) :
    ∃ (N : ℕ) (g : Fin N → ComplexModel n → ℂ) (r C : ℝ), 0 < r ∧
      (∀ l, g l ∈ bergmanUnitBall z R w) ∧
      ∀ f ∈ bergmanUnitBall z R w, ∃ a : Fin N → ComplexModel n → ℂ,
        (∀ l, DifferentiableOn ℂ (a l) (ball z r)) ∧ (∀ l, ∀ y ∈ ball z r, ‖a l y‖ ≤ C) ∧
        ∀ y ∈ ball z r, f y = ∑ l, a l y * g l y := by
  classical
  set X := bergmanUnitBall z R w with hX
  have hz2R : z ∈ ball z (2 * R) := mem_ball_self (by linarith)
  obtain ⟨N, g, hgX, hgen⟩ := exists_finite_germ_span_generators X z fun f hf =>
    Filter.eventually_of_mem (isOpen_ball.mem_nhds hz2R) fun y hy =>
      hf.1.differentiableAt (isOpen_ball.mem_nhds hy)
  obtain ⟨L, hL0, hL⟩ := exists_norm_le_of_mem_bergmanUnitBall hR hδ hlow
  have hTB : closedBall z R ⊆ ball z (2 * R) := closedBall_subset_ball_two_mul hR
  have : CompactSpace (closedBall z R) :=
    isCompact_iff_compactSpace.mp (isCompact_closedBall z R)
  let ev : ∀ f ∈ X, C(closedBall z R, ℂ) := fun f hf =>
    ⟨fun x => f x, (hf.1.continuousOn.mono hTB).domRestrict⟩
  let S : Set C(closedBall z R, ℂ) := {h | ∃ f ∈ X, ∀ x, h x = f x}
  have hSc : IsClosed S := by
    refine isClosed_of_closure_subset fun h hh => ?_
    obtain ⟨u, hu, hlim⟩ := mem_closure_iff_seq_limit.mp hh
    choose F hFX hFu using hu
    obtain ⟨ψ, G, hψ, hGX, hGt⟩ := exists_subseq_tendsto_mem_bergmanUnitBall hw hδ hlow hFX
    refine ⟨G, hGX, fun x => ?_⟩
    have h1 : Tendsto (fun i => u (ψ i) x) atTop (𝓝 (h x)) :=
      ((continuous_eval_const x).tendsto h).comp (hlim.comp hψ.tendsto_atTop)
    have h2 : Tendsto (fun i => u (ψ i) x) atTop (𝓝 (G x)) := by
      simpa only [hFu] using hGt x (hTB x.2)
    exact tendsto_nhds_unique h1 h2
  have : CompleteSpace S := hSc.completeSpace_coe
  have : Nonempty S := ⟨⟨ev 0 zero_mem_bergmanUnitBall, 0, zero_mem_bergmanUnitBall,
    fun _ => rfl⟩⟩
  let ρ : ℕ → ℝ := fun j => R / ((j : ℝ) + 1)
  have hρpos : ∀ j, 0 < ρ j := fun j => by positivity
  have hρR : ∀ j, ρ j ≤ R := fun j =>
    div_le_self hR.le (by linarith [(j.cast_nonneg : (0 : ℝ) ≤ j)])
  let A : ℕ → Set S := fun j => {h | ∃ a : Fin N → ComplexModel n → ℂ,
    (∀ l, DifferentiableOn ℂ (a l) (ball z (ρ j))) ∧
    (∀ l, ∀ y ∈ ball z (ρ j), ‖a l y‖ ≤ (j : ℝ) + 1) ∧
    ∀ y : closedBall z R, (y : ComplexModel n) ∈ ball z (ρ j) →
      (h : C(closedBall z R, ℂ)) y = ∑ l, a l y * g l y}
  have hAc : ∀ j, IsClosed (A j) := by
    intro j
    refine isClosed_of_closure_subset fun h hh => ?_
    obtain ⟨u, hu, hlim⟩ := mem_closure_iff_seq_limit.mp hh
    choose a ha hab heq using hu
    obtain ⟨ψ, b, hψ, hb, hbM, hconv⟩ := exists_subseq_tendsto_tuple isOpen_ball N
      (fun l i => a i l) (fun l i => ha i l) (fun l i => hab i l)
    refine ⟨b, hb, hbM, fun y hy => ?_⟩
    have h1 : Tendsto (fun i => ((u (ψ i) : S) : C(closedBall z R, ℂ)) y) atTop
        (𝓝 ((h : C(closedBall z R, ℂ)) y)) :=
      ((continuous_eval_const y).tendsto _).comp
        ((continuous_subtype_val.tendsto _).comp (hlim.comp hψ.tendsto_atTop))
    have h2 : Tendsto (fun i => ((u (ψ i) : S) : C(closedBall z R, ℂ)) y) atTop
        (𝓝 (∑ l, b l y * g l y)) := by
      have := tendsto_finsetSum Finset.univ fun l _ => (hconv l y hy).mul_const (g l y)
      exact this.congr fun i => (heq (ψ i) y hy).symm
    exact tendsto_nhds_unique h1 h2
  have hAU : ⋃ j, A j = univ := by
    refine eq_univ_of_forall fun h => mem_iUnion.mpr ?_
    obtain ⟨f, hfX, hfh⟩ := h.2
    obtain ⟨r, hr, a, ha, heqf⟩ := hgen f hfX
    have hcb : closedBall z (r / 2) ⊆ ball z r := closedBall_subset_ball (by linarith)
    have hMl : ∀ l, ∃ M : ℝ, ∀ y ∈ closedBall z (r / 2), ‖a l y‖ ≤ M := fun l =>
      (isCompact_closedBall z (r / 2)).exists_bound_of_continuousOn ((ha l).continuousOn.mono hcb)
    choose M hM using hMl
    obtain ⟨j, hj⟩ := exists_nat_gt (max (∑ l, |M l|) (2 * R / r))
    have hj1 : (0 : ℝ) < j + 1 := by positivity
    have hρr : ρ j ≤ r / 2 := by
      have h' := (le_max_right (∑ l, |M l|) (2 * R / r)).trans hj.le
      rw [div_le_iff₀ hr] at h'
      simp only [ρ]
      rw [div_le_iff₀ hj1]
      nlinarith
    have hsub : ball z (ρ j) ⊆ closedBall z (r / 2) :=
      ball_subset_closedBall.trans (closedBall_subset_closedBall hρr)
    refine ⟨j, a, fun l => (ha l).mono (hsub.trans hcb), fun l y hy => ?_, fun y hy => ?_⟩
    · calc ‖a l y‖ ≤ M l := hM l y (hsub hy)
        _ ≤ |M l| := le_abs_self _
        _ ≤ ∑ l, |M l| := Finset.single_le_sum (f := fun l => |M l|)
            (fun l _ => abs_nonneg _) (Finset.mem_univ l)
        _ ≤ (j : ℝ) + 1 := by linarith [le_max_left (∑ l, |M l|) (2 * R / r)]
    · rw [hfh y]
      exact heqf y (hcb (hsub hy))
  obtain ⟨j, h0, hh0⟩ := nonempty_interior_of_iUnion_of_closed hAc hAU
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp (mem_interior_iff_mem_nhds.mp hh0)
  obtain ⟨a0, ha0, ha0b, ha0e⟩ := interior_subset hh0
  obtain ⟨f0, hf0X, hf0h⟩ := h0.2
  set t : ℝ := ε / (2 * (2 * L + ε)) with ht
  have htpos : 0 < t := by positivity
  have ht1 : t ≤ 1 := by
    rw [ht, div_le_one (by positivity)]
    nlinarith
  have hj1 : (0 : ℝ) < j + 1 := by positivity
  refine ⟨N, g, ρ j, 2 * ((j : ℝ) + 1) / t, hρpos j, hgX, fun f hf => ?_⟩
  let ft : ComplexModel n → ℂ := fun x => (1 - t : ℂ) * f0 x + (t : ℂ) * f x
  have hftX : ft ∈ X := convex_mem_bergmanUnitBall hw hf0X hf htpos.le ht1
  let hft : S := ⟨ev ft hftX, ft, hftX, fun _ => rfl⟩
  have hdist : dist hft h0 < ε := by
    rw [Subtype.dist_eq]
    have hle : dist (ev ft hftX) (h0 : C(closedBall z R, ℂ)) ≤ t * (2 * L) := by
      refine (ContinuousMap.dist_le (by positivity)).mpr fun x => ?_
      rw [hf0h x, dist_eq_norm]
      change ‖(1 - t : ℂ) * f0 x + (t : ℂ) * f x - f0 x‖ ≤ _
      rw [show (1 - t : ℂ) * f0 x + (t : ℂ) * f x - f0 x = (t : ℂ) * (f x - f0 x) by ring,
        norm_mul, Complex.norm_real, Real.norm_of_nonneg htpos.le]
      gcongr
      refine (norm_sub_le _ _).trans ?_
      linarith [hL f hf x x.2, hL f0 hf0X x x.2]
    refine hle.trans_lt ?_
    rw [ht, div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
    nlinarith
  obtain ⟨at', hat, hatb, hate⟩ := hball hdist
  have htne : (t : ℂ) ≠ 0 := by exact_mod_cast htpos.ne'
  refine ⟨fun l y => (t : ℂ)⁻¹ * (at' l y - (1 - t : ℂ) * a0 l y),
    fun l => ((hat l).sub ((ha0 l).const_mul _)).const_mul _, fun l y hy => ?_,
    fun y hy => ?_⟩
  · rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg htpos.le]
    have h1 := hatb l y hy
    have h2 := ha0b l y hy
    have h3 : ‖at' l y - (1 - t : ℂ) * a0 l y‖ ≤ 2 * ((j : ℝ) + 1) := by
      refine (norm_sub_le _ _).trans ?_
      rw [norm_mul, show ((1 - t : ℂ)) = ((1 - t : ℝ) : ℂ) by push_cast; ring,
        Complex.norm_real, Real.norm_of_nonneg (by linarith)]
      nlinarith [norm_nonneg (a0 l y)]
    rw [div_eq_inv_mul]
    exact mul_le_mul_of_nonneg_left h3 (inv_nonneg.mpr htpos.le)
  · have hyT : y ∈ closedBall z R := ball_subset_closedBall (ball_subset_ball (hρR j) hy)
    have e1 := hate ⟨y, hyT⟩ hy
    have e0 := ha0e ⟨y, hyT⟩ hy
    rw [hf0h] at e0
    change ft y = _ at e1
    have hfy : f y = (t : ℂ)⁻¹ * (ft y - (1 - t : ℂ) * f0 y) := by
      simp only [ft]
      field_simp
      ring
    rw [hfy, e1, e0, Finset.mul_sum, ← Finset.sum_sub_distrib, Finset.mul_sum]
    refine Finset.sum_congr rfl fun l _ => ?_
    simp only
    ring

end Bergman

end

end TranscendentalNakamaye.Pending.MultiplierIdealBergmanNadelGeneration
