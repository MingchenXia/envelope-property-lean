-    rw [← hspan]
-    haveI htower : IsScalarTower R (A ⧸ I)
-        (Localization.Away r ⧸ Ideal.map (algebraMap A (Localization.Away r)) I) := by
-      refine IsScalarTower.of_algebraMap_eq (fun x => ?_)
-      rw [IsScalarTower.algebraMap_apply R A (A ⧸ I) x, Ideal.Quotient.algebraMap_eq,
-        Ideal.Quotient.algebraMap_quotient_map_quotient,
