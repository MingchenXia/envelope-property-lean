-      have hunit : IsUnit (algebraMap A (Localization.Away r) (dfun g hg)) :=
-        isUnit_of_dvd_unit (map_dvd _ hdvd)
-          (IsLocalization.map_units (Localization.Away r)
-            (⟨r, Submonoid.mem_powers r⟩ : Submonoid.powers r))
-      obtain ⟨u, hu⟩ := hunit
-      rw [Ideal.mem_span_singleton']
-      refine ⟨↑u⁻¹ * algebraMap A (Localization.Away r) (bfun g hg), ?_⟩
-      have hrel' : algebraMap A (Localization.Away r) (dfun g hg)
-          * algebraMap A (Localization.Away r) g
-          = algebraMap A (Localization.Away r) (bfun g hg)
-            * algebraMap A (Localization.Away r) f := by
-        rw [← map_mul, ← map_mul, hrel g hg]
-      rw [mul_assoc, ← hrel', ← hu, ← mul_assoc, Units.inv_mul, one_mul]
-    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
-      exact Ideal.mem_map_of_mem _ hfI
