-  obtain ⟨s, hs⟩ := hfg
-  have key : ∀ g ∈ s, ∃ dg : A, dg ∉ q ∧ ∃ bg : A, dg * g = bg * f := fun g hg =>
-    exists_denom_mul_eq_mul_of_mem_of_map_atPrime_span I f q hq (hs ▸ Ideal.subset_span hg)
