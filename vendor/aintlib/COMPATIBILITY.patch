-    (haff : ∀ s, IsAffineOpen (((∏ i, Scheme.Hom.ker (P i).1).subschemeι ≫ π) ⁻¹ᵁ (U s).1))
-    (hQ : ∀ s, Q (Spec.map (((∏ i, Scheme.Hom.ker (P i).1).subschemeι ≫ π).app (U s).1))) :
-    Q ((∏ i, Scheme.Hom.ker (P i).1).subschemeι ≫ π) := by
